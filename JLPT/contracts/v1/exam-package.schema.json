{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harumi:jlpt-exam:exam-package:1.2.0",
  "title": "Gói dữ liệu JLPT dùng trong Harumi",
  "description": "Structural validation only; semantic readiness and target compatibility are required separately.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.1.0",
        "1.2.0"
      ]
    },
    "packageId": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "exam": {
      "$ref": "#/$defs/exam"
    },
    "structure": {
      "$ref": "#/$defs/structure"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "annotations": {
      "$ref": "#/$defs/annotations"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "masterAudio": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "assetId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "rss": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "feedUrl": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    },
                    "episodeGuid": {
                      "type": "string",
                      "minLength": 1
                    },
                    "enclosureUrl": {
                      "type": "string",
                      "format": "uri",
                      "pattern": "^https://"
                    }
                  },
                  "required": [
                    "feedUrl",
                    "episodeGuid",
                    "enclosureUrl"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "assetId",
            "durationMs",
            "rss"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "revision",
    "exam",
    "structure",
    "sources",
    "assets",
    "content",
    "annotations",
    "review",
    "masterAudio"
  ],
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "textVi": {
          "type": "string"
        },
        "reading": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ]
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]$"
        },
        "text": {
          "type": "string"
        },
        "textVi": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ]
    },
    "script": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scriptJaMd": {
          "type": "string"
        },
        "scriptViMd": {
          "type": "string"
        }
      },
      "required": [
        "scriptJaMd",
        "scriptViMd"
      ]
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "prompt": {
          "$ref": "#/$defs/text"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          },
          "minItems": 2,
          "maxItems": 26
        },
        "correctChoiceId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "translationVi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "vocabNotes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "grammarNotes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "audioUrl": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^asset://[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "imageUrl": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^asset://[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "jlptListenScript": {
          "$ref": "#/$defs/script"
        },
        "jlptHighlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jlptChoiceHighlights": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "id",
        "prompt",
        "choices",
        "correctChoiceId",
        "explanation",
        "translationVi",
        "vocabNotes",
        "grammarNotes"
      ]
    },
    "media": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "const": "passage"
            },
            "passage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "jaMd": {
                  "type": "string"
                },
                "viMd": {
                  "type": "string"
                }
              },
              "required": [
                "jaMd",
                "viMd"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "passage"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "const": "audio"
            },
            "audio": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^asset://[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "scriptJaMd": {
                  "type": "string"
                },
                "scriptViMd": {
                  "type": "string"
                }
              },
              "required": [
                "url",
                "scriptJaMd",
                "scriptViMd"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "audio"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "const": "image"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^asset://[a-f0-9]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "url"
              ]
            }
          },
          "required": [
            "id",
            "kind",
            "image"
          ]
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "choiceCount": {
          "type": "integer",
          "minimum": 2,
          "maximum": 26
        },
        "mediaItems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/media"
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/question"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "choiceCount",
        "mediaItems",
        "questions"
      ]
    },
    "mondai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "section": {
          "enum": [
            "mojigoi",
            "bunpou",
            "dokkai",
            "choukai"
          ]
        },
        "mondaiNumber": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "instruction": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "section",
        "mondaiNumber",
        "label",
        "instruction",
        "blocks"
      ]
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mondais": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mondai"
          }
        }
      },
      "required": [
        "mondais"
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mojigoi": {
          "$ref": "#/$defs/paper"
        },
        "bunpou": {
          "$ref": "#/$defs/paper"
        },
        "dokkai": {
          "$ref": "#/$defs/paper"
        },
        "choukai": {
          "$ref": "#/$defs/paper"
        }
      },
      "required": [
        "mojigoi",
        "bunpou",
        "dokkai",
        "choukai"
      ]
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "N5",
            "N4",
            "N3",
            "N2",
            "N1"
          ]
        },
        "slug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "kind": {
          "enum": [
            "official",
            "practice",
            "unknown",
            "synthetic"
          ]
        },
        "year": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1900,
              "maximum": 9999
            },
            {
              "type": "null"
            }
          ]
        },
        "month": {
          "enum": [
            7,
            12,
            null
          ]
        }
      },
      "required": [
        "level",
        "slug",
        "name",
        "kind",
        "year",
        "month"
      ]
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profileKey": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "sectionOrder": {
          "type": "array",
          "items": {
            "enum": [
              "mojigoi",
              "bunpou",
              "dokkai",
              "choukai"
            ]
          },
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true
        },
        "timings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sectionKeys": {
                "type": "array",
                "items": {
                  "enum": [
                    "mojigoi",
                    "bunpou",
                    "dokkai",
                    "choukai"
                  ]
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "seconds": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "sectionKeys",
              "seconds",
              "sourceId"
            ]
          }
        },
        "expectations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mondaiId": {
                "type": "string",
                "format": "uuid"
              },
              "questionCount": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "mondaiId",
              "questionCount"
            ]
          }
        }
      },
      "required": [
        "profileKey",
        "description",
        "sectionOrder",
        "timings",
        "expectations"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "web",
            "local",
            "synthetic"
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            },
            {
              "type": "null"
            }
          ]
        },
        "localPath": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[:\\\\]).+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "capturedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "available",
            "blocked",
            "auth_required",
            "missing"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "sourceId",
        "kind",
        "url",
        "localPath",
        "sha256",
        "capturedAt",
        "status",
        "note"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "path": {
          "type": "string",
          "pattern": "^assets/sha256/[a-f0-9]{2}/[a-f0-9]{64}\\.(png|jpg|jpeg|webp|mp3|m4a|mp4|ogg|wav)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mediaType": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "audio/mpeg",
            "audio/mp4",
            "audio/ogg",
            "audio/wav"
          ]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "durationMs": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "width": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "origins": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sourceId",
              "locator"
            ]
          },
          "minItems": 1
        },
        "derivedFromAssetId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "transform": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "assetId",
        "path",
        "sha256",
        "mediaType",
        "byteLength",
        "durationMs",
        "width",
        "height",
        "origins",
        "derivedFromAssetId",
        "transform"
      ]
    },
    "nodeAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "sourceNumber": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceChoiceLabels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "choiceId": {
                "type": "string",
                "pattern": "^[a-z]$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "choiceId",
              "label"
            ]
          }
        }
      },
      "required": [
        "nodeId",
        "sourceId",
        "locator",
        "sourceNumber",
        "sourceChoiceLabels"
      ]
    },
    "fieldAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetId": {
          "type": "string",
          "format": "uuid"
        },
        "fieldPointer": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
        },
        "origin": {
          "enum": [
            "source",
            "ocr",
            "stt",
            "ai",
            "human"
          ]
        },
        "sourceId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "runId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "skillVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "inputSha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewStatus": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "targetId",
        "fieldPointer",
        "origin",
        "sourceId",
        "runId",
        "model",
        "skillVersion",
        "inputSha256",
        "reviewStatus",
        "note"
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questionId": {
          "type": "string",
          "format": "uuid"
        },
        "sourceChoiceId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "aiChoiceId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolvedChoiceId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z]$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "enum": [
            "unresolved",
            "source_confirmed",
            "human_corrected"
          ]
        },
        "sourceId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "questionId",
        "sourceChoiceId",
        "aiChoiceId",
        "resolvedChoiceId",
        "resolution",
        "sourceId",
        "note"
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mondaiId": {
          "type": "string",
          "format": "uuid"
        },
        "questionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true
