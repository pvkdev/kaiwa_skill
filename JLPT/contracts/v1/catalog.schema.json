{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harumi:jlpt-exam:catalog:1.3.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.1.0",
        "1.2.0",
        "1.3.0"
      ]
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "packageId": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[:\\\\]).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "packageId",
          "revision",
          "path",
          "sha256"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "packages"
  ]
}
