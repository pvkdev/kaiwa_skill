{
  "stage_uid": "e940faf8-8936-5ab8-a0a5-4ce5d3655b3d",
  "items": [
    {
      "item_id": "sj-thuong-03-b18-2011",
      "practice": [
        {
          "id": "sj-thuong-03-b18-2011-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f374becb-c849-5ec2-a8d8-2ed37bff3ff9",
          "situation_uid": "99d1fc55-8e81-52cf-a621-1f6e286475ee",
          "context_vi": "Khách đồng ý xem demo và hỏi địa điểm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đầu mối đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "実際の業務画面を見ながらご説明に伺いたいのですが、来週はいかがでしょうか。",
              "vi": "Tôi muốn đến giải thích trên màn hình nghiệp vụ thực tế; tuần sau anh có tiện không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "火曜の午後なら空いています。",
              "vi": "Chiều thứ Ba tôi còn trống."
            }
          ]
        },
        {
          "id": "sj-thuong-03-b18-2011-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d831b8f0-b333-5dac-ac20-4162c8fb30b2",
          "situation_uid": "2e1bb071-de92-53d9-b78d-14c0bb3ab3ba",
          "context_vi": "Lĩnh vực mới cần người chuyên môn dự cuộc gặp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đầu mối đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "弊社の技術担当と一緒に、一度そちらへ伺ってもよろしいでしょうか。",
              "vi": "Tôi cùng chuyên viên kỹ thuật tới chỗ anh một lần được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。参加者を確認します。",
              "vi": "Được. Tôi sẽ xác nhận người tham dự."
            }
          ]
        },
        {
          "id": "sj-thuong-03-b18-2011-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f374becb-c849-5ec2-a8d8-2ed37bff3ff9",
          "situation_uid": "f93b7f76-7ba1-5d97-a17e-836270853855",
          "context_vi": "Hỏi nơi đến để gặp người dùng thực tế.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đầu mối đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "現場の方にお話を伺いに、どちらへ伺えばよろしいでしょうか。",
              "vi": "Để nghe người làm thực tế chia sẻ, tôi nên đến địa điểm nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "第二工場の受付にお越しください。",
              "vi": "Xin đến quầy tiếp tân nhà máy số hai."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-03-b06-681",
      "practice": [
        {
          "id": "sj-thuong-03-b06-681-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f374becb-c849-5ec2-a8d8-2ed37bff3ff9",
          "situation_uid": "6431d05f-7774-51c1-b887-4c90d5861150",
          "context_vi": "Đầu mối cần hỏi nhóm sử dụng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đầu mối đối tác",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "利用部門に確認してからお返事します。",
              "vi": "Tôi sẽ hỏi bộ phận sử dụng rồi trả lời."
            },
            {
              "speaker_id": "B",
              "ja": "承知しました。では、来週水曜までに追ってご連絡します。",
              "vi": "Tôi hiểu. Vậy tôi sẽ liên hệ lại trước thứ Tư tuần sau."
            }
          ]
        },
        {
          "id": "sj-thuong-03-b06-681-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d831b8f0-b333-5dac-ac20-4162c8fb30b2",
          "situation_uid": "79831a27-7a98-584d-9f00-195441eb676e",
          "context_vi": "Đối tác chưa biết ý lãnh đạo.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đầu mối đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご意向が分かり次第、追ってご連絡します。いつごろ確認できそうでしょうか。",
              "vi": "Khi biết ý kiến, tôi sẽ liên hệ lại. Khoảng khi nào anh có thể xác nhận ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "金曜には分かると思います。",
              "vi": "Có lẽ thứ Sáu sẽ biết."
            }
          ]
        },
        {
          "id": "sj-thuong-03-b06-681-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c74bcd59-aa7d-510c-8001-149a4d5f2ec5",
          "situation_uid": "321865ae-eebe-5f3a-ab38-d60a47799879",
          "context_vi": "Người nghe muốn kiểm độ tin cậy số liệu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đầu mối đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "集計条件を確認し、追ってご連絡します。明日の夕方までお時間をいただけますか。",
              "vi": "Tôi sẽ kiểm tra điều kiện thống kê rồi liên hệ lại. Xin anh cho tôi thời gian tới chiều mai được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "それなら待てます。",
              "vi": "Nếu vậy tôi đợi được."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-03-b20-478",
      "practice": [
        {
          "id": "sj-thuong-03-b20-478-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f374becb-c849-5ec2-a8d8-2ed37bff3ff9",
          "situation_uid": "64e74e85-eaf9-5ee5-bb55-ea802f015b47",
          "context_vi": "Bàn nội bộ việc xin giới thiệu người phụ trách khó tiếp cận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先方の現場責任者を紹介してもらえるかな。",
              "vi": "Liệu họ có giới thiệu người phụ trách hiện trường không?"
            },
            {
              "speaker_id": "B",
              "ja": "ダメ元でお願いしてみます。断られたら、まず窓口の方のお話を聞きます。",
              "vi": "Tôi sẽ thử đề nghị, dù khả năng thấp. Nếu bị từ chối, trước hết tôi sẽ nghe đầu mối chia sẻ."
            }
          ]
        },
        {
          "id": "sj-thuong-03-b20-478-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d831b8f0-b333-5dac-ac20-4162c8fb30b2",
          "situation_uid": "6bed3bb4-cbf0-5e7a-bbfd-ead4f04911a7",
          "context_vi": "Đối tác chưa ưu tiên hợp tác lĩnh vực này.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今年は優先外だそうです。",
              "vi": "Họ nói năm nay lĩnh vực này chưa được ưu tiên."
            },
            {
              "speaker_id": "B",
              "ja": "ダメ元で別の分野も聞いてみよう。ただ、押しつけないように。",
              "vi": "Ta cứ thử hỏi thêm lĩnh vực khác dù khó được. Nhưng đừng ép họ."
            }
          ]
        },
        {
          "id": "sj-thuong-03-b20-478-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c74bcd59-aa7d-510c-8001-149a4d5f2ec5",
          "situation_uid": "5ce19c9b-e693-5068-af86-22efcd77024e",
          "context_vi": "Có số liệu mới, bàn xin trình lại phương án.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前回は人手の問題で見送りになったよね。",
              "vi": "Lần trước họ hoãn vì thiếu nhân sự nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "はい。新しい試算が出たので、ダメ元でもう一度ご相談したいです。",
              "vi": "Vâng. Nay có số liệu tính toán mới, tôi muốn thử đề nghị lại dù khó được."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-03-b12-1111",
      "practice": [
        {
          "id": "sj-thuong-03-b12-1111-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f374becb-c849-5ec2-a8d8-2ed37bff3ff9",
          "situation_uid": "f74efc74-373b-5bce-a875-9374afdc4202",
          "context_vi": "Khách không muốn thay toàn bộ hệ thống.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đầu mối đối tác",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今の仕組みは残したいんです。",
              "vi": "Chúng tôi muốn giữ hệ thống hiện tại."
            },
            {
              "speaker_id": "B",
              "ja": "それなら、配送の部分だけ試す案はいかがでしょうか。",
              "vi": "Nếu vậy, phương án chỉ thử phần giao hàng thì sao ạ?"
            }
          ]
        },
        {
          "id": "sj-thuong-03-b12-1111-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d831b8f0-b333-5dac-ac20-4162c8fb30b2",
          "situation_uid": "b16febf8-66b0-5118-8b80-3a4d529da11f",
          "context_vi": "Đối tác muốn bắt đầu bằng dự án nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đầu mối đối tác",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まず小さく試したいです。",
              "vi": "Trước hết chúng tôi muốn thử ở quy mô nhỏ."
            },
            {
              "speaker_id": "B",
              "ja": "それなら、一部署だけで一か月試して、結果を一緒に見ませんか。",
              "vi": "Nếu vậy, ta thử trong một bộ phận một tháng rồi cùng xem kết quả nhé?"
            }
          ]
        },
        {
          "id": "sj-thuong-03-b12-1111-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c74bcd59-aa7d-510c-8001-149a4d5f2ec5",
          "situation_uid": "2ea9bf92-dcb7-5c6b-931e-9309b262fe72",
          "context_vi": "Đối tác hiện không có người triển khai.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đầu mối đối tác",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên kinh doanh",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今月は担当者を出せません。",
              "vi": "Tháng này chúng tôi không bố trí người phụ trách được."
            },
            {
              "speaker_id": "B",
              "ja": "それなら、試験開始を来月に延ばす方が現実的でしょうか。",
              "vi": "Nếu vậy, dời bắt đầu thử sang tháng sau có thực tế hơn không ạ?"
            }
          ]
        }
      ]
    }
  ]
}
