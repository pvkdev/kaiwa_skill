{
  "stage_uid": "c31a0445-27d9-5df6-b64f-ddfedf78e253",
  "items": [
    {
      "item_id": "sj-thuong-14-b12-1741",
      "practice": [
        {
          "id": "sj-thuong-14-b12-1741-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "22840572-0228-51e3-a068-ef0e18149953",
          "situation_uid": "a055cb36-3f8c-598d-8fa7-4f48826b2463",
          "context_vi": "Chưa rõ phạm vi việc được nhờ, xin trả lời sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhờ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người được nhờ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日までに全部見てもらえる？",
              "vi": "Mai chị xem hết giúp tôi được không?"
            },
            {
              "speaker_id": "B",
              "ja": "範囲を確認してから、お返事させてもらってもいいですか。今日の夕方までに連絡します。",
              "vi": "Cho tôi kiểm phạm vi rồi trả lời được không? Chiều nay tôi sẽ liên hệ."
            }
          ]
        },
        {
          "id": "sj-thuong-14-b12-1741-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "22840572-0228-51e3-a068-ef0e18149953",
          "situation_uid": "bf23c085-2c64-5092-9af4-a84af03432c6",
          "context_vi": "Nhận một bước, để người nhờ làm bước khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người được nhờ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhờ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "資料の整理は私にさせてもらえますか。最終確認はご自身でお願いします。",
              "vi": "Cho tôi phụ trách việc sắp xếp tài liệu được không? Phần kiểm tra cuối nhờ anh tự làm."
            },
            {
              "speaker_id": "B",
              "ja": "分かった。最後は僕が見る。",
              "vi": "Được. Phần cuối tôi sẽ xem."
            }
          ]
        },
        {
          "id": "sj-thuong-14-b12-1741-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "5803d6d8-acf2-5dca-ae18-09e6b990a37e",
          "situation_uid": "0afbfb76-5051-57fe-b0d3-b04fe6e6bf22",
          "context_vi": "Được mời phát biểu nhưng chưa sẵn sàng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người điều phối",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一言お話しいただけますか。",
              "vi": "Anh phát biểu đôi lời được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "急なことで準備がなく、今日はご挨拶だけにさせていただけますか。",
              "vi": "Vì được mời bất ngờ nên tôi chưa chuẩn bị. Hôm nay xin phép chỉ chào mọi người thôi được không?"
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-14-b06-1108",
      "practice": [
        {
          "id": "sj-thuong-14-b06-1108-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "22840572-0228-51e3-a068-ef0e18149953",
          "situation_uid": "9f12319f-729f-5834-86b1-b23346efab53",
          "context_vi": "Trước khi rời cuộc nói, nhắc chưa nhận việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhờ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người được nhờ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "では、お願いできるんですね。",
              "vi": "Vậy là chị nhận giúp rồi nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "いえ、まだ決めていません。内容を持ち帰って検討します。明日お返事します。",
              "vi": "Chưa, tôi vẫn chưa quyết. Tôi sẽ mang nội dung về xem xét và trả lời ngày mai."
            }
          ]
        },
        {
          "id": "sj-thuong-14-b06-1108-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "46b1d5c2-5641-59da-bc79-3235b47edacc",
          "situation_uid": "754df16d-2d2f-5460-b2be-b27164b4c30c",
          "context_vi": "Tin khác nhau, chờ trước khi kết luận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người được nhờ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どちらの説明を信じる？",
              "vi": "Cậu tin lời bên nào?"
            },
            {
              "speaker_id": "B",
              "ja": "まだ証拠がないので、記録を見てから検討します。",
              "vi": "Chưa có chứng cứ nên tôi sẽ xem hồ sơ rồi mới cân nhắc."
            }
          ]
        },
        {
          "id": "sj-thuong-14-b06-1108-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "5803d6d8-acf2-5dca-ae18-09e6b990a37e",
          "situation_uid": "f8dd9ff5-4ceb-5dbb-8005-55dbbfe7e86e",
          "context_vi": "Chưa chắc có phát biểu trong lễ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người điều phối",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご挨拶をお願いできますか。",
              "vi": "Có thể nhờ anh phát biểu không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "日程を確認して検討します。金曜までにお返事してもよろしいですか。",
              "vi": "Tôi sẽ kiểm lịch rồi cân nhắc. Cho tôi trả lời trước thứ Sáu được không ạ?"
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-14-b06-1360",
      "practice": [
        {
          "id": "sj-thuong-14-b06-1360-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "22840572-0228-51e3-a068-ef0e18149953",
          "situation_uid": "c3e66a26-a48f-5235-ac23-5a75fcb04362",
          "context_vi": "Không nhận thêm việc vì trách nhiệm đang có.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhờ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người được nhờ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今週、もう一件お願いできない？",
              "vi": "Tuần này chị nhận thêm một việc được không?"
            },
            {
              "speaker_id": "B",
              "ja": "今の担当を終えずに新しい件も引き受ける、そういうわけにはいきません。来週なら相談できます。",
              "vi": "Tôi không thể nhận thêm khi việc đang phụ trách chưa xong. Tuần sau ta có thể bàn."
            }
          ]
        },
        {
          "id": "sj-thuong-14-b06-1360-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "46b1d5c2-5641-59da-bc79-3235b47edacc",
          "situation_uid": "30be552b-c6f2-52cb-8aad-beb6ec9a31ce",
          "context_vi": "Đối tác không đổi mốc, đặt giới hạn hỗ trợ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người được nhờ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日中に全部直してほしい。",
              "vi": "Tôi muốn sửa hết trong hôm nay."
            },
            {
              "speaker_id": "B",
              "ja": "確認を飛ばして全部出す、そういうわけにはいきません。重要な一件からなら対応できます。",
              "vi": "Tôi không thể bỏ khâu kiểm rồi gửi hết. Tôi có thể xử lý trường hợp quan trọng nhất trước."
            }
          ]
        },
        {
          "id": "sj-thuong-14-b06-1360-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "5803d6d8-acf2-5dca-ae18-09e6b990a37e",
          "situation_uid": "9696721c-a835-5bfc-9646-7edf40479d4d",
          "context_vi": "Người nhà chưa muốn nói tại tang lễ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhờ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người được nhờ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今、詳しく聞いてもいい？",
              "vi": "Bây giờ anh hỏi kỹ được không?"
            },
            {
              "speaker_id": "B",
              "ja": "今はそういうわけにはいかないと思います。静かにして、必要なことだけ手伝いましょう。",
              "vi": "Giờ tôi nghĩ chưa thích hợp. Ta cứ yên lặng và chỉ giúp những việc cần."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-14-b20-2487",
      "practice": [
        {
          "id": "sj-thuong-14-b20-2487-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "22840572-0228-51e3-a068-ef0e18149953",
          "situation_uid": "9f67e5e6-36fb-532a-8b70-70405209b926",
          "context_vi": "Việc mới vượt phạm vi đã nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người được nhờ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "依頼者は今日中を望み、チームは確認に二日必要です。板ばさみなので、まず優先順位を決めていただけますか。",
              "vi": "Người nhờ muốn xong hôm nay, nhóm cần hai ngày kiểm tra. Tôi đang kẹt giữa hai bên, anh giúp quyết ưu tiên được không?"
            },
            {
              "speaker_id": "B",
              "ja": "両方に現状を説明しよう。",
              "vi": "Ta sẽ giải thích tình hình cho cả hai."
            }
          ]
        },
        {
          "id": "sj-thuong-14-b20-2487-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "46b1d5c2-5641-59da-bc79-3235b47edacc",
          "situation_uid": "9144c4ad-63c7-5797-a6d4-86edf0c1a067",
          "context_vi": "Hai người đưa tin mốc khác nhau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người được nhờ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "営業は明日、開発は来週と言っています。板ばさみで返事ができません。誰が最終日程を決めますか。",
              "vi": "Bên kinh doanh nói mai, bên phát triển nói tuần sau. Tôi kẹt giữa hai bên nên chưa thể trả lời. Ai sẽ chốt lịch cuối?"
            },
            {
              "speaker_id": "B",
              "ja": "共通の責任者に確認しよう。",
              "vi": "Hãy hỏi người phụ trách chung."
            }
          ]
        },
        {
          "id": "sj-thuong-14-b20-2487-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "5803d6d8-acf2-5dca-ae18-09e6b990a37e",
          "situation_uid": "eb3670ba-d4da-5cd1-8d60-c648e66f35ee",
          "context_vi": "Người phát biểu được mời lên sớm hơn lịch.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người điều phối",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご家族は後で話してほしいそうですが、進行表では今ですね。板ばさみで困っています。",
              "vi": "Gia đình muốn phát biểu sau, nhưng chương trình ghi ngay lúc này. Tôi đang kẹt giữa hai phía."
            },
            {
              "speaker_id": "B",
              "ja": "順番を確認します。少々お待ちください。",
              "vi": "Tôi sẽ xác nhận thứ tự. Xin chờ một chút."
            }
          ]
        }
      ]
    }
  ]
}
