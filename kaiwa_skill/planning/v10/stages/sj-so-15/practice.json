{
  "stage_uid": "ddbb1dc6-1637-5895-8bc9-acaa0a37d88d",
  "items": [
    {
      "item_id": "sj-so-15-b12-10",
      "practice": [
        {
          "id": "sj-so-15-b12-10-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "49225882-4d10-5fca-9d88-49cda19b641b",
          "context_vi": "Bạn thân hỏi lịch trước khi rủ uống cà phê.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日の放課後は？",
              "vi": "Chiều mai tan học cậu có lịch gì không?"
            },
            {
              "speaker_id": "B",
              "ja": "特に予定ないよ。",
              "vi": "Tớ không có kế hoạch gì đặc biệt."
            },
            {
              "speaker_id": "A",
              "ja": "じゃ、カフェに行かない？",
              "vi": "Vậy đi cà phê nhé?"
            }
          ]
        },
        {
          "id": "sj-so-15-b12-10-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "c28aaabf-8851-5728-802d-383ffef13ca4",
          "context_vi": "Bạn thân hỏi ai sẽ đặt chỗ cho buổi gặp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "予約は？",
              "vi": "Còn chuyện đặt chỗ thì sao?"
            },
            {
              "speaker_id": "B",
              "ja": "私がしておくよ。",
              "vi": "Để tớ đặt trước."
            }
          ]
        },
        {
          "id": "sj-so-15-b12-10-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "b512b1cd-5e9b-5766-814a-e0d06df64341",
          "context_vi": "Hai bạn đã chọn ngày, còn hỏi điểm gặp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "待ち合わせ場所は？",
              "vi": "Thế mình gặp ở đâu?"
            },
            {
              "speaker_id": "B",
              "ja": "駅の北口にしよう。",
              "vi": "Gặp ở cổng bắc nhà ga nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-15-b12-11",
      "practice": [
        {
          "id": "sj-so-15-b12-11-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "d98886ad-41b8-569d-afda-a1396ef86df5",
          "context_vi": "Bạn không muốn xem phim, người rủ đề xuất đi dạo.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "映画はちょっと気分じゃないな。",
              "vi": "Hôm nay tớ không muốn xem phim lắm."
            },
            {
              "speaker_id": "B",
              "ja": "じゃ、公園を歩くのはどう？",
              "vi": "Vậy đi dạo trong công viên thì sao?"
            }
          ]
        },
        {
          "id": "sj-so-15-b12-11-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "8a26a1a8-c8b3-5091-b59f-00eb345eb0c8",
          "context_vi": "Hai người nhầm thứ bảy tuần này, một người đề xuất tuần sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今週の土曜日は仕事なんだ。",
              "vi": "Thứ Bảy tuần này tớ phải làm."
            },
            {
              "speaker_id": "B",
              "ja": "じゃ、来週の土曜日はどう？",
              "vi": "Vậy thứ Bảy tuần sau thì sao?"
            },
            {
              "speaker_id": "A",
              "ja": "来週なら空いてる。",
              "vi": "Tuần sau thì tớ rảnh."
            }
          ]
        },
        {
          "id": "sj-so-15-b12-11-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "408cab06-36da-5ee2-8064-e74dd680b1ce",
          "context_vi": "Bạn muốn gặp nơi gần hơn vì khó đi xa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は駅の向こうまで行けないんだ。",
              "vi": "Hôm nay tớ không sang bên kia ga được."
            },
            {
              "speaker_id": "B",
              "ja": "じゃ、駅前のカフェはどう？",
              "vi": "Vậy quán cà phê trước ga thì sao?"
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-15-b07-86",
      "practice": [
        {
          "id": "sj-so-15-b07-86-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "c9a4fe00-2e60-50c7-9317-b83be060845e",
          "context_vi": "Người mới quen nghe nhóm sắp đi dạo.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mới quen",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người rủ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "公園へ行かれるんですね。私もご一緒していいですか。",
              "vi": "Mọi người sắp đi công viên ạ? Tôi đi cùng được không?"
            },
            {
              "speaker_id": "B",
              "ja": "もちろんです。ご一緒しましょう。",
              "vi": "Tất nhiên rồi. Cùng đi nhé."
            }
          ]
        },
        {
          "id": "sj-so-15-b07-86-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a5628393-ffaa-59fd-9447-b86310deae6b",
          "situation_uid": "14a42ba7-d32f-52fe-ad6e-f9d65be51375",
          "context_vi": "Đồng nghiệp xin đi cùng tới sự kiện công ty.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người tổ chức",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私も会場までご一緒していいですか。",
              "vi": "Tôi đi cùng chị tới địa điểm tổ chức được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、五時に出ますよ。",
              "vi": "Được, năm giờ tôi đi nhé."
            }
          ]
        },
        {
          "id": "sj-so-15-b07-86-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "3c4f01a5-61c4-5739-867d-19ad1ea7e43d",
          "context_vi": "Bạn kể lần sau sẽ đi dạo, người học xin tham gia.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người học",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "次は私もご一緒していいですか。",
              "vi": "Lần sau cho tớ đi cùng được không?"
            },
            {
              "speaker_id": "B",
              "ja": "もちろん。日が決まったら連絡するね。",
              "vi": "Tất nhiên. Chốt ngày rồi tớ báo nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-15-b07-94",
      "practice": [
        {
          "id": "sj-so-15-b07-94-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "4f84ab0c-e7a3-5538-9451-4dc4cc1d903e",
          "context_vi": "Bạn mời đi chơi nhưng người kia không thể.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người được rủ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "日曜日、一緒に出かけない？",
              "vi": "Chủ nhật đi chơi cùng không?"
            },
            {
              "speaker_id": "B",
              "ja": "ごめん、今回は遠慮しとくね。また誘って。",
              "vi": "Xin lỗi, lần này tớ xin thôi nhé. Lần sau lại rủ tớ."
            }
          ]
        },
        {
          "id": "sj-so-15-b07-94-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a5628393-ffaa-59fd-9447-b86310deae6b",
          "situation_uid": "075b5679-79a0-5d89-8401-b188e5fba3f2",
          "context_vi": "Đồng nghiệp không dự được buổi mừng người mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mời",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日の歓迎会、来られますか。",
              "vi": "Mai anh đến buổi mừng người mới được không?"
            },
            {
              "speaker_id": "B",
              "ja": "すみません。今回は遠慮しときます。皆さんによろしくお伝えください。",
              "vi": "Xin lỗi, lần này tôi xin không tham gia. Nhờ chị gửi lời chào tới mọi người."
            }
          ]
        },
        {
          "id": "sj-so-15-b07-94-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a5628393-ffaa-59fd-9447-b86310deae6b",
          "situation_uid": "dadc61cd-5e36-52b2-9531-713f443a7ebe",
          "context_vi": "Đồng nghiệp từ chối rượu nhưng chọn nước không cồn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mời",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ビールはいかがですか。",
              "vi": "Chị uống bia không?"
            },
            {
              "speaker_id": "B",
              "ja": "お酒は今回は遠慮しときます。お茶をお願いします。",
              "vi": "Lần này tôi xin không uống rượu. Cho tôi trà nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-15-b11-5",
      "practice": [
        {
          "id": "sj-so-15-b11-5-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "a7d6a38b-9110-5b82-8e20-ee66b4efcbef",
          "context_vi": "Bạn nói chưa chắc lịch, người kia hỏi thêm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "土曜日はまだわからないんだ。",
              "vi": "Thứ Bảy tớ vẫn chưa rõ lịch."
            },
            {
              "speaker_id": "B",
              "ja": "いつわかるの？",
              "vi": "Khi nào cậu biết?"
            },
            {
              "speaker_id": "A",
              "ja": "金曜日の夜かな。",
              "vi": "Chắc tối thứ Sáu."
            }
          ]
        },
        {
          "id": "sj-so-15-b11-5-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "ecab7954-0bf1-557f-807a-1e8f737e39b1",
          "context_vi": "Bạn báo sẽ đến trễ, người kia hỏi lý do.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日、少し遅れる。",
              "vi": "Hôm nay tớ đến trễ một chút."
            },
            {
              "speaker_id": "B",
              "ja": "どうしたの？",
              "vi": "Có chuyện gì vậy?"
            },
            {
              "speaker_id": "A",
              "ja": "電車が止まってるんだ。",
              "vi": "Tàu đang dừng chạy."
            }
          ]
        },
        {
          "id": "sj-so-15-b11-5-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "c28aaabf-8851-5728-802d-383ffef13ca4",
          "context_vi": "Bạn nói sẽ đặt chỗ, người kia hỏi đã đặt chưa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "店は私が予約するね。",
              "vi": "Để tớ đặt quán nhé."
            },
            {
              "speaker_id": "B",
              "ja": "もう予約したの？",
              "vi": "Cậu đặt rồi à?"
            },
            {
              "speaker_id": "A",
              "ja": "まだ。今から電話する。",
              "vi": "Chưa. Giờ tớ gọi đây."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-15-b07-193",
      "practice": [
        {
          "id": "sj-so-15-b07-193-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "4f84ab0c-e7a3-5538-9451-4dc4cc1d903e",
          "context_vi": "Người được rủ bận nên xin dịp khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người rủ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今夜、映画に行かない？",
              "vi": "Tối nay đi xem phim không?"
            },
            {
              "speaker_id": "B",
              "ja": "今日は用事があるの。また誘ってね。",
              "vi": "Hôm nay tớ có việc. Lần sau lại rủ tớ nhé."
            }
          ]
        },
        {
          "id": "sj-so-15-b07-193-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a5628393-ffaa-59fd-9447-b86310deae6b",
          "situation_uid": "075b5679-79a0-5d89-8401-b188e5fba3f2",
          "context_vi": "Đồng nghiệp không dự tiệc, vẫn mong được mời lần tới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mời",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "金曜日の歓迎会はどうですか。",
              "vi": "Buổi mừng người mới thứ Sáu anh tham gia được không?"
            },
            {
              "speaker_id": "B",
              "ja": "今週は難しいです。また誘ってください。",
              "vi": "Tuần này tôi khó đi được. Lần sau chị lại rủ nhé."
            }
          ]
        },
        {
          "id": "sj-so-15-b07-193-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "3c4f01a5-61c4-5739-867d-19ad1ea7e43d",
          "context_vi": "Sau buổi đi chơi vui, người học muốn được đi tiếp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は楽しかったね。",
              "vi": "Hôm nay vui nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "うん。また誘ってね。",
              "vi": "Ừ. Lần sau lại rủ tớ nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-15-b07-100",
      "practice": [
        {
          "id": "sj-so-15-b07-100-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fc909d53-7e48-5392-9f3b-c227dd7779ab",
          "situation_uid": "a7d6a38b-9110-5b82-8e20-ee66b4efcbef",
