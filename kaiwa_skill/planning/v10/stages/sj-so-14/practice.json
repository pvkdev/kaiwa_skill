{
  "stage_uid": "5c6344fa-dc2e-5bb9-89d7-b54ff790a17e",
  "items": [
    {
      "item_id": "sj-so-14-b24-75",
      "practice": [
        {
          "id": "sj-so-14-b24-75-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "896b059b-46bd-541e-9ccb-4a8587e5517c",
          "situation_uid": "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644",
          "context_vi": "Người xin việc chờ đến giờ phỏng vấn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Ứng viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もうすぐ面接だから、ドキドキする。",
              "vi": "Sắp phỏng vấn rồi, tớ hồi hộp quá."
            },
            {
              "speaker_id": "B",
              "ja": "ゆっくり話せば大丈夫だよ。",
              "vi": "Cứ nói chậm rãi là ổn thôi."
            }
          ]
        },
        {
          "id": "sj-so-14-b24-75-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "896b059b-46bd-541e-9ccb-4a8587e5517c",
          "situation_uid": "53e2d7e7-f934-51f9-9f9a-50c65a7f553c",
          "context_vi": "Ứng viên bước vào và thừa nhận đang hồi hộp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phỏng vấn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Ứng viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "緊張していますか。",
              "vi": "Em có hồi hộp không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、少しドキドキしています。",
              "vi": "Vâng, em hơi hồi hộp ạ."
            }
          ]
        },
        {
          "id": "sj-so-14-b24-75-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a846871a-5f66-5f30-a0bf-6df2c63d40b6",
          "situation_uid": "bacf91e7-64d6-5e86-9f25-563bc9a3634f",
          "context_vi": "Nhân viên lần đầu nhận ca một mình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên mới",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初めて一人でレジに立つから、ドキドキするよ。",
              "vi": "Lần đầu đứng quầy thu ngân một mình nên tớ hồi hộp quá."
            },
            {
              "speaker_id": "B",
              "ja": "困ったら呼んでね。",
              "vi": "Có gì khó cứ gọi tớ nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-14-b06-8",
      "practice": [
        {
          "id": "sj-so-14-b06-8-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "896b059b-46bd-541e-9ccb-4a8587e5517c",
          "situation_uid": "d4120b7f-9d49-53be-97fe-cb94a1adc9bc",
          "context_vi": "Ứng viên chưa từng làm việc được hỏi, người phỏng vấn trấn an.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Ứng viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người phỏng vấn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この仕事は初めてです。覚えられるか心配です。",
              "vi": "Đây là lần đầu em làm việc này. Em lo không biết có nhớ nổi không."
            },
            {
              "speaker_id": "B",
              "ja": "あわてなくていいですよ。少しずつ覚えてください。",
              "vi": "Không cần vội. Em cứ học từng chút một."
            }
          ]
        },
        {
          "id": "sj-so-14-b06-8-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a846871a-5f66-5f30-a0bf-6df2c63d40b6",
          "situation_uid": "9ce94693-dc04-576f-96c0-c1fd1b5d51cb",
          "context_vi": "Người mới hoảng vì quầy đông khi đồng nghiệp vắng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên mới",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng ca",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お客さんが多くて、何からすればいいですか。",
              "vi": "Khách đông quá, em nên làm gì trước ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "あわてなくていいよ。まず会計をお願い。",
              "vi": "Không cần cuống. Trước hết em lo thanh toán nhé."
            }
          ]
        },
        {
          "id": "sj-so-14-b06-8-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a846871a-5f66-5f30-a0bf-6df2c63d40b6",
          "situation_uid": "f5683080-b192-58bc-b732-156deeeed27b",
          "context_vi": "Ca thay nhận nhiều việc tồn, người trước dặn xử lý từng việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên ca sau",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên ca trước",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まだ三件あるんですね。急いでやります。",
              "vi": "Vẫn còn ba việc nhỉ. Tôi sẽ làm nhanh."
            },
            {
              "speaker_id": "B",
              "ja": "あわてなくていいよ。まずこの一件から。",
              "vi": "Không cần vội. Bắt đầu từ việc này trước."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-14-b07-123",
      "practice": [
        {
          "id": "sj-so-14-b07-123-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "896b059b-46bd-541e-9ccb-4a8587e5517c",
          "situation_uid": "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644",
          "context_vi": "Bạn chúc người sắp đi phỏng vấn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Ứng viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "これから面接に行くよ。",
              "vi": "Giờ tớ đi phỏng vấn đây."
            },
            {
              "speaker_id": "B",
              "ja": "頑張ってね。終わったら教えて。",
              "vi": "Cố lên nhé. Xong rồi kể tớ nghe."
            }
          ]
        },
        {
          "id": "sj-so-14-b07-123-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "896b059b-46bd-541e-9ccb-4a8587e5517c",
          "situation_uid": "27fc1d64-32f8-5f54-8a78-b9b141b21a6c",
          "context_vi": "Ứng viên nhận việc và sắp đến ngày đầu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Ứng viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người quen",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来週から働き始めます。",
              "vi": "Tuần sau tôi bắt đầu đi làm ạ."
            },
            {
              "speaker_id": "B",
              "ja": "そうですか。頑張ってください。",
              "vi": "Vậy à. Chúc chị cố gắng nhé."
            }
          ]
        },
        {
          "id": "sj-so-14-b07-123-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a846871a-5f66-5f30-a0bf-6df2c63d40b6",
          "situation_uid": "bacf91e7-64d6-5e86-9f25-563bc9a3634f",
          "context_vi": "Đồng nghiệp động viên người nhận ca mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên mới",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日、初めて朝の担当なんだ。",
              "vi": "Hôm nay lần đầu tớ trực ca sáng."
            },
            {
              "speaker_id": "B",
              "ja": "頑張って。わからなかったら聞いてね。",
              "vi": "Cố lên. Không rõ thì cứ hỏi tớ nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-14-b07-165",
      "practice": [
        {
          "id": "sj-so-14-b07-165-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a846871a-5f66-5f30-a0bf-6df2c63d40b6",
          "situation_uid": "2a78d690-e6f7-5889-ad31-d01fa7a7e93d",
          "context_vi": "Khách đang đợi hỏi thời gian, nhân viên đáp và xử lý.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あと何分ぐらいかかりますか。",
              "vi": "Còn khoảng mấy phút nữa ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "かしこまりました。確認いたします。",
              "vi": "Vâng ạ. Tôi sẽ kiểm tra."
            }
          ]
        },
        {
          "id": "sj-so-14-b07-165-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "896b059b-46bd-541e-9ccb-4a8587e5517c",
          "situation_uid": "dda5f59c-f491-5857-b2e0-bc5c0fe6b20d",
          "context_vi": "Người tuyển dụng đề nghị lễ tân sắp giờ phỏng vấn cho ứng viên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người tuyển dụng",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Lễ tân",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この方を三時の面接へご案内してください。",
              "vi": "Anh dẫn người này tới buổi phỏng vấn lúc ba giờ nhé."
            },
            {
              "speaker_id": "B",
              "ja": "かしこまりました。こちらへどうぞ。",
              "vi": "Vâng ạ. Xin mời đi lối này."
            }
          ]
        },
        {
          "id": "sj-so-14-b07-165-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a846871a-5f66-5f30-a0bf-6df2c63d40b6",
          "situation_uid": "f5683080-b192-58bc-b732-156deeeed27b",
          "context_vi": "Khách nhờ ca mới kiểm tra đơn còn chờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "さっき頼んだ商品を確認してもらえますか。",
              "vi": "Chị kiểm giúp món hàng tôi đã nhờ lúc nãy được không?"
            },
            {
              "speaker_id": "B",
              "ja": "かしこまりました。担当に確認します。",
              "vi": "Vâng ạ. Tôi sẽ hỏi người phụ trách."
            }
          ]
        }
      ]
    }
  ]
}
