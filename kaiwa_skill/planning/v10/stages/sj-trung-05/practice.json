{
  "stage_uid": "fb719610-dd58-55c9-b7a5-94c315edd295",
  "items": [
    {
      "item_id": "sj-trung-05-b06-131",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xe chuyển nhà đến muộn, hỏi tình trạng hiện tại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "車がまだ来ていません。今どうなっていますか。",
              "vi": "Xe vẫn chưa tới. Hiện giờ tình hình thế nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "渋滞で、あと二十分ほどかかります。",
              "vi": "Do tắc đường, khoảng hai mươi phút nữa xe tới."
            }
          ],
          "id": "sj-trung-05-b06-131-ex01",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "e8fe1f83-ff00-5ff2-b73d-0de9cd967468"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi tiến độ tìm thùng đồ thất lạc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨日お願いした箱の確認は、どうなっていますか。",
              "vi": "Việc kiểm tra thùng đồ tôi nhờ hôm qua đã đến đâu rồi ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "倉庫を確認中で、夕方にご連絡します。",
              "vi": "Chúng tôi đang kiểm tra kho, chiều sẽ liên lạc lại."
            }
          ],
          "id": "sj-trung-05-b06-131-ex02",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "e143c7c8-bed5-520b-82bd-eb7025eb1249"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi bạn tình hình xin chỗ đỗ xe.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "管理人さんとの話、どうなってる？",
              "vi": "Chuyện trao đổi với quản lý về chỗ đỗ xe thế nào rồi?"
            },
            {
              "speaker_id": "B",
              "ja": "まだ返事待ちなんだ。",
              "vi": "Vẫn đang chờ trả lời."
            }
          ],
          "id": "sj-trung-05-b06-131-ex03",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "d758851c-0c69-5e1f-aead-d036568402f3"
        }
      ]
    },
    {
      "item_id": "sj-trung-05-b07-89",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Ngắt lại khi nghe báo khoản phí ngoài giá trọn gói.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "梱包材は別料金になります。",
              "vi": "Vật liệu đóng gói tính phí riêng ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ちょっと待ってください。見積もりには含まれていませんか。",
              "vi": "Khoan đã ạ. Khoản đó không nằm trong báo giá sao?"
            }
          ],
          "id": "sj-trung-05-b07-89-ex01",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "350c8968-1c5f-596c-8d37-cbfaa432ee0d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhờ nhân viên chờ trong lúc tìm số trên thùng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ちょっと待ってください。箱の番号を確認します。",
              "vi": "Anh đợi một chút ạ. Tôi xem số trên thùng."
            },
            {
              "speaker_id": "B",
              "ja": "はい、お待ちします。",
              "vi": "Vâng, tôi đợi."
            }
          ],
          "id": "sj-trung-05-b07-89-ex02",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "1d669951-b1d0-5dff-9972-d369284001a3"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Dừng việc bốc đồ để xác nhận lối và giờ mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ちょっと待ってください。先に新しい搬入口を確認しましょう。",
              "vi": "Khoan đã ạ. Ta xác nhận lối chuyển đồ mới trước đã."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。",
              "vi": "Vâng, tôi hiểu."
            }
          ],
          "id": "sj-trung-05-b07-89-ex03",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "52a2ccb1-c73c-5f44-867c-d6fec12f4c1c"
        }
      ]
    },
    {
      "item_id": "sj-trung-05-b06-44",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin dời ngày vì căn mới bàn giao muộn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "勝手を言ってすみませんが、引っ越しを一日延ばせますか。",
              "vi": "Xin lỗi vì yêu cầu riêng, tôi có thể dời ngày chuyển nhà một hôm không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "空きを確認します。",
              "vi": "Tôi sẽ kiểm tra lịch trống."
            }
          ],
          "id": "sj-trung-05-b06-44-ex01",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "bd66b24d-47d5-55d1-ac75-ba1864201bd6"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin bớt dịch vụ vì vượt ngân sách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "勝手を言ってすみません。梱包は自分でする形に変えられますか。",
              "vi": "Xin lỗi vì đưa ra yêu cầu riêng. Tôi có thể tự đóng gói và đổi gói dịch vụ không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、料金を計算し直します。",
              "vi": "Được, tôi sẽ tính lại giá."
            }
          ],
          "id": "sj-trung-05-b06-44-ex02",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "6ade8f75-0e21-53d9-bacc-c520ae723fb7"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi kiểm chi phí, xin đổi phương án tháo tủ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "勝手を言ってすみませんが、棚の解体だけお願いできますか。",
              "vi": "Xin lỗi vì yêu cầu riêng, anh chỉ tháo giúp cái kệ được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、その部分だけ対応します。",
              "vi": "Được, chúng tôi chỉ làm phần đó."
            }
          ],
          "id": "sj-trung-05-b06-44-ex03",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "493b74a3-56f1-531b-bfb9-0600c8ec0a04"
        }
      ]
    },
    {
      "item_id": "sj-trung-05-b18-304",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xác nhận gói chuyển nhà đã chọn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "梱包はお客様ご自身でなさいます。それでよろしいですか。",
              "vi": "Quý khách sẽ tự đóng gói. Như vậy có được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、それで結構です。",
              "vi": "Vâng, như vậy được ạ."
            }
          ],
          "id": "sj-trung-05-b18-304-ex01",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "fce47637-af41-5f1a-92a3-d0f009ca4650"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên kiểm tra giờ và mức giá mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "変更後は十時開始で、こちらの金額です。よろしいでしょうか。",
              "vi": "Sau khi đổi, bắt đầu lúc mười giờ với mức giá này. Chị thấy được chứ ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、それでお願いします。",
              "vi": "Vâng, nhờ anh làm theo phương án đó."
            }
          ],
          "id": "sj-trung-05-b18-304-ex02",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "1aa1b4d4-e337-5396-ae95-e02fdbfaf23d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kiểm tra lối chuyển mới trước khi tiếp tục.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "裏口から運んでもよろしいですか。",
              "vi": "Chúng tôi chuyển qua cửa sau được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、管理人にも確認しました。",
              "vi": "Vâng, tôi đã xác nhận với quản lý rồi."
            }
          ],
          "id": "sj-trung-05-b18-304-ex03",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "52a2ccb1-c73c-5f44-867c-d6fec12f4c1c"
        }
      ]
    },
    {
      "item_id": "sj-trung-05-b12-38",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhắc số thùng rồi bổ sung người đóng gói.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "箱は全部で十二個です。あと、食器は私が包みます。",
              "vi": "Tổng cộng mười hai thùng. À, bát đĩa tôi sẽ tự gói."
            },
            {
              "speaker_id": "B",
              "ja": "承知しました。",
              "vi": "Tôi hiểu rồi ạ."
            }
          ],
          "id": "sj-trung-05-b12-38-ex01",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "a7f175d1-e0b9-5da1-b31a-fd7d98002e99"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xác nhận giờ xe và bổ sung chuyện chỗ đỗ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "車は九時に来ますね。あと、駐車場所はどこになりますか。",
              "vi": "Xe đến lúc chín giờ nhỉ. Thêm nữa, xe sẽ đỗ ở đâu ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "建物の裏です。",
              "vi": "Phía sau tòa nhà ạ."
            }
          ],
          "id": "sj-trung-05-b12-38-ex02",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "fcc0262f-4e56-5161-b0b6-c69a556fae99"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chốt xử lý thùng đã tìm được, thêm cách giao.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "箱は倉庫で見つかりました。明日お届けします。",
              "vi": "Đã tìm thấy thùng trong kho. Ngày mai chúng tôi sẽ giao."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。あと、届く時間が分かったら教えてください。",
              "vi": "Cảm ơn chị. Khi biết giờ giao thì báo giúp tôi nhé."
            }
          ],
          "id": "sj-trung-05-b12-38-ex03",
          "topic_uid": "ff99432c-a861-5d71-aeaa-b4afbb5064d6",
          "situation_uid": "c9db8218-c458-53d9-9bb0-3a3d40c5fce1"
        }
      ]
    }
  ]
}
