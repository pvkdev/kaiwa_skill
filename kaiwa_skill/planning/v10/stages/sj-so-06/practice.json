{
  "stage_uid": "9c99a4d9-3c79-5120-b718-991588708adf",
  "items": [
    {
      "item_id": "sj-so-06-b07-84",
      "practice": [
        {
          "id": "sj-so-06-b07-84-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "569c0e4b-6182-56b1-96ec-5801a1141bd7",
          "situation_uid": "13e0838b-73c9-5c89-9ff2-dc77408cdf05",
          "context_vi": "Khách muốn tách thịt sống khỏi đồ ăn khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thu ngân",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちら、同じ袋に入れますか。",
              "vi": "Tôi bỏ chung vào một túi nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "生のお肉は別の袋でお願いします。",
              "vi": "Xin để thịt sống vào túi riêng giúp tôi ạ."
            }
          ]
        },
        {
          "id": "sj-so-06-b07-84-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "569c0e4b-6182-56b1-96ec-5801a1141bd7",
          "situation_uid": "0445f6d4-b05b-5850-bf67-96035f12d8fd",
          "context_vi": "Khách muốn quầy thịt chia thành hai phần.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "このお肉、二つに分けてお願いします。",
              "vi": "Xin chia phần thịt này làm hai giúp tôi ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、半分ずつにします。",
              "vi": "Vâng, tôi chia đôi nhé."
            }
          ]
        },
        {
          "id": "sj-so-06-b07-84-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "3721c5bf-a609-5d2f-9238-50f780e774bc",
          "context_vi": "Thu ngân chuẩn bị hâm cả hai món, khách nói rõ món cần hâm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thu ngân",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二つとも温めますか。",
              "vi": "Cả hai món đều hâm nóng ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "温めるのはお弁当だけでお願いします。サラダはそのままで。",
              "vi": "Xin chỉ hâm hộp cơm. Salad cứ để nguyên ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-06-b07-85",
      "practice": [
        {
          "id": "sj-so-06-b07-85-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "90bc1607-2c91-54ec-b961-a47bdf1fae43",
          "context_vi": "Khách mua mì và xin đũa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thu ngân",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この麺にお箸を一膳お願いします。",
              "vi": "Xin cho tôi một đôi đũa ăn mì này ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、お付けします。",
              "vi": "Vâng, tôi bỏ vào cho anh."
            }
          ]
        },
        {
          "id": "sj-so-06-b07-85-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "3c2662fb-6157-534d-add9-9934096b51aa",
          "context_vi": "Khách đã được báo có kiện hàng ở cửa hàng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "荷物を受け取りに来ました。お願いします。",
              "vi": "Tôi tới nhận kiện hàng. Nhờ anh giúp ạ."
            },
            {
              "speaker_id": "B",
              "ja": "お名前をお願いします。",
              "vi": "Xin chị cho biết tên ạ."
            }
          ]
        },
        {
          "id": "sj-so-06-b07-85-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "569c0e4b-6182-56b1-96ec-5801a1141bd7",
          "situation_uid": "20ad1af0-c042-53ee-aed0-ae8942b7518e",
          "context_vi": "Khách chốt loại cá và lượng mua.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この鮭を二切れお願いします。",
              "vi": "Xin lấy cho tôi hai lát cá hồi này ạ."
            },
            {
              "speaker_id": "B",
              "ja": "かしこまりました。",
              "vi": "Vâng ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-06-b18-7",
      "practice": [
        {
          "id": "sj-so-06-b18-7-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "be2b597f-4810-50b1-b900-4f8f1ea38544",
          "context_vi": "Nhân viên chỉ đúng nhãn giá, khách chấp nhận món.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらは一つで三百円です。",
              "vi": "Món này giá ba trăm yên một cái ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、その値段で結構です。これをください。",
              "vi": "Vâng, giá đó được ạ. Tôi lấy món này."
            }
          ]
        },
        {
          "id": "sj-so-06-b18-7-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "569c0e4b-6182-56b1-96ec-5801a1141bd7",
          "situation_uid": "97585e1f-f366-55f6-ba86-0071c8065bde",
          "context_vi": "Quầy không còn nhận cắt sẵn nhưng có phần đã đóng gói.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今は切れませんが、こちらの小分けならあります。",
              "vi": "Giờ không cắt được, nhưng có loại chia sẵn này ạ."
            },
            {
              "speaker_id": "B",
              "ja": "それで結構です。",
              "vi": "Loại đó được ạ."
            }
          ]
        },
        {
          "id": "sj-so-06-b18-7-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "30111bbf-02d6-5398-b8a2-717af051a5ab",
          "context_vi": "Món đầu hết, nhân viên gợi món tương đương.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらのサンドイッチなら同じ値段です。",
              "vi": "Bánh kẹp này thì cùng giá ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、それで結構です。",
              "vi": "Vâng, loại đó được ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-06-b18-8",
      "practice": [
        {
          "id": "sj-so-06-b18-8-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "493bca4c-9a5b-5254-a7eb-f251c132d91e",
          "context_vi": "Khách đã mang túi nên từ chối túi cửa hàng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thu ngân",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "袋はいかがですか。",
              "vi": "Anh có cần túi không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "袋は結構です。持ってきました。",
              "vi": "Tôi không cần túi ạ. Tôi có mang rồi."
            }
          ]
        },
        {
          "id": "sj-so-06-b18-8-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "deb5a58e-3545-55e1-8cee-4884e0ecb76f",
          "context_vi": "Khách muốn ăn món lạnh nên từ chối hâm nóng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちら、温めますか。",
              "vi": "Món này chị có muốn hâm nóng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "温めは結構です。冷たいままでお願いします。",
              "vi": "Tôi không cần hâm ạ. Cứ để lạnh giúp tôi."
            }
          ]
        },
        {
          "id": "sj-so-06-b18-8-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "90bc1607-2c91-54ec-b961-a47bdf1fae43",
          "context_vi": "Khách mua cơm nắm và không cần đũa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thu ngân",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お箸はお付けしますか。",
              "vi": "Tôi bỏ đũa vào cho anh nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "お箸は結構です。手で食べます。",
              "vi": "Tôi không cần đũa ạ. Tôi ăn bằng tay."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-06-b11-7",
      "practice": [
        {
          "id": "sj-so-06-b11-7-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "30111bbf-02d6-5398-b8a2-717af051a5ab",
          "context_vi": "Loại bánh lớn đã hết, khách hỏi loại nhỏ hơn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "これの小さいのはありますか。",
              "vi": "Loại này có cỡ nhỏ hơn không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、こちらにあります。",
              "vi": "Có ạ, ở bên này."
            }
          ]
        },
        {
          "id": "sj-so-06-b11-7-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "569c0e4b-6182-56b1-96ec-5801a1141bd7",
          "situation_uid": "9c01138d-0e99-5765-8e0a-88ffc084be91",
          "context_vi": "Khách xem gói lớn và hỏi loại đủ cho hai người.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "これの小さいのはありますか。二人分だけ欲しいんです。",
              "vi": "Loại này có gói nhỏ hơn không ạ? Tôi chỉ cần đủ cho hai người."
            },
            {
              "speaker_id": "B",
              "ja": "はい、こちらが二人分です。",
              "vi": "Có ạ, gói này đủ cho hai người."
            }
          ]
        },
        {
          "id": "sj-so-06-b11-7-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "21fe626f-60ac-5136-8e3c-0507fe4eca99",
          "context_vi": "Khách muốn chọn món không cay trong hai món.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この二つなら、辛くないのはどちらですか。",
              "vi": "Trong hai món này, món nào không cay ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "青いラベルのほうです。",
              "vi": "Loại nhãn xanh ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-06-b07-120",
      "practice": [
        {
          "id": "sj-so-06-b07-120-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "30111bbf-02d6-5398-b8a2-717af051a5ab",
          "context_vi": "Món khách định mua đã hết, khách hỏi món thay thế.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "同じぐらいの値段で、おすすめは何ですか。",
              "vi": "Có món nào tầm giá đó chị gợi ý không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "こちらのおにぎりはいかがですか。",
              "vi": "Anh xem cơm nắm này được không ạ?"
            }
          ]
        },
        {
          "id": "sj-so-06-b07-120-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "569c0e4b-6182-56b1-96ec-5801a1141bd7",
          "situation_uid": "abdf9419-01b8-57b3-ac34-b4dae48a1f58",
          "context_vi": "Khách cần nguyên liệu thay cho cá đã hết.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "魚がないなら、代わりにおすすめは何ですか。",
              "vi": "Nếu hết cá thì anh gợi ý thứ gì thay thế ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "この鶏肉なら同じ料理に使えます。",
              "vi": "Thịt gà này dùng cho món đó được ạ."
            }
          ]
        },
        {
          "id": "sj-so-06-b07-120-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "21fe626f-60ac-5136-8e3c-0507fe4eca99",
          "context_vi": "Khách tìm món ăn nhanh không cay.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "辛くないものなら、おすすめは何ですか。",
              "vi": "Nếu chọn món không cay thì chị gợi ý gì ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "たまごサンドが食べやすいですよ。",
              "vi": "Bánh kẹp trứng dễ ăn đấy ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-06-b07-103",
      "practice": [
        {
          "id": "sj-so-06-b07-103-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b21b966f-6596-59f0-a4a4-72fc81bb65bf",
          "situation_uid": "493bca4c-9a5b-5254-a7eb-f251c132d91e",
          "context_vi": "Thu ngân hỏi khách cần túi không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thu ngân",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "袋をお付けしますか。",
              "vi": "Tôi bỏ túi vào cho chị nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "大丈夫です。自分の袋があります。",
              "vi": "Không cần ạ. Tôi có túi rồi."
            }
          ]
        },
        {
          "id": "sj-so-06-b07-103-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
