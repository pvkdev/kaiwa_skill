{
  "stage_uid": "3362145c-ce74-507a-8bd3-d8d944852a99",
  "items": [
    {
      "item_id": "sj-trung-06-b18-572",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quầy chưa thấy thay đổi đặt chỗ, hỏi người đã tiếp nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨日の変更は、どなたに確認すればよろしいですか。",
              "vi": "Việc đổi đặt chỗ hôm qua, tôi nên xác nhận với ai ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "担当者をお呼びします。",
              "vi": "Tôi sẽ gọi người phụ trách."
            }
          ],
          "id": "sj-trung-06-b18-572-ex01",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "2d1fd666-5e02-5480-86be-b8d96e65f66e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên hỏi người đứng tên đặt bàn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご予約はどなたのお名前でしょうか。",
              "vi": "Quý khách đặt bàn dưới tên ai ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "山田です。",
              "vi": "Tôi là Yamada."
            }
          ],
          "id": "sj-trung-06-b18-572-ex02",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "517a77b1-536b-5f6c-8ae9-a590ac1bf32e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi đầu mối kiểm thông tin còn lệch.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "人数の変更について、どなたがご担当ですか。",
              "vi": "Về việc đổi số người, ai là người phụ trách ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "私が確認いたします。",
              "vi": "Tôi sẽ kiểm tra ạ."
            }
          ],
          "id": "sj-trung-06-b18-572-ex03",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "c36c7d80-553a-5bb1-a209-26c0e77b409b"
        }
      ]
    },
    {
      "item_id": "sj-trung-06-b18-2067",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi còn bàn cho nhóm bốn người không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今週の土曜日、四名で予約できるか伺いたいのですが。",
              "vi": "Tôi muốn hỏi thứ Bảy tuần này có thể đặt cho bốn người không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "お時間は何時ごろですか。",
              "vi": "Quý khách muốn mấy giờ ạ?"
            }
          ],
          "id": "sj-trung-06-b18-2067-ex01",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "6a12b091-613b-5930-8663-fc42ecd1017d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai bên nghe khác ngày, hỏi lại ngày và thứ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "念のため、予約の日付をもう一度伺ってもよろしいですか。",
              "vi": "Để chắc ăn, cho tôi hỏi lại ngày đặt bàn được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "十一月二十日、金曜日です。",
              "vi": "Thứ Sáu, ngày hai mươi tháng Mười Một ạ."
            }
          ],
          "id": "sj-trung-06-b18-2067-ex02",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "25774dbd-b42e-5a0c-93ce-745046feb748"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi phí khi đổi số người.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "人数を減らす場合の料金を伺いたいのですが。",
              "vi": "Tôi muốn hỏi mức phí nếu giảm số người ạ."
            },
            {
              "speaker_id": "B",
              "ja": "前日までなら変更料はかかりません。",
              "vi": "Đổi trước một ngày thì không mất phí ạ."
            }
          ],
          "id": "sj-trung-06-b18-2067-ex03",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "d5a4fd23-6f53-5027-aa66-a3ca61c32c11"
        }
      ]
    },
    {
      "item_id": "sj-trung-06-b18-622",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên xác nhận tên khách đứng đặt chỗ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "山田様のご予約は、土曜日の六時で承っております。",
              "vi": "Chúng tôi đã nhận đặt chỗ của quý khách Yamada lúc sáu giờ thứ Bảy."
            },
            {
              "speaker_id": "B",
              "ja": "はい、合っています。",
              "vi": "Vâng, đúng rồi ạ."
            }
          ],
          "id": "sj-trung-06-b18-622-ex01",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "517a77b1-536b-5f6c-8ae9-a590ac1bf32e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhắc người đã nhận cuộc gọi đổi chỗ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨日、鈴木様に人数の変更をお願いしました。",
              "vi": "Hôm qua tôi đã nhờ chị Suzuki đổi số người ạ."
            },
            {
              "speaker_id": "B",
              "ja": "確認いたします。",
              "vi": "Tôi sẽ kiểm tra."
            }
          ],
          "id": "sj-trung-06-b18-622-ex02",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "2d1fd666-5e02-5480-86be-b8d96e65f66e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên xác nhận lại tên người đặt chỗ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご予約は佐藤様のお名前でよろしいでしょうか。",
              "vi": "Đặt chỗ dưới tên quý khách Sato, đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、佐藤です。",
              "vi": "Vâng, tôi là Sato."
            }
          ],
          "id": "sj-trung-06-b18-622-ex03",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "517a77b1-536b-5f6c-8ae9-a590ac1bf32e"
        }
      ]
    },
    {
      "item_id": "sj-trung-06-b07-110",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhắc lại thông tin cuối trước khi cúp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "念のため確認します。金曜日の七時に五名ですね。",
              "vi": "Để chắc ăn, cho tôi xác nhận: thứ Sáu lúc bảy giờ, năm người nhỉ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、そのとおりです。",
              "vi": "Vâng, đúng vậy ạ."
            }
          ],
          "id": "sj-trung-06-b07-110-ex01",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "cda306ed-cb18-54f9-bdc3-ec11ac2f9d32"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe sai ngày, đọc lại cả thứ và ngày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "念のため、日付と曜日を両方確認してもいいですか。",
              "vi": "Để chắc ăn, tôi xác nhận cả ngày và thứ được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。二十日、金曜日です。",
              "vi": "Vâng. Ngày hai mươi, thứ Sáu ạ."
            }
          ],
          "id": "sj-trung-06-b07-110-ex02",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "25774dbd-b42e-5a0c-93ce-745046feb748"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xác nhận có giữ được chỗ khi đổi số người.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "念のため伺います。六名から五名にしても、同じ席で大丈夫ですか。",
              "vi": "Để chắc ăn, cho tôi hỏi giảm từ sáu xuống năm người thì vẫn giữ bàn cũ được chứ ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、同じお席をご用意します。",
              "vi": "Vâng, chúng tôi vẫn giữ bàn đó ạ."
            }
          ],
          "id": "sj-trung-06-b07-110-ex03",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "075ed2d5-8ec2-5707-93b0-6e76f6a696ad"
        }
      ]
    },
    {
      "item_id": "sj-trung-06-b12-47",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đang tìm tên người đứng đặt chỗ trong nhóm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご予約のお名前は？",
              "vi": "Tên người đặt chỗ là gì ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "えーっと、田中だったと思います。少し待ってください。",
              "vi": "Ừm, hình như là Tanaka. Chị đợi tôi một chút."
            }
          ],
          "id": "sj-trung-06-b12-47-ex01",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "517a77b1-536b-5f6c-8ae9-a590ac1bf32e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cần xem lại lịch nhóm trước khi hẹn giờ trả lời.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日中にお返事をいただけますか。",
              "vi": "Hôm nay anh trả lời được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "えーっと、皆の予定を確認して、五時までに電話します。",
              "vi": "Ừm, tôi sẽ kiểm tra lịch mọi người rồi gọi lại trước năm giờ."
            }
          ],
          "id": "sj-trung-06-b12-47-ex02",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "0a4037de-44d7-5291-a5e3-c857ff2896b7"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghĩ về địa chỉ chi nhánh đang hỏi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "駅前の店舗でよろしいですか。",
              "vi": "Chi nhánh trước ga đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "えーっと、駅前ではなく、川沿いの店舗です。",
              "vi": "Ừm, không phải trước ga, mà là chi nhánh ven sông ạ."
            }
          ],
          "id": "sj-trung-06-b12-47-ex03",
          "topic_uid": "1e5169b4-48e7-51f8-92d3-3a3c963f7fe7",
          "situation_uid": "db35a83f-6bc1-5302-96f2-adadf88cf93f"
        }
      ]
    }
  ]
}
