{
  "stage_uid": "bb2c6dc5-b314-57de-b703-fb212eb18ec3",
  "items": [
    {
      "item_id": "sj-trung-35-b06-8",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người nhà cuống khi nghe cảnh báo chưa rõ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あわてなくていいよ。まず、今の警報がこの地区のものか確認しよう。",
              "vi": "Không cần cuống. Trước tiên mình xem cảnh báo này có áp dụng cho khu mình không."
            },
            {
              "speaker_id": "B",
              "ja": "うん、確認する。",
              "vi": "Ừ, để anh xem."
            }
          ],
          "id": "sj-trung-35-b06-8-ex01",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "282ca27b-4b99-5c00-bd4a-86670d2933f8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người đi cùng vội định rời nơi an toàn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あわてなくていい。安全な道を確認してから出よう。",
              "vi": "Không cần vội. Kiểm tra đường an toàn rồi hãy đi."
            },
            {
              "speaker_id": "B",
              "ja": "分かった。",
              "vi": "Em hiểu."
            }
          ],
          "id": "sj-trung-35-b06-8-ex02",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "4e1882bb-363a-5ad0-820f-65e6adfa893b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Một người đi không kịp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người đi cùng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あわてなくて大丈夫です。職員の方に手伝いを頼みましょう。",
              "vi": "Không cần vội ạ. Mình nhờ nhân viên hỗ trợ nhé."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとう。",
              "vi": "Cảm ơn cô."
            }
          ],
          "id": "sj-trung-35-b06-8-ex03",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "17fe69fd-670f-5d3a-b4d3-d4cf800c1fa8"
        }
      ]
    },
    {
      "item_id": "sj-trung-35-b06-144",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chưa liên lạc được người thân ở nơi khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "向こうも安全な場所に着いていればいいけど。",
              "vi": "Mong là phía bên ấy cũng đã đến chỗ an toàn."
            },
            {
              "speaker_id": "B",
              "ja": "連絡が取れるまで待とう。",
              "vi": "Mình chờ liên lạc được đã."
            }
          ],
          "id": "sj-trung-35-b06-144-ex01",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "a2083ffb-c92a-5373-b4c2-61b349b9d6b7"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đã an toàn nhưng chưa biết khu nhà thế nào.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "家の周りに何もなければいいけど。",
              "vi": "Mong là quanh nhà không có chuyện gì."
            },
            {
              "speaker_id": "B",
              "ja": "次の情報を待とう。",
              "vi": "Chờ thông báo tiếp nhé."
            }
          ],
          "id": "sj-trung-35-b06-144-ex02",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "4111c68e-d018-5433-960d-9b15c3f823fa"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đường thường đi bị đóng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "別の道は通れるといいけど。何もなければいいな。",
              "vi": "Mong đường khác còn đi được. Hy vọng không có vấn đề gì."
            },
            {
              "speaker_id": "B",
              "ja": "係の人に聞こう。",
              "vi": "Hỏi người phụ trách nhé."
            }
          ],
          "id": "sj-trung-35-b06-144-ex03",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "3be141ac-5be2-5d3d-8a70-8ae6c56b0978"
        }
      ]
    },
    {
      "item_id": "sj-trung-35-b24-41",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe tin nhiều nơi nhưng chưa biết khu mình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "焦って動く前に、この知らせがうちの地区か確認しよう。",
              "vi": "Trước khi cuống lên mà đi, mình kiểm tra tin này có phải khu mình không."
            },
            {
              "speaker_id": "B",
              "ja": "そうだね。",
              "vi": "Ừ, đúng."
            }
          ],
          "id": "sj-trung-35-b24-41-ex01",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "f0c0055f-b799-54ed-b2b4-06ad404eb128"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người đi cùng cuống vì không kịp nhóm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi cùng",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "みんなに遅れそうで焦ってる。",
              "vi": "Tôi sợ theo không kịp mọi người nên cuống quá."
            },
            {
              "speaker_id": "B",
              "ja": "職員に今の場所を伝えましょう。",
              "vi": "Ta báo vị trí hiện tại cho nhân viên."
            }
          ],
          "id": "sj-trung-35-b24-41-ex02",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "17fe69fd-670f-5d3a-b4d3-d4cf800c1fa8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kế hoạch đổi nhiều lần khiến người nhà rối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "変更が続いて、ちょっとテンパってる。",
              "vi": "Kế hoạch đổi liên tục nên anh hơi rối rồi."
            },
            {
              "speaker_id": "B",
              "ja": "今の集合場所を一つずつ確認しよう。",
              "vi": "Mình kiểm tra lại điểm gặp hiện tại từng bước nhé."
            }
          ],
          "id": "sj-trung-35-b24-41-ex03",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "f8e5faa5-bb73-55ec-8b3f-805aa20b681a"
        }
      ]
    },
    {
      "item_id": "sj-trung-35-b24-39",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đường quen bị đóng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "いつもの道が通れない。まずいな、別の道を聞こう。",
              "vi": "Đường thường đi bị chặn rồi. Không ổn, hỏi lối khác thôi."
            },
            {
              "speaker_id": "B",
              "ja": "係の人があそこにいるよ。",
              "vi": "Người phụ trách ở đằng kia."
            }
          ],
          "id": "sj-trung-35-b24-39-ex01",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "3be141ac-5be2-5d3d-8a70-8ae6c56b0978"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nơi định đến không còn tiếp nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ここはもう受け入れていないんだ。困ったなあ、次はどこへ行けばいい？",
              "vi": "Chỗ này không nhận nữa. Khó rồi, tiếp theo đi đâu đây?"
            },
            {
              "speaker_id": "B",
              "ja": "この先の体育館へお願いします。",
              "vi": "Xin đến nhà thi đấu phía trước ạ."
            }
          ],
          "id": "sj-trung-35-b24-39-ex02",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "55bea680-e34c-5a17-b3b0-10def8fccbf8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai nguồn chỉ điểm tập trung khác nhau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "案内が二つあって違う場所を指してる。まずいね。最新の情報を確認しよう。",
              "vi": "Có hai hướng dẫn chỉ hai nơi khác nhau. Không ổn rồi. Mình kiểm thông tin mới nhất nhé."
            },
            {
              "speaker_id": "B",
              "ja": "うん、公式の案内を見よう。",
              "vi": "Ừ, xem thông báo chính thức."
            }
          ],
          "id": "sj-trung-35-b24-39-ex03",
          "topic_uid": "b0e70ce7-ab12-5c06-b5a6-9f6f10e51ccf",
          "situation_uid": "6a86832a-36bf-526d-b8ee-8829391c41af"
        }
      ]
    }
  ]
}
