{
  "stage_uid": "aec93997-42c7-5cf9-980b-7d28ff1b5ee7",
  "items": [
    {
      "item_id": "sj-so-10-b07-149",
      "practice": [
        {
          "id": "sj-so-10-b07-149-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90",
          "situation_uid": "079c0f95-14ae-58df-930d-76075c5d77f4",
          "context_vi": "Đối tác quen gọi vào công ty và tự xưng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Lễ tân",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "いつもお世話になっております。山川商事の佐藤です。",
              "vi": "Cảm ơn chị luôn hỗ trợ. Tôi là Satō của Yamakawa Thương mại."
            },
            {
              "speaker_id": "B",
              "ja": "こちらこそお世話になっております。",
              "vi": "Chính chúng tôi mới phải cảm ơn anh ạ."
            }
          ]
        },
        {
          "id": "sj-so-10-b07-149-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90",
          "situation_uid": "e1f96a31-0b83-57ea-b5a6-8d8cd649caa1",
          "context_vi": "Đối tác quen gọi tìm người đang họp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhận",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "いつもお世話になっております。青空印刷の森です。田中様はいらっしゃいますか。",
              "vi": "Cảm ơn anh luôn hỗ trợ. Tôi là Mori ở Aozora In ấn. Anh Tanaka có ở đó không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "ただ今会議中でございます。",
              "vi": "Hiện anh ấy đang họp ạ."
            }
          ]
        },
        {
          "id": "sj-so-10-b07-149-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90",
          "situation_uid": "2951a304-aa9e-5c78-b3c6-55bae5dbc78d",
          "context_vi": "Sau khi mất kết nối, người gọi liên hệ lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhận",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "いつもお世話になっております。先ほど電話した鈴木です。",
              "vi": "Cảm ơn chị luôn hỗ trợ. Tôi là Suzuki vừa gọi lúc nãy."
            },
            {
              "speaker_id": "B",
              "ja": "先ほどは失礼しました。おつなぎします。",
              "vi": "Ban nãy xin lỗi anh. Tôi nối máy ngay ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-10-b07-159",
      "practice": [
        {
          "id": "sj-so-10-b07-159-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f8b20d5f-a6b0-5e77-a582-2d12837969ee",
          "situation_uid": "6d891f27-42d0-57da-8389-d40cab09a6af",
          "context_vi": "Phụ huynh lần đầu gọi cho giáo viên của con.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Phụ huynh",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初めてお電話します。母のリンです。これからお世話になります。",
              "vi": "Tôi gọi cho thầy lần đầu. Tôi là mẹ của Linh. Từ nay mong thầy giúp đỡ cháu ạ."
            },
            {
              "speaker_id": "B",
              "ja": "こちらこそ、よろしくお願いします。",
              "vi": "Vâng, mong được phối hợp cùng chị."
            }
          ]
        },
        {
          "id": "sj-so-10-b07-159-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90",
          "situation_uid": "079c0f95-14ae-58df-930d-76075c5d77f4",
          "context_vi": "Nhân viên công ty mới lần đầu liên hệ đối tác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhận",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お世話になります。東海物流の山田と申します。",
              "vi": "Xin chào, mong được chị giúp đỡ. Tôi là Yamada ở Tōkai Vận tải."
            },
            {
              "speaker_id": "B",
              "ja": "山田様ですね。ご用件を伺います。",
              "vi": "Anh Yamada phải không ạ? Xin cho biết anh cần việc gì ạ."
            }
          ]
        },
        {
          "id": "sj-so-10-b07-159-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90",
          "situation_uid": "038543c0-935e-59cf-8d86-1e1548eadd77",
          "context_vi": "Nhân viên mới của công ty đối tác gọi lần đầu và xin gặp người phụ trách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhận",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お世話になります。今日から担当します、星野製作所の高橋です。",
              "vi": "Xin chào, tôi là Takahashi ở Hoshino Chế tạo, từ hôm nay phụ trách công việc này ạ."
            },
            {
              "speaker_id": "B",
              "ja": "高橋様ですね。担当におつなぎします。",
              "vi": "Chị Takahashi phải không ạ? Tôi nối máy tới người phụ trách."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-10-b07-180",
      "practice": [
        {
          "id": "sj-so-10-b07-180-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f8b20d5f-a6b0-5e77-a582-2d12837969ee",
          "situation_uid": "893d5f97-1be5-5f14-a412-7e8c68aeccc4",
          "context_vi": "Người gọi không chắc có đúng người cần tìm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhận",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "失礼ですが、山本さんでいらっしゃいますか。",
              "vi": "Xin lỗi, anh có phải anh Yamamoto không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いえ、山本は今外出中です。",
              "vi": "Không, anh Yamamoto đang ra ngoài ạ."
            }
          ]
        },
        {
          "id": "sj-so-10-b07-180-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90",
          "situation_uid": "cfe1962b-e579-508b-bf04-4c6004088170",
          "context_vi": "Người nhận điện thoại chưa nghe rõ tên khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhận",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người gọi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "失礼ですが、お名前をもう一度伺えますか。",
              "vi": "Xin lỗi, cho tôi hỏi lại tên chị được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "青空印刷の森です。",
              "vi": "Tôi là Mori ở Aozora In ấn."
            }
          ]
        },
        {
          "id": "sj-so-10-b07-180-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90",
          "situation_uid": "502df01e-243e-57fa-b25a-3bd70a613167",
          "context_vi": "Người nhận chưa chắc tên bộ phận muốn chuyển.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhận",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người gọi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "失礼ですが、営業部でよろしいでしょうか。",
              "vi": "Xin lỗi, có đúng là anh muốn gặp phòng kinh doanh không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、経理部です。",
              "vi": "Không, phòng kế toán ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-10-b07-89",
      "practice": [
        {
          "id": "sj-so-10-b07-89-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90",
          "situation_uid": "079c0f95-14ae-58df-930d-76075c5d77f4",
          "context_vi": "Người nhận xin chờ để ghi tên công ty.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhận",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "光和商事の中村です。",
              "vi": "Tôi là Nakamura của Kōwa Thương mại."
            },
            {
              "speaker_id": "B",
              "ja": "少々お待ちください。会社名を確認します。",
              "vi": "Xin anh chờ một chút. Tôi kiểm lại tên công ty ạ."
            }
          ]
        },
        {
          "id": "sj-so-10-b07-89-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f8b20d5f-a6b0-5e77-a582-2d12837969ee",
          "situation_uid": "ef91e650-7306-557c-826b-f53722fc1ff4",
          "context_vi": "Khách phát hiện nhân viên đọc sai số người trước khi chốt đặt chỗ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "では、三名様で承りました。",
              "vi": "Vậy tôi đã nhận đặt chỗ cho ba người ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ちょっと待ってください。二人です。",
              "vi": "Xin chờ một chút. Là hai người ạ."
            }
          ]
        },
        {
          "id": "sj-so-10-b07-89-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90",
          "situation_uid": "4d53acce-c7c4-5e77-a419-b23e67adc520",
          "context_vi": "Người nhận chưa biết lúc người phụ trách trở lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhận",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "田中さんは何時に戻りますか。",
              "vi": "Anh Tanaka mấy giờ quay lại ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "少しお待ちください。予定を確認します。",
              "vi": "Xin chị chờ một chút. Tôi kiểm tra lịch ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-10-b11-8",
      "practice": [
        {
          "id": "sj-so-10-b11-8-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f8b20d5f-a6b0-5e77-a582-2d12837969ee",
          "situation_uid": "a3aee465-3a23-587a-abd8-6278cc21a472",
          "context_vi": "Người nhà chuyển lời người gọi sẽ gọi lại cho giáo viên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "リンさんが、六時にかけ直すって言っていました。",
              "vi": "Chị Linh nói sáu giờ sẽ gọi lại."
            },
            {
              "speaker_id": "B",
              "ja": "わかりました。六時なら電話に出られます。",
              "vi": "Tôi biết rồi. Sáu giờ tôi nghe máy được."
            }
          ]
        },
        {
          "id": "sj-so-10-b11-8-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90",
          "situation_uid": "e1f96a31-0b83-57ea-b5a6-8d8cd649caa1",
          "context_vi": "Hai đồng nghiệp trao đổi cách báo cho khách khi người phụ trách đang họp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Lễ tân",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "田中さん、今会議中だって。お客さんにはどう伝える？",
              "vi": "Nghe nói anh Tanaka đang họp. Mình báo khách thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "後でかけ直していただくように伝えて。",
              "vi": "Báo nhờ khách gọi lại sau nhé."
            }
          ]
        },
        {
          "id": "sj-so-10-b11-8-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f8b20d5f-a6b0-5e77-a582-2d12837969ee",
          "situation_uid": "ae1ad3c7-b91e-5547-93b8-9bbdc345911a",
          "context_vi": "Nhân viên quán chuyển lời khách sẽ tới trễ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "七時の予約の佐藤さん、十分遅れるって。",
              "vi": "Anh Satō đặt bàn lúc bảy giờ nói sẽ đến trễ mười phút."
            },
            {
              "speaker_id": "B",
              "ja": "わかった。席はそのままにしておくね。",
              "vi": "Rõ rồi. Tớ giữ bàn như cũ nhé."
            }
          ]
        }
      ]
    }
  ]
}
