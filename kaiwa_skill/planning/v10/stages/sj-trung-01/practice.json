{
  "stage_uid": "cfa8d731-3de3-5454-bb55-cd43ccd8274e",
  "items": [
    {
      "item_id": "sj-trung-01-b12-31",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Muốn tâm sự nhưng hỏi trước xem bạn có rảnh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "実は、ちょっと聞いてほしいことがあるんだけど、今いい？",
              "vi": "Thật ra tớ có chuyện muốn cậu nghe, giờ có tiện không?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、今なら大丈夫だよ。",
              "vi": "Ừ, bây giờ tớ nghe được."
            }
          ],
          "id": "sj-trung-01-b12-31-ex01",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "abd63da6-e38a-5487-ba65-16fa8fec15bb"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kể với bạn điều mình đã giấu trong lòng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "実は、昨日の一言がまだ気になってるんだ。",
              "vi": "Thật ra tớ vẫn bận lòng vì câu nói hôm qua."
            },
            {
              "speaker_id": "B",
              "ja": "そうだったんだ。話してくれてありがとう。",
              "vi": "Ra vậy. Cảm ơn cậu đã nói với tớ."
            }
          ],
          "id": "sj-trung-01-b12-31-ex02",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "f7b31731-cde8-5a35-ba6e-1db884a71d7e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Làm rõ nhu cầu sau khi bạn bắt đầu khuyên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "実は、今日はアドバイスより、話を聞いてもらえるとうれしい。",
              "vi": "Thật ra hôm nay cậu chỉ cần nghe tớ kể là tớ vui rồi, chưa cần khuyên đâu."
            },
            {
              "speaker_id": "B",
              "ja": "分かった。続けて。",
              "vi": "Tớ hiểu rồi. Cậu kể tiếp đi."
            }
          ],
          "id": "sj-trung-01-b12-31-ex03",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "c8f9641e-71d7-5004-b461-a9b6527b3fcf"
        }
      ]
    },
    {
      "item_id": "sj-trung-01-b11-73",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn đã kể một đoạn về cuộc trao đổi với cấp trên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "上司に相談してみたんだ。",
              "vi": "Tớ đã thử trao đổi với sếp."
            },
            {
              "speaker_id": "B",
              "ja": "で、どうなったの？",
              "vi": "Rồi chuyện thế nào?"
            },
            {
              "speaker_id": "A",
              "ja": "来週また話すことになった。",
              "vi": "Tuần sau bọn tớ sẽ nói tiếp."
            }
          ],
          "id": "sj-trung-01-b11-73-ex01",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "cd30b010-04f3-5f30-ba61-8b0f8e1bed31"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi tiếp sau khi bạn kể về việc định làm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨日、本人に連絡したよ。",
              "vi": "Hôm qua tớ đã liên lạc với người đó rồi."
            },
            {
              "speaker_id": "B",
              "ja": "で、返事はあった？",
              "vi": "Rồi họ có trả lời không?"
            }
          ],
          "id": "sj-trung-01-b11-73-ex02",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "7e6e291f-9841-5597-9e7e-5a75f3e63950"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi nghe bạn nêu hai lựa chọn, hỏi bước kế.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今は二つの案で迷ってる。",
              "vi": "Tớ đang phân vân giữa hai cách."
            },
            {
              "speaker_id": "B",
              "ja": "で、どっちから試してみたい？",
              "vi": "Vậy cậu muốn thử cách nào trước?"
            }
          ],
          "id": "sj-trung-01-b11-73-ex03",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "29d9c1a0-0c6e-55ce-8938-4ab57d377be6"
        }
      ]
    },
    {
      "item_id": "sj-trung-01-b12-99",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn kể rằng cuộc hẹn không diễn ra như dự tính.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "待ち合わせの場所に行ったら、相手がまだ来てなくて。",
              "vi": "Tớ đến chỗ hẹn mà người ấy vẫn chưa tới."
            },
            {
              "speaker_id": "B",
              "ja": "へえ、それから？",
              "vi": "Ồ, rồi sao nữa?"
            }
          ],
          "id": "sj-trung-01-b12-99-ex01",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "f7b31731-cde8-5a35-ba6e-1db884a71d7e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn đã kể một phần, người nghe mời kể tiếp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "謝ろうと思って、電話したんだ。",
              "vi": "Tớ định xin lỗi nên đã gọi điện."
            },
            {
              "speaker_id": "B",
              "ja": "うん、それからどうなったの？",
              "vi": "Ừ, rồi sau đó thế nào?"
            }
          ],
          "id": "sj-trung-01-b12-99-ex02",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "cd30b010-04f3-5f30-ba61-8b0f8e1bed31"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn kể về việc đi gặp người sẽ giúp mình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日、相談できる人を紹介してもらった。",
              "vi": "Hôm nay tớ được giới thiệu một người có thể tư vấn."
            },
            {
              "speaker_id": "B",
              "ja": "へえ。それから？",
              "vi": "Ồ. Rồi sao nữa?"
            }
          ],
          "id": "sj-trung-01-b12-99-ex03",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "7e6e291f-9841-5597-9e7e-5a75f3e63950"
        }
      ]
    },
    {
      "item_id": "sj-trung-01-b06-149",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thấy bạn im lặng khác mọi khi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日はずいぶん静かだね。なんかあったの？",
              "vi": "Hôm nay cậu im lặng quá. Có chuyện gì à?"
            },
            {
              "speaker_id": "B",
              "ja": "うん。でも、少ししてから話してもいい？",
              "vi": "Ừ. Nhưng lát nữa tớ kể được không?"
            }
          ],
          "id": "sj-trung-01-b06-149-ex01",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "7d3a92e6-cbff-53fd-a450-564586ce2bd3"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Gọi hỏi thăm sau cuộc nói chuyện trước.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "声が疲れてるね。なんかあったの？",
              "vi": "Giọng cậu nghe mệt quá. Có chuyện gì à?"
            },
            {
              "speaker_id": "B",
              "ja": "今日はちょっと忙しかっただけ。",
              "vi": "Hôm nay tớ chỉ hơi bận thôi."
            }
          ],
          "id": "sj-trung-01-b06-149-ex02",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "943d29f6-8435-5ed7-9bb5-c8ad5f258c5f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thấy bạn buồn rồi hỏi nhẹ, không ép kể.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "さっきから元気がないね。なんかあったの？",
              "vi": "Từ nãy trông cậu không vui. Có chuyện gì à?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、あるけど、今は聞いてくれるだけでいい。",
              "vi": "Ừ, có. Nhưng giờ cậu chỉ nghe tớ kể thôi nhé."
            }
          ],
          "id": "sj-trung-01-b06-149-ex03",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "6604b6f5-a4d8-5303-9cb7-a947efaa2576"
        }
      ]
    },
    {
      "item_id": "sj-trung-01-b20-44",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn hỏi có thể giữ kín chuyện tâm sự không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もちろん。僕は口が堅いから、君が話したことは誰にも言わないよ。",
              "vi": "Tất nhiên rồi. Tớ biết giữ kín chuyện, sẽ không kể điều cậu nói với ai đâu."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとう。安心した。",
              "vi": "Cảm ơn cậu. Tớ yên tâm rồi."
            }
          ],
          "id": "sj-trung-01-b20-44-ex01",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "2fde7783-b25a-561f-811e-6e0487d5c9b3"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người thứ ba hỏi chuyện riêng của bạn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người quen",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あの話、何か聞いてる？",
              "vi": "Cậu có nghe gì về chuyện đó không?"
            },
            {
              "speaker_id": "B",
              "ja": "聞いていても話せないよ。口が堅いって信じてもらってるから。",
              "vi": "Dù có biết tớ cũng không kể. Bạn ấy tin tớ giữ kín chuyện."
            }
          ],
          "id": "sj-trung-01-b20-44-ex02",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "3d882f33-eccd-54fd-a55c-bee882c5e28f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn chọn người đáng tin để nhờ tư vấn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "誰に相談したらいいかな。",
              "vi": "Tớ nên hỏi ý ai nhỉ?"
            },
            {
              "speaker_id": "B",
              "ja": "佐藤さんは口が堅いし、一緒に行ってくれると思うよ。",
              "vi": "Chị Sato biết giữ kín chuyện, chắc chị ấy còn đi cùng cậu được đấy."
            }
          ],
          "id": "sj-trung-01-b20-44-ex03",
          "topic_uid": "2b1e3574-b63a-5ee5-b19e-295d61901897",
          "situation_uid": "211c0449-0d6c-546a-861e-7ec2753e3227"
        }
      ]
    }
  ]
}
