{
  "stage_uid": "024caeba-1d56-59df-b438-0a0855047dbc",
  "items": [
    {
      "item_id": "sj-trung-18-b18-3150",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin cấp trên giới thiệu người có dữ liệu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "データの担当者をご紹介いただけますか。",
              "vi": "Anh giới thiệu giúp tôi người phụ trách dữ liệu được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、田中さんを紹介します。",
              "vi": "Được, tôi sẽ giới thiệu anh Tanaka."
            }
          ],
          "id": "sj-trung-18-b18-3150-ex01",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "6b775729-ba02-56c7-92e6-81a69baa3d65"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cấp trên đồng ý giúp sau khi mình tự kiểm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私が資料を確認した後で、一度ご覧いただけますか。",
              "vi": "Sau khi tôi tự kiểm tài liệu, xin chị xem qua một lần được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、持ってきてください。",
              "vi": "Được, anh mang lại đây."
            }
          ],
          "id": "sj-trung-18-b18-3150-ex02",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "650dc021-cec7-5aab-ba71-300be874e20b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin cấp trên thống nhất với bộ phận khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この方針について、先方とご確認いただけますか。",
              "vi": "Về hướng này, xin anh xác nhận với phía bên kia giúp tôi được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。私から話します。",
              "vi": "Được. Tôi sẽ trao đổi."
            }
          ],
          "id": "sj-trung-18-b18-3150-ex03",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "099a1fbf-0145-5b6a-bb25-10830413ca4b"
        }
      ]
    },
    {
      "item_id": "sj-trung-18-b18-1846",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Lịch sự xin cấp trên cho biết đầu mối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "データの担当者をお教えくださいますか。",
              "vi": "Xin chị cho tôi biết người phụ trách dữ liệu được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "田中さんです。",
              "vi": "Anh Tanaka."
            }
          ],
          "id": "sj-trung-18-b18-1846-ex01",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "6b775729-ba02-56c7-92e6-81a69baa3d65"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cấp trên giúp sửa thứ tự việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先ほど順番をお教えくださって、ありがとうございました。",
              "vi": "Cảm ơn anh vừa chỉ cho tôi thứ tự công việc ạ."
            },
            {
              "speaker_id": "B",
              "ja": "では、その順番で進めてください。",
              "vi": "Vậy cứ theo thứ tự đó mà làm."
            }
          ],
          "id": "sj-trung-18-b18-1846-ex02",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "14e8c912-ac24-50f5-b600-2471737dc756"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin cấp trên xác nhận hai hạn chót.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "下書きと完成版の期限を、もう一度お教えください。",
              "vi": "Xin chị cho tôi biết lại hạn bản nháp và bản hoàn chỉnh ạ."
            },
            {
              "speaker_id": "B",
              "ja": "下書きは木曜、完成版は月曜です。",
              "vi": "Bản nháp thứ Năm, bản hoàn chỉnh thứ Hai."
            }
          ],
          "id": "sj-trung-18-b18-1846-ex03",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "98200d7a-ac1b-568c-9cb8-ac2ee41fb23f"
        }
      ]
    },
    {
      "item_id": "sj-trung-18-b06-37",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhờ cấp trên xem lại tài liệu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お手数をおかけしますが、確認後に見ていただけますか。",
              "vi": "Xin lỗi vì làm phiền, sau khi tôi kiểm xong anh xem giúp tôi được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、送ってください。",
              "vi": "Được, gửi cho tôi."
            }
          ],
          "id": "sj-trung-18-b06-37-ex01",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "650dc021-cec7-5aab-ba71-300be874e20b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhờ cấp trên nói với bộ phận khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お手数をおかけしますが、先方との認識をそろえていただけますか。",
              "vi": "Xin lỗi vì làm phiền, chị giúp thống nhất cách hiểu với phía bên kia được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。話しておきます。",
              "vi": "Được, tôi sẽ trao đổi."
            }
          ],
          "id": "sj-trung-18-b06-37-ex02",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "099a1fbf-0145-5b6a-bb25-10830413ca4b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhờ cấp trên giới thiệu người dữ liệu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お手数をおかけしてすみません。担当の方をご紹介いただけますか。",
              "vi": "Xin lỗi vì làm phiền anh. Anh giới thiệu người phụ trách giúp tôi được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、つなぎます。",
              "vi": "Được, tôi sẽ kết nối."
            }
          ],
          "id": "sj-trung-18-b06-37-ex03",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "6b775729-ba02-56c7-92e6-81a69baa3d65"
        }
      ]
    },
    {
      "item_id": "sj-trung-18-b07-82",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe cấp trên dặn thứ tự và người nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先に数字を確認して、それから私に報告してください。",
              "vi": "Hãy kiểm con số trước rồi báo tôi."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。数字を確認してから報告します。",
              "vi": "Tôi hiểu rồi. Tôi sẽ kiểm con số rồi báo anh."
            }
          ],
          "id": "sj-trung-18-b07-82-ex01",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "14e8c912-ac24-50f5-b600-2471737dc756"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hạn bản nháp và bản hoàn chỉnh đã được làm rõ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "木曜は下書き、月曜が完成版です。",
              "vi": "Thứ Năm nộp nháp, thứ Hai nộp bản hoàn chỉnh."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。木曜に下書きをお送りします。",
              "vi": "Tôi hiểu rồi. Thứ Năm tôi gửi bản nháp."
            }
          ],
          "id": "sj-trung-18-b07-82-ex02",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "98200d7a-ac1b-568c-9cb8-ac2ee41fb23f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cấp trên chuyển việc cũ cho đồng nghiệp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "古い案件は佐藤さんに引き継いでください。",
              "vi": "Hãy bàn giao việc cũ cho chị Sato."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。今日中に状況を伝えます。",
              "vi": "Tôi hiểu rồi. Hôm nay tôi sẽ báo tình hình cho chị ấy."
            }
          ],
          "id": "sj-trung-18-b07-82-ex03",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "3438b2ff-7ddf-5804-b4bd-713efa530fed"
        }
      ]
    },
    {
      "item_id": "sj-trung-18-b11-29",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi hạn phản hồi bản nháp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "下書きの返事は明日でもいいでしょうか。",
              "vi": "Ngày mai tôi trả lời về bản nháp được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、午前中なら大丈夫です。",
              "vi": "Được, trong buổi sáng nhé."
            }
          ],
          "id": "sj-trung-18-b11-29-ex01",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "98200d7a-ac1b-568c-9cb8-ac2ee41fb23f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi có thể hoàn tất việc cũ trước không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "新しい仕事は、今の作業が終わってからでもいいですか。",
              "vi": "Tôi làm việc mới sau khi xong việc hiện tại được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "こちらが先なので、今の仕事は引き継いでください。",
              "vi": "Việc này ưu tiên hơn, hãy bàn giao việc hiện tại."
            }
          ],
          "id": "sj-trung-18-b11-29-ex02",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "332e85a5-87a7-57c0-9286-2de047da0a86"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi hình thức báo cáo có phù hợp không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "結果はメールでお送りする形でもいいでしょうか。",
              "vi": "Tôi gửi kết quả qua email được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、私と担当者の両方に送ってください。",
              "vi": "Được, gửi cho cả tôi và người phụ trách."
            }
          ],
          "id": "sj-trung-18-b11-29-ex03",
          "topic_uid": "3f3e7b7e-5b1f-5a4e-9f7e-3e8da07c54b0",
          "situation_uid": "14e8c912-ac24-50f5-b600-2471737dc756"
        }
      ]
    }
  ]
