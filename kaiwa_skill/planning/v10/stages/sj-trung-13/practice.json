{
  "stage_uid": "e49bf7c6-5770-5a07-a6fc-223f92cbb0a7",
  "items": [
    {
      "item_id": "sj-trung-13-b24-37",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn bày tỏ lo về kết quả cần chuyên viên giải thích.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "結果がまだ分からなくて、ハラハラしてる。",
              "vi": "Chưa biết kết quả nên tớ cứ thấp thỏm."
            },
            {
              "speaker_id": "B",
              "ja": "分かるよ。説明の予約を取ろうか。",
              "vi": "Tớ hiểu. Mình đặt lịch nghe giải thích nhé?"
            }
          ],
          "id": "sj-trung-13-b24-37-ex01",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "d8fc98f0-e743-5ecc-b2d4-fd060102fa7b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kế hoạch sinh bắt đầu sớm hơn dự tính.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "予定より早くてハラハラするけど、まず病院に電話するよ。",
              "vi": "Sớm hơn dự tính làm anh lo thót tim, nhưng anh sẽ gọi bệnh viện trước."
            },
            {
              "speaker_id": "B",
              "ja": "うん、お願い。",
              "vi": "Ừ, anh gọi giúp em."
            }
          ],
          "id": "sj-trung-13-b24-37-ex02",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "2e76dc6d-e687-5fd2-b465-2c9c72c24e88"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người dự định đi cùng chưa đến được.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "連絡がつかなくて、ハラハラしてる。代わりに来られる人を探してくれる？",
              "vi": "Em không liên lạc được nên lo quá. Anh tìm giúp người khác có thể đến nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、すぐ電話する。",
              "vi": "Ừ, anh gọi ngay."
            }
          ],
          "id": "sj-trung-13-b24-37-ex03",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "cb1f9726-a799-5a24-9914-1f3266aab02a"
        }
      ]
    },
    {
      "item_id": "sj-trung-13-b24-40",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chờ lịch nghe giải thích kết quả.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "説明を聞くまでは気が気じゃないよ。",
              "vi": "Chưa được nghe giải thích thì anh cứ lo đứng lo ngồi."
            },
            {
              "speaker_id": "B",
              "ja": "早めの予約を聞いてみよう。",
              "vi": "Mình thử hỏi lịch sớm nhé."
            }
          ],
          "id": "sj-trung-13-b24-40-ex01",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "0513aa7d-9825-564e-bf87-b63bc524a7e3"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Dịch vụ hỗ trợ chưa có lịch.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "手伝いを頼める日がなくて、まいったなあ。",
              "vi": "Không có ngày nào nhờ được người hỗ trợ, khó thật."
            },
            {
              "speaker_id": "B",
              "ja": "別の窓口も聞いてみよう。",
              "vi": "Ta hỏi thêm đầu mối khác đi."
            }
          ],
          "id": "sj-trung-13-b24-40-ex02",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "03eb48eb-9fd8-5619-951b-894fd801fded"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Lời dặn điện thoại nghe chưa rõ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "大事なところが聞き取れなくて、気が気じゃないです。もう一度お願いします。",
              "vi": "Tôi không nghe rõ phần quan trọng nên rất lo. Xin nhắc lại giúp tôi ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、短くお伝えします。",
              "vi": "Vâng, tôi sẽ nói ngắn gọn ạ."
            }
          ],
          "id": "sj-trung-13-b24-40-ex03",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "5dc43e66-fa09-54b9-88bc-2c2e8f0fedcc"
        }
      ]
    },
    {
      "item_id": "sj-trung-13-b24-12",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người nhà đề nghị trông bé để mình nghỉ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一時間、赤ちゃんを見ているよ。",
              "vi": "Anh sẽ trông bé một tiếng."
            },
            {
              "speaker_id": "B",
              "ja": "いいんですか。そうしてもらえるとありがたいです。",
              "vi": "Thật vậy à? Được anh giúp thế thì quý quá."
            }
          ],
          "id": "sj-trung-13-b24-12-ex01",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "b34f6fd6-c20f-5bf4-af56-76fbb63a953c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người thân đề nghị đi cùng buổi tư vấn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "よければ、私も一緒に行くよ。",
              "vi": "Nếu được, em đi cùng nhé."
            },
            {
              "speaker_id": "B",
              "ja": "いいの？一緒に来てもらえるとありがたい。",
              "vi": "Được thật à? Có em đi cùng thì anh yên tâm lắm."
            }
          ],
          "id": "sj-trung-13-b24-12-ex02",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "4acdc32a-65bc-5ff2-9095-2d25539de84c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn đề nghị đưa mình đến nơi tiếp nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は僕が送るよ。",
              "vi": "Hôm nay để tớ chở cậu đi."
            },
            {
              "speaker_id": "B",
              "ja": "いいんですか。本当にありがたいです。",
              "vi": "Thật sự được à? Tớ biết ơn cậu lắm."
            }
          ],
          "id": "sj-trung-13-b24-12-ex03",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "cb1f9726-a799-5a24-9914-1f3266aab02a"
        }
      ]
    },
    {
      "item_id": "sj-trung-13-b07-129",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn báo đã đặt được lịch hẹn tiếp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来週の診察、予約できたよ。",
              "vi": "Tớ đặt được lịch khám tuần sau rồi."
            },
            {
              "speaker_id": "B",
              "ja": "よかったね。これで予定が立てられるね。",
              "vi": "Mừng quá. Vậy lên kế hoạch được rồi nhỉ."
            }
          ],
          "id": "sj-trung-13-b07-129-ex01",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "066c5305-eaec-5f64-be75-0bed83c09196"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đồng nghiệp báo đã sắp được lịch làm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "上司が勤務時間の変更を認めてくれました。",
              "vi": "Sếp đã đồng ý đổi giờ làm cho tôi."
            },
            {
              "speaker_id": "B",
              "ja": "よかったですね。安心しました。",
              "vi": "Mừng cho anh quá. Tôi cũng yên tâm rồi."
            }
          ],
          "id": "sj-trung-13-b07-129-ex02",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "058ef0cc-cc1b-5eaa-9671-24ca092a2a71"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Gia đình đã chốt được người liên hệ khi kế hoạch đổi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "連絡する人が決まったよ。",
              "vi": "Đã quyết định được người liên lạc rồi."
            },
            {
              "speaker_id": "B",
              "ja": "よかったね。これで慌てずに済むね。",
              "vi": "Tốt quá. Vậy mình đỡ cuống khi có thay đổi."
            }
          ],
          "id": "sj-trung-13-b07-129-ex03",
          "topic_uid": "82677fd3-7762-5d70-9dd0-ac2411b04f1b",
          "situation_uid": "baf78b16-f9dd-5cbc-be10-6426e425abe5"
        }
      ]
    }
  ]
}
