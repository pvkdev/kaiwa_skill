{
  "stage_uid": "21ae71c9-bfdf-56b4-95ce-ad27bd0d0511",
  "items": [
    {
      "item_id": "sj-trung-03-b07-91",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi trước khi nhờ bạn giúp chuyển đồ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "悪いんだけど、今ちょっと頼んでもいい？",
              "vi": "Phiền cậu chút, giờ tớ nhờ một việc được không?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、何？",
              "vi": "Ừ, việc gì vậy?"
            }
          ],
          "id": "sj-trung-03-b07-91-ex01",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "d71e31fa-159a-5940-b823-99354547edb9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhờ đồng nghiệp kiểm tài liệu trước chiều.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "悪いんだけど、今日の三時までにこの表を見てもらえる？",
              "vi": "Phiền anh xem giúp bảng này trước ba giờ chiều được không?"
            },
            {
              "speaker_id": "B",
              "ja": "その時間なら大丈夫です。",
              "vi": "Trước giờ đó thì được."
            }
          ],
          "id": "sj-trung-03-b07-91-ex02",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "fac95529-a26d-5000-b875-1a6860324416"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Mở lời từ chối vì đã có lịch khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "悪いんだけど、今日はその仕事を引き受けられないんだ。",
              "vi": "Xin lỗi cậu, hôm nay tớ không nhận việc ấy được."
            },
            {
              "speaker_id": "B",
              "ja": "分かった。別の人に聞いてみる。",
              "vi": "Ừ, tớ sẽ hỏi người khác."
            }
          ],
          "id": "sj-trung-03-b07-91-ex03",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "dc8a3e95-1f3b-5b90-9180-043c2d5882ed"
        }
      ]
    },
    {
      "item_id": "sj-trung-03-b06-95",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn nghĩ có thể dời việc sang ngày khác, nhưng lịch kín.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "じゃあ、明日に回せない？",
              "vi": "Vậy dời sang mai được không?"
            },
            {
              "speaker_id": "B",
              "ja": "明日も締め切りがあるから、そういうわけにはいかないんだ。",
              "vi": "Mai tớ cũng có hạn chót, nên không làm thế được."
            }
          ],
          "id": "sj-trung-03-b06-95-ex01",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "89ddb889-a112-5c95-9274-f9a22442f676"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Phạm vi nhờ việc tăng thêm sau khi đã nhận lời.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "残りも全部お願いしていい？",
              "vi": "Tớ nhờ cậu làm luôn tất cả phần còn lại được không?"
            },
            {
              "speaker_id": "B",
              "ja": "最初の分はやるけど、そういうわけにはいかないよ。",
              "vi": "Phần ban đầu tớ sẽ làm, nhưng nhận hết như thế thì không được."
            }
          ],
          "id": "sj-trung-03-b06-95-ex02",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "d5408afe-595e-5a02-a59a-0a37a1e74224"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn đề nghị cứ hứa giúp dù chỉ rảnh mười phút.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "とりあえず引き受けたことにしてくれない？",
              "vi": "Cứ nói là cậu nhận lời trước được không?"
            },
            {
              "speaker_id": "B",
              "ja": "できるのは十分だけだから、そういうわけにはいかないよ。",
              "vi": "Tớ chỉ giúp được mười phút, nên không thể hứa như thế."
            }
          ],
          "id": "sj-trung-03-b06-95-ex03",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "d8779199-e4b7-56d6-90de-c70a18a8106a"
        }
      ]
    },
    {
      "item_id": "sj-trung-03-b12-75",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nói trước rằng mình không ở lại tối được.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は六時で帰らせてもらうね。それまでに前半を終わらせる。",
              "vi": "Hôm nay cho tớ về lúc sáu giờ nhé. Trước đó tớ sẽ xong phần đầu."
            },
            {
              "speaker_id": "B",
              "ja": "分かった。後半は僕がやるよ。",
              "vi": "Ừ. Phần sau để tớ làm."
            }
          ],
          "id": "sj-trung-03-b12-75-ex01",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "314a4619-a85b-5d8e-9d93-19327a574b60"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi giúp một phần, người giúp phải dừng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "申し訳ないけど、ここで失礼させてもらうよ。",
              "vi": "Xin lỗi, cho tớ dừng ở đây và về nhé."
            },
            {
              "speaker_id": "B",
              "ja": "ここまで助かったよ。ありがとう。",
              "vi": "Cậu giúp được đến đây là quý rồi. Cảm ơn cậu."
            }
          ],
          "id": "sj-trung-03-b12-75-ex02",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "e3e4aa14-c6c6-5087-9a2a-caa7d84ec21d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin phép chia công việc ra hai ngày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "残りは明日やらせてもらってもいい？",
              "vi": "Cho tớ làm phần còn lại vào ngày mai được không?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、明日の午前中なら大丈夫。",
              "vi": "Ừ, sáng mai thì được."
            }
          ],
          "id": "sj-trung-03-b12-75-ex03",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "2adc1bc3-a919-5378-88dd-c1fb3ef9e2d0"
        }
      ]
    },
    {
      "item_id": "sj-trung-03-b24-21",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhờ bạn phụ phần kiểm cuối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "最後の確認だけ手伝ってくれるとありがたいんだけど。",
              "vi": "Nếu cậu giúp tớ kiểm lần cuối thì quý quá."
            },
            {
              "speaker_id": "B",
              "ja": "うん、五時からなら見られるよ。",
              "vi": "Ừ, từ năm giờ tớ xem được."
            }
          ],
          "id": "sj-trung-03-b24-21-ex01",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "fac95529-a26d-5000-b875-1a6860324416"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người kia chỉ giúp được một phần.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前半だけでも見てもらえたらうれしい。",
              "vi": "Nếu anh xem giúp được phần đầu thôi thì tôi cũng mừng rồi."
            },
            {
              "speaker_id": "B",
              "ja": "そこまでならできます。",
              "vi": "Đến phần đó thì tôi làm được."
            }
          ],
          "id": "sj-trung-03-b24-21-ex02",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "1d089b9d-c242-51c5-b94f-3432d622754c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhờ sửa một điểm nhỏ của kết quả.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この数字だけ直してもらえるとありがたいです。",
              "vi": "Nếu chị sửa giúp riêng con số này thì tốt quá ạ."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。今日中に直します。",
              "vi": "Được, hôm nay tôi sẽ sửa."
            }
          ],
          "id": "sj-trung-03-b24-21-ex03",
          "topic_uid": "50ef9531-2517-520a-930d-4379aff980ab",
          "situation_uid": "aeadd99c-bea2-5695-8c2a-7e6ba361538c"
        }
      ]
    }
  ]
}
