{
  "stage_uid": "fb6329f0-9774-57ad-a3ab-650942847914",
  "items": [
    {
      "item_id": "sj-thuong-18-b12-917",
      "practice": [
        {
          "id": "sj-thuong-18-b12-917-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "94bf4373-dd3e-527f-940b-4af4ab198417",
          "context_vi": "Khách muốn nhanh và đủ, nhóm chia hai giai đoạn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "全部を今月中に入れるのは難しく、必要な部分を先に出す案にしました。というわけで、第一段階の範囲を今日決めたいです。",
              "vi": "Làm đủ tất cả trong tháng này rất khó, nên chúng tôi đề xuất giao phần cần trước. Vì vậy hôm nay tôi muốn chốt phạm vi giai đoạn đầu."
            },
            {
              "speaker_id": "B",
              "ja": "まず申込画面を優先しましょう。",
              "vi": "Trước hết ưu tiên màn hình đăng ký."
            }
          ]
        },
        {
          "id": "sj-thuong-18-b12-917-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "39c6a4f3-88b8-57ff-89cb-c8b4a0399409",
          "context_vi": "Đầu vào khách chậm, bàn dời một phần mốc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách hàng",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "必要なデータは来週になります。",
              "vi": "Dữ liệu cần thiết tới tuần sau mới có."
            },
            {
              "speaker_id": "B",
              "ja": "というわけで、確認作業だけ先に進め、納品日はデータを受け取ってから決め直します。",
              "vi": "Vì vậy chúng tôi sẽ làm trước phần kiểm tra, còn ngày giao sẽ chốt lại sau khi nhận dữ liệu."
            },
            {
              "speaker_id": "A",
              "ja": "それでお願いします。",
              "vi": "Vậy nhé."
            }
          ]
        },
        {
          "id": "sj-thuong-18-b12-917-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "40e1d3aa-8d39-5f35-af09-a7d1859df689",
          "context_vi": "Sau dự án, đổi cách báo tin xấu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前回は問題の連絡が一日遅れたね。",
              "vi": "Lần trước ta báo sự cố chậm một ngày nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "そう。というわけで、次回は原因が未確定でも影響が分かった時点で知らせよう。",
              "vi": "Đúng. Vì vậy lần sau, dù chưa rõ nguyên nhân, hễ biết ảnh hưởng là báo ngay."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-18-b12-1386",
      "practice": [
        {
          "id": "sj-thuong-18-b12-1386-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "f06627f8-908c-5aa6-9c08-d35d53c5256c",
          "context_vi": "Giải thích vì sao chưa hứa được mốc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "原因を調べる担当がログを確認中です。復旧時刻はまだ出せません。そういうわけです。午後四時に状況をお伝えします。",
              "vi": "Người phụ trách đang kiểm log tìm nguyên nhân. Chúng tôi chưa thể báo giờ khôi phục. Tình hình là vậy. Bốn giờ chiều tôi sẽ cập nhật."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。四時にお願いします。",
              "vi": "Tôi hiểu. Xin gọi lúc bốn giờ."
            }
          ]
        },
        {
          "id": "sj-thuong-18-b12-1386-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "2f38bd86-925c-5c71-9653-f2544fe7fb76",
          "context_vi": "Giải thích vì sao chưa báo giá sau yêu cầu đổi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "変更で検証項目が増えます。費用を先に確認する必要があります。そういうわけです。明日までに見積もりをお送りします。",
              "vi": "Thay đổi này làm tăng hạng mục kiểm thử. Chúng tôi cần kiểm chi phí trước. Tình hình là vậy. Mai tôi sẽ gửi báo giá."
            },
            {
              "speaker_id": "B",
              "ja": "見積もりを待ちます。",
              "vi": "Tôi sẽ đợi báo giá."
            }
          ]
        },
        {
          "id": "sj-thuong-18-b12-1386-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "e14dc8f6-44a5-505e-82b6-b496e42581af",
          "context_vi": "Giải thích dự án chưa hết hỗ trợ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "納品は終わったので、もう問い合わせは受けないんですね。",
              "vi": "Đã bàn giao rồi nên ta không nhận hỏi đáp nữa nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、今週は運用確認が残っています。そういうわけなので、窓口はまだ開けておきます。",
              "vi": "Không. Tuần này còn theo dõi vận hành. Vì vậy ta vẫn mở đầu mối hỗ trợ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-18-b12-955",
      "practice": [
        {
          "id": "sj-thuong-18-b12-955-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "d1610cce-d8c1-5351-8e8b-11eb57eb827b",
          "context_vi": "Chốt người kiểm mẫu sau khi hai bên cùng tưởng người khác làm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "見本の確認は私がします。あと、結果をお客様に伝えるのはお願いできますか。",
              "vi": "Tôi sẽ kiểm mẫu. Thêm nữa, anh có thể báo kết quả cho khách không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。確認が終わったら教えてください。",
              "vi": "Được. Xong kiểm tra thì báo tôi."
            }
          ]
        },
        {
          "id": "sj-thuong-18-b12-955-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "d3860e51-95ad-5ce4-8240-328a21162629",
          "context_vi": "Báo phần hoàn thành và phần còn kiểm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "画面の修正は終わりました。あと、通知メールは今日の午後に確認します。",
              "vi": "Phần sửa màn hình đã xong. Thêm nữa, chiều nay chúng tôi sẽ kiểm email thông báo."
            },
            {
              "speaker_id": "B",
              "ja": "確認後に連絡してください。",
              "vi": "Kiểm xong hãy liên hệ nhé."
            }
          ]
        },
        {
          "id": "sj-thuong-18-b12-955-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "2f6843a9-babd-5b86-964b-7bca9fe9c090",
          "context_vi": "Bàn giao trạng thái cuối và đầu mối hỗ trợ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "本体の引き渡しは完了しました。あと、来週の問い合わせ窓口は佐藤です。",
              "vi": "Phần bàn giao chính đã xong. Thêm nữa, đầu mối hỗ trợ tuần sau là Sato."
            },
            {
              "speaker_id": "B",
              "ja": "連絡先を共有してください。",
              "vi": "Hãy gửi tôi thông tin liên lạc."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-18-b12-998",
      "practice": [
        {
          "id": "sj-thuong-18-b12-998-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "7db9a37e-bf84-5996-b79f-1b3c05101f5e",
          "context_vi": "Báo lỗi và thêm tác động khách đã xác nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "申込画面でエラーが出ています。しかも、二社のお客様が同じ画面で止まったと連絡しています。",
              "vi": "Màn hình đăng ký đang báo lỗi. Hơn nữa, hai khách hàng đã báo bị kẹt ở đúng màn hình đó."
            },
            {
              "speaker_id": "B",
              "ja": "影響範囲を先に確認しよう。",
              "vi": "Ta kiểm phạm vi ảnh hưởng trước."
            }
          ]
        },
        {
          "id": "sj-thuong-18-b12-998-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "13d4b74f-31bf-52d1-962c-06cb58e089aa",
          "context_vi": "Khách phát hiện thêm điểm chưa đạt trong buổi thử.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách hàng",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "入力はできました。しかも、前回より速くなっています。ただ、通知が届きません。",
              "vi": "Tôi đã nhập được. Hơn nữa, hệ thống còn nhanh hơn lần trước. Nhưng thông báo chưa tới."
            },
            {
              "speaker_id": "B",
              "ja": "通知の条件を確認します。",
              "vi": "Tôi sẽ kiểm điều kiện gửi thông báo."
            }
          ]
        },
        {
          "id": "sj-thuong-18-b12-998-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "2b881f13-9a97-5237-99f7-fad8c6865c6e",
          "context_vi": "Nhìn lại điều đã giúp nhóm đúng mốc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "早めに確認用の画面を渡したのが効いたね。",
              "vi": "Việc đưa màn hình để kiểm sớm đã phát huy tác dụng nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "しかも、先方からその日に指摘をもらえたので、修正に時間を取れました。",
              "vi": "Hơn nữa, khách góp ý ngay hôm đó nên ta có thời gian sửa."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-18-b12-1366",
      "practice": [
        {
          "id": "sj-thuong-18-b12-1366-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "d3860e51-95ad-5ce4-8240-328a21162629",
          "context_vi": "Kết phần báo cáo tiến độ ngắn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "修正は完了し、通知機能は今日の午後に確認します。私からの進捗報告は以上です。",
              "vi": "Phần sửa đã xong, tính năng thông báo sẽ kiểm chiều nay. Tôi báo cáo tiến độ đến đây là hết."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとう。確認担当は誰？",
              "vi": "Cảm ơn. Ai phụ trách kiểm tra?"
            }
          ]
        },
        {
          "id": "sj-thuong-18-b12-1366-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "0d777f88-e675-5edd-81d7-3e7aa2970f4b",
          "context_vi": "Sau khi xác minh nguyên nhân, báo khách đúng mức.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "確認できた原因は設定の不一致です。対応の説明は以上です。ご質問はございますか。",
              "vi": "Nguyên nhân đã xác minh là cấu hình không khớp. Phần giải thích cách xử lý đến đây là hết. Anh có câu hỏi nào không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "復旧の見込みはいつですか。",
              "vi": "Dự kiến khi nào khôi phục?"
            }
          ]
        },
        {
          "id": "sj-thuong-18-b12-1366-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "17693f67-6b41-5cb5-8888-6041205e29fa",
          "situation_uid": "5bb4b45c-aaf0-5904-a47e-92f655657ab0",
          "context_vi": "Nói với khách điều học được sau dự án.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご指摘を受けて、更新の連絡を早めることにしました。今回の振り返りは以上です。",
              "vi": "Từ góp ý của anh, chúng tôi quyết định báo cập nhật sớm hơn. Phần nhìn lại dự án đến đây là hết."
            },
            {
              "speaker_id": "B",
              "ja": "次回に反映されると助かります。",
              "vi": "Nếu lần tới được áp dụng thì tốt."
            }
          ]
        }
      ]
    }
  ]
}
