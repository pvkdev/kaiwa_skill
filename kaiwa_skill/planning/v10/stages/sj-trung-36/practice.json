{
  "stage_uid": "8787c4bf-0c68-5d47-8841-fe5d39fb9489",
  "items": [
    {
      "item_id": "sj-trung-36-b12-98",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe người học kể môn đang khó, hỏi tiếp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "数学は少し苦手なんです。",
              "vi": "Em hơi yếu môn toán."
            },
            {
              "speaker_id": "B",
              "ja": "それで、どの部分が一番難しいですか。",
              "vi": "Rồi phần nào khó nhất với em?"
            }
          ],
          "id": "sj-trung-36-b12-98-ex01",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "ae98212e-32b6-5e57-af9f-8efa32aa9b42"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi thử cách học mới, giáo viên mời kể tiếp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "毎日十分ずつ復習しました。",
              "vi": "Em đã ôn mười phút mỗi ngày."
            },
            {
              "speaker_id": "B",
              "ja": "それで、授業は前より分かりやすくなりましたか。",
              "vi": "Rồi em thấy bài trên lớp dễ hiểu hơn trước chưa?"
            }
          ],
          "id": "sj-trung-36-b12-98-ex02",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "1d73bbc5-4dca-5db2-9641-b99eaea6c4c5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người học kể đã thử học phụ đạo, giáo viên hỏi tiếp kết quả.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先週から放課後の補習に出ています。",
              "vi": "Từ tuần trước em bắt đầu học phụ đạo sau giờ học."
            },
            {
              "speaker_id": "B",
              "ja": "それで、授業についていけそうですか。",
              "vi": "Rồi em thấy theo kịp lớp chưa?"
            },
            {
              "speaker_id": "A",
              "ja": "少しずつ分かるようになりました。",
              "vi": "Em đã hiểu dần rồi ạ."
            }
          ],
          "id": "sj-trung-36-b12-98-ex03",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "bc3d685d-4e32-5f3f-a8d2-00aa98bdff2d"
        }
      ]
    },
    {
      "item_id": "sj-trung-36-b11-67",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi ý kiến về hai chương trình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Giáo viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二つの課程を見て、どう思いましたか。",
              "vi": "Sau khi xem hai chương trình, em thấy thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "実習が多いほうにひかれます。",
              "vi": "Em thích chương trình có nhiều thực hành hơn."
            }
          ],
          "id": "sj-trung-36-b11-67-ex01",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "46c39826-d729-58cc-bcbe-81146c1414a5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi tình hình lớp đang theo.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Giáo viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今の授業はどうですか。",
              "vi": "Lớp hiện nay thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "進むのが速くて、少しついていけません。",
              "vi": "Bài đi nhanh nên em theo chưa kịp."
            }
          ],
          "id": "sj-trung-36-b11-67-ex02",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "bc3d685d-4e32-5f3f-a8d2-00aa98bdff2d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Gợi lịch học khác khi thời gian thay đổi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Giáo viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "週末のコースはどうですか。",
              "vi": "Khóa cuối tuần thì sao?"
            },
            {
              "speaker_id": "B",
              "ja": "それなら通えそうです。",
              "vi": "Khóa đó chắc em theo được."
            }
          ],
          "id": "sj-trung-36-b11-67-ex03",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "4ac30da0-0287-57ab-87f4-d4cfa8ba069b"
        }
      ]
    },
    {
      "item_id": "sj-trung-36-b20-26",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nói cách học theo quỹ thời gian hiện có.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "毎日三十分、コツコツ勉強したいです。",
              "vi": "Em muốn học đều đặn mỗi ngày ba mươi phút."
            },
            {
              "speaker_id": "B",
              "ja": "それなら続けやすいですね。",
              "vi": "Vậy sẽ dễ duy trì hơn."
            }
          ],
          "id": "sj-trung-36-b20-26-ex01",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "2683abf7-f0b7-5662-8ad0-6270d9e8634c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo tiến bộ sau khi thử cách học.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "単語をコツコツ覚えたら、文章が読みやすくなりました。",
              "vi": "Em học từ đều đặn nên đọc đoạn văn dễ hơn."
            },
            {
              "speaker_id": "B",
              "ja": "いい調子ですね。",
              "vi": "Tiến bộ tốt đấy."
            }
          ],
          "id": "sj-trung-36-b20-26-ex02",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "1d73bbc5-4dca-5db2-9641-b99eaea6c4c5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chưa quyết chương trình, vẫn chuẩn bị từng bước.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "進路はまだ決めていませんが、語学はコツコツ続けます。",
              "vi": "Em chưa quyết hướng học, nhưng sẽ tiếp tục học tiếng đều đặn."
            },
            {
              "speaker_id": "B",
              "ja": "その間に条件も調べましょう。",
              "vi": "Trong lúc đó ta tìm hiểu các điều kiện nhé."
            }
          ],
          "id": "sj-trung-36-b20-26-ex03",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "27f63ecd-5f20-572b-a805-309a4f91c710"
        }
      ]
    },
    {
      "item_id": "sj-trung-36-b24-28",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi điều kiện tham gia chương trình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người tư vấn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "条件をしっかり理解してから申し込みたいです。",
              "vi": "Em muốn hiểu kỹ điều kiện rồi mới đăng ký."
            },
            {
              "speaker_id": "B",
              "ja": "具体例で説明しますね。",
              "vi": "Tôi sẽ giải thích bằng ví dụ nhé."
            }
          ],
          "id": "sj-trung-36-b24-28-ex01",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "6d3bb3f8-726c-5149-bfd0-04083a08745a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nói mình học nghiêm túc nhưng môn còn khó.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "毎日真面目に勉強していますが、数学はまだ苦手です。",
              "vi": "Em học nghiêm túc mỗi ngày, nhưng toán vẫn còn yếu."
            },
            {
              "speaker_id": "B",
              "ja": "どの単元が難しいか見ましょう。",
              "vi": "Ta xem phần nào khó nhé."
            }
          ],
          "id": "sj-trung-36-b24-28-ex02",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "ae98212e-32b6-5e57-af9f-8efa32aa9b42"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chốt lựa chọn và đầu mối bước sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người tư vấn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "次の手続きをしっかり確認してから進めます。",
              "vi": "Em sẽ kiểm kỹ thủ tục tiếp theo rồi tiến hành."
            },
            {
              "speaker_id": "B",
              "ja": "では、担当者をご紹介します。",
              "vi": "Vậy tôi sẽ giới thiệu người phụ trách."
            }
          ],
          "id": "sj-trung-36-b24-28-ex03",
          "topic_uid": "10ec0dc6-a5f1-5c48-85af-e545d81865cc",
          "situation_uid": "4798e2c5-d5e7-5843-96d2-5cd6b59ac400"
        }
      ]
    }
  ]
}
