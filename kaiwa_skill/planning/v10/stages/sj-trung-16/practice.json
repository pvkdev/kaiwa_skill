{
  "stage_uid": "e0c47e0a-2969-545c-97a5-dc700f468b32",
  "items": [
    {
      "item_id": "sj-trung-16-b18-651",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Tự giới thiệu tại buổi công ty.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "御社の開発部門について、少し伺いたいです。",
              "vi": "Tôi muốn hỏi chút về bộ phận phát triển của quý công ty ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、どうぞ。",
              "vi": "Vâng, xin cứ hỏi."
            }
          ],
          "id": "sj-trung-16-b18-651-ex01",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "b731491c-795a-5af0-8b18-a442f2b51cfc"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi vai trò của người mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "御社では、新人は最初にどんな仕事を担当しますか。",
              "vi": "Ở quý công ty, nhân viên mới ban đầu phụ trách việc gì ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "まず先輩と一緒に小さな案件を担当します。",
              "vi": "Ban đầu họ làm dự án nhỏ cùng người đi trước."
            }
          ],
          "id": "sj-trung-16-b18-651-ex02",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "fdd667ea-f372-5ff5-a163-0f128b10df12"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin buổi trao đổi ngắn sau sự kiện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "御社の仕事をもっと知りたいので、後日お話しする機会をいただけますか。",
              "vi": "Tôi muốn hiểu thêm công việc ở quý công ty, sau này xin một buổi trao đổi được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "担当に確認します。",
              "vi": "Tôi sẽ hỏi người phụ trách."
            }
          ],
          "id": "sj-trung-16-b18-651-ex03",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "c4ae9e0f-8f7d-5b6d-b2cb-30e6fe58142f"
        }
      ]
    },
    {
      "item_id": "sj-trung-16-b12-101",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi cảm giác lúc mới vào công ty.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tiền bối",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "入社したばかりの頃は、どんな感じでしたか。",
              "vi": "Khi mới vào công ty, anh thấy thế nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "分からないことが多くて、毎日質問していました。",
              "vi": "Có rất nhiều điều chưa biết nên ngày nào tôi cũng hỏi."
            }
          ],
          "id": "sj-trung-16-b12-101-ex01",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "988c2df7-69c1-5965-971a-68e52018d769"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chưa hình dung công việc của bộ phận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その部署は、普段どんな感じで仕事を進めますか。",
              "vi": "Bộ phận đó thường làm việc theo cách nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "少人数で相談しながら進めます。",
              "vi": "Chúng tôi làm theo nhóm nhỏ và thường trao đổi với nhau."
            }
          ],
          "id": "sj-trung-16-b12-101-ex02",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "490a4dfb-c0f4-5b4e-b57e-a638c605aa3a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi ấn tượng về môi trường khi thông tin còn thay đổi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tiền bối",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今の職場はどんな感じですか。",
              "vi": "Không khí nơi làm việc hiện nay thế nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "落ち着いていますが、部署によって違います。",
              "vi": "Khá điềm tĩnh, nhưng tùy bộ phận."
            }
          ],
          "id": "sj-trung-16-b12-101-ex03",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "3032b337-7b2a-5751-bd1c-1cf9a637fc33"
        }
      ]
    },
    {
      "item_id": "sj-trung-16-b06-73",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Lịch thực tập đổi, chưa quyết ngay.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "開始日が一週間早まりました。参加できますか。",
              "vi": "Ngày bắt đầu sớm hơn một tuần. Chị tham gia được không?"
            },
            {
              "speaker_id": "B",
              "ja": "予定を確認して検討します。",
              "vi": "Tôi sẽ xem lịch rồi cân nhắc ạ."
            }
          ],
          "id": "sj-trung-16-b06-73-ex01",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "9b5f6c91-11e7-53a3-bd14-f078706c6fa2"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Được mời đăng ký ngay nhưng muốn tìm hiểu thêm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日中に応募しますか。",
              "vi": "Hôm nay chị đăng ký luôn chứ?"
            },
            {
              "speaker_id": "B",
              "ja": "仕事内容をもう少し伺ってから検討します。",
              "vi": "Tôi muốn hỏi thêm về công việc rồi sẽ cân nhắc."
            }
          ],
          "id": "sj-trung-16-b06-73-ex02",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "c4ae9e0f-8f7d-5b6d-b2cb-30e6fe58142f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Công việc chưa hợp, giữ lời đáp lịch sự.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "選考に進まれますか。",
              "vi": "Anh có muốn vào vòng tuyển chọn không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "今回は見送りますが、今後また検討します。",
              "vi": "Lần này tôi xin thôi, nhưng sau này sẽ cân nhắc lại ạ."
            }
          ],
          "id": "sj-trung-16-b06-73-ex03",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "32e8975c-0468-5207-892b-d736fcaacfc8"
        }
      ]
    },
    {
      "item_id": "sj-trung-16-b07-73",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Tên bộ phận nghe quen nhưng việc chưa rõ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その部署、君に合いそう？",
              "vi": "Bộ phận đó có hợp với cậu không?"
            },
            {
              "speaker_id": "B",
              "ja": "微妙だね。名前だけでは仕事の中身が分からない。",
              "vi": "Khó nói lắm. Chỉ nghe tên thì chưa rõ công việc thực tế."
            }
          ],
          "id": "sj-trung-16-b07-73-ex01",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "490a4dfb-c0f4-5b4e-b57e-a638c605aa3a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Lịch mới có thể va lịch học.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "新しい日程でも行ける？",
              "vi": "Lịch mới cậu đi được không?"
            },
            {
              "speaker_id": "B",
              "ja": "微妙だな。授業の予定を確認しないと。",
              "vi": "Khó nói đấy. Tớ phải xem lịch học đã."
            }
          ],
          "id": "sj-trung-16-b07-73-ex02",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "9b5f6c91-11e7-53a3-bd14-f078706c6fa2"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau buổi giới thiệu, thấy vị trí chưa hợp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "応募するつもり？",
              "vi": "Cậu định ứng tuyển à?"
            },
            {
              "speaker_id": "B",
              "ja": "微妙かな。今の希望とは少し違う。",
              "vi": "Tớ thấy hơi khó nói. Nó khác điều tớ mong một chút."
            }
          ],
          "id": "sj-trung-16-b07-73-ex03",
          "topic_uid": "c042c8e0-8567-536d-acb8-a6106fcfebad",
          "situation_uid": "32e8975c-0468-5207-892b-d736fcaacfc8"
        }
      ]
    }
  ]
}
