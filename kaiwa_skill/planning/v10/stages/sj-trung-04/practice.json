{
  "stage_uid": "37c31e4c-4897-5077-8f09-029e67ae4332",
  "items": [
    {
      "item_id": "sj-trung-04-b12-13",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Muốn bàn lại cách chia ngăn tủ lạnh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn cùng nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "冷蔵庫の使い方なんだけど、棚を一段ずつ分けない？",
              "vi": "Về cách dùng tủ lạnh, mỗi người dùng một ngăn nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "いいね。そうしよう。",
              "vi": "Được đấy. Làm vậy đi."
            }
          ],
          "id": "sj-trung-04-b12-13-ex01",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "fccb53ca-369f-5411-bd85-8980fc32f907"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nêu tiếng ồn lúc đêm khuya với bạn cùng nhà.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn cùng nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "夜の音のことなんだけど、十二時を過ぎると眠れなくて。",
              "vi": "Về tiếng ồn buổi tối, sau mười hai giờ tớ không ngủ được."
            },
            {
              "speaker_id": "B",
              "ja": "ごめん。気をつけるね。",
              "vi": "Xin lỗi. Tớ sẽ chú ý."
            }
          ],
          "id": "sj-trung-04-b12-13-ex02",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "c509ace2-29f1-564b-805f-ce7228d6cbdd"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi lại món đồ để ở khu chung.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn cùng nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "玄関の箱なんだけど、誰のものか分かる？",
              "vi": "Cái hộp ở cửa ra vào ấy, cậu biết của ai không?"
            },
            {
              "speaker_id": "B",
              "ja": "僕のだよ。今日中に片づける。",
              "vi": "Của tớ. Hôm nay tớ sẽ dọn."
            }
          ],
          "id": "sj-trung-04-b12-13-ex03",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "42abd2f1-ccd4-506c-a59d-6c77d1786a2f"
        }
      ]
    },
    {
      "item_id": "sj-trung-04-b12-52",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người cùng nhà tưởng đồ mình là đồ dùng chung.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn cùng nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この鍋、みんなで使っていいんだよね？",
              "vi": "Cái nồi này mọi người dùng chung được nhỉ?"
            },
            {
              "speaker_id": "B",
              "ja": "違うよ。私のだから、使う前に声をかけてね。",
              "vi": "Không đâu. Nồi của tớ, trước khi dùng cậu hỏi tớ nhé."
            }
          ],
          "id": "sj-trung-04-b12-52-ex01",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "214ae04a-4362-53da-872f-f0a73ddbf4c6"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe nhắc nhầm về vật chắn lối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn cùng nhà",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この自転車、あなたの？",
              "vi": "Xe đạp này của cậu à?"
            },
            {
              "speaker_id": "B",
              "ja": "違うよ。僕のは外の駐輪場にある。",
              "vi": "Không, xe của tớ ở chỗ để xe bên ngoài."
            }
          ],
          "id": "sj-trung-04-b12-52-ex02",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "1eb1b7f0-28a2-5877-b572-92d110675474"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai bên hiểu nhầm chủ sở hữu món đồ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn cùng nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この箱は田中さんのだと思ってた。",
              "vi": "Tớ tưởng hộp này của anh Tanaka."
            },
            {
              "speaker_id": "B",
              "ja": "違うよ、私の。今日持っていくね。",
              "vi": "Không, của tớ. Hôm nay tớ mang đi."
            }
          ],
          "id": "sj-trung-04-b12-52-ex03",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "42abd2f1-ccd4-506c-a59d-6c77d1786a2f"
        }
      ]
    },
    {
      "item_id": "sj-trung-04-b06-88",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi đổi khung giờ dùng chung, chờ xem có ổn không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn cùng nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まず一週間、この時間で様子を見よう。",
              "vi": "Trước mắt thử khung giờ này một tuần xem sao."
            },
            {
              "speaker_id": "B",
              "ja": "うん、問題があったらまた話そう。",
              "vi": "Ừ, có vấn đề thì mình bàn lại."
            }
          ],
          "id": "sj-trung-04-b06-88-ex01",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "904097e5-558c-50b3-ba12-18cd70898ea5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Tiếng ồn lặp lại dù đã nhắc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn cùng nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もう一日だけ様子を見て、それでも続くなら管理人さんに相談しよう。",
              "vi": "Theo dõi thêm một ngày; nếu vẫn tiếp diễn thì mình hỏi quản lý nhé."
            },
            {
              "speaker_id": "B",
              "ja": "そうだね。",
              "vi": "Ừ, vậy đi."
            }
          ],
          "id": "sj-trung-04-b06-88-ex02",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "8fb2ec84-d1e1-5304-a0d7-7dbbd420f8a9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Phòng gần bếp có thể ồn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người giới thiệu",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すぐ決めずに、夜の様子を見てから返事してもいい？",
              "vi": "Cho tớ xem tình hình buổi tối rồi mới trả lời, không quyết ngay được không?"
            },
            {
              "speaker_id": "B",
              "ja": "もちろん。",
              "vi": "Tất nhiên rồi."
            }
          ],
          "id": "sj-trung-04-b06-88-ex03",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "19feafe7-5380-57f4-bd9b-3e642b14e41b"
        }
      ]
    },
    {
      "item_id": "sj-trung-04-b07-146",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe chưa rõ giờ yên tĩnh của nhà.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người giới thiệu",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "静かにする時間、もう一度いいですか。",
              "vi": "Giờ cần giữ yên tĩnh, anh nhắc lại giúp tôi được không?"
            },
            {
              "speaker_id": "B",
              "ja": "夜十時からです。",
              "vi": "Từ mười giờ tối."
            }
          ],
          "id": "sj-trung-04-b07-146-ex01",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "deeb8e03-10c2-529a-a25b-263d69e8599f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xác nhận điều kiện dùng bếp muộn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn cùng nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "遅く使うなら、すぐ片づけてね。",
              "vi": "Nếu dùng bếp muộn thì dọn ngay nhé."
            },
            {
              "speaker_id": "B",
              "ja": "すみません、もう一度いい？",
              "vi": "Xin lỗi, cậu nói lại được không?"
            },
            {
              "speaker_id": "A",
              "ja": "使ったら、すぐ片づけてね。",
              "vi": "Dùng xong thì dọn ngay nhé."
            }
          ],
          "id": "sj-trung-04-b07-146-ex02",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "bb574920-ac04-566f-825a-93a02a566889"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe chưa rõ ngày đổi lịch dọn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn cùng nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "僕が代わりに掃除する日、もう一度言ってもらえる？",
              "vi": "Cậu nhắc lại ngày tớ dọn thay được không?"
            },
            {
              "speaker_id": "B",
              "ja": "来週の水曜日だよ。",
              "vi": "Thứ Tư tuần sau."
            }
          ],
          "id": "sj-trung-04-b07-146-ex03",
          "topic_uid": "a4d369e2-0f96-51af-85a8-586353f06bbe",
          "situation_uid": "d2c9269a-c239-5447-ae69-bfb8f54b457f"
        }
      ]
    }
  ]
}
