{
  "stage_uid": "492d6f17-c1ac-58f9-ac36-8fbd4da736e9",
  "items": [
    {
      "item_id": "sj-trung-15-b12-102",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người đại diện hỏi cách tiến hành việc tang.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "家族の代表として、どのような形で進めればよいでしょうか。",
              "vi": "Tôi đại diện gia đình; xin hỏi nên tiến hành theo cách nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "まずご希望を伺います。",
              "vi": "Trước hết tôi sẽ hỏi nguyện vọng của gia đình."
            }
          ],
          "id": "sj-trung-15-b12-102-ex01",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "4b199923-7381-578c-b1d3-b10230656fb5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi cách người ở xa tham gia.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "遠方の家族は、オンラインで参加する形にできますか。",
              "vi": "Người nhà ở xa có thể tham gia qua mạng được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、準備できます。",
              "vi": "Vâng, chúng tôi có thể chuẩn bị."
            }
          ],
          "id": "sj-trung-15-b12-102-ex02",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "6afd558e-22d5-5e24-9d7b-7c9d56b21531"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chốt cách báo tin cho từng bên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "親族には私が連絡する形で進めます。",
              "vi": "Tôi sẽ phụ trách liên lạc với họ hàng theo cách đó."
            },
            {
              "speaker_id": "B",
              "ja": "では、職場には私が伝えるね。",
              "vi": "Vậy em sẽ báo bên nơi làm việc."
            }
          ],
          "id": "sj-trung-15-b12-102-ex03",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "8ae4c68e-604d-5682-a7cb-d31c53fc9a74"
        }
      ]
    },
    {
      "item_id": "sj-trung-15-b20-24",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người đại diện mới cần tóm tắt các quyết định.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前の担当者から一から十まで聞けていないので、決まった点を教えていただけますか。",
              "vi": "Tôi chưa được người phụ trách trước kể đủ mọi chi tiết, xin anh cho biết những điểm đã chốt ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、順番にご説明します。",
              "vi": "Vâng, tôi sẽ giải thích lần lượt."
            }
          ],
          "id": "sj-trung-15-b20-24-ex01",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "246a6b40-2d4c-5c96-b0d4-e21f8179ec22"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người đại diện mới chưa biết những điều đã chốt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "姉に一から十まで説明する時間はないね。",
              "vi": "Mình không có thời gian kể từng chi tiết cho chị ấy nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "まず決まったことだけメモにまとめよう。",
              "vi": "Trước hết ta ghi lại các điểm đã chốt."
            }
          ],
          "id": "sj-trung-15-b20-24-ex02",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "246a6b40-2d4c-5c96-b0d4-e21f8179ec22"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Phân chia người báo tin.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私が一から十まで連絡するのは難しいよ。",
              "vi": "Một mình em báo hết mọi người thì khó lắm."
            },
            {
              "speaker_id": "B",
              "ja": "そうだね。親族は僕が引き受ける。",
              "vi": "Ừ. Phần họ hàng để anh lo."
            }
          ],
          "id": "sj-trung-15-b20-24-ex03",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "8ae4c68e-604d-5682-a7cb-d31c53fc9a74"
        }
      ]
    },
    {
      "item_id": "sj-trung-15-b07-88",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Muốn hỏi ý người nhà về nghi thức khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ちょっといい？その形を希望する理由を聞いてもいいかな。",
              "vi": "Cho anh hỏi chút được không? Anh muốn biết vì sao em muốn làm theo cách đó."
            },
            {
              "speaker_id": "B",
              "ja": "祖母の希望だったから。",
              "vi": "Vì đó là nguyện vọng của bà."
            }
          ],
          "id": "sj-trung-15-b07-88-ex01",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "4da747db-dcdf-54c6-96a8-0e30171d01bf"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin hỏi đầu mối giấy tờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、ちょっといいですか。この書類はどちらに出しますか。",
              "vi": "Xin lỗi, cho tôi hỏi chút: giấy này nộp ở đâu ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "市役所の窓口です。",
              "vi": "Ở quầy của tòa thị chính ạ."
            }
          ],
          "id": "sj-trung-15-b07-88-ex02",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "129a692d-d528-5854-93a3-fbcf0f63dcb7"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin người nhà một lúc để bàn quyết định chưa chốt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ちょっといい？この件は今夜みんなで話してから返事しよう。",
              "vi": "Này, cho anh nói chút nhé? Việc này tối nay cả nhà bàn rồi trả lời."
            },
            {
              "speaker_id": "B",
              "ja": "うん、それがいい。",
              "vi": "Ừ, như vậy tốt."
            }
          ],
          "id": "sj-trung-15-b07-88-ex03",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "b812fee3-a1ef-51b3-8bbb-28ec763c6c23"
        }
      ]
    },
    {
      "item_id": "sj-trung-15-b06-121",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhờ nhân viên tư vấn bước đầu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初めてで分からないことが多いので、頼りにしています。",
              "vi": "Đây là lần đầu, tôi còn nhiều điều chưa rõ nên trông cậy vào anh ạ."
            },
            {
              "speaker_id": "B",
              "ja": "一つずつご案内します。",
              "vi": "Tôi sẽ hướng dẫn từng bước."
            }
          ],
          "id": "sj-trung-15-b06-121-ex01",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "4b199923-7381-578c-b1d3-b10230656fb5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người nhà nhận trách nhiệm báo tin.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "遠方の親族には僕が連絡するよ。",
              "vi": "Họ hàng ở xa để anh liên lạc."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとう。頼りにしてる。",
              "vi": "Cảm ơn anh. Em trông cậy vào anh."
            }
          ],
          "id": "sj-trung-15-b06-121-ex02",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "1ff0a8bc-d6d8-5e1f-bbde-1b87e5eac850"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người đại diện mới nhận việc thay.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Chị gái",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日から姉が代表になるよ。頼りにしてる。",
              "vi": "Từ mai chị làm đại diện nhé. Em trông cậy vào chị."
            },
            {
              "speaker_id": "B",
              "ja": "分かった。これまでの話を教えて。",
              "vi": "Ừ. Kể chị những gì đã bàn nhé."
            }
          ],
          "id": "sj-trung-15-b06-121-ex03",
          "topic_uid": "4b6016cd-a0d1-5500-9081-0b8ab16f0bb3",
          "situation_uid": "5690ac71-fc78-5c17-bbae-fa5cbb0bcd0b"
        }
      ]
    }
  ]
}
