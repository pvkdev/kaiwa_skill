{
  "stage_uid": "02fde202-c2f2-5066-9b8e-55b9ccbf62ac",
  "items": [
    {
      "item_id": "sj-trung-23-b18-445",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Giờ khách muốn đã hết, gợi giờ gần nhất.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "七時は満席です。七時半はいかがでしょうか。",
              "vi": "Bảy giờ đã hết chỗ. Bảy giờ rưỡi được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "その時間なら大丈夫です。",
              "vi": "Giờ đó thì được."
            }
          ],
          "id": "sj-trung-23-b18-445-ex01",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "4254effc-d763-5fca-a39f-8257e03f3952"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chỉ còn loại phòng khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "別のタイプのお部屋ならご用意できますが、いかがですか。",
              "vi": "Chúng tôi còn loại phòng khác, quý khách thấy sao ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "条件を聞いてから決めます。",
              "vi": "Tôi muốn nghe điều kiện trước khi quyết."
            }
          ],
          "id": "sj-trung-23-b18-445-ex02",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "cc7c85c3-1412-57a9-8a0b-cf13c2d3ca26"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đã sắp được chỗ khác, hỏi khách có chấp nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お席は入口に近い場所になります。いかがでしょうか。",
              "vi": "Chỗ ngồi sẽ gần cửa ra vào. Quý khách thấy được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、それでお願いします。",
              "vi": "Vâng, như vậy được."
            }
          ],
          "id": "sj-trung-23-b18-445-ex03",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "eb5e27cd-8017-5b40-8e06-d5c0e8ae1101"
        }
      ]
    },
    {
      "item_id": "sj-trung-23-b18-2818",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên nhận thông tin ngày giờ và số người.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご希望の日時と人数を承ります。",
              "vi": "Xin quý khách cho biết ngày giờ và số người ạ."
            },
            {
              "speaker_id": "B",
              "ja": "金曜日の六時に四人です。",
              "vi": "Thứ Sáu lúc sáu giờ, bốn người."
            }
          ],
          "id": "sj-trung-23-b18-2818-ex01",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "f2b0f48f-d3d0-513f-9aca-9b63dc2a5c60"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên nghe yêu cầu đổi đặt chỗ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "予約の時間を変えたいんですが。",
              "vi": "Tôi muốn đổi giờ đặt chỗ."
            },
            {
              "speaker_id": "B",
              "ja": "承ります。まず、お名前と元の時間を伺えますか。",
              "vi": "Vâng, tôi tiếp nhận ạ. Trước hết xin tên và giờ đặt ban đầu."
            }
          ],
          "id": "sj-trung-23-b18-2818-ex02",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "e305a179-2e9d-5bb2-b15a-2bbcbbd6b2a1"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên tiếp nhận nhu cầu đi cùng trẻ nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "小さい子どもと一緒でも大丈夫ですか。",
              "vi": "Tôi đi cùng trẻ nhỏ có được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "承りました。お子様用の椅子も必要ですか。",
              "vi": "Tôi đã ghi nhận. Quý khách có cần ghế trẻ em không ạ?"
            }
          ],
          "id": "sj-trung-23-b18-2818-ex03",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "fdcdd28a-aec2-5170-adf3-a583925789d5"
        }
      ]
    },
    {
      "item_id": "sj-trung-23-b07-93",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách từ chối ghế trẻ em theo cách thân mật với người đi cùng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "子ども用の椅子、借りる？",
              "vi": "Mượn ghế trẻ em không?"
            },
            {
              "speaker_id": "B",
              "ja": "ううん、いいよ。今日はベビーカーがあるから。",
              "vi": "Không cần đâu. Hôm nay mình có xe đẩy rồi."
            }
          ],
          "id": "sj-trung-23-b07-93-ex01",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "fdcdd28a-aec2-5170-adf3-a583925789d5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn đi cùng gợi đổi sang chỗ sát cửa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "入口の近くの席でもいい？",
              "vi": "Chỗ gần cửa ra vào cũng được chứ?"
            },
            {
              "speaker_id": "B",
              "ja": "いや、そこはいいよ。落ち着ける席を探そう。",
              "vi": "Thôi, chỗ đó tớ không muốn. Mình tìm bàn yên tĩnh hơn nhé."
            }
          ],
          "id": "sj-trung-23-b07-93-ex02",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "eb5e27cd-8017-5b40-8e06-d5c0e8ae1101"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn gợi đợi bàn giờ muộn hơn nhưng không muốn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "九時まで待つ？",
              "vi": "Đợi đến chín giờ không?"
            },
            {
              "speaker_id": "B",
              "ja": "いや、いいよ。別の店を探そう。",
              "vi": "Thôi, không cần. Mình tìm quán khác đi."
            }
          ],
          "id": "sj-trung-23-b07-93-ex03",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "4254effc-d763-5fca-a39f-8257e03f3952"
        }
      ]
    },
    {
      "item_id": "sj-trung-23-b07-180",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hệ thống không thấy đặt chỗ, hỏi thông tin khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "失礼ですが、ご予約のお名前をもう一度伺えますか。",
              "vi": "Xin lỗi, cho tôi hỏi lại tên đặt chỗ ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "山田です。",
              "vi": "Yamada ạ."
            }
          ],
          "id": "sj-trung-23-b07-180-ex01",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "5a9c1dc1-6652-5b62-a9b9-971a2baf2468"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe nhầm ngày đặt chỗ, hỏi lại cả ngày và thứ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "失礼ですが、金曜日の二十日でお間違いないでしょうか。",
              "vi": "Xin lỗi, thứ Sáu ngày hai mươi đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、その日です。",
              "vi": "Vâng, đúng ngày đó."
            }
          ],
          "id": "sj-trung-23-b07-180-ex02",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "0ef0d89e-2522-580e-84c2-5130b71894e3"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cần hỏi người phụ trách cơ sở.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "失礼ですが、確認のため少しお時間をいただけますか。",
              "vi": "Xin lỗi, cho tôi xin ít thời gian để kiểm tra được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、折り返しを待ちます。",
              "vi": "Vâng, tôi sẽ chờ anh gọi lại."
            }
          ],
          "id": "sj-trung-23-b07-180-ex03",
          "topic_uid": "6779ca57-5b5d-5067-8503-d9f67baa4563",
          "situation_uid": "771dd882-57e1-59ab-980c-ecf4ac2328b2"
        }
      ]
    }
  ]
}
