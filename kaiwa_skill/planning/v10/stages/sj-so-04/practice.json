{
  "stage_uid": "1c30005b-48ce-5f45-95bc-12bfe51d2ce5",
  "items": [
    {
      "item_id": "sj-so-04-b07-156",
      "practice": [
        {
          "id": "sj-so-04-b07-156-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8e4f2dbd-74ad-5332-a86e-ea63c1949286",
          "situation_uid": "544f4b0d-826b-5d92-b633-a608d6171f46",
          "context_vi": "Một nhân viên hết ca trước, đồng nghiệp còn làm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日の作業は終わりました。お先に失礼します。",
              "vi": "Hôm nay tôi làm xong rồi. Tôi xin phép về trước."
            },
            {
              "speaker_id": "B",
              "ja": "お疲れさまです。また明日。",
              "vi": "Anh vất vả rồi. Hẹn mai nhé."
            }
          ]
        },
        {
          "id": "sj-so-04-b07-156-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "cf29bea6-0d49-5b67-bb85-3dbfb32c2282",
          "situation_uid": "cbb308b0-9ab5-579d-8088-ceb8c77e29e7",
          "context_vi": "Cuối ngày đầu, người mới rời văn phòng trước người hướng dẫn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên mới",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người hướng dẫn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日また確認します。お先に失礼します。",
              "vi": "Ngày mai tôi sẽ hỏi lại. Tôi xin phép về trước ạ."
            },
            {
              "speaker_id": "B",
              "ja": "お疲れさまでした。",
              "vi": "Hôm nay em vất vả rồi."
            }
          ]
        },
        {
          "id": "sj-so-04-b07-156-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8e4f2dbd-74ad-5332-a86e-ea63c1949286",
          "situation_uid": "63cd2295-588b-5306-bb69-0bab1d46859a",
          "context_vi": "Một đồng nghiệp phải vào họp, người kia khép chuyện và về.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "会議が始まりますね。私はお先に失礼します。",
              "vi": "Cuộc họp sắp bắt đầu rồi nhỉ. Tôi xin phép về trước."
            },
            {
              "speaker_id": "B",
              "ja": "はい、お疲れさまでした。",
              "vi": "Vâng, chị vất vả rồi."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-04-b07-161",
      "practice": [
        {
          "id": "sj-so-04-b07-161-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8e4f2dbd-74ad-5332-a86e-ea63c1949286",
          "situation_uid": "39974159-e183-5203-8726-b410d0a56e8b",
          "context_vi": "Đồng nghiệp đang trực chào người vừa tới ca.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "おはようございます。今日もよろしくお願いします。",
              "vi": "Chào buổi sáng. Hôm nay cũng nhờ anh nhé."
            },
            {
              "speaker_id": "B",
              "ja": "お疲れさまです。今日は早いですね。",
              "vi": "Chào chị. Hôm nay chị đến sớm nhỉ."
            }
          ]
        },
        {
          "id": "sj-so-04-b07-161-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8e4f2dbd-74ad-5332-a86e-ea63c1949286",
          "situation_uid": "4aa580d1-fde2-53a8-8e2a-2545ffb1b464",
          "context_vi": "Người vừa vắng mấy ngày quay lại văn phòng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người quay lại",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お疲れさまです。お久しぶりですね。",
              "vi": "Chào chị. Lâu rồi mới gặp nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "お疲れさまです。今日から戻りました。",
              "vi": "Chào anh. Hôm nay tôi quay lại làm rồi."
            }
          ]
        },
        {
          "id": "sj-so-04-b07-161-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8e4f2dbd-74ad-5332-a86e-ea63c1949286",
          "situation_uid": "544f4b0d-826b-5d92-b633-a608d6171f46",
          "context_vi": "Người ở lại đáp đồng nghiệp về trước.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お先に失礼します。",
              "vi": "Tôi xin phép về trước."
            },
            {
              "speaker_id": "B",
              "ja": "お疲れさまです。気をつけて。",
              "vi": "Anh vất vả rồi. Về cẩn thận nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-04-b07-177",
      "practice": [
        {
          "id": "sj-so-04-b07-177-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8e4f2dbd-74ad-5332-a86e-ea63c1949286",
          "situation_uid": "4aa580d1-fde2-53a8-8e2a-2545ffb1b464",
          "context_vi": "Hai đồng nghiệp gặp lại sau vài ngày vắng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お久しぶりです。最近どうですか。",
              "vi": "Lâu rồi mới gặp. Dạo này anh thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "元気です。休みはゆっくりできました。",
              "vi": "Tôi khỏe. Mấy hôm nghỉ tôi được thư giãn."
            }
          ]
        },
        {
          "id": "sj-so-04-b07-177-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8e4f2dbd-74ad-5332-a86e-ea63c1949286",
          "situation_uid": "9ce5e198-65cd-55dd-938c-31d3cdb66ac2",
          "context_vi": "Người phụ trách nhận ra khách quen nhưng chưa chắc tên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お久しぶりです。最近どうですか。",
              "vi": "Lâu rồi không gặp. Dạo này chị thế nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "元気です。今日は相談があって来ました。",
              "vi": "Tôi khỏe. Hôm nay tôi tới có việc muốn trao đổi."
            }
          ]
        },
        {
          "id": "sj-so-04-b07-177-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8e4f2dbd-74ad-5332-a86e-ea63c1949286",
          "situation_uid": "4aa580d1-fde2-53a8-8e2a-2545ffb1b464",
          "context_vi": "Đồng nghiệp hỏi thăm người hướng dẫn quen đã nghỉ ốm vài ngày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người hướng dẫn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お久しぶりです。最近どうですか。体調はもう大丈夫ですか。",
              "vi": "Lâu rồi mới gặp chị. Dạo này chị thế nào? Sức khỏe đã ổn chưa ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "おかげさまで、もう元気です。",
              "vi": "Nhờ anh hỏi thăm, tôi khỏe rồi."
            }
          ]
        }
      ]
    }
  ]
}
