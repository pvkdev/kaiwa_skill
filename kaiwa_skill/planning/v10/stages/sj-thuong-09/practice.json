{
  "stage_uid": "83a1eeaf-d979-5607-b1f3-bee075a726a9",
  "items": [
    {
      "item_id": "sj-thuong-09-b06-1678",
      "practice": [
        {
          "id": "sj-thuong-09-b06-1678-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6aa8916d-8f94-5446-9f50-0c5315912b97",
          "situation_uid": "8f989c60-b317-55c3-a568-2d44697d0e8b",
          "context_vi": "Đến mốc nghe kết quả kiểm lỗi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "さっきの不具合、調子はどう？",
              "vi": "Lỗi lúc nãy giờ thế nào rồi?"
            },
            {
              "speaker_id": "B",
              "ja": "再発はありません。ただ、まだ一時間しか見ていません。",
              "vi": "Chưa tái phát. Nhưng chúng ta mới theo dõi một tiếng."
            }
          ]
        },
        {
          "id": "sj-thuong-09-b06-1678-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6aa8916d-8f94-5446-9f50-0c5315912b97",
          "situation_uid": "84608bc6-ae7c-5416-9d5d-0a86d93b4939",
          "context_vi": "Hỏi chức năng vừa khôi phục.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "注文画面の調子はどう？",
              "vi": "Màn hình đặt hàng hoạt động ra sao rồi?"
            },
            {
              "speaker_id": "B",
              "ja": "入力はできますが、通知はまだ確認中です。",
              "vi": "Nhập được rồi nhưng thông báo vẫn đang kiểm tra."
            }
          ]
        },
        {
          "id": "sj-thuong-09-b06-1678-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7fd50b1e-8afd-5de0-ae60-4ecf6c89839d",
          "situation_uid": "2db88497-1dc6-50cf-ba53-9087234b9ec0",
          "context_vi": "Đến mốc thử cách báo tiến độ mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "新しい連絡方法、調子はどう？",
              "vi": "Cách báo tin mới chạy ra sao?"
            },
            {
              "speaker_id": "B",
              "ja": "漏れは減りましたが、夜間の担当がまだ曖昧です。",
              "vi": "Ít sót hơn, nhưng người trực đêm vẫn chưa rõ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-09-b06-1283",
      "practice": [
        {
          "id": "sj-thuong-09-b06-1283-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6aa8916d-8f94-5446-9f50-0c5315912b97",
          "situation_uid": "86205a0c-8b73-5f6e-af45-ff0c33d13260",
          "context_vi": "Hệ thống hoạt động lại một phần.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "注文は再開しましたが、通知はまだ監視中です。明日午前までしばらく様子を見ましょう。",
              "vi": "Việc đặt hàng đã hoạt động lại, nhưng thông báo vẫn đang được theo dõi. Ta theo dõi thêm tới sáng mai nhé."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。異常があれば連絡します。",
              "vi": "Tôi hiểu. Nếu có bất thường tôi sẽ báo."
            }
          ]
        },
        {
          "id": "sj-thuong-09-b06-1283-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7fd50b1e-8afd-5de0-ae60-4ecf6c89839d",
          "situation_uid": "049c77b0-ff98-5b3f-9877-a1b19db8201c",
          "context_vi": "Thử nhỏ cách báo mới trong một tuần.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一週間だけ新しい方法で知らせて、しばらく様子を見ましょう。連絡漏れを数えてください。",
              "vi": "Ta thử cách báo mới một tuần rồi theo dõi. Em hãy đếm số lần bỏ sót."
            },
            {
              "speaker_id": "B",
              "ja": "はい。金曜に結果を出します。",
              "vi": "Vâng. Thứ Sáu tôi sẽ báo kết quả."
            }
          ]
        },
        {
          "id": "sj-thuong-09-b06-1283-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d14d40ce-ec31-5139-91ec-a9e16eaca721",
          "situation_uid": "0f07e96b-ac8d-59da-8a9d-c4dc620ee19b",
          "context_vi": "Báo cấp cao phần còn mở sau khôi phục.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Giám đốc",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "主要機能は戻りました。通知の遅れだけ、明日までしばらく様子を見ましょう。",
              "vi": "Các chức năng chính đã khôi phục. Riêng việc thông báo chậm, ta theo dõi thêm đến mai."
            },
            {
              "speaker_id": "B",
              "ja": "顧客への更新時刻も決めてください。",
              "vi": "Hãy chốt cả giờ cập nhật cho khách."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-09-b24-1767",
      "practice": [
        {
          "id": "sj-thuong-09-b24-1767-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6aa8916d-8f94-5446-9f50-0c5315912b97",
          "situation_uid": "e182930f-6227-5cfa-b7c1-0e63785c2aed",
          "context_vi": "Chưa thể hứa giờ khôi phục.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "復旧時刻が読めず、気が気じゃないです。",
              "vi": "Tôi cứ lo mãi vì chưa đoán được giờ khôi phục."
            },
            {
              "speaker_id": "B",
              "ja": "気持ちは分かる。まず一時間後に状況を共有しよう。",
              "vi": "Tôi hiểu. Trước hết một tiếng nữa ta cập nhật tình hình."
            }
          ]
        },
        {
          "id": "sj-thuong-09-b24-1767-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d14d40ce-ec31-5139-91ec-a9e16eaca721",
          "situation_uid": "c4931212-014b-5c96-b41c-74834bd2d697",
          "context_vi": "Giám đốc lo trễ hạn chắc chắn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Giám đốc",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もう納期に間に合わないの？",
              "vi": "Vậy là không kịp hạn giao nữa sao?"
            },
            {
              "speaker_id": "B",
              "ja": "まだ未確定です。ただ、確認結果が出るまで気が気じゃありません。午後三時にご報告します。",
              "vi": "Vẫn chưa chắc ạ. Nhưng tới khi có kết quả kiểm tra tôi chưa thể yên tâm. Ba giờ chiều tôi sẽ báo."
            }
          ]
        },
        {
          "id": "sj-thuong-09-b24-1767-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7fd50b1e-8afd-5de0-ae60-4ecf6c89839d",
          "situation_uid": "c6c26b91-18e9-56f4-8993-e4be79bfe061",
          "context_vi": "Thiếu số liệu để kết luận nguyên nhân.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どちらの連絡が先だったか分からず、気が気じゃないんです。",
              "vi": "Tôi không yên tâm vì chưa biết tin nào được báo trước."
            },
            {
              "speaker_id": "B",
              "ja": "記録を確認しよう。推測で責任を決めないで。",
              "vi": "Hãy kiểm tra nhật ký. Đừng quy trách nhiệm theo phỏng đoán."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-09-b24-1788",
      "practice": [
        {
          "id": "sj-thuong-09-b24-1788-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6aa8916d-8f94-5446-9f50-0c5315912b97",
          "situation_uid": "7ecf606f-812c-5348-a174-20ae8ea6b33e",
          "context_vi": "Người kiểm lỗi không có quyền truy cập.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まいりました。ログを見る権限がなくて、原因を絞れません。",
              "vi": "Khó rồi ạ. Tôi không có quyền xem log nên không thu hẹp được nguyên nhân."
            },
            {
              "speaker_id": "B",
              "ja": "管理者に権限を依頼する。安全確認は続けて。",
              "vi": "Tôi sẽ xin quyền từ quản trị viên. Em tiếp tục kiểm tra an toàn."
            }
          ]
        },
        {
          "id": "sj-thuong-09-b24-1788-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6aa8916d-8f94-5446-9f50-0c5315912b97",
          "situation_uid": "eb6f8d41-aae0-5ef1-9d4e-595f7791b34a",
          "context_vi": "Cách tạm thời gây rủi ro khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まいったな。この回避策だと、今度は通知が二重になる。",
              "vi": "Gay thật. Cách tránh lỗi này lại làm gửi thông báo hai lần."
            },
            {
              "speaker_id": "B",
              "ja": "いったん止めよう。別案を確認する。",
              "vi": "Tạm dừng đã. Tôi sẽ kiểm tra phương án khác."
            }
          ]
        },
        {
          "id": "sj-thuong-09-b24-1788-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7fd50b1e-8afd-5de0-ae60-4ecf6c89839d",
          "situation_uid": "cf44672b-1856-554e-8cbc-511ede1792a1",
          "context_vi": "Không thử được vì thiếu người.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まいりました。担当が休みで、試験を始められません。",
              "vi": "Gay rồi ạ. Người phụ trách nghỉ nên chưa bắt đầu thử được."
            },
            {
              "speaker_id": "B",
              "ja": "では、代わりの人か新しい日程を決めよう。",
              "vi": "Vậy hãy chọn người thay hoặc lịch mới."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-09-b20-2302",
      "practice": [
        {
          "id": "sj-thuong-09-b20-2302-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6aa8916d-8f94-5446-9f50-0c5315912b97",
          "situation_uid": "8f12d445-4090-5350-bcc0-e429338c88b1",
          "context_vi": "Phương án vượt quyền của nhóm xử lý.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "複数のシステムに障害が広がり、私たちだけでは手に負えません。専門チームの支援と上長の承認が必要です。",
              "vi": "Sự cố đã lan sang nhiều hệ thống, nhóm tôi không thể tự xử lý nổi. Chúng tôi cần nhóm chuyên môn hỗ trợ và cấp trên phê duyệt."
            },
            {
              "speaker_id": "B",
              "ja": "分かった。影響を整理して持っていく。",
              "vi": "Được. Tôi sẽ tổng hợp tác động để trình."
            }
          ]
        },
        {
          "id": "sj-thuong-09-b20-2302-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6aa8916d-8f94-5446-9f50-0c5315912b97",
          "situation_uid": "94419eaa-64d1-52f0-b306-b1042186282c",
          "context_vi": "Một chức năng chạy lại nhưng toàn hệ thống chưa ổn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "注文は通ったから、もう大丈夫？",
              "vi": "Đặt hàng đã được rồi, vậy ổn hết chưa?"
            },
            {
              "speaker_id": "B",
              "ja": "まだ通知の異常は私たちの手に負えません。専門チームに引き継ぎます。",
              "vi": "Lỗi thông báo vẫn vượt khả năng nhóm tôi. Chúng tôi sẽ chuyển cho nhóm chuyên môn."
            }
          ]
        },
        {
          "id": "sj-thuong-09-b20-2302-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d14d40ce-ec31-5139-91ec-a9e16eaca721",
          "situation_uid": "bcfda9f4-34cb-5ad2-8599-6a91a93fb098",
          "context_vi": "Báo lên giám đốc hai phương án xử lý.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Giám đốc",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この負荷は現体制では手に負えません。外部支援を頼むか、範囲を減らすか、ご判断ください。",
              "vi": "Khối lượng này vượt khả năng đội hiện tại. Xin chị quyết định dùng hỗ trợ ngoài hay giảm phạm vi."
            },
            {
              "speaker_id": "B",
              "ja": "費用と影響を並べてください。",
              "vi": "Hãy đặt chi phí và tác động cạnh nhau."
            }
          ]
        }
      ]
    }
  ]
}
