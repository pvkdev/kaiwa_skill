{
  "stage_uid": "d8d0ca9e-b729-556a-99b6-0e57185ca359",
  "items": [
    {
      "item_id": "sj-thuong-06-b12-674",
      "practice": [
        {
          "id": "sj-thuong-06-b12-674-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "cba953ce-d3d0-5e71-acb8-419cd0e708a1",
          "situation_uid": "fddfd7ed-fbfa-5284-b9d9-4d3ad9479153",
          "context_vi": "Nghe phản biện rằng nhóm không đủ người.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この人数では来月の開始は難しいです。",
              "vi": "Với số người này, khó bắt đầu vào tháng sau."
            },
            {
              "speaker_id": "B",
              "ja": "確かにその懸念はあります。まず対象を一部署に絞る案はどうでしょう。",
              "vi": "Đúng là có mối lo đó. Nếu trước hết giới hạn trong một bộ phận thì sao?"
            }
          ]
        },
        {
          "id": "sj-thuong-06-b12-674-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fbc7ece1-f87d-5ae1-9b20-fda44143321b",
          "situation_uid": "d110bcf2-83cd-529e-bf61-52b196dfd0af",
          "context_vi": "Hai bên ưu tiên khác nhau trong cùng cuộc họp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "納期を守ることが最優先です。",
              "vi": "Giữ hạn giao là ưu tiên hàng đầu."
            },
            {
              "speaker_id": "B",
              "ja": "確かに大切です。ただ、確認を省くと品質に影響します。",
              "vi": "Đúng là rất quan trọng. Nhưng bỏ khâu kiểm tra thì sẽ ảnh hưởng chất lượng."
            }
          ]
        },
        {
          "id": "sj-thuong-06-b12-674-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "110d4300-fdc1-55c4-9ded-4d667db6ed56",
          "situation_uid": "6c8960c2-a883-5118-a98c-e7e0bf30e5cc",
          "context_vi": "Người nghe đưa giả định khác với dữ liệu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "利用者はもう減っているのでは？",
              "vi": "Số người dùng chẳng phải đã giảm rồi sao?"
            },
            {
              "speaker_id": "B",
              "ja": "確かに先月は減りました。ただ、今月の数字はまだ確定していません。",
              "vi": "Đúng là tháng trước có giảm. Nhưng số liệu tháng này vẫn chưa chốt."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-06-b12-1019",
      "practice": [
        {
          "id": "sj-thuong-06-b12-1019-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "cba953ce-d3d0-5e71-acb8-419cd0e708a1",
          "situation_uid": "90fb7942-673a-5c6f-ab1a-56a1c98bd6a4",
          "context_vi": "Chủ trì chỉ muốn chọn hướng chứ chưa duyệt chi phí.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người chủ trì",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は方向性を決めましょう。",
              "vi": "Hôm nay ta chọn hướng đi."
            },
            {
              "speaker_id": "B",
              "ja": "方向性を決めるといっても、費用の承認は別ですね。",
              "vi": "Dù chọn hướng đi, việc duyệt chi phí vẫn là chuyện riêng nhỉ."
            }
          ]
        },
        {
          "id": "sj-thuong-06-b12-1019-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4b79024e-04b0-5d26-bf9d-51a4fe964edf",
          "situation_uid": "175b1c61-91ba-5acf-a394-2e59ebd71397",
          "context_vi": "Chủ trì xác định phạm vi quyết định ngắn hạn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người chủ trì",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まず今週の対応を決めます。",
              "vi": "Trước hết ta quyết cách ứng phó tuần này."
            },
            {
              "speaker_id": "B",
              "ja": "今週といっても、週末の顧客対応は含めますか。",
              "vi": "Dù nói tuần này, có bao gồm việc hỗ trợ khách cuối tuần không?"
            }
          ]
        },
        {
          "id": "sj-thuong-06-b12-1019-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "110d4300-fdc1-55c4-9ded-4d667db6ed56",
          "situation_uid": "ed3bddbc-b119-5f02-8d79-9f586fa70eb1",
          "context_vi": "Phương án nhanh có rủi ro vận hành.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "早い案を提案します。といっても、運用チームの確認が取れた場合に限ります。",
              "vi": "Tôi đề xuất phương án nhanh. Dù vậy, chỉ thực hiện nếu nhóm vận hành xác nhận được."
            },
            {
              "speaker_id": "B",
              "ja": "その条件を明示してください。",
              "vi": "Hãy ghi rõ điều kiện đó."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-06-b12-714",
      "practice": [
        {
          "id": "sj-thuong-06-b12-714-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "cba953ce-d3d0-5e71-acb8-419cd0e708a1",
          "situation_uid": "b608cff3-2872-546b-8bf2-a8c71a6eaef9",
          "context_vi": "Xác nhận một số liệu đã được kiểm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この数字は先週の確定値ですね。",
              "vi": "Số này là số đã chốt tuần trước nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "おっしゃるとおりです。ただ、今週分はまだ速報値です。",
              "vi": "Đúng như chị nói ạ. Nhưng số tuần này vẫn chỉ là tạm tính."
            }
          ]
        },
        {
          "id": "sj-thuong-06-b12-714-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fbc7ece1-f87d-5ae1-9b20-fda44143321b",
          "situation_uid": "58615c89-cd1e-5102-9007-c8f6e6444f90",
          "context_vi": "Cấp trên chỉ ra rủi ro không gán lỗi cá nhân.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "確認の手順が抜けていたのが問題ですね。",
              "vi": "Vấn đề là quy trình kiểm tra đã bị bỏ qua nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "おっしゃるとおりです。担当者を責める前に手順を直しましょう。",
              "vi": "Đúng như chị nói ạ. Ta sửa quy trình trước khi trách người phụ trách."
            }
          ]
        },
        {
          "id": "sj-thuong-06-b12-714-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "110d4300-fdc1-55c4-9ded-4d667db6ed56",
          "situation_uid": "f634b3cc-9e76-5593-8c21-1dee4170555c",
          "context_vi": "Người duyệt giới hạn phạm vi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一部署での試験までなら承認します。",
              "vi": "Tôi duyệt thử trong một bộ phận thôi."
            },
            {
              "speaker_id": "B",
              "ja": "おっしゃるとおりです。全社展開は試験結果を見てからですね。",
              "vi": "Vâng, đúng như chị nói. Triển khai toàn công ty sẽ để sau khi xem kết quả thử nghiệm ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-06-b11-2954",
      "practice": [
        {
          "id": "sj-thuong-06-b11-2954-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "cba953ce-d3d0-5e71-acb8-419cd0e708a1",
          "situation_uid": "2996b941-9541-5bb3-a115-6a6850c0f3c8",
          "context_vi": "Thiếu ý kiến của bộ phận chịu việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "運用チームはまだこの案を見ていないんじゃない？",
              "vi": "Nhóm vận hành chưa xem phương án này phải không?"
            },
            {
              "speaker_id": "B",
              "ja": "そうだね。決める前に聞こう。",
              "vi": "Đúng nhỉ. Ta hỏi họ trước khi quyết."
            }
          ]
        },
        {
          "id": "sj-thuong-06-b11-2954-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fbc7ece1-f87d-5ae1-9b20-fda44143321b",
          "situation_uid": "333b3b16-5e96-56c6-a5b8-c0dbc623fc67",
          "context_vi": "Hai con số có thể khác mốc thống kê.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その数字、集計した期間が違うんじゃない？",
              "vi": "Số đó có phải được tính cho kỳ khác không?"
            },
            {
              "speaker_id": "B",
              "ja": "確認するよ。私のは四月分だ。",
              "vi": "Để tôi kiểm tra. Của tôi là số tháng Tư."
            }
          ]
        },
        {
          "id": "sj-thuong-06-b11-2954-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4b79024e-04b0-5d26-bf9d-51a4fe964edf",
          "situation_uid": "954ab49f-902a-5ff0-927f-e6d993e18fc0",
          "context_vi": "Nghe báo chi phí nhưng chưa thấy duyệt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người chủ trì",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "費用の件はまだ承認されていないんじゃないですか。",
              "vi": "Khoản chi đó hình như vẫn chưa được duyệt phải không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "そのとおり。議事録にも未決と書こう。",
              "vi": "Đúng. Hãy ghi trong biên bản là chưa quyết."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-06-b06-1709",
      "practice": [
        {
          "id": "sj-thuong-06-b06-1709-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "cba953ce-d3d0-5e71-acb8-419cd0e708a1",
          "situation_uid": "3ecd9b4d-d484-555a-a4a7-2af525f8e316",
          "context_vi": "Cùng muốn giảm phạm vi thử.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まず一部署だけで試すべきだと思います。",
              "vi": "Tôi nghĩ trước hết chỉ nên thử ở một bộ phận."
            },
            {
              "speaker_id": "B",
              "ja": "同感です。利用者の反応を見てから広げましょう。",
              "vi": "Tôi đồng ý. Ta xem phản ứng của người dùng rồi mở rộng."
            }
          ]
        },
        {
          "id": "sj-thuong-06-b06-1709-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "fbc7ece1-f87d-5ae1-9b20-fda44143321b",
          "situation_uid": "4f652861-b7d5-52f3-af61-0f0a08d4cd0d",
          "context_vi": "Tóm tắt phần hai bên đã thống nhất.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "品質基準は下げず、対象を絞る点では同感です。納期はまだ別に話したいです。",
              "vi": "Tôi đồng ý giữ chuẩn chất lượng và thu hẹp phạm vi. Còn hạn giao, tôi muốn bàn riêng tiếp."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。",
              "vi": "Tôi hiểu."
            }
          ]
        },
        {
          "id": "sj-thuong-06-b06-1709-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4b79024e-04b0-5d26-bf9d-51a4fe964edf",
          "situation_uid": "def6845d-0fc8-52ec-bfe8-4c88928401e8",
          "context_vi": "Chủ trì tóm tắt hai ý kiến trái chiều.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người chủ trì",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "現場には準備期間が必要です。",
              "vi": "Bộ phận hiện trường cần thời gian chuẩn bị."
            },
            {
              "speaker_id": "B",
              "ja": "同感です。その点を踏まえて、営業側の期限も確認しましょう。",
              "vi": "Tôi đồng ý. Dựa trên điểm đó, ta cũng xác nhận hạn phía kinh doanh nhé."
            }
          ]
        }
      ]
    }
  ]
}
