{
  "stage_uid": "441dfa17-f82f-5ccd-a93a-c420a83589dd",
  "items": [
    {
      "item_id": "sj-trung-20-b12-40",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Brief ghi bản demo nhưng có thêm dữ liệu thật.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "試作品の依頼です。しかも、実際の顧客データが必要と書いてあります。",
              "vi": "Yêu cầu là bản thử. Hơn nữa, tài liệu còn ghi cần dữ liệu khách thật."
            },
            {
              "speaker_id": "B",
              "ja": "その点は確認しましょう。",
              "vi": "Điểm đó cần kiểm tra."
            }
          ],
          "id": "sj-trung-20-b12-40-ex01",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "8e6ee35a-8db0-5aac-afc2-fd8033a589b2"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thời gian ngắn lại có hai đầu ra.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "期限は明日です。しかも、資料と画面の両方が必要です。",
              "vi": "Hạn là ngày mai. Hơn nữa, cần cả tài liệu lẫn màn hình."
            },
            {
              "speaker_id": "B",
              "ja": "では、優先順位を決めます。",
              "vi": "Vậy tôi sẽ chọn thứ tự ưu tiên."
            }
          ],
          "id": "sj-trung-20-b12-40-ex02",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "ee326e35-6ff9-56c2-bbc1-182c1c6d36d0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Yêu cầu mới ảnh hưởng việc đã làm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "項目が増えました。しかも、最初の表も作り直す必要があります。",
              "vi": "Có thêm hạng mục. Hơn nữa, bảng ban đầu cũng phải làm lại."
            },
            {
              "speaker_id": "B",
              "ja": "影響範囲を確認しましょう。",
              "vi": "Ta kiểm tra phạm vi ảnh hưởng."
            }
          ],
          "id": "sj-trung-20-b12-40-ex03",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "13531074-787c-5a0e-a580-2cf7bf2dba4d"
        }
      ]
    },
    {
      "item_id": "sj-trung-20-b11-30",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chỉ đủ thời gian làm một trong hai đầu ra.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日中なら、どちらか一つしか完成できません。",
              "vi": "Nếu hạn trong hôm nay, tôi chỉ hoàn thành được một trong hai."
            },
            {
              "speaker_id": "B",
              "ja": "では、資料を先に。",
              "vi": "Vậy làm tài liệu trước."
            }
          ],
          "id": "sj-trung-20-b11-30-ex01",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "ee326e35-6ff9-56c2-bbc1-182c1c6d36d0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Không được giảm phạm vi, cần thêm người.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Leader",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "範囲は減らせません。",
              "vi": "Không thể giảm phạm vi."
            },
            {
              "speaker_id": "B",
              "ja": "そうすると、応援を頼むしかありませんね。",
              "vi": "Vậy thì chỉ còn cách nhờ thêm người hỗ trợ."
            }
          ],
          "id": "sj-trung-20-b11-30-ex02",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "2aff7cd8-9e8d-5deb-a91a-6a1a2ba07590"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chỉ còn cách hỏi lại nghĩa của xong.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "「完成」の意味が曖昧なので、依頼者に確認するしかないですね。",
              "vi": "Từ “xong” còn mơ hồ nên chỉ còn cách hỏi lại người giao việc."
            },
            {
              "speaker_id": "B",
              "ja": "そうですね。お願いします。",
              "vi": "Đúng, nhờ chị hỏi."
            }
          ],
          "id": "sj-trung-20-b11-30-ex03",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "b8ec5a9e-b783-5907-900b-7746ad0095bd"
        }
      ]
    },
    {
      "item_id": "sj-trung-20-b12-34",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Tiêu chí đã rõ một phần nhưng vẫn còn điều kiện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "必須項目は分かりました。でも、色の指定はありますか。",
              "vi": "Tôi đã hiểu các mục bắt buộc. Nhưng có yêu cầu về màu không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "色は任せます。",
              "vi": "Màu thì anh tự chọn."
            }
          ],
          "id": "sj-trung-20-b12-34-ex01",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "7a19ca81-4c39-5abe-8b79-2044bf947e62"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đã chọn bản cốt lõi, hỏi phần sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Leader",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今回は基本機能だけ作ってください。",
              "vi": "Lần này chỉ làm chức năng cơ bản."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。でも、追加分の予定はいつ決めますか。",
              "vi": "Tôi hiểu. Nhưng khi nào quyết lịch phần bổ sung ạ?"
            }
          ],
          "id": "sj-trung-20-b12-34-ex02",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "302799d1-3835-5cb3-b3cc-f699376eb7b4"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Buổi thử tốt nhưng vẫn còn tiêu chí chưa đạt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お客様の反応はよかったです。でも、操作の速さはまだ課題です。",
              "vi": "Khách phản ứng tốt. Nhưng tốc độ thao tác vẫn còn là vấn đề."
            },
            {
              "speaker_id": "B",
              "ja": "そこを次に直しましょう。",
              "vi": "Lần sau sửa phần đó."
            }
          ],
          "id": "sj-trung-20-b12-34-ex03",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "4f5e5802-7ad7-54d7-aefc-e801232e9dc6"
        }
      ]
    },
    {
      "item_id": "sj-trung-20-b12-46",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người giao nghĩ đã làm bản triển khai.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Leader",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もう本番用の画面ができたんですね。",
              "vi": "Vậy màn hình dùng chính thức đã xong rồi nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "そうじゃなくて、これは見せるための試作品です。",
              "vi": "Không phải ạ, đây là bản thử để trình bày."
            }
          ],
          "id": "sj-trung-20-b12-46-ex01",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "8e6ee35a-8db0-5aac-afc2-fd8033a589b2"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người giao hiểu xong là đã được duyệt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Leader",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "「完成」ということは、もう承認済みですね。",
              "vi": "Nói “xong” nghĩa là đã được duyệt rồi nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "そうじゃなくて、確認用の版ができたという意味です。",
              "vi": "Không phải, ý tôi là đã có bản để kiểm tra ạ."
            }
          ],
          "id": "sj-trung-20-b12-46-ex02",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "b8ec5a9e-b783-5907-900b-7746ad0095bd"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cấp trên tưởng muốn đổi toàn bộ thứ tự.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Leader",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "全部の順番を変えたいんですか。",
              "vi": "Anh muốn đổi toàn bộ thứ tự à?"
            },
            {
              "speaker_id": "B",
              "ja": "そうじゃなくて、最初の説明だけ前に出したいんです。",
              "vi": "Không phải, tôi chỉ muốn đưa phần giải thích đầu tiên lên trước."
            }
          ],
          "id": "sj-trung-20-b12-46-ex03",
          "topic_uid": "306f7ba6-c3ff-56e1-87d8-2edc0fc29014",
          "situation_uid": "3439680b-edac-50eb-a2f6-780847c58134"
        }
      ]
    }
  ]
}
