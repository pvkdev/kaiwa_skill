{
  "stage_uid": "a16e8f7f-619e-5cd1-a2ca-d111014d5db9",
  "items": [
    {
      "item_id": "sj-so-18-b11-67",
      "practice": [
        {
          "id": "sj-so-18-b11-67-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1a0bbf5d-2d55-53a9-9cef-ec4c4333f8c8",
          "situation_uid": "fc44f195-473e-5cb0-ac9f-bee8a4f996b1",
          "context_vi": "Lớp đầu đã đủ, học viên hỏi phương án khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người học",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "火曜日のクラスは満員です。",
              "vi": "Lớp thứ Ba đã đủ chỗ ạ."
            },
            {
              "speaker_id": "B",
              "ja": "では、木曜日のクラスはどうですか。",
              "vi": "Vậy lớp thứ Năm thì sao ạ?"
            },
            {
              "speaker_id": "A",
              "ja": "まだ空きがあります。",
              "vi": "Lớp đó vẫn còn chỗ."
            }
          ]
        },
        {
          "id": "sj-so-18-b11-67-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1a0bbf5d-2d55-53a9-9cef-ec4c4333f8c8",
          "situation_uid": "69b70966-4f4f-5d5e-b271-0e39cf84708c",
          "context_vi": "Người học muốn đổi lớp vì ca làm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người học",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "夜は働いています。午前のクラスはどうですか。",
              "vi": "Buổi tối tôi phải làm. Lớp buổi sáng thì sao ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "月曜日の午前なら空いています。",
              "vi": "Sáng thứ Hai vẫn còn chỗ ạ."
            }
          ]
        },
        {
          "id": "sj-so-18-b11-67-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1a0bbf5d-2d55-53a9-9cef-ec4c4333f8c8",
          "situation_uid": "054da203-8a7f-524f-9fec-948e969bd657",
          "context_vi": "Bạn cùng lớp gợi đổi vai để người kia dễ luyện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn học",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn học",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この役、難しいね。先に店員をやるのはどう？",
              "vi": "Vai này khó nhỉ. Cậu thử đóng nhân viên trước thì sao?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、それならできそう。",
              "vi": "Ừ, thế thì chắc tớ làm được."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-18-b06-166",
      "practice": [
        {
          "id": "sj-so-18-b06-166-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1a0bbf5d-2d55-53a9-9cef-ec4c4333f8c8",
          "situation_uid": "fca67705-2edc-5f0f-a192-0f84316c87ae",
          "context_vi": "Giáo viên cho học viên xem nội dung thật của cấp sơ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Giáo viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người học",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初級では、道を聞いて相手の答えを確かめる練習もします。",
              "vi": "Ở lớp sơ cấp còn luyện hỏi đường rồi xác nhận lời người kia đáp."
            },
            {
              "speaker_id": "B",
              "ja": "それは勉強になります。実際に使えそうです。",
              "vi": "Bài đó bổ ích quá ạ. Chắc tôi áp dụng được ngoài đời."
            }
          ]
        },
        {
          "id": "sj-so-18-b06-166-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1a0bbf5d-2d55-53a9-9cef-ec4c4333f8c8",
          "situation_uid": "66f3979d-46b3-5109-b787-31804dd2fe60",
          "context_vi": "Giáo viên giải thích nghĩa từ mới bằng ví dụ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Giáo viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người học",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "「予約」は、行く前に席を決めてもらうことです。",
              "vi": "“Đặt chỗ” là nhờ người ta giữ chỗ trước khi đến."
            },
            {
              "speaker_id": "B",
              "ja": "ああ、わかりました。勉強になります。",
              "vi": "À, em hiểu rồi. Bổ ích quá ạ."
            }
          ]
        },
        {
          "id": "sj-so-18-b06-166-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1a0bbf5d-2d55-53a9-9cef-ec4c4333f8c8",
          "situation_uid": "3e62fb3b-8dd0-5e08-9035-1bcb17d2284f",
          "context_vi": "Sau buổi học, bạn học nói đã hiểu cách xác nhận việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn học",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn học",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日の練習、どうだった？",
              "vi": "Buổi luyện hôm nay thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "相手の言葉を言い直す練習、勉強になったよ。",
              "vi": "Bài luyện nhắc lại lời người kia bổ ích lắm."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-18-b07-142",
      "practice": [
        {
          "id": "sj-so-18-b07-142-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1a0bbf5d-2d55-53a9-9cef-ec4c4333f8c8",
          "situation_uid": "fca67705-2edc-5f0f-a192-0f84316c87ae",
          "context_vi": "Người học hiểu vì sao cần học cấp đầu tiên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người học",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初級は、短い返事から練習します。",
              "vi": "Lớp sơ cấp bắt đầu luyện từ câu đáp ngắn ạ."
            },
            {
              "speaker_id": "B",
              "ja": "なるほど。では、そのクラスを見学したいです。",
              "vi": "Ra vậy. Thế tôi muốn đến xem lớp đó ạ."
            }
          ]
        },
        {
          "id": "sj-so-18-b07-142-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1a0bbf5d-2d55-53a9-9cef-ec4c4333f8c8",
          "situation_uid": "cf8f300a-af8f-5ecc-9157-9f6ef0e53b2f",
          "context_vi": "Giáo viên giải thích lớp chuyển sang tầng khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Giáo viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người học",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は三階の部屋を使います。二階は工事中です。",
              "vi": "Hôm nay dùng phòng tầng ba. Tầng hai đang sửa chữa."
            },
            {
              "speaker_id": "B",
              "ja": "なるほど。三階に行きます。",
              "vi": "Ra vậy. Em sẽ lên tầng ba."
            }
          ]
        },
        {
          "id": "sj-so-18-b07-142-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e94dbc1d-7f5b-5657-920c-d08f29a2180f",
          "situation_uid": "584b9005-13d8-5052-9cea-a2e8280d05b5",
          "context_vi": "Bạn giải thích nguyên liệu hết nên đổi món cho bữa tối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "豆腐が売り切れだったから、卵を買ったよ。",
              "vi": "Đậu phụ hết hàng nên tớ mua trứng."
            },
            {
              "speaker_id": "B",
              "ja": "なるほど。じゃ、今日は卵料理にしよう。",
              "vi": "Ra vậy. Thế hôm nay mình làm món trứng nhé."
            }
          ]
        }
      ]
    }
  ]
}
