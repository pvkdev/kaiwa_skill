{
  "stage_uid": "8b4739e0-0ba7-52ee-b8c3-81fc9241f2b1",
  "items": [
    {
      "item_id": "sj-trung-30-b18-203",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo còn bàn ở khu yên tĩnh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "奥に静かなお席がございます。",
              "vi": "Phía trong còn bàn yên tĩnh ạ."
            },
            {
              "speaker_id": "B",
              "ja": "そちらでお願いします。",
              "vi": "Cho tôi ngồi chỗ đó."
            }
          ],
          "id": "sj-trung-30-b18-203-ex01",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "8a8be733-7786-5169-a031-61cf48f98d37"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Món khách muốn hết, báo món khác còn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その料理は本日売り切れですが、こちらの魚料理がございます。",
              "vi": "Món đó hôm nay hết rồi, nhưng còn món cá này ạ."
            },
            {
              "speaker_id": "B",
              "ja": "味を教えてください。",
              "vi": "Anh cho tôi biết vị món ấy nhé."
            }
          ],
          "id": "sj-trung-30-b18-203-ex02",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "ec1cd6c2-a46d-50a4-8d32-8a790535a4ab"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách để quên đồ, nhân viên báo nơi nhận lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お預かりしたお忘れ物が受付にございます。",
              "vi": "Đồ quý khách để quên hiện ở quầy lễ tân ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。取りに行きます。",
              "vi": "Cảm ơn chị. Tôi sẽ đến lấy."
            }
          ],
          "id": "sj-trung-30-b18-203-ex03",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "e2c40709-ff65-5717-934a-97b78f2c4487"
        }
      ]
    },
    {
      "item_id": "sj-trung-30-b07-120",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Gợi món thay khi món khách chọn đã hết.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "辛いものがお好きなら、こちらのカレーがおすすめです。",
              "vi": "Nếu quý khách thích ăn cay, tôi gợi ý món cà ri này."
            },
            {
              "speaker_id": "B",
              "ja": "では、それにします。",
              "vi": "Vậy tôi lấy món đó."
            }
          ],
          "id": "sj-trung-30-b07-120-ex01",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "ec1cd6c2-a46d-50a4-8d32-8a790535a4ab"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách muốn món ít cay.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あまり辛くない料理はありますか。",
              "vi": "Có món nào không cay lắm không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "こちらの煮魚がおすすめです。",
              "vi": "Tôi gợi ý món cá kho này ạ."
            }
          ],
          "id": "sj-trung-30-b07-120-ex02",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "0c231f11-5e25-5b10-aeec-f6ef18ba1d7c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách chưa chọn được giữa hai món.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "軽めでしたら、うどんがおすすめです。",
              "vi": "Nếu muốn ăn nhẹ, tôi gợi ý mì udon ạ."
            },
            {
              "speaker_id": "B",
              "ja": "少し考えます。",
              "vi": "Để tôi nghĩ chút."
            }
          ],
          "id": "sj-trung-30-b07-120-ex03",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "0e4bde6f-e2a7-5069-8d63-9c5529231088"
        }
      ]
    },
    {
      "item_id": "sj-trung-30-b07-71",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách hỏi hai món nào ít cay hơn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どちらが辛くないですか。",
              "vi": "Món nào ít cay hơn ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "どちらかと言うと、こちらのうどんのほうが辛くありません。",
              "vi": "Nếu phải chọn thì món udon này ít cay hơn ạ."
            }
          ],
          "id": "sj-trung-30-b07-71-ex01",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "0c231f11-5e25-5b10-aeec-f6ef18ba1d7c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai món thay đều còn, khách hỏi món nào nhẹ hơn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "魚とカレーなら、どちらが軽いですか。",
              "vi": "Cá và cà ri thì món nào nhẹ bụng hơn ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "どちらかと言うと、魚料理ですね。",
              "vi": "Nếu phải nói thì món cá ạ."
            }
          ],
          "id": "sj-trung-30-b07-71-ex02",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "ec1cd6c2-a46d-50a4-8d32-8a790535a4ab"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách hỏi món vừa ra có đúng yêu cầu không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "これは辛くないほうですか。",
              "vi": "Đây là phần ít cay hơn phải không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。どちらかと言うと、こちらは甘めの味です。",
              "vi": "Vâng. Nếu phải nói thì món này thiên về vị ngọt ạ."
            }
          ],
          "id": "sj-trung-30-b07-71-ex03",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "630bd8a7-629e-5c07-acd4-28298fe433f1"
        }
      ]
    },
    {
      "item_id": "sj-trung-30-b20-25",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách nhận món đúng kèm dụng cụ đã nhờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "小さいスプーンまで用意してくれたんですね。かゆいところに手が届くサービスですね。",
              "vi": "Anh chuẩn bị cả thìa nhỏ nữa à. Dịch vụ chu đáo đến từng chi tiết thật."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。",
              "vi": "Cảm ơn quý khách."
            }
          ],
          "id": "sj-trung-30-b20-25-ex01",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "2e005891-5198-5e73-9b47-14e7d26745b5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên đã hỏi trước thành phần cần tránh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "聞く前に苦手な食材を確認してくれて、かゆいところに手が届きますね。",
              "vi": "Chị hỏi trước cả nguyên liệu tôi cần tránh, thật chu đáo."
            },
            {
              "speaker_id": "B",
              "ja": "安心して召し上がっていただきたいので。",
              "vi": "Chúng tôi muốn quý khách yên tâm dùng bữa ạ."
            }
          ],
          "id": "sj-trung-30-b20-25-ex02",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "0c231f11-5e25-5b10-aeec-f6ef18ba1d7c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi rời quán, khách kể với bạn về cách hỗ trợ lấy lại đồ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "忘れ物の受け取り方まで教えてくれたよ。かゆいところに手が届く店だね。",
              "vi": "Họ còn chỉ cả cách nhận lại đồ tớ quên. Quán chu đáo đến từng chi tiết nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "それは助かるね。",
              "vi": "Thế thì tốt quá."
            }
          ],
          "id": "sj-trung-30-b20-25-ex03",
          "topic_uid": "4822bf91-d75a-5732-9a4b-a4ae131f8d7a",
          "situation_uid": "e2c40709-ff65-5717-934a-97b78f2c4487"
        }
      ]
    }
  ]
}
