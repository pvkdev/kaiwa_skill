{
  "stage_uid": "0f76997e-6e41-5d9c-ae7d-1552757496b8",
  "items": [
    {
      "item_id": "sj-thuong-04-b20-278",
      "practice": [
        {
          "id": "sj-thuong-04-b20-278-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9349c2cb-99d6-5116-aede-edd9fdbcfbe4",
          "situation_uid": "0ef00f2a-35ee-5179-a08e-512853a764ca",
          "context_vi": "Bàn nội bộ trước buổi thương lượng giá.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先方は何を一番重視していると思う？",
              "vi": "Em nghĩ bên kia coi trọng điều gì nhất?"
            },
            {
              "speaker_id": "B",
              "ja": "先手を打って、価格より納期の優先順位を聞いてみましょう。",
              "vi": "Ta hãy chủ động hỏi trước xem họ ưu tiên giá hay tiến độ."
            }
          ]
        },
        {
          "id": "sj-thuong-04-b20-278-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6347a04c-648a-5a61-b940-e2c046221d04",
          "situation_uid": "726fbf68-32b6-5042-a8c3-0ede2d5acafb",
          "context_vi": "Chuẩn bị đề nghị giá thấp hơn theo đơn định kỳ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "相手から新しい単価が出る前に、先手を打って定期発注の条件を示しませんか。",
              "vi": "Trước khi họ đưa đơn giá mới, ta chủ động nêu điều kiện đặt hàng định kỳ nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "数量の見込みを先に確認しよう。",
              "vi": "Hãy xác nhận dự kiến số lượng trước."
            }
          ]
        },
        {
          "id": "sj-thuong-04-b20-278-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bfce5e6f-3e03-5d55-bb27-9244786e943a",
          "situation_uid": "89736afd-547d-5721-98bc-d68c70cb5163",
          "context_vi": "Cần nêu hai phương án trước khi khách yêu cầu cả hai.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日の打ち合わせ、どう進める？",
              "vi": "Cuộc họp hôm nay em định tiến hành thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "先手を打って、納期を守る案と範囲を守る案を最初に並べます。",
              "vi": "Em sẽ chủ động đưa ra ngay phương án giữ hạn và phương án giữ phạm vi."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-04-b20-3408",
      "practice": [
        {
          "id": "sj-thuong-04-b20-3408-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9349c2cb-99d6-5116-aede-edd9fdbcfbe4",
          "situation_uid": "7a9b27fd-8da3-5b95-8775-834f4ea8cc41",
          "context_vi": "Cấp trên chưa chấp thuận điều khoản mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đối tác",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その条件は上司に通りそうですか。",
              "vi": "Điều kiện đó có được cấp trên chị chấp thuận không?"
            },
            {
              "speaker_id": "B",
              "ja": "まだ首を縦に振ってくれません。保証期間が懸念点です。",
              "vi": "Cấp trên tôi vẫn chưa đồng ý. Điểm vướng là thời hạn bảo hành."
            }
          ]
        },
        {
          "id": "sj-thuong-04-b20-3408-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6347a04c-648a-5a61-b940-e2c046221d04",
          "situation_uid": "5e1d05f7-5f2a-5ce1-94ba-bfc388156aff",
          "context_vi": "Nói với đồng nghiệp vì sao mức hiện tại chưa qua duyệt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この単価で決められる？",
              "vi": "Có thể chốt đơn giá này không?"
            },
            {
              "speaker_id": "B",
              "ja": "部長がまだ首を縦に振ってくれないの。最低数量を下げる必要があるって。",
              "vi": "Trưởng phòng vẫn chưa đồng ý. Bà ấy nói phải giảm lượng đặt tối thiểu."
            }
          ]
        },
        {
          "id": "sj-thuong-04-b20-3408-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "44afa4c2-5012-52c0-8e9d-26dfc5eb75b1",
          "situation_uid": "45fa18fa-27cd-5e54-b34a-95935e2f011e",
          "context_vi": "Người duyệt bên khách đang vắng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご担当者様のお返事はいかがでしょうか。",
              "vi": "Người phụ trách bên anh đã phản hồi chưa ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "まだ首を縦に振っていません。二回目の納期を気にしています。",
              "vi": "Ông ấy vẫn chưa đồng ý. Ông ấy lo thời hạn của đợt giao thứ hai."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-04-b12-934",
      "practice": [
        {
          "id": "sj-thuong-04-b12-934-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9349c2cb-99d6-5116-aede-edd9fdbcfbe4",
          "situation_uid": "9bcc5c84-3647-53d4-a731-d535ecde1ee4",
          "context_vi": "Khách hứa cung cấp dữ liệu đúng ngày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đối tác",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "入力データは金曜までに渡せます。",
              "vi": "Chúng tôi có thể bàn giao dữ liệu đầu vào trước thứ Sáu."
            },
            {
              "speaker_id": "B",
              "ja": "とすると、当初の納期を維持できるか、こちらで確認すればよいですね。",
              "vi": "Vậy tôi cần kiểm tra bên mình có giữ được hạn giao ban đầu hay không nhỉ."
            }
          ]
        },
        {
          "id": "sj-thuong-04-b12-934-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6347a04c-648a-5a61-b940-e2c046221d04",
          "situation_uid": "66e88b2a-6d5e-5ab0-8c49-41035045ce67",
          "context_vi": "Nhà cung cấp chỉ giảm giá khi tăng số lượng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhà cung cấp",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "最低発注数を倍にすれば、単価は下げられます。",
              "vi": "Nếu tăng lượng đặt tối thiểu gấp đôi thì chúng tôi có thể hạ đơn giá."
            },
            {
              "speaker_id": "B",
              "ja": "とすると、少量の追加発注には今の単価が適用されますか。",
              "vi": "Vậy đơn đặt bổ sung số lượng nhỏ vẫn áp dụng đơn giá hiện tại phải không ạ?"
            }
          ]
        },
        {
          "id": "sj-thuong-04-b12-934-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bfce5e6f-3e03-5d55-bb27-9244786e943a",
          "situation_uid": "eb9954e1-e72b-574e-8868-178fb19151e1",
          "context_vi": "Kỹ thuật nói phải lùi hạn mới làm đủ phạm vi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "全部入れるなら、完成は二週間後になります。",
              "vi": "Nếu làm đủ mọi phần, ngày hoàn thành sẽ lùi hai tuần."
            },
            {
              "speaker_id": "B",
              "ja": "とすると、元の期限を守るには範囲を減らす必要がありますね。",
              "vi": "Vậy để giữ hạn cũ, ta cần giảm phạm vi nhỉ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-04-b06-1381",
      "practice": [
        {
          "id": "sj-thuong-04-b06-1381-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9349c2cb-99d6-5116-aede-edd9fdbcfbe4",
          "situation_uid": "a1f96678-ec39-59ed-a4b4-a83f7bca1d63",
          "context_vi": "Bên kia ngại rút ngắn thời gian nghiệm thu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đối tác",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "確認期間を三日にはできません。",
              "vi": "Chúng tôi không thể rút thời gian kiểm tra xuống ba ngày."
            },
            {
              "speaker_id": "B",
              "ja": "そこをなんとかお願いします。展示会の前に納品したいんです。難しければ先行分だけ確認いただけませんか。",
              "vi": "Xin anh cố thu xếp giúp; chúng tôi muốn giao trước hội chợ. Nếu khó, anh có thể kiểm tra trước phần giao đầu không ạ?"
            }
          ]
        },
        {
          "id": "sj-thuong-04-b06-1381-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6347a04c-648a-5a61-b940-e2c046221d04",
          "situation_uid": "3c53c7c9-4727-5f0a-b2d9-e6e725d14cb7",
          "context_vi": "Nhà cung cấp không giảm được vì giá nguyên liệu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhà cung cấp",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "原料費が上がっていて、値引きは難しいです。",
              "vi": "Giá nguyên liệu tăng nên khó giảm giá."
            },
            {
              "speaker_id": "B",
              "ja": "そこをなんとかお願いします。無理なら、配送をまとめて費用を抑えられませんか。",
              "vi": "Xin chị cố xem lại giúp. Nếu không được, liệu gộp các chuyến giao để giảm phí được không ạ?"
            }
          ]
        },
        {
          "id": "sj-thuong-04-b06-1381-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "44afa4c2-5012-52c0-8e9d-26dfc5eb75b1",
          "situation_uid": "6b515942-fa40-546a-b32c-85e264fa15f8",
          "context_vi": "Bộ phận vận hành không nhận được lịch giao đủ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初回に全量は出せません。",
              "vi": "Đợt đầu không thể xuất toàn bộ số lượng."
            },
            {
              "speaker_id": "B",
              "ja": "そこをなんとかお願いします。お客様の開店分だけでも先に出せませんか。",
              "vi": "Xin anh cố thu xếp giúp. Ít nhất có thể giao trước phần đủ cho khách khai trương không?"
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-04-b07-1182",
      "practice": [
        {
          "id": "sj-thuong-04-b07-1182-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "9349c2cb-99d6-5116-aede-edd9fdbcfbe4",
          "situation_uid": "339d4563-9162-533c-b02c-a188db41ee54",
          "context_vi": "Đọc lại điều kiện sau buổi đàm phán.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "では、初回は五百個、納品は月末でお願いします。保証期間は別途確認します。",
              "vi": "Vậy đợt đầu xin là 500 sản phẩm, giao cuối tháng. Thời hạn bảo hành sẽ xác nhận riêng ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、その二点は合っています。",
              "vi": "Vâng, hai điểm đó đúng."
            }
          ]
        },
        {
          "id": "sj-thuong-04-b07-1182-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6347a04c-648a-5a61-b940-e2c046221d04",
          "situation_uid": "22da1136-824f-5588-be90-ad50d784d646",
          "context_vi": "Chốt đơn giá sau khi làm rõ thuế.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhà cung cấp",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "税込みで一個八百円です。",
              "vi": "Đơn giá là 800 yên một sản phẩm, gồm thuế."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。その金額でお願いします。",
              "vi": "Tôi hiểu rồi. Xin chốt theo mức đó."
            }
          ]
        },
        {
          "id": "sj-thuong-04-b07-1182-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bfce5e6f-3e03-5d55-bb27-9244786e943a",
          "situation_uid": "e3b4bc3b-c328-5a55-b118-e9e4551f087e",
          "context_vi": "Khách muốn biết lần cập nhật đầu theo mốc mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đối tác",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên đàm phán",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "次の進捗はいつ分かりますか。",
              "vi": "Khi nào sẽ biết tiến độ tiếp theo?"
            },
            {
              "speaker_id": "B",
              "ja": "来週火曜の午前中でお願いします。検証結果をそろえてご報告します。",
              "vi": "Xin hẹn sáng thứ Ba tuần sau. Tôi sẽ tập hợp kết quả kiểm thử để báo cáo."
            }
          ]
        }
      ]
    }
  ]
}
