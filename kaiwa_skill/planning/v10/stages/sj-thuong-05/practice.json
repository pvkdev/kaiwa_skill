{
  "stage_uid": "e4ade665-5fa5-5bec-8196-62e5a981f92a",
  "items": [
    {
      "item_id": "sj-thuong-05-b12-213",
      "practice": [
        {
          "id": "sj-thuong-05-b12-213-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7cf689bb-5005-57ab-b0ff-3d6c2a25925d",
          "situation_uid": "a3129534-72b6-5b2b-bd16-d538e6ea5cfd",
          "context_vi": "Khách nói muốn có trang web mới, người thực hiện hỏi trọng tâm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách dự án",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người thực hiện dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "新しいサイトを作りたいんです。",
              "vi": "Tôi muốn làm trang web mới."
            },
            {
              "speaker_id": "B",
              "ja": "見た目を変えるというより、問い合わせを増やすことが目的でしょうか。",
              "vi": "Mục tiêu chính là tăng lượt hỏi hàng, hơn là chỉ đổi giao diện, phải không ạ?"
            }
          ]
        },
        {
          "id": "sj-thuong-05-b12-213-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b0720164-c051-531a-ad48-5231da4563ea",
          "situation_uid": "b5de725d-5f5d-57dd-b595-63b8701c9ec3",
          "context_vi": "Làm rõ quyền quyết định của người được phỏng vấn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người được phỏng vấn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người phỏng vấn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "最後は上司が決めます。",
              "vi": "Quyết định cuối cùng là của cấp trên."
            },
            {
              "speaker_id": "B",
              "ja": "一人で決めるというより、候補を絞って提案する役割なんですね。",
              "vi": "Vậy vai trò của anh là lọc phương án rồi đề xuất, chứ không phải tự quyết hết nhỉ."
            }
          ]
        },
        {
          "id": "sj-thuong-05-b12-213-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c62a0fd8-664a-5cbd-a854-ee0c8f355a00",
          "situation_uid": "ebf91f65-b991-5ad3-9581-5f502b80a35b",
          "context_vi": "Ứng viên nói về thành tích chung của nhóm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Ứng viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người phỏng vấn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "チームで売上を二割伸ばしました。",
              "vi": "Nhóm chúng tôi đã tăng doanh thu hai mươi phần trăm."
            },
            {
              "speaker_id": "B",
              "ja": "結果というより、あなたご自身がどの判断をされたかを伺いたいです。",
              "vi": "Tôi muốn nghe cụ thể chị đã đưa ra quyết định nào hơn là chỉ nghe kết quả."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-05-b12-1132",
      "practice": [
        {
          "id": "sj-thuong-05-b12-1132-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7cf689bb-5005-57ab-b0ff-3d6c2a25925d",
          "situation_uid": "ad45a03e-25ea-5a10-99bd-e8c78775cc45",
          "context_vi": "Khách hiểu câu để xem là đã nhận việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách dự án",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người thực hiện dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "追加の画面も作ってもらえるんですね。",
              "vi": "Vậy chị sẽ làm thêm màn hình đó nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "そうじゃなくて、まず工数を確認するという意味でした。対応できるかは明日お答えします。",
              "vi": "Ý tôi là trước hết sẽ kiểm tra khối lượng công việc. Ngày mai tôi mới trả lời có làm được hay không."
            }
          ]
        },
        {
          "id": "sj-thuong-05-b12-1132-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b0720164-c051-531a-ad48-5231da4563ea",
          "situation_uid": "87917953-8cce-5d5b-8ceb-25155f830fdf",
          "context_vi": "Người phỏng vấn hiểu nhầm lý do đổi nghề.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phỏng vấn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người được phỏng vấn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前の会社が嫌で辞めたんですか。",
              "vi": "Anh nghỉ vì không thích công ty cũ à?"
            },
            {
              "speaker_id": "B",
              "ja": "そうじゃなくて、新しい分野を学びたかったんです。退職理由の詳細は控えさせてください。",
              "vi": "Không phải vậy, tôi muốn học lĩnh vực mới. Xin phép không nói chi tiết lý do nghỉ việc."
            }
          ]
        },
        {
          "id": "sj-thuong-05-b12-1132-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c62a0fd8-664a-5cbd-a854-ee0c8f355a00",
          "situation_uid": "1a575e19-c0d1-5400-a6bb-901583dd7efa",
          "context_vi": "Ứng viên tưởng phải đưa một đáp án duy nhất.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Ứng viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người phỏng vấn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "正解を一つだけ答えればいいですか。",
              "vi": "Tôi chỉ cần nêu một đáp án đúng thôi sao?"
            },
            {
              "speaker_id": "B",
              "ja": "そうじゃなくて、判断する前に何を確認するかを聞きたいんです。",
              "vi": "Không, tôi muốn nghe chị sẽ kiểm tra những gì trước khi quyết định."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-05-b20-2409",
      "practice": [
        {
          "id": "sj-thuong-05-b20-2409-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7cf689bb-5005-57ab-b0ff-3d6c2a25925d",
          "situation_uid": "580a18f1-1b90-5025-9a82-4e97c6bb6932",
          "context_vi": "Mốc cũ không còn giữ được vì khách đổi yêu cầu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người thực hiện dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách dự án",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今週中に三画面追加するとなると、確認時間がネックになります。優先する一画面を選べますか。",
              "vi": "Nếu thêm ba màn hình trong tuần này, thời gian kiểm tra sẽ là nút thắt. Anh có thể chọn một màn hình ưu tiên không?"
            },
            {
              "speaker_id": "B",
              "ja": "まず申込画面をお願いします。",
              "vi": "Trước hết xin làm màn hình đăng ký."
            }
          ]
        },
        {
          "id": "sj-thuong-05-b20-2409-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b0720164-c051-531a-ad48-5231da4563ea",
          "situation_uid": "db238b8c-da27-5f3e-bf0e-88c6c789d067",
          "context_vi": "Hỏi về kỹ năng người mới vào nghề dễ thiếu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phỏng vấn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người được phỏng vấn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "未経験者には何が一番ネックになりますか。",
              "vi": "Với người chưa có kinh nghiệm, điều gì là trở ngại lớn nhất?"
            },
            {
              "speaker_id": "B",
              "ja": "専門用語より、相談するタイミングですね。",
              "vi": "Không phải thuật ngữ chuyên môn, mà là biết lúc nào nên hỏi."
            }
          ]
        },
        {
          "id": "sj-thuong-05-b20-2409-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c62a0fd8-664a-5cbd-a854-ee0c8f355a00",
          "situation_uid": "0cc24572-8d9c-5d5b-af63-7cc41196ed8a",
          "context_vi": "Ứng viên băn khoăn về hỗ trợ ban đầu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phỏng vấn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Ứng viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "入社を考えるうえで、何かネックになっていることはありますか。",
              "vi": "Khi cân nhắc nhận việc, có điều gì đang là vướng mắc với chị không?"
            },
            {
              "speaker_id": "B",
              "ja": "最初の研修期間がどのくらいか気になります。",
              "vi": "Tôi muốn biết giai đoạn đào tạo đầu kéo dài bao lâu."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-05-b06-589",
      "practice": [
        {
          "id": "sj-thuong-05-b06-589-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7cf689bb-5005-57ab-b0ff-3d6c2a25925d",
          "situation_uid": "0b7b3531-1c01-57b2-acaa-37e23c2dfee1",
          "context_vi": "Khách dự án tìm cách mô tả màn hình mình muốn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách dự án",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người thực hiện dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "うまく言えないのですが、使う人が迷わず申し込める画面にしたいんです。例えば、入力項目を減らせますか。",
              "vi": "Tôi khó diễn đạt, nhưng muốn người dùng đăng ký mà không lúng túng. Chẳng hạn có thể giảm các ô phải điền không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。今の画面を見ながら確認しましょう。",
              "vi": "Được. Ta cùng xem màn hình hiện tại nhé."
            }
          ]
        },
        {
          "id": "sj-thuong-05-b06-589-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b0720164-c051-531a-ad48-5231da4563ea",
          "situation_uid": "6fd09fbc-dc0e-5f4c-8028-b7b3c4e82479",
          "context_vi": "Tóm tắt điều học được từ cuộc trò chuyện nghề nghiệp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phỏng vấn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người được phỏng vấn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "うまく言えないのですが、技術よりも、人に相談する力が大切だと感じました。合っていますか。",
              "vi": "Tôi khó diễn đạt, nhưng cảm thấy khả năng hỏi ý kiến người khác còn quan trọng hơn kỹ thuật. Tôi hiểu vậy đúng không?"
            },
            {
              "speaker_id": "B",
              "ja": "そうですね。特に最初の一年は。",
              "vi": "Đúng vậy. Nhất là năm đầu."
            }
          ]
        },
        {
          "id": "sj-thuong-05-b06-589-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c62a0fd8-664a-5cbd-a854-ee0c8f355a00",
          "situation_uid": "0cc24572-8d9c-5d5b-af63-7cc41196ed8a",
          "context_vi": "Hỏi ứng viên còn băn khoăn điều gì.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Ứng viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người phỏng vấn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "うまく言えないんですが、配属後に一人で抱え込まないかが心配です。",
              "vi": "Tôi khó diễn đạt, nhưng lo sau khi vào nhóm sẽ phải ôm việc một mình."
            },
            {
              "speaker_id": "B",
              "ja": "相談先の体制についてお話ししますね。",
              "vi": "Tôi sẽ nói về cơ chế hỗ trợ nhé."
            }
          ]
        }
      ]
    }
  ]
}
