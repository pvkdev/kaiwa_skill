{
  "stage_uid": "398ac440-4497-549e-959b-c15a3663c1d0",
  "items": [
    {
      "item_id": "sj-thuong-15-b18-3291",
      "practice": [
        {
          "id": "sj-thuong-15-b18-3291-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7b2bec88-c40f-545d-af47-1ef69cf6dcef",
          "situation_uid": "fc5069bb-02a7-5b19-b505-e5ed42d1cbf3",
          "context_vi": "Người dẫn mời trưởng nhóm phát biểu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người dẫn chương trình",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "続いて、部長をご紹介させていただきます。今年の活動についてお話しいただきます。",
              "vi": "Tiếp theo, tôi xin giới thiệu trưởng bộ phận. Ông sẽ tổng kết hoạt động năm nay."
            },
            {
              "speaker_id": "B",
              "ja": "ご紹介ありがとうございます。",
              "vi": "Cảm ơn lời giới thiệu."
            }
          ]
        },
        {
          "id": "sj-thuong-15-b18-3291-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7b2bec88-c40f-545d-af47-1ef69cf6dcef",
          "situation_uid": "70c79cee-a365-53ba-aa06-9bde72571ac3",
          "context_vi": "Người rời nhóm chỉ muốn chào ngắn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người dẫn chương trình",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "それでは、短いご挨拶をお願いします。",
              "vi": "Vậy xin mời anh chào mọi người đôi lời ngắn thôi ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい。短くご挨拶させていただきます。",
              "vi": "Vâng. Tôi xin phép chào mọi người ngắn gọn."
            }
          ]
        },
        {
          "id": "sj-thuong-15-b18-3291-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "46765f4e-2845-5531-aa27-efd97c40d6dc",
          "situation_uid": "e55d1e44-7b39-51de-a198-69303afb8d06",
          "context_vi": "Nhận vai điều phối họp khu phố.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Hàng xóm",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người dẫn chương trình",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "次回の会議、進行をお願いできますか。",
              "vi": "Buổi họp tới chị điều phối giúp được không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、議題を確認した上で進行させていただきます。",
              "vi": "Vâng, tôi xin đảm nhận điều phối sau khi kiểm tra chương trình họp."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-15-b12-1344",
      "practice": [
        {
          "id": "sj-thuong-15-b12-1344-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7b2bec88-c40f-545d-af47-1ef69cf6dcef",
          "situation_uid": "aa639ff9-784e-56be-9278-6a0c82ea0a5d",
          "context_vi": "Kết phần tiễn người rời nhóm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người dẫn chương trình",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "引き継ぎ先は佐藤さんで、最初のご連絡は月曜です。そういうことで、これで送別会をお開きにします。",
              "vi": "Đầu mối tiếp nhận là Sato, lần liên hệ đầu vào thứ Hai. Vậy chúng ta kết thúc buổi tiệc chia tay tại đây."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございました。",
              "vi": "Cảm ơn mọi người."
            }
          ]
        },
        {
          "id": "sj-thuong-15-b12-1344-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "46765f4e-2845-5531-aa27-efd97c40d6dc",
          "situation_uid": "be2a3ec6-8695-5457-bcec-bfe8b26c48f7",
          "context_vi": "Chốt quyết định buổi họp cư dân.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người dẫn chương trình",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người dự họp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "清掃は日曜九時、道具は私が用意します。そういうことで進めてよろしいですか。",
              "vi": "Việc dọn dẹp là chín giờ Chủ nhật, tôi chuẩn bị dụng cụ. Ta làm theo đó được chứ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。私は参加者に連絡します。",
              "vi": "Vâng. Tôi sẽ báo người tham gia."
            }
          ]
        },
        {
          "id": "sj-thuong-15-b12-1344-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "121a792c-e29f-55b9-8ab1-cb533003554d",
          "situation_uid": "1c985e82-dd9c-5af6-bcb7-3a0f98eb39ba",
          "context_vi": "Hàng xóm thống nhất cách liên lạc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Hàng xóm",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "急ぎのときだけ電話、普段はメッセージですね。そういうことでお願いします。",
              "vi": "Việc gấp thì gọi, còn thường ngày thì nhắn tin nhỉ. Vậy thống nhất như thế nhé."
            },
            {
              "speaker_id": "B",
              "ja": "はい、その方が助かります。",
              "vi": "Vâng, như vậy tiện cho tôi."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-15-b06-1048",
      "practice": [
        {
          "id": "sj-thuong-15-b06-1048-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "46765f4e-2845-5531-aa27-efd97c40d6dc",
          "situation_uid": "9b91fd75-8d27-55bc-8155-f6e4229e4f69",
          "context_vi": "Chưa đạt đồng thuận, chủ trì khép cuộc họp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người dự họp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người dẫn chương trình",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まだ二案に分かれています。",
              "vi": "Ta vẫn còn hai phương án."
            },
            {
              "speaker_id": "B",
              "ja": "今日はここまでにしましょう。来週、費用を確認してから続きを話します。",
              "vi": "Hôm nay ta dừng ở đây. Tuần sau kiểm chi phí rồi bàn tiếp."
            }
          ]
        },
        {
          "id": "sj-thuong-15-b06-1048-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7b2bec88-c40f-545d-af47-1ef69cf6dcef",
          "situation_uid": "97587834-9589-5ee7-bc53-a83d6575516d",
          "context_vi": "Kết một phần chương trình và chuyển sang phần sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người dẫn chương trình",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご挨拶は今日はここまでにしましょう。この後は交流の時間です。",
              "vi": "Phần chào hỏi hôm nay đến đây thôi. Tiếp theo là thời gian giao lưu."
            },
            {
              "speaker_id": "B",
              "ja": "皆さん、どうぞ楽しんでください。",
              "vi": "Mọi người cứ tự nhiên nhé."
            }
          ]
        },
        {
          "id": "sj-thuong-15-b06-1048-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "46765f4e-2845-5531-aa27-efd97c40d6dc",
          "situation_uid": "5d230640-1450-56ff-ae7f-dd0e9dd1cb8c",
          "context_vi": "Cuộc họp khu phố đi xa khỏi chủ đề, người điều phối hẹn bàn tiếp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người dự họp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người điều phối",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "駐車場の話も今決めましょう。",
              "vi": "Ta quyết luôn chuyện bãi đỗ xe bây giờ nhé."
            },
            {
              "speaker_id": "B",
              "ja": "今日はここまでにしましょう。次回、駐車場を議題に入れて改めて話します。",
              "vi": "Hôm nay ta dừng ở đây. Buổi sau sẽ đưa chuyện bãi đỗ xe vào chương trình để bàn kỹ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-15-b20-3446",
      "practice": [
        {
          "id": "sj-thuong-15-b20-3446-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7b2bec88-c40f-545d-af47-1ef69cf6dcef",
          "situation_uid": "645e58e8-17e6-5859-809d-0ddcbb169304",
          "context_vi": "Giới thiệu người rời nhóm và sự hỗ trợ họ đã nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người dẫn chương trình",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "佐藤さんは、新人の相談にいつも耳を傾けてくれました。今日はその一例を紹介します。",
              "vi": "Sato luôn chăm chú lắng nghe người mới khi họ cần hỏi ý. Hôm nay tôi xin kể một ví dụ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。",
              "vi": "Cảm ơn chị."
            }
          ]
        },
        {
          "id": "sj-thuong-15-b20-3446-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "121a792c-e29f-55b9-8ab1-cb533003554d",
          "situation_uid": "358bedc0-045f-5adf-88f6-01c62e532176",
          "context_vi": "Sau khi hàng xóm kể hết chuyện tiếng ồn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Hàng xóm",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨夜も音が続いて、子どもが眠れませんでした。",
              "vi": "Đêm qua vẫn ồn, con tôi không ngủ được."
            },
            {
              "speaker_id": "B",
              "ja": "話に耳を傾けて初めて、夜遅くまで続いていたと分かりました。今夜から時間を変えます。",
              "vi": "Nghe chị kể hết tôi mới biết tiếng ồn kéo dài tới khuya. Từ tối nay tôi sẽ đổi giờ."
            }
          ]
        },
        {
          "id": "sj-thuong-15-b20-3446-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "46765f4e-2845-5531-aa27-efd97c40d6dc",
          "situation_uid": "0be4a808-aaa5-5f93-8ff1-2fb8231e3a8e",
          "context_vi": "Mời người ít phát biểu nêu quan điểm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người dẫn chương trình",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người dự họp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まだ話していない方の意見にも耳を傾けたいです。田中さん、気になる点はありますか。",
              "vi": "Tôi muốn nghe cả ý kiến của người chưa phát biểu. Anh Tanaka có điều gì băn khoăn không?"
            },
            {
              "speaker_id": "B",
              "ja": "作業時間を確認したいです。",
              "vi": "Tôi muốn xác nhận giờ làm."
            }
          ]
        }
      ]
    }
  ]
}
