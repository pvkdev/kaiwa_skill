{
  "stage_uid": "cce2b217-5cb7-5f31-9327-2785d7a854db",
  "items": [
    {
      "item_id": "sj-so-01-b07-146",
      "practice": [
        {
          "id": "sj-so-01-b07-146-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6d7236fd-ec40-59c5-8693-d185dae019ad",
          "situation_uid": "f398d2b8-51a2-5129-b589-b3ae88face41",
          "context_vi": "Ở quầy ăn ồn, khách chưa nghe rõ tên món.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、料理の名前、もう一度いいですか。",
              "vi": "Xin lỗi, anh nhắc lại tên món giúp tôi được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "親子丼です。",
              "vi": "Dạ, cơm gà trứng ạ."
            }
          ]
        },
        {
          "id": "sj-so-01-b07-146-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6d7236fd-ec40-59c5-8693-d185dae019ad",
          "situation_uid": "98b422c2-fbc1-5995-b41a-2aa18e8434cb",
          "context_vi": "Khách chỉ muốn nghe lại số tiền phải trả.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、金額だけもう一度いいですか。",
              "vi": "Xin lỗi, chị nhắc lại riêng số tiền giúp tôi được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "千二百八十円です。",
              "vi": "Dạ, một nghìn hai trăm tám mươi yên ạ."
            }
          ]
        },
        {
          "id": "sj-so-01-b07-146-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7e123726-1655-5175-8cba-36c64682c8e2",
          "situation_uid": "a83fe791-edd3-5880-9fe9-fc257cc9563d",
          "context_vi": "Người mới đến nhà nghe chưa rõ tên con gái chủ nhà.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Chủ nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、お嬢さんのお名前、もう一度いいですか。",
              "vi": "Xin lỗi, bác nhắc lại tên con gái giúp cháu được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "美咲です。",
              "vi": "Con bé tên Misaki."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-01-b11-41",
      "practice": [
        {
          "id": "sj-so-01-b11-41-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "61142be7-8b9c-5008-9371-03b2ece1e568",
          "situation_uid": "db046936-f196-5829-85fc-450babe0b419",
          "context_vi": "Khách mở lời với nhân viên về món không có nhãn giá.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あのう、ちょっと伺いますが。",
              "vi": "Xin lỗi, tôi hỏi một chút được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、何でしょうか。",
              "vi": "Vâng, chị cần hỏi gì ạ?"
            },
            {
              "speaker_id": "A",
              "ja": "このお皿はいくらですか。",
              "vi": "Chiếc đĩa này bao nhiêu tiền ạ?"
            }
          ]
        },
        {
          "id": "sj-so-01-b11-41-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1898f652-0310-5555-af05-963595fbf83b",
          "situation_uid": "a186d05c-37d6-5cd4-a23e-c8ac29dbccd6",
          "context_vi": "Khách hỏi người môi giới căn đã xem trên mạng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Môi giới",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あのう、ちょっと伺いますが。この部屋はまだ見られますか。",
              "vi": "Xin lỗi, tôi hỏi một chút ạ. Căn này vẫn xem được chứ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、明日でしたらご案内できます。",
              "vi": "Vâng, ngày mai tôi có thể dẫn anh đi xem."
            }
          ]
        },
        {
          "id": "sj-so-01-b11-41-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7e123726-1655-5175-8cba-36c64682c8e2",
          "situation_uid": "eb183fa8-7529-510f-a579-736b03323032",
          "context_vi": "Người mới ở hỏi chủ nhà cách dùng phòng tắm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người ở mới",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Chủ nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あのう、ちょっと伺いますが。お風呂は何時ごろ使えますか。",
              "vi": "Cháu xin hỏi một chút ạ. Khoảng mấy giờ cháu có thể dùng phòng tắm?"
            },
            {
              "speaker_id": "B",
              "ja": "八時からどうぞ。",
              "vi": "Từ tám giờ cháu cứ dùng nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-01-b11-61",
      "practice": [
        {
          "id": "sj-so-01-b11-61-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6d7236fd-ec40-59c5-8693-d185dae019ad",
          "situation_uid": "96922b15-2a7b-57ea-8ecd-ade9417126ec",
          "context_vi": "Người đi đường hỏi nghĩa một từ trong lời chỉ đường.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi đường",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người chỉ đường",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、「突き当たり」についてちょっと聞きたいんですが。",
              "vi": "Xin lỗi, tôi muốn hỏi một chút về từ “cuối đường” ạ."
            },
            {
              "speaker_id": "B",
              "ja": "道がそこで終わるところです。",
              "vi": "Là chỗ con đường kết thúc ấy ạ."
            }
          ]
        },
        {
          "id": "sj-so-01-b11-61-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1898f652-0310-5555-af05-963595fbf83b",
          "situation_uid": "95fb1914-13c7-5108-a674-3c6358adfe5f",
          "context_vi": "Sau khi xem phòng, khách muốn biết chi phí khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Môi giới",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "家賃のほかに払うお金を聞きたいんですが。",
              "vi": "Tôi muốn hỏi ngoài tiền thuê còn khoản nào phải trả ạ."
            },
            {
              "speaker_id": "B",
              "ja": "管理費が毎月三千円かかります。",
              "vi": "Phí quản lý là ba nghìn yên mỗi tháng ạ."
            }
          ]
        },
        {
          "id": "sj-so-01-b11-61-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7e123726-1655-5175-8cba-36c64682c8e2",
          "situation_uid": "4c6e0f71-5c76-52dc-9177-de1134f5a755",
          "context_vi": "Người mới ở chưa hiểu quy tắc bỏ rác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người ở mới",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Chủ nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、ゴミの出し方がちょっとわからないんですが。",
              "vi": "Xin lỗi, cháu chưa hiểu cách bỏ rác lắm ạ."
            },
            {
              "speaker_id": "B",
              "ja": "燃えるゴミは火曜日の朝に出してください。",
              "vi": "Rác đốt được thì cháu đem ra sáng thứ Ba nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-01-b07-18",
      "practice": [
        {
          "id": "sj-so-01-b07-18-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6d7236fd-ec40-59c5-8693-d185dae019ad",
          "situation_uid": "11150a19-1ca3-5a8c-ab9b-a04940ced927",
          "context_vi": "Người học hiểu bước đầu nhưng chưa rõ lời dặn tiếp theo.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người học",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người hướng dẫn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "駅まで行くのはわかりました。そのあと「戻る」って、どういうことですか。",
              "vi": "Tôi hiểu là đi đến ga rồi. Sau đó “quay lại” là sao ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "駅の手前の角まで戻ってください。",
              "vi": "Chị quay lại góc đường trước ga nhé."
            }
          ]
        },
        {
          "id": "sj-so-01-b07-18-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "1898f652-0310-5555-af05-963595fbf83b",
          "situation_uid": "88e4092e-4749-5fa5-984b-db8f7f4d3d1d",
          "context_vi": "Khách nghe phí quản lý thu hằng tháng dù tưởng chỉ một lần.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Môi giới",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "管理費が毎月かかるって、どういうことですか。",
              "vi": "Phí quản lý phải trả hằng tháng là sao ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "家賃と一緒に毎月払う費用です。",
              "vi": "Đó là khoản trả cùng tiền thuê mỗi tháng ạ."
            }
          ]
        },
        {
          "id": "sj-so-01-b07-18-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7e123726-1655-5175-8cba-36c64682c8e2",
          "situation_uid": "4c6e0f71-5c76-52dc-9177-de1134f5a755",
          "context_vi": "Chủ nhà nói một quy tắc ngắn khiến khách chưa hiểu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người ở mới",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Chủ nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "「お風呂は先に声をかけて」って、どういうことですか。",
              "vi": "Bác bảo “trước khi tắm thì báo một tiếng” nghĩa là sao ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "入る前に私に一言言ってください。",
              "vi": "Trước khi vào, cháu báo cho bác một tiếng nhé."
            }
          ]
        }
      ]
    }
  ]
}
