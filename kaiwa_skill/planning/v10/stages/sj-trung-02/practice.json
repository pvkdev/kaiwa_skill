{
  "stage_uid": "6ea637d7-8a4b-59f4-8c0d-21d1bd044bd9",
  "items": [
    {
      "item_id": "sj-trung-02-b07-128",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn muốn yên tĩnh sau tin buồn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今は一人でいたいよね。何かあったら言ってね。",
              "vi": "Giờ cậu muốn ở một mình nhỉ. Có cần gì thì cứ bảo tớ nhé."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとう。少し休むよ。",
              "vi": "Cảm ơn. Tớ nghỉ một lúc."
            }
          ],
          "id": "sj-trung-02-b07-128-ex01",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "b383a6e8-399f-5970-b97d-5854e0cbba68"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đồng nghiệp đang vất vả với phần bàn giao.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "資料の整理なら手伝えます。何かあったら言ってください。",
              "vi": "Tôi có thể giúp sắp xếp tài liệu. Nếu cần gì cứ nói với tôi."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。助かります。",
              "vi": "Cảm ơn anh. Vậy tốt quá."
            }
          ],
          "id": "sj-trung-02-b07-128-ex02",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "914a686a-4336-56a4-bb8b-2103840f5a2c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Vài ngày sau vẫn để bạn tự chọn có nói không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "返事は急がなくていいよ。何かあったら言ってね。",
              "vi": "Cậu không cần trả lời ngay. Có chuyện gì thì cứ bảo tớ nhé."
            },
            {
              "speaker_id": "B",
              "ja": "うん、ありがとう。",
              "vi": "Ừ, cảm ơn cậu."
            }
          ],
          "id": "sj-trung-02-b07-128-ex03",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "76cf4870-292a-564c-9d56-f4dd3326b3cd"
        }
      ]
    },
    {
      "item_id": "sj-trung-02-b06-20",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn phân vân có nhờ mình đi cùng không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一緒に行ってほしくなったら、いつでも言って。",
              "vi": "Nếu cậu muốn tớ đi cùng thì cứ nói bất cứ lúc nào."
            },
            {
              "speaker_id": "B",
              "ja": "うん、考えてみる。",
              "vi": "Ừ, để tớ nghĩ xem."
            }
          ],
          "id": "sj-trung-02-b06-20-ex01",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "fed783ea-be61-56d3-8279-6648ec3de3bf"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đồng nghiệp chưa muốn kể chi tiết.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "詳しいことは聞きません。仕事のことで困ったら、いつでも言ってください。",
              "vi": "Tôi sẽ không hỏi chuyện riêng. Nếu gặp khó khăn trong công việc thì cứ nói với tôi bất cứ lúc nào."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。",
              "vi": "Cảm ơn chị."
            }
          ],
          "id": "sj-trung-02-b06-20-ex02",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "745fee11-885f-5bbe-8cd4-2e7c698031ef"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi thăm sau vài hôm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は話したくなければ大丈夫。話せるときにいつでも言って。",
              "vi": "Hôm nay cậu chưa muốn kể cũng không sao. Khi nào muốn nói thì cứ bảo tớ."
            },
            {
              "speaker_id": "B",
              "ja": "そう言ってくれると気が楽になる。",
              "vi": "Cậu nói vậy tớ thấy nhẹ lòng hơn."
            }
          ],
          "id": "sj-trung-02-b06-20-ex03",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "76cf4870-292a-564c-9d56-f4dd3326b3cd"
        }
      ]
    },
    {
      "item_id": "sj-trung-02-b07-34",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn báo kết quả thi không như mong đợi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "試験、落ちちゃった。",
              "vi": "Tớ trượt kỳ thi rồi."
            },
            {
              "speaker_id": "B",
              "ja": "それは残念だったね。頑張ってたの、知ってるよ。",
              "vi": "Tiếc quá. Tớ biết cậu đã cố gắng nhiều."
            }
          ],
          "id": "sj-trung-02-b07-34-ex01",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "2a4ac3d5-e2e6-5375-bda6-bd2da73a1f48"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đồng nghiệp báo một kế hoạch bị hủy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "予定していた研修が中止になりました。",
              "vi": "Buổi tập huấn đã định bị hủy rồi."
            },
            {
              "speaker_id": "B",
              "ja": "それは残念でしたね。準備も進めていたのに。",
              "vi": "Thật đáng tiếc. Chị đã chuẩn bị nhiều rồi mà."
            }
          ],
          "id": "sj-trung-02-b07-34-ex02",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "a01a8c9b-8cca-57dc-b0f1-e6eecd011bcd"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe bạn mất cơ hội mình mong đợi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "面接、今回はだめだった。",
              "vi": "Lần phỏng vấn này tớ không đậu."
            },
            {
              "speaker_id": "B",
              "ja": "それは残念だったね。よかったら話、聞くよ。",
              "vi": "Tiếc quá. Nếu cậu muốn, tớ nghe cậu kể nhé."
            }
          ],
          "id": "sj-trung-02-b07-34-ex03",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "af9b3d7c-4390-5530-a870-f086485255c1"
        }
      ]
    },
    {
      "item_id": "sj-trung-02-b24-35",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn đổi ý muốn gặp và thấy lòng dịu lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "会って話したら、少し癒されたよ。",
              "vi": "Gặp cậu và nói chuyện xong, lòng tớ dịu lại một chút."
            },
            {
              "speaker_id": "B",
              "ja": "それならよかった。",
              "vi": "Vậy thì tốt rồi."
            }
          ],
          "id": "sj-trung-02-b24-35-ex01",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "045270ed-989e-5487-8997-3722b69e231b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đồng nghiệp trở lại và cảm thấy dễ chịu với nhóm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "みんなが普段どおりに接してくれて、気持ちが和みました。",
              "vi": "Mọi người đối xử với tôi như thường ngày, nên tôi thấy lòng nhẹ lại."
            },
            {
              "speaker_id": "B",
              "ja": "よかったです。無理はしないでくださいね。",
              "vi": "Mừng quá. Anh đừng cố sức quá nhé."
            }
          ],
          "id": "sj-trung-02-b24-35-ex02",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "11e581cd-8394-5e17-b600-2be0276a7ebc"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chỉ ngồi cạnh cũng khiến bạn bớt căng thẳng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "何も言わずに一緒にいてくれて、なんだか和んだよ。",
              "vi": "Cậu chỉ ngồi cùng, chẳng cần nói gì, mà tớ thấy yên lòng."
            },
            {
              "speaker_id": "B",
              "ja": "いつでも呼んで。",
              "vi": "Khi nào cần thì gọi tớ."
            }
          ],
          "id": "sj-trung-02-b24-35-ex03",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "fed783ea-be61-56d3-8279-6648ec3de3bf"
        }
      ]
    },
    {
      "item_id": "sj-trung-02-b24-62",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn thất vọng vì tin vừa nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あんなに準備したのに、だめだった。がっかりしたよ。",
              "vi": "Tớ đã chuẩn bị nhiều thế mà vẫn không được. Thất vọng quá."
            },
            {
              "speaker_id": "B",
              "ja": "うん、つらいよね。",
              "vi": "Ừ, buồn thật đấy."
            }
          ],
          "id": "sj-trung-02-b24-62-ex01",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "2a4ac3d5-e2e6-5375-bda6-bd2da73a1f48"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thấy bạn ủ rũ vài ngày sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まだしょんぼりしてるね。今日は一緒に散歩する？",
              "vi": "Cậu vẫn buồn rầu nhỉ. Hôm nay đi dạo với tớ không?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、少し歩きたい。",
              "vi": "Ừ, tớ muốn đi bộ một chút."
            }
          ],
          "id": "sj-trung-02-b24-62-ex02",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "76cf4870-292a-564c-9d56-f4dd3326b3cd"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn kể mình buồn vì kế hoạch không thành.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "楽しみにしてた旅行がなくなって、がっかりしてる。",
              "vi": "Chuyến đi tớ mong chờ bị hủy, tớ thất vọng quá."
            },
            {
              "speaker_id": "B",
              "ja": "それは残念だったね。",
              "vi": "Thật đáng tiếc."
            }
          ],
          "id": "sj-trung-02-b24-62-ex03",
          "topic_uid": "fc19cbb2-ccaf-5c9c-aadf-f59a4a77edf8",
          "situation_uid": "af9b3d7c-4390-5530-a870-f086485255c1"
        }
      ]
    }
  ]
}
