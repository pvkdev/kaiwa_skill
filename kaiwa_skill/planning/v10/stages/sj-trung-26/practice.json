{
  "stage_uid": "86b031c7-adbb-5c76-8cb5-99811a1a84df",
  "items": [
    {
      "item_id": "sj-trung-26-b20-119",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai việc do hai người khác nhau giao cùng lúc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二人の担当者に別々の締め切りを言われて、板ばさみなんだ。",
              "vi": "Hai người phụ trách đưa hạn khác nhau, tớ bị kẹt giữa hai bên."
            },
            {
              "speaker_id": "B",
              "ja": "優先順位を一緒に確認しよう。",
              "vi": "Mình hỏi lại thứ tự ưu tiên nhé."
            }
          ],
          "id": "sj-trung-26-b20-119-ex01",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "f2ee2748-1a85-5221-8cd8-9eda09c503d5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quản lý thêm việc trong khi đầu mối khác chờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二つのチームの間で板ばさみになっています。どちらを先にすべきですか。",
              "vi": "Tôi đang kẹt giữa hai nhóm. Việc nào nên làm trước ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "今日はこちらを優先してください。",
              "vi": "Hôm nay ưu tiên việc này."
            }
          ],
          "id": "sj-trung-26-b20-119-ex02",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "f9d41e4d-b966-5f88-9893-39ba7771b4c0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đồng nghiệp tưởng mình không hợp tác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どちらの仕事も断るの？",
              "vi": "Cậu từ chối cả hai việc à?"
            },
            {
              "speaker_id": "B",
              "ja": "違うよ。両方から急ぎと言われて板ばさみなんだ。",
              "vi": "Không, cả hai bên đều bảo gấp nên tớ kẹt giữa hai phía."
            }
          ],
          "id": "sj-trung-26-b20-119-ex03",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "6af5755d-6cc2-5172-8052-d2e004d01bf9"
        }
      ]
    },
    {
      "item_id": "sj-trung-26-b24-44",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo khối lượng việc hiện tại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今週は問い合わせ対応で手が回らず、報告書に着手できません。",
              "vi": "Tuần này tôi bận xử lý yêu cầu đến mức không lo được báo cáo."
            },
            {
              "speaker_id": "B",
              "ja": "では、別の人に一部任せましょう。",
              "vi": "Vậy giao bớt một phần cho người khác."
            }
          ],
          "id": "sj-trung-26-b24-44-ex01",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "3a4a8e09-1bb0-5323-918e-093cf28a1e9e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Việc mới làm mình không thể xoay xở.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この仕事も今日中だと、身動きがとれません。どれを延ばせますか。",
              "vi": "Nếu việc này cũng phải xong hôm nay thì tôi không xoay xở nổi. Có thể lùi việc nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "報告書を明日にしましょう。",
              "vi": "Lùi báo cáo sang mai."
            }
          ],
          "id": "sj-trung-26-b24-44-ex02",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "f9d41e4d-b966-5f88-9893-39ba7771b4c0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau tuần thử vẫn quá tải.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先週の方法でも、夕方は手が回りませんでした。",
              "vi": "Dù thử cách tuần trước, chiều đến tôi vẫn không xoay xở kịp."
            },
            {
              "speaker_id": "B",
              "ja": "仕事の分け方を見直しましょう。",
              "vi": "Ta xem lại cách chia việc."
            }
          ],
          "id": "sj-trung-26-b24-44-ex03",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "0f51bcc2-aed7-5836-928c-8656817cb032"
        }
      ]
    },
    {
      "item_id": "sj-trung-26-b24-43",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Giờ làm đã sát giới hạn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "毎日ぎりぎりまで働いていて、追加の仕事は難しいです。",
              "vi": "Ngày nào tôi cũng làm sát giờ tối đa, khó nhận thêm việc."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。優先順位を整理します。",
              "vi": "Tôi hiểu. Tôi sẽ sắp thứ tự ưu tiên."
            }
          ],
          "id": "sj-trung-26-b24-43-ex01",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "3a4a8e09-1bb0-5323-918e-093cf28a1e9e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cận giờ hết ngày, cần chọn việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もう時間がぎりぎりです。どちらを先に終わらせますか。",
              "vi": "Sắp hết giờ rồi. Ta hoàn tất việc nào trước ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "お客様への返答を先に。",
              "vi": "Trả lời khách trước."
            }
          ],
          "id": "sj-trung-26-b24-43-ex02",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "cac62491-f517-5b89-8275-6df66fe29d00"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Mốc đổi đột ngột khiến nhóm bị dồn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "期限が急に早まって、せっぱ詰まっています。",
              "vi": "Hạn đột ngột sớm hơn nên tình hình rất cấp bách."
            },
            {
              "speaker_id": "B",
              "ja": "まず必要な部分だけに絞りましょう。",
              "vi": "Trước hết chỉ làm phần cần thiết."
            }
          ],
          "id": "sj-trung-26-b24-43-ex03",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "cbf24770-0508-570d-8cdf-3e43039bcb88"
        }
      ]
    },
    {
      "item_id": "sj-trung-26-b06-206",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đề nghị đồng nghiệp nhận phần nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は余裕がないので、この確認だけお願いできる？",
              "vi": "Hôm nay tớ không còn thời gian, cậu kiểm giúp riêng phần này được không?"
            },
            {
              "speaker_id": "B",
              "ja": "そこだけならできるよ。",
              "vi": "Riêng phần đó thì được."
            }
          ],
          "id": "sj-trung-26-b06-206-ex01",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "840ef93c-0db7-522b-9d1e-3873a059e07b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Ngoài giờ cần xác định việc thật sự khẩn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "夜は余裕がないので、急ぎの連絡だけ電話にしてください。",
              "vi": "Buổi tối tôi không có dư thời gian, xin chỉ gọi các việc khẩn ạ."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。",
              "vi": "Tôi hiểu rồi."
            }
          ],
          "id": "sj-trung-26-b06-206-ex02",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "5bbe5c5b-ad4c-53bf-8c12-50084310e93b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo cách làm thử vẫn không tạo thêm thời gian.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今の分担では、まだ余裕がありません。",
              "vi": "Với cách chia việc hiện nay, tôi vẫn không có thời gian dư."
            },
            {
              "speaker_id": "B",
              "ja": "もう一度調整しましょう。",
              "vi": "Ta điều chỉnh lại."
            }
          ],
          "id": "sj-trung-26-b06-206-ex03",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "0f51bcc2-aed7-5836-928c-8656817cb032"
        }
      ]
    },
    {
      "item_id": "sj-trung-26-b06-190",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau một tuần quá tải, nói đã đến giới hạn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "このペースで毎晩残業するのは、もう限界です。",
              "vi": "Cứ ngày nào cũng tăng ca với nhịp này thì tôi đến giới hạn rồi."
            },
            {
              "speaker_id": "B",
              "ja": "負担を減らす方法を考えましょう。",
              "vi": "Ta tìm cách giảm bớt gánh nặng."
            }
          ],
          "id": "sj-trung-26-b06-190-ex01",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "0f51bcc2-aed7-5836-928c-8656817cb032"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Làm rõ mình vẫn hợp tác nhưng quá sức.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もう手伝わないの？",
              "vi": "Cậu không giúp nữa à?"
            },
            {
              "speaker_id": "B",
              "ja": "手伝いたいけど、今の量はもう限界なんだ。",
              "vi": "Tớ muốn giúp, nhưng khối lượng hiện tại là quá sức rồi."
            }
          ],
          "id": "sj-trung-26-b06-190-ex02",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "6af5755d-6cc2-5172-8052-d2e004d01bf9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Việc mới vượt khả năng trong ngày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日さらに一件増えると、もう限界です。何を後回しにできますか。",
              "vi": "Hôm nay thêm một việc nữa thì tôi quá sức rồi. Có thể lùi việc nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "資料の整理は明日にします。",
              "vi": "Việc sắp tài liệu để mai."
            }
          ],
          "id": "sj-trung-26-b06-190-ex03",
          "topic_uid": "3411a12f-3071-5c8b-8f18-846661f36d5d",
          "situation_uid": "f9d41e4d-b966-5f88-9893-39ba7771b4c0"
        }
      ]
    }
  ]
}
