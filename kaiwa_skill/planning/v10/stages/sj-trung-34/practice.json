{
  "stage_uid": "f6315df3-d6aa-5138-aeb6-73876d48f3a2",
  "items": [
    {
      "item_id": "sj-trung-34-b20-175",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Mới biết phí vật liệu thêm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "材料費が別なのは盲点でした。料金をもう一度教えてください。",
              "vi": "Tôi đã bỏ sót chuyện phí vật liệu tính riêng. Xin cho tôi biết lại số tiền ạ."
            },
            {
              "speaker_id": "B",
              "ja": "五百円です。",
              "vi": "Năm trăm yên ạ."
            }
          ],
          "id": "sj-trung-34-b20-175-ex01",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "80db6579-3059-5e85-a82c-7d446fcd509c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sản phẩm lệch vì một bước bị bỏ qua.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ここだけ形が違うね。",
              "vi": "Chỗ này hình dáng khác nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "乾かす時間を忘れてた。それが盲点だったね。",
              "vi": "Tớ quên thời gian để khô. Đúng là chỗ mình bỏ sót."
            }
          ],
          "id": "sj-trung-34-b20-175-ex02",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "b337cd56-6735-5aa8-bb35-b7efaf4982f9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thời gian còn ít, mới nghĩ đến bước chờ khô.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người hướng dẫn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "乾く時間を考えてなかったのが盲点でした。今、何ができますか。",
              "vi": "Tôi đã bỏ sót thời gian khô. Bây giờ tôi còn làm được gì ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "形を整えるところまでできます。",
              "vi": "Anh còn có thể chỉnh hình dáng."
            }
          ],
          "id": "sj-trung-34-b20-175-ex03",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "71e10bbe-b453-5cf4-8b8b-131a84bf5f4d"
        }
      ]
    },
    {
      "item_id": "sj-trung-34-b11-87",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chọn buổi cơ bản phù hợp trình độ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người hướng dẫn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "難しい講座と基本講座、どちらにしますか。",
              "vi": "Anh chọn lớp nâng cao hay lớp cơ bản?"
            },
            {
              "speaker_id": "B",
              "ja": "初めてなので、基本講座のほうにします。",
              "vi": "Đây là lần đầu nên tôi chọn lớp cơ bản."
            }
          ],
          "id": "sj-trung-34-b11-87-ex01",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "165bf284-151a-5621-b338-694cedeb4241"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chọn màu khác khi vật liệu giới hạn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người hướng dẫn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "青がないなら、緑のほうがいいです。",
              "vi": "Nếu không có màu xanh dương, tôi chọn màu xanh lá."
            },
            {
              "speaker_id": "B",
              "ja": "緑はありますよ。",
              "vi": "Có màu xanh lá ạ."
            }
          ],
          "id": "sj-trung-34-b11-87-ex02",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "78b1b93b-9bf1-5991-b53a-ee412f264fd9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chọn bước dễ hơn để tiếp tục.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người hướng dẫn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "細かい模様は難しそうです。",
              "vi": "Họa tiết nhỏ có vẻ khó."
            },
            {
              "speaker_id": "B",
              "ja": "では、線だけ入れるほうにします。",
              "vi": "Vậy tôi chọn chỉ vẽ đường nét thôi."
            }
          ],
          "id": "sj-trung-34-b11-87-ex03",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "7e9715c2-2070-54e0-a7b1-69a32aaa5085"
        }
      ]
    },
    {
      "item_id": "sj-trung-34-b12-96",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nói với bạn đã làm đến bước nào.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もう色を塗った？",
              "vi": "Cậu tô màu rồi à?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、ちゃんと下地を乾かしてから塗ったよ。",
              "vi": "Ừ, tớ để lớp nền khô hẳn rồi mới tô."
            }
          ],
          "id": "sj-trung-34-b12-96-ex01",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "58102ff5-3809-5392-83ef-e7cdf88c97e0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi được hướng dẫn lại, tự làm đúng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今度はちゃんと順番どおりにできたよ。",
              "vi": "Lần này tớ làm đúng thứ tự rồi."
            },
            {
              "speaker_id": "B",
              "ja": "きれいにできたね。",
              "vi": "Đẹp đấy."
            }
          ],
          "id": "sj-trung-34-b12-96-ex02",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "64309b5f-bdc2-54e2-b30f-96fa1ffdcf5a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kiểm với bạn sản phẩm đã sẵn sàng mang về.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もう持って帰れる？",
              "vi": "Giờ mang về được chưa?"
            },
            {
              "speaker_id": "B",
              "ja": "ちゃんと乾いてからじゃないとだめだって。",
              "vi": "Phải để khô hẳn mới được mang về cơ."
            }
          ],
          "id": "sj-trung-34-b12-96-ex03",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "e55f9fdb-879f-5d7b-a7d3-2ff14d76a3ce"
        }
      ]
    },
    {
      "item_id": "sj-trung-34-b24-25",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn xem lỗi có thể biến thành kiểu khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どれどれ。ここを模様にすれば、きれいになるかも。",
              "vi": "Để xem nào. Nếu biến chỗ này thành họa tiết có lẽ sẽ đẹp."
            },
            {
              "speaker_id": "B",
              "ja": "それ、いいね。",
              "vi": "Ý đó hay đấy."
            }
          ],
          "id": "sj-trung-34-b24-25-ex01",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "d5e0da72-354c-5455-ae85-3de1369d8835"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chọn buổi workshop thay thế.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "木工の講座にひかれています。次はいつありますか。",
              "vi": "Tôi bị thu hút bởi lớp làm đồ gỗ. Buổi sau là khi nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "来月の土曜日です。",
              "vi": "Thứ Bảy tháng sau ạ."
            }
          ],
          "id": "sj-trung-34-b24-25-ex02",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "7db945c4-e544-54f7-9e07-9e3de2893d8f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xem sản phẩm sau khi hoàn tất.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どれどれ、焼き上がりはどうかな。",
              "vi": "Để xem nào, nung xong trông thế nào nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "色がきれいに出たね。",
              "vi": "Màu lên đẹp đấy."
            }
          ],
          "id": "sj-trung-34-b24-25-ex03",
          "topic_uid": "2d4648f8-23ae-52be-b0f5-461fb397336a",
          "situation_uid": "41ebc57d-8065-5fab-8819-c127fd059ed3"
        }
      ]
    }
  ]
}
