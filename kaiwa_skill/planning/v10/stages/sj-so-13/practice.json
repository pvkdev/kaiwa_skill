{
  "stage_uid": "bb7273ba-ef7e-5ae4-9113-e4f1ef8e3f4a",
  "items": [
    {
      "item_id": "sj-so-13-b07-121",
      "practice": [
        {
          "id": "sj-so-13-b07-121-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6b566f8f-86d4-5f86-9885-c7012e5e0eec",
          "situation_uid": "324d243f-e54e-505e-bdb0-e267a35443ec",
          "context_vi": "Người đi cùng hoảng khi thấy bạn ngã.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi cùng",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người giúp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "友達が倒れた！ どうしよう。",
              "vi": "Bạn tôi ngã rồi! Làm sao bây giờ?"
            },
            {
              "speaker_id": "B",
              "ja": "落ち着いてください。私は助けを呼びます。",
              "vi": "Xin chị bình tĩnh. Tôi sẽ gọi người giúp."
            }
          ]
        },
        {
          "id": "sj-so-13-b07-121-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6b566f8f-86d4-5f86-9885-c7012e5e0eec",
          "situation_uid": "56408789-f5b7-549d-a9ef-b7352fa863f3",
          "context_vi": "Người gọi hỗ trợ hoảng nên nói không rõ vị trí.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người hỗ trợ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今どこにいるか、うまく言えません。",
              "vi": "Tôi không nói rõ được đang ở đâu."
            },
            {
              "speaker_id": "B",
              "ja": "落ち着いてください。駅の出口の名前を見てください。",
              "vi": "Xin anh bình tĩnh. Hãy nhìn tên cửa ra của ga."
            }
          ]
        },
        {
          "id": "sj-so-13-b07-121-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c34eaae5-2700-50ae-87e2-eac5fc56a05f",
          "situation_uid": "3b8e5538-973b-5dca-9a49-fd942e0df6b4",
          "context_vi": "Người chứng kiến hoảng khi phải trả lời nhiều câu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người chứng kiến",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người hỗ trợ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、何から話せばいいかわかりません。",
              "vi": "Xin lỗi, tôi không biết nên nói từ đâu."
            },
            {
              "speaker_id": "B",
              "ja": "落ち着いてください。一つずつ聞きます。",
              "vi": "Xin chị bình tĩnh. Tôi sẽ hỏi từng việc một."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-13-b07-128",
      "practice": [
        {
          "id": "sj-so-13-b07-128-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6b566f8f-86d4-5f86-9885-c7012e5e0eec",
          "situation_uid": "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c",
          "context_vi": "Người đã tới chỗ an toàn được dặn báo thay đổi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người hỗ trợ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người gọi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "何かあったらすぐ言ってください。",
              "vi": "Có chuyện gì thay đổi thì báo ngay cho tôi nhé."
            },
            {
              "speaker_id": "B",
              "ja": "はい。今は安全な場所にいます。",
              "vi": "Vâng. Giờ tôi đang ở nơi an toàn."
            }
          ]
        },
        {
          "id": "sj-so-13-b07-128-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6b566f8f-86d4-5f86-9885-c7012e5e0eec",
          "situation_uid": "58b8bfef-513b-5021-b8e3-2ee9ead0d850",
          "context_vi": "Một người ra đón lực lượng hỗ trợ ở cửa ga.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhờ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người đón",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "何かあったらすぐ電話してください。私は中にいます。",
              "vi": "Có chuyện gì thì gọi cho tôi ngay nhé. Tôi ở bên trong."
            },
            {
              "speaker_id": "B",
              "ja": "わかりました。入口で待ちます。",
              "vi": "Tôi biết rồi. Tôi sẽ đợi ở cửa."
            }
          ]
        },
        {
          "id": "sj-so-13-b07-128-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c34eaae5-2700-50ae-87e2-eac5fc56a05f",
          "situation_uid": "ce0c42be-43a1-586a-80a4-febe840b92b3",
          "context_vi": "Người tiếp nhận thống nhất cách liên lạc an toàn về sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người tiếp nhận",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người báo",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "何かあったら、この番号に電話してください。",
              "vi": "Nếu có chuyện gì, chị gọi số này nhé."
            },
            {
              "speaker_id": "B",
              "ja": "はい。番号を控えました。",
              "vi": "Vâng. Tôi đã ghi lại số."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-13-b07-168",
      "practice": [
        {
          "id": "sj-so-13-b07-168-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6b566f8f-86d4-5f86-9885-c7012e5e0eec",
          "situation_uid": "797bdfe1-e8e6-510d-a9fd-136c002b5325",
          "context_vi": "Người học thấy khói và nhắc người bên cạnh tránh lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phát hiện",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người bên cạnh",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "煙が出ています。近づかないで、気を付けてください。",
              "vi": "Có khói. Đừng lại gần, chị cẩn thận nhé."
            },
            {
              "speaker_id": "B",
              "ja": "わかりました。こちらへ離れます。",
              "vi": "Tôi biết rồi. Tôi sẽ tránh sang phía này."
            }
          ]
        },
        {
          "id": "sj-so-13-b07-168-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6b566f8f-86d4-5f86-9885-c7012e5e0eec",
          "situation_uid": "d966bf21-597d-57fe-a1fe-ef39dcc3a907",
          "context_vi": "Lối đi cũ đóng, người học nhắc người đến giúp đừng vào nhầm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người đến hỗ trợ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この入口は閉まっています。入らないように気を付けてください。",
              "vi": "Lối này đóng rồi. Anh cẩn thận, đừng đi vào nhầm nhé."
            },
            {
              "speaker_id": "B",
              "ja": "わかりました。別の入口に回ります。",
              "vi": "Rõ rồi. Tôi vòng sang lối khác."
            }
          ]
        },
        {
          "id": "sj-so-13-b07-168-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c34eaae5-2700-50ae-87e2-eac5fc56a05f",
          "situation_uid": "211640c0-caf4-54eb-bad9-547c532b3133",
          "context_vi": "Người tiếp nhận nhắc người báo ở chỗ an toàn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người tiếp nhận",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người báo",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "外に出ないでください。近くに人がいますから、気を付けてください。",
              "vi": "Chị đừng ra ngoài. Có người ở gần đó, hãy cẩn thận."
            },
            {
              "speaker_id": "B",
              "ja": "はい、ここで待ちます。",
              "vi": "Vâng, tôi sẽ đợi ở đây."
            }
          ]
        }
      ]
    }
  ]
}
