{
  "stage_uid": "1affdd5b-12f2-5caa-a761-be7bc363572c",
  "items": [
    {
      "item_id": "sj-thuong-17-b20-3210",
      "practice": [
        {
          "id": "sj-thuong-17-b20-3210-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "59f799ad-782c-5a27-b414-6aec62810011",
          "context_vi": "Kiểm báo cáo gốc về số người dùng công cụ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người trình bày",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "報告書では、利用者数が四月から六月まで右肩上がりです。対象は国内だけです。",
              "vi": "Theo báo cáo, số người dùng tăng đều từ tháng Tư đến tháng Sáu. Phạm vi chỉ trong nước."
            },
            {
              "speaker_id": "B",
              "ja": "海外の数字とは分けて見るべきですね。",
              "vi": "Vậy nên xem riêng số ở nước ngoài."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b20-3210-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "b5c5092d-0cb3-56a0-b9e8-556b5324d8ec",
          "context_vi": "Bạn khái quát từ một hóa đơn tăng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nghe",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người trình bày",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この一か月で、すべての物価が右肩上がりだね。",
              "vi": "Chỉ một tháng mà mọi giá cả đều tăng đều nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "この請求書だけでは分からないよ。右肩上がりか、数か月分を見よう。",
              "vi": "Chỉ một hóa đơn thì chưa biết. Ta xem số liệu vài tháng để biết có tăng đều không."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b20-3210-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2814e8ec-c872-5f1b-8477-9737d2fc30eb",
          "situation_uid": "377821de-e2ad-5e70-b905-5caf50ec4134",
          "context_vi": "Báo kết quả thử phương pháp học mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn học",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Giảng viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "六週間の記録では、正答率が右肩上がりでした。まだ一人分の結果ですが。",
              "vi": "Trong sáu tuần ghi lại, tỷ lệ trả lời đúng tăng đều. Nhưng mới là kết quả của một người thôi ạ."
            },
            {
              "speaker_id": "B",
              "ja": "その限定も発表に入れてください。",
              "vi": "Hãy nêu cả giới hạn đó trong bài trình bày."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-17-b20-3231",
      "practice": [
        {
          "id": "sj-thuong-17-b20-3231-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "2298a2ec-8545-55f6-bc5b-67ad6935bbc7",
          "context_vi": "Người nói thấy giá mặt hàng tăng nhanh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người trình bày",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "近所の店では、米の値段が三か月でうなぎ上りです。",
              "vi": "Ở cửa hàng gần nhà, giá gạo tăng vọt trong ba tháng qua."
            },
            {
              "speaker_id": "B",
              "ja": "ほかの店も同じか調べたいね。",
              "vi": "Tớ muốn xem cửa hàng khác có vậy không."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b20-3231-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "3845818e-73de-5d96-8bfa-ede9e87a8e05",
          "context_vi": "Tách dự báo tăng giá khỏi mức đã xảy ra.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nghe",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người trình bày",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来年も値段がうなぎ上りになるんだね。",
              "vi": "Vậy năm sau giá cũng sẽ tăng vọt nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "それは予測です。うなぎ上りだったのは今年の三月までの実績です。",
              "vi": "Đó là dự báo. Số liệu thực tế tăng vọt chỉ tới tháng Ba năm nay."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b20-3231-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2814e8ec-c872-5f1b-8477-9737d2fc30eb",
          "situation_uid": "377821de-e2ad-5e70-b905-5caf50ec4134",
          "context_vi": "Trong nghiên cứu, số lượt truy cập thử nghiệm tăng nhanh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn học",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Giảng viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "公開直後の二週間、閲覧数がうなぎ上りでした。ただ、その後は落ち着いています。",
              "vi": "Hai tuần ngay sau khi công bố, lượt xem tăng vọt. Sau đó thì đã ổn định lại ạ."
            },
            {
              "speaker_id": "B",
              "ja": "その違いを図で示しましょう。",
              "vi": "Hãy thể hiện sự khác biệt đó bằng biểu đồ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-17-b20-3250",
      "practice": [
        {
          "id": "sj-thuong-17-b20-3250-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "59f799ad-782c-5a27-b414-6aec62810011",
          "context_vi": "Xem dữ liệu sáu tháng về đăng ký dịch vụ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người trình bày",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "登録数は三月まで増えましたが、四月から頭打ちです。減少はしていません。",
              "vi": "Số đăng ký tăng tới tháng Ba rồi chững lại từ tháng Tư. Nó chưa giảm."
            },
            {
              "speaker_id": "B",
              "ja": "なるほど、横ばいですね。",
              "vi": "Ra vậy, đang đi ngang nhỉ."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b20-3250-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "3f59e324-dca1-5cd6-8e23-7ba4a6891aa5",
          "context_vi": "Sau khi kiểm nguồn, sửa lời nói quá mức.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nghe",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người trình bày",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "利用者が減り始めたって聞いたよ。",
              "vi": "Tớ nghe số người dùng bắt đầu giảm."
            },
            {
              "speaker_id": "B",
              "ja": "元の表では頭打ちです。増えていませんが、減ってもいません。",
              "vi": "Bảng gốc cho thấy số đó chững lại. Không tăng, nhưng cũng chưa giảm."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b20-3250-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2814e8ec-c872-5f1b-8477-9737d2fc30eb",
          "situation_uid": "f131d044-82bf-597b-869b-8d49005cb5d1",
          "context_vi": "Báo phần chắc và phần còn mở của kết quả.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn học",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Giảng viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前半は伸びましたが、後半は頭打ちです。理由はまだ調べています。",
              "vi": "Nửa đầu tăng, nửa sau chững lại. Em vẫn đang tìm nguyên nhân."
            },
            {
              "speaker_id": "B",
              "ja": "結論を急がずに進めましょう。",
              "vi": "Ta cứ tiếp tục, chưa cần vội kết luận."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-17-b20-3292",
      "practice": [
        {
          "id": "sj-thuong-17-b20-3292-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "38b5e99c-3a58-59ac-ae8c-72afe2f7cd01",
          "context_vi": "Nêu lợi ích công cụ và giới hạn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người trình bày",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "入力を自動化できたのは追い風です。ただ、最終判断は人が確認する必要があります。",
              "vi": "Việc tự động hóa nhập liệu là một thuận lợi. Nhưng quyết định cuối vẫn cần con người kiểm tra."
            },
            {
              "speaker_id": "B",
              "ja": "その条件なら試せそうです。",
              "vi": "Nếu vậy thì có thể thử."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b20-3292-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "6addc0b7-2adb-534f-b9c1-4d9cee3c8071",
          "context_vi": "Nói điều kiện thuận lợi cho một nhóm mà không khái quát.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người trình bày",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "補助制度は小規模事業者には追い風です。一方で、対象外の人の負担も見たいです。",
              "vi": "Chính sách hỗ trợ tạo thuận lợi cho doanh nghiệp nhỏ. Đồng thời tôi muốn xem gánh nặng của người không thuộc diện."
            },
            {
              "speaker_id": "B",
              "ja": "対象を分けて見ましょう。",
              "vi": "Ta tách các nhóm ra xem."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b20-3292-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2814e8ec-c872-5f1b-8477-9737d2fc30eb",
          "situation_uid": "377821de-e2ad-5e70-b905-5caf50ec4134",
          "context_vi": "Nguồn dữ liệu mở giúp nghiên cứu tiến nhanh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn học",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Giảng viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "資料が公開されたのは研究の追い風になりました。ただ、結論は再検証が必要です。",
              "vi": "Việc công bố tư liệu đã giúp nghiên cứu thuận lợi hơn. Nhưng kết luận vẫn cần kiểm chứng lại."
            },
            {
              "speaker_id": "B",
              "ja": "再検証の方法も説明してください。",
              "vi": "Hãy giải thích cả cách kiểm chứng lại."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-17-b20-3311",
      "practice": [
        {
          "id": "sj-thuong-17-b20-3311-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "6addc0b7-2adb-534f-b9c1-4d9cee3c8071",
          "context_vi": "Giá nguyên liệu gây bất lợi cho hộ kinh doanh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người trình bày",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "原材料費の上昇は小さな店には逆風です。売上の変化も別に確認したいです。",
              "vi": "Giá nguyên liệu tăng là bất lợi cho cửa hàng nhỏ. Tôi cũng muốn kiểm riêng biến động doanh thu."
            },
            {
              "speaker_id": "B",
              "ja": "一つの原因だけで決めつけないほうがいいね。",
              "vi": "Đúng là không nên quy hết cho một nguyên nhân."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b20-3311-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "95395303-758a-5abd-b1e4-fa6de5cffe73",
          "context_vi": "Chưa có báo cáo gốc, hoãn khẳng định nguyên nhân.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nghe",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người trình bày",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "新しい規制が逆風になったんだろうね。",
              "vi": "Có lẽ quy định mới gây bất lợi nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "逆風かもしれませんが、元の報告を読んでから判断しましょう。",
              "vi": "Có thể là bất lợi, nhưng hãy đọc báo cáo gốc rồi hãy kết luận."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b20-3311-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2814e8ec-c872-5f1b-8477-9737d2fc30eb",
          "situation_uid": "39036a2b-b102-5b47-805a-7c639f24f0e5",
          "context_vi": "Phương pháp học bị hạn chế khi nguồn không đủ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn học",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Giảng viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "資料が少ないことが逆風になっています。方法を変えたほうがよいでしょうか。",
              "vi": "Việc thiếu tư liệu đang gây bất lợi. Em có nên đổi phương pháp không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "まず使える資料を整理しましょう。",
              "vi": "Trước hết hãy sắp lại những tư liệu đang dùng được."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-17-b24-3440",
      "practice": [
        {
          "id": "sj-thuong-17-b24-3440-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "744c0ab6-4503-569c-ad10-32a438a526b2",
          "situation_uid": "71a701b4-9f69-5f3b-9eba-b3fe83560fd5",
          "context_vi": "Người nghe tưởng công cụ luôn đúng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nghe",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người trình bày",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この結果なら、全部任せても大丈夫？",
              "vi": "Nếu ra kết quả này, giao hết cho công cụ được không?"
            },
            {
              "speaker_id": "B",
              "ja": "それは微妙です。例外で間違いが出ないか、まず十件確認しましょう。",
              "vi": "Điều đó khó nói. Hãy kiểm trước mười trường hợp xem có sai ở ngoại lệ không."
            }
          ]
        },
        {
          "id": "sj-thuong-17-b24-3440-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2814e8ec-c872-5f1b-8477-9737d2fc30eb",
          "situation_uid": "a6f3c5b1-da4a-5ef9-8c80-eefede4c2e9b",
          "context_vi": "Chưa đủ dữ liệu cho kết luận nghiên cứu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Giảng viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn học",
              "gender": "male"
            }
          ],
