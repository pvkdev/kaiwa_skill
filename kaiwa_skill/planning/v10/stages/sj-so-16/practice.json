{
  "stage_uid": "2c23717e-838d-5ad8-a842-e7139a4dadd7",
  "items": [
    {
      "item_id": "sj-so-16-b07-37",
      "practice": [
        {
          "id": "sj-so-16-b07-37-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "8b1731e9-9a10-5ef6-a9ff-6bad6997dbb8",
          "context_vi": "Bạn kể mình lo vì buổi phỏng vấn sắp tới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "面接で何を聞かれるか心配なんだ。",
              "vi": "Tớ lo không biết buổi phỏng vấn sẽ hỏi gì."
            },
            {
              "speaker_id": "B",
              "ja": "それは大変だね。どの質問が一番気になる？",
              "vi": "Thế thì căng thẳng nhỉ. Cậu lo câu hỏi nào nhất?"
            }
          ]
        },
        {
          "id": "sj-so-16-b07-37-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31",
          "context_vi": "Bạn nói muốn kể chuyện khó ở trường.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は授業でうまく話せなくてさ。",
              "vi": "Hôm nay trong lớp tớ nói không trôi chảy."
            },
            {
              "speaker_id": "B",
              "ja": "大変だったね。話したいなら聞くよ。",
              "vi": "Vất vả rồi nhỉ. Nếu cậu muốn kể, tớ nghe."
            }
          ]
        },
        {
          "id": "sj-so-16-b07-37-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "77e92c16-cdf2-5d46-ac8b-a4acd4f7f556",
          "context_vi": "Bạn kể buổi đầu đi học có quá nhiều điều mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初日は教室も人の名前も覚えることが多かったよ。",
              "vi": "Ngày đầu phải nhớ cả phòng học lẫn tên mọi người, nhiều thứ quá."
            },
            {
              "speaker_id": "B",
              "ja": "それは大変だったね。",
              "vi": "Vậy thì vất vả thật nhỉ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-16-b24-65",
      "practice": [
        {
          "id": "sj-so-16-b24-65-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "cf45da0d-28a5-5cd5-a639-7a85e527fb91",
          "context_vi": "Sau buổi phỏng vấn, bạn hỏi người kia đã bình tâm chưa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người đi phỏng vấn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "面接が終わって、少しは落ち着いた？",
              "vi": "Phỏng vấn xong, cậu bình tâm lại chút nào chưa?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、今は少し楽になった。",
              "vi": "Ừ, giờ tớ thấy dễ chịu hơn chút rồi."
            }
          ]
        },
        {
          "id": "sj-so-16-b24-65-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31",
          "context_vi": "Sau khi nghe bạn tâm sự, người học hỏi cảm giác hiện tại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nghe",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "話して、少し落ち着いた？",
              "vi": "Kể ra rồi, cậu thấy bình tâm hơn chút nào chưa?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、ありがとう。",
              "vi": "Ừ, cảm ơn cậu."
            }
          ]
        },
        {
          "id": "sj-so-16-b24-65-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "77e92c16-cdf2-5d46-ac8b-a4acd4f7f556",
          "context_vi": "Người học hỏi sau ngày đầu đi học nhiều lo lắng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người hỏi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "学校から帰って、もう落ち着いた？",
              "vi": "Về từ trường rồi, cậu đã bình tâm lại chưa?"
            },
            {
              "speaker_id": "B",
              "ja": "うん。明日はもう少し気楽に行けそう。",
              "vi": "Ừ. Mai chắc tớ đi với tâm trạng thoải mái hơn."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-16-b24-66",
      "practice": [
        {
          "id": "sj-so-16-b24-66-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31",
          "context_vi": "Bạn được lắng nghe và nói đầu óc đã nhẹ hơn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nghe",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "話してみて、どう？",
              "vi": "Kể ra rồi, cậu thấy sao?"
            },
            {
              "speaker_id": "B",
              "ja": "少しすっきりした。聞いてくれてありがとう。",
              "vi": "Tớ thấy nhẹ lòng hơn chút rồi. Cảm ơn cậu đã nghe."
            }
          ]
        },
        {
          "id": "sj-so-16-b24-66-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "cf45da0d-28a5-5cd5-a639-7a85e527fb91",
          "context_vi": "Bạn đã biết kết quả phỏng vấn và hết băn khoăn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người đi phỏng vấn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "結果を聞いて、どうだった？",
              "vi": "Nghe kết quả rồi, cậu thấy sao?"
            },
            {
              "speaker_id": "B",
              "ja": "残念だったけど、待つ不安はなくなってすっきりしたよ。",
              "vi": "Tuy tiếc, nhưng không còn lo vì phải chờ, tớ thấy nhẹ đầu hơn."
            }
          ]
        },
        {
          "id": "sj-so-16-b24-66-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a274fb72-1934-5329-93da-2be8b08cdc7d",
          "situation_uid": "45a86827-63cd-5bca-ab09-8ed13040c82b",
          "context_vi": "Bạn kể xong chuyện hiểu nhầm và thấy rõ hơn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "話してみて、何が起きたかわかったよ。",
              "vi": "Kể ra rồi tớ mới hiểu chuyện gì đã xảy ra."
            },
            {
              "speaker_id": "B",
              "ja": "うん、私もすっきりした。",
              "vi": "Ừ, tớ cũng thấy rõ ràng hơn."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-16-b11-1",
      "practice": [
        {
          "id": "sj-so-16-b11-1-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31",
          "context_vi": "Người học nghe bạn kể và công nhận buổi đó khó.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先生の前で言葉が出なかった。",
              "vi": "Đứng trước cô, tớ chẳng nói được lời nào."
            },
            {
              "speaker_id": "B",
              "ja": "それは緊張したね。",
              "vi": "Hẳn là cậu hồi hộp lắm nhỉ."
            }
          ]
        },
        {
          "id": "sj-so-16-b11-1-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "b464414d-75a2-595f-9fab-76e3874a1ad6",
          "context_vi": "Hai bạn hẹn ngày khác để luyện nói.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は無理だけど、明日なら練習できる。",
              "vi": "Hôm nay tớ không luyện được, nhưng mai thì được."
            },
            {
              "speaker_id": "B",
              "ja": "じゃ、明日の三時だね。",
              "vi": "Vậy ba giờ chiều mai nhé."
            }
          ]
        },
        {
          "id": "sj-so-16-b11-1-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "0b54dae9-d32d-573d-afaa-57ac8343bc3f",
          "context_vi": "Bạn không cần người đi cùng nữa, người kia xác nhận nhẹ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一人で行けそうだから、付き添いは大丈夫。",
              "vi": "Chắc tớ tự đi được, không cần ai đi cùng nữa."
            },
            {
              "speaker_id": "B",
              "ja": "わかった。無理しないでね。",
              "vi": "Tớ biết rồi. Đừng cố quá nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-16-b07-124",
      "practice": [
        {
          "id": "sj-so-16-b07-124-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "42d25d3c-be5d-58b2-ad46-da319a77c4b8",
          "context_vi": "Bạn xin lỗi vì không đi ăn mừng được, người mời không phiền.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người mời",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ごめん、今日は一緒に行けない。",
              "vi": "Xin lỗi, hôm nay tớ không đi cùng được."
            },
            {
              "speaker_id": "B",
              "ja": "大丈夫。気にしないで。また別の日にしよう。",
              "vi": "Không sao. Đừng bận tâm. Để hôm khác nhé."
            }
          ]
        },
        {
          "id": "sj-so-16-b07-124-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "5922597c-1945-5354-aec7-a1896ee6d2b3",
          "context_vi": "Bạn xin lỗi vì đã kể lộn xộn, người nghe thấy không sao.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ごめん、話がわかりにくかったよね。",
              "vi": "Xin lỗi, tớ kể khó hiểu quá nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "気にしないで。もう一度ゆっくり聞くよ。",
              "vi": "Đừng bận tâm. Tớ sẽ nghe lại từ đầu, chậm rãi nhé."
            }
          ]
        },
        {
          "id": "sj-so-16-b07-124-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bc7f65fa-332c-58c4-bde3-f2588a1a57d0",
          "situation_uid": "d4c0e198-ab35-5bbe-9cac-a296254199c1",
          "context_vi": "Bạn nghĩ mình đã báo tin đỗ quá sớm, người kia trấn an.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まだ結果が出ていないのに、期待させてごめん。",
              "vi": "Chưa có kết quả mà tớ làm cậu kỳ vọng, xin lỗi nhé."
            },
            {
              "speaker_id": "B",
              "ja": "気にしないで。結果が出てから一緒に考えよう。",
              "vi": "Đừng bận tâm. Có kết quả rồi mình cùng tính."
            }
          ]
        }
      ]
    }
  ]
}
