{
  "stage_uid": "e2e46870-43c8-5f93-b36a-70457d46c0b6",
  "items": [
    {
      "item_id": "sj-trung-17-b11-61",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi ưu tiên học trong tháng đầu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "最初に何を覚えればいいか、ちょっとお聞きしたいんですが。",
              "vi": "Tôi muốn hỏi lúc đầu nên học việc gì trước ạ."
            },
            {
              "speaker_id": "B",
              "ja": "まず社内システムから覚えてください。",
              "vi": "Trước hết hãy học hệ thống nội bộ."
            }
          ],
          "id": "sj-trung-17-b11-61-ex01",
          "topic_uid": "106854a6-346f-55ab-a972-b52340cce5ae",
          "situation_uid": "6cb305c0-d5e6-5248-bd55-c082ed5ea11a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Không hiểu một từ nội bộ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Mentor",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、その言葉の意味がまだ分からないんですけど。",
              "vi": "Xin lỗi, tôi vẫn chưa hiểu nghĩa của từ đó ạ."
            },
            {
              "speaker_id": "B",
              "ja": "具体例で説明しますね。",
              "vi": "Tôi sẽ giải thích bằng ví dụ nhé."
            }
          ],
          "id": "sj-trung-17-b11-61-ex02",
          "topic_uid": "106854a6-346f-55ab-a972-b52340cce5ae",
          "situation_uid": "5f3b4837-7fb5-5d0a-9edb-a56bfec4bfa0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi mốc tự xử lý hay báo lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どこまで自分で判断していいか、確認したいんですが。",
              "vi": "Tôi muốn xác nhận mình được tự quyết đến mức nào ạ."
            },
            {
              "speaker_id": "B",
              "ja": "金額が変わる場合は相談してください。",
              "vi": "Nếu số tiền thay đổi thì hãy hỏi tôi."
            }
          ],
          "id": "sj-trung-17-b11-61-ex03",
          "topic_uid": "106854a6-346f-55ab-a972-b52340cce5ae",
          "situation_uid": "060f25d0-6838-56de-b33c-b0273dc3ff04"
        }
      ]
    },
    {
      "item_id": "sj-trung-17-b20-23",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Mentor giải thích rất kỹ thao tác mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Mentor",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一つずつ、手とり足とり教えていただいて助かりました。",
              "vi": "Cảm ơn chị đã cầm tay chỉ việc từng bước, tôi rất được giúp đỡ."
            },
            {
              "speaker_id": "B",
              "ja": "次は一人で試してみましょう。",
              "vi": "Lần sau anh thử tự làm nhé."
            }
          ],
          "id": "sj-trung-17-b20-23-ex01",
          "topic_uid": "106854a6-346f-55ab-a972-b52340cce5ae",
          "situation_uid": "5f3b4837-7fb5-5d0a-9edb-a56bfec4bfa0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Leader sắp người hướng dẫn cho việc nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Leader",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初めは先輩が手とり足とり教えます。",
              "vi": "Ban đầu người đi trước sẽ hướng dẫn từng bước."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。まず流れを覚えます。",
              "vi": "Cảm ơn chị. Tôi sẽ học quy trình trước."
            }
          ],
          "id": "sj-trung-17-b20-23-ex02",
          "topic_uid": "106854a6-346f-55ab-a972-b52340cce5ae",
          "situation_uid": "9c680dfe-19ad-54d1-87af-37f2b6c08cfb"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhìn lại tuần đầu nhận việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "最初は手とり足とり教わりましたが、今は一人で入力できます。",
              "vi": "Lúc đầu tôi được hướng dẫn từng bước, giờ tôi tự nhập liệu được rồi."
            },
            {
              "speaker_id": "B",
              "ja": "いいですね。次の仕事もお願いしましょう。",
              "vi": "Tốt lắm. Vậy giao việc tiếp theo nhé."
            }
          ],
          "id": "sj-trung-17-b20-23-ex03",
          "topic_uid": "106854a6-346f-55ab-a972-b52340cce5ae",
          "situation_uid": "6bce5198-ee7e-5ec2-9c29-06d0ca6eadbb"
        }
      ]
    },
    {
      "item_id": "sj-trung-17-b07-115",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Leader giao việc nhỏ đầu tiên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Leader",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この一覧の確認をお願いできますか。",
              "vi": "Anh kiểm giúp danh sách này được không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、任せてください。終わったら報告します。",
              "vi": "Vâng, cứ giao cho tôi. Xong tôi sẽ báo lại."
            }
          ],
          "id": "sj-trung-17-b07-115-ex01",
          "topic_uid": "106854a6-346f-55ab-a972-b52340cce5ae",
          "situation_uid": "9c680dfe-19ad-54d1-87af-37f2b6c08cfb"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Mentor vắng, cần người nhận câu hỏi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "午後は先輩がいないけど、大丈夫？",
              "vi": "Chiều nay người hướng dẫn vắng, anh ổn chứ?"
            },
            {
              "speaker_id": "B",
              "ja": "基本の入力は任せてください。分からない点は担当の方に確認します。",
              "vi": "Phần nhập liệu cơ bản cứ giao cho tôi. Chỗ nào chưa rõ tôi sẽ hỏi người phụ trách."
            }
          ],
          "id": "sj-trung-17-b07-115-ex02",
          "topic_uid": "106854a6-346f-55ab-a972-b52340cce5ae",
          "situation_uid": "657b6287-cd68-5bb9-8cc0-251aa50808f6"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Muốn nhận thêm kỹ năng ở dự án sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "次の資料作成、よければ任せてください。",
              "vi": "Lần soạn tài liệu tới, nếu được xin giao cho tôi."
            },
            {
              "speaker_id": "B",
              "ja": "では、まず下書きをお願いします。",
              "vi": "Vậy trước hết anh làm bản nháp nhé."
            }
          ],
          "id": "sj-trung-17-b07-115-ex03",
          "topic_uid": "106854a6-346f-55ab-a972-b52340cce5ae",
          "situation_uid": "2e6c729f-cef6-5b74-8813-715dd0589aa7"
        }
      ]
    }
  ]
}
