{
  "stage_uid": "d7b2ec42-2303-5fba-b7ad-4e126cd8192b",
  "items": [
    {
      "item_id": "sj-thuong-13-b12-192",
      "practice": [
        {
          "id": "sj-thuong-13-b12-192-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b65cde5f-f597-5944-a5eb-ac4dc00da449",
          "situation_uid": "86f5f8fe-5a20-5ca3-ac24-180e17454bf6",
          "context_vi": "Bạn đời tưởng đã quyết đổi nhà.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn đời",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もう引っ越すと決めたんだね。",
              "vi": "Vậy em đã quyết chuyển nhà rồi nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "決めたというか、まず通勤がどれくらい楽になるか知りたいの。",
              "vi": "Nói là đã quyết thì chưa đúng; em muốn biết trước việc đi làm sẽ nhẹ hơn bao nhiêu."
            },
            {
              "speaker_id": "A",
              "ja": "分かった。一緒に調べよう。",
              "vi": "Anh hiểu. Ta cùng tìm hiểu."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b12-192-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3cbdb697-395a-5147-b8f0-1bdeae58aba2",
          "situation_uid": "19eda502-1a65-5175-82e6-b98f06599a0e",
          "context_vi": "Tìm từ để nói cảm giác xa cách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "寂しいというか、最近は話を最後まで聞いてもらえていない感じがする。",
              "vi": "Nói là buồn thì chưa hẳn; gần đây tớ có cảm giác mình chưa được nghe hết lời."
            },
            {
              "speaker_id": "B",
              "ja": "そう感じたのはいつ？",
              "vi": "Cậu cảm thấy vậy khi nào?"
            }
          ]
        },
        {
          "id": "sj-thuong-13-b12-192-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2eda52a1-5314-5def-bf50-f6e5d313b877",
          "situation_uid": "4d8fd670-d8da-5272-bef1-48721b26fff5",
          "context_vi": "Hai người có cùng dữ kiện nhưng khác ưu tiên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "反対というか、私は時間より安全を優先したいんだ。",
              "vi": "Nói phản đối thì không hẳn; tớ muốn ưu tiên an toàn hơn thời gian."
            },
            {
              "speaker_id": "B",
              "ja": "なるほど。優先順位が違うんだね。",
              "vi": "Ra vậy. Ta khác thứ tự ưu tiên."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-13-b11-2850",
      "practice": [
        {
          "id": "sj-thuong-13-b11-2850-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b65cde5f-f597-5944-a5eb-ac4dc00da449",
          "situation_uid": "d8c72a69-56a4-5643-a07e-8655ef21b5ac",
          "context_vi": "Chưa chắc chuyển nhà sẽ giúp gia đình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn đời",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "駅に近い家なら、みんなの負担が少し減る気がする。どう思う？",
              "vi": "Em có cảm giác nhà gần ga sẽ giảm bớt gánh nặng cho cả nhà. Anh nghĩ sao?"
            },
            {
              "speaker_id": "B",
              "ja": "家賃も一緒に見よう。",
              "vi": "Ta xem cả tiền thuê nhé."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b11-2850-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3cbdb697-395a-5147-b8f0-1bdeae58aba2",
          "situation_uid": "81961426-4e00-53cd-8bbf-b7004b2442f1",
          "context_vi": "Kể chuyện khó ngủ mà chưa tự chẩn đoán.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn thân",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "最近、眠りが浅くなった気がする。まだ原因は分からないんだけど。",
              "vi": "Gần đây tớ cảm thấy ngủ không sâu. Tớ vẫn chưa biết nguyên nhân."
            },
            {
              "speaker_id": "B",
              "ja": "そうなんだ。話したいことがあれば聞くよ。",
              "vi": "Vậy à. Nếu muốn nói thì tớ nghe."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b11-2850-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2eda52a1-5314-5def-bf50-f6e5d313b877",
          "situation_uid": "890f43dd-6a3b-5067-9ead-550a8b73692f",
          "context_vi": "Sau bất đồng, nói điều học từ góc nhìn người kia.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨日の話、どうだった？",
              "vi": "Chuyện hôm qua, cậu thấy sao?"
            },
            {
              "speaker_id": "B",
              "ja": "あなたの話を聞いて、私が急ぎすぎていた気がする。",
              "vi": "Nghe cậu nói, tớ có cảm giác mình đã vội quá."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-13-b24-3020",
      "practice": [
        {
          "id": "sj-thuong-13-b24-3020-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b65cde5f-f597-5944-a5eb-ac4dc00da449",
          "situation_uid": "97849a07-9edf-5d22-9807-d67bc65739a1",
          "context_vi": "Con không thích phương án người lớn nghĩ hộ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Mẹ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Con trai",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この学校、いいと思っていたけど、あなたにはなんか違う？",
              "vi": "Mẹ nghĩ trường này tốt, nhưng với con thì có gì đó chưa đúng ý à?"
            },
            {
              "speaker_id": "B",
              "ja": "うん。部活を続けられるか心配。",
              "vi": "Dạ. Con lo không tiếp tục câu lạc bộ được."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b24-3020-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3cbdb697-395a-5147-b8f0-1bdeae58aba2",
          "situation_uid": "19eda502-1a65-5175-82e6-b98f06599a0e",
          "context_vi": "Nói cảm giác trong một cuộc gặp gần đây.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先週の食事、なんか違うと感じた。会っていたのに、ずっと仕事の電話だったから。",
              "vi": "Bữa ăn tuần trước tớ thấy có gì đó không ổn. Mình gặp nhau mà cậu cứ nghe điện thoại công việc."
            },
            {
              "speaker_id": "B",
              "ja": "そうだったね。ごめん。",
              "vi": "Đúng vậy. Tớ xin lỗi."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b24-3020-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2eda52a1-5314-5def-bf50-f6e5d313b877",
          "situation_uid": "6b54a53e-eeb8-50d4-b4dd-5888fa2f24b4",
          "context_vi": "Bạn nói điểm chưa đúng trong phương án.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その案、なんか違うんだよね。早いけど、誰が困るか見えていない。",
              "vi": "Phương án đó có gì đó chưa ổn. Nhanh thì nhanh, nhưng chưa thấy ai sẽ gặp khó."
            },
            {
              "speaker_id": "B",
              "ja": "どの人の影響が心配？",
              "vi": "Cậu lo ảnh hưởng tới những ai?"
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-13-b24-3040",
      "practice": [
        {
          "id": "sj-thuong-13-b24-3040-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b65cde5f-f597-5944-a5eb-ac4dc00da449",
          "situation_uid": "e4275ec6-5db9-5059-81c2-acf52e51ec99",
          "context_vi": "Sửa khi người thân tưởng mình phản đối chăm sóc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người thân",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "手伝いたくないってこと？",
              "vi": "Con không muốn giúp à?"
            },
            {
              "speaker_id": "B",
              "ja": "そうじゃなくて、毎週は無理なの。月に二回なら行けるよ。",
              "vi": "Không phải vậy, tuần nào con cũng đi thì không được. Mỗi tháng hai lần thì con đi được."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b24-3040-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3cbdb697-395a-5147-b8f0-1bdeae58aba2",
          "situation_uid": "206eb305-f89e-5f9c-aa72-976e097ed106",
          "context_vi": "Bạn tưởng khó ngủ chỉ vì công việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn thân",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "仕事のストレスが原因じゃない？",
              "vi": "Có phải do căng thẳng công việc không?"
            },
            {
              "speaker_id": "B",
              "ja": "そうじゃなくて、休みの日も眠れないんだ。原因はまだ分からない。",
              "vi": "Không hẳn vậy, ngày nghỉ tớ cũng không ngủ được. Tớ vẫn chưa biết nguyên nhân."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b24-3040-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2eda52a1-5314-5def-bf50-f6e5d313b877",
          "situation_uid": "f773933f-5d11-563b-af3b-bc6269d3bcd8",
          "context_vi": "Sửa hiểu lầm rằng mình phủ nhận trải nghiệm người khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私の経験を否定しているの？",
              "vi": "Cậu đang phủ nhận trải nghiệm của tớ à?"
            },
            {
              "speaker_id": "B",
              "ja": "そうじゃなくて、あなたが大変だったのは分かる。私は次の方法を一緒に考えたいんだ。",
              "vi": "Không phải vậy. Tớ hiểu cậu đã vất vả. Tớ muốn cùng nghĩ cách làm tiếp theo."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-13-b24-3098",
      "practice": [
        {
          "id": "sj-thuong-13-b24-3098-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b65cde5f-f597-5944-a5eb-ac4dc00da449",
          "situation_uid": "faac38ae-83e7-5bd6-90c4-7ccdd6da1f07",
          "context_vi": "Thông tin từ trường khác suy đoán của gia đình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người thân",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先生は、もう学校に行きたくないと言ったそうだ。",
              "vi": "Thầy nói con đã bảo không muốn đi học nữa."
            },
            {
              "speaker_id": "B",
              "ja": "一度休みたいとは聞いたけど、ずっと行かないとは思えない。本人にも聞いてみよう。",
              "vi": "Em nghe con muốn nghỉ một hôm, nhưng em không nghĩ con muốn bỏ học hẳn. Hãy hỏi con trực tiếp."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b24-3098-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3cbdb697-395a-5147-b8f0-1bdeae58aba2",
          "situation_uid": "4bae3851-dd6f-5b74-a001-c74483fdc204",
          "context_vi": "Người kia nghĩ mình trách họ cố ý xa cách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "わざと避けていると言いたいの？",
              "vi": "Cậu muốn nói tớ cố tình tránh cậu à?"
            },
            {
              "speaker_id": "B",
              "ja": "そんなつもりだったとは思えないよ。ただ、会う時間が減って寂しかった。",
              "vi": "Tớ không nghĩ cậu cố ý. Chỉ là ít gặp nhau hơn nên tớ buồn."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b24-3098-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2eda52a1-5314-5def-bf50-f6e5d313b877",
          "situation_uid": "0e5806e2-205e-5666-9d3f-6d44d3170086",
          "context_vi": "Không nói thay ý người vắng mặt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người thân",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "彼も絶対反対だよ。",
              "vi": "Anh ấy chắc chắn cũng phản đối."
            },
            {
              "speaker_id": "B",
              "ja": "本人に聞かずに反対だとは思えない。まず直接聞こう。",
              "vi": "Chưa hỏi trực tiếp thì tớ chưa thể nghĩ anh ấy phản đối. Ta hỏi anh ấy trước nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-13-b06-1960",
      "practice": [
        {
          "id": "sj-thuong-13-b06-1960-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b65cde5f-f597-5944-a5eb-ac4dc00da449",
          "situation_uid": "d3caf642-f410-58b6-9f4b-e37f0135b3a4",
          "context_vi": "Con im lặng sau bữa tối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người thân",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は静かだね。なんかあったの？ 話したくなければ、後でもいいよ。",
              "vi": "Hôm nay con im lặng nhỉ. Có chuyện gì à? Nếu chưa muốn kể thì để sau cũng được."
            },
            {
              "speaker_id": "B",
              "ja": "今は話したくない。",
              "vi": "Giờ con chưa muốn kể."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b06-1960-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3cbdb697-395a-5147-b8f0-1bdeae58aba2",
          "situation_uid": "a7d1aaff-c21b-51d0-b675-b4015a5d16c7",
          "context_vi": "Bạn gọi bất thường để tâm sự.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn thân",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "珍しいね、この時間に電話なんて。なんかあったの？",
              "vi": "Lạ nhỉ, giờ này cậu gọi. Có chuyện gì à?"
            },
            {
              "speaker_id": "B",
              "ja": "少し話を聞いてほしくて。",
              "vi": "Tớ muốn cậu nghe một chút."
            }
          ]
        },
        {
          "id": "sj-thuong-13-b06-1960-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6fc8d22f-2efc-58b3-84c7-3f62b156cedb",
          "situation_uid": "8924eb02-5ad9-5dcf-8e65-726214306580",
