{
  "stage_uid": "ff232764-be97-5768-89a5-153290f64805",
  "items": [
    {
      "item_id": "sj-so-08-b07-88",
      "practice": [
        {
          "id": "sj-so-08-b07-88-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "6c750b19-9237-5f0f-a814-f075b42657bf",
          "context_vi": "Người học mở lời nhờ bạn giữ hộ túi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhờ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今、ちょっといいですか。この袋を五分だけ見ていてもらえますか。",
              "vi": "Bây giờ cậu có tiện không? Trông giúp tớ cái túi này năm phút được không?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、ここで待ってるよ。",
              "vi": "Ừ, tớ đợi ở đây."
            }
          ]
        },
        {
          "id": "sj-so-08-b07-88-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "1fa09ea7-04ea-5b61-9484-627b55275888",
          "context_vi": "Người đi chơi xin người khác chụp ảnh giúp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhờ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người đi đường",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、ちょっといいですか。写真を一枚お願いできますか。",
              "vi": "Xin lỗi, chị có tiện một chút không? Chụp giúp tôi một tấm ảnh được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、いいですよ。",
              "vi": "Vâng, được ạ."
            }
          ]
        },
        {
          "id": "sj-so-08-b07-88-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "faa47566-ecba-5453-bf1b-4078c1c54de7",
          "situation_uid": "00d934ff-1426-5d43-b595-95ba75e99ae2",
          "context_vi": "Người học xin phép hỏi về ổ cắm chung.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người học",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、ちょっといいですか。ここのコンセントは使えますか。",
              "vi": "Xin lỗi, tôi hỏi một chút được không ạ? Ổ cắm ở đây dùng được chứ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、一時間までなら使えます。",
              "vi": "Được ạ, nhưng tối đa một giờ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-08-b07-90",
      "practice": [
        {
          "id": "sj-so-08-b07-90-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "38599a91-33f3-5941-8a61-a9139207599b",
          "context_vi": "Bạn chỉ giữ được túi đến bốn giờ, người nhờ nói nguyện vọng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhờ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "四時までなら預かれるよ。",
              "vi": "Tớ giữ giúp đến bốn giờ được."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとう。できれば三時半に取りに来るね。",
              "vi": "Cảm ơn. Nếu được, tớ sẽ đến lấy lúc ba rưỡi."
            }
          ]
        },
        {
          "id": "sj-so-08-b07-90-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "b80fe36f-d794-5fc3-b7d0-ce5f684673db",
          "context_vi": "Người được nhờ đang vội, người học đề nghị chụp nhanh một tấm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhờ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người đi đường",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "できれば一枚だけお願いできますか。すぐ終わります。",
              "vi": "Nếu tiện, chị chụp giúp một tấm thôi được không ạ? Sẽ xong ngay."
            },
            {
              "speaker_id": "B",
              "ja": "一枚なら大丈夫です。",
              "vi": "Một tấm thì được ạ."
            }
          ]
        },
        {
          "id": "sj-so-08-b07-90-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "faa47566-ecba-5453-bf1b-4078c1c54de7",
          "situation_uid": "c2506633-da42-5e1c-8d8c-6c17a4e24801",
          "context_vi": "Người học xin đổi giờ dùng bếp nếu người kia tiện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người học",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người ở cùng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "できれば、今日だけ台所を先に使いたいんですが。",
              "vi": "Nếu tiện, riêng hôm nay cho tôi dùng bếp trước được không?"
            },
            {
              "speaker_id": "B",
              "ja": "今日はいいですよ。",
              "vi": "Hôm nay thì được."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-08-b24-23",
      "practice": [
        {
          "id": "sj-so-08-b24-23-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "da6c1107-21e6-5af8-b6b7-c9506116f35e",
          "context_vi": "Người đang bê đồ được bạn chủ động mở cửa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người bê đồ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ドア、開けるよ。",
              "vi": "Để tớ mở cửa cho."
            },
            {
              "speaker_id": "B",
              "ja": "えっ、いいんですか。助かるよ。",
              "vi": "Ơ, được à? Cảm ơn cậu, đỡ quá."
            }
          ]
        },
        {
          "id": "sj-so-08-b24-23-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "6c750b19-9237-5f0f-a814-f075b42657bf",
          "context_vi": "Bạn đề nghị giữ hộ đồ khi người kia phải đi gấp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhờ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この箱、私が見ておきますよ。",
              "vi": "Để tôi trông hộ cái hộp này nhé."
            },
            {
              "speaker_id": "B",
              "ja": "いいんですか。ありがとうございます。",
              "vi": "Thật sự được ạ? Cảm ơn anh."
            }
          ]
        },
        {
          "id": "sj-so-08-b24-23-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "faa47566-ecba-5453-bf1b-4078c1c54de7",
          "situation_uid": "e1e5302b-5f2b-5769-bd30-09cd2dc102db",
          "context_vi": "Người kia nhận lời mang giúp túi nặng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người giúp",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người mang túi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その袋、持ちましょうか。",
              "vi": "Để tôi mang giúp túi đó nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "いいんですか。じゃ、階段までお願いします。",
              "vi": "Thật sự được ạ? Vậy nhờ chị mang đến cầu thang."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-08-b24-24",
      "practice": [
        {
          "id": "sj-so-08-b24-24-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "aea2d6ec-de98-5d3c-a6a1-779b523a005b",
          "context_vi": "Bạn nhận giữ hộ món đồ đến giờ lấy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhờ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "四時までここにいるから、預かるよ。",
              "vi": "Tớ ở đây đến bốn giờ, cứ để tớ giữ cho."
            },
            {
              "speaker_id": "B",
              "ja": "そうしてもらえるとありがたいです。",
              "vi": "Nếu cậu giúp vậy thì tớ biết ơn lắm."
            }
          ]
        },
        {
          "id": "sj-so-08-b24-24-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "94978938-69e4-5cf3-8660-e1625e351aea",
          "context_vi": "Người học nhận lại túi sau khi bạn giữ hộ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhờ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "待っていてくれてありがとう。本当にありがたかったよ。",
              "vi": "Cảm ơn cậu đã đợi. Tớ thật sự biết ơn."
            },
            {
              "speaker_id": "B",
              "ja": "無事に戻ってきてよかった。",
              "vi": "Cậu quay lại được là tốt rồi."
            }
          ]
        },
        {
          "id": "sj-so-08-b24-24-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "faa47566-ecba-5453-bf1b-4078c1c54de7",
          "situation_uid": "4defb2b2-2e5f-5422-b4c0-82853642a510",
          "context_vi": "Người mang đồ nhờ bạn giữ cửa, không cần mang đồ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mang đồ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ドアだけ押さえてくれるとありがたいです。",
              "vi": "Nếu anh giữ cửa giúp thôi thì tôi rất biết ơn."
            },
            {
              "speaker_id": "B",
              "ja": "はい、どうぞ。",
              "vi": "Được, chị đi đi."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-08-b11-4",
      "practice": [
        {
          "id": "sj-so-08-b11-4-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "79a13872-f046-5d83-a742-fde342296177",
          "context_vi": "Bạn thấy người kia ôm đồ, ngỏ ý mở cửa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người giúp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người bê đồ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ドア、開けようか。",
              "vi": "Để tớ mở cửa nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、お願い。手がふさがってるの。",
              "vi": "Ừ, nhờ cậu. Hai tay tớ bận rồi."
            }
          ]
        },
        {
          "id": "sj-so-08-b11-4-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "faa47566-ecba-5453-bf1b-4078c1c54de7",
          "situation_uid": "8aad28ed-6b44-5efd-ba6c-1b5ac7d57ed0",
          "context_vi": "Người học thấy người kia mang túi nặng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người giúp",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người mang túi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その袋、持ちましょうか。",
              "vi": "Tôi mang giúp cái túi đó nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。お願いします。",
              "vi": "Cảm ơn chị. Nhờ chị giúp."
            }
          ]
        },
        {
          "id": "sj-so-08-b11-4-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "faa47566-ecba-5453-bf1b-4078c1c54de7",
          "situation_uid": "a0e81632-e98f-5900-807f-262844957a81",
          "context_vi": "Người học đề nghị mang giúp nhưng người kia tự làm được.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người giúp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người mang túi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "荷物、持ちましょうか。",
              "vi": "Tôi mang giúp hành lý nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。でも、一人で大丈夫です。",
              "vi": "Cảm ơn anh, nhưng tôi tự mang được ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-08-b11-6",
      "practice": [
        {
          "id": "sj-so-08-b11-6-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "9e76289d-0136-58e2-ba98-8d251adaa543",
          "context_vi": "Người học nói mình mới tới nên nhờ bạn chỉ đường.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mới",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初めて行く場所なんです。道を教えてもらえますか。",
              "vi": "Tớ chưa đến chỗ đó bao giờ. Cậu chỉ đường giúp tớ được không?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、駅からまっすぐだよ。",
              "vi": "Ừ, đi thẳng từ ga nhé."
            }
          ]
        },
        {
          "id": "sj-so-08-b11-6-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
          "situation_uid": "da6c1107-21e6-5af8-b6b7-c9506116f35e",
          "context_vi": "Người bê đồ giải thích vì sao cần giúp mở cửa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người bê đồ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người ở gần",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "両手がふさがっているんです。ドアを開けてもらえますか。",
              "vi": "Hai tay tôi đang bận. Chị mở cửa giúp được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、どうぞ。",
              "vi": "Được, anh đi đi."
            }
          ]
        },
        {
          "id": "sj-so-08-b11-6-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "faa47566-ecba-5453-bf1b-4078c1c54de7",
          "situation_uid": "19cecd66-6f55-54a8-b646-b2ef249de701",
          "context_vi": "Người học giải thích phòng nóng trước khi xin mở cửa sổ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người học",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người ở cùng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この部屋、少し暑いんです。窓を開けてもいいですか。",
              "vi": "Phòng này hơi nóng. Tôi mở cửa sổ được không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、いいですよ。",
              "vi": "Vâng, cứ mở đi."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-08-b07-197",
      "practice": [
        {
          "id": "sj-so-08-b07-197-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb72c7c9-57d0-51a3-9260-0dbbc625cdaa",
