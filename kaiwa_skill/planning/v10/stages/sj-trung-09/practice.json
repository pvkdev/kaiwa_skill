{
  "stage_uid": "7a06ac69-e5f6-5eea-8970-b986253b86f7",
  "items": [
    {
      "item_id": "sj-trung-09-b18-547",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi quầy phụ trách khai báo chuyển đến.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "転入の手続きはどちらの窓口でしょうか。",
              "vi": "Thủ tục đăng ký chuyển đến làm ở quầy nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "三番窓口です。",
              "vi": "Quầy số ba ạ."
            }
          ],
          "id": "sj-trung-09-b18-547-ex01",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "a3bc7691-e00c-5f12-b2de-5feee61a6e17"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi nơi nhận giấy xác nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この証明書は、後日どちらで受け取れますか。",
              "vi": "Giấy xác nhận này sau tôi nhận ở đâu ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "一階の受け取り窓口です。",
              "vi": "Ở quầy nhận giấy tầng một ạ."
            }
          ],
          "id": "sj-trung-09-b18-547-ex02",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "f1504b16-9714-53c3-ba0c-5070ed35e2a6"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai quầy dùng tên khác, hỏi người phụ trách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この変更については、どちらに確認すればよろしいですか。",
              "vi": "Về thay đổi này, tôi cần hỏi bên nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "保険の窓口にお願いします。",
              "vi": "Xin hỏi quầy bảo hiểm ạ."
            }
          ],
          "id": "sj-trung-09-b18-547-ex03",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "61ce9c5c-1d78-5323-b54f-89b34a57e0e7"
        }
      ]
    },
    {
      "item_id": "sj-trung-09-b18-269",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đưa giấy hỏi có đúng loại cần không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらの書類でよろしいでしょうか。",
              "vi": "Giấy này có đúng loại cần không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、こちらで大丈夫です。",
              "vi": "Vâng, giấy này được ạ."
            }
          ],
          "id": "sj-trung-09-b18-269-ex01",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "6e89c550-b23e-5a5f-acb4-f929a8358c2f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên chỉ quầy bảo hiểm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "住所変更の後は、こちらの保険窓口へお越しください。",
              "vi": "Sau khi đổi địa chỉ, xin qua quầy bảo hiểm bên này."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。先に住所の手続きをします。",
              "vi": "Tôi hiểu rồi. Tôi sẽ làm thủ tục địa chỉ trước."
            }
          ],
          "id": "sj-trung-09-b18-269-ex02",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "d0a0c90b-02c3-5927-a1a6-b556267e0b44"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chỉ thông tin sai trên giấy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらの部屋番号が違うようです。",
              "vi": "Số phòng ở đây có vẻ sai ạ."
            },
            {
              "speaker_id": "B",
              "ja": "確認いたします。",
              "vi": "Tôi sẽ kiểm tra."
            }
          ],
          "id": "sj-trung-09-b18-269-ex03",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "6044c790-d998-5d03-9a34-7602b7dbd334"
        }
      ]
    },
    {
      "item_id": "sj-trung-09-b06-36",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quầy chưa xác nhận ngay được và hẹn báo lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は結果が分からないんですね。",
              "vi": "Hôm nay chưa có kết quả đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。確認でき次第、追ってご連絡します。",
              "vi": "Vâng. Khi xác nhận được, chúng tôi sẽ liên lạc lại."
            }
          ],
          "id": "sj-trung-09-b06-36-ex01",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "847ce47f-485f-5f3a-8be9-d1fe8e80e942"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Không thể chờ cả ngày tại quầy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日はここで待てないのですが、結果はどう受け取れますか。",
              "vi": "Hôm nay tôi không thể chờ ở đây, vậy nhận kết quả bằng cách nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "確認後、追ってご連絡します。",
              "vi": "Sau khi kiểm tra, chúng tôi sẽ liên lạc lại ạ."
            }
          ],
          "id": "sj-trung-09-b06-36-ex02",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "f5c90336-ae77-5d97-baca-04fa1869843e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi bổ sung giấy còn thiếu, quầy hẹn báo kết quả.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "不足分を提出しました。結果はいつ分かりますか。",
              "vi": "Tôi đã nộp giấy còn thiếu. Khi nào có kết quả ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "確認して、追ってご連絡します。",
              "vi": "Chúng tôi sẽ kiểm tra rồi liên lạc lại ạ."
            }
          ],
          "id": "sj-trung-09-b06-36-ex03",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "44bf8c2c-5c81-5da0-bb12-942dd97679c3"
        }
      ]
    },
    {
      "item_id": "sj-trung-09-b07-16",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Mở lời hỏi đúng quầy thủ tục.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、ちょっとお伺いしたいんですが、転入届はこちらですか。",
              "vi": "Xin lỗi, cho tôi hỏi chút: giấy khai chuyển đến nộp ở đây phải không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、こちらです。",
              "vi": "Vâng, ở đây ạ."
            }
          ],
          "id": "sj-trung-09-b07-16-ex01",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "a3bc7691-e00c-5f12-b2de-5feee61a6e17"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi giấy nào bắt buộc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ちょっとお伺いしたいんですが、私の場合、どの書類が必要ですか。",
              "vi": "Cho tôi hỏi chút, trường hợp của tôi cần giấy tờ nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "在留カードと本人確認書類です。",
              "vi": "Thẻ lưu trú và giấy xác minh danh tính ạ."
            }
          ],
          "id": "sj-trung-09-b07-16-ex02",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "5a6684eb-12de-53b6-9c3c-36298af637eb"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi ngày nhận giấy xác nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ちょっとお伺いしたいんですが、証明書はいつ受け取れますか。",
              "vi": "Xin hỏi chút, khi nào tôi nhận được giấy xác nhận ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "来週の月曜日からです。",
              "vi": "Từ thứ Hai tuần sau ạ."
            }
          ],
          "id": "sj-trung-09-b07-16-ex03",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "f1504b16-9714-53c3-ba0c-5070ed35e2a6"
        }
      ]
    },
    {
      "item_id": "sj-trung-09-b06-159",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Được báo có loại giấy phù hợp hơn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この用途なら、別の証明書のほうが合います。",
              "vi": "Với mục đích này, loại giấy xác nhận khác phù hợp hơn ạ."
            },
            {
              "speaker_id": "B",
              "ja": "それは初耳です。違いを教えていただけますか。",
              "vi": "Lần đầu tôi nghe vậy. Chị giải thích điểm khác nhau giúp tôi được không ạ?"
            }
          ],
          "id": "sj-trung-09-b06-159-ex01",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "ff211d15-2c1e-5ccf-b3d4-2d4e5dc90a60"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quầy bảo hiểm chưa thấy dữ liệu đổi địa chỉ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "保険のほうには、まだ変更が反映されていません。",
              "vi": "Phía bảo hiểm chưa thấy cập nhật thay đổi ạ."
            },
            {
              "speaker_id": "B",
              "ja": "初耳です。住所の窓口では完了したと聞いたのですが。",
              "vi": "Đây là lần đầu tôi nghe vậy. Quầy địa chỉ nói với tôi là đã xong rồi ạ."
            }
          ],
          "id": "sj-trung-09-b06-159-ex02",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "44931865-a458-53e8-a893-63de9a46f8aa"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Biết có thể nộp trước một phần hồ sơ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "書類がそろう前でも、ここまでは受け付けられます。",
              "vi": "Chưa đủ giấy tờ chúng tôi vẫn tiếp nhận phần này được ạ."
            },
            {
              "speaker_id": "B",
              "ja": "それは初耳です。では、先にお願いします。",
              "vi": "Lần đầu tôi biết vậy. Vậy nhờ chị nhận trước phần này."
            }
          ],
          "id": "sj-trung-09-b06-159-ex03",
          "topic_uid": "cb94dc1f-0701-5410-ac4a-7c0f63ac672a",
          "situation_uid": "82922f6d-9a09-5885-99f6-0c64719e06f8"
        }
      ]
    }
  ]
