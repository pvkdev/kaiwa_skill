{
  "stage_uid": "43440649-3fc3-5bf1-9a7a-d2df6cba687f",
  "items": [
    {
      "item_id": "sj-trung-25-b18-2011",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo lịch tới công ty khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日の九時に御社へ伺います。",
              "vi": "Ngày mai chín giờ tôi sẽ đến quý công ty ạ."
            },
            {
              "speaker_id": "B",
              "ja": "受付でお名前をお伝えください。",
              "vi": "Xin báo tên ở quầy lễ tân."
            }
          ],
          "id": "sj-trung-25-b18-2011-ex01",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "ae5fc9e4-7b35-5e13-aa30-065a926adf4c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau lỗi truy cập, xin tới quầy hỗ trợ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "午後、担当部署へ伺ってもよろしいでしょうか。",
              "vi": "Chiều nay tôi đến bộ phận phụ trách được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、私がご案内します。",
              "vi": "Được, tôi sẽ dẫn chị tới."
            }
          ],
          "id": "sj-trung-25-b18-2011-ex02",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "85b479ab-5782-5cd3-8f21-20962ab39a31"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hẹn trở lại sau khi về công ty mình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "修正版を持って、来週また伺います。",
              "vi": "Tôi sẽ mang bản sửa và tuần sau tới lại ạ."
            },
            {
              "speaker_id": "B",
              "ja": "お待ちしています。",
              "vi": "Chúng tôi sẽ đợi."
            }
          ],
          "id": "sj-trung-25-b18-2011-ex03",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "c4021763-1488-5ae2-8361-39d8e658ae64"
        }
      ]
    },
    {
      "item_id": "sj-trung-25-b18-2511",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Tự giới thiệu vai khi tới nơi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "本日から担当します、山田と申します。",
              "vi": "Tôi là Yamada, từ hôm nay sẽ phụ trách ạ."
            },
            {
              "speaker_id": "B",
              "ja": "よろしくお願いします。",
              "vi": "Rất mong được hợp tác."
            }
          ],
          "id": "sj-trung-25-b18-2511-ex01",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "ae5fc9e4-7b35-5e13-aa30-065a926adf4c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách tưởng mình quyết được giá.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "料金もこちらで決めていただけますか。",
              "vi": "Chị có thể quyết cả mức giá ở đây không?"
            },
            {
              "speaker_id": "B",
              "ja": "技術担当の山田と申します。料金は社内で確認します。",
              "vi": "Tôi là Yamada, phụ trách kỹ thuật. Phần giá tôi cần xác nhận nội bộ ạ."
            }
          ],
          "id": "sj-trung-25-b18-2511-ex02",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "63d86f4f-50c8-5e00-9042-551014247a6e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người phụ trách mới tự giới thiệu với khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người phụ trách mới",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "本日から担当する佐藤と申します。今後ともよろしくお願いいたします。",
              "vi": "Tôi là Sato, từ hôm nay sẽ phụ trách. Rất mong tiếp tục được hợp tác ạ."
            },
            {
              "speaker_id": "B",
              "ja": "よろしくお願いします。",
              "vi": "Rất mong được hợp tác."
            }
          ],
          "id": "sj-trung-25-b18-2511-ex03",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "a56f9cf3-cced-59d2-b11b-93d1a249b5e7"
        }
      ]
    },
    {
      "item_id": "sj-trung-25-b18-2955",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin gặp đầu mối hằng ngày tại công ty khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Lễ tân",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご担当の田中様にお目にかかれますか。",
              "vi": "Tôi có thể gặp chị Tanaka phụ trách được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "少々お待ちください。",
              "vi": "Xin chờ một chút ạ."
            }
          ],
          "id": "sj-trung-25-b18-2955-ex01",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "ae5fc9e4-7b35-5e13-aa30-065a926adf4c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách chưa xem bản cuối, xin buổi gặp sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来週、結果についてお目にかかってお話しできますか。",
              "vi": "Tuần sau tôi có thể gặp anh để trao đổi về kết quả không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "火曜日なら大丈夫です。",
              "vi": "Thứ Ba thì được ạ."
            }
          ],
          "id": "sj-trung-25-b18-2955-ex02",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "34328eca-1676-5ed3-803d-f53728619e01"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cảm ơn người đã hỗ trợ tại chỗ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "本日お目にかかれてよかったです。いろいろ助けていただき、ありがとうございました。",
              "vi": "Hôm nay được gặp chị thật tốt. Cảm ơn chị đã giúp tôi nhiều ạ."
            },
            {
              "speaker_id": "B",
              "ja": "こちらこそ、ありがとうございました。",
              "vi": "Tôi cũng cảm ơn anh."
            }
          ],
          "id": "sj-trung-25-b18-2955-ex03",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "a56f9cf3-cced-59d2-b11b-93d1a249b5e7"
        }
      ]
    },
    {
      "item_id": "sj-trung-25-b07-149",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chào đầu mối đã làm việc trước đây.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "いつもお世話になっております。本日から現地を担当する山田です。",
              "vi": "Cảm ơn anh luôn hỗ trợ. Tôi là Yamada, từ hôm nay phụ trách tại đây ạ."
            },
            {
              "speaker_id": "B",
              "ja": "よろしくお願いします。",
              "vi": "Rất mong được hợp tác."
            }
          ],
          "id": "sj-trung-25-b07-149-ex01",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "ae5fc9e4-7b35-5e13-aa30-065a926adf4c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Gọi lại sau khi đã về công ty.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "いつもお世話になっております。先日の資料についてお電話しました。",
              "vi": "Cảm ơn chị luôn hỗ trợ. Tôi gọi về tài liệu hôm trước ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、確認しました。",
              "vi": "Vâng, tôi đã xem."
            }
          ],
          "id": "sj-trung-25-b07-149-ex02",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "c4021763-1488-5ae2-8361-39d8e658ae64"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cảm ơn và chuyển đầu mối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "いつもお世話になっております。今後のご連絡は佐藤が承ります。",
              "vi": "Cảm ơn anh luôn hỗ trợ. Từ nay anh Sato sẽ tiếp nhận liên lạc ạ."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。",
              "vi": "Tôi hiểu rồi."
            }
          ],
          "id": "sj-trung-25-b07-149-ex03",
          "topic_uid": "0d2e8640-dcbc-555f-bf18-bbf2bbe25d31",
          "situation_uid": "a56f9cf3-cced-59d2-b11b-93d1a249b5e7"
        }
      ]
    }
  ]
}
