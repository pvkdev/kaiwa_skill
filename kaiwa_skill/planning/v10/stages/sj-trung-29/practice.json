{
  "stage_uid": "79e85018-7c58-5da0-ab60-631caf6b5cec",
  "items": [
    {
      "item_id": "sj-trung-29-b20-18",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thấy người mới còn ngại ở tiệc chào mừng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "新しい人もいるし、空気を読んで、内輪の話ばかりしないようにしよう。",
              "vi": "Có người mới nên ta để ý không khí, đừng chỉ nói chuyện nội bộ nhé."
            },
            {
              "speaker_id": "B",
              "ja": "そうだね。",
              "vi": "Ừ, đúng."
            }
          ],
          "id": "sj-trung-29-b20-18-ex01",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "74037063-68e1-5a0e-ae27-3619f1501ca5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người mời rượu không nhận ra người kia không muốn uống.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "相手の様子を見て、空気を読んだほうがいいよ。",
              "vi": "Cậu nên nhìn phản ứng người ta mà biết ý chứ."
            },
            {
              "speaker_id": "B",
              "ja": "そうだね。もう勧めない。",
              "vi": "Ừ. Tớ sẽ không mời nữa."
            }
          ],
          "id": "sj-trung-29-b20-18-ex02",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "e5902f54-f96c-5752-8819-adfacb87b8c5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đồng nghiệp hiểu câu nói vui ở tiệc như lời chốt việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨日の話、もう決まったんだよね。",
              "vi": "Chuyện hôm qua đã quyết rồi nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "昨日は空気を読まずに冗談を言ってしまった。正式な決定じゃないよ。",
              "vi": "Hôm qua tớ đã đùa không đúng lúc. Đó chưa phải quyết định chính thức."
            }
          ],
          "id": "sj-trung-29-b20-18-ex03",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "11293ff0-0f19-5b57-8668-03c7ee2fbaa6"
        }
      ]
    },
    {
      "item_id": "sj-trung-29-b24-17",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe về dự án bộ phận khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今年は新しい企画を始めるんです。",
              "vi": "Năm nay nhóm tôi bắt đầu dự án mới."
            },
            {
              "speaker_id": "B",
              "ja": "面白そうですね。どんな企画ですか。",
              "vi": "Nghe thú vị quá. Dự án gì vậy ạ?"
            }
          ],
          "id": "sj-trung-29-b24-17-ex01",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "e8f3761e-bfbc-5823-94fc-ed1887977320"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Được mời tiệc và mong gặp lại nhóm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người tổ chức",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "皆さんと話せるのが楽しみです。何時からですか。",
              "vi": "Tôi mong được trò chuyện với mọi người. Mấy giờ bắt đầu ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "七時からです。",
              "vi": "Từ bảy giờ."
            }
          ],
          "id": "sj-trung-29-b24-17-ex02",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "91e0645b-aeb2-52cb-bdd1-aac253724f7c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người mới nói muốn tìm hiểu nhóm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mới",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "皆さんのお話を聞くのが楽しみです。",
              "vi": "Em mong được nghe mọi người kể chuyện."
            },
            {
              "speaker_id": "B",
              "ja": "こちらこそ、よろしくね。",
              "vi": "Bọn anh cũng vậy, rất vui được gặp em."
            }
          ],
          "id": "sj-trung-29-b24-17-ex03",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "74037063-68e1-5a0e-ae27-3619f1501ca5"
        }
      ]
    },
    {
      "item_id": "sj-trung-29-b07-94",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Từ chối rượu và gọi đồ không cồn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ビール、もう一杯どう？",
              "vi": "Thêm một cốc bia không?"
            },
            {
              "speaker_id": "B",
              "ja": "今日は遠慮しときます。お茶にするね。",
              "vi": "Hôm nay tớ xin thôi. Tớ uống trà."
            }
          ],
          "id": "sj-trung-29-b07-94-ex01",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "e5902f54-f96c-5752-8819-adfacb87b8c5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Từ chối đi tăng hai.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二次会にも行く？",
              "vi": "Cậu đi tăng hai không?"
            },
            {
              "speaker_id": "B",
              "ja": "今日は遠慮しとくよ。明日早いから。",
              "vi": "Hôm nay tớ xin phép không đi. Mai tớ dậy sớm."
            }
          ],
          "id": "sj-trung-29-b07-94-ex02",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "aea215f2-f05f-564e-9a7f-d6be07a443ca"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người kia mời rượu lần nữa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "少しだけでも飲まない？",
              "vi": "Uống một chút thôi nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "ありがとう。でも、お酒は遠慮しとくね。",
              "vi": "Cảm ơn. Nhưng rượu thì tớ xin thôi nhé."
            }
          ],
          "id": "sj-trung-29-b07-94-ex03",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "e5470761-8369-51fa-9476-fb9fa176f76f"
        }
      ]
    },
    {
      "item_id": "sj-trung-29-b06-54",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn hỏi có muốn đi tiếp không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二次会、行きたい？",
              "vi": "Cậu muốn đi tăng hai không?"
            },
            {
              "speaker_id": "B",
              "ja": "今日は気が進まないな。もう帰りたい。",
              "vi": "Hôm nay tớ không muốn lắm. Tớ muốn về rồi."
            }
          ],
          "id": "sj-trung-29-b06-54-ex01",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "aea215f2-f05f-564e-9a7f-d6be07a443ca"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Buổi tiệc có khách ngoài công ty, người học còn ngại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "知らない人が多いと、ちょっと気が進まないんだ。",
              "vi": "Có nhiều người lạ nên tớ hơi ngại đi."
            },
            {
              "speaker_id": "B",
              "ja": "最初だけ一緒にいようか。",
              "vi": "Lúc đầu tớ đi cùng nhé?"
            }
          ],
          "id": "sj-trung-29-b06-54-ex02",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "ddc488e5-09ec-5851-81db-de4152a41389"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đề nghị gặp riêng vào bữa trưa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "夜の飲み会は気が進まないなら、昼ご飯はどう？",
              "vi": "Nếu cậu không muốn đi tiệc tối, ăn trưa thì sao?"
            },
            {
              "speaker_id": "B",
              "ja": "それなら行きたい。",
              "vi": "Vậy thì tớ muốn đi."
            }
          ],
          "id": "sj-trung-29-b06-54-ex03",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "7150985c-742e-50ef-b772-07054f0f2815"
        }
      ]
    },
    {
      "item_id": "sj-trung-29-b12-76",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin phép rời tiệc sau phần đầu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người tổ chức",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一時間ほどで失礼してもよろしいでしょうか。",
              "vi": "Sau khoảng một tiếng tôi xin phép về được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、大丈夫です。",
              "vi": "Vâng, được ạ."
            }
          ],
          "id": "sj-trung-29-b12-76-ex01",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "3bbe17ea-1a54-5580-b6ad-3d413d7381a0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin phép về sớm, chào cấp trên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "少し早いのですが、先に失礼してもよろしいでしょうか。",
              "vi": "Tôi xin phép về trước hơi sớm một chút được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、気をつけて。",
              "vi": "Được, về cẩn thận nhé."
            }
          ],
          "id": "sj-trung-29-b12-76-ex02",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "c68e2ea1-bbf1-526d-a345-8b8c743b0d55"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên hỏi người có vị thế cao hơn trước khi đổi đồ uống.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người tổ chức",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お飲み物をお茶に替えてもよろしいでしょうか。",
              "vi": "Tôi đổi sang trà được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "もちろんです。",
              "vi": "Tất nhiên rồi."
            }
          ],
          "id": "sj-trung-29-b12-76-ex03",
          "topic_uid": "1f7b4c75-29ed-56c1-9c16-fd5206162aac",
          "situation_uid": "e5902f54-f96c-5752-8819-adfacb87b8c5"
        }
      ]
    }
  ]
}
