{
  "stage_uid": "03ba1dd0-fb82-54d6-a341-ee9d4c33124a",
  "items": [
    {
      "item_id": "sj-so-05-b07-82",
      "practice": [
        {
          "id": "sj-so-05-b07-82-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f584e001-d3cd-51dc-9547-07c5361f9f36",
          "situation_uid": "36a1d27b-7311-54eb-b938-137c3e2c88b5",
          "context_vi": "Nhân viên nghe thứ tự ba việc trong ngày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まず資料を印刷して、そのあと会議室を準備してください。",
              "vi": "Trước tiên in tài liệu, sau đó chuẩn bị phòng họp nhé."
            },
            {
              "speaker_id": "B",
              "ja": "わかりました。印刷してから、会議室ですね。",
              "vi": "Vâng, tôi hiểu rồi. In xong rồi đến phòng họp ạ."
            }
          ]
        },
        {
          "id": "sj-so-05-b07-82-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e11281ed-680a-52b6-8cd5-06afd95ba28c",
          "situation_uid": "0f4edf7d-eb2a-5f85-82ac-8d34993e1331",
          "context_vi": "Nhân viên đến sau khi tàu trễ, hỏi ưu tiên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今は受付を手伝ってください。",
              "vi": "Bây giờ em giúp ở quầy tiếp tân nhé."
            },
            {
              "speaker_id": "B",
              "ja": "わかりました。すぐ行きます。",
              "vi": "Vâng ạ. Em đến ngay."
            }
          ]
        },
        {
          "id": "sj-so-05-b07-82-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f584e001-d3cd-51dc-9547-07c5361f9f36",
          "situation_uid": "66942223-7714-5ccf-a130-a9c82f6ca25d",
          "context_vi": "Trưởng nhóm chọn việc ưu tiên giữa hai hạn chót.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先に見積書をお願いします。",
              "vi": "Làm báo giá trước nhé."
            },
            {
              "speaker_id": "B",
              "ja": "わかりました。メールはそのあとにします。",
              "vi": "Vâng. Tôi sẽ xử lý thư sau."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-05-b07-110",
      "practice": [
        {
          "id": "sj-so-05-b07-110-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e11281ed-680a-52b6-8cd5-06afd95ba28c",
          "situation_uid": "54cf86ff-31fe-58bd-8896-138d6725d64d",
          "context_vi": "Cuộc gặp đổi tòa, nhân viên kiểm lại lối vào.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đối tác",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "念のため確認します。入口は東棟の一階ですね。",
              "vi": "Để chắc ăn, tôi xin xác nhận. Lối vào ở tầng một tòa phía đông đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、受付のある入口です。",
              "vi": "Vâng, lối có quầy tiếp tân ạ."
            }
          ]
        },
        {
          "id": "sj-so-05-b07-110-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f584e001-d3cd-51dc-9547-07c5361f9f36",
          "situation_uid": "913bce8f-4fac-5f81-9781-b5bc4734c261",
          "context_vi": "Nhân viên nghe hai giờ gần nhau và kiểm lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "念のため、荷物は十時、会議は十一時ですね。",
              "vi": "Để chắc ăn, hàng đến lúc mười giờ, họp lúc mười một giờ đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、その順番です。",
              "vi": "Đúng rồi, theo thứ tự đó."
            }
          ]
        },
        {
          "id": "sj-so-05-b07-110-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e11281ed-680a-52b6-8cd5-06afd95ba28c",
          "situation_uid": "941f55c2-bc4d-5da0-a0d8-63ded333d49d",
          "context_vi": "Trước chuyến công tác ngắn, người đi kiểm nơi gặp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "念のため、明日は駅の南口に九時集合ですね。",
              "vi": "Để chắc ăn, mai tập trung ở cổng nam nhà ga lúc chín giờ phải không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "そうです。九時に南口です。",
              "vi": "Đúng rồi. Chín giờ ở cổng nam."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-05-b07-30",
      "practice": [
        {
          "id": "sj-so-05-b07-30-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e11281ed-680a-52b6-8cd5-06afd95ba28c",
          "situation_uid": "0f4edf7d-eb2a-5f85-82ac-8d34993e1331",
          "context_vi": "Nhân viên tới đúng sát giờ bắt đầu ca.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ぎりぎり間に合った。電車が遅れていたんです。",
              "vi": "May vừa kịp giờ. Tàu bị trễ."
            },
            {
              "speaker_id": "B",
              "ja": "よかった。まだ始まっていないよ。",
              "vi": "May quá. Vẫn chưa bắt đầu đâu."
            }
          ]
        },
        {
          "id": "sj-so-05-b07-30-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e11281ed-680a-52b6-8cd5-06afd95ba28c",
          "situation_uid": "c0b4dc0f-d3f7-5960-88c0-f7dffd4eeca4",
          "context_vi": "Nhân viên kịp tới chỗ đối tác trước giờ hẹn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ぎりぎり間に合った。受付はまだ開いてる？",
              "vi": "Vừa kịp giờ. Quầy tiếp tân vẫn mở chứ?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、今なら入れるよ。",
              "vi": "Ừ, giờ vẫn vào được."
            }
          ]
        },
        {
          "id": "sj-so-05-b07-30-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e11281ed-680a-52b6-8cd5-06afd95ba28c",
          "situation_uid": "cb43236f-c528-582e-89e6-54d117db2b87",
          "context_vi": "Hai đồng nghiệp vừa kịp chuyến tàu quay về.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ぎりぎり間に合ったね。次の電車は三十分後だったよ。",
              "vi": "Vừa kịp tàu nhỉ. Chuyến sau tận ba mươi phút nữa đấy."
            },
            {
              "speaker_id": "B",
              "ja": "本当によかった。",
              "vi": "May thật đấy."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-05-b11-3",
      "practice": [
        {
          "id": "sj-so-05-b11-3-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f584e001-d3cd-51dc-9547-07c5361f9f36",
          "situation_uid": "66942223-7714-5ccf-a130-a9c82f6ca25d",
          "context_vi": "Nhân viên kiểm lại việc còn lại sau khi nhận ưu tiên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "見積書を先にして、メールは午後でいいですよね。",
              "vi": "Tôi làm báo giá trước, còn thư để chiều được đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、それでお願いします。",
              "vi": "Vâng, cứ như vậy nhé."
            }
          ]
        },
        {
          "id": "sj-so-05-b11-3-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e11281ed-680a-52b6-8cd5-06afd95ba28c",
          "situation_uid": "941f55c2-bc4d-5da0-a0d8-63ded333d49d",
          "context_vi": "Hai đồng nghiệp cùng biết điểm hẹn nhưng vẫn xác nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日は南口で会うんだよね。",
              "vi": "Mai mình gặp ở cổng nam đúng không?"
            },
            {
              "speaker_id": "B",
              "ja": "うん、九時にね。",
              "vi": "Ừ, lúc chín giờ nhé."
            }
          ]
        },
        {
          "id": "sj-so-05-b11-3-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f584e001-d3cd-51dc-9547-07c5361f9f36",
          "situation_uid": "4e222b75-f24a-50e9-8f61-295d2b762b63",
          "context_vi": "Ca sáng hỏi ca tối có nhận việc còn dang dở.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên ca sáng",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên ca tối",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この箱の確認は、夜の担当に引き継ぐんですよね。",
              "vi": "Việc kiểm tra thùng này sẽ bàn giao cho ca tối đúng không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、私が続けます。",
              "vi": "Đúng, tôi sẽ làm tiếp."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-05-b07-81",
      "practice": [
        {
          "id": "sj-so-05-b07-81-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f584e001-d3cd-51dc-9547-07c5361f9f36",
          "situation_uid": "ce4be486-c77e-59ac-bb02-0657242fdc2e",
          "context_vi": "Hai đồng nghiệp ngang vai chia phần việc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私が前半を書きます。後半、お願いできる？",
              "vi": "Tớ viết nửa đầu. Cậu làm nửa sau được không?"
            },
            {
              "speaker_id": "B",
              "ja": "了解です。午後から始めます。",
              "vi": "Rõ rồi. Chiều tớ bắt đầu."
            }
          ]
        },
        {
          "id": "sj-so-05-b07-81-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e11281ed-680a-52b6-8cd5-06afd95ba28c",
          "situation_uid": "941f55c2-bc4d-5da0-a0d8-63ded333d49d",
          "context_vi": "Cấp trên dặn giờ tập trung, nhân viên đáp kính trọng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日は八時半に駅で集合してください。",
              "vi": "Ngày mai tập trung ở ga lúc tám rưỡi nhé."
            },
            {
              "speaker_id": "B",
              "ja": "承知しました。八時半ですね。",
              "vi": "Vâng, tôi đã nắm rõ. Tám rưỡi ạ."
            }
          ]
        },
        {
          "id": "sj-so-05-b07-81-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f584e001-d3cd-51dc-9547-07c5361f9f36",
          "situation_uid": "ab005c6f-f21a-582d-b81f-fa8ce97fe925",
          "context_vi": "Trưởng nhóm phân công việc ưu tiên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は先に発送の準備をしてください。",
              "vi": "Hôm nay hãy chuẩn bị gửi hàng trước nhé."
            },
            {
              "speaker_id": "B",
              "ja": "承知しました。書類の確認はそのあとにします。",
              "vi": "Vâng, tôi hiểu ạ. Tôi sẽ kiểm tra giấy tờ sau."
            }
          ]
        }
      ]
    }
  ]
}
