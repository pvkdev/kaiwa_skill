{
  "stage_uid": "48ed85d9-10a0-5617-8ddc-b0b96cbe7e23",
  "items": [
    {
      "item_id": "sj-thuong-02-b24-705",
      "practice": [
        {
          "id": "sj-thuong-02-b24-705-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "03e96090-e8f1-52e6-9621-79700133d170",
          "situation_uid": "c8e39d43-2dcf-52bd-8b34-74167b70c3f6",
          "context_vi": "Cảm ơn người chuẩn bị số liệu phía sau buổi trình bày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "おかげさまで、数字の根拠まで自信を持って説明できました。",
              "vi": "Nhờ chị mà tôi đã giải thích được cả căn cứ của các con số một cách tự tin."
            },
            {
              "speaker_id": "B",
              "ja": "役に立ててよかったです。",
              "vi": "Tôi mừng vì đã giúp được."
            }
          ]
        },
        {
          "id": "sj-thuong-02-b24-705-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "03e96090-e8f1-52e6-9621-79700133d170",
          "situation_uid": "a7752fe0-335d-5ccc-9f9f-892912db3ce4",
          "context_vi": "Nhận lời khen sau khi cả nhóm hoàn thành.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách hàng",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨日の対応は見事でしたね。",
              "vi": "Cách xử lý hôm qua thật tốt."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。皆さんのおかげで、予定どおりお届けできました。",
              "vi": "Cảm ơn chị. Nhờ mọi người mà chúng tôi đã giao đúng hẹn."
            }
          ]
        },
        {
          "id": "sj-thuong-02-b24-705-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb40b988-d45c-5095-87dd-b9df0e4b0a2d",
          "situation_uid": "dc602846-20b2-5eae-8981-5a34983a648f",
          "context_vi": "Ngày cuối, cảm ơn người hướng dẫn cũ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "おかげさまで、初めての海外案件も一人で担当できるようになりました。",
              "vi": "Nhờ anh mà tôi đã có thể tự phụ trách cả dự án nước ngoài đầu tiên."
            },
            {
              "speaker_id": "B",
              "ja": "そう言ってもらえるとうれしいよ。",
              "vi": "Nghe em nói vậy anh vui lắm."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-02-b24-725",
      "practice": [
        {
          "id": "sj-thuong-02-b24-725-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "03e96090-e8f1-52e6-9621-79700133d170",
          "situation_uid": "7448d7fb-5604-58e7-a17a-761844076efe",
          "context_vi": "Người nhận lời khen hỏi ai khác đã hỗ trợ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ほかに手伝ってくれた人はいますか。",
              "vi": "Còn ai đã giúp em nữa không?"
            },
            {
              "speaker_id": "B",
              "ja": "法務の方が契約を確認してくださって、助かりました。",
              "vi": "Bên pháp chế đã kiểm tra hợp đồng, giúp em rất nhiều."
            }
          ]
        },
        {
          "id": "sj-thuong-02-b24-725-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb40b988-d45c-5095-87dd-b9df0e4b0a2d",
          "situation_uid": "2fc7f5d6-a8a8-526d-9117-fc53f4a7fd5c",
          "context_vi": "Bàn giao một việc còn mở trước khi nghỉ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この問い合わせを引き継いでもらえると助かります。回答案はまだ確認中です。",
              "vi": "Nếu anh tiếp nhận câu hỏi này thì giúp tôi nhiều lắm. Bản dự thảo trả lời vẫn đang được kiểm tra."
            },
            {
              "speaker_id": "B",
              "ja": "状況を確認してから返事するよ。",
              "vi": "Tôi sẽ xem tình hình rồi trả lời."
            }
          ]
        },
        {
          "id": "sj-thuong-02-b24-725-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "edbc7921-4a04-5338-a33a-9a60bf5bf2a8",
          "situation_uid": "68b5c546-879d-5a9e-8026-b853dbec07a0",
          "context_vi": "Hỏi người đi cùng có cần hỗ trợ đặt bàn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đối tác",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "同僚が一人増えても大丈夫ですか。",
              "vi": "Có thêm một đồng nghiệp đi cùng thì được không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。お人数を先に伺えて助かります。",
              "vi": "Được ạ. Anh cho biết số người trước như vậy giúp tôi nhiều lắm."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-02-b20-1261",
      "practice": [
        {
          "id": "sj-thuong-02-b20-1261-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "03e96090-e8f1-52e6-9621-79700133d170",
          "situation_uid": "fa812eb0-78d5-5440-9461-39f29c1b6801",
          "context_vi": "Khen quyết định cụ thể khi khách đang chờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "確認が取れるまで出荷を止めた判断には頭が下がるよ。お客様への影響を防げた。",
              "vi": "Tôi thật nể quyết định dừng giao hàng cho tới khi kiểm tra xong. Nhờ vậy đã tránh ảnh hưởng đến khách."
            },
            {
              "speaker_id": "B",
              "ja": "そう言っていただけると安心します。",
              "vi": "Anh nói vậy tôi yên tâm hơn."
            }
          ]
        },
        {
          "id": "sj-thuong-02-b20-1261-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "03e96090-e8f1-52e6-9621-79700133d170",
          "situation_uid": "c8e39d43-2dcf-52bd-8b34-74167b70c3f6",
          "context_vi": "Nhắc công sức người không lên sân khấu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "森さんには頭が下がります。全件を照合してくれたおかげで発表できました。",
              "vi": "Tôi rất nể anh Mori. Nhờ anh ấy đối chiếu từng trường hợp mà chúng ta mới trình bày được."
            },
            {
              "speaker_id": "B",
              "ja": "本人にも伝えましょう。",
              "vi": "Hãy nói trực tiếp với anh ấy nhé."
            }
          ]
        },
        {
          "id": "sj-thuong-02-b20-1261-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb40b988-d45c-5095-87dd-b9df0e4b0a2d",
          "situation_uid": "dc602846-20b2-5eae-8981-5a34983a648f",
          "context_vi": "Cảm ơn đồng nghiệp từng ở lại giúp xử lý lỗi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あの夜、最後まで一緒に原因を調べてくださったことには頭が下がります。",
              "vi": "Tôi thật sự nể anh vì tối ấy đã cùng tôi tìm nguyên nhân đến tận cuối."
            },
            {
              "speaker_id": "B",
              "ja": "こちらこそ、助けられたよ。",
              "vi": "Anh cũng được em giúp mà."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-02-b20-597",
      "practice": [
        {
          "id": "sj-thuong-02-b20-597-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "edbc7921-4a04-5338-a33a-9a60bf5bf2a8",
          "situation_uid": "0657ce04-f332-5929-9fd6-03785e84f27a",
          "context_vi": "Khách nhận được thực đơn có ghi món không cồn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách hàng",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ノンアルコール飲料と料理の組み合わせまで載っていますね。",
              "vi": "Ở đây còn ghi cả cách kết hợp đồ uống không cồn với món ăn nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "かゆいところに手が届く案内ですね。",
              "vi": "Bản hướng dẫn chu đáo đến từng chi tiết nhỉ."
            }
          ]
        },
        {
          "id": "sj-thuong-02-b20-597-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "03e96090-e8f1-52e6-9621-79700133d170",
          "situation_uid": "ab86fa37-1556-5525-a189-0ac24aabc9e2",
          "context_vi": "Hỏi điều nào của tài liệu có giá trị nhất.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この資料、どこが特に役立ちましたか。",
              "vi": "Phần nào của tài liệu này hữu ích nhất?"
            },
            {
              "speaker_id": "B",
              "ja": "例外の判断基準まで載っていて、かゆいところに手が届く内容でした。",
              "vi": "Có cả tiêu chí xử lý ngoại lệ, đúng là tài liệu rất chu đáo."
            }
          ]
        },
        {
          "id": "sj-thuong-02-b20-597-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bbf51edf-691f-5148-8b81-a8f2be616491",
          "situation_uid": "e8b42f46-d0f0-5c5d-aee7-5799f6757793",
          "context_vi": "Khách nhận thấy lời hỏi trước về món cần tránh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách hàng",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "食べられないものまで先に聞いてくれるんですね。かゆいところに手が届く気遣いですね。",
              "vi": "Chị còn hỏi trước cả món tôi không ăn được. Chu đáo đến từng chi tiết nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "当日の店選びで困らないようにと思いまして。",
              "vi": "Tôi muốn tránh việc chọn quán không phù hợp hôm đó ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-02-b06-630",
      "practice": [
        {
          "id": "sj-thuong-02-b06-630-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "eb40b988-d45c-5095-87dd-b9df0e4b0a2d",
          "situation_uid": "0c4b4d52-e9f4-5ddb-9055-af933deec1bd",
          "context_vi": "Đồng nghiệp đề nghị giúp sắp buổi gặp trước ngày đi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "会議室は僕が取っておくよ。",
              "vi": "Để tôi đặt phòng họp cho."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。では、お言葉に甘えてお願いします。",
              "vi": "Cảm ơn anh. Vậy tôi xin nhận lời, nhờ anh nhé."
            }
          ]
        },
        {
          "id": "sj-thuong-02-b06-630-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "03e96090-e8f1-52e6-9621-79700133d170",
          "situation_uid": "194a036e-d03b-5a10-b315-ae9748c32fa1",
          "context_vi": "Sau tiệc, trưởng nhóm đề nghị nhận phần hỗ trợ khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日の問い合わせは私が受けようか。",
              "vi": "Để mai tôi tiếp nhận câu hỏi của khách nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "お言葉に甘えてもよろしいですか。午後は資料を直します。",
              "vi": "Vậy tôi xin nhờ anh được không? Chiều tôi sẽ sửa tài liệu."
            }
          ]
        },
        {
          "id": "sj-thuong-02-b06-630-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "edbc7921-4a04-5338-a33a-9a60bf5bf2a8",
          "situation_uid": "92e8d84e-a3d1-5d02-bcc4-434a81412f20",
          "context_vi": "Khách được đề nghị gọi xe sau bữa gặp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お帰りの車をお呼びしましょうか。",
              "vi": "Để tôi gọi xe cho anh về nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "では、お言葉に甘えてお願いします。",
              "vi": "Vậy tôi xin nhận lòng tốt của chị."
            }
          ]
        }
      ]
    }
  ]
}
