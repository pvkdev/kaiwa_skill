{
  "stage_uid": "52bf6fc1-be36-5eef-9634-045c01d52ea4",
  "items": [
    {
      "item_id": "sj-so-09-b07-172",
      "practice": [
        {
          "id": "sj-so-09-b07-172-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3c412c9d-4f79-5216-a1ac-7dc15b22b61a",
          "situation_uid": "8022454a-927a-56ef-9d20-34382d2a6d21",
          "context_vi": "Người học để thùng chắn lối hàng xóm rồi dời đi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gây phiền",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Hàng xóm",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "通路に箱を置いて、ご迷惑をおかけしました。すぐ動かします。",
              "vi": "Tôi để thùng chắn lối, xin lỗi đã gây bất tiện. Tôi dời ngay."
            },
            {
              "speaker_id": "B",
              "ja": "お願いします。",
              "vi": "Nhờ anh nhé."
            }
          ]
        },
        {
          "id": "sj-so-09-b07-172-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4b53810c-31d7-5ea9-b759-ac187e20fdfd",
          "situation_uid": "979e6fe8-87ed-51a8-986d-53193a7ebc45",
          "context_vi": "Nhân viên gửi nhầm bản chưa duyệt cho đồng nghiệp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "確認前の資料を送ってしまい、ご迷惑をおかけしました。",
              "vi": "Tôi gửi nhầm tài liệu chưa kiểm, xin lỗi đã gây phiền cho anh."
            },
            {
              "speaker_id": "B",
              "ja": "まだ使っていません。訂正版を送ってください。",
              "vi": "Tôi chưa dùng. Chị gửi bản đã sửa nhé."
            }
          ]
        },
        {
          "id": "sj-so-09-b07-172-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3c412c9d-4f79-5216-a1ac-7dc15b22b61a",
          "situation_uid": "9878ea28-973e-5393-9ada-8c90620dba1b",
          "context_vi": "Sau khi sửa món thiếu, nhân viên xin lỗi khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらのミスでご迷惑をおかけしました。足りない分をお持ちしました。",
              "vi": "Do lỗi phía chúng tôi mà chị gặp bất tiện, rất xin lỗi. Tôi đã mang phần còn thiếu."
            },
            {
              "speaker_id": "B",
              "ja": "はい、これで合っています。",
              "vi": "Vâng, giờ đủ rồi ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-09-b07-194",
      "practice": [
        {
          "id": "sj-so-09-b07-194-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4b53810c-31d7-5ea9-b759-ac187e20fdfd",
          "situation_uid": "174fb9a0-ff92-58cd-93d2-c4bc93988069",
          "context_vi": "Nhân viên báo sẽ tới trễ trước giờ bắt đầu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "電車が遅れています。開始に間に合わず、申し訳ありません。",
              "vi": "Tàu đang trễ. Tôi không kịp giờ bắt đầu, thật sự xin lỗi ạ."
            },
            {
              "speaker_id": "B",
              "ja": "わかりました。着いたら連絡してください。",
              "vi": "Tôi biết rồi. Đến nơi hãy báo nhé."
            }
          ]
        },
        {
          "id": "sj-so-09-b07-194-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4b53810c-31d7-5ea9-b759-ac187e20fdfd",
          "situation_uid": "7c2fa408-a526-5853-a59c-732ef840b16c",
          "context_vi": "Nhân viên quên tài liệu cần cho cuộc họp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "資料を持ってくるのを忘れました。申し訳ありません。",
              "vi": "Tôi quên mang tài liệu tới. Tôi thật sự xin lỗi ạ."
            },
            {
              "speaker_id": "B",
              "ja": "まず共有フォルダを確認してください。",
              "vi": "Trước tiên hãy kiểm tra thư mục chung."
            }
          ]
        },
        {
          "id": "sj-so-09-b07-194-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3c412c9d-4f79-5216-a1ac-7dc15b22b61a",
          "situation_uid": "2dc39038-ec8a-50e5-baf6-0ae288b9b37e",
          "context_vi": "Nhân viên xin lỗi vì giao thiếu phần hàng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一つ足りません。いつ届きますか。",
              "vi": "Thiếu một món. Bao giờ giao tới ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "申し訳ありません。十分ほどでお持ちします。",
              "vi": "Chúng tôi thật sự xin lỗi. Khoảng mười phút nữa sẽ mang tới ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-09-b07-97",
      "practice": [
        {
          "id": "sj-so-09-b07-97-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4b53810c-31d7-5ea9-b759-ac187e20fdfd",
          "situation_uid": "869dff52-16e8-50df-8148-2c0a9e758503",
          "context_vi": "Trưởng nhóm nhắc nhân viên đặt vật sai kệ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この箱は別の棚ですよ。",
              "vi": "Thùng này phải để ở kệ khác nhé."
            },
            {
              "speaker_id": "B",
              "ja": "すみません。すぐ移します。今後気をつけます。",
              "vi": "Xin lỗi ạ. Tôi chuyển ngay. Từ nay tôi sẽ chú ý."
            }
          ]
        },
        {
          "id": "sj-so-09-b07-97-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3c412c9d-4f79-5216-a1ac-7dc15b22b61a",
          "situation_uid": "01ef11a1-1da0-53d8-b8d3-db6a6d520d10",
          "context_vi": "Người kia chấp nhận lời xin lỗi nhưng muốn được báo sớm lần sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người bị lỡ hẹn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người lỡ hẹn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今回は大丈夫です。次は早めに知らせてください。",
              "vi": "Lần này không sao. Lần sau báo sớm cho tôi nhé."
            },
            {
              "speaker_id": "B",
              "ja": "はい、気をつけます。",
              "vi": "Vâng, tôi sẽ chú ý."
            }
          ]
        },
        {
          "id": "sj-so-09-b07-97-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4b53810c-31d7-5ea9-b759-ac187e20fdfd",
          "situation_uid": "979e6fe8-87ed-51a8-986d-53193a7ebc45",
          "context_vi": "Đồng nghiệp nhắc không gửi bản chưa duyệt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "送る前に承認を確認してくださいね。",
              "vi": "Trước khi gửi, nhớ kiểm xem đã được duyệt chưa nhé."
            },
            {
              "speaker_id": "B",
              "ja": "はい。これから気をつけます。",
              "vi": "Vâng. Từ nay tôi sẽ chú ý ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-09-b07-178",
      "practice": [
        {
          "id": "sj-so-09-b07-178-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3c412c9d-4f79-5216-a1ac-7dc15b22b61a",
          "situation_uid": "ae2c6c8f-97f2-5f31-aeff-60e40fbb242a",
          "context_vi": "Nhân viên nghe nhầm số lượng món khách đặt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二つ頼んだんですが、一つしかありません。",
              "vi": "Tôi gọi hai phần mà chỉ có một phần thôi."
            },
            {
              "speaker_id": "B",
              "ja": "失礼しました。すぐもう一つお持ちします。",
              "vi": "Xin lỗi chị. Tôi mang thêm một phần ngay."
            }
          ]
        },
        {
          "id": "sj-so-09-b07-178-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4b53810c-31d7-5ea9-b759-ac187e20fdfd",
          "situation_uid": "b77115fd-93bf-570e-9643-b4b9e1dca327",
          "context_vi": "Trưởng nhóm tưởng nhân viên chưa báo trễ, nhân viên giải thích.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "遅れる連絡を受けていません。",
              "vi": "Tôi chưa nhận được tin báo em sẽ trễ."
            },
            {
              "speaker_id": "B",
              "ja": "失礼しました。受付の方にだけお伝えしていました。",
              "vi": "Em xin lỗi ạ. Em mới báo cho người ở quầy tiếp tân."
            }
          ]
        },
        {
          "id": "sj-so-09-b07-178-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "3c412c9d-4f79-5216-a1ac-7dc15b22b61a",
          "situation_uid": "83dd58b3-e4f3-52c1-b91a-b14b89388b18",
          "context_vi": "Nhân viên đưa nhầm số lượng rồi sửa lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "失礼しました。こちらが二つ目の商品です。",
              "vi": "Xin lỗi anh. Đây là món thứ hai ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、二つそろいました。ありがとうございます。",
              "vi": "Vâng, đủ hai món rồi. Cảm ơn chị."
            }
          ]
        }
      ]
    }
  ]
}
