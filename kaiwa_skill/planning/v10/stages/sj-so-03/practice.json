{
  "stage_uid": "78c023e0-3782-5396-b5ae-094719bfd881",
  "items": [
    {
      "item_id": "sj-so-03-b18-13",
      "practice": [
        {
          "id": "sj-so-03-b18-13-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a7e878d8-bc1a-5101-ab8b-ac0b15a70dff",
          "situation_uid": "ad2623c7-0c89-5dc2-90dd-fd953cc45060",
          "context_vi": "Người đi đường hỏi hướng tới bưu điện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi đường",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người địa phương",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません、郵便局はどちらですか。",
              "vi": "Xin lỗi, bưu điện ở hướng nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "この道をまっすぐ行った左側です。",
              "vi": "Chị đi thẳng đường này, nó ở bên trái ạ."
            }
          ]
        },
        {
          "id": "sj-so-03-b18-13-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "da5c16e5-9425-5a4f-9086-8c109aa79c90",
          "situation_uid": "c86d5282-a8f9-5db3-9a55-2ded9d0541b0",
          "context_vi": "Khách hỏi sân ga chuyển tuyến.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Hành khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên ga",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "中央線のホームはどちらですか。",
              "vi": "Sân ga tuyến Chūō ở phía nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "階段を上がって右です。",
              "vi": "Anh lên cầu thang rồi rẽ phải ạ."
            }
          ]
        },
        {
          "id": "sj-so-03-b18-13-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "da5c16e5-9425-5a4f-9086-8c109aa79c90",
          "situation_uid": "4e5556ca-92ca-5164-95fa-96f682da6aea",
          "context_vi": "Người mang vali hỏi lối thang máy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Hành khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên ga",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "エレベーターはどちらですか。",
              "vi": "Thang máy ở đâu ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "改札の奥にございます。",
              "vi": "Ở phía sau cổng soát vé ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-03-b11-77",
      "practice": [
        {
          "id": "sj-so-03-b11-77-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a7e878d8-bc1a-5101-ab8b-ac0b15a70dff",
          "situation_uid": "137fe401-3b11-5af5-8267-2a9669dca659",
          "context_vi": "Qua điện thoại, người đi đường nói mình đang ở cổng nam.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi đường",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người đón",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私は南口にいます。そちらから見えますか。",
              "vi": "Tôi đang ở cổng nam. Từ chỗ chị có thấy tôi không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。こちらから見えます。",
              "vi": "Có, tôi nhìn thấy anh từ đây."
            }
          ]
        },
        {
          "id": "sj-so-03-b11-77-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "da5c16e5-9425-5a4f-9086-8c109aa79c90",
          "situation_uid": "2f02b243-cae3-5107-bff3-aa7a1e38f18c",
          "context_vi": "Nhân viên chỉ sân ga đúng cho người đang ở phía đối diện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Hành khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên ga",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "このホームで合っていますか。",
              "vi": "Tôi đứng ở sân ga này đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "反対方向です。あちらのホームへどうぞ。",
              "vi": "Chị đi ngược chiều rồi. Mời sang sân ga phía kia."
            }
          ]
        },
        {
          "id": "sj-so-03-b11-77-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a7e878d8-bc1a-5101-ab8b-ac0b15a70dff",
          "situation_uid": "0fd8fb48-9605-52df-96f2-67c4331a7239",
          "context_vi": "Người chỉ đường hỏi khách chọn đi bộ hay tàu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người chỉ đường",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người đi đường",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "歩くのと電車、どちらがよろしいですか。",
              "vi": "Anh muốn đi bộ hay đi tàu ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "歩きます。近いですか。",
              "vi": "Tôi đi bộ. Có gần không ạ?"
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-03-b11-2",
      "practice": [
        {
          "id": "sj-so-03-b11-2-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a7e878d8-bc1a-5101-ab8b-ac0b15a70dff",
          "situation_uid": "53ca2388-ec85-561b-b6b7-7b34b87da79f",
          "context_vi": "Người địa phương báo mốc rẽ mà khách chưa biết.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi đường",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người địa phương",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "図書館はどこですか。",
              "vi": "Thư viện ở đâu ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "あの交番を右に曲がると見えますよ。",
              "vi": "Rẽ phải ở đồn cảnh sát kia là chị thấy ngay đấy."
            }
          ]
        },
        {
          "id": "sj-so-03-b11-2-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a7e878d8-bc1a-5101-ab8b-ac0b15a70dff",
          "situation_uid": "b98ce024-3703-54a7-a5dc-fb10a344a0c1",
          "context_vi": "Khách nhắc sai hướng, người chỉ đường sửa lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi đường",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người chỉ đường",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この角を左ですね。",
              "vi": "Rẽ trái ở góc này đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "右ですよ。青い看板が見えるほうです。",
              "vi": "Rẽ phải đấy ạ. Phía có biển màu xanh."
            }
          ]
        },
        {
          "id": "sj-so-03-b11-2-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "da5c16e5-9425-5a4f-9086-8c109aa79c90",
          "situation_uid": "2f02b243-cae3-5107-bff3-aa7a1e38f18c",
          "context_vi": "Nhân viên cảnh báo khách đang đứng ở chiều ngược.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Hành khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên ga",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この電車で新宿に行けますか。",
              "vi": "Tàu này có đến Shinjuku không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "このホームは反対方向ですよ。",
              "vi": "Sân ga này đi chiều ngược đấy ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-03-b11-75",
      "practice": [
        {
          "id": "sj-so-03-b11-75-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a7e878d8-bc1a-5101-ab8b-ac0b15a70dff",
          "situation_uid": "76d7f505-ed14-55de-a194-657fef8072fe",
          "context_vi": "Người đi đường nói mốc mình đang đứng để hỏi lối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi đường",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người địa phương",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この辺にいますが、駅の入口が見えません。",
              "vi": "Tôi đang ở quanh đây mà không thấy lối vào ga."
            },
            {
              "speaker_id": "B",
              "ja": "その赤い看板の後ろですよ。",
              "vi": "Nó ở sau biển màu đỏ ngay chỗ anh đấy."
            }
          ]
        },
        {
          "id": "sj-so-03-b11-75-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a7e878d8-bc1a-5101-ab8b-ac0b15a70dff",
          "situation_uid": "18e4b46f-16f3-519a-92c3-82ef9a40b19c",
          "context_vi": "Có hai ngã rẽ, khách hỏi đúng ngã nào.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi đường",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người địa phương",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どの角を曲がればいいですか。",
              "vi": "Tôi cần rẽ ở góc nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "あの信号のある角です。",
              "vi": "Góc có đèn giao thông đằng kia ạ."
            }
          ]
        },
        {
          "id": "sj-so-03-b11-75-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "a7e878d8-bc1a-5101-ab8b-ac0b15a70dff",
          "situation_uid": "137fe401-3b11-5af5-8267-2a9669dca659",
          "context_vi": "Người đón hỏi người đi đường đang đứng ở cổng nào.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đón",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người đi đường",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どの出口にいますか。",
              "vi": "Chị đang ở lối ra nào?"
            },
            {
              "speaker_id": "B",
              "ja": "この南口です。目の前にバス停があります。",
              "vi": "Tôi ở cổng nam này. Trước mặt có trạm xe buýt."
            }
          ]
        }
      ]
    }
  ]
}
