{
  "stage_uid": "7ae746f8-e9f7-5dba-9f06-06b829d90f77",
  "items": [
    {
      "item_id": "sj-thuong-10-b06-432",
      "practice": [
        {
          "id": "sj-thuong-10-b06-432-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "5e3b13ab-9681-55c7-936a-3845f6c72630",
          "situation_uid": "5d626676-5c4c-5629-8fbd-a58056a42c26",
          "context_vi": "Báo không kịp làm lại toàn bộ trước khai trương.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "言いにくいんですが、全量の作り直しは開店日までに間に合いません。先に必要な数を教えてください。",
              "vi": "Khó nói nhưng chúng tôi không thể làm lại toàn bộ trước ngày khai trương. Anh cho biết số lượng cần trước nhé."
            },
            {
              "speaker_id": "B",
              "ja": "まず百個必要です。",
              "vi": "Trước mắt tôi cần một trăm cái."
            }
          ]
        },
        {
          "id": "sj-thuong-10-b06-432-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "787f9d8a-9ce3-5c7b-b786-263706df0d2b",
          "situation_uid": "5c07bbe2-a8cc-54fb-b2da-3b496a871e73",
          "context_vi": "Báo sếp chưa thể hứa giờ khôi phục.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "言いにくいんですが、復旧時刻はまだ約束できません。一時間後に調査結果を報告します。",
              "vi": "Khó nói nhưng tôi chưa thể hứa giờ khôi phục. Một tiếng nữa tôi sẽ báo kết quả điều tra."
            },
            {
              "speaker_id": "B",
              "ja": "分かった。",
              "vi": "Được."
            }
          ]
        },
        {
          "id": "sj-thuong-10-b06-432-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1a37223-0d58-582c-aa1f-066bbf9efd99",
          "situation_uid": "e0153f56-51f3-5cc9-a801-f13e98553c66",
          "context_vi": "Không còn phòng riêng như khách mong muốn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "言いにくいんですが、本日は個室が満室です。静かな奥の席ならご案内できます。",
              "vi": "Khó nói quá, nhưng hôm nay phòng riêng đã kín. Tôi có thể dẫn anh tới chỗ yên tĩnh phía trong."
            },
            {
              "speaker_id": "B",
              "ja": "それなら席を見せてください。",
              "vi": "Vậy cho tôi xem chỗ ấy."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-10-b06-1118",
      "practice": [
        {
          "id": "sj-thuong-10-b06-1118-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "5e3b13ab-9681-55c7-936a-3845f6c72630",
          "situation_uid": "10377d08-da6f-5b7c-96e1-0c378894fbad",
          "context_vi": "Khách tưởng lời xin lỗi đã chốt bồi thường.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "謝ったということは、補償も決まったんですね。",
              "vi": "Chị xin lỗi nghĩa là mức bồi thường đã quyết rồi nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "それは誤解です。影響についてお詫びしましたが、補償内容は確認中です。",
              "vi": "Đó là hiểu lầm ạ. Tôi xin lỗi về ảnh hưởng đã gây ra, còn nội dung bồi thường vẫn đang xem xét."
            }
          ]
        },
        {
          "id": "sj-thuong-10-b06-1118-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f762c2fb-b676-5ccc-82b0-6da2140351ce",
          "situation_uid": "5b1e0dd4-f769-567d-8573-cbe7c8b18c1f",
          "context_vi": "Sếp tưởng đã rõ nguyên nhân lỗi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "印刷機の不具合が原因なんだね。",
              "vi": "Vậy nguyên nhân là máy in lỗi nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "すみません、原因が確定したという点は誤解です。説明が足りませんでした。確認できたのは納品物が見本と違う点までです。",
              "vi": "Xin lỗi, có hiểu lầm ở chỗ nguyên nhân đã được xác định. Tôi giải thích chưa rõ. Hiện chỉ xác nhận được hàng giao khác mẫu."
            }
          ]
        },
        {
          "id": "sj-thuong-10-b06-1118-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1a37223-0d58-582c-aa1f-066bbf9efd99",
          "situation_uid": "30957d2a-da8b-5373-adc8-9f8162e93c83",
          "context_vi": "Nhân viên hiểu khách muốn đổi phòng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "部屋を替えたいわけではないんです。",
              "vi": "Tôi không định đổi phòng đâu."
            },
            {
              "speaker_id": "B",
              "ja": "失礼しました。私の誤解です。音を抑える方法を確認します。",
              "vi": "Tôi xin lỗi. Tôi đã hiểu nhầm. Tôi sẽ kiểm tra cách giảm tiếng ồn."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-10-b07-844",
      "practice": [
        {
          "id": "sj-thuong-10-b07-844-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "5e3b13ab-9681-55c7-936a-3845f6c72630",
          "situation_uid": "de2c34ca-e0a0-5273-b988-c131f8dbe920",
          "context_vi": "Khách nghe lời hỏi như đổ trách nhiệm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらの保管が悪かったと言いたいんですか。",
              "vi": "Chị định nói chúng tôi bảo quản sai sao?"
            },
            {
              "speaker_id": "B",
              "ja": "そんなつもりじゃなかったんです。確認のために伺いましたが、言い方が悪く申し訳ありません。",
              "vi": "Tôi không có ý đó. Tôi hỏi để kiểm tra, nhưng cách nói của tôi không khéo. Xin lỗi anh."
            }
          ]
        },
        {
          "id": "sj-thuong-10-b07-844-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "787f9d8a-9ce3-5c7b-b786-263706df0d2b",
          "situation_uid": "a932cfce-8092-593b-a28a-93d71f644f3c",
          "context_vi": "Đồng nghiệp bị coi là nguyên nhân sự cố.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私が原因だと言いたいの？",
              "vi": "Cô muốn nói tôi gây ra sự cố à?"
            },
            {
              "speaker_id": "B",
              "ja": "そんなつもりじゃなかったんです。操作の時刻を確認したかっただけです。",
              "vi": "Tôi không có ý đó. Tôi chỉ muốn xác nhận thời điểm thao tác."
            }
          ]
        },
        {
          "id": "sj-thuong-10-b07-844-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1a37223-0d58-582c-aa1f-066bbf9efd99",
          "situation_uid": "da7d28cd-3407-5e2a-9e82-77c33f339e19",
          "context_vi": "Khách không muốn nhắc sở thích cũ trước người đi cùng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前に来た時の話は、今ここではしないでください。",
              "vi": "Xin đừng nhắc chuyện lần trước ngay lúc này."
            },
            {
              "speaker_id": "B",
              "ja": "そんなつもりじゃなかったんです。配慮が足りず、失礼しました。今日のご希望だけ伺います。",
              "vi": "Tôi không cố ý. Tôi đã thiếu tế nhị, xin lỗi anh. Tôi chỉ hỏi mong muốn của anh hôm nay."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-10-b20-2746",
      "practice": [
        {
          "id": "sj-thuong-10-b20-2746-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "5e3b13ab-9681-55c7-936a-3845f6c72630",
          "situation_uid": "4cdbf74c-0b40-5894-b746-1bab0d62f196",
          "context_vi": "Gọi đúng hẹn báo phần đã xác minh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "このたびはお騒がせして申し訳ありません。見本との差は確認できました。納期は午後四時にご連絡します。",
              "vi": "Chúng tôi xin lỗi vì đã gây phiền lòng. Chúng tôi đã xác nhận hàng khác mẫu. Bốn giờ chiều tôi sẽ báo hạn giao."
            },
            {
              "speaker_id": "B",
              "ja": "必ずその時刻にお願いします。",
              "vi": "Nhất định hãy gọi đúng giờ đó."
            }
          ]
        },
        {
          "id": "sj-thuong-10-b20-2746-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f762c2fb-b676-5ccc-82b0-6da2140351ce",
          "situation_uid": "b258d5c8-6810-564d-a5a9-eb5c89680342",
          "context_vi": "Hỏi khách dùng hàng sau khi sửa thế nào.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先日はお騒がせしました。その後、お届けし直した商品は問題なくお使いいただけていますか。",
              "vi": "Lần trước chúng tôi đã gây phiền hà, rất xin lỗi. Số hàng giao lại anh dùng có ổn không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、今は大丈夫です。",
              "vi": "Vâng, giờ ổn rồi."
            }
          ]
        },
        {
          "id": "sj-thuong-10-b20-2746-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "787f9d8a-9ce3-5c7b-b786-263706df0d2b",
          "situation_uid": "307b5f5b-a526-5b54-9fe4-2106eeb4d6ff",
          "context_vi": "Báo tình trạng cuối cho cấp trên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お騒がせして申し訳ありませんでした。再発はなく、顧客にも結果を伝えました。",
              "vi": "Xin lỗi vì đã khiến mọi người lo lắng. Lỗi không tái phát và đã báo kết quả cho khách."
            },
            {
              "speaker_id": "B",
              "ja": "再発防止策もまとめよう。",
              "vi": "Hãy tổng hợp biện pháp ngăn tái phát."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-10-b12-1894",
      "practice": [
        {
          "id": "sj-thuong-10-b12-1894-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "5e3b13ab-9681-55c7-936a-3845f6c72630",
          "situation_uid": "61475c1d-3f28-522f-be6b-fdfd32d0ce8a",
          "context_vi": "Khách sửa nhân viên hiểu nhầm lỗi số lượng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "数量が違ったのですね。",
              "vi": "Là số lượng bị sai phải không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "は？ 数は合っています。違うのはロゴの色です。",
              "vi": "Hả? Số lượng đúng. Sai là màu logo."
            },
            {
              "speaker_id": "A",
              "ja": "失礼しました。ロゴの色ですね。",
              "vi": "Tôi xin lỗi. Là màu logo ạ."
            }
          ]
        },
        {
          "id": "sj-thuong-10-b12-1894-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "5e3b13ab-9681-55c7-936a-3845f6c72630",
          "situation_uid": "5d626676-5c4c-5629-8fbd-a58056a42c26",
          "context_vi": "Khách bất ngờ vì không kịp đủ hàng khai trương.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "全量は開店日に間に合いません。",
              "vi": "Toàn bộ hàng không kịp ngày khai trương ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はあ？ 必要なのは開店日です。少なくとも百個は間に合いますか。",
              "vi": "Hả? Chúng tôi cần hàng đúng ngày khai trương. Ít nhất một trăm cái có kịp không?"
            },
            {
              "speaker_id": "A",
              "ja": "工場に確認して、午後三時までにお返事します。",
              "vi": "Tôi sẽ hỏi nhà máy và trả lời trước ba giờ chiều."
            }
          ]
        },
        {
          "id": "sj-thuong-10-b12-1894-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1a37223-0d58-582c-aa1f-066bbf9efd99",
          "situation_uid": "e82a1774-3da9-5922-90a5-682f330a2e22",
          "context_vi": "Khách phải nhắc lại tiếng ồn nào khiến mình khó chịu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どの音が一番気になりますか。",
              "vi": "Tiếng gì khiến anh khó chịu nhất ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はあ？ 隣のテレビの音です。さっきも伝えましたよ。",
              "vi": "Hả? Tiếng ti vi phòng bên. Tôi đã nói lúc nãy rồi."
            },
            {
              "speaker_id": "A",
              "ja": "失礼しました。すぐ確認します。",
              "vi": "Tôi xin lỗi. Tôi sẽ kiểm tra ngay."
            }
          ]
        }
      ]
    }
  ]
}
