{
  "stage_uid": "382c8261-24f7-5998-b35e-5aa536253d26",
  "items": [
    {
      "item_id": "sj-thuong-11-b06-1022",
      "practice": [
        {
          "id": "sj-thuong-11-b06-1022-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b74a7aee-9abf-5bbd-8651-1cac1caa5d72",
          "situation_uid": "b4fe6e49-4cdb-5e7d-8bea-ff81ad9c4dfe",
          "context_vi": "Chuyến bay trễ, xin đổi cuộc gặp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi công tác",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "急な話で恐縮ですが、到着が二時間遅れます。午後三時の打ち合わせを五時に変更できますか。",
              "vi": "Xin lỗi vì báo gấp, chuyến bay của tôi đến muộn hai tiếng. Ta đổi cuộc họp ba giờ sang năm giờ được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "五時は難しいので、同僚と先に話します。",
              "vi": "Năm giờ khó, tôi sẽ nói chuyện trước với đồng nghiệp chị."
            }
          ]
        },
        {
          "id": "sj-thuong-11-b06-1022-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8abe4006-8e8a-550a-8168-d8b10604270b",
          "situation_uid": "0b61e249-21c9-5009-9e33-0eb9dd6b5811",
          "context_vi": "Muốn hỏi còn kịp đổi chi tiết bộ đồ đặt may.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách sử dụng dịch vụ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên dịch vụ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "急な話で恐縮ですが、袖の長さを変えたいんです。まだ間に合いますか。",
              "vi": "Xin lỗi vì báo đột ngột, tôi muốn đổi độ dài tay áo. Còn kịp không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "作業状況を確認します。",
              "vi": "Tôi sẽ kiểm tra tiến độ làm."
            }
          ]
        },
        {
          "id": "sj-thuong-11-b06-1022-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2fbfe235-9cff-5820-8073-202b8c5f0f5a",
          "situation_uid": "176777c2-39df-5f81-accf-1dcab4d36e38",
          "context_vi": "Quầy cần kiểm với bộ phận khác, người đi hỏi mốc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên dịch vụ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người đi công tác",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "別の担当に確認いたします。",
              "vi": "Tôi sẽ hỏi bộ phận khác ạ."
            },
            {
              "speaker_id": "B",
              "ja": "急な話で恐縮ですが、同行者が夕方には帰る必要があります。何時ごろ分かりますか。",
              "vi": "Xin lỗi vì nói gấp, nhưng người đi cùng tôi cần về trước chiều tối. Khoảng mấy giờ có câu trả lời ạ?"
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-11-b06-1035",
      "practice": [
        {
          "id": "sj-thuong-11-b06-1035-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b74a7aee-9abf-5bbd-8651-1cac1caa5d72",
          "situation_uid": "c00c6782-48dc-593a-8694-5791336ef62d",
          "context_vi": "Đồng nghiệp được nhờ gặp khách thay vào phút chót.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi công tác",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私の代わりに、三時から先方と会ってくれる？",
              "vi": "Anh gặp khách lúc ba giờ thay tôi được không?"
            },
            {
              "speaker_id": "B",
              "ja": "急に言われても困るよ。資料と、決めていい範囲を先に教えて。",
              "vi": "Nói gấp vậy tôi khó xoay kịp. Cho tôi tài liệu và phạm vi được quyết trước đi."
            }
          ]
        },
        {
          "id": "sj-thuong-11-b06-1035-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8abe4006-8e8a-550a-8168-d8b10604270b",
          "situation_uid": "11bc4619-45b6-574b-b988-054262eb1f9e",
          "context_vi": "Thợ báo sửa đồ sau ngày cần mặc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên dịch vụ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách sử dụng dịch vụ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "直せますが、完成は来週になります。",
              "vi": "Sửa được, nhưng tuần sau mới xong ạ."
            },
            {
              "speaker_id": "B",
              "ja": "急に言われても困ります。土曜に着る予定で注文したので、使える部分だけ先に受け取れますか。",
              "vi": "Giờ mới báo vậy tôi rất khó xử. Tôi đặt để mặc thứ Bảy, vậy có thể nhận trước phần dùng được không?"
            }
          ]
        },
        {
          "id": "sj-thuong-11-b06-1035-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2fbfe235-9cff-5820-8073-202b8c5f0f5a",
          "situation_uid": "06b49e36-ab7c-52d3-b47a-a9127d038709",
          "context_vi": "Quầy đề nghị chuyến thay không phù hợp nhóm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên dịch vụ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người đi công tác",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明朝の便ならご案内できます。",
              "vi": "Có thể chuyển sang chuyến sáng mai ạ."
            },
            {
              "speaker_id": "B",
              "ja": "急に言われても困ります。一人は今夜帰る必要があります。別の経路はありませんか。",
              "vi": "Báo gấp vậy chúng tôi khó xoay xở. Một người cần về tối nay. Có tuyến khác không ạ?"
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-11-b07-1372",
      "practice": [
        {
          "id": "sj-thuong-11-b07-1372-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c720d1f1-dd0b-5f2c-893a-0df310b80ad3",
          "situation_uid": "87887419-aae2-5744-a014-3bd9602228dc",
          "context_vi": "Nhân viên đề nghị sửa nhanh, khách đồng ý.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên dịch vụ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách sử dụng dịch vụ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "本日中の修理なら可能です。",
              "vi": "Nếu sửa trong hôm nay thì được ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、結構です。終わる時刻を教えてください。",
              "vi": "Vâng, được. Xin cho tôi biết giờ xong."
            },
            {
              "speaker_id": "A",
              "ja": "午後六時の予定です。",
              "vi": "Dự kiến sáu giờ chiều ạ."
            }
          ]
        },
        {
          "id": "sj-thuong-11-b07-1372-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8abe4006-8e8a-550a-8168-d8b10604270b",
          "situation_uid": "e3caabf6-454f-5dbb-b50f-ea3c11163184",
          "context_vi": "Từ chối ưu đãi kèm cam kết dài.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên dịch vụ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách sử dụng dịch vụ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "本日だけ、長期契約の割引がございます。",
              "vi": "Chỉ hôm nay có ưu đãi hợp đồng dài hạn ạ."
            },
            {
              "speaker_id": "B",
              "ja": "いえ、結構です。契約なしの料金だけ教えてください。",
              "vi": "Không, cảm ơn. Xin cho tôi biết giá không kèm hợp đồng thôi."
            },
            {
              "speaker_id": "A",
              "ja": "通常料金をご案内します。",
              "vi": "Tôi sẽ báo giá thông thường."
            }
          ]
        },
        {
          "id": "sj-thuong-11-b07-1372-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2fbfe235-9cff-5820-8073-202b8c5f0f5a",
          "situation_uid": "7a947bef-471b-53b6-8726-1fd3ab9a75a8",
          "context_vi": "Phòng thay không có ăn sáng, khách muốn kiểm lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên dịch vụ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách sử dụng dịch vụ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "朝食なしのお部屋に変更できます。",
              "vi": "Có thể đổi sang phòng không gồm bữa sáng ạ."
            },
            {
              "speaker_id": "B",
              "ja": "それなら結構です。差額も確認できますか。",
              "vi": "Nếu vậy được. Xin kiểm giúp cả phần chênh lệch giá."
            },
            {
              "speaker_id": "A",
              "ja": "はい、確認します。",
              "vi": "Vâng, tôi sẽ kiểm tra."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-11-b20-3484",
      "practice": [
        {
          "id": "sj-thuong-11-b20-3484-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "b74a7aee-9abf-5bbd-8651-1cac1caa5d72",
          "situation_uid": "b4fe6e49-4cdb-5e7d-8bea-ff81ad9c4dfe",
          "context_vi": "Nói trong nhóm về cuộc gặp bị hủy phút chót.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi công tác",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "飛行機が止まって、午後の面談をドタキャンすることになりそう。先方には事情を正確に伝えるね。",
              "vi": "Máy bay ngừng bay, có lẽ tôi phải hủy cuộc gặp chiều nay vào phút chót. Tôi sẽ báo đúng lý do cho bên kia."
            },
            {
              "speaker_id": "B",
              "ja": "うん。代わりの時間も聞いて。",
              "vi": "Ừ. Nhớ hỏi giờ thay thế nữa."
            }
          ]
        },
        {
          "id": "sj-thuong-11-b20-3484-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2fbfe235-9cff-5820-8073-202b8c5f0f5a",
          "situation_uid": "1b613599-347f-5c05-b8c6-27d79c2fba87",
          "context_vi": "Trong nhóm du lịch, chuyến tham quan bị hủy sát giờ khởi hành.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người trong nhóm du lịch",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn đồng hành",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "現地ツアーのガイドがドタキャンしたって。予約していたのは午後のツアーだけ？",
              "vi": "Nghe nói hướng dẫn viên hủy chuyến tham quan phút chót. Chỉ tour buổi chiều bị ảnh hưởng thôi à?"
            },
            {
              "speaker_id": "B",
              "ja": "そう。明日の船は予約どおりだよ。",
              "vi": "Ừ. Chuyến tàu thủy ngày mai vẫn như đã đặt."
            }
          ]
        },
        {
          "id": "sj-thuong-11-b20-3484-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "2fbfe235-9cff-5820-8073-202b8c5f0f5a",
          "situation_uid": "63d6295e-2304-5f67-aac4-8c1adcee282b",
          "context_vi": "Nhóm tưởng mọi chặng đi bị hủy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người đi công tác",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "全部ドタキャンになったの？",
              "vi": "Mọi chặng đều bị hủy phút chót à?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、船だけです。帰りの列車はまだ使えます。",
              "vi": "Không, chỉ chuyến tàu thủy thôi. Tàu hỏa lượt về vẫn dùng được."
            }
          ]
        }
      ]
    }
  ]
}
