{
  "stage_uid": "25178381-1e8f-58f8-b133-f93aa11fda1a",
  "items": [
    {
      "item_id": "sj-so-07-b18-10",
      "practice": [
        {
          "id": "sj-so-07-b18-10-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "72d35860-f51f-5d26-b6c8-489bed15a13f",
          "situation_uid": "0f6e0d72-f978-5bf2-99d8-44ed65334a19",
          "context_vi": "Món khách chọn hết, nhân viên gợi món khác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "焼き魚は売り切れです。煮魚はいかがですか。",
              "vi": "Cá nướng hết rồi ạ. Anh dùng cá kho nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "では、それを一つお願いします。",
              "vi": "Vậy cho tôi một phần đó."
            }
          ]
        },
        {
          "id": "sj-so-07-b18-10-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8c15dd2f-3934-5191-b35f-1ac643c2cc9f",
          "situation_uid": "c5308851-070d-5573-a1cf-d6367f0823e4",
          "context_vi": "Nhân viên gợi trà cho khách không uống cà phê.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "コーヒー以外でしたら、紅茶はいかがですか。",
              "vi": "Nếu không uống cà phê, chị dùng trà đen nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、紅茶にします。",
              "vi": "Vâng, tôi lấy trà đen."
            }
          ]
        },
        {
          "id": "sj-so-07-b18-10-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "72d35860-f51f-5d26-b6c8-489bed15a13f",
          "situation_uid": "3f352c15-c928-5f8b-b81c-eea5ef73fbdc",
          "context_vi": "Nhân viên thấy khách hết nước và hỏi có muốn thêm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お水のおかわりはいかがですか。",
              "vi": "Anh có muốn thêm nước không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、お願いします。",
              "vi": "Vâng, làm ơn cho tôi thêm."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-07-b07-93",
      "practice": [
        {
          "id": "sj-so-07-b07-93-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "72d35860-f51f-5d26-b6c8-489bed15a13f",
          "situation_uid": "0f6e0d72-f978-5bf2-99d8-44ed65334a19",
          "context_vi": "Nhân viên mời món thay thế nhưng khách không muốn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "別の定食はいかがですか。",
              "vi": "Chị dùng suất cơm khác nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "いえ、いいです。今日はうどんにします。",
              "vi": "Thôi, không cần ạ. Hôm nay tôi ăn udon."
            }
          ]
        },
        {
          "id": "sj-so-07-b07-93-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8c15dd2f-3934-5191-b35f-1ac643c2cc9f",
          "situation_uid": "fd86984d-5930-51e7-b916-4f7847b0fa4d",
          "context_vi": "Nhân viên gợi thêm khoai tây vào set.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ポテトも付けますか。",
              "vi": "Anh lấy thêm khoai tây không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いいです。飲み物だけで。",
              "vi": "Không cần ạ. Chỉ đồ uống thôi."
            }
          ]
        },
        {
          "id": "sj-so-07-b07-93-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "72d35860-f51f-5d26-b6c8-489bed15a13f",
          "situation_uid": "3f352c15-c928-5f8b-b81c-eea5ef73fbdc",
          "context_vi": "Khách đã đủ dụng cụ nên từ chối thêm thìa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "スプーンもお持ちしましょうか。",
              "vi": "Tôi mang thêm thìa cho chị nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "いいです。お箸がありますから。",
              "vi": "Không cần ạ. Tôi có đũa rồi."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-07-b07-170",
      "practice": [
        {
          "id": "sj-so-07-b07-170-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "72d35860-f51f-5d26-b6c8-489bed15a13f",
          "situation_uid": "1de4388c-f06a-5de2-8620-a22fab7252f2",
          "context_vi": "Khách ăn xong và rời quán.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ごちそうさまでした。おいしかったです。",
              "vi": "Cảm ơn về bữa ăn. Món ngon lắm ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。またお越しください。",
              "vi": "Cảm ơn chị. Hẹn gặp lại ạ."
            }
          ]
        },
        {
          "id": "sj-so-07-b07-170-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "72d35860-f51f-5d26-b6c8-489bed15a13f",
          "situation_uid": "793d78a1-b0aa-5478-b53c-f6a8ea8e4dd9",
          "context_vi": "Bạn trả tiền bữa ăn chung.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người được mời",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は僕が払うよ。",
              "vi": "Hôm nay để tớ trả."
            },
            {
              "speaker_id": "B",
              "ja": "ごちそうさま。ありがとう。",
              "vi": "Cảm ơn cậu đã mời nhé."
            }
          ]
        },
        {
          "id": "sj-so-07-b07-170-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8c15dd2f-3934-5191-b35f-1ac643c2cc9f",
          "situation_uid": "deb03d4e-705c-5d84-a4ff-867531788e7e",
          "context_vi": "Hai người ăn nhẹ xong, một người thanh toán cả hai.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người trả tiền",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二人分、払っておいたよ。",
              "vi": "Tớ trả tiền cho cả hai rồi."
            },
            {
              "speaker_id": "B",
              "ja": "ごちそうさま。次は僕が払うね。",
              "vi": "Cảm ơn cậu đã mời. Lần sau để tớ trả nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-07-b07-147",
      "practice": [
        {
          "id": "sj-so-07-b07-147-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "72d35860-f51f-5d26-b6c8-489bed15a13f",
          "situation_uid": "1de4388c-f06a-5de2-8620-a22fab7252f2",
          "context_vi": "Món đúng vừa được mang ra và khách bắt đầu ăn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お待たせしました。こちらが焼き魚です。",
              "vi": "Xin lỗi đã để anh chờ. Đây là món cá nướng ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。いただきます。",
              "vi": "Cảm ơn chị. Tôi xin dùng bữa."
            }
          ]
        },
        {
          "id": "sj-so-07-b07-147-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "72d35860-f51f-5d26-b6c8-489bed15a13f",
          "situation_uid": "061d58d3-0328-5c7a-99d3-f592d3fb7f33",
          "context_vi": "Hai người đã gọi xong và bắt đầu bữa ăn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "全部そろったね。",
              "vi": "Món lên đủ rồi nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "うん、いただきます。",
              "vi": "Ừ, ăn thôi."
            }
          ]
        },
        {
          "id": "sj-so-07-b07-147-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8c15dd2f-3934-5191-b35f-1ac643c2cc9f",
          "situation_uid": "0b6ab72d-f05e-57fe-9075-6dbfcc318c3e",
          "context_vi": "Khách nhận đúng đồ uống sau khi nhân viên kiểm mã.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらがご注文の紅茶です。",
              "vi": "Đây là trà đen chị gọi ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。いただきます。",
              "vi": "Cảm ơn anh. Tôi xin dùng."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-07-b07-162",
      "practice": [
        {
          "id": "sj-so-07-b07-162-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "72d35860-f51f-5d26-b6c8-489bed15a13f",
          "situation_uid": "9c24d4d6-f694-539b-88f3-cd4f8f98f34e",
          "context_vi": "Nhân viên dẫn khách vào bàn sau lúc chờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お待たせしました。こちらのお席へどうぞ。",
              "vi": "Xin lỗi đã để chị chờ. Mời chị ngồi bàn này ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。",
              "vi": "Cảm ơn anh."
            }
          ]
        },
        {
          "id": "sj-so-07-b07-162-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "72d35860-f51f-5d26-b6c8-489bed15a13f",
          "situation_uid": "77e8a9a6-1981-5576-aa8d-c6f560d917d2",
          "context_vi": "Món chờ lâu vừa được mang ra.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お待たせしました。ご注文のカレーです。",
              "vi": "Xin lỗi đã để anh chờ. Cà ri anh gọi đây ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。",
              "vi": "Cảm ơn chị."
            }
          ]
        },
        {
          "id": "sj-so-07-b07-162-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "8c15dd2f-3934-5191-b35f-1ac643c2cc9f",
          "situation_uid": "d9902c9b-f050-56ca-a6a0-02a3a614aa59",
          "context_vi": "Người đi mua đồ uống quay lại với bạn đang chờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mua",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お待たせ。飲み物、できたよ。",
              "vi": "Để cậu chờ rồi. Nước xong rồi đây."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとう。席を取っておいたよ。",
              "vi": "Cảm ơn. Tớ đã giữ chỗ rồi."
            }
          ]
        }
      ]
    }
  ]
}
