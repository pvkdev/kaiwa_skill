{
  "stage_uid": "5575eac1-dd59-5e7a-b6e0-6c1723d79e29",
  "items": [
    {
      "item_id": "sj-trung-11-b12-39",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhắc nơi đến rồi bổ sung loại hàng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "送り先はカナダです。ちなみに、中身は衣類です。",
              "vi": "Nơi nhận là Canada. À, bên trong là quần áo ạ."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。",
              "vi": "Vâng, tôi hiểu."
            }
          ],
          "id": "sj-trung-11-b12-39-ex01",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "ca17a900-d77a-5532-a875-46a9147e4d81"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kiểm địa chỉ rồi bổ sung số căn hộ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "住所はこのとおりです。ちなみに、部屋番号は最後の三〇二です。",
              "vi": "Địa chỉ đúng như đây ạ. À, số phòng là 302 ở cuối."
            },
            {
              "speaker_id": "B",
              "ja": "確認しました。",
              "vi": "Tôi đã xác nhận."
            }
          ],
          "id": "sj-trung-11-b12-39-ex02",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "8ef3d4b4-fea8-5944-a600-5d29aca3caa3"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhắc bước của người gửi và bổ sung của người nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私はここで手続きをします。ちなみに、受取人は現地で連絡が必要ですか。",
              "vi": "Tôi sẽ làm thủ tục ở đây. À, người nhận có cần liên lạc với bên giao ở nước đó không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "不在票が入った場合だけです。",
              "vi": "Chỉ khi có phiếu báo vắng ạ."
            }
          ],
          "id": "sj-trung-11-b12-39-ex03",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "1aaab415-7b55-52d9-b6bb-b95478c22350"
        }
      ]
    },
    {
      "item_id": "sj-trung-11-b12-43",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên tưởng gửi sang Pháp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "フランスへのお荷物ですね。",
              "vi": "Kiện hàng gửi sang Pháp nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "それが、送る先はフランスではなく、カナダなんです。",
              "vi": "À, thực ra nơi gửi đến không phải Pháp mà là Canada ạ."
            }
          ],
          "id": "sj-trung-11-b12-43-ex01",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "8343df53-1fa1-5e70-9103-18c988a61fa0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người nhận báo đã đổi địa chỉ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨日の住所へ配達予定です。",
              "vi": "Dự kiến giao đến địa chỉ hôm qua ạ."
            },
            {
              "speaker_id": "B",
              "ja": "それが、受取人が今朝引っ越したと連絡してきまして。",
              "vi": "Chuyện là sáng nay người nhận báo đã chuyển nhà ạ."
            }
          ],
          "id": "sj-trung-11-b12-43-ex02",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "67f8a54d-b95b-5fce-848e-6c6c2944cf3a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kiện bị trả về bất ngờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もう届いたかな。",
              "vi": "Chắc đến nơi rồi nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "それが、荷物が戻ってきたの。理由はまだ分からない。",
              "vi": "Thực ra kiện hàng bị trả lại rồi. Tớ vẫn chưa biết lý do."
            }
          ],
          "id": "sj-trung-11-b12-43-ex03",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "e078b45e-58ef-5f96-8afc-b70e7bee4a7b"
        }
      ]
    },
    {
      "item_id": "sj-trung-11-b07-108",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Một món không được nhận gửi, xử lý phần còn lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "とりあえず、この品物を抜いて、残りを送ります。",
              "vi": "Trước mắt tôi bỏ món này ra rồi gửi phần còn lại ạ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、それならお受けできます。",
              "vi": "Vâng, như vậy chúng tôi nhận gửi được."
            }
          ],
          "id": "sj-trung-11-b07-108-ex01",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "86298726-db3f-5a86-b252-579f11dcc390"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chờ đối tác nước đến phản hồi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "とりあえず、次の確認日を教えてください。",
              "vi": "Trước mắt, xin cho tôi biết ngày kiểm tra tiếp theo ạ."
            },
            {
              "speaker_id": "B",
              "ja": "来週の火曜日です。",
              "vi": "Thứ Ba tuần sau ạ."
            }
          ],
          "id": "sj-trung-11-b07-108-ex02",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "e6e45288-8ed6-5708-a7fb-331414b7e1b4"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kiện nhận bị hỏng, cần giữ chứng cứ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "とりあえず、箱と中身の写真を撮っておきます。",
              "vi": "Trước mắt tôi sẽ chụp ảnh thùng và đồ bên trong."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。箱も保管してください。",
              "vi": "Cảm ơn anh. Xin giữ cả thùng."
            }
          ],
          "id": "sj-trung-11-b07-108-ex03",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "ff7e8c33-8d1a-5fd0-b80e-56a30ff39d4b"
        }
      ]
    },
    {
      "item_id": "sj-trung-11-b06-17",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đã cân tại nhà, muốn kiểm lại tại quầy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一応家で量ったら二キロくらいでしたが、ここでも量ってもらえますか。",
              "vi": "Tôi đã cân ở nhà, khoảng hai ký, chị cân lại tại đây giúp tôi được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、量ります。",
              "vi": "Vâng, tôi sẽ cân."
            }
          ],
          "id": "sj-trung-11-b06-17-ex01",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "36fb3382-6971-5169-a794-b6fc9065acd1"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Địa chỉ đã điền nhưng muốn kiểm lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "住所は一応書きました。抜けているところがないか見ていただけますか。",
              "vi": "Tôi đã điền địa chỉ trước rồi. Chị xem có thiếu chỗ nào không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "確認します。",
              "vi": "Tôi sẽ kiểm tra."
            }
          ],
          "id": "sj-trung-11-b06-17-ex02",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "8ef3d4b4-fea8-5944-a600-5d29aca3caa3"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đã có câu trả lời sơ bộ từ đầu mối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一応、現地から返事は来ましたが、配達日はまだ未定です。",
              "vi": "Trước mắt đã có trả lời từ phía bên đó, nhưng ngày giao vẫn chưa xác định."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。決まり次第お知らせします。",
              "vi": "Tôi hiểu. Khi có ngày sẽ báo chị."
            }
          ],
          "id": "sj-trung-11-b06-17-ex03",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "526878a2-2819-541c-8222-b1ee21655c44"
        }
      ]
    },
    {
      "item_id": "sj-trung-11-b06-68",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Địa chỉ thiếu số nhà, nhân viên tạm dừng tiếp nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "番地が足りないようです。今日はここまでにしましょう。",
              "vi": "Có vẻ thiếu số nhà. Hôm nay mình dừng ở đây nhé ạ."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。確認してまた来ます。",
              "vi": "Tôi hiểu rồi. Tôi sẽ kiểm tra rồi quay lại."
            }
          ],
          "id": "sj-trung-11-b06-68-ex01",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "3d9f262e-0ecb-5d80-8d68-660462c25dbc"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quầy chưa có cập nhật sau mốc đã hẹn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まだ回答がないので、今日はここまでにしましょう。",
              "vi": "Vẫn chưa có trả lời nên hôm nay ta dừng ở đây ạ."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。次はいつ確認できますか。",
              "vi": "Tôi hiểu. Khi nào tôi hỏi lại được ạ?"
            }
          ],
          "id": "sj-trung-11-b06-68-ex02",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "2361fdcb-b1b4-5be7-adf2-58450546507d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi chốt đầu mối và hạn phản hồi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来週水曜日に担当からお電話します。今日はここまでにしましょう。",
              "vi": "Thứ Tư tuần sau người phụ trách sẽ gọi. Hôm nay ta dừng ở đây ạ."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。よろしくお願いします。",
              "vi": "Tôi hiểu. Nhờ anh ạ."
            }
          ],
          "id": "sj-trung-11-b06-68-ex03",
          "topic_uid": "435486f2-9c27-5220-9c44-bdcfca5d9d3e",
          "situation_uid": "27f03e90-ef9f-5249-95e6-ffee11abfbec"
        }
      ]
    }
  ]
}
