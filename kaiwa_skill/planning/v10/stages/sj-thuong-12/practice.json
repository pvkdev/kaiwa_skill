{
  "stage_uid": "ede6760c-cef5-596f-9b96-4cc4a78d4312",
  "items": [
    {
      "item_id": "sj-thuong-12-b06-2095",
      "practice": [
        {
          "id": "sj-thuong-12-b06-2095-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "0cdf995e-3b39-5842-b318-bab803f95731",
          "situation_uid": "00833278-c4e6-54a1-8893-4921042f7df9",
          "context_vi": "Phí gia hạn khác lời giải thích cũ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Chủ nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người thuê nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "更新には事務手数料も必要です。",
              "vi": "Gia hạn cần thêm phí làm thủ tục."
            },
            {
              "speaker_id": "B",
              "ja": "前回は更新料だけと伺いました。話が違います。どの費用が追加されたのでしょうか。",
              "vi": "Lần trước tôi được báo chỉ có phí gia hạn. Như vậy khác điều đã nói. Khoản nào mới thêm vào ạ?"
            }
          ]
        },
        {
          "id": "sj-thuong-12-b06-2095-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "33186026-5220-566b-b1b8-69c5262b821d",
          "situation_uid": "3c234d18-6888-5313-9afc-06570e2cfa54",
          "context_vi": "Hai cơ sở nói khác về hồ sơ đã gửi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bảo hiểm",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người thuê nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "病院からの書類はまだ届いていません。",
              "vi": "Chúng tôi chưa nhận được giấy tờ từ bệnh viện."
            },
            {
              "speaker_id": "B",
              "ja": "病院には先週送ったと言われました。話が違うので、送付先と日付を確認していただけますか。",
              "vi": "Bệnh viện nói đã gửi tuần trước. Thông tin không khớp, chị kiểm nơi nhận và ngày gửi được không?"
            }
          ]
        },
        {
          "id": "sj-thuong-12-b06-2095-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1fbfdfc-8d11-5ae8-a4c1-855b65ad5b8e",
          "situation_uid": "3df73e5f-cae2-5e40-9c86-126a171a71ec",
          "context_vi": "Gia đình và người bệnh nghe khác lời bác sĩ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người bệnh",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bác sĩ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "家族は来週すぐ治療を始めると理解していますが、私は検査後に決めると聞きました。話が違うので、もう一度説明いただけますか。",
              "vi": "Gia đình tôi hiểu là tuần sau bắt đầu điều trị ngay, còn tôi nghe là quyết sau khi xét nghiệm. Hai cách hiểu khác nhau, bác sĩ giải thích lại được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。順番から確認しましょう。",
              "vi": "Được. Ta kiểm lại thứ tự từng bước nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-12-b20-1746",
      "practice": [
        {
          "id": "sj-thuong-12-b20-1746-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "0cdf995e-3b39-5842-b318-bab803f95731",
          "situation_uid": "1ab8af74-ed84-5756-ac47-46ecee104b10",
          "context_vi": "Chủ nhà chỉ hỗ trợ một phần phí sửa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Chủ nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người thuê nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "修理費の半分は負担します。",
              "vi": "Tôi sẽ chịu một nửa chi phí sửa."
            },
            {
              "speaker_id": "B",
              "ja": "百歩譲って半分だとしても、入居前からあった傷の分は別に考えていただけませんか。",
              "vi": "Dù tạm chấp nhận chia đôi, phần vết hỏng có trước khi tôi vào ở có thể xét riêng không ạ?"
            }
          ]
        },
        {
          "id": "sj-thuong-12-b20-1746-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "0cdf995e-3b39-5842-b318-bab803f95731",
          "situation_uid": "01c3aaf0-e770-516f-9202-b8f06462eb75",
          "context_vi": "Tranh luận khoản cụ thể trong số tiền cuối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người thuê nhà",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Chủ nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "百歩譲って清掃費を払うとしても、この交換費用の根拠はまだ分かりません。",
              "vi": "Dù tạm chấp nhận trả phí dọn dẹp, tôi vẫn chưa hiểu căn cứ khoản phí thay mới này."
            },
            {
              "speaker_id": "B",
              "ja": "明細を確認してお伝えします。",
              "vi": "Tôi sẽ kiểm bảng chi tiết rồi báo."
            }
          ]
        },
        {
          "id": "sj-thuong-12-b20-1746-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "0cdf995e-3b39-5842-b318-bab803f95731",
          "situation_uid": "265475b0-7d68-5ff9-8e30-55f36ac4fe85",
          "context_vi": "Còn bất đồng về một điều kiện gia hạn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Chủ nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người thuê nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "契約期間だけは変えられません。",
              "vi": "Riêng thời hạn hợp đồng không đổi được."
            },
            {
              "speaker_id": "B",
              "ja": "百歩譲って期間は受け入れるとしても、追加手数料までは同意できません。",
              "vi": "Dù tạm chấp nhận thời hạn đó, tôi không thể đồng ý cả khoản phí bổ sung."
            },
            {
              "speaker_id": "A",
              "ja": "費用はもう一度確認します。",
              "vi": "Tôi sẽ kiểm lại phần chi phí."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-12-b20-1686",
      "practice": [
        {
          "id": "sj-thuong-12-b20-1686-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "0cdf995e-3b39-5842-b318-bab803f95731",
          "situation_uid": "af332c9a-873f-573d-8db2-965a0ba99be7",
          "context_vi": "Sau buổi kiểm, chủ nhà bỏ qua một vết xước nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Chủ nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người thuê nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "小さな傷は今回は大目に見ます。修理費には入れません。",
              "vi": "Vết xước nhỏ lần này tôi sẽ bỏ qua, không tính phí sửa."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。ほかの項目も確認させてください。",
              "vi": "Cảm ơn anh. Xin cho tôi kiểm tra các khoản khác nữa."
            }
          ]
        },
        {
          "id": "sj-thuong-12-b20-1686-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "0cdf995e-3b39-5842-b318-bab803f95731",
          "situation_uid": "01c3aaf0-e770-516f-9202-b8f06462eb75",
          "context_vi": "Trong bảng phí cuối, người thuê nhận một vết xước nhỏ do mình gây ra và xin chủ nhà xem xét.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người thuê nhà",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Chủ nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この小さな傷は私がつけました。ほかの修繕費は負担しますので、今回は大目に見ていただけませんか。",
              "vi": "Vết xước nhỏ này là do tôi gây ra. Tôi sẽ chịu các khoản sửa khác, nên lần này anh có thể xem xét bỏ qua khoản này không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "その部分は明細を見て検討します。",
              "vi": "Tôi sẽ xem bảng chi tiết rồi cân nhắc khoản đó."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-12-b12-2483",
      "practice": [
        {
          "id": "sj-thuong-12-b12-2483-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "0cdf995e-3b39-5842-b318-bab803f95731",
          "situation_uid": "aa078bb2-c7ea-59a8-a618-7814ca64e344",
          "context_vi": "Chủ nhà đề nghị kỳ hạn dài hơn, người thuê còn điều kiện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Chủ nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người thuê nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二年契約なら更新できます。",
              "vi": "Nếu ký hai năm thì có thể gia hạn."
            },
            {
              "speaker_id": "B",
              "ja": "二年はちょっと…。手数料を下げられるなら考えたいです。",
              "vi": "Hai năm thì hơi khó... Nếu có thể giảm phí thủ tục, tôi muốn cân nhắc."
            }
          ]
        },
        {
          "id": "sj-thuong-12-b12-2483-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1fbfdfc-8d11-5ae8-a4c1-855b65ad5b8e",
          "situation_uid": "2d84de9c-db1b-571a-a633-1d0a0e98f53d",
          "context_vi": "Bác sĩ hỏi có quyết phương án ngay không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bác sĩ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người bệnh",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日、方針を決められますか。",
              "vi": "Hôm nay anh quyết phương án được không?"
            },
            {
              "speaker_id": "B",
              "ja": "今日すぐはちょっと…。家族とも話して、いつまでに返事すればよいですか。",
              "vi": "Quyết ngay hôm nay thì hơi khó... Tôi muốn trao đổi với gia đình; tôi cần trả lời trước khi nào ạ?"
            }
          ]
        },
        {
          "id": "sj-thuong-12-b12-2483-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "62ab5d29-ea70-5a5b-9112-022a8422edcd",
          "situation_uid": "4a3cffcc-f901-508e-8c59-699cc80d90f8",
          "context_vi": "Quầy đề nghị liên hệ qua số không an toàn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người tư vấn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người thuê nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご自宅の電話に折り返します。",
              "vi": "Chúng tôi sẽ gọi lại số máy nhà chị."
            },
            {
              "speaker_id": "B",
              "ja": "自宅への電話はちょっと…。こちらの携帯に、午後だけお願いします。",
              "vi": "Gọi máy nhà thì hơi khó... Xin chỉ gọi vào di động này vào buổi chiều."
            }
          ]
        }
      ]
    }
  ]
}
