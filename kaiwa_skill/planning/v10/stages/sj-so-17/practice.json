{
  "stage_uid": "e8a7d70c-9f8f-54db-bdd5-063b3801c9c1",
  "items": [
    {
      "item_id": "sj-so-17-b24-33",
      "practice": [
        {
          "id": "sj-so-17-b24-33-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "25d84288-a4c1-525e-bcbf-615f4b296b8f",
          "context_vi": "Bạn kể muốn đi vùng có suối nước nóng lần đầu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来月、山の温泉町に行きたいんだ。",
              "vi": "Tháng sau tớ muốn đến thị trấn suối nước nóng trên núi."
            },
            {
              "speaker_id": "B",
              "ja": "面白そう。何日くらい行く予定？",
              "vi": "Nghe thú vị đấy. Cậu định đi mấy ngày?"
            }
          ]
        },
        {
          "id": "sj-so-17-b24-33-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "8242714d-3735-50ee-be34-6a480bce2d91",
          "context_vi": "Bạn gợi ngủ lại để xem chợ sáng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nghe",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一泊すれば朝市にも行けるよ。",
              "vi": "Nếu ngủ lại một đêm, mình còn đi chợ sáng được."
            },
            {
              "speaker_id": "B",
              "ja": "面白そう。一泊にしようか。",
              "vi": "Nghe thú vị đấy. Hay mình ở một đêm nhé?"
            }
          ]
        },
        {
          "id": "sj-so-17-b24-33-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "03d93a87-0096-5ac9-a11a-852344d64ef9",
          "context_vi": "Nhân viên khách sạn giới thiệu tuyến đi bộ đến khu phố cổ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "川沿いを歩くと、古い町並みが見られます。",
              "vi": "Đi dọc bờ sông là chị sẽ thấy khu phố cổ ạ."
            },
            {
              "speaker_id": "B",
              "ja": "面白そうですね。午後に行ってみます。",
              "vi": "Nghe thú vị quá. Chiều tôi sẽ thử đi."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-17-b24-34",
      "practice": [
        {
          "id": "sj-so-17-b24-34-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "25d84288-a4c1-525e-bcbf-615f4b296b8f",
          "context_vi": "Bạn hỏi điều người kia mong nhất ở chuyến đi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người sắp đi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "旅行で一番の楽しみは何？",
              "vi": "Trong chuyến đi, điều cậu mong nhất là gì?"
            },
            {
              "speaker_id": "B",
              "ja": "朝の海を見ることかな。",
              "vi": "Chắc là ngắm biển buổi sáng."
            }
          ]
        },
        {
          "id": "sj-so-17-b24-34-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "339fa90d-0aaa-5587-be3b-2e2f1fce6f45",
          "context_vi": "Hai bạn chốt ngày đi và nói về điều mong chờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来週の土曜日に出発だね。",
              "vi": "Thứ Bảy tuần sau mình khởi hành nhé."
            },
            {
              "speaker_id": "B",
              "ja": "うん。海辺の朝ごはんが楽しみ。",
              "vi": "Ừ. Tớ mong được ăn sáng bên biển."
            }
          ]
        },
        {
          "id": "sj-so-17-b24-34-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "d06238a6-17ea-5416-a797-7c57f71efa39",
          "context_vi": "Chuyến đi rút xuống một ngày, bạn vẫn giữ điều mong chờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一日だけでも行けそうだよ。",
              "vi": "Một ngày thôi thì tớ vẫn đi được."
            },
            {
              "speaker_id": "B",
              "ja": "よかった。港を見るのが楽しみだね。",
              "vi": "Tốt quá. Mong được ngắm bến cảng nhỉ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-17-b07-196",
      "practice": [
        {
          "id": "sj-so-17-b07-196-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "25d84288-a4c1-525e-bcbf-615f4b296b8f",
          "context_vi": "Người quen nghe bạn sắp đi du lịch.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người sắp đi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người quen",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来週、初めて京都へ行くんです。",
              "vi": "Tuần sau tôi đến Kyoto lần đầu ạ."
            },
            {
              "speaker_id": "B",
              "ja": "いいですね。よいご旅行を。",
              "vi": "Hay quá. Chúc chị có chuyến đi vui vẻ."
            },
            {
              "speaker_id": "A",
              "ja": "ありがとうございます。",
              "vi": "Cảm ơn anh."
            }
          ]
        },
        {
          "id": "sj-so-17-b07-196-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "339fa90d-0aaa-5587-be3b-2e2f1fce6f45",
          "context_vi": "Hai bạn đã chốt ngày và một người đi trước.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người sắp đi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日の朝、出発するよ。",
              "vi": "Sáng mai tớ đi rồi."
            },
            {
              "speaker_id": "B",
              "ja": "よいご旅行を。帰ったら話を聞かせてね。",
              "vi": "Chúc cậu chuyến đi vui. Về rồi kể tớ nghe nhé."
            },
            {
              "speaker_id": "A",
              "ja": "うん、ありがとう。",
              "vi": "Ừ, cảm ơn cậu."
            }
          ]
        },
        {
          "id": "sj-so-17-b07-196-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "26f5411d-33e5-593e-83ca-f51ee4b78f5a",
          "situation_uid": "14ec82bb-587f-503a-b682-f85d6c50d41d",
          "context_vi": "Nhân viên sân bay xác nhận cổng mới rồi chúc hành khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Hành khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "新しい搭乗口は七番です。よいご旅行を。",
              "vi": "Cổng lên máy bay mới là cổng số bảy ạ. Chúc anh có chuyến đi vui vẻ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。七番ですね。",
              "vi": "Cảm ơn chị. Cổng số bảy ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-17-b07-39",
      "practice": [
        {
          "id": "sj-so-17-b07-39-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "8242714d-3735-50ee-be34-6a480bce2d91",
          "context_vi": "Bạn quyết định ở hai đêm tại nơi muốn đến.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二泊ならゆっくりできるね。",
              "vi": "Ở hai đêm thì mình thong thả được nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "うん、今から楽しみです。",
              "vi": "Ừ, tớ đã mong chờ từ bây giờ rồi."
            }
          ]
        },
        {
          "id": "sj-so-17-b07-39-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "339fa90d-0aaa-5587-be3b-2e2f1fce6f45",
          "context_vi": "Người đi nói điều háo hức sau khi chốt ngày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来月の旅行、楽しみです。",
              "vi": "Tôi rất mong chuyến đi tháng sau."
            },
            {
              "speaker_id": "B",
              "ja": "私もです。もう宿を調べました。",
              "vi": "Tôi cũng vậy. Tôi đã tìm chỗ ở rồi."
            }
          ]
        },
        {
          "id": "sj-so-17-b07-39-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4018562d-44c4-5e72-9274-28b090befd0d",
          "situation_uid": "03d93a87-0096-5ac9-a11a-852344d64ef9",
          "context_vi": "Khách sắp tới điểm tham quan từ khách sạn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この町を歩くのは初めてです。楽しみです。",
              "vi": "Đây là lần đầu tôi đi dạo trong thị trấn này. Tôi háo hức lắm."
            },
            {
              "speaker_id": "B",
              "ja": "川沿いの道がおすすめです。",
              "vi": "Tôi gợi ý anh đi dọc bờ sông ạ."
            }
          ]
        }
      ]
    }
  ]
}
