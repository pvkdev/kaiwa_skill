{
  "stage_uid": "ca0063a9-b55f-5f9e-84b4-78e209fc8f18",
  "items": [
    {
      "item_id": "sj-trung-33-b20-169",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người mang thiết bị báo bận sát ngày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "器具を持ってくる人がドタキャンしたから、代わりを探そう。",
              "vi": "Người mang dụng cụ hủy sát giờ rồi, mình tìm người thay nhé."
            },
            {
              "speaker_id": "B",
              "ja": "私が確認してみる。",
              "vi": "Để tớ hỏi thử."
            }
          ],
          "id": "sj-trung-33-b20-169-ex01",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "26bbb0bf-96bd-5339-a37e-56eeb88e1559"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Một người hủy ngay trước ngày đi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日の参加、急に無理になったって。",
              "vi": "Người đó đột nhiên không đi ngày mai được."
            },
            {
              "speaker_id": "B",
              "ja": "ドタキャンか。人数を施設に伝えよう。",
              "vi": "Hủy sát giờ à. Mình báo lại số người cho nơi cắm trại."
            }
          ],
          "id": "sj-trung-33-b20-169-ex02",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "53ee64e6-2685-5682-9e77-42934bf0a270"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau chuyến, hỏi về người hủy phút cuối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あの人、結局来なかったね。",
              "vi": "Rốt cuộc người ấy không đến nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "うん、ドタキャンだったけど、体調が悪かったらしい。",
              "vi": "Ừ, hủy sát giờ nhưng nghe nói họ bị mệt."
            }
          ],
          "id": "sj-trung-33-b20-169-ex03",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "742db0bf-4a4d-5d6e-b3d0-05e4c804b313"
        }
      ]
    },
    {
      "item_id": "sj-trung-33-b11-65",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nói dở lý do phải đổi thực đơn để bạn tự đề xuất.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一人、肉が食べられなくて…。",
              "vi": "Có một người không ăn thịt được nên..."
            },
            {
              "speaker_id": "B",
              "ja": "じゃあ、本人に聞いて、野菜のメニューも用意しよう。",
              "vi": "Vậy mình hỏi chính bạn ấy rồi chuẩn bị thêm món rau nhé."
            }
          ],
          "id": "sj-trung-33-b11-65-ex01",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "d5ae731a-6d48-5e52-ab29-3d47fcb4c6f7"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nêu dở lý do đổi kế hoạch vì thời tiết.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "天気が変わって…。",
              "vi": "Thời tiết đổi nên..."
            },
            {
              "speaker_id": "B",
              "ja": "じゃあ、安全に使える場所を係の人に聞こう。",
              "vi": "Vậy mình hỏi người phụ trách chỗ nào còn dùng an toàn."
            }
          ],
          "id": "sj-trung-33-b11-65-ex02",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "2f2da010-bd46-58ad-b3b2-39f5504828f9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nói dở lý do không thể mang nguyên liệu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日、急に仕事が入って…。",
              "vi": "Mai tớ đột nhiên có việc nên..."
            },
            {
              "speaker_id": "B",
              "ja": "食材を買いに行けなくなったんだね。分かった、私が買うよ。",
              "vi": "Cậu không đi mua nguyên liệu được nhỉ. Tớ hiểu rồi, để tớ mua."
            }
          ],
          "id": "sj-trung-33-b11-65-ex03",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "26bbb0bf-96bd-5339-a37e-56eeb88e1559"
        }
      ]
    },
    {
      "item_id": "sj-trung-33-b12-36",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khu chọn không cho dùng lửa, đổi hoạt động.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その場所では火が使えないそうです。というわけで、バーベキューは別の区画にしましょう。",
              "vi": "Nghe nói chỗ đó không được dùng lửa. Vì vậy mình chuyển BBQ sang khu khác nhé."
            },
            {
              "speaker_id": "B",
              "ja": "空きを確認しよう。",
              "vi": "Hỏi xem còn chỗ không."
            }
          ],
          "id": "sj-trung-33-b12-36-ex01",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "40293dec-e37a-5a8f-9d37-53769655780c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thời tiết xấu, nhóm đổi kế hoạch.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "午後は強い雨の予報です。というわけで、今日は早めに帰ります。",
              "vi": "Dự báo chiều mưa lớn. Vì vậy hôm nay mình về sớm."
            },
            {
              "speaker_id": "B",
              "ja": "分かった。片づけを始めよう。",
              "vi": "Ừ. Bắt đầu dọn đi."
            }
          ],
          "id": "sj-trung-33-b12-36-ex02",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "2f2da010-bd46-58ad-b3b2-39f5504828f9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai người tưởng bên kia đặt chỗ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まだ誰も予約していませんでした。というわけで、今から私が電話します。",
              "vi": "Hóa ra vẫn chưa ai đặt chỗ. Vậy bây giờ tớ sẽ gọi."
            },
            {
              "speaker_id": "B",
              "ja": "お願い。",
              "vi": "Nhờ cậu."
            }
          ],
          "id": "sj-trung-33-b12-36-ex03",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "d6ea820d-0cd3-573c-8eab-106d58d9b561"
        }
      ]
    },
    {
      "item_id": "sj-trung-33-b07-100",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Giờ khu còn trống không hợp cả nhóm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "夕方の枠しか空いてないって。",
              "vi": "Họ bảo chỉ còn khung chiều tối."
            },
            {
              "speaker_id": "B",
              "ja": "急いで決めなくていいよ。また今度でもいい。",
              "vi": "Không cần quyết vội. Để lần sau cũng được."
            }
          ],
          "id": "sj-trung-33-b07-100-ex01",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "66e0baf3-550b-5953-afaf-d6fa8122c738"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Không có chỗ nướng BBQ phù hợp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "火が使える区画が空いてないなら、バーベキューはまた今度でいいよ。",
              "vi": "Nếu khu cho phép dùng lửa đã hết chỗ, để BBQ lần sau cũng được."
            },
            {
              "speaker_id": "B",
              "ja": "今日は散歩だけにしようか。",
              "vi": "Hôm nay mình đi dạo thôi nhé?"
            }
          ],
          "id": "sj-trung-33-b07-100-ex02",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "40293dec-e37a-5a8f-9d37-53769655780c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhóm về sớm, bạn rủ tổ chức bù ngay tuần sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来週もう一回やる？",
              "vi": "Tuần sau làm lại lần nữa không?"
            },
            {
              "speaker_id": "B",
              "ja": "また今度でいいよ。まず今回の道具を片づけよう。",
              "vi": "Để lần sau cũng được. Trước hết dọn dụng cụ hôm nay đã."
            }
          ],
          "id": "sj-trung-33-b07-100-ex03",
          "topic_uid": "5383dcce-3ea8-5f09-bc34-f8d2fd568773",
          "situation_uid": "594350ce-2042-5d60-a2a1-33a3f39a7bcc"
        }
      ]
    }
  ]
}
