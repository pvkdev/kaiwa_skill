{
  "stage_uid": "6b14baef-c0ad-5a3f-a3c5-256cd7aa77eb",
  "items": [
    {
      "item_id": "sj-so-02-b07-157",
      "practice": [
        {
          "id": "sj-so-02-b07-157-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4a8889f8-b866-5ef2-80af-9186770fe19f",
          "situation_uid": "0442a0e4-e850-5534-9a2d-667a972f079d",
          "context_vi": "Người mới chuyển đến được hàng xóm mời vào nhà nói chuyện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mới",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Hàng xóm",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どうぞ、お入りください。",
              "vi": "Mời anh vào nhà."
            },
            {
              "speaker_id": "B",
              "ja": "お邪魔します。隣の部屋に越してきました。",
              "vi": "Tôi xin phép vào. Tôi vừa chuyển đến phòng bên cạnh."
            }
          ]
        },
        {
          "id": "sj-so-02-b07-157-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4a8889f8-b866-5ef2-80af-9186770fe19f",
          "situation_uid": "920db456-6053-53ee-9ea6-e2d613f6d7c2",
          "context_vi": "Sau khi hàng xóm giúp dời đồ chắn lối, người mới ra về.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mới",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Hàng xóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日はお邪魔しました。通路のこと、ありがとうございました。",
              "vi": "Hôm nay tôi xin phép về. Cảm ơn anh đã giúp chuyện hành lang."
            },
            {
              "speaker_id": "B",
              "ja": "いえいえ。また何かあれば声をかけてください。",
              "vi": "Không có gì. Có việc gì nữa cứ gọi tôi nhé."
            }
          ]
        },
        {
          "id": "sj-so-02-b07-157-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7e8bb5e2-9e23-5e68-821f-03b5d688c10c",
          "situation_uid": "74a623bf-0cfc-53b0-b13e-2bf497561fdd",
          "context_vi": "Bạn cùng phòng mời người mới vào xem chỗ để đồ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn cùng phòng",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người mới",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こっちに棚があります。入ってください。",
              "vi": "Có kệ ở phía này. Cậu vào đi."
            },
            {
              "speaker_id": "B",
              "ja": "お邪魔します。どこを使えばいい？",
              "vi": "Tớ xin phép vào nhé. Tớ dùng chỗ nào?"
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-02-b07-38",
      "practice": [
        {
          "id": "sj-so-02-b07-38-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4a8889f8-b866-5ef2-80af-9186770fe19f",
          "situation_uid": "0de8e2a5-97df-5025-94a6-6da53a5ca858",
          "context_vi": "Người ở cùng giúp chỉ cách dùng máy giặt chung.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người ở mới",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người ở cùng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "このボタンを押せば動きますよ。",
              "vi": "Bấm nút này là máy chạy nhé."
            },
            {
              "speaker_id": "B",
              "ja": "助かります。一人ではわからなくて。",
              "vi": "Vậy thì giúp tôi nhiều quá. Một mình tôi không biết dùng."
            }
          ]
        },
        {
          "id": "sj-so-02-b07-38-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7e8bb5e2-9e23-5e68-821f-03b5d688c10c",
          "situation_uid": "74a623bf-0cfc-53b0-b13e-2bf497561fdd",
          "context_vi": "Bạn cùng phòng sắp xếp chỗ để hành lý cho người mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mới",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn cùng phòng",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "荷物はこの棚の下に置いていいよ。",
              "vi": "Cậu để hành lý dưới kệ này được đấy."
            },
            {
              "speaker_id": "B",
              "ja": "助かるよ。置く場所に困ってたんだ。",
              "vi": "May quá, tớ đang không biết để đâu."
            }
          ]
        },
        {
          "id": "sj-so-02-b07-38-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "0451e369-ff04-5aa8-9946-5815f12ae2c4",
          "situation_uid": "0902a38e-ad39-57cf-b94b-7a5b57ca7ceb",
          "context_vi": "Nhân viên thư viện dẫn người mới đến đúng phòng sinh hoạt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người tham gia",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "部屋までご案内します。こちらです。",
              "vi": "Tôi dẫn chị đến phòng. Lối này ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。助かります。",
              "vi": "Cảm ơn anh. Thế thì đỡ cho tôi quá."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-02-b07-179",
      "practice": [
        {
          "id": "sj-so-02-b07-179-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "4a8889f8-b866-5ef2-80af-9186770fe19f",
          "situation_uid": "8d647bd9-2dfe-5c27-a62b-4091cc6cb792",
          "context_vi": "Người ở mới xin phép bước vào phòng có người đang dùng đồ chung.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người ở mới",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người ở cùng",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "失礼します。この机、使ってもいいですか。",
              "vi": "Xin phép tôi vào. Tôi dùng chiếc bàn này được không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、どうぞ。",
              "vi": "Ừ, cứ dùng đi."
            }
          ]
        },
        {
          "id": "sj-so-02-b07-179-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "7e8bb5e2-9e23-5e68-821f-03b5d688c10c",
          "situation_uid": "47383413-d5aa-50d3-bc59-93720045c647",
          "context_vi": "Người ở ký túc vào phòng quản lý hỏi đầu mối sửa thiết bị.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người ở",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "失礼します。エアコンのことで伺いたいんですが。",
              "vi": "Xin phép vào ạ. Tôi muốn hỏi về máy điều hòa."
            },
            {
              "speaker_id": "B",
              "ja": "はい、どうしましたか。",
              "vi": "Vâng, máy có vấn đề gì ạ?"
            }
          ]
        },
        {
          "id": "sj-so-02-b07-179-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "0451e369-ff04-5aa8-9946-5815f12ae2c4",
          "situation_uid": "0902a38e-ad39-57cf-b94b-7a5b57ca7ceb",
          "context_vi": "Ở thư viện, người học đi qua trước mặt hai người đang đọc để tìm phòng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người học",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người đọc sách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前を失礼します。会議室はこの先ですか。",
              "vi": "Xin lỗi, cho tôi đi qua phía trước. Phòng họp ở phía trước phải không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、右側です。",
              "vi": "Vâng, bên phải ạ."
            }
          ]
        }
      ]
    }
  ]
}
