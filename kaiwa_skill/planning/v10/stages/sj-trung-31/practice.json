{
  "stage_uid": "b803c2e4-da87-5135-a4fc-0e713ca2a630",
  "items": [
    {
      "item_id": "sj-trung-31-b18-2871",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên nhận yêu cầu thêm gối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "三〇二号室に枕を一つお願いします。",
              "vi": "Cho tôi xin thêm một chiếc gối lên phòng 302."
            },
            {
              "speaker_id": "B",
              "ja": "承知いたしました。お部屋にお持ちします。",
              "vi": "Vâng ạ. Tôi sẽ mang lên phòng."
            }
          ],
          "id": "sj-trung-31-b18-2871-ex01",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "3b00966e-d022-570c-b51f-a23b682310b4"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên tiếp nhận mô tả đồ bỏ quên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "黒い傘を忘れたかもしれません。",
              "vi": "Có lẽ tôi để quên chiếc ô đen."
            },
            {
              "speaker_id": "B",
              "ja": "承知いたしました。忘れ物を確認いたします。",
              "vi": "Vâng ạ. Tôi sẽ kiểm tra đồ thất lạc."
            }
          ],
          "id": "sj-trung-31-b18-2871-ex02",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "fb13581c-37e7-566d-b95e-6417740606db"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách phản đối khoản trên hóa đơn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この追加料金には覚えがありません。",
              "vi": "Tôi không nhớ đã dùng dịch vụ tính thêm khoản này."
            },
            {
              "speaker_id": "B",
              "ja": "承知いたしました。記録を確認しますので、少々お待ちください。",
              "vi": "Tôi hiểu rồi ạ. Xin đợi chút để tôi kiểm tra ghi chép."
            }
          ],
          "id": "sj-trung-31-b18-2871-ex03",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "9f37f628-b895-5437-9fa3-67bd1199a4b8"
        }
      ]
    },
    {
      "item_id": "sj-trung-31-b07-121",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách hoảng vì nghĩ mất đồ quan trọng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "財布が見つからないんです！",
              "vi": "Tôi không tìm thấy ví!"
            },
            {
              "speaker_id": "B",
              "ja": "落ち着いてください。最後に見た場所を一緒に確認しましょう。",
              "vi": "Xin bình tĩnh ạ. Ta cùng xem nơi cuối cùng quý khách thấy ví."
            }
          ],
          "id": "sj-trung-31-b07-121-ex01",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "fb13581c-37e7-566d-b95e-6417740606db"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách hoảng vì điều hòa trục trặc khi đi cùng trẻ nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "子どもが暑がって泣いています。どうしたらいいんですか。",
              "vi": "Con tôi nóng quá đang khóc. Tôi phải làm sao đây?"
            },
            {
              "speaker_id": "B",
              "ja": "落ち着いてください。すぐ別のお部屋を確認します。",
              "vi": "Xin anh bình tĩnh. Chúng tôi sẽ kiểm tra phòng khác ngay."
            }
          ],
          "id": "sj-trung-31-b07-121-ex02",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "d9cec75c-ccc6-54e6-a8fc-c8b40b760875"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Điều hòa hỏng, khách sợ không có chỗ ngủ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今夜どうしたらいいんですか。",
              "vi": "Tối nay tôi phải làm sao đây?"
            },
            {
              "speaker_id": "B",
              "ja": "落ち着いてください。別のお部屋を確認しています。",
              "vi": "Xin bình tĩnh ạ. Chúng tôi đang kiểm tra phòng khác."
            }
          ],
          "id": "sj-trung-31-b07-121-ex03",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "d9cec75c-ccc6-54e6-a8fc-c8b40b760875"
        }
      ]
    },
    {
      "item_id": "sj-trung-31-b07-172",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi phát hiện tính sai, nhân viên xin lỗi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらの確認不足でした。ご迷惑をおかけしました。",
              "vi": "Chúng tôi kiểm tra thiếu. Xin lỗi đã gây phiền cho quý khách."
            },
            {
              "speaker_id": "B",
              "ja": "訂正後の金額を教えてください。",
              "vi": "Xin cho tôi biết số tiền sau khi sửa."
            }
          ],
          "id": "sj-trung-31-b07-172-ex01",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "31b427ae-cb74-5866-a64c-efe7651c45e9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên mang sai món khách cần.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "別のお部屋のご注文をお持ちしてしまいました。ご迷惑をおかけしました。",
              "vi": "Tôi đã mang nhầm yêu cầu của phòng khác. Xin lỗi đã gây phiền cho chị."
            },
            {
              "speaker_id": "B",
              "ja": "では、私が頼んだ毛布をお願いします。",
              "vi": "Vậy xin mang chiếc chăn tôi đã nhờ."
            }
          ],
          "id": "sj-trung-31-b07-172-ex02",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "f8b57876-cc34-56ba-86d4-e26b6aed2ca5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Điều hòa hỏng làm khách bất tiện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "空調の不具合でご迷惑をおかけしました。今、別のお部屋を確認しています。",
              "vi": "Điều hòa trục trặc gây bất tiện cho quý khách, chúng tôi rất xin lỗi. Hiện đang kiểm tra phòng khác."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。",
              "vi": "Tôi hiểu rồi."
            }
          ],
          "id": "sj-trung-31-b07-172-ex03",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "d9cec75c-ccc6-54e6-a8fc-c8b40b760875"
        }
      ]
    },
    {
      "item_id": "sj-trung-31-b12-59",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khoản tính sai đã được sửa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "誤った料金を取り消しました。",
              "vi": "Chúng tôi đã xóa khoản tính sai."
            },
            {
              "speaker_id": "B",
              "ja": "よかったです。新しい合計をお願いします。",
              "vi": "May quá. Xin cho tôi biết tổng mới."
            }
          ],
          "id": "sj-trung-31-b12-59-ex01",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "31b427ae-cb74-5866-a64c-efe7651c45e9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đồ thất lạc đã được tìm thấy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "傘が見つかりました。受付でお預かりしています。",
              "vi": "Đã tìm thấy ô, chúng tôi đang giữ ở quầy lễ tân."
            },
            {
              "speaker_id": "B",
              "ja": "よかった。取りに行きます。",
              "vi": "May quá. Tôi sẽ đến lấy."
            }
          ],
          "id": "sj-trung-31-b12-59-ex02",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "8d956945-f70d-5453-885d-b681e3980c2a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đã có phòng khác phù hợp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "静かなお部屋をご用意できました。",
              "vi": "Chúng tôi đã chuẩn bị được phòng yên tĩnh."
            },
            {
              "speaker_id": "B",
              "ja": "よかったです。そちらに移ります。",
              "vi": "May quá. Tôi sẽ chuyển sang đó."
            }
          ],
          "id": "sj-trung-31-b12-59-ex03",
          "topic_uid": "30c05b26-5871-550c-890c-87f254c63535",
          "situation_uid": "31198b4e-bba9-5ee3-9e69-d03c10661ed7"
        }
      ]
    }
  ]
}
