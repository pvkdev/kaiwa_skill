{
  "stage_uid": "27168f5c-36be-53ba-8640-59a48f434a31",
  "items": [
    {
      "item_id": "sj-thuong-01-b18-651",
      "practice": [
        {
          "id": "sj-thuong-01-b18-651-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "446f1748-eaee-5340-a474-5b4b01c0c9ef",
          "situation_uid": "cab28fde-da97-5862-9c02-ac9dd05c6947",
          "context_vi": "Gọi lần đầu, xác định bộ phận phụ trách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Lễ tân đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "御社で物流システムをご担当の方におつなぎいただけますか。",
              "vi": "Cho tôi xin gặp người phụ trách hệ thống logistics bên quý công ty được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "担当部署を確認いたします。",
              "vi": "Để tôi kiểm tra bộ phận phụ trách ạ."
            }
          ]
        },
        {
          "id": "sj-thuong-01-b18-651-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "446f1748-eaee-5340-a474-5b4b01c0c9ef",
          "situation_uid": "86f9e9f4-a10b-56dd-8cc4-dc3c7fd912b0",
          "context_vi": "Khách hiểu nhầm phạm vi lời giới thiệu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "御社の採用システムではなく、配送管理についてご相談したくお電話しました。",
              "vi": "Tôi gọi để trao đổi về quản lý giao hàng, chứ không phải hệ thống tuyển dụng của quý công ty ạ."
            },
            {
              "speaker_id": "B",
              "ja": "失礼しました。物流の件ですね。",
              "vi": "Tôi xin lỗi. Là về logistics nhỉ."
            }
          ]
        },
        {
          "id": "sj-thuong-01-b18-651-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d7036909-625c-5e38-9f82-2fb9cdc92f17",
          "situation_uid": "3b84d201-24a4-57ef-991c-7107ec1b0ea4",
          "context_vi": "Trước khi trình bày, hỏi khách có tiện nói chuyện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "御社のご計画について、今少しお話を伺ってもよろしいでしょうか。",
              "vi": "Tôi xin hỏi đôi chút về kế hoạch của quý công ty lúc này có tiện không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "あと十分でしたら大丈夫です。",
              "vi": "Nếu trong mười phút thì được."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-01-b18-678",
      "practice": [
        {
          "id": "sj-thuong-01-b18-678-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "446f1748-eaee-5340-a474-5b4b01c0c9ef",
          "situation_uid": "cab28fde-da97-5862-9c02-ac9dd05c6947",
          "context_vi": "Tự giới thiệu công ty với lễ tân.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Lễ tân đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "弊社は業務システムの開発をしております。営業の田中と申します。",
              "vi": "Công ty chúng tôi phát triển hệ thống nghiệp vụ. Tôi là Tanaka, bên kinh doanh ạ."
            },
            {
              "speaker_id": "B",
              "ja": "田中様ですね。少々お待ちください。",
              "vi": "Anh/chị Tanaka phải không ạ. Xin chờ một chút."
            }
          ]
        },
        {
          "id": "sj-thuong-01-b18-678-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "446f1748-eaee-5340-a474-5b4b01c0c9ef",
          "situation_uid": "322c668c-6947-513d-8bdb-f1dbf12e1bd3",
          "context_vi": "Người chuyên môn bên mình không thể dự họp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "弊社の技術担当が当日伺えなくなりました。別の日をご相談できますでしょうか。",
              "vi": "Chuyên viên kỹ thuật bên chúng tôi không thể đến vào hôm đó. Chúng ta có thể bàn ngày khác được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "来週の火曜なら空いています。",
              "vi": "Thứ Ba tuần sau tôi còn trống."
            }
          ]
        },
        {
          "id": "sj-thuong-01-b18-678-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d7036909-625c-5e38-9f82-2fb9cdc92f17",
          "situation_uid": "8d736f4a-07ff-59f5-abe2-c081fa8ca4fc",
          "context_vi": "Nói rõ ai bên mình sẽ phản hồi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "弊社の契約担当、佐藤から明日中にご連絡いたします。",
              "vi": "Ngày mai, Sato phụ trách hợp đồng bên chúng tôi sẽ liên hệ lại ạ."
            },
            {
              "speaker_id": "B",
              "ja": "佐藤さんからですね。承知しました。",
              "vi": "Là anh/chị Sato phải không. Tôi hiểu rồi."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-01-b18-304",
      "practice": [
        {
          "id": "sj-thuong-01-b18-304-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "446f1748-eaee-5340-a474-5b4b01c0c9ef",
          "situation_uid": "0db4ced7-4a5d-5e42-9453-d5b9d15fef38",
          "context_vi": "Được nối máy, xin một phút để trình bày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今、一分ほどよろしいでしょうか。ご連絡した理由だけお伝えします。",
              "vi": "Bây giờ tôi xin một phút được không ạ? Tôi xin nói lý do liên hệ."
            },
            {
              "speaker_id": "B",
              "ja": "一分ならどうぞ。",
              "vi": "Nếu một phút thì mời chị nói."
            }
          ]
        },
        {
          "id": "sj-thuong-01-b18-304-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "446f1748-eaee-5340-a474-5b4b01c0c9ef",
          "situation_uid": "e5722d79-eb84-5e7d-af53-2ee6ddc72598",
          "context_vi": "Khách chỉ có mười lăm phút cho cuộc hẹn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách hàng",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "十五分しか取れませんが、よろしいですか。",
              "vi": "Tôi chỉ dành được mười lăm phút, có được không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。導入時期の確認に絞ります。",
              "vi": "Vâng. Tôi sẽ chỉ tập trung xác nhận thời điểm triển khai."
            }
          ]
        },
        {
          "id": "sj-thuong-01-b18-304-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d7036909-625c-5e38-9f82-2fb9cdc92f17",
          "situation_uid": "3b84d201-24a4-57ef-991c-7107ec1b0ea4",
          "context_vi": "Mở đầu trao đổi tại văn phòng đối tác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "資料を広げてもよろしいでしょうか。",
              "vi": "Tôi mở tài liệu ra được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、お願いします。",
              "vi": "Vâng, mời chị."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-01-b18-1177",
      "practice": [
        {
          "id": "sj-thuong-01-b18-1177-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d7036909-625c-5e38-9f82-2fb9cdc92f17",
          "situation_uid": "6f84117b-e8ce-509b-bf92-027c0d391755",
          "context_vi": "Hỏi đối tác đã nghe ý kiến người duyệt bên họ chưa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "御社の部長様は、先日の件について何かおっしゃっていましたか。",
              "vi": "Trưởng phòng bên anh có nói gì về việc hôm trước không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "まず見積もりを見たいとのことでした。",
              "vi": "Ông ấy muốn xem báo giá trước."
            }
          ]
        },
        {
          "id": "sj-thuong-01-b18-1177-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d7036909-625c-5e38-9f82-2fb9cdc92f17",
          "situation_uid": "1969ec01-e4bd-5f52-937d-0ad5da03dab4",
          "context_vi": "Hỏi lại mức ý định của đối tác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先ほど「検討したい」とおっしゃいましたが、社内でのご相談はこれからでしょうか。",
              "vi": "Ban nãy anh nói muốn xem xét; vậy anh sẽ trao đổi trong nội bộ từ bây giờ phải không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。まだ決定ではありません。",
              "vi": "Đúng vậy. Chúng tôi chưa quyết định."
            }
          ]
        },
        {
          "id": "sj-thuong-01-b18-1177-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d7036909-625c-5e38-9f82-2fb9cdc92f17",
          "situation_uid": "afa921b0-18ec-5c4e-a3d2-6dc195f5b608",
          "context_vi": "Tránh nhầm đã biết thông tin với đã phê duyệt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご責任者様は内容をご存じとはおっしゃいましたが、承認したとは伺っておりません。",
              "vi": "Tôi nghe nói người phụ trách đã biết nội dung, nhưng chưa nghe nói đã phê duyệt ạ."
            },
            {
              "speaker_id": "B",
              "ja": "その理解で合っています。",
              "vi": "Chị hiểu như vậy là đúng."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-01-b18-2067",
      "practice": [
        {
          "id": "sj-thuong-01-b18-2067-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "446f1748-eaee-5340-a474-5b4b01c0c9ef",
          "situation_uid": "022e4684-6384-5eb8-acd3-c0093ecd0ee2",
          "context_vi": "Hỏi nhu cầu trước khi chốt nội dung buổi gặp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "最初の面談で、特に伺っておくべき課題はございますか。",
              "vi": "Trong buổi gặp đầu tiên, có vấn đề nào tôi nên hỏi trước không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "まず納期について相談したいです。",
              "vi": "Trước hết tôi muốn bàn về tiến độ giao hàng."
            }
          ]
        },
        {
          "id": "sj-thuong-01-b18-2067-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "446f1748-eaee-5340-a474-5b4b01c0c9ef",
          "situation_uid": "9045dba2-0751-5633-bc1b-58bc0db763d1",
          "context_vi": "Gọi lại để xác nhận người dự họp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "当日ご参加になる方のお名前を伺ってもよろしいでしょうか。",
              "vi": "Tôi xin hỏi tên những người sẽ tham dự hôm đó được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "私と開発部の森です。",
              "vi": "Có tôi và Mori bên phòng phát triển."
            }
          ]
        },
        {
          "id": "sj-thuong-01-b18-2067-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "d7036909-625c-5e38-9f82-2fb9cdc92f17",
          "situation_uid": "45c0d1ff-ab93-59f3-be7e-e42686921e4b",
          "context_vi": "Xin xác nhận lại chức danh vì đã nghe nhầm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên bên gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "失礼いたしました。ご役職をもう一度伺ってもよろしいでしょうか。",
              "vi": "Xin lỗi, tôi xin phép hỏi lại chức danh của anh được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "営業部長です。",
              "vi": "Tôi là trưởng phòng kinh doanh."
            }
          ]
        }
      ]
    }
  ]
}
