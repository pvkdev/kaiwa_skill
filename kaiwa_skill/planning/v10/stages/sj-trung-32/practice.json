{
  "stage_uid": "3d0945ea-c71b-58b2-9a5d-37459c0ae4e9",
  "items": [
    {
      "item_id": "sj-trung-32-b07-102",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên hỏi có cần thêm dịch vụ không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご予約に朝食を追加しますか。",
              "vi": "Quý khách muốn thêm bữa sáng vào đặt chỗ không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、そのままで結構です。",
              "vi": "Không, cứ giữ như hiện tại là được ạ."
            }
          ],
          "id": "sj-trung-32-b07-102-ex01",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "72e7e8a8-f078-580e-9b9d-abdfd67e02b8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên hỏi có muốn đổi loại phòng sau khi báo phí.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "料金が変わりますが、お部屋を替えますか。",
              "vi": "Đổi phòng thì giá khác, quý khách có muốn đổi không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、そのままで結構です。",
              "vi": "Không, cứ giữ như hiện tại là được ạ."
            }
          ],
          "id": "sj-trung-32-b07-102-ex02",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "764b2616-e82b-5364-b308-c4ce4b60fd63"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xác nhận với quầy rằng phòng đã đặt giữ nguyên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お部屋も変更されますか。",
              "vi": "Quý khách có muốn đổi cả phòng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、お部屋はそのままで結構です。",
              "vi": "Không, phòng cứ giữ như đã đặt là được ạ."
            }
          ],
          "id": "sj-trung-32-b07-102-ex03",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "72e7e8a8-f078-580e-9b9d-abdfd67e02b8"
        }
      ]
    },
    {
      "item_id": "sj-trung-32-b07-99",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên xác nhận điều kiện đổi giờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前日までなら無料で変更できます。よろしいですか。",
              "vi": "Đổi trước một ngày thì miễn phí. Như vậy được chứ ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、それで結構です。",
              "vi": "Vâng, như vậy được ạ."
            }
          ],
          "id": "sj-trung-32-b07-99-ex01",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "fd26fe4f-0fb8-5d56-a145-9539a37ad4b8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên tư vấn tuyến ít đổi tàu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらなら乗り換えが少ないですが、いかがですか。",
              "vi": "Tuyến này ít phải đổi tàu, quý khách thấy sao ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、それで結構です。",
              "vi": "Vâng, tuyến đó được ạ."
            }
          ],
          "id": "sj-trung-32-b07-99-ex02",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "15f3fcdc-3a37-573b-894d-ba0940ea3160"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quầy hỏi hạn trả lời sau khi người học xác nhận với gia đình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ご家族に確認して、午後四時までにお返事いただけますか。",
              "vi": "Quý khách hỏi gia đình rồi trả lời trước bốn giờ được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、午後四時で結構です。",
              "vi": "Vâng, bốn giờ được ạ."
            }
          ],
          "id": "sj-trung-32-b07-99-ex03",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "d844d749-5220-5990-a434-22471c12ab00"
        }
      ]
    },
    {
      "item_id": "sj-trung-32-b06-160",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Phí đổi lịch khác điều đã nghe.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "無料で変更できると聞いたのに、今は料金がかかるんですか。話が違いますね。",
              "vi": "Tôi nghe là đổi miễn phí, giờ lại mất phí ạ? Khác điều tôi được báo rồi."
            },
            {
              "speaker_id": "B",
              "ja": "条件を確認します。",
              "vi": "Tôi sẽ kiểm tra điều kiện ạ."
            }
          ],
          "id": "sj-trung-32-b06-160-ex01",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "764b2616-e82b-5364-b308-c4ce4b60fd63"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Một người tưởng cả nhóm đã đồng ý tách ra.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "別々に行くことで決まったよね。",
              "vi": "Đã quyết đi riêng rồi nhỉ?"
            },
            {
              "speaker_id": "B",
              "ja": "話が違うよ。まだ全員には確認してない。",
              "vi": "Không đúng điều mình đã bàn. Mình chưa hỏi hết mọi người mà."
            }
          ],
          "id": "sj-trung-32-b06-160-ex02",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "0e48e175-4f29-5f31-bdfb-023b19fc4c05"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Ngày về được ghi khác thỏa thuận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "帰りは日曜日と伝えたはずです。月曜日になっているなら話が違います。",
              "vi": "Tôi nhớ đã báo ngày về là Chủ nhật. Nếu ghi thứ Hai thì khác điều đã nói ạ."
            },
            {
              "speaker_id": "B",
              "ja": "申し訳ありません。確認します。",
              "vi": "Xin lỗi anh. Tôi sẽ kiểm tra."
            }
          ],
          "id": "sj-trung-32-b06-160-ex03",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "d4605667-1a6f-55d8-9fc5-562d9b727412"
        }
      ]
    },
    {
      "item_id": "sj-trung-32-b06-50",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người đặt phòng báo phí đổi chưa từng nêu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "変更には一万円かかるらしい。",
              "vi": "Hình như đổi lịch mất một vạn yên."
            },
            {
              "speaker_id": "B",
              "ja": "えっ、それは聞いてないよ。条件をもう一度確認しよう。",
              "vi": "Ơ, tớ chưa nghe chuyện đó. Mình kiểm lại điều kiện đi."
            }
          ],
          "id": "sj-trung-32-b06-50-ex01",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "764b2616-e82b-5364-b308-c4ce4b60fd63"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người nhà tưởng đã đồng ý chia nhóm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日は別々に回るんだよね。",
              "vi": "Mai mình đi riêng nhỉ?"
            },
            {
              "speaker_id": "B",
              "ja": "それは聞いてないよ。まず皆に確認しよう。",
              "vi": "Tớ chưa nghe chuyện đó. Trước hết hỏi lại mọi người đi."
            }
          ],
          "id": "sj-trung-32-b06-50-ex02",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "0e48e175-4f29-5f31-bdfb-023b19fc4c05"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Biết thêm khoản chi phí chung mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "駐車料金もみんなで払うことになったよ。",
              "vi": "Phí đỗ xe cũng chia đều nhé."
            },
            {
              "speaker_id": "B",
              "ja": "え、それは聞いてなかった。金額を見てから決めたい。",
              "vi": "Ơ, tớ chưa nghe khoản đó. Cho tớ xem số tiền rồi mới quyết."
            }
          ],
          "id": "sj-trung-32-b06-50-ex03",
          "topic_uid": "82cdb7e1-bdb8-5410-8b0d-0b3179bac810",
          "situation_uid": "a4b59107-0259-5099-a68e-69aa0bf9849b"
        }
      ]
    }
  ]
}
