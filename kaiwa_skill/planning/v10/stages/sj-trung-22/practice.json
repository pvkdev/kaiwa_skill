{
  "stage_uid": "2f45ddb3-4ddc-5f43-99e5-99dde76effcc",
  "items": [
    {
      "item_id": "sj-trung-22-b18-2920",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên nhận yêu cầu nối máy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "営業部の佐藤様をお願いします。",
              "vi": "Cho tôi gặp chị Sato ở phòng kinh doanh ạ."
            },
            {
              "speaker_id": "B",
              "ja": "かしこまりました。おつなぎします。",
              "vi": "Vâng ạ. Tôi sẽ nối máy."
            }
          ],
          "id": "sj-trung-22-b18-2920-ex01",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "b08c71e9-7e71-51bf-9500-2f5663459d91"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhận yêu cầu gọi lại trước chiều.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "三時までに折り返していただけますか。",
              "vi": "Chị gọi lại trước ba giờ được không?"
            },
            {
              "speaker_id": "B",
              "ja": "かしこまりました。担当に伝えます。",
              "vi": "Vâng ạ. Tôi sẽ báo người phụ trách."
            }
          ],
          "id": "sj-trung-22-b18-2920-ex02",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "c88d3e75-780a-5604-8197-c3aff40a082a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người gọi nhờ kiểm số đơn vừa đọc qua đường truyền nhiễu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "注文番号が聞こえましたか。もう一度確認してください。",
              "vi": "Anh nghe rõ mã đơn không? Xin kiểm lại giúp tôi."
            },
            {
              "speaker_id": "B",
              "ja": "かしこまりました。番号を復唱いたします。",
              "vi": "Vâng ạ. Tôi xin đọc lại mã số."
            }
          ],
          "id": "sj-trung-22-b18-2920-ex03",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "7b161fe9-134e-59ef-a517-83f41918ca8b"
        }
      ]
    },
    {
      "item_id": "sj-trung-22-b18-2722",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chưa chắc giờ gọi lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người gọi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "担当の予定を確認してから、ご連絡いたします。",
              "vi": "Tôi sẽ kiểm tra lịch người phụ trách rồi liên lạc lại ạ."
            },
            {
              "speaker_id": "B",
              "ja": "お願いします。",
              "vi": "Nhờ chị."
            }
          ],
          "id": "sj-trung-22-b18-2722-ex01",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "1ade4a62-211c-5b49-a6cb-b57cc05d9561"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên đọc lại số đơn để kiểm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người gọi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "番号を復唱いたします。五二七三でよろしいでしょうか。",
              "vi": "Tôi xin đọc lại số: 5273, đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "最後は四です。",
              "vi": "Số cuối là bốn ạ."
            }
          ],
          "id": "sj-trung-22-b18-2722-ex02",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "ddf09660-876f-59fc-b020-79bea74d4551"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Gọi lại sau khi xác nhận giờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người gọi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先ほどのお電話の件で、ご連絡いたしました。",
              "vi": "Tôi gọi lại về cuộc điện thoại lúc nãy ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。",
              "vi": "Cảm ơn chị."
            }
          ],
          "id": "sj-trung-22-b18-2722-ex03",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "effdf1ab-0470-58fa-8bd9-8c89d8b3f679"
        }
      ]
    },
    {
      "item_id": "sj-trung-22-b12-56",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đã chốt ai gọi lại và giờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người gọi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "担当から三時までに折り返します。そういうことで、失礼いたします。",
              "vi": "Người phụ trách sẽ gọi lại trước ba giờ. Vậy nhé, tôi xin phép gác máy."
            },
            {
              "speaker_id": "B",
              "ja": "お願いします。",
              "vi": "Nhờ anh."
            }
          ],
          "id": "sj-trung-22-b12-56-ex01",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "c88d3e75-780a-5604-8197-c3aff40a082a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kết thúc cuộc gọi với đối tác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đối tác",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "資料は明日お送りします。そういうことで、失礼いたします。",
              "vi": "Tôi sẽ gửi tài liệu ngày mai. Vậy nhé, tôi xin phép gác máy."
            },
            {
              "speaker_id": "B",
              "ja": "よろしくお願いします。",
              "vi": "Nhờ chị."
            }
          ],
          "id": "sj-trung-22-b12-56-ex02",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "3fb54e4f-b0b1-5c40-83f9-75eff754fdd2"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đọc lại ngày giao đã chốt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đối tác",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "納品は十一月二十日、金曜日ですね。そういうことで、よろしくお願いいたします。",
              "vi": "Ngày giao là thứ Sáu, hai mươi tháng Mười Một nhỉ. Vậy xin nhờ chị."
            },
            {
              "speaker_id": "B",
              "ja": "はい、よろしくお願いします。",
              "vi": "Vâng, nhờ anh."
            }
          ],
          "id": "sj-trung-22-b12-56-ex03",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "1db68618-a205-56b0-b335-ba92d40a09e1"
        }
      ]
    },
    {
      "item_id": "sj-trung-22-b06-124",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi đồng nghiệp tiến độ kiểm lịch.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "担当の予定確認、調子はどう？",
              "vi": "Việc kiểm lịch người phụ trách đến đâu rồi?"
            },
            {
              "speaker_id": "B",
              "ja": "もう確認できたよ。",
              "vi": "Tớ kiểm xong rồi."
            }
          ],
          "id": "sj-trung-22-b06-124-ex01",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "1ade4a62-211c-5b49-a6cb-b57cc05d9561"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi gọi lại, hỏi công việc tiến triển thế nào.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "折り返しの電話、調子はどう？",
              "vi": "Cuộc gọi lại tiến triển thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "時間を確認して伝えられたよ。",
              "vi": "Tớ đã xác nhận giờ và báo lại rồi."
            }
          ],
          "id": "sj-trung-22-b06-124-ex02",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "effdf1ab-0470-58fa-8bd9-8c89d8b3f679"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi tình trạng điện thoại bị nhiễu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "回線の調子はどう？",
              "vi": "Đường dây thế nào rồi?"
            },
            {
              "speaker_id": "B",
              "ja": "今ははっきり聞こえるよ。",
              "vi": "Giờ nghe rõ rồi."
            }
          ],
          "id": "sj-trung-22-b06-124-ex03",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "ddf09660-876f-59fc-b020-79bea74d4551"
        }
      ]
    },
    {
      "item_id": "sj-trung-22-b06-85",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Ngày giao đang cận kề, cần xác nhận trước giờ đóng quầy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "納品日が明日なので、確認を至急お願いします。",
              "vi": "Ngày giao là mai nên xin kiểm tra gấp giúp tôi."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。すぐ確認します。",
              "vi": "Được, tôi sẽ kiểm ngay."
            }
          ],
          "id": "sj-trung-22-b06-85-ex01",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "34a57206-5557-5c99-b13b-7720e003c0e9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Số đơn sai cần sửa trước khi gửi thông tin cho khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "注文番号が一桁違います。訂正を至急お願いします。",
              "vi": "Mã đơn sai một chữ số. Xin sửa gấp giúp tôi."
            },
            {
              "speaker_id": "B",
              "ja": "すぐ直します。",
              "vi": "Tôi sửa ngay."
            }
          ],
          "id": "sj-trung-22-b06-85-ex02",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "ddf09660-876f-59fc-b020-79bea74d4551"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách cần câu trả lời để kịp bước sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お客様への返答が今日必要です。至急、確認をお願いします。",
              "vi": "Hôm nay cần trả lời khách. Xin kiểm tra gấp giúp tôi."
            },
            {
              "speaker_id": "B",
              "ja": "承知しました。",
              "vi": "Tôi hiểu rồi."
            }
          ],
          "id": "sj-trung-22-b06-85-ex03",
          "topic_uid": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70",
          "situation_uid": "c88d3e75-780a-5604-8197-c3aff40a082a"
        }
      ]
    }
  ]
