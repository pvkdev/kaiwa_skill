{
  "stage_uid": "82707143-3652-5841-ac64-7824f35090bd",
  "items": [
    {
      "item_id": "sj-trung-24-b20-10",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Trước họp cần hỏi ý bộ phận chịu ảnh hưởng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "会議の前に、影響を受ける部署にも根回ししておきたいです。",
              "vi": "Trước cuộc họp, tôi muốn trao đổi trước với bộ phận bị ảnh hưởng."
            },
            {
              "speaker_id": "B",
              "ja": "そうですね。意見を聞いてください。",
              "vi": "Đúng. Hãy nghe ý họ."
            }
          ],
          "id": "sj-trung-24-b20-10-ex01",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "4ce485f8-372a-5fd0-8155-f5de10c2766b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cần chuẩn bị đồng thuận trước khi trình phương án.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "正式に提案する前に、関係者への根回しが必要ですね。",
              "vi": "Trước khi đề xuất chính thức, ta cần trao đổi trước với người liên quan nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "はい、まず営業部に聞きましょう。",
              "vi": "Vâng, hỏi phòng kinh doanh trước."
            }
          ],
          "id": "sj-trung-24-b20-10-ex02",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "37b79925-addf-540d-b885-811637b8b2a2"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Tên người duyệt chưa rõ, chưa thể dàn xếp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Chủ trì",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "承認者が分からないと、根回しの相手も決められません。",
              "vi": "Chưa rõ người duyệt thì tôi cũng không biết cần trao đổi trước với ai."
            },
            {
              "speaker_id": "B",
              "ja": "今日中に確認します。",
              "vi": "Hôm nay tôi sẽ kiểm tra."
            }
          ],
          "id": "sj-trung-24-b20-10-ex03",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "25764f16-25de-5c10-b340-3e1256507f57"
        }
      ]
    },
    {
      "item_id": "sj-trung-24-b12-42",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nêu rủi ro trong công đoạn và thêm căn cứ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Chủ trì",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この工程は時間がかかります。それに、担当者が一人しかいません。",
              "vi": "Công đoạn này mất thời gian. Hơn nữa, chỉ có một người phụ trách."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。人数も確認しましょう。",
              "vi": "Tôi hiểu. Ta sẽ kiểm cả nhân lực."
            }
          ],
          "id": "sj-trung-24-b12-42-ex01",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "0004e9f7-73cb-55c8-969e-06425fa43b5f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đề nghị thử nhỏ để lấy dữ kiện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Chủ trì",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "小規模なら早く試せます。それに、失敗しても影響を抑えられます。",
              "vi": "Nếu thử quy mô nhỏ thì làm nhanh được. Hơn nữa, nếu không suôn sẻ cũng giảm được ảnh hưởng."
            },
            {
              "speaker_id": "B",
              "ja": "では、その案で検討しましょう。",
              "vi": "Vậy hãy xem xét cách đó."
            }
          ],
          "id": "sj-trung-24-b12-42-ex02",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "b1196b85-9271-5c92-bc77-54cfd81a55e6"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo kết quả thử và bổ sung phát hiện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Chủ trì",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "操作は予定どおりでした。それに、お客様から新しい質問も出ました。",
              "vi": "Thao tác diễn ra đúng dự tính. Hơn nữa, khách còn đưa ra câu hỏi mới."
            },
            {
              "speaker_id": "B",
              "ja": "その質問も記録してください。",
              "vi": "Hãy ghi lại câu hỏi đó."
            }
          ],
          "id": "sj-trung-24-b12-42-ex03",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "7957036a-bcc0-547d-b30b-107ee4f68095"
        }
      ]
    },
    {
      "item_id": "sj-trung-24-b11-58",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cần kiểm thêm trước khi quyết.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Chủ trì",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "数字を確認してから決めたほうがいいと思います。",
              "vi": "Tôi nghĩ nên kiểm con số rồi mới quyết."
            },
            {
              "speaker_id": "B",
              "ja": "そうですね。次回までにお願いします。",
              "vi": "Đúng. Nhờ chị làm trước cuộc họp sau."
            }
          ],
          "id": "sj-trung-24-b11-58-ex01",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "011ee18e-3e3a-5c21-9237-1b0c66ac07ef"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Làm rõ ý kiến không bác toàn bộ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "提案全体はよいと思います。ただ、この工程にはリスクがあると思います。",
              "vi": "Tôi nghĩ toàn bộ đề xuất là tốt. Chỉ có công đoạn này có rủi ro."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。その点ですね。",
              "vi": "Tôi hiểu. Là điểm đó nhỉ."
            }
          ],
          "id": "sj-trung-24-b11-58-ex02",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "42e6e915-091b-5268-8ae4-2f00b6892c2d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đề xuất thử trước trên một nhóm nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Chủ trì",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まず小さい範囲で試すのがいいと思います。",
              "vi": "Tôi nghĩ nên thử trong phạm vi nhỏ trước."
            },
            {
              "speaker_id": "B",
              "ja": "では、対象を決めましょう。",
              "vi": "Vậy chọn nhóm thử nhé."
            }
          ],
          "id": "sj-trung-24-b11-58-ex03",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "b1196b85-9271-5c92-bc77-54cfd81a55e6"
        }
      ]
    },
    {
      "item_id": "sj-trung-24-b24-83",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai đồng nghiệp bàn hai phương án sau họp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どっちの案がいいと思う？",
              "vi": "Cậu thấy phương án nào tốt hơn?"
            },
            {
              "speaker_id": "B",
              "ja": "今の情報なら、どっちもありだと思う。",
              "vi": "Với thông tin hiện có, tớ thấy cả hai đều có lý."
            }
          ],
          "id": "sj-trung-24-b24-83-ex01",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "59f1d13d-bccc-57d1-b9c7-2b0e40bc07dd"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chưa biết buổi thử có thành công không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Chủ trì",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "成功するかは五分五分ですね。小さく試しましょう。",
              "vi": "Khả năng thành công chắc ngang nhau. Ta thử nhỏ trước nhé."
            },
            {
              "speaker_id": "B",
              "ja": "そうしましょう。",
              "vi": "Làm vậy đi."
            }
          ],
          "id": "sj-trung-24-b24-83-ex02",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "b1196b85-9271-5c92-bc77-54cfd81a55e6"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Số liệu chưa đủ nên khó chọn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "数字がそろっていないので、今はどっちもありですね。",
              "vi": "Chưa đủ số liệu nên hiện giờ cả hai cách đều có thể."
            },
            {
              "speaker_id": "B",
              "ja": "では、追加で調べます。",
              "vi": "Vậy tôi sẽ tìm hiểu thêm."
            }
          ],
          "id": "sj-trung-24-b24-83-ex03",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "8701330c-f862-543d-88d3-449c953d711d"
        }
      ]
    },
    {
      "item_id": "sj-trung-24-b06-154",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chưa có số liệu đã xác nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Chủ trì",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "効果は出そうですか。",
              "vi": "Liệu có hiệu quả không?"
            },
            {
              "speaker_id": "B",
              "ja": "まだ数字がないので、何とも言えません。",
              "vi": "Chưa có con số nên tôi chưa thể nói chắc."
            }
          ],
          "id": "sj-trung-24-b06-154-ex01",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "a2f261ac-513c-5efc-8618-1581173cf448"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau buổi thử, kết quả vẫn chưa rõ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この方法で決まりですか。",
              "vi": "Chốt cách này rồi chứ?"
            },
            {
              "speaker_id": "B",
              "ja": "試した人数が少ないので、まだ何とも言えません。",
              "vi": "Số người thử còn ít nên chưa thể khẳng định."
            }
          ],
          "id": "sj-trung-24-b06-154-ex02",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "7957036a-bcc0-547d-b30b-107ee4f68095"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người duyệt cần thêm dữ kiện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "承認されるかは、担当者の確認前なので何とも言えません。",
              "vi": "Có được duyệt không thì chưa thể nói vì người phụ trách chưa xem."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。確認を待ちます。",
              "vi": "Tôi hiểu. Tôi sẽ chờ kiểm tra."
            }
          ],
          "id": "sj-trung-24-b06-154-ex03",
          "topic_uid": "ab73b053-c96a-51da-8e21-44ed894414c8",
          "situation_uid": "f27a2500-2f6a-5212-933e-72a31a1071e9"
        }
      ]
    }
  ]
}
