{
  "stage_uid": "292e121f-d445-551a-a9a4-b89069f033ee",
  "items": [
    {
      "item_id": "sj-so-12-b07-29",
      "practice": [
        {
          "id": "sj-so-12-b07-29-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e",
          "situation_uid": "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3",
          "context_vi": "Bệnh nhân chưa biết tên triệu chứng nên mô tả cảm giác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bệnh nhân",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bác sĩ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "朝から気分が悪くて、少し吐き気があります。",
              "vi": "Từ sáng tôi thấy khó chịu trong người và hơi buồn nôn ạ."
            },
            {
              "speaker_id": "B",
              "ja": "わかりました。いつから強くなりましたか。",
              "vi": "Tôi hiểu rồi. Từ lúc nào chị thấy nặng hơn?"
            }
          ]
        },
        {
          "id": "sj-so-12-b07-29-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "36b7df83-3fb3-5528-8551-ee33068e6fa7",
          "situation_uid": "7a5db36f-57fa-504e-a65e-218c3ba09d69",
          "context_vi": "Khách thấy khó chịu trong người khi đến hiệu thuốc.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Dược sĩ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は気分が悪くて、少しおなかも痛いんです。",
              "vi": "Hôm nay tôi thấy khó chịu trong người và hơi đau bụng ạ."
            },
            {
              "speaker_id": "B",
              "ja": "症状について確認しますね。",
              "vi": "Để tôi hỏi kỹ về triệu chứng nhé."
            }
          ]
        },
        {
          "id": "sj-so-12-b07-29-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e",
          "situation_uid": "9207ac27-7cfa-57cd-b157-6f1aea48e397",
          "context_vi": "Bệnh nhân phân biệt đau đầu và khó chịu toàn thân.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bác sĩ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bệnh nhân",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "頭は痛みますか。",
              "vi": "Anh có đau đầu không?"
            },
            {
              "speaker_id": "B",
              "ja": "頭は痛くないですが、気分が悪いです。",
              "vi": "Tôi không đau đầu, nhưng thấy khó chịu trong người ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-12-b07-19",
      "practice": [
        {
          "id": "sj-so-12-b07-19-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e",
          "situation_uid": "9207ac27-7cfa-57cd-b157-6f1aea48e397",
          "context_vi": "Nhân viên tiếp nhận thấy bệnh nhân xanh mặt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bệnh nhân",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "顔色が悪いですね。どうしたんですか。",
              "vi": "Sắc mặt chị không tốt. Chị có chuyện gì vậy?"
            },
            {
              "speaker_id": "B",
              "ja": "朝からめまいがするんです。",
              "vi": "Từ sáng tôi thấy chóng mặt ạ."
            }
          ]
        },
        {
          "id": "sj-so-12-b07-19-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e",
          "situation_uid": "bd005ef3-0055-54dc-9b54-9e1047578420",
          "context_vi": "Bác sĩ hỏi người bệnh tái khám vì sao trở lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bác sĩ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bệnh nhân",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日はどうしたんですか。",
              "vi": "Hôm nay anh đến vì chuyện gì ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "熱は下がりましたが、せきが続いています。",
              "vi": "Tôi hết sốt rồi, nhưng vẫn ho ạ."
            }
          ]
        },
        {
          "id": "sj-so-12-b07-19-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "36b7df83-3fb3-5528-8551-ee33068e6fa7",
          "situation_uid": "7a5db36f-57fa-504e-a65e-218c3ba09d69",
          "context_vi": "Dược sĩ thấy khách vịn quầy và hỏi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Dược sĩ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "大丈夫ですか。どうしたんですか。",
              "vi": "Chị ổn chứ? Chị sao vậy?"
            },
            {
              "speaker_id": "B",
              "ja": "急におなかが痛くなりました。",
              "vi": "Tôi đột nhiên đau bụng ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-12-b07-160",
      "practice": [
        {
          "id": "sj-so-12-b07-160-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e",
          "situation_uid": "bd005ef3-0055-54dc-9b54-9e1047578420",
          "context_vi": "Người quen chúc bệnh nhân sau buổi tái khám.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người quen",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người bệnh",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "診察は終わった？ お大事にね。",
              "vi": "Khám xong rồi à? Giữ gìn sức khỏe nhé."
            },
            {
              "speaker_id": "B",
              "ja": "うん、ありがとう。",
              "vi": "Ừ, cảm ơn cậu."
            }
          ]
        },
        {
          "id": "sj-so-12-b07-160-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "36b7df83-3fb3-5528-8551-ee33068e6fa7",
          "situation_uid": "1bf2f647-abed-5c00-ab57-d7b516657219",
          "context_vi": "Dược sĩ chúc khách khi khách rời quầy.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Dược sĩ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どうぞお大事に。",
              "vi": "Chúc chị mau khỏe ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。",
              "vi": "Cảm ơn anh."
            }
          ]
        },
        {
          "id": "sj-so-12-b07-160-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e",
          "situation_uid": "6d21bb55-02ed-5f10-a1d8-f33cb09fd568",
          "context_vi": "Người bạn phải đổi giờ hẹn vì không khỏe.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người bệnh",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は熱があって、行けそうにないの。",
              "vi": "Hôm nay tớ sốt, chắc không đến được."
            },
            {
              "speaker_id": "B",
              "ja": "わかった。お大事に。予定はまた決めよう。",
              "vi": "Tớ biết rồi. Mau khỏe nhé. Lịch mình tính sau."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-12-b07-27",
      "practice": [
        {
          "id": "sj-so-12-b07-27-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e",
          "situation_uid": "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3",
          "context_vi": "Bệnh nhân mô tả cảm giác uể oải chưa rõ nguyên nhân.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bệnh nhân",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bác sĩ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二日前から体がだるいんです。",
              "vi": "Từ hai ngày trước tôi thấy người uể oải ạ."
            },
            {
              "speaker_id": "B",
              "ja": "熱はありますか。",
              "vi": "Anh có sốt không?"
            }
          ]
        },
        {
          "id": "sj-so-12-b07-27-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "36b7df83-3fb3-5528-8551-ee33068e6fa7",
          "situation_uid": "7a5db36f-57fa-504e-a65e-218c3ba09d69",
          "context_vi": "Khách nói rõ ngoài đau bụng còn thấy người rã rời.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Dược sĩ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ほかに気になることはありますか。",
              "vi": "Chị còn thấy gì đáng lo không?"
            },
            {
              "speaker_id": "B",
              "ja": "おなかが痛くて、体もだるいです。",
              "vi": "Tôi đau bụng và người cũng rã rời ạ."
            }
          ]
        },
        {
          "id": "sj-so-12-b07-27-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e",
          "situation_uid": "bd005ef3-0055-54dc-9b54-9e1047578420",
          "context_vi": "Bệnh nhân tái khám nói cơn sốt đã giảm nhưng còn uể oải.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bác sĩ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bệnh nhân",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前より楽になりましたか。",
              "vi": "So với trước anh thấy đỡ hơn chưa?"
            },
            {
              "speaker_id": "B",
              "ja": "熱は下がりましたが、まだ体がだるいです。",
              "vi": "Tôi đã hết sốt, nhưng người vẫn còn uể oải ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-12-b07-153-health",
      "practice": [
        {
          "id": "sj-so-12-b07-153-health-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e",
          "situation_uid": "bd005ef3-0055-54dc-9b54-9e1047578420",
          "context_vi": "Người quen hỏi sau khi bệnh nhân tái khám.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người quen",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người bệnh",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "体調はどうですか。",
              "vi": "Sức khỏe chị dạo này thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "おかげさまで、だいぶよくなりました。",
              "vi": "Nhờ anh quan tâm, tôi đã khỏe hơn nhiều."
            }
          ]
        },
        {
          "id": "sj-so-12-b07-153-health-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e",
          "situation_uid": "bd005ef3-0055-54dc-9b54-9e1047578420",
          "context_vi": "Bác sĩ hỏi so với lần khám trước.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bác sĩ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bệnh nhân",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先週より、具合はいかがですか。",
              "vi": "So với tuần trước, anh thấy thế nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "おかげさまで、だいぶよくなりました。",
              "vi": "Nhờ cô chăm sóc, tôi đã đỡ nhiều ạ."
            }
          ]
        },
        {
          "id": "sj-so-12-b07-153-health-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "36b7df83-3fb3-5528-8551-ee33068e6fa7",
          "situation_uid": "1bf2f647-abed-5c00-ab57-d7b516657219",
          "context_vi": "Khách quay lại báo đã khá hơn và cảm ơn dược sĩ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Dược sĩ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その後、具合はいかがですか。",
              "vi": "Sau đó chị thấy trong người thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "おかげさまで、だいぶよくなりました。",
              "vi": "Nhờ anh quan tâm, tôi đã khỏe hơn nhiều ạ."
            }
          ]
        }
      ]
    }
  ]
}
