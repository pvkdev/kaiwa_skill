{
  "stage_uid": "0aa48c45-81e1-52bf-b9b8-d8f8bcfb082b",
  "items": [
    {
      "item_id": "sj-trung-10-b12-1",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Tên phiên âm trên giấy mới khác dữ liệu ngân hàng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "名前の表記が違うので、何かの間違いかと思うのですが。",
              "vi": "Tên được ghi khác nhau, tôi nghĩ có thể có nhầm lẫn ạ."
            },
            {
              "speaker_id": "B",
              "ja": "両方の書類を確認します。",
              "vi": "Tôi sẽ đối chiếu cả hai giấy tờ."
            }
          ],
          "id": "sj-trung-10-b12-1-ex01",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "a795cf70-0378-56b5-94f8-3ee2f378d52b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai đầu mối nói khác về giấy cần mang.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "窓口と電話で案内が違うので、確認が必要かと思いまして。",
              "vi": "Hướng dẫn ở quầy và qua điện thoại khác nhau, nên tôi nghĩ cần kiểm tra lại ạ."
            },
            {
              "speaker_id": "B",
              "ja": "担当者に確認します。",
              "vi": "Tôi sẽ hỏi người phụ trách."
            }
          ],
          "id": "sj-trung-10-b12-1-ex02",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "8cf5b485-0e41-5454-a045-eba5c94a413e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhận thấy ngày giao dịch trên giấy khác lời vừa nói.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらの日付は私が言った日と違うかと思うんですが。",
              "vi": "Ngày trên đây hình như khác ngày tôi vừa nói ạ."
            },
            {
              "speaker_id": "B",
              "ja": "失礼しました。もう一度伺います。",
              "vi": "Xin lỗi anh. Cho tôi hỏi lại ạ."
            }
          ],
          "id": "sj-trung-10-b12-1-ex03",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "33cc3569-3076-5b9d-9372-7d65e5a7b77b"
        }
      ]
    },
    {
      "item_id": "sj-trung-10-b12-53",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên nghĩ máy hỏng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ATMが使えないということですか。",
              "vi": "Ý anh là máy ATM không dùng được ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いえ、機械ではなく、私の口座が制限されているようです。",
              "vi": "Không ạ, không phải máy, mà dường như tài khoản của tôi bị hạn chế."
            }
          ],
          "id": "sj-trung-10-b12-53-ex01",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "c473e9ab-7284-534c-ac53-04def93871a8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên nhắc lại ngày mình đọc nhầm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "送金は十二日ですね。",
              "vi": "Giao dịch chuyển tiền vào ngày mười hai nhỉ?"
            },
            {
              "speaker_id": "B",
              "ja": "いえ、十三日でした。先ほどは私が間違えました。",
              "vi": "Không ạ, ngày mười ba. Lúc nãy tôi đọc nhầm."
            }
          ],
          "id": "sj-trung-10-b12-53-ex02",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "33cc3569-3076-5b9d-9372-7d65e5a7b77b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cuộc gọi đến chưa rõ có chính thức không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この電話で確認を進めますか。",
              "vi": "Chúng ta xác nhận qua cuộc gọi này nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "いえ、まず公式の番号にかけ直して確認します。",
              "vi": "Không ạ, trước tiên tôi sẽ gọi lại số chính thức để kiểm tra."
            }
          ],
          "id": "sj-trung-10-b12-53-ex03",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "6b9fc6b9-d92b-5999-a637-2329e0043e1d"
        }
      ]
    },
    {
      "item_id": "sj-trung-10-b06-177",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhắc khoản chuyển nhưng chưa chắc số tiền.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "間違ってたらすみません。送金額は三万円だったと思います。",
              "vi": "Xin lỗi nếu tôi nhầm. Tôi nhớ số tiền chuyển là ba vạn yên."
            },
            {
              "speaker_id": "B",
              "ja": "履歴を確認します。",
              "vi": "Tôi sẽ kiểm tra lịch sử giao dịch."
            }
          ],
          "id": "sj-trung-10-b06-177-ex01",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "c21fa04d-1a88-5377-8fbc-852281173fe8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sửa ngày tham chiếu sau khi xem lại lịch.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "間違っていたらすみません。十三日の取引ではないでしょうか。",
              "vi": "Xin lỗi nếu tôi nhầm. Có phải giao dịch ngày mười ba không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、十三日で確認できました。",
              "vi": "Vâng, đã tìm thấy giao dịch ngày mười ba."
            }
          ],
          "id": "sj-trung-10-b06-177-ex02",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "33cc3569-3076-5b9d-9372-7d65e5a7b77b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi lại thông tin giấy cần nộp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "間違ってたらすみません。先ほど電話では、通帳も必要と聞きました。",
              "vi": "Xin lỗi nếu tôi nhầm. Ban nãy qua điện thoại tôi nghe là cần cả sổ ngân hàng ạ."
            },
            {
              "speaker_id": "B",
              "ja": "確認してご案内します。",
              "vi": "Tôi sẽ kiểm tra rồi hướng dẫn."
            }
          ],
          "id": "sj-trung-10-b06-177-ex03",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "8cf5b485-0e41-5454-a045-eba5c94a413e"
        }
      ]
    },
    {
      "item_id": "sj-trung-10-b20-115",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thiếu giấy xác nhận nên chưa tiếp tục được.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "必要な証明書がないことが、手続きのネックになっています。",
              "vi": "Thiếu giấy xác nhận cần thiết đang là chỗ vướng của thủ tục."
            },
            {
              "speaker_id": "B",
              "ja": "次回お持ちいただければ進められます。",
              "vi": "Lần sau mang đến thì ta tiếp tục được."
            }
          ],
          "id": "sj-trung-10-b20-115-ex01",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "d36654ec-aabe-507e-9f5d-c9503e981e1a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Ngân hàng khác liên quan giao dịch.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "相手の銀行から返事がないのが、確認のネックですか。",
              "vi": "Chưa có trả lời từ ngân hàng bên kia là nút thắt của việc xác minh phải không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、今はその回答を待っています。",
              "vi": "Vâng, hiện chúng tôi đang chờ phản hồi đó."
            }
          ],
          "id": "sj-trung-10-b20-115-ex02",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "3583573c-feef-56c7-8df7-7c2bf299f1fb"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi vì sao chưa có người phản hồi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どの確認がネックになっているか、教えていただけますか。",
              "vi": "Anh cho tôi biết khâu xác nhận nào đang vướng được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "担当部署への照会です。",
              "vi": "Là việc hỏi bộ phận phụ trách ạ."
            }
          ],
          "id": "sj-trung-10-b20-115-ex03",
          "topic_uid": "1d7f2357-631b-55ab-a983-4b0bba54f293",
          "situation_uid": "b0fb869c-60b5-54a2-8338-6d548dff359b"
        }
      ]
    }
  ]
}
