{
  "stage_uid": "188a9e18-8921-5ffb-829f-fa871c5bf82b",
  "items": [
    {
      "item_id": "sj-so-11-b18-5",
      "practice": [
        {
          "id": "sj-so-11-b18-5-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "324e60d1-e9e5-5ba6-99ec-7d2f0747e9f7",
          "situation_uid": "293f81a6-a917-560b-a316-fcd619535035",
          "context_vi": "Quầy hiện tại không xử lý việc gửi hàng, nhân viên chỉ lối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "荷物を送りたいんですが、ここですか。",
              "vi": "Tôi muốn gửi hàng, ở quầy này phải không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "発送はあちらです。こちらは受け取りの窓口です。",
              "vi": "Gửi hàng ở phía kia ạ. Quầy này là quầy nhận hàng."
            }
          ]
        },
        {
          "id": "sj-so-11-b18-5-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bb024da0-3d41-5b59-83d6-86494fa81214",
          "situation_uid": "5d433196-c08d-5a38-beae-7699ad4cd89f",
          "context_vi": "Nhân viên hành chính mời người học tới lối này.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người đến",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらの階段から二階へどうぞ。",
              "vi": "Mời anh đi cầu thang này lên tầng hai ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。二階ですね。",
              "vi": "Cảm ơn chị. Tầng hai ạ."
            }
          ]
        },
        {
          "id": "sj-so-11-b18-5-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "324e60d1-e9e5-5ba6-99ec-7d2f0747e9f7",
          "situation_uid": "ed7f9eb0-5b9f-5332-a940-034d6c9189de",
          "context_vi": "Khách quay lại quầy và chỉ giấy đã được hướng dẫn mang tới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先日伺いました。こちらが持ってくるように言われた書類です。",
              "vi": "Hôm trước tôi đã tới. Đây là giấy tờ chị dặn mang theo ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。確認いたします。",
              "vi": "Cảm ơn anh. Tôi sẽ kiểm tra."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-11-b18-14",
      "practice": [
        {
          "id": "sj-so-11-b18-14-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "324e60d1-e9e5-5ba6-99ec-7d2f0747e9f7",
          "situation_uid": "293f81a6-a917-560b-a316-fcd619535035",
          "context_vi": "Khách muốn biết người phụ trách đúng việc mở tài khoản.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "口座の相談は、どなたに伺えばいいですか。",
              "vi": "Tôi muốn hỏi về tài khoản thì nên gặp ai ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "あちらの窓口の担当者にお声がけください。",
              "vi": "Chị hỏi người phụ trách ở quầy kia nhé."
            }
          ]
        },
        {
          "id": "sj-so-11-b18-14-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bb024da0-3d41-5b59-83d6-86494fa81214",
          "situation_uid": "af98b46a-1f1e-55a3-ac32-74f9cf2dab6e",
          "context_vi": "Quầy hiện tại không phụ trách, khách hỏi ai giúp được.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この手続きは、どなたにお願いすればいいですか。",
              "vi": "Thủ tục này tôi nên nhờ ai ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "二階の受付の方にお尋ねください。",
              "vi": "Anh hỏi người ở quầy tiếp nhận tầng hai nhé."
            }
          ]
        },
        {
          "id": "sj-so-11-b18-14-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bb024da0-3d41-5b59-83d6-86494fa81214",
          "situation_uid": "03bed172-145a-5f52-afc3-bc7f64613b54",
          "context_vi": "Người học gọi trước buổi hẹn để xác nhận đầu mối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người gọi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "明日の相談は、どなたが担当ですか。",
              "vi": "Buổi tư vấn ngày mai ai phụ trách ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "佐藤が担当します。",
              "vi": "Anh Satō phụ trách ạ."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-so-11-b07-183",
      "practice": [
        {
          "id": "sj-so-11-b07-183-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "324e60d1-e9e5-5ba6-99ec-7d2f0747e9f7",
          "situation_uid": "fd2459b0-f558-5a01-9a82-745f53d4669d",
          "context_vi": "Khách gọi chú ý trước khi hỏi quầy rút tiền.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません。お金を下ろす窓口はどちらですか。",
              "vi": "Xin lỗi, quầy rút tiền ở đâu ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "右の二番窓口です。",
              "vi": "Quầy số hai bên phải ạ."
            }
          ]
        },
        {
          "id": "sj-so-11-b07-183-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "bb024da0-3d41-5b59-83d6-86494fa81214",
          "situation_uid": "7cc19fb7-1cf0-5531-9f1a-29df9db0a6bc",
          "context_vi": "Người học chưa hiểu tên quầy nên xin nói chậm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người đến",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すみません。窓口の名前をゆっくり言っていただけますか。",
              "vi": "Xin lỗi, anh nói chậm tên quầy giúp tôi được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "「市民課」です。",
              "vi": "Là “Phòng công dân” ạ."
            }
          ]
        },
        {
          "id": "sj-so-11-b07-183-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "324e60d1-e9e5-5ba6-99ec-7d2f0747e9f7",
          "situation_uid": "ed7f9eb0-5b9f-5332-a940-034d6c9189de",
          "context_vi": "Khách được chỉ đúng nơi xử lý và cảm ơn người giúp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この番号札を持って三番窓口へどうぞ。",
              "vi": "Chị cầm số thứ tự này tới quầy số ba nhé."
            },
            {
              "speaker_id": "B",
              "ja": "あ、すみません。助かりました。",
              "vi": "À, cảm ơn anh. Anh giúp tôi nhiều quá."
            }
          ]
        }
      ]
    }
  ]
}
