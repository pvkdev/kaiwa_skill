{
  "stage_uid": "679785b8-3439-5818-b613-168d3f836d51",
  "items": [
    {
      "item_id": "sj-trung-14-b20-80",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Con không thích lớp sau buổi thử.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一回の体験だけで決めず、長い目で見たいです。",
              "vi": "Tôi muốn xem về lâu dài, chứ không quyết chỉ dựa vào một buổi thử."
            },
            {
              "speaker_id": "B",
              "ja": "では、お子さんの様子を一緒に見ましょう。",
              "vi": "Vậy ta cùng theo dõi xem cháu thế nào."
            }
          ],
          "id": "sj-trung-14-b20-80-ex01",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "c71652ca-e050-57e7-917c-f9015796fa8f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bàn học phí với người nhà.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "月謝だけでなく、長い目で見て続けられるか考えよう。",
              "vi": "Đừng chỉ nhìn học phí một tháng, mình nghĩ xem có theo lâu dài được không."
            },
            {
              "speaker_id": "B",
              "ja": "そうだね。ほかの費用も聞こう。",
              "vi": "Ừ. Hỏi cả các khoản khác nữa."
            }
          ],
          "id": "sj-trung-14-b20-80-ex02",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "ef2f1844-156a-5fa8-a61e-e253367715e9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Gia đình muốn thử thêm một lần.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Giáo viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "長い目で見れば、もう一度試すのもいいかもしれません。",
              "vi": "Xét về lâu dài, cho con thử thêm một lần có lẽ cũng tốt."
            },
            {
              "speaker_id": "B",
              "ja": "次の体験日をご案内します。",
              "vi": "Tôi sẽ báo ngày học thử tiếp theo."
            }
          ],
          "id": "sj-trung-14-b20-80-ex03",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "fa94b8dd-d7fa-5cfd-8ba4-cbaec7142180"
        }
      ]
    },
    {
      "item_id": "sj-trung-14-b12-21",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Mục tiêu lớp khác điều mình tưởng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この内容で子どもに合うかな。どうだろう。",
              "vi": "Nội dung thế này có hợp với con không nhỉ. Khó nói quá."
            },
            {
              "speaker_id": "B",
              "ja": "本人にも聞いてみよう。",
              "vi": "Hỏi chính con xem sao."
            }
          ],
          "id": "sj-trung-14-b12-21-ex01",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "9072a648-d5eb-594a-a756-cad9ce172f7d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Giờ học va lịch gia đình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "毎週この時間に通うのは、どうかなと思う。",
              "vi": "Tớ thấy đến lớp giờ này hằng tuần có lẽ không ổn."
            },
            {
              "speaker_id": "B",
              "ja": "別の曜日を聞いてみよう。",
              "vi": "Mình hỏi ngày khác nhé."
            }
          ],
          "id": "sj-trung-14-b12-21-ex02",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "c36a8c90-c34f-5581-b8c3-3a0b562795a4"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Con nói không muốn học tiếp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "もう少し続けさせる？",
              "vi": "Cho con học thêm một chút không?"
            },
            {
              "speaker_id": "B",
              "ja": "嫌がっているのに続けさせるのは、どうかと思う。",
              "vi": "Con đã không muốn mà vẫn ép học thì tớ thấy không ổn."
            }
          ],
          "id": "sj-trung-14-b12-21-ex03",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "c71652ca-e050-57e7-917c-f9015796fa8f"
        }
      ]
    },
    {
      "item_id": "sj-trung-14-b12-24",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người nhà chỉ ra chi phí phát sinh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "教材費も毎月かかるよ。",
              "vi": "Tháng nào cũng mất thêm tiền tài liệu."
            },
            {
              "speaker_id": "B",
              "ja": "確かに。それも含めて考えよう。",
              "vi": "Đúng thật. Mình tính cả khoản đó."
            }
          ],
          "id": "sj-trung-14-b12-24-ex01",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "ef2f1844-156a-5fa8-a61e-e253367715e9"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Giáo viên nhận xét con cần thời gian thích nghi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Giáo viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初めは慣れるまで時間がかかるかもしれません。",
              "vi": "Ban đầu có thể cháu cần thời gian để quen."
            },
            {
              "speaker_id": "B",
              "ja": "確かにそうかもしれません。家でも様子を聞いてみます。",
              "vi": "Đúng là có thể như vậy. Về nhà tôi cũng hỏi con xem."
            }
          ],
          "id": "sj-trung-14-b12-24-ex02",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "c71652ca-e050-57e7-917c-f9015796fa8f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người nhà thấy lịch học quá dày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nhà",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今の予定にもう一つ足すのは大変かも。",
              "vi": "Thêm một lớp vào lịch hiện giờ có thể vất vả đấy."
            },
            {
              "speaker_id": "B",
              "ja": "確かにね。別の曜日があるか聞こう。",
              "vi": "Đúng nhỉ. Hỏi xem có ngày khác không."
            }
          ],
          "id": "sj-trung-14-b12-24-ex03",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "c36a8c90-c34f-5581-b8c3-3a0b562795a4"
        }
      ]
    },
    {
      "item_id": "sj-trung-14-b12-91",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Con kể buổi học thử dễ theo hơn dự kiến.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Con",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "体験授業、わりと分かりやすかったよ。",
              "vi": "Buổi học thử khá dễ hiểu, hơn con tưởng."
            },
            {
              "speaker_id": "B",
              "ja": "そう。続けてみたい？",
              "vi": "Vậy à. Con muốn học tiếp không?"
            }
          ],
          "id": "sj-trung-14-b12-91-ex01",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "021317cb-8915-5134-af2c-f736c86e5ba4"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi con sau buổi thử.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Con",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先生の説明、どうだった？",
              "vi": "Thầy cô giải thích thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "わりと分かりやすかったけど、まだ決めたくない。",
              "vi": "Cũng khá dễ hiểu, nhưng con chưa muốn quyết."
            }
          ],
          "id": "sj-trung-14-b12-91-ex02",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "c71652ca-e050-57e7-917c-f9015796fa8f"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Con nói lớp học khá thú vị.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Con",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "二回目はわりと楽しかった。",
              "vi": "Buổi thứ hai khá vui, hơn con nghĩ."
            },
            {
              "speaker_id": "B",
              "ja": "それならよかった。続けるかゆっくり考えよう。",
              "vi": "Vậy thì tốt. Mình thong thả nghĩ xem có học tiếp không."
            }
          ],
          "id": "sj-trung-14-b12-91-ex03",
          "topic_uid": "10c72cfa-88d0-55a1-938f-2c0111febceb",
          "situation_uid": "fa94b8dd-d7fa-5cfd-8ba4-cbaec7142180"
        }
      ]
    }
  ]
}
