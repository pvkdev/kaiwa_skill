{
  "stage_uid": "7aff5367-56f0-5836-a4d9-a74cb5b84c00",
  "items": [
    {
      "item_id": "sj-trung-27-b20-167",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Muốn quản lý lắng nghe chuyện định hướng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私の今後の希望にも、少し耳を傾けていただけるとありがたいです。",
              "vi": "Tôi sẽ rất biết ơn nếu anh dành chút thời gian lắng nghe mong muốn sắp tới của tôi."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。聞かせてください。",
              "vi": "Được. Chị cứ nói."
            }
          ],
          "id": "sj-trung-27-b20-167-ex01",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "87011f14-30e4-5c1f-a254-3136ec09d369"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đồng nghiệp nhận thấy quản lý đã nghe cả hai góc nhìn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "上司は両方の話に耳を傾けてくれたね。",
              "vi": "Sếp đã lắng nghe cả hai phía nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "うん、助かった。",
              "vi": "Ừ, vậy tốt quá."
            }
          ],
          "id": "sj-trung-27-b20-167-ex02",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "bc5f7d1c-fc56-5565-b03c-b66126fca96e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quản lý nghe lý do đổi mục tiêu nghề.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "目標を変えたい理由に耳を傾けてくださって、ありがとうございます。",
              "vi": "Cảm ơn chị đã lắng nghe lý do tôi muốn đổi mục tiêu nghề nghiệp."
            },
            {
              "speaker_id": "B",
              "ja": "次の案を一緒に考えましょう。",
              "vi": "Ta cùng nghĩ phương án tiếp theo."
            }
          ],
          "id": "sj-trung-27-b20-167-ex03",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "02a2eb97-48e9-54c5-9350-904fc1d2f877"
        }
      ]
    },
    {
      "item_id": "sj-trung-27-b12-86",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quản lý khen thành tựu thực tế.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Quản lý",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "難しい調整を最後までやり切って、感心しました。",
              "vi": "Anh đã xử lý việc điều phối khó đến cùng, tôi rất ấn tượng."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。チームにも助けられました。",
              "vi": "Cảm ơn chị. Nhóm cũng giúp tôi nhiều."
            }
          ],
          "id": "sj-trung-27-b12-86-ex01",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "f2da408c-d8e2-5953-b243-f85dd3d14d9e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quản lý thấy nỗ lực trong tháng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Quản lý",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "毎週改善を続けたことに感心しました。",
              "vi": "Tôi rất ấn tượng vì chị duy trì cải thiện hằng tuần."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。次も続けます。",
              "vi": "Cảm ơn anh. Tôi sẽ tiếp tục."
            }
          ],
          "id": "sj-trung-27-b12-86-ex02",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "8e7ff5a6-2aa6-5d2a-a314-996383309f0c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nghe cấp trên khen đồng nghiệp làm tốt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "佐藤さんの準備には感心しました。",
              "vi": "Tôi rất ấn tượng với sự chuẩn bị của anh Sato."
            },
            {
              "speaker_id": "B",
              "ja": "ええ、丁寧でしたね。",
              "vi": "Ừ, anh ấy làm rất cẩn thận."
            }
          ],
          "id": "sj-trung-27-b12-86-ex03",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "c648c675-577c-504a-a698-2cc54370390d"
        }
      ]
    },
    {
      "item_id": "sj-trung-27-b12-109",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quản lý hẹn giờ ngoài thời gian có thể.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Quản lý",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "日曜日に話せますか。",
              "vi": "Chủ nhật ta nói chuyện được không?"
            },
            {
              "speaker_id": "B",
              "ja": "日曜日はちょっと…。月曜日なら空いています。",
              "vi": "Chủ nhật thì hơi khó ạ... Thứ Hai tôi rảnh."
            }
          ],
          "id": "sj-trung-27-b12-109-ex01",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "7151622b-568e-5c5f-b744-919317bba70a"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhiệm vụ mới vượt thời gian.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Quản lý",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今週中にもう一件できますか。",
              "vi": "Trong tuần này chị làm thêm một việc được không?"
            },
            {
              "speaker_id": "B",
              "ja": "今週中はちょっと難しいです。今の仕事との優先順位を相談したいです。",
              "vi": "Trong tuần này thì hơi khó ạ. Tôi muốn bàn thứ tự ưu tiên với việc đang làm."
            }
          ],
          "id": "sj-trung-27-b12-109-ex02",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "831b2a52-8c4e-534d-b113-186d94297a65"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chưa thể nhận bước nhảy lớn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Quản lý",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "すぐにリーダーを任せるのは難しいです。",
              "vi": "Khó giao vai trò trưởng nhóm ngay."
            },
            {
              "speaker_id": "B",
              "ja": "そうですか。それはちょっと残念ですが、足りない点を教えてください。",
              "vi": "Vậy ạ. Tôi hơi tiếc, nhưng xin anh cho biết mình còn thiếu điểm nào."
            }
          ],
          "id": "sj-trung-27-b12-109-ex03",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "bfd166bc-c348-5deb-a4ea-404ab6a650ce"
        }
      ]
    },
    {
      "item_id": "sj-trung-27-b06-13",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bất đồng về một sự kiện đánh giá.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "言いにくいんですが、その日の担当は私ではありませんでした。",
              "vi": "Khó nói điều này, nhưng hôm đó tôi không phải người phụ trách ạ."
            },
            {
              "speaker_id": "B",
              "ja": "そうでしたか。記録を確認します。",
              "vi": "Vậy à. Tôi sẽ xem lại ghi chép."
            }
          ],
          "id": "sj-trung-27-b06-13-ex01",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "bc5f7d1c-fc56-5565-b03c-b66126fca96e"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhiệm vụ mới vượt thời gian hiện có.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "言いにくいんですが、この量を今週中に終えるのは難しいです。",
              "vi": "Khó nói, nhưng hoàn tất khối lượng này trong tuần là khó ạ."
            },
            {
              "speaker_id": "B",
              "ja": "では、ほかの仕事を調整します。",
              "vi": "Vậy tôi sẽ điều chỉnh việc khác."
            }
          ],
          "id": "sj-trung-27-b06-13-ex02",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "831b2a52-8c4e-534d-b113-186d94297a65"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo ý định đổi mục tiêu nghề.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "言いにくいんですが、今は別の分野に進みたいと考えています。",
              "vi": "Khó nói, nhưng hiện tôi muốn chuyển sang lĩnh vực khác ạ."
            },
            {
              "speaker_id": "B",
              "ja": "理由を聞かせてください。",
              "vi": "Cho tôi nghe lý do nhé."
            }
          ],
          "id": "sj-trung-27-b06-13-ex03",
          "topic_uid": "a6c3c559-2a25-5c59-8d2a-8783ca30cd60",
          "situation_uid": "02a2eb97-48e9-54c5-9350-904fc1d2f877"
        }
      ]
    }
  ]
}
