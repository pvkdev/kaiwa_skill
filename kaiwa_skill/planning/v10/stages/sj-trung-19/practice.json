{
  "stage_uid": "a3f145e8-9f70-5c34-8e70-1f959044a9cb",
  "items": [
    {
      "item_id": "sj-trung-19-b12-37",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cấp trên cần nghe khách trước khi quyết.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お客様の意見を明日聞きます。",
              "vi": "Ngày mai tôi sẽ nghe ý khách."
            },
            {
              "speaker_id": "B",
              "ja": "とすると、最終案は明日以降ですね。",
              "vi": "Vậy tức là phương án cuối sẽ có từ ngày mai trở đi nhỉ."
            }
          ],
          "id": "sj-trung-19-b12-37-ex01",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "7d939375-0fb5-5922-b42d-afff7347f03c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cấp trên gợi thử trên nhóm nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まず五人に見せてみましょう。",
              "vi": "Trước hết cho năm người xem thử."
            },
            {
              "speaker_id": "B",
              "ja": "とすると、本番用の資料はその後で直しますか。",
              "vi": "Vậy tức là tài liệu dùng chính thức sẽ sửa sau đó ạ?"
            }
          ],
          "id": "sj-trung-19-b12-37-ex02",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "b98dde74-2e94-526b-833c-de361cacbdd1"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kết quả thử chưa như dự kiến.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "反応が予想より弱かったです。とすると、最初の説明を変える必要がありますね。",
              "vi": "Phản ứng yếu hơn dự kiến. Vậy có lẽ cần đổi phần giải thích ban đầu."
            },
            {
              "speaker_id": "B",
              "ja": "そうですね。そこから直しましょう。",
              "vi": "Đúng. Hãy sửa từ chỗ đó."
            }
          ],
          "id": "sj-trung-19-b12-37-ex03",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "b12b90a8-bb31-5f2f-9bf9-da049ca9e1f8"
        }
      ]
    },
    {
      "item_id": "sj-trung-19-b11-47",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cấp trên chưa thể quyết trước khi hỏi khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先方に確認してから決めます。",
              "vi": "Tôi sẽ hỏi phía khách rồi quyết."
            },
            {
              "speaker_id": "B",
              "ja": "でしたら、私は二案を用意しておきます。",
              "vi": "Vậy tôi sẽ chuẩn bị sẵn hai phương án."
            }
          ],
          "id": "sj-trung-19-b11-47-ex01",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "7d939375-0fb5-5922-b42d-afff7347f03c"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khách thấy phần mở đầu dài.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お客様は冒頭が長いとおっしゃっていました。",
              "vi": "Khách nói phần mở đầu dài quá."
            },
            {
              "speaker_id": "B",
              "ja": "そしたら、結論を先に出してみよう。",
              "vi": "Vậy thử đưa kết luận lên trước đi."
            }
          ],
          "id": "sj-trung-19-b11-47-ex02",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "746681c1-62d4-57f3-b720-2e9e5a6fc451"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thử nhỏ có kết quả tốt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "少人数の試しでは好評でした。",
              "vi": "Buổi thử với nhóm nhỏ được đánh giá tốt."
            },
            {
              "speaker_id": "B",
              "ja": "だったら、次は対象を広げて確認しましょう。",
              "vi": "Vậy bước sau hãy mở rộng nhóm để kiểm tra."
            }
          ],
          "id": "sj-trung-19-b11-47-ex03",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "b98dde74-2e94-526b-833c-de361cacbdd1"
        }
      ]
    },
    {
      "item_id": "sj-trung-19-b12-45",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cấp trên gợi thử nhưng chưa quyết định áp dụng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まずこの案を試してみましょう。",
              "vi": "Trước hết thử phương án này nhé."
            },
            {
              "speaker_id": "B",
              "ja": "それなら、まだ正式な決定ではないという理解でいいですか。",
              "vi": "Vậy tôi hiểu đây chưa phải quyết định chính thức, đúng không ạ?"
            }
          ],
          "id": "sj-trung-19-b12-45-ex01",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "b770b8d0-01ea-530a-8553-9f9335203d20"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai đồng nghiệp cho ý kiến khác nhau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "先方の案も聞いてみましょう。",
              "vi": "Hãy nghe cả phương án bên kia."
            },
            {
              "speaker_id": "B",
              "ja": "それなら、両方の条件を表にまとめます。",
              "vi": "Vậy tôi sẽ tóm tắt điều kiện của cả hai vào bảng."
            }
          ],
          "id": "sj-trung-19-b12-45-ex02",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "0836785a-c5f0-536e-ac19-ac64afdcfe06"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cấp trên nói bản thử chưa đạt, hỏi điểm cần sửa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "試した結果は、まだ期待したほどではありません。",
              "vi": "Kết quả thử vẫn chưa đạt như mong đợi."
            },
            {
              "speaker_id": "B",
              "ja": "それなら、どの点から直すのがよいでしょうか。",
              "vi": "Vậy nên sửa điểm nào trước ạ?"
            }
          ],
          "id": "sj-trung-19-b12-45-ex03",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "b12b90a8-bb31-5f2f-9bf9-da049ca9e1f8"
        }
      ]
    },
    {
      "item_id": "sj-trung-19-b06-110",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Tóm tắt hai cách trình bày trước khi hỏi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一つは数字から、もう一つは事例から入ります。そんな感じです。",
              "vi": "Một cách mở bằng con số, một cách mở bằng ví dụ. Đại khái là vậy ạ."
            },
            {
              "speaker_id": "B",
              "ja": "では、事例のほうを見せてください。",
              "vi": "Vậy cho tôi xem cách dùng ví dụ."
            }
          ],
          "id": "sj-trung-19-b06-110-ex01",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "5b883116-16fe-51cf-857c-70f07fae93cc"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo phản ứng khách sau buổi thử.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お客様の反応はどうでしたか。",
              "vi": "Khách phản ứng thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "最初は静かでしたが、事例を出すと質問が増えました。そんな感じです。",
              "vi": "Ban đầu họ khá im lặng, nhưng khi có ví dụ thì hỏi nhiều hơn. Đại khái là như vậy."
            }
          ],
          "id": "sj-trung-19-b06-110-ex02",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "746681c1-62d4-57f3-b720-2e9e5a6fc451"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cảm ơn lời khuyên về cách giải thích.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "結論を先に言うと伝わりやすくなりました。そんな感じです。",
              "vi": "Khi nói kết luận trước thì dễ truyền đạt hơn. Đại khái là thế ạ."
            },
            {
              "speaker_id": "B",
              "ja": "役に立ったならよかったです。",
              "vi": "Có ích là tốt rồi."
            }
          ],
          "id": "sj-trung-19-b06-110-ex03",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "934c5688-42af-50b4-bbfe-a25386994919"
        }
      ]
    },
    {
      "item_id": "sj-trung-19-b06-11",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cấp trên xem thử bản trình bày.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この構成、いい線いってるよ。あとは結論を短く。",
              "vi": "Bố cục này khá đúng hướng rồi. Chỉ cần rút ngắn kết luận."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。そこを直します。",
              "vi": "Tôi hiểu rồi. Tôi sẽ sửa chỗ đó."
            }
          ],
          "id": "sj-trung-19-b06-11-ex01",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "aef95dcb-a1df-5aeb-833a-edb319a64c31"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bản sửa gần đạt nhưng số liệu chưa rõ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "いい線いってる。数字の根拠を一つ足そう。",
              "vi": "Gần đúng hướng rồi. Thêm một căn cứ cho con số nhé."
            },
            {
              "speaker_id": "B",
              "ja": "はい、確認します。",
              "vi": "Vâng, tôi sẽ kiểm tra."
            }
          ],
          "id": "sj-trung-19-b06-11-ex02",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "b12b90a8-bb31-5f2f-9bf9-da049ca9e1f8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi áp dụng sửa đổi, hỏi cấp trên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "修正した案はどうでしょうか。",
              "vi": "Phương án đã sửa thế nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いい線いってるね。これならお客様に見せられる。",
              "vi": "Khá tốt rồi. Bản này có thể cho khách xem."
            }
          ],
          "id": "sj-trung-19-b06-11-ex03",
          "topic_uid": "b5fbba23-9aa7-5367-811c-a9271dff0490",
          "situation_uid": "35c50ee5-0271-5c6a-b490-01fedfb3710d"
        }
      ]
    }
  ]
}
