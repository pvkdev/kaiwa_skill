{
  "stage_uid": "5beb5615-31b6-5e40-bb14-3bae1a1ca000",
  "items": [
    {
      "item_id": "sj-trung-08-b24-23",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nói mức màu và vẻ tự nhiên mong muốn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thợ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "なるべく自然な色にしてください。できれば、この写真に近い感じがいいです。",
              "vi": "Xin làm màu tự nhiên nhất có thể. Nếu được, tôi muốn gần giống cảm giác trong ảnh này."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。明るさを抑えますね。",
              "vi": "Tôi hiểu rồi. Tôi sẽ giảm độ sáng màu."
            }
          ],
          "id": "sj-trung-08-b24-23-ex01",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "fa95b5a3-4fe4-588a-b907-d364d5b20347"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chỉ có giờ ngắn, chọn mẫu đơn giản.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thợ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "時間が短いので、なるべく簡単なデザインでお願いします。",
              "vi": "Vì thời gian ngắn, xin làm mẫu đơn giản nhất có thể."
            },
            {
              "speaker_id": "B",
              "ja": "それなら間に合います。",
              "vi": "Mẫu đó thì kịp ạ."
            }
          ],
          "id": "sj-trung-08-b24-23-ex02",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "b2402dd6-22cf-55fd-9eee-aebc0e85ece6"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo vùng da nhạy cảm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thợ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "できれば、目元を強くこすらないでいただけますか。",
              "vi": "Nếu được, xin đừng chà mạnh vùng quanh mắt tôi."
            },
            {
              "speaker_id": "B",
              "ja": "はい、気をつけます。",
              "vi": "Vâng, tôi sẽ chú ý."
            }
          ],
          "id": "sj-trung-08-b24-23-ex03",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "babb3a15-1360-55ca-ac8d-ff7b2f8a82ae"
        }
      ]
    },
    {
      "item_id": "sj-trung-08-b07-90",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Muốn xem kết quả một bên trước.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thợ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "できれば、片方だけ先に見せていただけますか。",
              "vi": "Nếu được, chị cho tôi xem một bên trước nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、鏡をお持ちします。",
              "vi": "Vâng, tôi mang gương lại."
            }
          ],
          "id": "sj-trung-08-b07-90-ex01",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "2dac4ca4-2010-588d-90ce-99be8b613b53"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cần giờ chỉnh lại phù hợp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "できれば、金曜日の夕方に直していただきたいです。",
              "vi": "Nếu được, tôi muốn sửa lại vào chiều thứ Sáu."
            },
            {
              "speaker_id": "B",
              "ja": "空きを確認します。",
              "vi": "Tôi sẽ xem còn lịch trống không."
            }
          ],
          "id": "sj-trung-08-b07-90-ex02",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "e63ed208-6793-5b8f-ac42-072d5d1ce366"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Muốn thử chỉnh nhẹ rồi kiểm cảm giác.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thợ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "できれば、少しだけ短くして様子を見たいです。",
              "vi": "Nếu được, tôi muốn cắt ngắn chút thôi rồi xem thế nào."
            },
            {
              "speaker_id": "B",
              "ja": "はい、少しずつ調整します。",
              "vi": "Vâng, tôi sẽ chỉnh từng chút."
            }
          ],
          "id": "sj-trung-08-b07-90-ex03",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "ca9d6c7c-ca1c-521e-9982-593d21eddc6a"
        }
      ]
    },
    {
      "item_id": "sj-trung-08-b07-101",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thợ đề nghị chỉ sửa phần nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thợ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "全部やり直さず、ここだけ直しましょうか。",
              "vi": "Hay chỉ sửa chỗ này thôi, không làm lại cả bộ nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "その案に賛成です。",
              "vi": "Tôi đồng ý với phương án đó."
            }
          ],
          "id": "sj-trung-08-b07-101-ex01",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "2c1f8c43-3097-5d9f-9f7d-a771821cb306"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thợ gợi mẫu đơn giản để kịp giờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thợ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は時間が短いので、単色にしませんか。",
              "vi": "Hôm nay thời gian ngắn, mình làm một màu thôi nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "賛成です。それなら間に合いそうですね。",
              "vi": "Tôi đồng ý. Vậy chắc kịp giờ."
            }
          ],
          "id": "sj-trung-08-b07-101-ex02",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "b2402dd6-22cf-55fd-9eee-aebc0e85ece6"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thợ gợi phương án nhẹ hơn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thợ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "刺激の少ない方法に変えましょうか。",
              "vi": "Mình đổi sang cách ít gây kích ứng hơn nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "賛成です。料金は変わりますか。",
              "vi": "Tôi đồng ý. Giá có thay đổi không ạ?"
            }
          ],
          "id": "sj-trung-08-b07-101-ex03",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "7379fc75-0552-5222-b614-3f40d7262ab0"
        }
      ]
    },
    {
      "item_id": "sj-trung-08-b12-11",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bàn giờ hẹn với bạn đi cùng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "土曜日の午後はどう？",
              "vi": "Chiều thứ Bảy thì sao?"
            },
            {
              "speaker_id": "B",
              "ja": "いいよ。一緒に行こう。",
              "vi": "Được, mình đi cùng nhé."
            }
          ],
          "id": "sj-trung-08-b12-11-ex01",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "72513cf9-2a63-586d-9712-e8ae85ddbd33"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thợ hỏi lựa chọn màu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thợ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "少し落ち着いたピンクはどうですか。",
              "vi": "Màu hồng dịu hơn một chút thì sao ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "それがいいです。",
              "vi": "Màu đó được ạ."
            }
          ],
          "id": "sj-trung-08-b12-11-ex02",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "fa95b5a3-4fe4-588a-b907-d364d5b20347"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Thợ gợi chỉnh độ dài.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thợ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "右側だけ少し短くするのはどうですか。",
              "vi": "Chỉ cắt bên phải ngắn đi một chút thì sao ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、まずそれでお願いします。",
              "vi": "Vâng, trước hết làm thế giúp tôi."
            }
          ],
          "id": "sj-trung-08-b12-11-ex03",
          "topic_uid": "51180487-cb71-560e-bba1-b46284880f40",
          "situation_uid": "2c1f8c43-3097-5d9f-9f7d-a771821cb306"
        }
      ]
    }
  ]
}
