{
  "stage_uid": "00eba9a1-a437-5baf-8dce-1b1e938f7f37",
  "items": [
    {
      "item_id": "sj-trung-28-b18-2771",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin nghỉ dài ngày với mốc dự kiến.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来月から三週間、お休みを取らせていただきたいです。",
              "vi": "Tôi muốn xin phép nghỉ ba tuần từ tháng sau ạ."
            },
            {
              "speaker_id": "B",
              "ja": "日程を確認しましょう。",
              "vi": "Ta kiểm tra lịch nhé."
            }
          ],
          "id": "sj-trung-28-b18-2771-ex01",
          "topic_uid": "cb64db58-1088-51bd-9146-2a0842e21392",
          "situation_uid": "0c16443e-450a-50c0-88a3-4077031c092b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Sau khi nhân sự tư vấn, xác nhận ngày nghỉ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "人事と確認した日程で、休ませていただきます。",
              "vi": "Tôi xin nghỉ theo lịch đã xác nhận với phòng nhân sự ạ."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。引き継ぎをお願いします。",
              "vi": "Được. Nhờ anh bàn giao việc."
            }
          ],
          "id": "sj-trung-28-b18-2771-ex02",
          "topic_uid": "cb64db58-1088-51bd-9146-2a0842e21392",
          "situation_uid": "8276102e-59fe-5987-b8e9-2dcdedd5b9af"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Xin đổi giờ làm khi trở lại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "戻った最初の週は、短い時間で働かせていただけますか。",
              "vi": "Tuần đầu trở lại, tôi có thể xin làm giờ ngắn hơn không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "人事と相談してみましょう。",
              "vi": "Ta trao đổi với phòng nhân sự nhé."
            }
          ],
          "id": "sj-trung-28-b18-2771-ex03",
          "topic_uid": "cb64db58-1088-51bd-9146-2a0842e21392",
          "situation_uid": "9ed35975-721a-50c0-b531-663160f63e11"
        }
      ]
    },
    {
      "item_id": "sj-trung-28-b24-31",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quản lý hỏi chuyện riêng, nêu rõ giới hạn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "詳しい事情は話せませんが、必要な休みの期間ははっきりお伝えします。",
              "vi": "Tôi không thể kể chi tiết chuyện riêng, nhưng sẽ nói rõ khoảng thời gian cần nghỉ ạ."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。日程を教えてください。",
              "vi": "Tôi hiểu. Anh cho tôi biết lịch nhé."
            }
          ],
          "id": "sj-trung-28-b24-31-ex01",
          "topic_uid": "cb64db58-1088-51bd-9146-2a0842e21392",
          "situation_uid": "739b5160-22f9-5784-8e70-3b6d417c3fab"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Người thay hiểu nhầm thời hạn bàn giao.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người thay",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "引き継ぎは金曜日までですよね。",
              "vi": "Bàn giao đến thứ Sáu nhỉ?"
            },
            {
              "speaker_id": "B",
              "ja": "はっきり言うと、木曜日までです。金曜日から休みに入ります。",
              "vi": "Nói rõ là đến thứ Năm. Từ thứ Sáu tôi bắt đầu nghỉ."
            }
          ],
          "id": "sj-trung-28-b24-31-ex02",
          "topic_uid": "cb64db58-1088-51bd-9146-2a0842e21392",
          "situation_uid": "15568acf-859a-55dd-8472-60e4b53992b5"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Quản lý tưởng muốn nghỉ tiếp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Quản lý",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "休みを延ばしたいということですか。",
              "vi": "Chị muốn kéo dài kỳ nghỉ à?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、復帰します。仕事の量をはっきり決めたいんです。",
              "vi": "Không ạ, tôi sẽ trở lại. Tôi muốn chốt rõ khối lượng công việc."
            }
          ],
          "id": "sj-trung-28-b24-31-ex03",
          "topic_uid": "cb64db58-1088-51bd-9146-2a0842e21392",
          "situation_uid": "5e6ff023-9623-5845-b87a-4ade6a8553af"
        }
      ]
    },
    {
      "item_id": "sj-trung-28-b06-66",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo ý định nghỉ dài ngày đột ngột.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "急な話で恐縮ですが、来月からしばらく休みを相談したいです。",
              "vi": "Xin lỗi vì nói đột ngột, nhưng tôi muốn bàn về việc nghỉ một thời gian từ tháng sau."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。予定を教えてください。",
              "vi": "Được. Anh cho tôi biết dự kiến."
            }
          ],
          "id": "sj-trung-28-b06-66-ex01",
          "topic_uid": "cb64db58-1088-51bd-9146-2a0842e21392",
          "situation_uid": "0c16443e-450a-50c0-88a3-4077031c092b"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Tình trạng đổi, cần điều chỉnh giờ làm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "急な話で恐縮ですが、復帰後の勤務時間を調整できないでしょうか。",
              "vi": "Xin lỗi vì nói đột ngột, nhưng có thể điều chỉnh giờ làm sau khi tôi trở lại không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "人事にも確認します。",
              "vi": "Tôi sẽ hỏi thêm phòng nhân sự."
            }
          ],
          "id": "sj-trung-28-b06-66-ex02",
          "topic_uid": "cb64db58-1088-51bd-9146-2a0842e21392",
          "situation_uid": "9ed35975-721a-50c0-b531-663160f63e11"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Ngày trở lại chưa chắc chắn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Quản lý",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "急な話で恐縮ですが、戻る日がまだ決まりません。来週またご連絡します。",
              "vi": "Xin lỗi vì báo đột ngột, nhưng ngày tôi trở lại vẫn chưa chốt. Tuần sau tôi sẽ liên lạc lại."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。",
              "vi": "Tôi hiểu rồi."
            }
          ],
          "id": "sj-trung-28-b06-66-ex03",
          "topic_uid": "cb64db58-1088-51bd-9146-2a0842e21392",
          "situation_uid": "ccdc7a7c-aaf0-586a-9326-fc96b6086947"
        }
      ]
    }
  ]
}
