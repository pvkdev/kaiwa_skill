{
  "stage_uid": "813a704a-fdc3-5c5e-99d4-89450dbabba8",
  "items": [
    {
      "item_id": "sj-trung-21-b11-78",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chỉ cách đối chiếu dữ liệu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Mentor",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người mới",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こうやって元の表と見比べてください。",
              "vi": "Hãy đối chiếu với bảng gốc theo cách này."
            },
            {
              "speaker_id": "B",
              "ja": "はい、差が見えました。",
              "vi": "Vâng, tôi thấy chỗ khác rồi."
            }
          ],
          "id": "sj-trung-21-b11-78-ex01",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "76e9cbd6-dd56-5391-80fc-cff99796a045"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi người mới sẽ làm gì khi thiếu thông tin.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Mentor",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người mới",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "必要な数字がなかったら、どうしますか。",
              "vi": "Nếu thiếu con số cần thiết, em sẽ làm thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "担当者に確認します。",
              "vi": "Em sẽ hỏi người phụ trách."
            }
          ],
          "id": "sj-trung-21-b11-78-ex02",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "2ae643a8-7d85-53b0-828a-19f303dda692"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhắc lại cách hỏi đầu mối.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người mới",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Mentor",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "分からないときは、こうやって担当者に聞けばいいですか。",
              "vi": "Khi chưa rõ, em hỏi người phụ trách như thế này được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、それで大丈夫です。",
              "vi": "Ừ, như vậy được."
            }
          ],
          "id": "sj-trung-21-b11-78-ex03",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "1f77aaf9-19b4-5aa3-b156-5d131892b3da"
        }
      ]
    },
    {
      "item_id": "sj-trung-21-b12-77",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Khen phần đúng rồi chỉ một lỗi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Mentor",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người mới",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "数字は正確です。ただ、日付が一日ずれています。",
              "vi": "Con số chính xác rồi. Chỉ có ngày bị lệch một hôm."
            },
            {
              "speaker_id": "B",
              "ja": "すぐ直します。",
              "vi": "Em sửa ngay."
            }
          ],
          "id": "sj-trung-21-b12-77-ex01",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "b6e8774a-6b44-50ed-befa-3d2e9a39f215"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bản sửa đã tốt nhưng còn một chỗ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Mentor",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người mới",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前より分かりやすいです。ただ、見出しを短くしましょう。",
              "vi": "Bản này dễ hiểu hơn trước. Chỉ cần rút ngắn tiêu đề."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。",
              "vi": "Em hiểu rồi."
            }
          ],
          "id": "sj-trung-21-b12-77-ex02",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "43bb5906-2bad-52b1-97b1-80ce5a6a786d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Báo với leader mức tiến bộ của người mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "入力は一人でできます。ただ、例外の処理にはまだ支援が必要です。",
              "vi": "Bạn ấy tự nhập liệu được rồi. Tuy nhiên, xử lý ngoại lệ vẫn cần hỗ trợ."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。そこは一緒に見てください。",
              "vi": "Tôi hiểu. Phần đó hãy xem cùng bạn ấy."
            }
          ],
          "id": "sj-trung-21-b12-77-ex03",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "76c7f69f-6a1d-5de8-adb6-4162fac0b507"
        }
      ]
    },
    {
      "item_id": "sj-trung-21-b12-90",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Đánh giá bản đầu của người mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Mentor",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người mới",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "初めてにしては、なかなかいいですね。",
              "vi": "Lần đầu mà làm khá tốt đấy."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。どこを直せばいいですか。",
              "vi": "Cảm ơn chị. Tôi cần sửa chỗ nào ạ?"
            }
          ],
          "id": "sj-trung-21-b12-90-ex01",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "b6e8774a-6b44-50ed-befa-3d2e9a39f215"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bản sửa có tiến bộ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Mentor",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người mới",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この修正はなかなかいいよ。次の部分もやってみて。",
              "vi": "Phần sửa này khá tốt. Em thử làm phần tiếp theo đi."
            },
            {
              "speaker_id": "B",
              "ja": "はい、やってみます。",
              "vi": "Vâng, em sẽ thử."
            }
          ],
          "id": "sj-trung-21-b12-90-ex02",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "43bb5906-2bad-52b1-97b1-80ce5a6a786d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Leader hỏi có tăng mức nhiệm vụ không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Leader",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Mentor",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来週はもう少し難しい仕事を任せますか。",
              "vi": "Tuần sau giao việc khó hơn chút được không?"
            },
            {
              "speaker_id": "B",
              "ja": "なかなか順調なので、小さい案件なら大丈夫です。",
              "vi": "Bạn ấy tiến bộ khá tốt, việc nhỏ thì làm được ạ."
            }
          ],
          "id": "sj-trung-21-b12-90-ex03",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "60ece27b-4f82-5ad3-8f70-c8de7f343a84"
        }
      ]
    },
    {
      "item_id": "sj-trung-21-b06-22",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nêu một điểm chưa đạt trong bản làm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Mentor",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người mới",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "内容は合っていますが、説明が今一つ分かりにくいです。",
              "vi": "Nội dung đúng, nhưng phần giải thích vẫn chưa thật dễ hiểu."
            },
            {
              "speaker_id": "B",
              "ja": "具体例を足します。",
              "vi": "Em sẽ thêm ví dụ cụ thể."
            }
          ],
          "id": "sj-trung-21-b06-22-ex01",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "b6e8774a-6b44-50ed-befa-3d2e9a39f215"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bản sửa vẫn còn điểm thiếu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Mentor",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người mới",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前よりよくなりました。ただ、結論が今一つはっきりしません。",
              "vi": "Đã tốt hơn trước. Nhưng kết luận vẫn chưa thật rõ."
            },
            {
              "speaker_id": "B",
              "ja": "結論を先に書きます。",
              "vi": "Em sẽ viết kết luận lên trước."
            }
          ],
          "id": "sj-trung-21-b06-22-ex02",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "43bb5906-2bad-52b1-97b1-80ce5a6a786d"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cân nhắc tăng mức nhiệm vụ tuần sau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Mentor",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Leader",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "基本はできていますが、応用は今一つです。来週も一緒に見ましょう。",
              "vi": "Phần cơ bản đã làm được, nhưng vận dụng vẫn chưa đạt. Tuần sau ta tiếp tục xem cùng nhau nhé."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。",
              "vi": "Tôi hiểu rồi."
            }
          ],
          "id": "sj-trung-21-b06-22-ex03",
          "topic_uid": "fc19e143-5413-57f9-9dd1-5fe70bae8742",
          "situation_uid": "60ece27b-4f82-5ad3-8f70-c8de7f343a84"
        }
      ]
    }
  ]
}
