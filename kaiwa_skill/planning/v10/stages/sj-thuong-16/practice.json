{
  "stage_uid": "d9eeb241-b3bc-57f4-a60a-befba0d14e43",
  "items": [
    {
      "item_id": "sj-thuong-16-b20-320",
      "practice": [
        {
          "id": "sj-thuong-16-b20-320-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1a56594-b23e-5ad2-9ebe-0d8f8fdf16ce",
          "situation_uid": "da9685c8-88ec-549c-88d7-d7e2c7e89146",
          "context_vi": "Nói điều khiến mình thích một bộ truyện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn trò chuyện",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "最近、この漫画にハマってるんです。主人公が失敗のあとで考え方を変えるところが好きで。",
              "vi": "Gần đây tôi mê bộ truyện tranh này. Tôi thích chỗ nhân vật chính thay đổi cách nghĩ sau thất bại."
            },
            {
              "speaker_id": "B",
              "ja": "どの場面からそう思ったの？",
              "vi": "Cảnh nào khiến bạn nghĩ vậy?"
            }
          ]
        },
        {
          "id": "sj-thuong-16-b20-320-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1a56594-b23e-5ad2-9ebe-0d8f8fdf16ce",
          "situation_uid": "05ca0cf2-5b9e-5bcf-8137-81d36d87e015",
          "context_vi": "Rủ bạn xem trận sau vì cùng thích đội.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn trò chuyện",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "次の試合も見る？",
              "vi": "Trận tới cậu có xem không?"
            },
            {
              "speaker_id": "B",
              "ja": "うん。最近このチームにハマってるから、一緒に見たい。",
              "vi": "Có. Dạo này tớ mê đội này, muốn xem cùng cậu."
            }
          ]
        },
        {
          "id": "sj-thuong-16-b20-320-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "005d5cad-653f-509e-9184-6858b491850b",
          "situation_uid": "2b582064-f915-5fa1-b811-e7e6a4504e9f",
          "context_vi": "Thử làm món thủ công và bất ngờ thấy thích.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người hướng dẫn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "最初は難しそうだったけど、作り始めたらハマりました。次は何を練習すればいいですか。",
              "vi": "Ban đầu tôi tưởng khó, nhưng làm rồi thì mê luôn. Tiếp theo nên tập phần nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "形を整えるところからどうぞ。",
              "vi": "Hãy bắt đầu bằng việc nắn dáng nhé."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-16-b20-340",
      "practice": [
        {
          "id": "sj-thuong-16-b20-340-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "005d5cad-653f-509e-9184-6858b491850b",
          "situation_uid": "5e7cefc0-974c-50c3-9043-b36935c6e021",
          "context_vi": "Hỏi món nhà chủ thường ăn dịp nào.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người hướng dẫn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "私、甘いものに目がないんです。このお菓子はいつ食べるものですか。",
              "vi": "Tôi mê đồ ngọt lắm. Món bánh này thường ăn dịp nào vậy ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "うちではお正月に作ります。",
              "vi": "Nhà tôi làm dịp Tết."
            }
          ]
        },
        {
          "id": "sj-thuong-16-b20-340-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "005d5cad-653f-509e-9184-6858b491850b",
          "situation_uid": "368f72de-5c32-58a9-9410-026e4c1a4a49",
          "context_vi": "So món quê mình với món đang được mời.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn trò chuyện",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "故郷のお菓子にも似てる？",
              "vi": "Nó có giống bánh quê cậu không?"
            },
            {
              "speaker_id": "B",
              "ja": "少しね。私はもち米のお菓子に目がないんだけど、これは豆の香りが強いね。",
              "vi": "Hơi giống. Tớ mê bánh nếp, nhưng món này có mùi đậu rõ hơn."
            }
          ]
        },
        {
          "id": "sj-thuong-16-b20-340-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1a56594-b23e-5ad2-9ebe-0d8f8fdf16ce",
          "situation_uid": "9e1c869b-5e5e-5d6f-bf7c-08c5e5a2d491",
          "context_vi": "Bạn mang bánh đến buổi xem phim.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn trò chuyện",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "映画を見ながら、これも食べる？",
              "vi": "Vừa xem phim vừa ăn cái này nhé?"
            },
            {
              "speaker_id": "B",
              "ja": "ありがとう。焼き菓子に目がないんだ。",
              "vi": "Cảm ơn. Tớ mê bánh nướng lắm."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-16-b06-1128",
      "practice": [
        {
          "id": "sj-thuong-16-b06-1128-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1a56594-b23e-5ad2-9ebe-0d8f8fdf16ce",
          "situation_uid": "9e1c869b-5e5e-5d6f-bf7c-08c5e5a2d491",
          "context_vi": "Chia sẻ sở thích ít người trong nhóm biết.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn trò chuyện",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ここだけの話ですが、実は昔のロボットアニメが大好きなんです。",
              "vi": "Chuyện riêng nhé, thật ra tôi rất mê anime robot đời cũ."
            },
            {
              "speaker_id": "B",
              "ja": "そうなんですか。ほかの人には言いません。",
              "vi": "Vậy à. Tôi sẽ không kể với ai."
            }
          ]
        },
        {
          "id": "sj-thuong-16-b06-1128-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "005d5cad-653f-509e-9184-6858b491850b",
          "situation_uid": "fe3559f7-82d7-5ab1-9eb1-01188d9a6937",
          "context_vi": "Chủ nhà kể tập quán riêng trong gia đình.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người hướng dẫn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Khách tham quan",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ここだけの話ですが、この飾り方は祖母が考えたんです。地域全体の習慣ではありません。",
              "vi": "Chuyện riêng nhé, cách trang trí này là do bà tôi nghĩ ra, không phải tập quán của cả vùng."
            },
            {
              "speaker_id": "B",
              "ja": "そうなんですね。家族の話として伺います。",
              "vi": "Vậy à. Tôi sẽ hiểu đó là chuyện riêng của gia đình."
            }
          ]
        },
        {
          "id": "sj-thuong-16-b06-1128-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1a56594-b23e-5ad2-9ebe-0d8f8fdf16ce",
          "situation_uid": "bd5d68f3-5a43-5598-816e-869c625e2368",
          "context_vi": "Bạn chia sẻ tin chưa xác nhận về buổi diễn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn trò chuyện",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nói",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ここだけの話ですが、来月ライブがあるらしいよ。まだ公式発表前だから広めないでね。",
              "vi": "Chuyện riêng nhé, nghe nói tháng sau có buổi diễn. Chưa có thông báo chính thức nên đừng lan truyền."
            },
            {
              "speaker_id": "B",
              "ja": "分かった。発表を待つよ。",
              "vi": "Tớ hiểu. Tớ sẽ chờ thông báo."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-16-b12-896",
      "practice": [
        {
          "id": "sj-thuong-16-b12-896-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c1a56594-b23e-5ad2-9ebe-0d8f8fdf16ce",
          "situation_uid": "ba927dbf-4d02-5e8b-a3ab-2b5c4d2f1a5f",
          "context_vi": "Bạn kể nhân vật đổi quan điểm sau một cảnh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bạn trò chuyện",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あの場面で主人公は初めて謝ったんだ。",
              "vi": "Ở cảnh đó nhân vật chính lần đầu xin lỗi."
            },
            {
              "speaker_id": "B",
              "ja": "それで、相手との関係は変わったの？",
              "vi": "Rồi quan hệ với người kia có thay đổi không?"
            }
          ]
        },
        {
          "id": "sj-thuong-16-b12-896-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "005d5cad-653f-509e-9184-6858b491850b",
          "situation_uid": "fd42f59d-0b39-55ec-990c-938a31b31881",
          "context_vi": "Người mới làm sai một bước trong món ăn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Người nói",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người hướng dẫn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "粉を入れる順番を間違えました。",
              "vi": "Tôi đã cho bột sai thứ tự."
            },
            {
              "speaker_id": "B",
              "ja": "それで、生地はもう混ぜましたか。まだなら直せます。",
              "vi": "Thế chị đã trộn bột chưa? Nếu chưa thì sửa được."
            }
          ]
        },
        {
          "id": "sj-thuong-16-b12-896-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "c3f63fa1-b340-524c-857c-ead760692af3",
          "situation_uid": "8c955248-01c8-5cec-b43d-4ae0a0392f32",
          "context_vi": "Khách nhầm mốc xây với mốc tu sửa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Khách tham quan",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người hướng dẫn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ここは明治時代に建てられたんですよね。",
              "vi": "Nơi này được xây vào thời Minh Trị phải không?"
            },
            {
              "speaker_id": "B",
              "ja": "建設はもっと前で、明治に修復されました。",
              "vi": "Nó được xây sớm hơn, đến thời Minh Trị mới trùng tu."
            },
            {
              "speaker_id": "A",
              "ja": "それで、当時の部分はどこに残っていますか。",
              "vi": "Vậy phần từ thời xây ban đầu còn ở đâu?"
            }
          ]
        }
      ]
    }
  ]
}
