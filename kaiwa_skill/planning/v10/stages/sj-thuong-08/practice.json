{
  "stage_uid": "579221be-9f7f-5e05-9b67-b5272bb2f715",
  "items": [
    {
      "item_id": "sj-thuong-08-b06-1646",
      "practice": [
        {
          "id": "sj-thuong-08-b06-1646-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ed2cfc85-1285-5107-a60f-5099aa4a6bc2",
          "situation_uid": "b47ac63a-0dcb-5a1a-b793-240462924cb5",
          "context_vi": "Giao việc cần kinh nghiệm xử lý khách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この案件はお客様との調整が鍵です。そこはあなたを頼りにしてます。",
              "vi": "Việc này mấu chốt ở điều phối với khách. Phần đó tôi trông cậy vào em."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。まず日程を確認します。",
              "vi": "Cảm ơn anh. Tôi sẽ xác nhận lịch trước."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b06-1646-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ed2cfc85-1285-5107-a60f-5099aa4a6bc2",
          "situation_uid": "fa885ca0-9c1a-5841-9f31-350e7a7a1756",
          "context_vi": "Người nhận cần hỗ trợ kỹ thuật.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "技術面は森さんが支援します。お客様との窓口はあなたを頼りにしてます。",
              "vi": "Mori sẽ hỗ trợ phần kỹ thuật. Tôi trông cậy vào em làm đầu mối với khách."
            },
            {
              "speaker_id": "B",
              "ja": "それなら担当できます。",
              "vi": "Nếu vậy tôi nhận được."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b06-1646-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f674a0d8-8cdf-5c8d-b686-349530f1e159",
          "situation_uid": "3efa5b04-f50a-5ae4-ac9f-12ae339068f4",
          "context_vi": "Sau tuần đầu bàn giao, hỏi người mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "未対応の問い合わせを整理してくれて助かったよ。引き続き頼りにしてます。",
              "vi": "Em đã sắp xếp những câu hỏi chưa trả lời, giúp tôi nhiều. Tôi tiếp tục trông cậy vào em."
            },
            {
              "speaker_id": "B",
              "ja": "残りの二件は明日確認します。",
              "vi": "Hai trường hợp còn lại tôi sẽ kiểm tra ngày mai."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-08-b06-2230",
      "practice": [
        {
          "id": "sj-thuong-08-b06-2230-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ed2cfc85-1285-5107-a60f-5099aa4a6bc2",
          "situation_uid": "4e42e7b6-9b9c-5326-b962-e71d6e5b4f28",
          "context_vi": "Chỉ rõ quyền tự quyết khoản nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "五万円以内の調整は任せた。それを超える場合は先に相談して。",
              "vi": "Các điều chỉnh trong mức 50.000 yên giao em quyết. Vượt mức đó thì hỏi trước nhé."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。境目で確認します。",
              "vi": "Tôi hiểu. Đến ngưỡng đó tôi sẽ hỏi."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b06-2230-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f674a0d8-8cdf-5c8d-b686-349530f1e159",
          "situation_uid": "3ad83be2-d885-5eb6-af83-28b7c80c8f18",
          "context_vi": "Bàn giao hai ưu tiên cho người thay.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "まず納期確認と顧客への連絡、この二つを任せた。費用の話は私が引き取る。",
              "vi": "Tôi giao em xác nhận tiến độ và liên hệ khách. Phần chi phí để tôi xử lý."
            },
            {
              "speaker_id": "B",
              "ja": "承知しました。今日中に状況を共有します。",
              "vi": "Tôi hiểu. Hôm nay tôi sẽ cập nhật tình hình."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b06-2230-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "02274e7c-dd76-58a5-b066-29542601c44f",
          "situation_uid": "1aeb02ff-de90-5401-bc4c-6d649d338862",
          "context_vi": "Sau khi leader quyết, phân phần phối hợp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "顧客への説明は任せた。検証結果は私がまとめる。",
              "vi": "Việc giải thích với khách tôi giao anh. Kết quả kiểm thử tôi sẽ tổng hợp."
            },
            {
              "speaker_id": "B",
              "ja": "了解。検証が終わったら教えて。",
              "vi": "Rõ. Xong kiểm thử thì báo tôi."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-08-b07-922",
      "practice": [
        {
          "id": "sj-thuong-08-b07-922-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ed2cfc85-1285-5107-a60f-5099aa4a6bc2",
          "situation_uid": "4f1b1b4f-2a39-5d49-94be-c47f30a9db85",
          "context_vi": "Trưởng nhóm trao quyền chọn cách kiểm thử trong phạm vi nhỏ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "一部署で試す範囲なら、方法はあなたにお任せします。",
              "vi": "Nếu thử trong một bộ phận, tôi để em tự chọn cách làm."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。結果は金曜に報告します。",
              "vi": "Tôi hiểu. Thứ Sáu tôi sẽ báo kết quả."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b07-922-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f674a0d8-8cdf-5c8d-b686-349530f1e159",
          "situation_uid": "b33e103b-f356-5fa4-9a6c-b4ecdde8ad8a",
          "context_vi": "Người mới hỏi khi nào cần hỏi lại người cũ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "例外対応で迷ったら、いつ連絡すればいいですか。",
              "vi": "Nếu phân vân về ngoại lệ, khi nào tôi nên liên hệ anh?"
            },
            {
              "speaker_id": "B",
              "ja": "通常の判断はお任せします。契約条件に触れるときだけ聞いてください。",
              "vi": "Các quyết định thông thường tôi giao chị tự chọn. Chỉ hỏi tôi khi đụng đến điều khoản hợp đồng."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b07-922-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e373a54b-ce41-581c-b387-386d8e15203a",
          "situation_uid": "784ecbff-5a45-5948-b828-585b6f1c9b76",
          "context_vi": "Xin cấp trên chọn ưu tiên giữa hai phương án.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Cấp trên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "どちらも対応できます。優先順位の判断は部長にお任せします。",
              "vi": "Tôi có thể xử lý cả hai. Tôi xin để trưởng phòng quyết thứ tự ưu tiên."
            },
            {
              "speaker_id": "B",
              "ja": "では、顧客への回答を先に。",
              "vi": "Vậy hãy trả lời khách trước."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-08-b07-1585",
      "practice": [
        {
          "id": "sj-thuong-08-b07-1585-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ed2cfc85-1285-5107-a60f-5099aa4a6bc2",
          "situation_uid": "5c25889d-dd26-5a58-bf59-b37cd401099e",
          "context_vi": "Nhân viên muốn nhận phần vừa sức.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この仕事、引き受けられそう？",
              "vi": "Em nhận việc này được không?"
            },
            {
              "speaker_id": "B",
              "ja": "顧客との日程調整は任せてください。見積もりは別の担当が必要です。",
              "vi": "Xin giao tôi phần điều phối lịch với khách. Báo giá cần người khác phụ trách."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b07-1585-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f674a0d8-8cdf-5c8d-b686-349530f1e159",
          "situation_uid": "a03e4fd8-cb45-55b2-9ef4-1a8508572746",
          "context_vi": "Người mới phát hiện thiếu thông tin.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "契約の更新日が資料にありません。確認は任せてください。今日中に共有します。",
              "vi": "Hồ sơ thiếu ngày gia hạn hợp đồng. Để tôi kiểm tra; hôm nay tôi sẽ chia sẻ lại."
            },
            {
              "speaker_id": "B",
              "ja": "助かります。",
              "vi": "Vậy giúp tôi nhiều."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b07-1585-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e373a54b-ce41-581c-b387-386d8e15203a",
          "situation_uid": "0b562700-fd45-5f9f-a928-827367de6b32",
          "context_vi": "Báo đã sửa và xin nhận theo dõi tiếp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Cấp trên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お客様には修正が届いた？",
              "vi": "Bản sửa đã đến tay khách chưa?"
            },
            {
              "speaker_id": "B",
              "ja": "はい。確認の電話も任せてください。午後に結果を報告します。",
              "vi": "Rồi ạ. Xin để tôi gọi xác nhận nữa. Chiều tôi sẽ báo kết quả."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-08-b20-560",
      "practice": [
        {
          "id": "sj-thuong-08-b20-560-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f674a0d8-8cdf-5c8d-b686-349530f1e159",
          "situation_uid": "7fb83218-31d2-5eb5-b37d-22aa46bd835f",
          "context_vi": "Hỏi mức hướng dẫn người nhận cần.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "手とり足とり説明したほうがいい？ それとも未決事項の一覧から見る？",
              "vi": "Tôi nên hướng dẫn từng bước hay bắt đầu từ danh sách việc chưa quyết?"
            },
            {
              "speaker_id": "B",
              "ja": "まず一覧を見たいです。分からない所だけ聞きます。",
              "vi": "Tôi muốn xem danh sách trước. Chỉ chỗ nào không hiểu tôi sẽ hỏi."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b20-560-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ed2cfc85-1285-5107-a60f-5099aa4a6bc2",
          "situation_uid": "6011c450-e69f-5f69-9708-5f1a85c2dc59",
          "context_vi": "Người nhận tưởng mọi việc đều phải xin duyệt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "小さな変更も毎回確認しますか。",
              "vi": "Thay đổi nhỏ cũng phải hỏi duyệt mỗi lần sao?"
            },
            {
              "speaker_id": "B",
              "ja": "手とり足とり指示するつもりはないよ。上限内なら自分で決めて。",
              "vi": "Tôi không định chỉ dẫn từng bước. Trong hạn mức thì em tự quyết."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b20-560-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f674a0d8-8cdf-5c8d-b686-349530f1e159",
          "situation_uid": "3faeafff-d0b2-5075-b188-56000ed9c3ec",
          "context_vi": "Kéo dài hỗ trợ người cũ thêm một tuần.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今週だけ、手とり足とりの引き継ぎをお願いできますか。判断の基準を一緒に見てほしいです。",
              "vi": "Chỉ tuần này, anh có thể hướng dẫn bàn giao kỹ từng bước không? Tôi muốn hai người cùng xem tiêu chí ra quyết định."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。午前中なら空いています。",
              "vi": "Được. Buổi sáng tôi rảnh."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-08-b12-2649",
      "practice": [
        {
          "id": "sj-thuong-08-b12-2649-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "ed2cfc85-1285-5107-a60f-5099aa4a6bc2",
          "situation_uid": "9bc77265-6c76-532e-88d0-f4fb202b9cab",
          "context_vi": "Nêu rõ đầu ra và hạn của việc giao.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "金曜までに、未解決の三件を一覧にしてお願いします。対応そのものはまだ始めなくていい。",
              "vi": "Nhờ em lập danh sách ba việc chưa giải quyết trước thứ Sáu. Chưa cần bắt đầu xử lý."
            },
            {
              "speaker_id": "B",
              "ja": "承知しました。",
              "vi": "Tôi hiểu."
            }
          ]
        },
        {
          "id": "sj-thuong-08-b12-2649-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "f674a0d8-8cdf-5c8d-b686-349530f1e159",
          "situation_uid": "ca1e6f22-8062-53b8-ae9f-7829d88ea535",
          "context_vi": "Cùng gọi khách giới thiệu đầu mối mới.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Khách hàng",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来週からのご連絡は佐藤にお願いします。私も今週は同席します。",
