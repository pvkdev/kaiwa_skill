{
  "stage_uid": "7ae5f51e-dcde-5589-b82e-e10b2fa9de7f",
  "items": [
    {
      "item_id": "sj-thuong-07-b20-297",
      "practice": [
        {
          "id": "sj-thuong-07-b20-297-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "031495a0-58af-5cf0-8815-a87fe5c9a076",
          "situation_uid": "78c29709-2bd5-53fe-9558-a90e51e8b550",
          "context_vi": "Chọn thứ tự gặp các bộ phận trước cuộc họp.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "本会議の前に、誰と話しておくべきかな。",
              "vi": "Trước cuộc họp chính, ta nên nói chuyện với ai?"
            },
            {
              "speaker_id": "B",
              "ja": "根回しとして、まず運用と営業に懸念を聞きます。賛成を取りつける前に実態を知りたいです。",
              "vi": "Để trao đổi trước, tôi sẽ hỏi lo ngại của bên vận hành và kinh doanh. Tôi muốn biết thực tế trước khi xin họ đồng thuận."
            }
          ]
        },
        {
          "id": "sj-thuong-07-b20-297-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "031495a0-58af-5cf0-8815-a87fe5c9a076",
          "situation_uid": "0d9f1a16-f4e4-50bf-a807-6227d1a030c1",
          "context_vi": "Chủ trì tưởng mọi bên đã đồng ý.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "根回しは済んだから、全員賛成ですね。",
              "vi": "Đã trao đổi trước rồi, vậy mọi người đều đồng ý nhỉ."
            },
            {
              "speaker_id": "B",
              "ja": "いいえ。意見は聞きましたが、営業はまだ懸念を持っています。",
              "vi": "Chưa ạ. Chúng tôi đã nghe ý kiến, nhưng bên kinh doanh vẫn còn lo ngại."
            }
          ]
        },
        {
          "id": "sj-thuong-07-b20-297-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e902b136-74af-5d7f-a19a-b24522cfa437",
          "situation_uid": "d2d7a212-8af8-5580-90a5-9acb18d2361f",
          "context_vi": "Chưa được tăng người, chuẩn bị hỏi ưu tiên cấp trên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "予算が増えないなら、先に優先順位を確認しましょう。",
              "vi": "Nếu ngân sách không tăng, ta nên xác nhận thứ tự ưu tiên trước."
            },
            {
              "speaker_id": "B",
              "ja": "そうだね。会議前に根回しして、影響を受けるチームにも聞こう。",
              "vi": "Đúng. Ta trao đổi trước cuộc họp và hỏi cả nhóm chịu ảnh hưởng."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-07-b20-457",
      "practice": [
        {
          "id": "sj-thuong-07-b20-457-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "031495a0-58af-5cf0-8815-a87fe5c9a076",
          "situation_uid": "93a99a37-0e21-599e-a2e1-57b626db94bb",
          "context_vi": "Nhóm vận hành phản đối vì thiếu người.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "反対が出たので、話を打ち切りますか。",
              "vi": "Có người phản đối rồi, ta dừng trao đổi sao?"
            },
            {
              "speaker_id": "B",
              "ja": "空気を読んで、今は理由を最後まで聞こう。人手が足りないなら計画を直せる。",
              "vi": "Hãy để ý tình hình và nghe hết lý do đã. Nếu thiếu người, ta có thể sửa kế hoạch."
            }
          ]
        },
        {
          "id": "sj-thuong-07-b20-457-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6ec3ce05-79e0-5486-9f86-1503e21525e5",
          "situation_uid": "de466a4f-5066-552f-8e58-a5be235203db",
          "context_vi": "Thành viên chưa muốn nói chuyện riêng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "最近、話しにくいこともありますか。",
              "vi": "Gần đây có điều gì em khó nói không?"
            },
            {
              "speaker_id": "B",
              "ja": "今は仕事の優先順位だけ相談したいです。",
              "vi": "Lúc này tôi chỉ muốn bàn thứ tự ưu tiên công việc."
            },
            {
              "speaker_id": "A",
              "ja": "分かった。空気を読んで、私から私生活のことは聞かないよ。",
              "vi": "Tôi hiểu. Tôi sẽ để ý và không hỏi về chuyện riêng."
            }
          ]
        },
        {
          "id": "sj-thuong-07-b20-457-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e902b136-74af-5d7f-a19a-b24522cfa437",
          "situation_uid": "4eda3b47-7adc-51af-96b1-9fc200668c49",
          "context_vi": "Nhóm khác cũng đang cần chuyên gia.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Đồng nghiệp",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "あちらも緊急の案件だそうです。",
              "vi": "Bên kia cũng có việc khẩn."
            },
            {
              "speaker_id": "B",
              "ja": "空気を読んで、こちらだけの事情で人を取らず、共通の上司に優先順位を聞こう。",
              "vi": "Ta nên nhìn tình hình, đừng lấy người chỉ vì việc bên mình; hãy hỏi cấp trên chung về ưu tiên."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-07-b12-1220",
      "practice": [
        {
          "id": "sj-thuong-07-b12-1220-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "031495a0-58af-5cf0-8815-a87fe5c9a076",
          "situation_uid": "140c5f14-e6cc-5273-8676-511d9a3e4f44",
          "context_vi": "Nêu đề xuất chưa chốt để hỏi lo ngại.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bộ phận vận hành",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "そうですね、まだ決まった案ではありません。今の段階で気になる点を教えてください。",
              "vi": "Để xem, đây chưa phải phương án đã chốt. Chị cho tôi biết điều gì đáng lo ở giai đoạn này nhé."
            },
            {
              "speaker_id": "B",
              "ja": "夜間対応が増えるかもしれません。",
              "vi": "Có thể việc trực đêm sẽ tăng."
            }
          ]
        },
        {
          "id": "sj-thuong-07-b12-1220-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6ec3ce05-79e0-5486-9f86-1503e21525e5",
          "situation_uid": "b6c3a119-8cda-533b-bc56-059537a66d17",
          "context_vi": "Thành viên nói đang quá tải.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今週は仕事が重なっていて…。",
              "vi": "Tuần này các việc chồng lên nhau..."
            },
            {
              "speaker_id": "B",
              "ja": "そうですね。まず締め切りと作業量を一緒に見ましょう。",
              "vi": "Để xem. Trước hết ta cùng xem hạn và khối lượng công việc."
            }
          ]
        },
        {
          "id": "sj-thuong-07-b12-1220-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e902b136-74af-5d7f-a19a-b24522cfa437",
          "situation_uid": "aade035c-a9e8-5b7b-a4a6-f34ed3c7fb82",
          "context_vi": "Tiến độ gần xong nhưng còn khách duyệt.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "この件はもう完了でいいかな。",
              "vi": "Việc này coi như xong được chưa?"
            },
            {
              "speaker_id": "B",
              "ja": "そうですね、作業は終わりました。ただ、顧客の承認はまだです。",
              "vi": "Để xem, phần làm đã xong. Nhưng khách vẫn chưa duyệt."
            }
          ]
        }
      ]
    },
    {
      "item_id": "sj-thuong-07-b12-976",
      "practice": [
        {
          "id": "sj-thuong-07-b12-976-ex01",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "031495a0-58af-5cf0-8815-a87fe5c9a076",
          "situation_uid": "a5e6c4b4-bc09-5b8e-8662-5b5f83831ab3",
          "context_vi": "Tìm bộ phận còn thiếu trong vòng tham vấn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ほかに聞いておくべき部署はある？",
              "vi": "Còn bộ phận nào cần hỏi trước không?"
            },
            {
              "speaker_id": "B",
              "ja": "ちなみに、夜間対応の窓口にも確認しましたか。",
              "vi": "Tiện hỏi thêm, ta đã xác nhận với đầu mối trực đêm chưa?"
            }
          ]
        },
        {
          "id": "sj-thuong-07-b12-976-ex02",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "6ec3ce05-79e0-5486-9f86-1503e21525e5",
          "situation_uid": "e56e11f9-97e9-5caa-9ef7-66a184ea192e",
          "context_vi": "Nhắc việc hai bên đã hứa sau buổi một đối một.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "来週までに優先順位を整理します。ちなみに、相談先の紹介はいつごろいただけますか。",
              "vi": "Tôi sẽ sắp xếp lại thứ tự ưu tiên trước tuần sau. Tiện thể, khoảng khi nào anh giới thiệu người hỗ trợ được ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "水曜までに連絡するよ。",
              "vi": "Tôi sẽ liên hệ trước thứ Tư."
            }
          ]
        },
        {
          "id": "sj-thuong-07-b12-976-ex03",
          "authorship": "ai_authored",
          "type": "dialogue",
          "topic_uid": "e902b136-74af-5d7f-a19a-b24522cfa437",
          "situation_uid": "732f43a2-88b1-596b-822f-4b4dcb642c6b",
          "context_vi": "Hỏi ai cần báo khách sau khi đổi ưu tiên.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Thành viên dự án",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Trưởng nhóm",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "ちなみに、この変更はお客様に誰から伝えますか。",
              "vi": "Tiện thể, ai sẽ báo thay đổi này cho khách ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "営業の佐藤から伝えてもらう。",
              "vi": "Để Sato bên kinh doanh báo."
            }
          ]
        }
      ]
    }
  ]
}
