{
  "stage_uid": "976ee7c4-9226-5723-bbe9-3e0f40700bd8",
  "items": [
    {
      "item_id": "sj-trung-12-b06-71",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn hỏi thăm sau lần khám trước.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その後、具合はどう？",
              "vi": "Sau đó sức khỏe cậu thế nào rồi?"
            },
            {
              "speaker_id": "B",
              "ja": "熱は下がったけど、咳がまだ出るよ。",
              "vi": "Tớ hết sốt rồi, nhưng vẫn còn ho."
            }
          ],
          "id": "sj-trung-12-b06-71-ex01",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "9ed9a8b9-9451-5dfd-b1b9-4126b060e7bc"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Gọi đổi lịch tái khám và nhân viên hỏi tình trạng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "その後、具合はいかがですか。",
              "vi": "Sau lần khám trước, tình trạng anh thế nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "痛みは少し減りました。",
              "vi": "Cơn đau giảm một chút rồi ạ."
            }
          ],
          "id": "sj-trung-12-b06-71-ex02",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "80fc9d67-ee5a-5ae9-aaea-1ac27a0596d0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi người nhà sau khi điều trị.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨日より具合はどう？",
              "vi": "So với hôm qua cậu thấy thế nào?"
            },
            {
              "speaker_id": "B",
              "ja": "少し楽になったよ。",
              "vi": "Dễ chịu hơn một chút."
            }
          ],
          "id": "sj-trung-12-b06-71-ex03",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "704fda2b-9d10-5a0c-8bbc-e1f813156705"
        }
      ]
    },
    {
      "item_id": "sj-trung-12-b07-160",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kết thúc cuộc gọi đổi lịch khi người kia còn ốm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "新しい予約は金曜日の十時です。お大事になさってください。",
              "vi": "Lịch hẹn mới là mười giờ thứ Sáu. Chúc anh mau khỏe ạ."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとうございます。",
              "vi": "Cảm ơn chị."
            }
          ],
          "id": "sj-trung-12-b07-160-ex01",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "80fc9d67-ee5a-5ae9-aaea-1ac27a0596d0"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bạn nói vẫn còn ho sau tái khám.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bạn",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "咳がまだ出るんだ。",
              "vi": "Tớ vẫn còn ho."
            },
            {
              "speaker_id": "B",
              "ja": "そうなんだ。お大事にね。",
              "vi": "Vậy à. Cậu giữ gìn nhé."
            }
          ],
          "id": "sj-trung-12-b07-160-ex02",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "9ed9a8b9-9451-5dfd-b1b9-4126b060e7bc"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Tạm biệt người nhà trước buổi tái khám.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Người nhà",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日は無理しないで。お大事に。",
              "vi": "Hôm nay đừng cố quá. Giữ gìn nhé."
            },
            {
              "speaker_id": "B",
              "ja": "ありがとう。",
              "vi": "Cảm ơn anh."
            }
          ],
          "id": "sj-trung-12-b07-160-ex03",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "704fda2b-9d10-5a0c-8bbc-e1f813156705"
        }
      ]
    },
    {
      "item_id": "sj-trung-12-b12-50",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bác sĩ hỏi liệu có thể quyết ngay không.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bác sĩ",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今日、治療法を決められそうですか。",
              "vi": "Hôm nay chị quyết định cách điều trị được không?"
            },
            {
              "speaker_id": "B",
              "ja": "そうですね、家族と話してから決めたいです。",
              "vi": "Để tôi nghĩ chút, tôi muốn bàn với gia đình rồi mới quyết."
            }
          ],
          "id": "sj-trung-12-b12-50-ex01",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "0a559938-cfcd-5fbe-8961-4d6c47df8088"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Phân biệt việc cần làm ngay và có thể chờ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bác sĩ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "そうですね、まず薬は始めて、検査の予約は後で決めてもいいですか。",
              "vi": "Để tôi nghĩ, trước hết dùng thuốc, còn lịch xét nghiệm quyết sau được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、それで大丈夫です。",
              "vi": "Vâng, như vậy được."
            }
          ],
          "id": "sj-trung-12-b12-50-ex02",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "d97aa26c-91f2-52fa-820a-8392bb0decfb"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Bác sĩ cân nhắc giữa hai phương án.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Bác sĩ",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "そうですね。症状を見ると、まず検査をしてから決めるのがよさそうです。",
              "vi": "Để tôi xem. Theo triệu chứng thì nên xét nghiệm trước rồi mới quyết."
            },
            {
              "speaker_id": "B",
              "ja": "分かりました。",
              "vi": "Tôi hiểu rồi ạ."
            }
          ],
          "id": "sj-trung-12-b12-50-ex03",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "7504e72f-eb55-586a-8eff-c2a7ce2eeb29"
        }
      ]
    },
    {
      "item_id": "sj-trung-12-b24-38",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chờ kết quả nên lo lắng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "結果がまだ出なくて、ずっと気になっています。",
              "vi": "Chưa có kết quả nên tôi cứ lo mãi."
            },
            {
              "speaker_id": "B",
              "ja": "明日には分かる予定です。",
              "vi": "Dự kiến ngày mai sẽ có ạ."
            }
          ],
          "id": "sj-trung-12-b24-38-ex01",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "353dddd3-c129-53cf-8f1e-d4d7414fe772"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Trước khi nghe kết quả, tim đập nhanh.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bác sĩ",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "結果を聞く前は、いつもドキドキします。",
              "vi": "Trước khi nghe kết quả, tim tôi luôn đập thình thịch."
            },
            {
              "speaker_id": "B",
              "ja": "ゆっくりお話ししますね。",
              "vi": "Tôi sẽ giải thích từ từ nhé."
            }
          ],
          "id": "sj-trung-12-b24-38-ex02",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "ea113391-beb7-5913-a1bc-21f26e23e136"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Lo về việc đổi kế hoạch điều trị.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Bác sĩ",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "前の予定と変わった理由が気になっています。",
              "vi": "Tôi băn khoăn vì sao kế hoạch lại thay đổi."
            },
            {
              "speaker_id": "B",
              "ja": "検査で新しいことが分かったからです。",
              "vi": "Vì xét nghiệm cho thấy thông tin mới ạ."
            }
          ],
          "id": "sj-trung-12-b24-38-ex03",
          "topic_uid": "c68fc9e0-c783-5a79-ada3-f788800c4a64",
          "situation_uid": "c9700ada-32dc-5fa5-8601-a75bb51dda82"
        }
      ]
    }
  ]
}
