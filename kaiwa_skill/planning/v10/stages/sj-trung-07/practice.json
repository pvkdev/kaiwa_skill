  "stage_uid": "977dba57-7855-5014-80dc-a159fa8387b9",
  "items": [
    {
      "item_id": "sj-trung-07-b18-377",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên gợi đặt màu khác có ngay.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "青でしたら、今日お持ち帰りいただけます。",
              "vi": "Màu xanh thì hôm nay quý khách lấy được ạ."
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、結構です。白が入るのを待ちます。",
              "vi": "Không, xin cảm ơn. Tôi sẽ đợi màu trắng."
            }
          ],
          "id": "sj-trung-07-b18-377-ex01",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "94853317-0155-528a-bfbf-9e61d739b2c7"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Từ chối mẫu vượt ngân sách.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらの上位モデルはいかがですか。",
              "vi": "Quý khách xem mẫu cao cấp hơn này được không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、結構です。予算を超えてしまうので。",
              "vi": "Không, xin cảm ơn. Mẫu đó vượt ngân sách của tôi."
            }
          ],
          "id": "sj-trung-07-b18-377-ex02",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "c18607b6-0ab7-5187-abac-e58330dd15b8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Không nhận gợi ý mua thêm phụ kiện.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "別売りのケースもお付けしますか。",
              "vi": "Quý khách có muốn mua thêm hộp đựng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、結構です。本体だけでお願いします。",
              "vi": "Không, cảm ơn. Tôi chỉ lấy máy thôi."
            }
          ],
          "id": "sj-trung-07-b18-377-ex03",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "906df393-59c8-5a27-8362-066093c2f6a1"
        }
      ]
    },
    {
      "item_id": "sj-trung-07-b18-343",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Nhân viên xác nhận phiên bản và số lượng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "白の小さいサイズを一つでよろしいですか。",
              "vi": "Một chiếc màu trắng cỡ nhỏ, đúng không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、それで結構です。",
              "vi": "Vâng, như vậy được ạ."
            }
          ],
          "id": "sj-trung-07-b18-343-ex01",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "32ec3b13-ee75-5f8d-a35d-213c7dc00a58"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hỏi món đổi cùng loại đã phù hợp chưa.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらの同じ型でよろしいでしょうか。",
              "vi": "Đổi sang chiếc cùng mẫu này được chứ ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、これで結構です。",
              "vi": "Vâng, chiếc này được ạ."
            }
          ],
          "id": "sj-trung-07-b18-343-ex02",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "377b3d78-90db-5bc5-8b56-19bc398cff69"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Kiểm đủ phụ kiện trước khi nhận món đổi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "説明書とケーブルも入っています。ほかに必要なものはございますか。",
              "vi": "Có cả sách hướng dẫn và dây cáp ạ. Quý khách còn cần gì không?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、これで結構です。",
              "vi": "Không, như vậy đủ rồi ạ."
            }
          ],
          "id": "sj-trung-07-b18-343-ex03",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "16668e02-ad20-5110-ac90-a3ac89d209bc"
        }
      ]
    },
    {
      "item_id": "sj-trung-07-b07-105",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Ngày hàng về chưa chắc chắn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "入荷日はまだ決まっていません。",
              "vi": "Ngày hàng về vẫn chưa xác định ạ."
            },
            {
              "speaker_id": "B",
              "ja": "そうですか。ちょっと考えます。",
              "vi": "Vậy à. Tôi sẽ suy nghĩ thêm."
            }
          ],
          "id": "sj-trung-07-b07-105-ex01",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "d1157ca0-1f65-5e1c-ad19-310d317add58"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Cân nhắc đổi món hay chờ đúng mẫu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "今交換するか、同じ型を待つか選べます。",
              "vi": "Quý khách có thể đổi ngay hoặc chờ đúng mẫu."
            },
            {
              "speaker_id": "B",
              "ja": "ちょっと考えさせてください。",
              "vi": "Cho tôi suy nghĩ một chút ạ."
            }
          ],
          "id": "sj-trung-07-b07-105-ex02",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "0dbb32c8-2a45-5fb5-ba88-d0bece0fc799"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chưa rõ điều kiện đổi trả.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "条件を確認してから決めたいので、ちょっと考えます。",
              "vi": "Tôi muốn xem kỹ điều kiện rồi mới quyết, nên sẽ cân nhắc thêm."
            },
            {
              "speaker_id": "B",
              "ja": "かしこまりました。",
              "vi": "Vâng ạ."
            }
          ],
          "id": "sj-trung-07-b07-105-ex03",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "aa390f80-be4c-5723-922e-10361b646c2d"
        }
      ]
    },
    {
      "item_id": "sj-trung-07-b07-98",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chưa muốn đặt khi ngày giao không rõ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "このままご注文なさいますか。",
              "vi": "Quý khách đặt luôn chứ ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、結構です。日が決まってからにします。",
              "vi": "Không, xin cảm ơn. Tôi sẽ đợi khi có ngày giao."
            }
          ],
          "id": "sj-trung-07-b07-98-ex01",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "2ca26000-121b-56ff-bf8b-95c41cc01dbb"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Không mua gói mở rộng.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "保証を延長しますか。",
              "vi": "Quý khách có muốn gia hạn bảo hành không ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、結構です。通常の保証でお願いします。",
              "vi": "Không, cảm ơn. Tôi lấy bảo hành thông thường thôi."
            }
          ],
          "id": "sj-trung-07-b07-98-ex02",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "c18607b6-0ab7-5187-abac-e58330dd15b8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Không mua món không hợp nhu cầu.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "こちらの商品はいかがですか。",
              "vi": "Quý khách thấy sản phẩm này thế nào ạ?"
            },
            {
              "speaker_id": "B",
              "ja": "いいえ、結構です。必要な機能がないので。",
              "vi": "Không, cảm ơn. Nó thiếu chức năng tôi cần."
            }
          ],
          "id": "sj-trung-07-b07-98-ex03",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "ee37d725-2a9b-5ea7-9b54-af9a846a4cb8"
        }
      ]
    },
    {
      "item_id": "sj-trung-07-b06-141",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hóa đơn ghi món khác món đã nhận.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "受け取った品物とレシートの型番が違います。このままでは納得がいきません。",
              "vi": "Mã mẫu trên món tôi nhận khác trên hóa đơn. Tôi chưa thể chấp nhận như thế này."
            },
            {
              "speaker_id": "B",
              "ja": "申し訳ありません。確認します。",
              "vi": "Xin lỗi quý khách. Tôi sẽ kiểm tra."
            }
          ],
          "id": "sj-trung-07-b06-141-ex01",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "dd542a4d-9441-5713-bf7a-ebedb41dc016"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Hai đầu mối cho hướng xử lý khác nhau.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "昨日と今日で説明が違うので、納得がいかないんです。担当の方に確認していただけますか。",
              "vi": "Hôm qua và hôm nay giải thích khác nhau nên tôi chưa thấy thỏa đáng. Anh kiểm tra với người phụ trách giúp tôi được không?"
            },
            {
              "speaker_id": "B",
              "ja": "はい、確認いたします。",
              "vi": "Vâng, tôi sẽ kiểm tra."
            }
          ],
          "id": "sj-trung-07-b06-141-ex02",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "088a19fb-9321-533f-8b9d-ec53a46d26bb"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Món thay vẫn cùng lỗi.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "交換後も同じ不具合が出ました。原因が分からないままでは納得がいきません。",
              "vi": "Đổi rồi mà vẫn lỗi như cũ. Chưa rõ nguyên nhân thì tôi không yên tâm chấp nhận."
            },
            {
              "speaker_id": "B",
              "ja": "詳しく調べます。",
              "vi": "Chúng tôi sẽ kiểm tra kỹ."
            }
          ],
          "id": "sj-trung-07-b06-141-ex03",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "82c5630f-8416-5e3f-89ee-1820f84b8df0"
        }
      ]
    },
    {
      "item_id": "sj-trung-07-b12-41",
      "practice": [
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Mẫu tốt có giá cao hơn.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "male"
            },
            {
              "id": "B",
              "role_vi": "Bạn",
              "gender": "female"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "性能はいい。といっても、予算を一万円超えるなら考え直すよ。",
              "vi": "Tính năng tốt thật. Nhưng nếu vượt ngân sách một vạn yên thì tớ phải nghĩ lại."
            },
            {
              "speaker_id": "B",
              "ja": "必要な機能を絞ろうか。",
              "vi": "Hay chọn lại những chức năng cần thiết."
            }
          ],
          "id": "sj-trung-07-b12-41-ex01",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "c18607b6-0ab7-5187-abac-e58330dd15b8"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Có thể đặt hàng nhưng ngày giao chưa rõ.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Nhân viên",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Tôi",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "お取り寄せはできます。",
              "vi": "Chúng tôi có thể đặt hàng giúp."
            },
            {
              "speaker_id": "B",
              "ja": "そうですか。といっても、届く日が分からないと注文しにくいです。",
              "vi": "Vậy à. Nhưng nếu không biết ngày hàng đến thì tôi khó đặt lắm."
            }
          ],
          "id": "sj-trung-07-b12-41-ex02",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "d1157ca0-1f65-5e1c-ad19-310d317add58"
        },
        {
          "authorship": "ai_authored",
          "type": "dialogue",
          "context_vi": "Chờ đúng mẫu có vẻ ổn nhưng cần sớm.",
          "speakers": [
            {
              "id": "A",
              "role_vi": "Tôi",
              "gender": "female"
            },
            {
              "id": "B",
              "role_vi": "Nhân viên",
              "gender": "male"
            }
          ],
          "turns": [
            {
              "speaker_id": "A",
              "ja": "同じ型を待てます。といっても、来月までかかるなら別の案を考えたいです。",
              "vi": "Tôi có thể đợi đúng mẫu. Nhưng nếu phải sang tháng sau thì tôi muốn tính cách khác."
            },
            {
              "speaker_id": "B",
              "ja": "入荷予定を調べます。",
              "vi": "Tôi sẽ kiểm tra lịch hàng về."
            }
          ],
          "id": "sj-trung-07-b12-41-ex03",
          "topic_uid": "c3ff4d9b-f6e8-57d5-97b5-dc52deef0999",
          "situation_uid": "0dbb32c8-2a45-5fb5-ba88-d0bece0fc799"
        }
      ]
    }
  ]
}
