  "items": [
    {
      "id": "S-056-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người báo mất đồ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "財布をなくしました。",
          "vi": "Tôi bị mất ví ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Cảnh sát tại chốt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "財布は何色でしたか。",
          "vi": "Ví của chị màu gì ạ?"
        }
      ]
    },
    {
      "id": "S-056-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người báo mất đồ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "私の財布は小さくて黒いです。",
          "vi": "Ví của tôi nhỏ, màu đen ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người báo mất đồ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "財布の表に赤い星があります。",
          "vi": "Mặt trước ví có hình ngôi sao màu đỏ ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người báo mất đồ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "電車を降りたときは、まだ財布を持っていました。",
          "vi": "Lúc xuống tàu tôi vẫn còn cầm ví ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người báo mất đồ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "家に帰る途中で、財布がないことに気づきました。",
          "vi": "Trên đường về nhà, tôi mới nhận ra mình mất ví ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người báo mất đồ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "財布には現金とキャッシュカードが入っていました。",
          "vi": "Trong ví có tiền mặt và thẻ ATM ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người báo mất đồ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "診察券も財布に入っていたかもしれません。",
          "vi": "Có thể trong ví còn có thẻ khám bệnh nữa ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người gọi hỏi cảnh sát"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "似た財布が届いたら、電話で連絡してもらえますか。",
          "vi": "Nếu có ai mang tới một chiếc ví tương tự, anh gọi báo cho tôi được không ạ?"
        }
      ]
    },
    {
      "id": "S-056-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Cảnh sát tại chốt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "財布のことを問い合わせるときは、受理番号を教えてください。",
          "vi": "Khi gọi hỏi về chiếc ví, chị cho tôi xin mã hồ sơ ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người xem ảnh đồ tại chốt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この財布は茶色ですが、私の財布は黒です。",
          "vi": "Chiếc ví này màu nâu, còn ví tôi màu đen ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người gọi bổ sung hồ sơ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "財布の中に小さい写真があったことも書いてもらえますか。",
          "vi": "Anh ghi thêm giúp tôi là trong ví có một tấm ảnh nhỏ được không ạ?"
        }
      ]
    },
    {
      "id": "S-056-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người gọi báo thêm cho cảnh sát"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "最後に財布を使ったのは、駅の切符売り場です。",
          "vi": "Lần cuối tôi dùng ví là ở quầy vé nhà ga ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Chủ thẻ gọi ngân hàng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "なくしたキャッシュカードを止めてください。",
          "vi": "Nhờ anh khóa giúp tôi thẻ ATM bị mất ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên ngân hàng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "本人確認のために、お名前と生年月日を教えてください。",
          "vi": "Để xác minh danh tính, chị cho tôi xin họ tên và ngày tháng năm sinh ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Chủ thẻ gọi ngân hàng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "キャッシュカードはもう利用停止になりましたか。",
          "vi": "Thẻ ATM của tôi đã được khóa chưa ạ?"
        }
      ]
    },
    {
      "id": "S-056-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Chủ thẻ vừa tìm lại được thẻ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "見つかったキャッシュカードは、また使えますか。",
          "vi": "Tôi tìm lại được thẻ ATM rồi, giờ tôi có dùng lại thẻ đó được không ạ?"
        }
      ]
    },
    {
      "id": "S-056-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người mang đồ nhặt được đến chốt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "駅の前のベンチで、この傘を拾いました。",
          "vi": "Tôi nhặt được chiếc ô này ở ghế dài trước ga ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Cảnh sát tại chốt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "かばんの受け取りには身分証明書が必要です。",
          "vi": "Chị cần mang giấy tờ tùy thân để nhận lại túi ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người đến nhận túi"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "私のかばんは青くて、内側に名前が書いてあります。",
          "vi": "Túi của tôi màu xanh lam, bên trong có ghi tên ạ."
        }
      ]
    },
    {
      "id": "S-056-V13-021",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người hỏi cảnh sát cách nhận lại túi"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "かばんを受け取るときは、何を持って来ればいいですか。",
          "vi": "Khi đến nhận lại túi, tôi cần mang theo gì ạ?"
        }
      ]
    },
    {
      "id": "S-056-V13-022",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người cập nhật với cảnh sát"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "駅で財布を受け取りましたが、キャッシュカードは入っていませんでした。",
          "vi": "Tôi đã nhận lại ví ở ga, nhưng bên trong không có thẻ ATM ạ."
        }
      ]
    }
  ]
