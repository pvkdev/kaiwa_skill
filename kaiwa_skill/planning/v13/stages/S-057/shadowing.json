{
  "id": "74d2ca57-008a-5bea-b514-37d41e6a9480-shadowing",
  "type": "shadowing",
  "items": [
    {
      "id": "S-057-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người vừa đến nơi sơ tán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "避難所の受付はどこですか。",
          "vi": "Bàn tiếp nhận của nơi sơ tán ở đâu ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người hỏi tại bàn tiếp nhận"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この避難所にはまだ空きがありますか。",
          "vi": "Nơi sơ tán này còn chỗ không ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên bàn tiếp nhận"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この避難所は今いっぱいです。",
          "vi": "Nơi sơ tán này hiện đã hết chỗ ạ."
        }
      ]
    },
    {
      "id": "S-057-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người đến cùng gia đình"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "子どもと祖母と一緒に休める場所はありますか。",
          "vi": "Có chỗ nào để tôi nghỉ cùng con và bà tôi không ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người được chỉ đến nơi sơ tán khác"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "次に行く避難所を地図で教えてください。",
          "vi": "Xin chỉ giúp tôi trên bản đồ nơi sơ tán tôi cần đến tiếp ạ."
        }
      ]
    },
    {
      "id": "S-057-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người hỏi khu nghỉ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "家族が寝る場所はどこですか。",
          "vi": "Chỗ ngủ của gia đình tôi ở đâu ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người hỏi chỗ lấy nước"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "飲み水はどこでもらえますか。",
          "vi": "Tôi có thể lấy nước uống ở đâu ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người phụ trách phát nước"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "水は一人一本ずつ、列に並んで受け取ってください。",
          "vi": "Mọi người xếp hàng nhận nước, mỗi người một chai nhé."
        }
      ]
    },
    {
      "id": "S-057-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người hỏi đồ cho con"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "子どものおむつはここでもらえますか。",
          "vi": "Tôi có thể xin tã cho con ở đây được không ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người muốn hỏi lại về tã"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "おむつのことは、何時にまた聞きに来ればいいですか。",
          "vi": "Tôi nên quay lại lúc mấy giờ để hỏi về tã ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người đi cùng bà"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "祖母の薬がもうすぐなくなるので、医療スタッフに相談したいです。",
          "vi": "Thuốc bà tôi dùng sắp hết, tôi muốn hỏi ý kiến nhân viên y tế ạ."
        }
      ]
    },
    {
      "id": "S-057-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người phụ trách khu nghỉ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "新しいお知らせは一階の掲示板に出します。",
          "vi": "Chúng tôi sẽ dán thông báo mới lên bảng ở tầng một ạ."
        }
      ]
    },
    {
      "id": "S-057-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người nhờ tìm mẹ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "母とまだ連絡が取れません。",
          "vi": "Tôi vẫn chưa liên lạc được với mẹ ạ."
        }
      ]
    },
    {
      "id": "S-057-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người nhờ tìm mẹ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "母に最後に会ったのは、今朝、さくら町の家です。",
          "vi": "Lần cuối tôi gặp mẹ là sáng nay, ở nhà tại khu Sakura ạ."
        }
      ]
    },
    {
      "id": "S-057-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên hỗ trợ tìm người thân"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "同じ名前の方がお母様かどうか、避難所に確認します。",
          "vi": "Chúng tôi sẽ hỏi nơi sơ tán đó để xác nhận người trùng tên có phải mẹ chị không ạ."
        }
      ]
    },
    {
      "id": "S-057-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người vừa nhận tin của mẹ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "母から電話があって、無事だと分かりました。",
          "vi": "Mẹ tôi vừa gọi, tôi biết mẹ đã an toàn rồi ạ."
        }
      ]
    },
    {
      "id": "S-057-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người chưa liên lạc được với mẹ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "携帯の電波が入らないので、私のいる場所を受付に伝えてもいいですか。",
          "vi": "Điện thoại tôi không có sóng, tôi để lại chỗ mình đang ở tại bàn tiếp nhận được không ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người ở cùng bà tại nơi sơ tán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "祖母が眠れないので、もう少し静かな所に移れますか。",
          "vi": "Bà tôi không ngủ được, chúng tôi chuyển sang chỗ yên hơn một chút được không ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người xác nhận chuyển khu"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "家族三人とも、新しい区画に移ってもいいですか。",
          "vi": "Cả ba người nhà tôi đều có thể chuyển sang khu mới được không ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người báo đổi điểm đến"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "行き先が北小学校から北体育館に変わりました。",
          "vi": "Nơi chúng tôi đến đã đổi từ Trường Tiểu học Kita sang Nhà thi đấu Kita ạ."
        }
      ]
    },
    {
      "id": "S-057-V13-021",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người báo xe chưa đến"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "車がまだ来ないので、家族三人ともここで待っています。",
          "vi": "Xe chưa đến nên cả ba người nhà tôi vẫn đang đợi ở đây ạ."
        }
      ]
    },
    {
      "id": "S-057-V13-022",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người báo bàn tiếp nhận sau khi đổi khu"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "家族で二階のBに移ったので、受付の記録を変えてもらえますか。",
          "vi": "Gia đình tôi đã chuyển sang khu B tầng hai, anh cập nhật giúp chỗ ở trong sổ tiếp nhận được không ạ?"
        }
      ]
    },
    {
      "id": "S-057-V13-023",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người sắp rời nơi sơ tán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "新しい避難所に着いたら、どの番号に連絡すればいいですか。",
          "vi": "Khi đến nơi sơ tán mới, tôi cần gọi số nào ạ?"
        }
      ]
    }
  ]
}
