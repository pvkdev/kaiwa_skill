      ]
    },
    {
      "id": "S-050-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách nói với dược sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この薬は食前に飲むのか、食後に飲むのか教えてください。",
          "vi": "Anh cho tôi biết thuốc này uống trước hay sau bữa ăn ạ."
