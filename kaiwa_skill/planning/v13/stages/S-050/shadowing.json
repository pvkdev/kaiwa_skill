      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "薬のことはどのカウンターで聞けますか。",
          "vi": "Tôi có thể hỏi về thuốc ở quầy nào ạ?"
        }
      ]
    },
    {
