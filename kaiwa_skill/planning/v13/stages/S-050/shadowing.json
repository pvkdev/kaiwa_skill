    },
    {
      "id": "S-050-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách nói với dược sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この症状は、近くのどの医療機関に相談すればいいですか。",
          "vi": "Với triệu chứng này, tôi nên hỏi cơ sở y tế nào gần đây ạ?"
