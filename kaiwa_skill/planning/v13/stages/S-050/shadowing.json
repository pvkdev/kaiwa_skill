      ]
    },
    {
      "id": "S-050-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách nói với dược sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "商品名が聞き取れなかったので、箱のどこにあるか教えてください。",
          "vi": "Tôi nghe không rõ tên sản phẩm, anh chỉ giúp tên nằm chỗ nào trên hộp ạ."
