      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách hỏi nhân viên hiệu thuốc"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "薬剤師さんには何時ごろ相談できますか。",
          "vi": "Khoảng mấy giờ tôi có thể gặp dược sĩ để hỏi ạ?"
        }
      ]
    },
    {
      "id": "S-050-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách hỏi nhân viên hiệu thuốc"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "いつもの薬が売り切れなら、別の薬について相談できますか。",
          "vi": "Nếu hết loại thuốc tôi hay mua, tôi hỏi về loại khác được không ạ?"
        }
      ]
    },
    {
      "id": "S-050-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách hỏi nhân viên hiệu thuốc"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この箱に入っているのは、薬ですか、それとも化粧品ですか。",
          "vi": "Trong hộp này là thuốc hay mỹ phẩm ạ?"
        }
      ]
    },
    {
      "id": "S-050-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách nói với dược sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今朝からお腹が痛いので、薬のことで相談してもいいですか。",
          "vi": "Tôi đau bụng từ sáng nay, nhờ dược sĩ tư vấn về thuốc được không ạ?"
        }
      ]
    },
    {
      "id": "S-050-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Dược sĩ hỏi khách"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お腹の真ん中がずっと痛いんですか。",
          "vi": "Chị bị đau liên tục ở giữa bụng phải không ạ?"
        }
      ]
    },
    {
      "id": "S-050-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách nói với dược sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "別の薬も飲んでいるので、この薬との飲み合わせを確認してもらえますか。",
          "vi": "Tôi đang uống thuốc khác nữa, anh kiểm tra giúp tôi có dùng cùng thuốc này được không ạ?"
        }
      ]
    },
    {
      "id": "S-050-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Dược sĩ hỏi khách"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お薬手帳にある、今飲んでいる薬の名前を見せていただけますか。",
          "vi": "Chị cho tôi xem tên thuốc đang dùng trong sổ theo dõi thuốc được không ạ?"
        }
