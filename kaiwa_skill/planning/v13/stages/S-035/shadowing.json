        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bạn nhờ người quen giúp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "二階の部屋への行き方を教えてくれる？",
          "vi": "Cậu chỉ tớ đường đến phòng trên tầng hai được không?"
        }
      ]
    },
    {
      "id": "S-035-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bạn nhờ người quen giúp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このかばんを五分だけ預かってくれる？",
          "vi": "Cậu giữ giúp tớ cái túi này năm phút thôi được không?"
        }
      ]
    },
    {
      "id": "S-035-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bạn được nhờ giúp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "三時までなら、ここでかばんを預かれるよ。",
          "vi": "Tớ giữ túi giúp cậu ở đây đến ba giờ thì được nhé."
        }
      ]
    },
    {
      "id": "S-035-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bạn nhờ người quen giúp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "紙を置いてすぐ戻るから、かばんをあと二分だけ見ててくれる？",
          "vi": "Tớ sang đặt giấy rồi quay lại ngay, cậu trông túi thêm hai phút thôi được không?"
        }
      ]
    },
    {
      "id": "S-035-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bạn nhờ người quen giúp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "急いでるなら、かばんは自分で持っていくね。",
          "vi": "Nếu cậu đang vội thì tớ tự mang túi đi nhé."
        }
      ]
    },
    {
      "id": "S-035-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhờ khách qua đường"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "箱を持っているので、ドアを開けていただけますか。",
          "vi": "Tôi đang bê thùng, anh mở cửa giúp tôi được không ạ?"
        }
      ]
    },
    {
      "id": "S-035-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhờ khách qua đường"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このスマホで写真を一枚撮っていただけますか。",
          "vi": "Anh chụp giúp tôi một tấm ảnh bằng điện thoại này được không ạ?"
        }
      ]
    },
    {
      "id": "S-035-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhờ khách qua đường"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お急ぎなら、写真は自分で撮りますね。",
          "vi": "Nếu anh đang vội thì tôi tự chụp ảnh ạ."
        }
      ]
    },
    {
      "id": "S-035-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhờ khách qua đường"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "荷物が重いんですが、ここまで運ぶのを手伝っていただけますか。",
          "vi": "Đồ nặng quá, anh giúp tôi chuyển đến chỗ này được không ạ?"
        }
      ]
    },
    {
      "id": "S-035-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhờ khách qua đường"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "写真を撮ってくださって、助かりました。",
          "vi": "Cảm ơn anh đã chụp ảnh giúp tôi ạ."
        }
      ]
    },
    {
      "id": "S-035-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bạn nhờ người quen giúp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "用事がまだ終わらないから、かばんをあと五分だけ預かってもらえる？",
          "vi": "Việc của tớ vẫn chưa xong, cậu giữ túi thêm năm phút nữa được không?"
        }
      ]
    },
    {
      "id": "S-035-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bạn được nhờ giúp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "三時に出るから、かばんは入口まで取りに来てね。",
          "vi": "Ba giờ tớ phải đi, cậu ra cửa lấy túi nhé."
        }
      ]
    },
    {
      "id": "S-035-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bạn nhờ người quen giúp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "かばんを受け取るのは、三時じゃなくて三時半だよね。",
          "vi": "Tớ nhận túi lúc ba giờ rưỡi, không phải ba giờ, đúng không?"
        }
      ]
    },
    {
      "id": "S-035-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bạn nhờ người quen giúp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "三時半にセンターの入口までかばんを取りに行くね。",
          "vi": "Ba giờ rưỡi tớ đến cửa trung tâm lấy túi nhé."
        }
      ]
    },
    {
      "id": "S-035-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bạn nhờ người quen giúp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "かばんを預かってくれて助かったよ。",
          "vi": "Cảm ơn cậu đã giữ túi giúp tớ nhé."
        }
      ]
    },
    {
      "id": "S-035-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhận lời giúp bạn cùng lớp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "部屋の準備は、何から手伝えばいい？",
          "vi": "Chuẩn bị phòng thì tớ phụ việc gì trước?"
        }
      ]
    },
    {
      "id": "S-035-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhận lời giúp bạn cùng lớp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "三時に出るから、箱一つなら運べるよ。",
          "vi": "Ba giờ tớ phải đi, tớ chuyển được một thùng thôi nhé."
        }
      ]
    },
    {
      "id": "S-035-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhận lời giúp bạn cùng lớp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "ごめん、今日は用事があって、いすを運ぶのは手伝えないんだ。",
          "vi": "Xin lỗi, hôm nay tớ có việc nên không phụ chuyển ghế được."
        }
      ]
    },
    {
      "id": "S-035-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhận lời giúp bạn cùng lớp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "いすを並べるのと紙を貼るの、どっちを先にすればいい？",
          "vi": "Tớ nên xếp ghế hay dán giấy trước?"
        }
      ]
    },
    {
      "id": "S-035-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhận lời giúp bạn cùng lớp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "紙はもうドアに貼ったけど、まだいすが二つ残ってるよ。",
          "vi": "Tớ dán giấy lên cửa rồi, vẫn còn hai chiếc ghế chưa xếp nhé."
        }
      ]
    }
