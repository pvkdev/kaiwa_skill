{
  "id": "1d1fc916-15b1-5b9f-b7c0-304d53087e02-shadowing",
  "type": "shadowing",
  "items": [
    {
      "id": "S-041-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo trưởng ca"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "会議で使う封筒を二十セット受け取りました。",
          "vi": "Tôi đã nhận 20 bộ phong bì dùng cho cuộc họp ạ."
        }
      ]
    },
    {
      "id": "S-041-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo trưởng ca"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今から会議用の袋を作り始めます。",
          "vi": "Bây giờ tôi bắt đầu chuẩn bị các túi tài liệu cho cuộc họp ạ."
        }
      ]
    },
    {
      "id": "S-041-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo trưởng ca"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "何時に袋の進み具合を報告すればいいですか。",
          "vi": "Mấy giờ tôi cần báo tiến độ chuẩn bị túi tài liệu ạ?"
        }
      ]
    },
    {
      "id": "S-041-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo trưởng ca"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今のところ、用意する袋の半分ができています。",
          "vi": "Tính đến giờ tôi đã chuẩn bị xong một nửa số túi ạ."
        }
      ]
    },
    {
      "id": "S-041-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo trưởng ca"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "名前のシールが五枚足りないので、このままでは全部の袋が作れません。",
          "vi": "Thiếu năm nhãn tên, cứ thế này thì tôi chưa làm xong hết các túi được ạ."
        }
      ]
    },
    {
      "id": "S-041-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Trưởng ca trao đổi với nhân viên"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "会議までに、追加のシールが何枚必要ですか。",
          "vi": "Trước giờ họp, anh cần thêm bao nhiêu nhãn dán?"
        }
      ]
    },
    {
      "id": "S-041-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo đồng nghiệp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今日の会議室は三階の三〇五号室に変更になりました。",
          "vi": "Phòng họp hôm nay chuyển sang phòng 305 ở tầng ba rồi nhé."
        }
      ]
    },
    {
      "id": "S-041-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo đồng nghiệp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今日の会議は二階ではなく、三階の三〇五号室です。",
          "vi": "Cuộc họp hôm nay ở phòng 305 tầng ba, không phải tầng hai nhé."
        }
      ]
    },
    {
      "id": "S-041-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo đồng nghiệp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "会議室は変わりましたが、会議の時間は同じです。",
          "vi": "Phòng họp đổi rồi, nhưng giờ họp vẫn như cũ nhé."
        }
      ]
    },
    {
      "id": "S-041-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo đồng nghiệp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "荷物は午後四時ごろ届く予定ですが、まだ時間は決まっていません。",
          "vi": "Dự kiến hàng đến khoảng 4 giờ chiều, giờ cụ thể vẫn chưa chốt nhé."
        }
      ]
    },
    {
      "id": "S-041-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo đồng nghiệp"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "荷物が受付に届いたので、受け取りをお願いします。",
          "vi": "Hàng đã đến quầy lễ tân rồi, nhờ chị ra nhận giúp nhé."
        }
      ]
    },
    {
      "id": "S-041-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên bàn giao cuối ca"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "二十セットのうち十五セットは完成しています。",
          "vi": "Trong 20 bộ thì 15 bộ đã xong rồi."
        }
      ]
    },
    {
      "id": "S-041-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên bàn giao cuối ca"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "残りの五セットは、名前のシールが届いたら仕上げてください。",
          "vi": "Năm bộ còn lại, nhờ chị làm nốt khi nhãn tên về nhé."
        }
      ]
    },
    {
      "id": "S-041-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nhận ca sau"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "急ぎの五セットは作れますが、在庫の確認まではできません。",
          "vi": "Tôi làm được năm bộ cần gấp, nhưng không thể kiểm luôn cả hàng trong kho."
        }
      ]
    },
    {
      "id": "S-041-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên bàn giao cuối ca"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "シールの在庫は誰に確認してもらえばいいですか。",
          "vi": "Tôi nên nhờ ai kiểm tra số nhãn trong kho ạ?"
        }
      ]
    },
    {
      "id": "S-041-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo trưởng ca"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "残りの五セットが完成したか、朝一番に確認します。",
          "vi": "Đầu giờ sáng tôi sẽ kiểm tra xem năm bộ còn lại đã xong chưa ạ."
        }
      ]
    },
    {
      "id": "S-041-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo trưởng ca"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "受付に届いた荷物に受取人の名前がないので、どうすればいいですか。",
          "vi": "Kiện hàng đến quầy lễ tân không có tên người nhận, tôi nên xử lý thế nào ạ?"
        }
      ]
    },
    {
      "id": "S-041-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Trưởng ca trao đổi với nhân viên"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "送り状に差出人の名前があるか確かめてください。",
          "vi": "Anh kiểm tra xem trên phiếu gửi hàng có tên người gửi không nhé."
        }
      ]
    },
    {
      "id": "S-041-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Trưởng ca trao đổi với nhân viên"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "受取人が確認できるまで、その荷物は受付に置いておいてください。",
          "vi": "Anh cứ để kiện hàng đó ở quầy lễ tân cho tới khi xác định được người nhận nhé."
        }
      ]
    }
  ]
}
