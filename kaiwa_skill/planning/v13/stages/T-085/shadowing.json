{
  "id": "b3eb7a7f-38b1-52c1-a2a0-4b2295779e70-shadowing",
  "type": "shadowing",
  "items": [
    {
      "id": "T-085-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お電話ありがとうございます、みどり工業の営業部でございます。",
          "vi": "Xin chào, phòng kinh doanh công ty Midori Kōgyō nghe máy ạ."
        }
      ]
    },
    {
      "id": "T-085-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Đối tác gọi điện"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "いつもお世話になっております、青葉商事の購買部の春田です。",
          "vi": "Chào chị, tôi là Haruta bên bộ phận thu mua của Aoba Shōji."
        }
      ]
    },
    {
      "id": "T-085-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "恐れ入りますが、会社名だけもう一度お願いできますか。",
          "vi": "Phiền anh nhắc lại riêng tên công ty giúp tôi được không ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お名前を正しく控えたいので、もう一度ゆっくりおっしゃっていただけますか。",
          "vi": "Để tôi ghi đúng tên anh, anh nói lại chậm hơn một lần giúp tôi được không ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お名前の漢字表記も確認させていただけますか。",
          "vi": "Cho tôi hỏi thêm tên anh viết bằng chữ Hán thế nào được không ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Đối tác gọi điện"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "はるたは、春夏秋冬の「春」に田んぼの「田」と書きます。",
          "vi": "Haruta viết bằng chữ “xuân” trong bốn mùa và chữ “điền” nghĩa là ruộng ạ."
        }
      ]
    },
    {
      "id": "T-085-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "差し支えなければ、技術部へのご用件を伺ってもよろしいでしょうか。",
          "vi": "Nếu tiện, anh cho tôi biết anh gọi bên kỹ thuật về việc gì được không ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Đối tác gọi điện"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "先週の点検資料について、技術部の佐藤様をお願いできますか。",
          "vi": "Về tài liệu kiểm tra thiết bị tuần trước, chị cho tôi gặp anh Sato bên kỹ thuật được không ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Đối tác gọi điện"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "詳しい内容は、担当の佐藤様に直接お話ししてもよろしいでしょうか。",
          "vi": "Tôi xin trao đổi chi tiết trực tiếp với anh Sato phụ trách việc này được không ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "技術部の佐藤におつなぎしますので、少々お待ちください。",
          "vi": "Tôi sẽ nối máy với anh Sato bên kỹ thuật. Xin anh đợi một chút ạ."
        }
      ]
    },
    {
      "id": "T-085-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お電話が少し遠いようですので、発注番号の最後の二桁だけもう一度お願いできますか。",
          "vi": "Đường dây hơi khó nghe, anh đọc lại riêng hai số cuối của mã đơn mua hàng được không ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "念のため復唱しますが、発注番号は六、一、五、八でよろしいでしょうか。",
          "vi": "Tôi xin đọc lại mã đơn mua hàng cho chắc, sáu, một, năm, tám, đúng không ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Đối tác gọi điện"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "発注番号の末尾は三ではなく四で、全体では五、二、七、四です。",
          "vi": "Số cuối của mã đơn là bốn chứ không phải ba, cả dãy là năm, hai, bảy, bốn ạ."
        }
      ]
    },
    {
      "id": "T-085-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "失礼いたしました、発注番号は五、二、七、四でお調べします。",
          "vi": "Tôi xin lỗi, tôi sẽ tra đơn theo mã năm, hai, bảy, bốn ạ."
        }
      ]
    },
    {
      "id": "T-085-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "納品の曜日を確認したいのですが、火曜日と木曜日のどちらでしょうか。",
          "vi": "Tôi xin xác nhận lại thứ giao hàng, là thứ Ba hay thứ Năm ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "納品は十二月十日の午前十一時まででよろしいでしょうか。",
          "vi": "Giao hàng muộn nhất mười một giờ sáng ngày 10 tháng 12, đúng không ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "配送担当の木村から、今おかけの番号に午後三時までに折り返す予定です。",
          "vi": "Kimura phụ trách giao hàng dự kiến sẽ gọi lại theo số anh đang dùng muộn nhất ba giờ chiều."
        }
      ]
    },
    {
      "id": "T-085-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "担当が何時に折り返せるか決まらなくても、午後二時までに私から一度ご連絡いたします。",
          "vi": "Dù chưa chốt được giờ gọi lại, tôi vẫn sẽ liên hệ cập nhật cho anh muộn nhất hai giờ chiều ạ."
        }
      ]
    },
    {
      "id": "T-085-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên chủ động gọi lại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "配送担当の木村が午後三時半にお電話できますが、その時間のご都合はいかがでしょうか。",
          "vi": "Kimura phụ trách giao hàng có thể gọi lúc ba giờ rưỡi chiều, giờ đó anh có tiện nghe máy không ạ?"
        }
      ]
    },
    {
      "id": "T-085-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "資料は明日の午前中にお送りしますので、正午までに届かなければ私にご連絡ください。",
          "vi": "Tôi sẽ gửi tài liệu trong sáng mai. Nếu đến trưa anh chưa nhận được thì liên hệ giúp tôi nhé."
        }
      ]
    },
    {
      "id": "T-085-V13-021",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nghe máy"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お電話いただきありがとうございました、失礼いたします。",
          "vi": "Cảm ơn anh đã gọi. Tôi xin phép gác máy ạ."
        }
      ]
    }
  ]
}
