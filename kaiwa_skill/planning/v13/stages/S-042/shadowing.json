      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người gọi điện cho bạn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "もしもし、今ちょっと話せる？",
          "vi": "A lô, giờ cậu nói chuyện một chút được không?"
        }
      ]
    },
    {
      "id": "S-042-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người gọi điện cho bạn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "明日の約束の時間を確かめたくて電話したよ。",
          "vi": "Tớ gọi để hỏi lại giờ hẹn ngày mai nhé."
        }
      ]
    },
    {
      "id": "S-042-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người gọi điện cho bạn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "名前がよく聞こえなかったから、もう一度言ってくれる？",
          "vi": "Tớ nghe không rõ tên cậu, cậu nói lại một lần nữa được không?"
        }
      ]
    },
    {
      "id": "S-042-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người gọi điện cho bạn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "電話番号を間違えたみたいだから、確かめてからかけ直すね。",
          "vi": "Hình như tớ bấm nhầm số, tớ kiểm lại rồi gọi lại nhé."
        }
      ]
    },
    {
      "id": "S-042-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người gọi điện cho bạn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今話せないなら、夜七時にかけ直すね。",
          "vi": "Nếu giờ cậu chưa nói chuyện được, tối bảy giờ tớ gọi lại nhé."
        }
      ]
    },
    {
      "id": "S-042-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Học viên gọi cho cô giáo"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "もしもし、森先生、グエンですが、今お話ししてもよろしいですか。",
          "vi": "A lô, cô Mori ạ, em là Nguyễn, giờ cô có tiện nói chuyện một chút không ạ?"
        }
      ]
    },
    {
      "id": "S-042-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Học viên gọi cho cô giáo"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "夜分にお電話してすみません。",
          "vi": "Em xin lỗi vì gọi cho cô muộn thế này ạ."
        }
      ]
    },
    {
      "id": "S-042-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Học viên gọi cho cô giáo"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "明日の授業は九時からでよろしいでしょうか。",
          "vi": "Cho em hỏi lớp ngày mai bắt đầu lúc 9 giờ đúng không ạ?"
        }
      ]
    },
    {
      "id": "S-042-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Học viên nói với người nhà cô giáo"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "グエンと申しますが、森先生はいらっしゃいますか。",
          "vi": "Cháu là Nguyễn, cho cháu hỏi cô Mori có nhà không ạ?"
        }
      ]
    },
    {
      "id": "S-042-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Học viên nói với người nhà cô giáo"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "私が午後六時にかけ直すと、森先生にお伝えいただけますか。",
          "vi": "Bác nhắn giúp cháu với cô Mori là sáu giờ chiều cháu sẽ tự gọi lại được không ạ?"
        }
      ]
    },
    {
      "id": "S-042-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Học viên gọi cho cô giáo"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "先ほど授業のことでお電話したグエンです。",
          "vi": "Em là Nguyễn, lúc nãy có gọi cho cô hỏi về buổi học ạ."
        }
      ]
    },
    {
      "id": "S-042-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Học viên gọi cho cô giáo"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "授業の時間を教えていただき、ありがとうございました。",
          "vi": "Em cảm ơn cô đã cho em biết giờ học ạ."
        }
      ]
    },
    {
      "id": "S-042-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi đặt bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "二人で行きたいんですが、金曜日の夜七時は席が空いていますか。",
          "vi": "Tối thứ Sáu lúc 7 giờ có bàn cho hai người không ạ?"
        }
      ]
    },
    {
      "id": "S-042-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên nhận đặt bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "七時は満席ですが、七時半なら二名様のお席が空いています。",
          "vi": "Lúc 7 giờ đã hết bàn, nhưng 7 giờ rưỡi còn bàn cho hai người ạ."
        }
      ]
    },
    {
      "id": "S-042-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi đặt bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "予約は三人じゃなくて、二人でお願いします。",
          "vi": "Chỗ tôi đặt là cho hai người, không phải ba ạ."
        }
      ]
    },
    {
      "id": "S-042-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi đặt bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "予約の確認ですが、金曜日の夜七時にグエンの名前で二人ですね。",
          "vi": "Cho tôi xác nhận, tối thứ Sáu lúc 7 giờ có bàn cho hai người dưới tên Nguyễn, đúng không ạ?"
        }
      ]
    },
    {
      "id": "S-042-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi đặt bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今夜は満席とのことですので、また別の日にお電話します。",
          "vi": "Vậy tối nay quán hết bàn rồi, hôm khác tôi sẽ gọi lại ạ."
        }
      ]
    },
    {
      "id": "S-042-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi đặt bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "七時に予約したグエンですが、十分ほど遅れそうです。",
          "vi": "Tôi là Nguyễn, có đặt bàn lúc 7 giờ, chắc tôi đến trễ khoảng mười phút ạ."
        }
      ]
    },
    {
      "id": "S-042-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi đặt bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "七時に間に合わないので、予約した時間を変更できますか。",
          "vi": "Tôi không kịp đến lúc 7 giờ, tôi đổi giờ đặt bàn được không ạ?"
        }
      ]
    },
    {
      "id": "S-042-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi đặt bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "七時の予約に間に合わなかったので、七時半の席を確認していただけますか。",
          "vi": "Tôi không đến kịp giờ đặt lúc 7 giờ, chị kiểm tra giúp tôi lúc 7 giờ rưỡi còn chỗ không ạ?"
        }
      ]
    },
    {
      "id": "S-042-V13-021",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi đặt bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "七時半に、グエンの名前で二人の席をお願いできますか。",
          "vi": "Chị đặt giúp tôi bàn cho hai người lúc 7 giờ rưỡi dưới tên Nguyễn được không ạ?"
        }
      ]
    },
    {
      "id": "S-042-V13-022",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đến quầy đón khách"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "予約を七時半に変更していただいたグエンです。",
          "vi": "Tôi là Nguyễn, đã đổi giờ đặt bàn sang 7 giờ rưỡi ạ."
        }
      ]
