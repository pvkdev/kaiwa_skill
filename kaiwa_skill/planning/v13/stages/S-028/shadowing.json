{
  "id": "29ae1409-8211-5fc4-9082-88ad7ef5face-shadowing",
  "type": "shadowing",
  "items": [
    {
      "id": "S-028-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mua đồ cũ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この中古のランプはまだ点きますか。",
          "vi": "Chiếc đèn cũ này vẫn sáng được chứ ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mua đồ cũ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このスーツケースのファスナーを開けてもいいですか。",
          "vi": "Tôi mở thử khóa kéo chiếc va li này được không ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mua đồ cũ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このカメラに充電器は付いていますか。",
          "vi": "Máy ảnh này có kèm bộ sạc không ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mua đồ cũ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この椅子の脚はぐらつきませんか。",
          "vi": "Chân chiếc ghế này có bị lung lay không ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên cửa hàng đồ cũ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この扇風機はここでは動かせないので、奥で確認しますね。",
          "vi": "Chiếc quạt này không chạy thử ở đây được nên tôi vào trong kiểm tra nhé."
        }
      ]
    },
    {
      "id": "S-028-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mua đồ cũ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "車輪が動きにくいので、このスーツケースはやめておきます。",
          "vi": "Bánh xe khó lăn nên tôi xin thôi, không lấy chiếc va li này ạ."
        }
      ]
    },
    {
      "id": "S-028-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mua đồ cũ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "配送料を入れると、椅子は全部でいくらですか。",
          "vi": "Tính cả phí giao hàng thì chiếc ghế này hết bao nhiêu ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mua đồ cũ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "『現状渡し』と書いてありますが、このランプに保証はありますか。",
          "vi": "Chiếc đèn có ghi «bán theo hiện trạng» này có được bảo hành không ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mua đồ cũ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "椅子の傷をもう一度見てから決めます。",
          "vi": "Tôi xem lại vết xước trên ghế rồi mới quyết định ạ."
        }
      ]
    },
    {
      "id": "S-028-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mua đồ cũ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "カメラの箱に充電器とストラップは両方入っていますか。",
          "vi": "Trong hộp máy ảnh có đủ cả bộ sạc lẫn dây đeo không ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đem đồ đến bán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "こちらで中古の椅子を買い取ってもらえますか。",
          "vi": "Cửa hàng mình có thu mua ghế cũ không ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đem đồ đến bán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "二年使ったスピーカーですが、音量のボタンが少し固いです。",
          "vi": "Chiếc loa này tôi dùng hai năm rồi, nút âm lượng hơi khó bấm ạ."
        }
      ]
    },
    {
      "id": "S-028-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đem đồ đến bán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "スピーカーの査定に何分ぐらいかかりますか。",
          "vi": "Định giá chiếc loa này mất khoảng bao nhiêu phút ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đem đồ đến bán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "査定が終わるまで店の中を見ていてもいいですか。",
          "vi": "Trong lúc chờ định giá xong, tôi đi xem quanh cửa hàng được không ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đem đồ đến bán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "思ったより安いので、スピーカーは持って帰ります。",
          "vi": "Giá thu mua thấp hơn tôi nghĩ nên tôi xin mang loa về ạ."
        }
      ]
    },
    {
      "id": "S-028-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đem đồ đến bán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "昨日のスピーカーは、電源コードも付けて売ります。",
          "vi": "Chiếc loa hôm qua, tôi sẽ bán kèm cả dây nguồn ạ."
        }
      ]
    },
    {
      "id": "S-028-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi sau khi bán đồ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "さっき売ったカメラの充電器を今から持って行ってもいいですか。",
          "vi": "Giờ tôi mang bộ sạc của chiếc máy ảnh vừa bán đến được không ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi sau khi mua đồ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "買ったランプの箱に電源コードがなかったので、店で確認してもらえますか。",
          "vi": "Hộp đèn tôi mua thiếu dây nguồn, nhờ cửa hàng kiểm tra giúp tôi được không ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi sau khi mua đồ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "ランプの電源コードのことで、何時ごろ電話すればいいですか。",
          "vi": "Về dây nguồn của đèn, khoảng mấy giờ tôi nên gọi lại hỏi ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi lại cửa hàng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "ランプの電源コードは倉庫で見つかりましたか。",
          "vi": "Đã tìm thấy dây nguồn của đèn trong kho chưa ạ?"
        }
      ]
    },
    {
      "id": "S-028-V13-021",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đến lấy phụ kiện"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "ランプの電源コードはどのカウンターで受け取れますか。",
          "vi": "Tôi nhận dây nguồn của đèn tại quầy nào ạ?"
        }
      ]
    }
  ]
}
