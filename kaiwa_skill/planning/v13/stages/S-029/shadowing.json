{
  "id": "58c1dc4c-c367-5a13-87fe-c525a16e98b9-shadowing",
  "type": "shadowing",
  "items": [
    {
      "id": "S-029-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách chọn kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "仕事で使うメガネが欲しいです。",
          "vi": "Tôi muốn mua kính để dùng khi làm việc ạ."
        }
      ]
    },
    {
      "id": "S-029-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách chọn kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この二つのフレームはどちらが軽いですか。",
          "vi": "Trong hai gọng này, gọng nào nhẹ hơn ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách chọn kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このフレームを掛けてみてもいいですか。",
          "vi": "Tôi đeo thử gọng này được không ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách thử gọng kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このフレームは右のこめかみに当たります。",
          "vi": "Gọng này cấn ở thái dương bên phải ạ."
        }
      ]
    },
    {
      "id": "S-029-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách chọn kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このレンズを入れられる紺のフレームはありますか。",
          "vi": "Có gọng xanh navy nào lắp được tròng này không ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách chọn kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このフレームなら耳が痛くならないので、これにします。",
          "vi": "Đeo gọng này tôi không bị đau tai, nên tôi lấy gọng này ạ."
        }
      ]
    },
    {
      "id": "S-029-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đặt làm kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "新しいメガネを作る前に、今のメガネの度数を確認できますか。",
          "vi": "Trước khi làm kính mới, cửa hàng kiểm giúp tôi độ của kính đang dùng được không ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách thử độ kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この度数だと近くの字がまだ見にくいです。",
          "vi": "Với độ kính này, nhìn chữ ở gần vẫn hơi khó ạ."
        }
      ]
    },
    {
      "id": "S-029-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên đo kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "本を読むときと同じ距離でもう一度確認しますね。",
          "vi": "Tôi sẽ kiểm lại ở đúng khoảng cách anh thường đọc sách nhé."
        }
      ]
    },
    {
      "id": "S-029-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đặt làm kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "レンズを取り寄せると、メガネはいつごろ受け取れそうですか。",
          "vi": "Nếu phải đặt tròng về, dự kiến khi nào tôi nhận được kính ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách hỏi giá kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "レンズの料金はフレームの料金とは別ですか。",
          "vi": "Tiền tròng kính có tính riêng với tiền gọng không ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách hỏi giá kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "フレームとレンズを合わせると、合計はいくらですか。",
          "vi": "Tính cả gọng và tròng thì tổng cộng bao nhiêu ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách thử kính mới"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "下を向くと、メガネが鼻のほうにずれます。",
          "vi": "Cứ cúi xuống là kính lại trượt xuống mũi ạ."
        }
      ]
    },
    {
      "id": "S-029-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách thử kính mới"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このメガネの鼻パッドを少し調整してもらえますか。",
          "vi": "Nhờ cửa hàng chỉnh nhẹ miếng đệm mũi của kính này giúp tôi được không ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách chờ chỉnh kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "メガネの調整が終わるのは何時ごろですか。",
          "vi": "Khoảng mấy giờ thì cửa hàng chỉnh kính xong ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách thử kính sau khi chỉnh"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "下を向いても、メガネがずれなくなりました。",
          "vi": "Giờ tôi cúi xuống kính cũng không trượt nữa ạ."
        }
      ]
    },
    {
      "id": "S-029-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi hẹn chỉnh kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "先日買ったメガネのつるが耳の後ろに当たります。",
          "vi": "Càng của chiếc kính tôi mua mấy hôm trước bị cấn sau tai ạ."
        }
      ]
    },
    {
      "id": "S-029-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi hẹn chỉnh kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今日の午後、メガネの掛かり具合を見てもらえますか。",
          "vi": "Chiều nay tôi qua nhờ cửa hàng xem kính đeo có vừa không được không ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách hỏi nơi khám mắt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "片目だけ急に見えにくくなったので、近くの眼科を教えてもらえますか。",
          "vi": "Một bên mắt tôi đột nhiên nhìn không rõ, cửa hàng chỉ giúp tôi phòng khám mắt gần đây được không ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách từng mua kính"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "レシートがあれば、前に作ったメガネの度数を確認できますか。",
          "vi": "Nếu còn biên lai, tôi có thể xem lại độ của kính làm lần trước không ạ?"
        }
      ]
    },
    {
      "id": "S-029-V13-021",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đem kính quay lại cửa hàng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "レンズはそのままで、曲がったフレームだけ調整してください。",
          "vi": "Nhờ cửa hàng giữ nguyên tròng kính và chỉ chỉnh lại phần gọng bị lệch giúp tôi ạ."
        }
      ]
    }
  ]
}
