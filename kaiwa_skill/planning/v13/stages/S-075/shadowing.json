{
  "id": "4018562d-44c4-5e72-9274-28b090befd0d-shadowing",
  "type": "shadowing",
  "items": [
    {
      "id": "S-075-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bạn bàn chuyến đi biển"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "海の近くの町に旅行したいな。",
          "vi": "Tớ muốn đi du lịch ở một thị trấn gần biển."
        }
      ]
    },
    {
      "id": "S-075-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bạn hỏi số đêm nghỉ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "海の近くの宿に泊まるなら、一泊と二泊のどっちがいい？",
          "vi": "Ở chỗ nghỉ gần biển, cậu thích ở một đêm hay hai đêm?"
        }
      ]
    },
    {
      "id": "S-075-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bạn rút ngắn chuyến đi"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "日曜しか休めないなら、日帰りにしようか。",
          "vi": "Nếu cậu chỉ nghỉ được Chủ nhật, mình đi về trong ngày nhé?"
        }
      ]
    },
    {
      "id": "S-075-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bạn nhắc lại ngày đi và về"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "来週の金曜に出発して、土曜の午後に帰るんだよね。",
          "vi": "Mình đi thứ Sáu tuần sau, về chiều thứ Bảy, đúng không?"
        }
      ]
    },
    {
      "id": "S-075-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách hỏi phòng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "五月十二日に大人二人で一泊できる部屋はありますか。",
          "vi": "Ngày mười hai tháng Năm, khách sạn có phòng cho hai người lớn ở một đêm không ạ?"
        }
      ]
    },
    {
      "id": "S-075-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên báo phòng thay thế"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "ツインは満室ですが、ダブルなら空いています。",
          "vi": "Phòng hai giường đơn đã hết, nhưng vẫn còn phòng một giường đôi ạ."
        }
      ]
    },
    {
      "id": "S-075-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách đang so giá phòng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "二人で泊まる場合、一部屋の料金はいくらですか。",
          "vi": "Nếu hai người ở, giá một phòng là bao nhiêu ạ?"
        }
      ]
    },
    {
      "id": "S-075-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách chốt đặt phòng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "グエン・ランの名前で、五月二十日からダブルを一泊予約したいです。",
          "vi": "Tôi muốn đặt một phòng giường đôi trong một đêm từ ngày hai mươi tháng Năm, dưới tên Nguyễn Lan ạ."
        }
      ]
    },
    {
      "id": "S-075-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách hỏi giờ tới khách sạn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "チェックインは何時からですか。",
          "vi": "Tôi có thể nhận phòng từ mấy giờ ạ?"
        }
      ]
    },
    {
      "id": "S-075-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách đến quầy nhận phòng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "グエン・ランの名前で予約していますが、チェックインをお願いできますか。",
          "vi": "Tôi đã đặt dưới tên Nguyễn Lan, cho tôi nhận phòng ạ."
        }
      ]
    },
    {
      "id": "S-075-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách tới sớm muốn gửi vali"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "チェックインまで、フロントに荷物を預けてもいいですか。",
          "vi": "Tôi gửi hành lý ở quầy lễ tân đến giờ nhận phòng được không ạ?"
        }
      ]
    },
    {
      "id": "S-075-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Lễ tân dặn khách khi lấy hành lý"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "荷物を受け取るときは、この札をフロントでお見せください。",
          "vi": "Khi lấy lại hành lý, chị đưa thẻ này cho lễ tân xem nhé."
        }
      ]
    },
    {
      "id": "S-075-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách đưa thông tin khi chưa tìm thấy đặt phòng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "ホテルの予約番号は、このメールに書いてあります。",
          "vi": "Mã đặt phòng khách sạn nằm trong email này ạ."
        }
      ]
    },
    {
      "id": "S-075-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Lễ tân trao thẻ phòng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "四〇五号室のカードキーはこちらです。",
          "vi": "Đây là thẻ khóa của phòng bốn không năm ạ."
        }
      ]
    },
    {
      "id": "S-075-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách hỏi đường từ khách sạn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "古い町並みを見に行きたいんですが、ホテルから歩いて行けますか。",
          "vi": "Tôi muốn đến xem khu phố cổ, từ khách sạn đi bộ tới được không ạ?"
        }
      ]
    },
    {
      "id": "S-075-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách gọi báo thiếu khăn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "四〇三号室ですが、バスタオルが一枚足りません。",
          "vi": "Tôi ở phòng bốn không ba, trong phòng thiếu một khăn tắm lớn ạ."
        }
      ]
    },
    {
      "id": "S-075-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách hỏi bao lâu chăn tới"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お願いした毛布は、あとどのくらいで部屋に届きますか。",
          "vi": "Khoảng bao lâu nữa chăn tôi xin sẽ được mang tới phòng ạ?"
        }
      ]
    },
    {
      "id": "S-075-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách gọi nhắc về chăn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "四〇五号室ですが、お願いした毛布がまだ届いていません。",
          "vi": "Tôi ở phòng bốn không năm, chăn tôi xin vẫn chưa được mang lên ạ."
        }
      ]
    },
    {
      "id": "S-075-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách báo đã nhận chăn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "毛布を受け取りましたので、もう大丈夫です。",
          "vi": "Tôi nhận được chăn rồi, giờ thì ổn ạ."
        }
      ]
    },
    {
      "id": "S-075-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách hỏi hạn trả phòng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "明日のチェックアウトは、朝十時までで合っていますか。",
          "vi": "Sáng mai trả phòng chậm nhất lúc mười giờ, đúng không ạ?"
        }
      ]
    },
    {
      "id": "S-075-V13-021",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách muốn gửi đồ sau khi trả phòng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "チェックアウトしてから、午後二時まで荷物を預けてもいいですか。",
          "vi": "Sau khi trả phòng, tôi gửi hành lý đến hai giờ chiều được không ạ?"
        }
      ]
    },
    {
      "id": "S-075-V13-022",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách hỏi khoản chưa rõ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この千二百円は、一人分の朝食代ですか。",
          "vi": "Một nghìn hai trăm yên ở dòng này là tiền một suất ăn sáng ạ?"
        }
      ]
    },
    {
      "id": "S-075-V13-023",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Lễ tân xác nhận tổng tiền"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "部屋代と朝食代を合わせて、一万千二百円です。",
          "vi": "Tổng tiền phòng và bữa sáng là mười một nghìn hai trăm yên ạ."
        }
      ]
    },
    {
      "id": "S-075-V13-024",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bạn kể về chuyến đi"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "次は朝市が開いている日を調べてから行くよ。",
          "vi": "Lần sau tớ xem chợ sáng mở hôm nào rồi mới đi."
        }
      ]
    }
  ]
}
