{
  "id": "9e5b1a57-ab8c-5523-b47a-1b3a0643ff90-shadowing",
  "type": "shadowing",
  "items": [
    {
      "id": "S-043-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "はい、月商事の鈴木です。",
          "vi": "Vâng, Suzuki ở công ty Tsuki xin nghe ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách gọi từ công ty đối tác"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "営業部の田中さんをお願いします。",
          "vi": "Cho tôi gặp chị Tanaka ở phòng kinh doanh ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "恐れ入りますが、お名前をもう一度伺えますか。",
          "vi": "Xin phép, anh nhắc lại tên giúp tôi được không ạ?"
        }
      ]
    },
    {
      "id": "S-043-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "森田商事の伊藤様ですね。",
          "vi": "Anh là Ito ở công ty Morita Shōji, đúng không ạ?"
        }
      ]
    },
    {
      "id": "S-043-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "営業部の田中におつなぎしますので、少々お待ちください。",
          "vi": "Tôi sẽ chuyển máy cho chị Tanaka phòng kinh doanh, anh chờ một chút ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên gọi máy nội bộ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "田中さん、森田商事の伊藤様からの電話をおつなぎしてもいいですか。",
          "vi": "Chị Tanaka ơi, tôi chuyển cuộc gọi của anh Ito ở công ty Morita Shōji cho chị được không?"
        }
      ]
    },
    {
      "id": "S-043-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người phụ trách nhận cuộc gọi"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今なら電話に出られますので、こちらにつないでください。",
          "vi": "Giờ tôi nghe máy được, anh chuyển sang đây giúp tôi nhé."
        }
      ]
    },
    {
      "id": "S-043-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Khách gọi từ công ty đối tác"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "すみません、総務ではなく、経理の方をお願いします。",
          "vi": "Cho tôi gặp người bên kế toán, không phải bên tổng vụ ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "先ほど経理を総務と聞き違えてしまい、申し訳ありません。",
          "vi": "Lúc nãy tôi nghe nhầm kế toán thành tổng vụ, thành thật xin lỗi ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "経理につなげるか確認しますので、少々お待ちください。",
          "vi": "Tôi sẽ kiểm tra xem có chuyển sang kế toán được không, anh chờ một chút ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "担当の佐藤は、ただ今電話に出られません。",
          "vi": "Chị Sato phụ trách việc này, hiện chị ấy chưa nghe máy được ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "佐藤は会議中ですが、ご伝言をお預かりしましょうか。",
          "vi": "Chị Sato đang họp, anh có muốn để lại lời nhắn không ạ?"
        }
      ]
    },
    {
      "id": "S-043-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "一分後も佐藤が会議中でしたら、こちらからお知らせします。",
          "vi": "Sau một phút nếu chị Sato vẫn đang họp, tôi sẽ báo anh ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "三時ごろまたお電話をいただくと、佐藤に伝えておきます。",
          "vi": "Tôi sẽ nhắn với chị Sato là khoảng 3 giờ anh sẽ gọi lại ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "佐藤の戻る時間をお知らせするので、お電話番号を伺えますか。",
          "vi": "Để báo anh giờ chị Sato quay lại, cho tôi xin số điện thoại được không ạ?"
        }
      ]
    },
    {
      "id": "S-043-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "佐藤が戻る時間を確認してから、会社の代表番号に折り返します。",
          "vi": "Tôi sẽ kiểm tra giờ chị Sato quay lại rồi gọi lại số chính của công ty anh ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "先ほどお電話が切れてしまい、申し訳ありません。",
          "vi": "Lúc nãy cuộc gọi bị ngắt, thành thật xin lỗi ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên trực điện thoại"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "もう一度つなぐ前に、田中が電話に出られるか確認します。",
          "vi": "Trước khi nối lại máy, tôi sẽ kiểm tra xem chị Tanaka có nghe được không ạ."
        }
      ]
    },
    {
      "id": "S-043-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên gọi máy nội bộ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "田中さん、伊藤様にかけ直しましたが、今つないでもいいですか。",
          "vi": "Chị Tanaka ơi, tôi đã gọi lại cho anh Ito, giờ tôi chuyển máy cho chị được không?"
        }
      ]
    }
  ]
}
