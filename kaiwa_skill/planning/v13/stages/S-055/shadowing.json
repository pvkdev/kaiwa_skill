{
  "id": "094099fd-43d3-582c-ad02-517959c88556-shadowing",
  "type": "shadowing",
  "items": [
    {
      "id": "S-055-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người gọi 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "二階から煙が出ています。",
          "vi": "Có khói bốc ra từ tầng hai ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người tiếp nhận 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "建物の住所を教えてください。",
          "vi": "Chị cho tôi biết địa chỉ tòa nhà ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người gọi 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "住所はさくら町三の十二です。",
          "vi": "Địa chỉ là Sakura-machi 3-12 ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người gọi 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "あおいビルの入口には青い看板があります。",
          "vi": "Ở lối vào tòa Aoi có bảng hiệu màu xanh lam ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người gọi 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "煙は見えますが、炎は見えません。",
          "vi": "Tôi thấy khói, nhưng chưa thấy ngọn lửa ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người gọi 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "煙の原因はまだ分かりません。",
          "vi": "Tôi vẫn chưa biết vì sao lại có khói ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người báo quản lý tòa nhà"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "非常ベルが二回聞こえました。",
          "vi": "Tôi nghe chuông báo động reo hai lần ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người gọi 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "建物の中にまだ人がいるか分かりません。",
          "vi": "Tôi không biết còn ai ở trong tòa nhà không ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người báo quản lý tòa nhà"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "二階で煙を見たことは、もう百十九番に伝えました。",
          "vi": "Tôi đã báo 119 là tôi thấy khói ở tầng hai rồi ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người đang nghe hướng dẫn từ 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "どの出口を使うか、もう一度教えてください。",
          "vi": "Anh nhắc lại giúp tôi phải đi lối nào ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người gọi 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今、一階の階段の前にいます。",
          "vi": "Tôi đang ở trước cầu thang tầng một ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người gọi 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "東側の出口は煙で通れないそうです。",
          "vi": "Tôi nghe nói lối ra phía đông có khói, không đi qua được ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người nhờ người đứng gần"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "百十九番の案内を一緒に聞いてもらえますか。",
          "vi": "Anh nghe hướng dẫn của tổng đài 119 cùng tôi được không ạ?"
        }
      ]
    },
    {
      "id": "S-055-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người gọi 119 sau khi ra ngoài"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今はビルの外の広場にいます。",
          "vi": "Giờ tôi đang ở khoảng sân bên ngoài tòa nhà ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người gọi lại cho 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今は東側の通路にも煙が見えます。",
          "vi": "Giờ tôi thấy cả khói ở lối đi phía đông ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người cập nhật cho 119"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "外に出る前に、二階で煙を見ました。",
          "vi": "Tôi thấy khói ở tầng hai trước khi ra ngoài ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người vừa sơ tán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "北側の広場に避難したリンです。",
          "vi": "Tôi là Linh, tôi đã sơ tán ra sân phía bắc ạ."
        }
      ]
    },
    {
      "id": "S-055-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người phụ trách nơi tập trung"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "次の案内があるまで、広場で待ってください。",
          "vi": "Mọi người chờ ở sân đến khi có hướng dẫn tiếp nhé."
        }
      ]
    },
    {
      "id": "S-055-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người vừa sơ tán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "あおいビルには、もう戻ってもいいですか。",
          "vi": "Bây giờ đã được phép quay lại tòa Aoi chưa ạ?"
        }
      ]
    },
    {
      "id": "S-055-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Người báo cho chị gái"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お姉ちゃん、もう外に出たから無事だよ。",
          "vi": "Chị ơi, em ra ngoài an toàn rồi."
        }
      ]
    },
    {
      "id": "S-055-V13-021",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Người báo chỗ đang đợi với tổng đài"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "北側の広場で、係の人のそばにいます。",
          "vi": "Tôi đang ở cạnh người phụ trách tại sân phía bắc ạ."
        }
      ]
    }
  ]
}
