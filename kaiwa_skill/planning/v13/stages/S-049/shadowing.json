{
  "id": "ab1e1d2e-4c1e-5ca4-8ee3-8f570ee5549e-shadowing",
  "type": "shadowing",
  "items": [
    {
      "id": "S-049-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân gọi phòng khám"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "昨日から熱があるのですが、今日診てもらえますか。",
          "vi": "Tôi bị sốt từ hôm qua, hôm nay phòng khám có thể khám giúp tôi không ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân hỏi quầy tiếp nhận"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "診察の受付はどちらですか。",
          "vi": "Cho tôi hỏi quầy tiếp nhận khám bệnh ở đâu ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân gọi phòng khám"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今日予約できなければ、明日の午前は空いていますか。",
          "vi": "Nếu hôm nay không đặt được lịch, sáng mai còn giờ nào trống không ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân gọi phòng khám"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "予約した時間に間に合いそうにないので、もう少し遅い時間にできますか。",
          "vi": "Có lẽ tôi không đến kịp giờ đã hẹn, tôi đổi sang giờ muộn hơn một chút được không ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân nói với bác sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お腹の右側が昨日の夜から痛いです。",
          "vi": "Tôi đau bên phải bụng từ tối qua ạ."
        }
      ]
    },
    {
      "id": "S-049-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bác sĩ đang hỏi bệnh"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お腹のどこが痛いか、指で示してもらえますか。",
          "vi": "Chị chỉ giúp tôi bằng ngón tay xem đau chỗ nào ở bụng được không?"
        }
      ]
    },
    {
      "id": "S-049-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân nói với bác sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "歩くとお腹が強く痛みますが、座ると少し楽です。",
          "vi": "Đi lại thì bụng tôi đau nhiều, ngồi xuống thì đỡ một chút ạ."
        }
      ]
    },
    {
      "id": "S-049-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân nói với bác sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "お腹が痛くなったのは今日ではなく、昨日の夜です。",
          "vi": "Tôi bắt đầu đau bụng từ tối qua, không phải hôm nay ạ."
        }
      ]
    },
    {
      "id": "S-049-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân nói với bác sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "食べると吐き気がします。",
          "vi": "Cứ ăn vào là tôi thấy buồn nôn ạ."
        }
      ]
    },
    {
      "id": "S-049-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Bác sĩ đang hỏi bệnh"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "吐き気はいつから続いていますか。",
          "vi": "Chị thấy buồn nôn kéo dài từ khi nào?"
        }
      ]
    },
    {
      "id": "S-049-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân nói với bác sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "検査のことを、もう一度簡単な言葉で説明してもらえますか。",
          "vi": "Bác sĩ giải thích lại về việc kiểm tra bằng từ dễ hiểu giúp tôi được không ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân nói với bác sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "検査を受ける前に、何をするか聞いてもいいですか。",
          "vi": "Trước khi làm kiểm tra, tôi có thể hỏi bác sĩ sẽ làm những gì không ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân nói với bác sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "明日も同じように痛かったら、いつ電話すればいいですか。",
          "vi": "Nếu ngày mai tôi vẫn đau như vậy, tôi nên gọi khi nào ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân nói với bác sĩ"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "再診の日は、後で電話して予約してもいいですか。",
          "vi": "Tôi gọi điện đặt lịch tái khám sau được không ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân gọi phòng khám"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "診察のときにもらった紙に「再連絡」とありますが、いつ電話すればいいですか。",
          "vi": "Giấy tôi nhận khi đi khám có ghi “liên hệ lại”, vậy tôi nên gọi khi nào ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Nhân viên quầy phòng khám"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "医師に聞いてから、この番号に折り返します。",
          "vi": "Tôi sẽ hỏi bác sĩ rồi gọi lại vào số này ạ."
        }
      ]
    },
    {
      "id": "S-049-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân gọi phòng khám"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "診察後の指示について、何時ごろ折り返していただけますか。",
          "vi": "Về lời dặn sau buổi khám, khoảng mấy giờ phòng khám gọi lại cho tôi được ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân đến tái khám"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "歩くときのお腹の痛みが、前の診察のときより弱くなりました。",
          "vi": "Giờ đi lại tôi đỡ đau bụng hơn so với lần khám trước ạ."
        }
      ]
    },
    {
      "id": "S-049-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân đến tái khám"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "次の受診先の名前を、もう一度教えていただけますか。",
          "vi": "Anh nhắc lại giúp tôi tên nơi cần đến khám tiếp được không ạ?"
        }
      ]
    },
    {
      "id": "S-049-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Bệnh nhân đến tái khám"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "紹介された病院には、自分で電話して予約すればいいですか。",
          "vi": "Tôi tự gọi đến bệnh viện được giới thiệu để đặt lịch là được, đúng không ạ?"
        }
      ]
    }
  ]
}
