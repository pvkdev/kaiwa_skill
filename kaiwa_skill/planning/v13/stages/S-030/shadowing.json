{
  "id": "e9121b41-5da6-55e9-ba98-65343f646d27-shadowing",
  "type": "shadowing",
  "items": [
    {
      "id": "S-030-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mang đồ đi giặt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "コートの左の袖にコーヒーのしみがあります。",
          "vi": "Tay trái áo khoác có vết cà phê ạ."
        }
      ]
    },
    {
      "id": "S-030-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mang đồ đi giặt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このセーターはドライクリーニングできますか。",
          "vi": "Tiệm có giặt khô được chiếc áo len này không ạ?"
        }
      ]
    },
    {
      "id": "S-030-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên tiệm giặt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "セーターの内側にある洗濯表示を見せてください。",
          "vi": "Anh cho tôi xem nhãn hướng dẫn giặt bên trong áo len nhé."
        }
      ]
    },
    {
      "id": "S-030-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mang đồ đi giặt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "しみが少し残ってもいいので、このコートをお願いします。",
          "vi": "Vết ố còn lại một chút cũng được, nhờ tiệm giặt giúp chiếc áo khoác này ạ."
        }
      ]
    },
    {
      "id": "S-030-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mang đồ đi giặt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "金曜日の夕方までにコートを受け取れますか。",
          "vi": "Tôi nhận áo khoác chậm nhất vào chiều thứ Sáu được không ạ?"
        }
      ]
    },
    {
      "id": "S-030-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách mang đồ đi giặt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このセーターを預けられるか、何時ごろ電話で聞けばいいですか。",
          "vi": "Khoảng mấy giờ tôi nên gọi lại hỏi tiệm có nhận giặt chiếc áo len này không ạ?"
        }
      ]
    },
    {
      "id": "S-030-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách thử áo để sửa"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このシャツの右の袖を短くしてください。",
          "vi": "Nhờ tiệm rút ngắn tay phải của chiếc áo sơ mi này giúp tôi ạ."
        }
      ]
    },
    {
      "id": "S-030-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách nhờ sửa áo"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "袖を短くしても、この形を残せますか。",
          "vi": "Rút ngắn tay áo nhưng vẫn giữ được dáng này không ạ?"
        }
      ]
    },
    {
      "id": "S-030-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách nhờ sửa áo"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "金曜日までに間に合うように、袖だけ先に直してください。",
          "vi": "Nhờ tiệm sửa riêng tay áo trước cho kịp thứ Sáu ạ."
        }
      ]
    },
    {
      "id": "S-030-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách nhờ sửa áo"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "袖はそのままで、ウエストだけ詰めてください。",
          "vi": "Nhờ tiệm giữ nguyên tay áo và chỉ bóp phần eo giúp tôi ạ."
        }
      ]
    },
    {
      "id": "S-030-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đem giày đi sửa"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "右の靴の底が、かかとのところではがれました。",
          "vi": "Đế giày bên phải bị bong ở chỗ gót ạ."
        }
      ]
    },
    {
      "id": "S-030-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách đem giày đi sửa"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "はがれた靴底は、交換しないで直せますか。",
          "vi": "Phần đế bị bong có sửa được mà không cần thay không ạ?"
        }
      ]
    },
    {
      "id": "S-030-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách hỏi chi phí sửa giày"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "靴底を直す前に、修理の費用を教えてください。",
          "vi": "Trước khi sửa đế, tiệm báo chi phí sửa giúp tôi ạ."
        }
      ]
    },
    {
      "id": "S-030-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách hỏi khi nào lấy giày"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "明日の朝までに修理した靴を受け取れますか。",
          "vi": "Tôi lấy giày đã sửa chậm nhất vào sáng mai được không ạ?"
        }
      ]
    },
    {
      "id": "S-030-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách quyết định hoãn sửa giày"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "修理の費用が高いので、今日は靴を持ち帰ります。",
          "vi": "Chi phí sửa cao nên hôm nay tôi xin mang giày về ạ."
        }
      ]
    },
    {
      "id": "S-030-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách xác nhận phần giày sẽ sửa"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "靴のかかとは右だけ交換するんですね。",
          "vi": "Tiệm chỉ thay gót giày bên phải thôi, đúng không ạ?"
        }
      ]
    },
    {
      "id": "S-030-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách nhận đồ giặt"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "コートの袖にしみが残っているので、もう一度見てもらえますか。",
          "vi": "Tay áo khoác vẫn còn vết ố, nhờ tiệm xem lại giúp tôi được không ạ?"
        }
      ]
    },
    {
      "id": "S-030-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách nhận áo đã sửa"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "右の袖がまだ左より長いので、もう一度直してもらえますか。",
          "vi": "Tay phải vẫn dài hơn tay trái, nhờ tiệm sửa lại giúp tôi được không ạ?"
        }
      ]
    },
    {
      "id": "S-030-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách để lại áo sửa lần nữa"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "左の袖はそのままで、右の袖だけ短くしてください。",
          "vi": "Nhờ tiệm giữ nguyên tay trái và chỉ rút ngắn tay phải giúp tôi ạ."
        }
      ]
    },
    {
      "id": "S-030-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi hỏi đồ đã xong chưa"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "右の袖を直してもらったシャツは、もう仕上がっていますか。",
          "vi": "Áo sơ mi tôi gửi sửa lại tay phải đã xong chưa ạ?"
        }
      ]
    },
    {
      "id": "S-030-V13-021",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách thử áo ở quầy nhận"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "左右の袖が同じ長さになったので、このシャツを受け取ります。",
          "vi": "Hai tay áo giờ dài bằng nhau rồi, tôi nhận áo sơ mi này nhé."
        }
      ]
    }
  ]
}
