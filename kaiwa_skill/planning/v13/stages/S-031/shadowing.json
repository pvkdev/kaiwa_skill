  "items": [
    {
      "id": "S-031-V13-001",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách vào nhà hàng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "二人ですが、席は空いていますか。",
          "vi": "Bây giờ còn chỗ cho hai người không ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-002",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách chọn bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "奥の静かな席に座ってもいいですか。",
          "vi": "Chúng tôi ngồi bàn yên tĩnh phía trong được không ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-003",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "female",
          "role_vi": "Nhân viên đón khách"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "こちらの席は七時までお使いいただけます。",
          "vi": "Anh có thể dùng bàn này đến 7 giờ ạ."
        }
      ]
    },
    {
      "id": "S-031-V13-004",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách hỏi sau khi nghe hết bàn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "満席なら、何時ごろ来れば席が空きそうですか。",
          "vi": "Nếu quán đang hết bàn, khoảng mấy giờ tôi quay lại thì có thể có chỗ ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-005",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách xem thực đơn"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "メニューのこの写真は何の料理ですか。",
          "vi": "Món trong ảnh này trên thực đơn là món gì ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-006",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách hỏi thành phần món"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "この丼には卵が入っていますか。",
          "vi": "Món cơm tô này có trứng không ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-007",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách chọn món chia chung"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "このサラダ一人前を二人で分けても大丈夫ですか。",
          "vi": "Hai người chúng tôi chia nhau một phần salad này được không ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-008",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi món"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "うどんを一つと、冷たいお茶を二杯ください。",
          "vi": "Cho tôi một tô mì udon và hai ly trà lạnh ạ."
        }
      ]
    },
    {
      "id": "S-031-V13-009",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách sửa số phần đã gọi"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "すみません、ラーメンは三つではなく二つです。",
          "vi": "Xin lỗi, tôi gọi hai tô ramen, không phải ba ạ."
        }
      ]
    },
    {
      "id": "S-031-V13-010",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách xin thêm nước"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "すみません、お水をもう二杯いただけますか。",
          "vi": "Cho chúng tôi thêm hai ly nước được không ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-011",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách hỏi món ra chậm"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "注文したうどんは、あとどのくらいかかりますか。",
          "vi": "Món udon tôi gọi còn khoảng bao lâu nữa mới ra ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-012",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách báo món mang nhầm"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "私が注文したのは、クリームソースではなくトマトソースのパスタです。",
          "vi": "Tôi gọi mì Ý xốt cà chua, không phải xốt kem ạ."
        }
      ]
    },
    {
      "id": "S-031-V13-013",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách xin đĩa để chia món"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "サラダを分けたいので、取り皿を二枚いただけますか。",
          "vi": "Chúng tôi muốn chia salad, cho xin hai đĩa nhỏ được không ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-014",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi món thay thế"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "カレーが売り切れなら、親子丼に変えてもらえますか。",
          "vi": "Nếu hết cà ri thì đổi giúp tôi sang cơm gà trứng được không ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-015",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách nhận đúng món sau khi đổi"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "パスタを取り替えてくださって、ありがとうございます。",
          "vi": "Cảm ơn anh đã đổi giúp tôi món mì Ý ạ."
        }
      ]
    },
    {
      "id": "S-031-V13-016",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách thanh toán"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "会計は二人で別々にできますか。",
          "vi": "Hai người chúng tôi thanh toán riêng được không ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-017",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách kiểm phiếu tính tiền"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "伝票にあるサラダは注文していません。",
          "vi": "Món salad ghi trên phiếu tính tiền là món chúng tôi không gọi ạ."
        }
      ]
    },
    {
      "id": "S-031-V13-018",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách kiểm lại số tiền"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "サラダを外すと、合計はいくらになりますか。",
          "vi": "Bỏ món salad ra thì tổng cộng còn bao nhiêu ạ?"
        }
      ]
    },
    {
      "id": "S-031-V13-019",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách rời nhà hàng"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "ごちそうさまでした。",
          "vi": "Cảm ơn quán vì bữa ăn ạ."
        }
      ]
    },
    {
      "id": "S-031-V13-020",
      "type": "single_sentence",
      "speakers": [
        {
          "id": "a",
          "gender": "male",
          "role_vi": "Khách gọi tìm ô để quên"
        }
      ],
      "turns": [
        {
          "speaker_id": "a",
          "ja": "今日そちらの入口近くの席に青い傘を忘れたかもしれません。",
          "vi": "Hôm nay có thể tôi để quên chiếc ô màu xanh ở bàn gần cửa vào của quán ạ."
        }
      ]
