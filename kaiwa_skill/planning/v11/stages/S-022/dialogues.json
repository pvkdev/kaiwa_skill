          }
        }
      }
    },
    {
      "situation_uid": "8929d022-135d-581f-9beb-18751e50acdc",
      "event_id": "E01",
      "context_vi": "Mori giao bạn ở bàn A kiểm 20 chi tiết loại P trong lô hư cấu hôm nay. Bạn nhắc lại công đoạn và số lượng trước khi làm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "giám sát Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8929d022-135d-581f-9beb-18751e50acdc-u01",
          "speaker_id": "b",
          "ja": "今日はPの部品を二十個、見てください。",
          "vi": "Hôm nay chị kiểm 20 chi tiết loại P."
        },
        {
          "id": "8929d022-135d-581f-9beb-18751e50acdc-u02",
          "speaker_id": "a",
          "ja": "Pの部品を二十個、確認するんですね。",
          "vi": "Tôi kiểm 20 chi tiết loại P nhỉ."
        },
        {
          "id": "8929d022-135d-581f-9beb-18751e50acdc-u03",
          "speaker_id": "b",
          "ja": "はい。まず見本を見ましょう。",
          "vi": "Đúng. Trước tiên xem mẫu nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8929d022-135d-581f-9beb-18751e50acdc-u01": {
