    {
      "situation_uid": "b8ef55c7-23c9-5f19-8afb-6c2f35e5baa0",
      "event_id": "E02",
      "context_vi": "Ở xưởng Aoba hư cấu, bạn đã kiểm một lô đầu nhưng chưa biết ai duyệt trước khi tiếp tục. Bạn hỏi Mori người xác nhận lô đó.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "giám sát Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b8ef55c7-23c9-5f19-8afb-6c2f35e5baa0-u01",
          "speaker_id": "a",
          "ja": "最初の分は終わりました。次を始める前に、誰が確認しますか。",
          "vi": "Tôi đã xong lô đầu. Trước khi làm tiếp, ai kiểm lô này ạ?"
        },
        {
          "id": "b8ef55c7-23c9-5f19-8afb-6c2f35e5baa0-u02",
          "speaker_id": "b",
          "ja": "私が確認します。ここに置いてください。",
          "vi": "Tôi sẽ kiểm. Chị để ở đây nhé."
        },
        {
          "id": "b8ef55c7-23c9-5f19-8afb-6c2f35e5baa0-u03",
          "speaker_id": "a",
          "ja": "はい。確認を待ちます。",
          "vi": "Vâng. Tôi chờ anh kiểm."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions",
          "report"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b8ef55c7-23c9-5f19-8afb-6c2f35e5baa0-u01": {
            "kind": "original_extension"
          },
          "b8ef55c7-23c9-5f19-8afb-6c2f35e5baa0-u02": {
