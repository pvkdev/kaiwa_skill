            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3569ada8-bfc7-59e9-8497-7142a23db772",
      "event_id": "E02",
      "context_vi": "Tiếp khi Mori chưa cho câu trả lời về khu B: anh cần kiểm lịch máy ở khu đó và sẽ quay lại nói. Bạn không vào trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "giám sát Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3569ada8-bfc7-59e9-8497-7142a23db772-u01",
          "speaker_id": "b",
          "ja": "Bの機械の予定を見てから伝えます。",
          "vi": "Tôi sẽ xem lịch máy ở khu B rồi báo chị."
        },
        {
          "id": "3569ada8-bfc7-59e9-8497-7142a23db772-u02",
          "speaker_id": "a",
          "ja": "はい。確認が終わるまで、Aにいます。",
          "vi": "Vâng. Tôi ở khu A tới khi anh kiểm xong."
        },
        {
          "id": "3569ada8-bfc7-59e9-8497-7142a23db772-u03",
          "speaker_id": "b",
          "ja": "お願いします。",
          "vi": "Nhờ chị nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions"
        ],
        "specialty_item_ids": [],
