            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "419d9f66-df62-5662-9d60-8f1c7e831b93",
      "event_id": "E02",
      "context_vi": "Trong xưởng Aoba hư cấu, bạn thấy biển khu B nhưng chưa được nói có thể vào không. Bạn hỏi Mori phạm vi mình được vào hôm nay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "giám sát Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "419d9f66-df62-5662-9d60-8f1c7e831b93-u01",
          "speaker_id": "a",
          "ja": "今日はBの場所に入ってもいいですか。",
          "vi": "Hôm nay tôi vào khu B được không ạ?"
        },
        {
          "id": "419d9f66-df62-5662-9d60-8f1c7e831b93-u02",
          "speaker_id": "b",
          "ja": "まだ確認中です。今はAの場所で待ってください。",
          "vi": "Tôi còn đang kiểm tra. Giờ chị đợi ở khu A nhé."
        },
        {
          "id": "419d9f66-df62-5662-9d60-8f1c7e831b93-u03",
          "speaker_id": "a",
          "ja": "わかりました。Aで待ちます。",
          "vi": "Tôi hiểu. Tôi đợi ở khu A."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions",
          "mhlw_train"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "419d9f66-df62-5662-9d60-8f1c7e831b93-u01": {
