    },
    {
      "situation_uid": "2d9c0d68-f660-5758-bae3-34c8dd7b99c1",
      "event_id": "E02",
      "context_vi": "Ở Aoba, bạn được chỉ tới một máy nhưng chưa từng được Mori hướng dẫn cách dùng. Bạn nói rõ điều này và xin người chỉ, không thao tác thử.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "giám sát Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2d9c0d68-f660-5758-bae3-34c8dd7b99c1-u01",
          "speaker_id": "a",
          "ja": "この機械の使い方は、まだ聞いていません。教えてください。",
          "vi": "Tôi chưa được hướng dẫn dùng máy này. Anh chỉ giúp tôi."
        },
        {
          "id": "2d9c0d68-f660-5758-bae3-34c8dd7b99c1-u02",
          "speaker_id": "b",
          "ja": "わかりました。先に説明します。今は触らないでください。",
          "vi": "Tôi hiểu. Tôi sẽ hướng dẫn trước. Giờ chị chưa chạm vào máy nhé."
        },
        {
          "id": "2d9c0d68-f660-5758-bae3-34c8dd7b99c1-u03",
          "speaker_id": "a",
          "ja": "はい、待ちます。",
          "vi": "Vâng, tôi chờ."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions",
          "mhlw_train"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "2d9c0d68-f660-5758-bae3-34c8dd7b99c1-u01": {
            "kind": "original_extension"
          },
