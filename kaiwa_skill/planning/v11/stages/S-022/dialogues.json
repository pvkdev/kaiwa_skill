  "dialogues": [
    {
      "situation_uid": "3d91a408-4c4a-5c6d-94db-dfd88768d524",
      "event_id": "E01",
      "context_vi": "Ngày đầu tại xưởng Aoba hư cấu, bạn là công nhân nữ Linh. Bạn hỏi giám sát nam Mori khu làm việc hôm nay và ai trực tiếp chỉ mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "giám sát Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3d91a408-4c4a-5c6d-94db-dfd88768d524-u01",
          "speaker_id": "a",
          "ja": "今日はどこで働きますか。誰に聞けばいいですか。",
          "vi": "Hôm nay tôi làm ở đâu? Tôi hỏi ai ạ?"
        },
        {
          "id": "3d91a408-4c4a-5c6d-94db-dfd88768d524-u02",
          "speaker_id": "b",
          "ja": "Aの作業台です。今日は私が説明します。",
          "vi": "Ở bàn làm việc A. Hôm nay tôi sẽ hướng dẫn chị."
        },
        {
          "id": "3d91a408-4c4a-5c6d-94db-dfd88768d524-u03",
          "speaker_id": "a",
          "ja": "Aの台で、森さんに聞きます。",
          "vi": "Bàn A, tôi hỏi anh Mori nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions",
          "mhlw_train"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3d91a408-4c4a-5c6d-94db-dfd88768d524-u01": {
            "kind": "original_extension"
