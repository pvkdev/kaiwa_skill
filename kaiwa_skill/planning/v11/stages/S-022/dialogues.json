          "90704231-e874-5a56-b657-12825e2f2c75-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "b4a74c62-aafd-595a-af71-61b265dd05a1",
      "event_id": "E01",
      "context_vi": "Ở bàn A của xưởng Aoba hư cấu, có hai khay vật liệu xanh và trắng. Bạn hỏi Mori khay nào dành cho lô hôm nay trước khi lấy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "giám sát Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b4a74c62-aafd-595a-af71-61b265dd05a1-u01",
          "speaker_id": "a",
          "ja": "今日の材料は、青い箱ですか、白い箱ですか。",
          "vi": "Vật liệu hôm nay ở khay xanh hay khay trắng ạ?"
        },
        {
          "id": "b4a74c62-aafd-595a-af71-61b265dd05a1-u02",
          "speaker_id": "b",
          "ja": "青い箱です。白い箱は別の仕事です。",
          "vi": "Khay xanh. Khay trắng cho việc khác."
        },
        {
          "id": "b4a74c62-aafd-595a-af71-61b265dd05a1-u03",
          "speaker_id": "a",
          "ja": "青い箱ですね。",
          "vi": "Khay xanh nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b4a74c62-aafd-595a-af71-61b265dd05a1-u01": {
