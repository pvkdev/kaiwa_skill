            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "90704231-e874-5a56-b657-12825e2f2c75",
      "event_id": "E01",
      "context_vi": "Tiếp việc kiểm 20 chi tiết P: khay có nhãn P và B nhìn gần giống. Mori đưa mẫu P cho bạn so, bạn hỏi lại trước khi chạm lô.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "giám sát Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "90704231-e874-5a56-b657-12825e2f2c75-u01",
          "speaker_id": "a",
          "ja": "PとBの箱があります。今日の部品は、この見本と同じPですか。",
          "vi": "Có hộp P và B. Chi tiết hôm nay là loại P giống mẫu này ạ?"
        },
        {
          "id": "90704231-e874-5a56-b657-12825e2f2c75-u02",
          "speaker_id": "b",
          "ja": "はい、Pです。Bは今日は使いません。",
          "vi": "Đúng, P. Hôm nay không dùng B."
        },
        {
          "id": "90704231-e874-5a56-b657-12825e2f2c75-u03",
          "speaker_id": "a",
          "ja": "Pだけ二十個ですね。",
          "vi": "Chỉ 20 chi tiết P nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
