            "kind": "original_extension"
          },
          "2d9c0d68-f660-5758-bae3-34c8dd7b99c1-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "e9eefe6d-a644-5b1b-8495-22ec93c2fcf3",
      "event_id": "E02",
      "context_vi": "Tiếp khi Mori bảo chưa chạm vào máy trước buổi hướng dẫn. Bạn hỏi có thể nhận việc khác trong lúc chờ; anh giao kiểm nhãn trên bàn A.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "giám sát Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e9eefe6d-a644-5b1b-8495-22ec93c2fcf3-u01",
          "speaker_id": "a",
          "ja": "機械はまだ使いません。待つ間、ほかの仕事はありますか。",
          "vi": "Tôi chưa dùng máy. Trong lúc chờ có việc khác không ạ?"
        },
        {
          "id": "e9eefe6d-a644-5b1b-8495-22ec93c2fcf3-u02",
          "speaker_id": "b",
          "ja": "Aの台で、ラベルを十枚数えてください。",
          "vi": "Ở bàn A, chị đếm 10 nhãn nhé."
        },
        {
          "id": "e9eefe6d-a644-5b1b-8495-22ec93c2fcf3-u03",
          "speaker_id": "a",
          "ja": "Aの台で十枚ですね。",
          "vi": "10 nhãn ở bàn A nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions",
          "mhlw_train"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e9eefe6d-a644-5b1b-8495-22ec93c2fcf3-u01": {
