            "kind": "original_extension"
          },
          "c4ffdfed-9f26-568d-8533-234165583d6d-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "f52e705b-f7db-5b47-94c4-b0511748edb7",
      "event_id": "E01",
      "context_vi": "Ngay sau khi nhân viên đưa một đôi găng tay cùng màu thay cho hai chiếc mẫu khác màu, bạn xác nhận đơn vị trước khi mua.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f52e705b-f7db-5b47-94c4-b0511748edb7-u01",
          "speaker_id": "a",
          "ja": "この一組をください。右と左、一つずつですね。",
          "vi": "Cho tôi đôi này ạ. Một chiếc tay phải, một chiếc tay trái nhỉ?"
        },
        {
          "id": "f52e705b-f7db-5b47-94c4-b0511748edb7-u02",
          "speaker_id": "b",
          "ja": "はい、一組です。",
          "vi": "Vâng, một đôi ạ."
        },
        {
          "id": "f52e705b-f7db-5b47-94c4-b0511748edb7-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。これにします。",
          "vi": "Cảm ơn anh. Tôi lấy đôi này."
        }
      ],
      "admin": {
        "source_refs": [
          "shop"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f52e705b-f7db-5b47-94c4-b0511748edb7-u01": {
