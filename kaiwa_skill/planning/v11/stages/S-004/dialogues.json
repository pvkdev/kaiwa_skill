          "685ec829-4668-578b-b39b-358618aba528-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "f745e4f5-05f2-579c-a4f7-ba7b987ee12f",
      "event_id": "E01",
      "context_vi": "Trên kệ có hai chiếc cốc gần giống nhau: một chiếc xanh, một chiếc trắng. Bạn cần chiếc xanh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f745e4f5-05f2-579c-a4f7-ba7b987ee12f-u01",
          "speaker_id": "b",
          "ja": "こちらのコップですか。",
          "vi": "Chị lấy chiếc cốc này ạ?"
        },
        {
          "id": "f745e4f5-05f2-579c-a4f7-ba7b987ee12f-u02",
          "speaker_id": "a",
          "ja": "いいえ、隣の青いコップです。",
          "vi": "Không, chiếc cốc xanh bên cạnh ạ."
        },
        {
          "id": "f745e4f5-05f2-579c-a4f7-ba7b987ee12f-u03",
          "speaker_id": "b",
          "ja": "こちらですね。",
          "vi": "Chiếc này nhỉ."
        },
        {
          "id": "f745e4f5-05f2-579c-a4f7-ba7b987ee12f-u04",
          "speaker_id": "a",
          "ja": "はい、それです。",
          "vi": "Vâng, đúng chiếc đó."
        }
      ],
      "admin": {
        "source_refs": [
          "shop"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f745e4f5-05f2-579c-a4f7-ba7b987ee12f-u01": {
            "kind": "original_extension"
          },
          "f745e4f5-05f2-579c-a4f7-ba7b987ee12f-u02": {
            "kind": "original_extension"
          },
