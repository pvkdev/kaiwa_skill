          "e5a89b6d-dade-5d3e-a150-0edaa07e4a69-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "c4ffdfed-9f26-568d-8533-234165583d6d",
      "event_id": "E01",
      "context_vi": "Bạn cần một đôi găng tay cùng kiểu. Nhân viên vừa đặt lên quầy hai chiếc găng tay mẫu khác màu, tưởng bạn muốn hai chiếc lẻ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c4ffdfed-9f26-568d-8533-234165583d6d-u01",
          "speaker_id": "a",
          "ja": "すみません、二つではなく、一組ほしいです。",
          "vi": "Xin lỗi, tôi không cần hai chiếc lẻ; tôi muốn một đôi ạ."
        },
        {
          "id": "c4ffdfed-9f26-568d-8533-234165583d6d-u02",
          "speaker_id": "b",
          "ja": "あ、一組ですね。同じ色がいいですか。",
          "vi": "À, một đôi nhỉ. Chị muốn cùng màu ạ?"
        },
        {
          "id": "c4ffdfed-9f26-568d-8533-234165583d6d-u03",
          "speaker_id": "a",
          "ja": "はい、同じ色でお願いします。",
          "vi": "Vâng, cho tôi cùng màu ạ."
        },
        {
          "id": "c4ffdfed-9f26-568d-8533-234165583d6d-u04",
          "speaker_id": "b",
          "ja": "わかりました。こちらの一組です。",
          "vi": "Tôi hiểu rồi. Đây là một đôi cùng màu."
        }
      ],
      "admin": {
        "source_refs": [
          "shop"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c4ffdfed-9f26-568d-8533-234165583d6d-u01": {
            "kind": "original_extension"
          },
