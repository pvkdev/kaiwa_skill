          }
        }
      }
    },
    {
      "situation_uid": "9632e99d-4f10-5746-b446-906f8caa0007",
      "event_id": "E02",
      "context_vi": "Bạn hỏi lịch hẹn thứ Năm tuần này nhưng ngày đó đã kín. Người hẹn đề nghị thứ Sáu, và bạn kiểm lại trước khi chọn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hẹn gặp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9632e99d-4f10-5746-b446-906f8caa0007-u01",
          "speaker_id": "a",
          "ja": "木曜日は空いていますか。",
          "vi": "Thứ Năm còn chỗ hẹn không ạ?"
        },
        {
          "id": "9632e99d-4f10-5746-b446-906f8caa0007-u02",
          "speaker_id": "b",
          "ja": "木曜日はいっぱいです。金曜日はどうですか。",
          "vi": "Thứ Năm kín rồi. Thứ Sáu được không?"
        },
        {
          "id": "9632e99d-4f10-5746-b446-906f8caa0007-u03",
          "speaker_id": "a",
          "ja": "金曜日の午後は空いていますか。",
          "vi": "Chiều thứ Sáu còn chỗ không ạ?"
        },
        {
          "id": "9632e99d-4f10-5746-b446-906f8caa0007-u04",
          "speaker_id": "b",
          "ja": "はい、空いています。",
          "vi": "Vâng, còn ạ."
        },
        {
          "id": "9632e99d-4f10-5746-b446-906f8caa0007-u05",
          "speaker_id": "a",
          "ja": "では、金曜日の午後にお願いします。",
          "vi": "Vậy cho tôi hẹn chiều thứ Sáu ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
