  "dialogues": [
    {
      "situation_uid": "685ec829-4668-578b-b39b-358618aba528",
      "event_id": "E01",
      "context_vi": "Ở cửa hàng đồ gia dụng, bạn không biết tên một món tròn màu đỏ dùng để pha trà. Bạn mô tả để nhân viên chỉ đúng món.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "685ec829-4668-578b-b39b-358618aba528-u01",
          "speaker_id": "a",
          "ja": "すみません、赤くて丸い、お茶を入れるものはありますか。",
          "vi": "Xin lỗi, ở đây có món màu đỏ, tròn, dùng pha trà không ạ?"
        },
        {
          "id": "685ec829-4668-578b-b39b-358618aba528-u02",
          "speaker_id": "b",
          "ja": "急須ですか。こちらにあります。",
          "vi": "Có phải ấm trà không ạ? Ở đây có."
        },
        {
          "id": "685ec829-4668-578b-b39b-358618aba528-u03",
          "speaker_id": "a",
          "ja": "はい、これです。ありがとうございます。",
          "vi": "Đúng rồi, món này. Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "shop"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "685ec829-4668-578b-b39b-358618aba528-u01": {
