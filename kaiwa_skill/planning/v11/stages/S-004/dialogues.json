    {
      "situation_uid": "bed297ea-b918-5f5e-81cc-ddf84170da7e",
      "event_id": "E02",
      "context_vi": "Người hẹn nói giờ gặp là 13 giờ thứ Sáu. Bạn nghe thành 3 giờ chiều và hỏi lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hẹn gặp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bed297ea-b918-5f5e-81cc-ddf84170da7e-u01",
          "speaker_id": "b",
          "ja": "金曜日の十三時です。",
          "vi": "Thứ Sáu lúc 13 giờ ạ."
        },
        {
          "id": "bed297ea-b918-5f5e-81cc-ddf84170da7e-u02",
          "speaker_id": "a",
          "ja": "三時ですか。",
          "vi": "Ba giờ chiều ạ?"
        },
        {
          "id": "bed297ea-b918-5f5e-81cc-ddf84170da7e-u03",
          "speaker_id": "b",
          "ja": "いいえ、十三時です。午後一時です。",
          "vi": "Không, 13 giờ, tức một giờ chiều."
        },
        {
          "id": "bed297ea-b918-5f5e-81cc-ddf84170da7e-u04",
          "speaker_id": "a",
          "ja": "あ、午後一時ですね。",
          "vi": "À, một giờ chiều nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
        "specialty_item_ids": [
          "sj-so-01-b07-146"
