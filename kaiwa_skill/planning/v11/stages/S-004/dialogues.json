          }
        }
      }
    },
    {
      "situation_uid": "710cb3ce-7d0e-5b70-8eb3-40b37ef2f721",
      "event_id": "E02",
      "context_vi": "Bạn gọi điện đặt một buổi gặp riêng. Bạn muốn biết cả giờ bắt đầu và kết thúc trước khi nhận lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hẹn gặp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "710cb3ce-7d0e-5b70-8eb3-40b37ef2f721-u01",
          "speaker_id": "a",
          "ja": "何時から何時までですか。",
          "vi": "Buổi gặp từ mấy giờ đến mấy giờ ạ?"
        },
        {
          "id": "710cb3ce-7d0e-5b70-8eb3-40b37ef2f721-u02",
          "speaker_id": "b",
          "ja": "二時から三時までです。",
          "vi": "Từ hai giờ đến ba giờ."
        },
        {
          "id": "710cb3ce-7d0e-5b70-8eb3-40b37ef2f721-u03",
          "speaker_id": "a",
          "ja": "二時から三時ですね。大丈夫です。",
          "vi": "Từ hai đến ba giờ nhỉ. Tôi đến được."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
        "specialty_item_ids": [],
