            "kind": "original_extension"
          },
          "f745e4f5-05f2-579c-a4f7-ba7b987ee12f-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "e5a89b6d-dade-5d3e-a150-0edaa07e4a69",
      "event_id": "E01",
      "context_vi": "Ở quầy, bạn muốn mua ba chiếc cốc giống chiếc đang chỉ. Nhân viên cần biết số lượng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e5a89b6d-dade-5d3e-a150-0edaa07e4a69-u01",
          "speaker_id": "a",
          "ja": "このコップを三つください。",
          "vi": "Cho tôi ba chiếc cốc này ạ."
        },
        {
          "id": "e5a89b6d-dade-5d3e-a150-0edaa07e4a69-u02",
          "speaker_id": "b",
          "ja": "三つですね。",
          "vi": "Ba chiếc nhỉ."
        },
        {
          "id": "e5a89b6d-dade-5d3e-a150-0edaa07e4a69-u03",
          "speaker_id": "a",
          "ja": "はい、同じものを三つです。",
          "vi": "Vâng, ba chiếc giống nhau ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "shop"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e5a89b6d-dade-5d3e-a150-0edaa07e4a69-u01": {
            "kind": "original_extension"
