    {
      "situation_uid": "1de770dc-2c60-5dfa-aa74-07027d1453ea",
      "event_id": "E02",
      "context_vi": "Hôm nay là thứ Hai. Người hẹn hỏi trong tuần này bạn rảnh ngày nào. Bạn rảnh thứ Năm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hẹn gặp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1de770dc-2c60-5dfa-aa74-07027d1453ea-u01",
          "speaker_id": "b",
          "ja": "今週、いつがいいですか。",
          "vi": "Tuần này ngày nào tiện cho chị?"
        },
        {
          "id": "1de770dc-2c60-5dfa-aa74-07027d1453ea-u02",
          "speaker_id": "a",
          "ja": "木曜日がいいです。",
          "vi": "Thứ Năm thì tiện cho tôi."
        },
        {
          "id": "1de770dc-2c60-5dfa-aa74-07027d1453ea-u03",
          "speaker_id": "b",
          "ja": "木曜日ですね。午後はどうですか。",
          "vi": "Thứ Năm nhỉ. Buổi chiều được không?"
        },
        {
          "id": "1de770dc-2c60-5dfa-aa74-07027d1453ea-u04",
          "speaker_id": "a",
          "ja": "はい、午後なら大丈夫です。",
          "vi": "Vâng, buổi chiều được ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1de770dc-2c60-5dfa-aa74-07027d1453ea-u01": {
            "kind": "original_extension"
          },
