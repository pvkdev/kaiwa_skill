          }
        }
      }
    },
    {
      "situation_uid": "14a42ba7-d32f-52fe-ad6e-f9d65be51375",
      "event_id": "E01",
      "context_vi": "Bạn đã biết buổi chào mừng thứ Sáu tổ chức ở quán Sakura cạnh công ty. Bạn báo mình sẽ dự và hỏi giờ bắt đầu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp phụ trách Tanaka",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "14a42ba7-d32f-52fe-ad6e-f9d65be51375-u01",
          "speaker_id": "A",
          "ja": "金曜の歓迎会、私も行きます。何時からですか。",
          "vi": "Tôi cũng sẽ dự buổi chào mừng thứ Sáu. Mấy giờ bắt đầu ạ?"
        },
        {
          "id": "14a42ba7-d32f-52fe-ad6e-f9d65be51375-u02",
          "speaker_id": "B",
          "ja": "夕方六時からです。",
          "vi": "Bắt đầu lúc sáu giờ tối."
        },
        {
          "id": "14a42ba7-d32f-52fe-ad6e-f9d65be51375-u03",
          "speaker_id": "A",
          "ja": "六時に「さくら」ですね。",
          "vi": "Sáu giờ ở quán Sakura ạ."
        },
        {
          "id": "14a42ba7-d32f-52fe-ad6e-f9d65be51375-u04",
          "speaker_id": "B",
          "ja": "はい、お店で会いましょう。",
          "vi": "Đúng rồi. Mình gặp nhau ở quán nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "attend"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "14a42ba7-d32f-52fe-ad6e-f9d65be51375-u01": {
