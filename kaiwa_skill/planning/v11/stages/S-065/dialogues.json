      }
    },
    {
      "situation_uid": "7c142476-a649-5a57-9100-370a42987e59",
      "event_id": "E02",
      "context_vi": "Trong buổi gặp mặt của nhóm, bạn nghe một đồng nghiệp đã được thăng lên trưởng nhóm. Bạn đến chúc mừng anh ấy.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp được thăng chức",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7c142476-a649-5a57-9100-370a42987e59-u01",
          "speaker_id": "A",
          "ja": "チームリーダーになったんですね。おめでとうございます。",
          "vi": "Anh lên trưởng nhóm rồi ạ. Chúc mừng anh!"
        },
        {
          "id": "7c142476-a649-5a57-9100-370a42987e59-u02",
          "speaker_id": "B",
          "ja": "ありがとうございます。初めてなので少し心配です。",
          "vi": "Cảm ơn chị. Lần đầu làm nên tôi cũng hơi lo."
        },
        {
          "id": "7c142476-a649-5a57-9100-370a42987e59-u03",
          "speaker_id": "A",
          "ja": "何かあったら、私にも声をかけてくださいね。",
          "vi": "Có việc gì anh cứ gọi tôi nhé."
        },
        {
          "id": "7c142476-a649-5a57-9100-370a42987e59-u04",
          "speaker_id": "B",
          "ja": "そう言ってもらえると心強いです。",
          "vi": "Chị nói vậy tôi thấy yên tâm hơn."
        }
      ],
      "admin": {
        "source_refs": [
