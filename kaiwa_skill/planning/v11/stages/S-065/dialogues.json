    {
      "situation_uid": "b716c9eb-cb6f-5091-9791-016e06db7450",
      "event_id": "E03",
      "context_vi": "Bạn ngồi cạnh một đồng nghiệp tại tiệc tất niên. Hồi mới vào, anh ấy đã chỉ bạn cách làm báo cáo hằng ngày. Bạn muốn cảm ơn anh ấy về việc đó.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b716c9eb-cb6f-5091-9791-016e06db7450-u01",
          "speaker_id": "A",
          "ja": "今年はたくさん助けていただいて、ありがとうございました。",
          "vi": "Cảm ơn anh năm nay đã giúp đỡ tôi nhiều."
        },
        {
          "id": "b716c9eb-cb6f-5091-9791-016e06db7450-u02",
          "speaker_id": "B",
          "ja": "いえいえ。慣れるまで大変でしたね。",
          "vi": "Có gì đâu. Thời gian đầu làm quen cũng vất vả nhỉ."
        },
        {
          "id": "b716c9eb-cb6f-5091-9791-016e06db7450-u03",
          "speaker_id": "A",
          "ja": "毎日の報告の書き方を教えてもらって、助かりました。",
          "vi": "May mà anh chỉ tôi cách viết báo cáo hằng ngày."
        },
        {
          "id": "b716c9eb-cb6f-5091-9791-016e06db7450-u04",
          "speaker_id": "B",
          "ja": "今はもう一人でできていますね。来年もよろしくお願いします。",
          "vi": "Giờ chị tự làm được rồi nhỉ. Sang năm mình tiếp tục giúp đỡ nhau nhé."
        }
      ],
      "admin": {
