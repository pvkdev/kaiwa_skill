    {
      "situation_uid": "e392f4e5-7e3b-5913-9caa-bd3c1aa54edf",
      "event_id": "E04",
      "context_vi": "Bạn phải về sớm khỏi buổi tiệc chia tay đồng nghiệp chuyển nhóm hôm qua. Hôm sau, bạn gặp chính người chuyển nhóm và muốn nói lời xin lỗi cùng lời chúc.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp chuyển nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e392f4e5-7e3b-5913-9caa-bd3c1aa54edf-u01",
          "speaker_id": "A",
          "ja": "昨日は先に帰ってすみませんでした。",
          "vi": "Hôm qua tôi về trước, anh thông cảm nhé."
        },
        {
          "id": "e392f4e5-7e3b-5913-9caa-bd3c1aa54edf-u02",
          "speaker_id": "B",
          "ja": "大丈夫ですよ。最初に話せてよかったです。",
          "vi": "Không sao đâu. Tôi rất vui vì mình đã nói chuyện được lúc đầu."
        },
        {
          "id": "e392f4e5-7e3b-5913-9caa-bd3c1aa54edf-u03",
          "speaker_id": "A",
          "ja": "新しいチームでも頑張ってください。",
          "vi": "Chúc anh làm tốt ở nhóm mới nhé."
        },
        {
          "id": "e392f4e5-7e3b-5913-9caa-bd3c1aa54edf-u04",
          "speaker_id": "B",
          "ja": "ありがとうございます。またお昼にでも会いましょう。",
          "vi": "Cảm ơn chị. Hôm nào mình ăn trưa cùng nhé."
        }
      ],
