  "dialogues": [
    {
      "situation_uid": "a4dd9ae0-9f56-53cb-9709-9f1cf41fb688",
      "event_id": "E01",
      "context_vi": "Đồng nghiệp phụ trách vừa mời bạn dự buổi chào mừng anh Sato vào thứ Sáu. Bạn muốn biết buổi gặp tổ chức ở đâu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp phụ trách Tanaka",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a4dd9ae0-9f56-53cb-9709-9f1cf41fb688-u01",
          "speaker_id": "A",
          "ja": "金曜日の歓迎会はどこですか。",
          "vi": "Buổi chào mừng thứ Sáu tổ chức ở đâu ạ?"
        },
        {
          "id": "a4dd9ae0-9f56-53cb-9709-9f1cf41fb688-u02",
          "speaker_id": "B",
          "ja": "会社の近くの「さくら」です。",
          "vi": "Ở quán Sakura, gần công ty."
        },
        {
          "id": "a4dd9ae0-9f56-53cb-9709-9f1cf41fb688-u03",
          "speaker_id": "A",
          "ja": "会社から歩いて行けますか。",
          "vi": "Từ công ty đi bộ tới được không ạ?"
        },
        {
          "id": "a4dd9ae0-9f56-53cb-9709-9f1cf41fb688-u04",
          "speaker_id": "B",
          "ja": "ええ。そこのコンビニの隣です。",
          "vi": "Được. Quán ở ngay cạnh cửa hàng tiện lợi kia."
        }
      ],
      "admin": {
        "source_refs": [
          "season"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a4dd9ae0-9f56-53cb-9709-9f1cf41fb688-u01": {
            "kind": "original_extension"
