          }
        }
      }
    },
    {
      "situation_uid": "0ad06810-6417-5eaa-ac56-3908db5f4ea7",
      "event_id": "E02",
      "context_vi": "Ở buổi chào mừng của công ty, bạn đến chào một nhân viên mới và hỏi anh ấy về nhóm sẽ làm việc.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên mới Sato",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0ad06810-6417-5eaa-ac56-3908db5f4ea7-u01",
          "speaker_id": "A",
          "ja": "はじめまして。総務のランです。",
          "vi": "Chào anh, tôi là Lan bên hành chính."
        },
        {
          "id": "0ad06810-6417-5eaa-ac56-3908db5f4ea7-u02",
          "speaker_id": "B",
          "ja": "佐藤です。よろしくお願いします。",
          "vi": "Tôi là Sato. Rất mong được chị giúp đỡ."
        },
        {
          "id": "0ad06810-6417-5eaa-ac56-3908db5f4ea7-u03",
          "speaker_id": "A",
          "ja": "佐藤さんはどのチームですか。",
          "vi": "Anh Sato làm ở nhóm nào ạ?"
        },
        {
          "id": "0ad06810-6417-5eaa-ac56-3908db5f4ea7-u04",
          "speaker_id": "B",
          "ja": "営業チームです。月曜からです。",
          "vi": "Nhóm kinh doanh. Tôi bắt đầu từ thứ Hai."
        },
        {
          "id": "0ad06810-6417-5eaa-ac56-3908db5f4ea7-u05",
          "speaker_id": "A",
          "ja": "そうなんですね。総務は営業の隣なので、また会えそうですね。",
          "vi": "Ra vậy. Phòng hành chính cạnh phòng kinh doanh nên chắc mình sẽ còn gặp nhau."
        }
      ],
      "admin": {
        "source_refs": [
          "welcome"
        ],
