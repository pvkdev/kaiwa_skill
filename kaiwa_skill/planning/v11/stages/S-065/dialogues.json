    {
      "situation_uid": "51d6f625-ca11-54d2-9088-59c997bee240",
      "event_id": "E04",
      "context_vi": "Sáng hôm sau buổi chào mừng, bạn gặp anh Sato ở hành lang. Bạn hỏi anh ấy đã quen đường đến phòng nhóm kinh doanh chưa.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên mới Sato",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "51d6f625-ca11-54d2-9088-59c997bee240-u01",
          "speaker_id": "A",
          "ja": "佐藤さん、営業チームの部屋までの道は、もうわかりますか。",
          "vi": "Anh Sato, anh biết đường đến phòng nhóm kinh doanh chưa ạ?"
        },
        {
          "id": "51d6f625-ca11-54d2-9088-59c997bee240-u02",
          "speaker_id": "B",
          "ja": "まだ、どの階段かよくわからなくて。",
          "vi": "Tôi vẫn chưa rõ phải đi cầu thang nào."
        },
        {
          "id": "51d6f625-ca11-54d2-9088-59c997bee240-u03",
          "speaker_id": "A",
          "ja": "受付の奥の階段です。一緒に行きましょうか。",
          "vi": "Cầu thang phía sau quầy lễ tân ạ. Tôi đi cùng anh nhé?"
        },
        {
          "id": "51d6f625-ca11-54d2-9088-59c997bee240-u04",
          "speaker_id": "B",
          "ja": "お願いします。助かります。",
          "vi": "Vâng, nhờ chị dẫn tôi đi với."
        }
      ],
      "admin": {
        "source_refs": [
          "welcome"
        ],
