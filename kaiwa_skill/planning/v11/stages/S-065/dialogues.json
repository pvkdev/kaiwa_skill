          }
        }
      }
    },
    {
      "situation_uid": "075b5679-79a0-5d89-8401-b188e5fba3f2",
      "event_id": "E01",
      "context_vi": "Bạn vừa hỏi nơi tổ chức buổi chào mừng nhân viên mới Sato. Vì có việc gia đình vào thứ Sáu, bạn báo không tham gia và nhờ người mời chuyển lời chúc mừng anh Sato gia nhập công ty.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp phụ trách Tanaka",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "075b5679-79a0-5d89-8401-b188e5fba3f2-u01",
          "speaker_id": "A",
          "ja": "すみません。金曜は家の用事で行けません。",
          "vi": "Tiếc quá, thứ Sáu tôi có việc gia đình nên không đi được."
        },
        {
          "id": "075b5679-79a0-5d89-8401-b188e5fba3f2-u02",
          "speaker_id": "B",
          "ja": "そうですか。わかりました。",
          "vi": "Vậy à. Tôi hiểu rồi."
        },
        {
          "id": "075b5679-79a0-5d89-8401-b188e5fba3f2-u03",
          "speaker_id": "A",
          "ja": "佐藤さんに「入社おめでとうございます」と伝えてもらえますか。",
          "vi": "Anh chuyển giúp tôi lời chúc mừng anh Sato gia nhập công ty được không ạ?"
        },
        {
          "id": "075b5679-79a0-5d89-8401-b188e5fba3f2-u04",
          "speaker_id": "B",
          "ja": "ええ、伝えておきます。",
          "vi": "Được, tôi sẽ chuyển lời."
        },
        {
          "id": "075b5679-79a0-5d89-8401-b188e5fba3f2-u05",
          "speaker_id": "A",
          "ja": "ありがとうございます。また誘ってください。",
          "vi": "Cảm ơn anh. Lần sau anh lại rủ tôi nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "attend"
        ],
        "specialty_item_ids": [
          "sj-so-15-b07-193"
        ],
        "turn_origins": {
