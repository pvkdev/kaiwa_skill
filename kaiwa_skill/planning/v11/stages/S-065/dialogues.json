    {
      "situation_uid": "b801311a-62b2-56c0-860f-692bbaebe9df",
      "event_id": "E04",
      "context_vi": "Buổi chào mừng anh Sato vừa kết thúc. Bạn gặp anh Tanaka, người đã chuẩn bị buổi gặp, và muốn cảm ơn vì có dịp làm quen với Sato.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp phụ trách Tanaka",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b801311a-62b2-56c0-860f-692bbaebe9df-u01",
          "speaker_id": "A",
          "ja": "今日は準備してくださって、ありがとうございました。",
          "vi": "Cảm ơn anh đã chuẩn bị buổi gặp hôm nay."
        },
        {
          "id": "b801311a-62b2-56c0-860f-692bbaebe9df-u02",
          "speaker_id": "B",
          "ja": "いえ、来てくれてありがとうございます。",
          "vi": "Có gì đâu. Cảm ơn chị đã tới."
        },
        {
          "id": "b801311a-62b2-56c0-860f-692bbaebe9df-u03",
          "speaker_id": "A",
          "ja": "佐藤さんとゆっくり話せてよかったです。",
          "vi": "Tôi rất vui vì được nói chuyện với anh Sato một lúc."
        },
        {
          "id": "b801311a-62b2-56c0-860f-692bbaebe9df-u04",
          "speaker_id": "B",
          "ja": "皆さんに会えて、佐藤さんもうれしそうでしたね。",
          "vi": "Anh Sato có vẻ cũng vui vì được gặp mọi người."
        }
      ],
      "admin": {
