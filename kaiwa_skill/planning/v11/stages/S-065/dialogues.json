    {
      "situation_uid": "def9c887-40ad-56b4-83b9-e9e9229bd8bc",
      "event_id": "E03",
      "context_vi": "Ở tiệc đầu năm công ty, bạn chào một đồng nghiệp mới gặp ở nhóm phát triển và hỏi tháng Một nhóm anh ấy có việc gì sắp tới.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp Matsuda",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "def9c887-40ad-56b4-83b9-e9e9229bd8bc-u01",
          "speaker_id": "A",
          "ja": "明けましておめでとうございます。総務のランです。",
          "vi": "Chúc mừng năm mới. Tôi là Lan bên hành chính."
        },
        {
          "id": "def9c887-40ad-56b4-83b9-e9e9229bd8bc-u02",
          "speaker_id": "B",
          "ja": "おめでとうございます。開発チームの松田です。",
          "vi": "Chúc mừng năm mới. Tôi là Matsuda bên nhóm phát triển."
        },
        {
          "id": "def9c887-40ad-56b4-83b9-e9e9229bd8bc-u03",
          "speaker_id": "A",
          "ja": "開発チームは一月に何をしますか。",
          "vi": "Tháng Một nhóm phát triển sẽ làm gì ạ?"
        },
        {
          "id": "def9c887-40ad-56b4-83b9-e9e9229bd8bc-u04",
          "speaker_id": "B",
          "ja": "月末に新しいアプリを試します。",
          "vi": "Cuối tháng bên tôi sẽ chạy thử ứng dụng mới."
        },
        {
          "id": "def9c887-40ad-56b4-83b9-e9e9229bd8bc-u05",
          "speaker_id": "A",
          "ja": "そうなんですね。もうすぐですね。",
          "vi": "Vậy à. Cũng sắp rồi nhỉ."
        }
      ],
      "admin": {
