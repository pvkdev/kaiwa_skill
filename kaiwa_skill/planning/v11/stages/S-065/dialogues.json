      "turns": [
        {
          "id": "1ecd5743-319c-5904-a15e-5bf076756b65-u01",
          "speaker_id": "A",
          "ja": "昨日話した数字の資料、何時までに送ればいいですか。",
          "vi": "Tài liệu số liệu mình nói hôm qua ấy, tôi gửi chậm nhất lúc mấy giờ ạ?"
        },
        {
          "id": "1ecd5743-319c-5904-a15e-5bf076756b65-u02",
          "speaker_id": "B",
          "ja": "お昼までにお願いします。午後一時の会議で使います。",
          "vi": "Chị gửi trước trưa nhé. Tôi dùng trong cuộc họp lúc một giờ chiều."
        },
        {
          "id": "1ecd5743-319c-5904-a15e-5bf076756b65-u03",
          "speaker_id": "A",
          "ja": "わかりました。十一時までに送ります。",
          "vi": "Tôi hiểu rồi. Tôi sẽ gửi chậm nhất lúc mười một giờ."
        },
        {
          "id": "1ecd5743-319c-5904-a15e-5bf076756b65-u04",
          "speaker_id": "B",
          "ja": "助かります。届いたら見ておきますね。",
          "vi": "May quá. Nhận được tôi sẽ xem trước."
        }
