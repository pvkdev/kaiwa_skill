    {
      "situation_uid": "a97f24d2-db34-5de1-a0b0-1a6a3a36ce79",
      "event_id": "E03",
      "context_vi": "Bạn vừa trò chuyện với đồng nghiệp nhóm phát triển ở tiệc đầu năm. Bạn nghe họ của anh ấy thành Matsui và muốn hỏi lại để gọi cho đúng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp Matsuda",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a97f24d2-db34-5de1-a0b0-1a6a3a36ce79-u01",
          "speaker_id": "A",
          "ja": "すみません。お名前は松井さんでしたか。",
          "vi": "Cho tôi hỏi lại, anh là Matsui ạ?"
        },
        {
          "id": "a97f24d2-db34-5de1-a0b0-1a6a3a36ce79-u02",
          "speaker_id": "B",
          "ja": "松田です。「まつい」じゃなくて、「まつだ」です。",
          "vi": "Tôi họ Matsuda. Là Matsuda, không phải Matsui."
        },
        {
          "id": "a97f24d2-db34-5de1-a0b0-1a6a3a36ce79-u03",
          "speaker_id": "A",
          "ja": "松田さんですね。すみません、聞き間違えました。",
          "vi": "Anh Matsuda ạ. Tôi nghe nhầm, anh thông cảm nhé."
        },
        {
          "id": "a97f24d2-db34-5de1-a0b0-1a6a3a36ce79-u04",
          "speaker_id": "B",
          "ja": "大丈夫ですよ。",
          "vi": "Không sao đâu."
        }
      ],
