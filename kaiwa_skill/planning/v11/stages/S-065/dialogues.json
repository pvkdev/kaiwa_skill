    {
      "situation_uid": "af22c4bc-345b-57f0-a471-3928c634e06e",
      "event_id": "E01",
      "context_vi": "Bạn muốn ghé buổi chào mừng ở quán Sakura nhưng thứ Sáu phải rời quán chậm nhất lúc bảy giờ tối. Bạn hỏi người tổ chức có thể chỉ dự phần đầu không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp phụ trách Tanaka",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "af22c4bc-345b-57f0-a471-3928c634e06e-u01",
          "speaker_id": "A",
          "ja": "金曜日は夜七時までに店を出ないといけません。",
          "vi": "Thứ Sáu tôi phải rời quán chậm nhất lúc bảy giờ tối."
        },
        {
          "id": "af22c4bc-345b-57f0-a471-3928c634e06e-u02",
          "speaker_id": "A",
          "ja": "歓迎会は最初だけでもいいですか。",
          "vi": "Tôi chỉ dự phần đầu buổi chào mừng được không ạ?"
        },
        {
          "id": "af22c4bc-345b-57f0-a471-3928c634e06e-u03",
          "speaker_id": "B",
          "ja": "いいですよ。自己紹介は最初にします。",
          "vi": "Được chứ. Mọi người sẽ giới thiệu ngay đầu buổi."
        },
        {
          "id": "af22c4bc-345b-57f0-a471-3928c634e06e-u04",
          "speaker_id": "A",
          "ja": "よかったです。じゃ、最初だけ参加します。",
          "vi": "May quá. Vậy tôi sẽ đến dự phần đầu ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "attend"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "af22c4bc-345b-57f0-a471-3928c634e06e-u01": {
