    {
      "situation_uid": "dadc61cd-5e36-52b2-9531-713f443a7ebe",
      "event_id": "E03",
      "context_vi": "Trong tiệc công ty, đồng nghiệp đề nghị rót bia cho bạn. Bạn muốn từ chối bia và chọn đồ uống không cồn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp mời đồ uống",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "dadc61cd-5e36-52b2-9531-713f443a7ebe-u01",
          "speaker_id": "B",
          "ja": "ビール、どうですか。",
          "vi": "Chị uống bia không?"
        },
        {
          "id": "dadc61cd-5e36-52b2-9531-713f443a7ebe-u02",
          "speaker_id": "A",
          "ja": "今日はお酒は遠慮しておきます。お茶はありますか。",
          "vi": "Hôm nay tôi xin phép không uống rượu bia. Có trà không anh?"
        },
        {
          "id": "dadc61cd-5e36-52b2-9531-713f443a7ebe-u03",
          "speaker_id": "B",
          "ja": "ウーロン茶と緑茶がありますよ。",
          "vi": "Có trà ô long và trà xanh."
        },
        {
          "id": "dadc61cd-5e36-52b2-9531-713f443a7ebe-u04",
          "speaker_id": "A",
          "ja": "では、ウーロン茶をお願いします。",
          "vi": "Vậy cho tôi trà ô long nhé."
        }
      ],
      "admin": {
