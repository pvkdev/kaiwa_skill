          }
        }
      }
    },
    {
      "situation_uid": "c8eadc77-98cb-5478-b303-8471ba01f8fd",
      "event_id": "E02",
      "context_vi": "Trong tiệc chia tay đồng nghiệp chuyển sang nhóm khác, bạn muốn cảm ơn anh ấy từng chỉ việc và chúc anh ấy thuận lợi ở nhóm mới.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp chuyển nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c8eadc77-98cb-5478-b303-8471ba01f8fd-u01",
          "speaker_id": "A",
          "ja": "今まで、仕事を教えてくれてありがとうございました。",
          "vi": "Cảm ơn anh thời gian qua đã chỉ việc cho tôi."
        },
        {
          "id": "c8eadc77-98cb-5478-b303-8471ba01f8fd-u02",
          "speaker_id": "B",
          "ja": "いえいえ。私も助かりましたよ。",
          "vi": "Có gì đâu. Chị cũng giúp tôi nhiều mà."
        },
        {
          "id": "c8eadc77-98cb-5478-b303-8471ba01f8fd-u03",
          "speaker_id": "A",
          "ja": "新しいチームでも頑張ってくださいね。",
          "vi": "Chúc anh làm tốt ở nhóm mới nhé."
        },
        {
          "id": "c8eadc77-98cb-5478-b303-8471ba01f8fd-u04",
          "speaker_id": "B",
          "ja": "ありがとうございます。同じビルなので、また会いましょう。",
          "vi": "Cảm ơn chị. Vẫn cùng tòa nhà nên hôm nào mình gặp lại nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "congrats"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c8eadc77-98cb-5478-b303-8471ba01f8fd-u01": {
