    {
      "situation_uid": "91b238f7-28a5-5a84-bc82-0b5583bac729",
      "event_id": "E02",
      "context_vi": "Buổi liên hoan kết thúc dự án vừa xong. Bạn nói với đồng nghiệp cùng nhóm rằng mọi người đã giúp bạn vượt qua một giai đoạn bận và nhờ anh ấy gửi lời cảm ơn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp cùng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "91b238f7-28a5-5a84-bc82-0b5583bac729-u01",
          "speaker_id": "A",
          "ja": "最後の日、数字をみんなで見てくれて助かりました。",
          "vi": "Hôm cuối, may có mọi người cùng kiểm tra số liệu giúp tôi."
        },
        {
          "id": "91b238f7-28a5-5a84-bc82-0b5583bac729-u02",
          "speaker_id": "B",
          "ja": "あの日は忙しかったですね。間に合ってよかったです。",
          "vi": "Hôm đó bận thật. May mà mình kịp."
        },
        {
          "id": "91b238f7-28a5-5a84-bc82-0b5583bac729-u03",
          "speaker_id": "A",
          "ja": "皆さんにも「ありがとうございました」と伝えてください。",
          "vi": "Anh gửi lời cảm ơn của tôi đến mọi người nhé."
        },
        {
          "id": "91b238f7-28a5-5a84-bc82-0b5583bac729-u04",
          "speaker_id": "B",
          "ja": "はい。明日、チームのみんなに伝えます。",
          "vi": "Được. Ngày mai tôi sẽ chuyển lời cho cả nhóm."
        }
      ],
      "admin": {
