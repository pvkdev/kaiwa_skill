  "dialogues": [
    {
      "situation_uid": "bb60eb3d-344a-5c98-a554-42dd7669154d",
      "event_id": "E01",
      "context_vi": "Bạn thấy thông báo tuyển làm thêm của quán cà phê Midori và gọi hỏi còn tuyển không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bb60eb3d-344a-5c98-a554-42dd7669154d-u01",
          "speaker_id": "a",
          "ja": "アルバイトの募集を見ました。まだ募集していますか。",
          "vi": "Tôi thấy thông báo tuyển làm thêm. Quán còn tuyển không ạ?"
        },
        {
          "id": "bb60eb3d-344a-5c98-a554-42dd7669154d-u02",
          "speaker_id": "b",
          "ja": "はい、まだ募集しています。面接を希望しますか。",
          "vi": "Có, chúng tôi vẫn tuyển. Bạn muốn phỏng vấn không?"
        },
        {
          "id": "bb60eb3d-344a-5c98-a554-42dd7669154d-u03",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, tôi muốn xin phỏng vấn."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "bb60eb3d-344a-5c98-a554-42dd7669154d-u01": {
            "kind": "original_extension"
          },
          "bb60eb3d-344a-5c98-a554-42dd7669154d-u02": {
            "kind": "original_extension"
          },
          "bb60eb3d-344a-5c98-a554-42dd7669154d-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3a326184-0d26-58fc-836d-6142eaf2df37",
      "event_id": "E01",
      "context_vi": "Bạn gọi quán cà phê theo thông báo tuyển, nhưng nhân viên báo đã đủ người. Bạn hỏi mốc có thể liên hệ lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3a326184-0d26-58fc-836d-6142eaf2df37-u01",
          "speaker_id": "b",
          "ja": "先ほど募集しているとお伝えしましたが、今の枠が埋まりました。すみません。",
          "vi": "Lúc nãy tôi báo còn tuyển, nhưng vị trí vừa được nhận đủ người. Xin lỗi bạn."
        },
        {
          "id": "3a326184-0d26-58fc-836d-6142eaf2df37-u02",
          "speaker_id": "a",
          "ja": "また募集する予定はありますか。いつ聞けばいいですか。",
          "vi": "Quán có định tuyển lại không? Khi nào tôi nên hỏi lại ạ?"
        },
        {
          "id": "3a326184-0d26-58fc-836d-6142eaf2df37-u03",
          "speaker_id": "b",
          "ja": "来月の初めに店の募集ページを見てください。",
          "vi": "Đầu tháng tới, bạn xem trang tuyển dụng của quán nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3a326184-0d26-58fc-836d-6142eaf2df37-u01": {
            "kind": "original_extension"
          },
          "3a326184-0d26-58fc-836d-6142eaf2df37-u02": {
            "kind": "original_extension"
          },
          "3a326184-0d26-58fc-836d-6142eaf2df37-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "dda5f59c-f491-5857-b2e0-bc5c0fe6b20d",
      "event_id": "E01",
      "context_vi": "Trước khi xin lịch phỏng vấn, bạn gọi quán hỏi việc chính và khung giờ làm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "dda5f59c-f491-5857-b2e0-bc5c0fe6b20d-u01",
          "speaker_id": "a",
          "ja": "主にどんな仕事をしますか。働く時間は何時からですか。",
          "vi": "Công việc chủ yếu là gì, và giờ làm bắt đầu từ mấy giờ ạ?"
        },
        {
          "id": "dda5f59c-f491-5857-b2e0-bc5c0fe6b20d-u02",
          "speaker_id": "b",
          "ja": "今の募集はホールで注文を聞く仕事です。夕方五時から九時の枠です。",
          "vi": "Đợt tuyển này là vị trí phục vụ trong quán, nhận món khách gọi. Ca từ 5 đến 9 giờ tối."
        },
        {
          "id": "dda5f59c-f491-5857-b2e0-bc5c0fe6b20d-u03",
          "speaker_id": "a",
          "ja": "分かりました。面接を希望します。",
          "vi": "Tôi hiểu. Tôi muốn xin phỏng vấn."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "dda5f59c-f491-5857-b2e0-bc5c0fe6b20d-u01": {
            "kind": "original_extension"
          },
          "dda5f59c-f491-5857-b2e0-bc5c0fe6b20d-u02": {
            "kind": "original_extension"
          },
          "dda5f59c-f491-5857-b2e0-bc5c0fe6b20d-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "9fdaad04-f404-51d5-a9c2-3f9acbd5dbdc",
      "event_id": "E01",
      "context_vi": "Nhân viên nói tên vị trí là ホール, bạn chưa hiểu. Bạn xin một ví dụ việc thường làm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9fdaad04-f404-51d5-a9c2-3f9acbd5dbdc-u01",
          "speaker_id": "a",
          "ja": "「ホール」は何をする仕事ですか。例えば一つ教えてください。",
          "vi": "“Hōru” là công việc gì ạ? Cho tôi một ví dụ cụ thể."
        },
        {
          "id": "9fdaad04-f404-51d5-a9c2-3f9acbd5dbdc-u02",
          "speaker_id": "b",
          "ja": "お客様を席へ案内したり、注文を聞いたりします。",
          "vi": "Ví dụ, bạn dẫn khách tới bàn và nhận món khách gọi."
        },
        {
          "id": "9fdaad04-f404-51d5-a9c2-3f9acbd5dbdc-u03",
          "speaker_id": "a",
          "ja": "分かりました。店内でお客様に対応する仕事ですね。",
          "vi": "Tôi hiểu, là phục vụ khách trong quán."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9fdaad04-f404-51d5-a9c2-3f9acbd5dbdc-u01": {
            "kind": "original_extension"
          },
          "9fdaad04-f404-51d5-a9c2-3f9acbd5dbdc-u02": {
            "kind": "original_extension"
          },
          "9fdaad04-f404-51d5-a9c2-3f9acbd5dbdc-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644",
      "event_id": "E02",
      "context_vi": "Quán mời bạn tới phỏng vấn. Bạn nói thứ Ba sau 2 giờ chiều có thể đến.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u01",
          "speaker_id": "a",
          "ja": "面接は火曜日の午後二時以降なら行けます。",
          "vi": "Tôi có thể đến phỏng vấn từ 2 giờ chiều thứ Ba."
        },
        {
          "id": "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u02",
          "speaker_id": "b",
          "ja": "では、火曜日の三時はいかがですか。",
          "vi": "Vậy thứ Ba lúc 3 giờ được không ạ?"
        },
        {
          "id": "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u03",
          "speaker_id": "a",
          "ja": "はい、三時に伺います。",
          "vi": "Vâng, tôi sẽ đến lúc 3 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u01": {
            "kind": "original_extension"
          },
          "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u02": {
            "kind": "original_extension"
          },
          "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "63764ae4-ca4b-5e8d-90b9-e28fb9606222",
      "event_id": "E02",
      "context_vi": "Quán báo thứ Ba lúc 3 giờ không tiện. Bạn đề xuất hai giờ khác để họ chọn, rồi chốt một giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "63764ae4-ca4b-5e8d-90b9-e28fb9606222-u01",
          "speaker_id": "b",
          "ja": "先ほど火曜日の三時で予約しましたが、担当者の都合が変わりました。すみません。",
          "vi": "Lúc nãy tôi đã hẹn thứ Ba lúc 3 giờ, nhưng lịch người phỏng vấn vừa thay đổi. Xin lỗi bạn."
        },
        {
          "id": "63764ae4-ca4b-5e8d-90b9-e28fb9606222-u02",
          "speaker_id": "a",
          "ja": "水曜日の十時か、木曜日の二時はどうですか。",
          "vi": "Thứ Tư lúc 10 giờ hoặc thứ Năm lúc 2 giờ được không ạ?"
        },
        {
          "id": "63764ae4-ca4b-5e8d-90b9-e28fb9606222-u03",
          "speaker_id": "b",
          "ja": "木曜日の二時でお願いします。",
          "vi": "Thứ Năm lúc 2 giờ nhé."
        },
        {
          "id": "63764ae4-ca4b-5e8d-90b9-e28fb9606222-u04",
          "speaker_id": "a",
          "ja": "木曜日の二時に伺います。",
          "vi": "Tôi sẽ đến lúc 2 giờ thứ Năm."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "63764ae4-ca4b-5e8d-90b9-e28fb9606222-u01": {
