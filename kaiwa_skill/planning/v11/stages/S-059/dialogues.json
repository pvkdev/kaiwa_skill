    {
      "situation_uid": "7ed7d50d-680e-5f7d-9512-b9a2c53c98c2",
      "event_id": "E04",
      "context_vi": "Sau lời mời dự kiến của quán, bạn vẫn chưa nhận được xác nhận chính thức. Bạn hỏi khi nào quán sẽ báo kết quả.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7ed7d50d-680e-5f7d-9512-b9a2c53c98c2-u01",
          "speaker_id": "a",
          "ja": "最初に働く日は、まだ決まっていませんか。いつご連絡をいただけますか。",
          "vi": "Ngày đầu đi làm vẫn chưa chốt phải không ạ? Khi nào tôi sẽ nhận được tin?"
        },
        {
          "id": "7ed7d50d-680e-5f7d-9512-b9a2c53c98c2-u02",
          "speaker_id": "b",
          "ja": "まだ条件を確認中です。金曜日の午後五時までに電話します。",
          "vi": "Chúng tôi vẫn đang xác nhận điều kiện. Chậm nhất 5 giờ chiều thứ Sáu, chúng tôi sẽ gọi."
        }
      ],
