    {
      "situation_uid": "53e2d7e7-f934-51f9-9f9a-50c65a7f553c",
      "event_id": "E03",
      "context_vi": "Bạn đến phỏng vấn quán cà phê. Người phỏng vấn hỏi giới thiệu; bạn nêu tên và kinh nghiệm gần nhất ở cửa hàng bánh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "53e2d7e7-f934-51f9-9f9a-50c65a7f553c-u01",
          "speaker_id": "b",
          "ja": "お名前と、最近のお仕事を教えてください。",
          "vi": "Bạn cho biết tên và công việc gần nhất nhé."
        },
        {
          "id": "53e2d7e7-f934-51f9-9f9a-50c65a7f553c-u02",
          "speaker_id": "a",
          "ja": "リンです。去年、パン屋でレジの仕事をしました。",
          "vi": "Tôi là Linh. Năm ngoái tôi làm thu ngân ở tiệm bánh."
        },
        {
