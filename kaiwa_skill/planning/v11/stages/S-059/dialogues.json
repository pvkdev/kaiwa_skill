    {
      "situation_uid": "aa1484f5-f1ab-5dc6-85be-4b7ca107891e",
      "event_id": "E03",
      "context_vi": "Trong buổi phỏng vấn, bạn có lớp học buổi sáng. Bạn nói rõ ngày và giờ có thể làm, để người tuyển đối chiếu với ca.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "aa1484f5-f1ab-5dc6-85be-4b7ca107891e-u01",
          "speaker_id": "b",
          "ja": "いつ働けますか。",
          "vi": "Bạn có thể làm lúc nào ạ?"
        },
        {
          "id": "aa1484f5-f1ab-5dc6-85be-4b7ca107891e-u02",
          "speaker_id": "a",
          "ja": "月曜日と水曜日は、午後五時から九時まで働けます。午前は学校です。",
          "vi": "Thứ Hai và thứ Tư tôi có thể làm từ 5 đến 9 giờ tối. Buổi sáng tôi đi học."
        },
        {
          "id": "aa1484f5-f1ab-5dc6-85be-4b7ca107891e-u03",
          "speaker_id": "b",
          "ja": "月曜日と水曜日の夕方ですね。シフトを確認します。",
          "vi": "Buổi chiều tối thứ Hai và thứ Tư ạ. Tôi sẽ kiểm lịch ca."
        }
      ],
      "admin": {
