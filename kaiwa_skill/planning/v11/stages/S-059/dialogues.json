    {
      "situation_uid": "96fcbbe3-f487-58cf-8ef8-fef5121dc201",
      "event_id": "E02",
      "context_vi": "Bạn đã hẹn phỏng vấn tại quán nhưng không nghe rõ địa điểm. Bạn hỏi lại lối vào cụ thể.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "96fcbbe3-f487-58cf-8ef8-fef5121dc201-u01",
          "speaker_id": "a",
          "ja": "面接の場所をもう一度お願いします。入口はどちらですか。",
          "vi": "Xin nhắc lại nơi phỏng vấn. Lối vào ở phía nào ạ?"
        },
        {
          "id": "96fcbbe3-f487-58cf-8ef8-fef5121dc201-u02",
          "speaker_id": "b",
          "ja": "あおい駅西口の店です。入口は大通り側です。",
          "vi": "Là quán ở cửa tây ga Aoi. Lối vào quay ra đường lớn."
        },
        {
          "id": "96fcbbe3-f487-58cf-8ef8-fef5121dc201-u03",
          "speaker_id": "a",
          "ja": "西口の店、大通り側ですね。",
          "vi": "Quán cửa tây, lối đường lớn ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "96fcbbe3-f487-58cf-8ef8-fef5121dc201-u01": {
            "kind": "original_extension"
          },
