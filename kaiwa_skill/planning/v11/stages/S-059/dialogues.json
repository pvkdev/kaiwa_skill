          "9fdaad04-f404-51d5-a9c2-3f9acbd5dbdc-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644",
      "event_id": "E02",
      "context_vi": "Quán mời bạn tới phỏng vấn. Bạn nói thứ Ba sau 2 giờ chiều có thể đến.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u01",
          "speaker_id": "a",
          "ja": "面接は火曜日の午後二時以降なら行けます。",
          "vi": "Tôi có thể đến phỏng vấn từ 2 giờ chiều thứ Ba."
        },
        {
          "id": "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u02",
          "speaker_id": "b",
          "ja": "では、火曜日の午後三時はいかがですか。",
          "vi": "Vậy 3 giờ chiều thứ Ba được không ạ?"
        },
        {
          "id": "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u03",
          "speaker_id": "a",
          "ja": "はい、火曜日の午後三時に伺います。",
          "vi": "Vâng, tôi sẽ đến lúc 3 giờ chiều thứ Ba ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u01": {
            "kind": "original_extension"
          },
          "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u02": {
            "kind": "original_extension"
          },
          "3aa7a0c9-c538-5c74-8ce5-f7980b2e0644-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "63764ae4-ca4b-5e8d-90b9-e28fb9606222",
      "event_id": "E02",
      "context_vi": "Quán báo thứ Ba lúc 3 giờ không tiện. Bạn đề xuất hai giờ khác để họ chọn, rồi chốt một giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "63764ae4-ca4b-5e8d-90b9-e28fb9606222-u01",
          "speaker_id": "b",
          "ja": "先ほど火曜日の午後三時とお伝えしましたが、面接担当がその時間に会えなくなりました。すみません。",
          "vi": "Lúc nãy tôi hẹn 3 giờ chiều thứ Ba, nhưng người phỏng vấn không gặp được giờ đó nữa. Xin lỗi chị."
        },
        {
          "id": "63764ae4-ca4b-5e8d-90b9-e28fb9606222-u02",
          "speaker_id": "a",
          "ja": "水曜日の午前十時か、木曜日の午後二時はいかがですか。",
          "vi": "10 giờ sáng thứ Tư hoặc 2 giờ chiều thứ Năm được không ạ?"
        },
        {
          "id": "63764ae4-ca4b-5e8d-90b9-e28fb9606222-u03",
          "speaker_id": "b",
          "ja": "では、木曜日の午後二時でお願いします。",
          "vi": "Vậy hẹn chị 2 giờ chiều thứ Năm nhé."
        },
        {
          "id": "63764ae4-ca4b-5e8d-90b9-e28fb9606222-u04",
          "speaker_id": "a",
          "ja": "木曜日の二時に伺います。",
          "vi": "Tôi sẽ đến lúc 2 giờ chiều thứ Năm ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
