            "kind": "original_extension"
          },
          "96fcbbe3-f487-58cf-8ef8-fef5121dc201-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b",
      "event_id": "E02",
      "context_vi": "Bạn đã hẹn phỏng vấn thứ Ba 3 giờ, nhưng có việc đột xuất. Bạn gọi trước giờ hẹn để xin đổi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b-u01",
          "speaker_id": "a",
          "ja": "火曜日の三時に面接の約束をしたリンです。急な用事で行けません。変更できますか。",
          "vi": "Tôi là Linh, đã hẹn phỏng vấn 3 giờ thứ Ba. Tôi có việc đột xuất nên không đến được. Xin đổi giờ được không ạ?"
        },
        {
          "id": "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b-u02",
          "speaker_id": "b",
          "ja": "木曜日の二時なら空いています。",
          "vi": "Thứ Năm lúc 2 giờ còn trống."
        },
        {
          "id": "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b-u03",
          "speaker_id": "a",
          "ja": "木曜日の二時にお願いします。",
          "vi": "Vậy cho tôi đổi sang 2 giờ thứ Năm."
        },
        {
          "id": "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b-u04",
          "speaker_id": "b",
          "ja": "変更しました。",
          "vi": "Tôi đã đổi lịch."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b-u01": {
