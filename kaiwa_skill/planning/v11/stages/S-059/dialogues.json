            "kind": "original_extension"
          },
          "96fcbbe3-f487-58cf-8ef8-fef5121dc201-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b",
      "event_id": "E02",
      "context_vi": "Bạn đã hẹn phỏng vấn thứ Ba 3 giờ, nhưng có việc đột xuất. Bạn gọi trước giờ hẹn để xin đổi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b-u01",
          "speaker_id": "a",
          "ja": "火曜日の午後三時に面接のお約束をしたリンです。すみません、急な用事で行けなくなりました。日時を変えられますか。",
          "vi": "Tôi là Linh, có lịch phỏng vấn 3 giờ chiều thứ Ba. Xin lỗi, tôi có việc đột xuất nên không tới được. Tôi đổi lịch được không ạ?"
        },
        {
          "id": "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b-u02",
          "speaker_id": "b",
          "ja": "木曜日の午後二時なら空いています。",
          "vi": "Bên tôi còn trống lúc 2 giờ chiều thứ Năm ạ."
        },
        {
          "id": "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b-u03",
          "speaker_id": "a",
          "ja": "木曜日の二時にお願いします。",
          "vi": "Vậy cho tôi đổi sang 2 giờ thứ Năm."
        },
        {
          "id": "5fbcf0fc-e6be-5ac1-9150-7b54e7f7be8b-u04",
          "speaker_id": "b",
          "ja": "木曜日の午後二時に変更しました。",
          "vi": "Tôi đã đổi sang 2 giờ chiều thứ Năm ạ."
        }
      ],
      "admin": {
