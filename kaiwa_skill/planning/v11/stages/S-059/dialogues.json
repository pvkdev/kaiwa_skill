    {
      "situation_uid": "27fc1d64-32f8-5f54-8a78-b9b141b21a6c",
      "event_id": "E04",
      "context_vi": "Quán mời bạn làm ở cửa tây và dự kiến ngày đầu là thứ Hai, còn phải xác nhận điều kiện và lịch. Bạn muốn nhận lời và hỏi khi đến sẽ gặp ai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "27fc1d64-32f8-5f54-8a78-b9b141b21a6c-u01",
          "speaker_id": "b",
          "ja": "西口の店で働いていただきたいです。条件を確認できたら、月曜日から来ていただく予定です。",
          "vi": "Chúng tôi muốn mời chị vào làm ở quán cửa tây. Nếu xác nhận xong điều kiện, dự kiến chị bắt đầu từ thứ Hai."
        },
        {
          "id": "27fc1d64-32f8-5f54-8a78-b9b141b21a6c-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。ぜひお願いします。月曜日に行くことになったら、誰に声をかければいいですか。",
          "vi": "Cảm ơn anh. Tôi rất muốn nhận việc. Nếu đến vào thứ Hai thì tôi nên gặp ai ạ?"
        },
        {
          "id": "27fc1d64-32f8-5f54-8a78-b9b141b21a6c-u03",
          "speaker_id": "b",
          "ja": "店長の田中です。勤務の条件をお伝えして、初日が決まったらまたご連絡します。",
          "vi": "Chị gặp quản lý Tanaka. Tôi sẽ gửi thông tin về điều kiện làm việc và liên hệ lại khi chốt ngày đầu ạ."
        }
      ],
