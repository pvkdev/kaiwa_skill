    {
      "situation_uid": "6ec5c717-c210-54f3-bb63-dc2ddc03ffc7",
      "event_id": "E04",
      "context_vi": "Sau buổi phỏng vấn, quán đề xuất một chi nhánh khác thay cho cửa tây. Bạn hỏi công việc và địa điểm mới trước khi quyết định.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6ec5c717-c210-54f3-bb63-dc2ddc03ffc7-u01",
          "speaker_id": "b",
          "ja": "西口の店ではなく、東口の店はいかがですか。",
          "vi": "Thay vì quán cửa tây, bạn thấy quán cửa đông được không?"
        },
        {
          "id": "6ec5c717-c210-54f3-bb63-dc2ddc03ffc7-u02",
          "speaker_id": "a",
          "ja": "東口の店では何の仕事ですか。場所も教えてください。",
          "vi": "Ở quán cửa đông là công việc gì ạ? Xin cho biết cả địa điểm."
        },
        {
          "id": "6ec5c717-c210-54f3-bb63-dc2ddc03ffc7-u03",
          "speaker_id": "b",
          "ja": "駅の東口を出て右の店です。仕事は注文を聞くことです。",
          "vi": "Quán nằm bên phải khi ra cửa đông ga. Công việc là nhận món khách gọi."
        }
      ],
