    {
      "situation_uid": "d4120b7f-9d49-53be-97fe-cb94a1adc9bc",
      "event_id": "E03",
      "context_vi": "Người phỏng vấn thấy bạn từng làm thu ngân và hỏi đã nhận đơn qua máy đặt món chưa. Bạn chưa làm việc đó, nhưng sẵn sàng học.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d4120b7f-9d49-53be-97fe-cb94a1adc9bc-u01",
          "speaker_id": "b",
          "ja": "注文の機械を使ったことはありますか。",
          "vi": "Bạn từng dùng máy nhận đơn chưa?"
        },
        {
          "id": "d4120b7f-9d49-53be-97fe-cb94a1adc9bc-u02",
          "speaker_id": "a",
          "ja": "まだありません。でも、教えていただければ覚えたいです。",
          "vi": "Tôi chưa từng dùng, nhưng nếu được hướng dẫn tôi muốn học."
        },
        {
          "id": "d4120b7f-9d49-53be-97fe-cb94a1adc9bc-u03",
          "speaker_id": "b",
          "ja": "分かりました。研修で練習できます。",
          "vi": "Tôi hiểu. Bạn có thể tập trong buổi hướng dẫn."
        }
      ],
      "admin": {
