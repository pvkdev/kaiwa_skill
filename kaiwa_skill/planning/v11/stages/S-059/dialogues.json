    {
      "situation_uid": "050acd18-e85b-55f6-badf-2e4ad771e088",
      "event_id": "E03",
      "context_vi": "Bạn đã nói chỉ làm được tối thứ Hai và thứ Tư. Người phỏng vấn đề nghị ca sáng thứ Bảy; bạn từ chối ca đó và hỏi ca khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "050acd18-e85b-55f6-badf-2e4ad771e088-u01",
          "speaker_id": "b",
          "ja": "土曜日の朝も働けますか。",
          "vi": "Bạn có làm sáng thứ Bảy được không ạ?"
        },
        {
          "id": "050acd18-e85b-55f6-badf-2e4ad771e088-u02",
          "speaker_id": "a",
          "ja": "土曜日の朝は働けません。月曜日か水曜日の夕方の枠はありますか。",
          "vi": "Sáng thứ Bảy tôi không làm được. Còn ca chiều tối thứ Hai hoặc thứ Tư không ạ?"
        },
        {
          "id": "050acd18-e85b-55f6-badf-2e4ad771e088-u03",
          "speaker_id": "b",
          "ja": "水曜日の夕方の枠があります。",
          "vi": "Có ca chiều tối thứ Tư."
        }
      ],
      "admin": {
        "source_refs": [
