    {
      "situation_uid": "d4120b7f-9d49-53be-97fe-cb94a1adc9bc",
      "event_id": "E03",
      "context_vi": "Người phỏng vấn thấy bạn từng làm thu ngân và hỏi đã nhận đơn qua máy đặt món chưa. Bạn chưa làm việc đó, nhưng sẵn sàng học.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d4120b7f-9d49-53be-97fe-cb94a1adc9bc-u01",
          "speaker_id": "b",
          "ja": "注文を取る端末を使ったことはありますか。",
          "vi": "Chị từng dùng máy nhận món khách gọi chưa ạ?"
        },
        {
          "id": "d4120b7f-9d49-53be-97fe-cb94a1adc9bc-u02",
          "speaker_id": "a",
          "ja": "まだ使ったことはありません。ぜひ教えていただきたいです。",
          "vi": "Tôi chưa từng dùng. Tôi rất muốn được hướng dẫn ạ."
        },
        {
          "id": "d4120b7f-9d49-53be-97fe-cb94a1adc9bc-u03",
          "speaker_id": "b",
          "ja": "分かりました。採用になったら、研修で練習できます。",
          "vi": "Tôi hiểu. Nếu được nhận, chị sẽ được tập trong buổi hướng dẫn ạ."
        }
      ],
