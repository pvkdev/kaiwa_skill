    {
      "situation_uid": "27fc1d64-32f8-5f54-8a78-b9b141b21a6c",
      "event_id": "E04",
      "context_vi": "Quán nói muốn mời bạn vào làm và dự kiến ngày đầu là thứ Hai, nhưng còn bước xác nhận điều kiện làm việc. Bạn hỏi ngày đó sẽ gặp ai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tuyển",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "27fc1d64-32f8-5f54-8a78-b9b141b21a6c-u01",
          "speaker_id": "b",
          "ja": "西口の店にぜひ来てほしいです。条件を確認できれば、最初は月曜日の予定です。",
          "vi": "Chúng tôi muốn mời bạn vào làm ở quán cửa tây. Nếu xác nhận xong điều kiện, dự kiến ngày đầu là thứ Hai."
        },
        {
          "id": "27fc1d64-32f8-5f54-8a78-b9b141b21a6c-u02",
          "speaker_id": "a",
          "ja": "月曜日は誰に会えばいいですか。",
          "vi": "Thứ Hai tôi cần gặp ai ạ?"
        },
        {
          "id": "27fc1d64-32f8-5f54-8a78-b9b141b21a6c-u03",
          "speaker_id": "b",
          "ja": "店長の田中です。正式に決まったら、こちらから連絡します。",
          "vi": "Bạn gặp quản lý Tanaka. Khi chốt chính thức, chúng tôi sẽ liên hệ."
        }
      ],
      "admin": {
