  "dialogues": [
    {
      "situation_uid": "bb60eb3d-344a-5c98-a554-42dd7669154d",
      "event_id": "E01",
      "context_vi": "Bạn thấy thông báo tuyển làm thêm của quán cà phê Midori và gọi hỏi còn tuyển không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bb60eb3d-344a-5c98-a554-42dd7669154d-u01",
          "speaker_id": "a",
          "ja": "アルバイトの募集を見てお電話しました。まだ応募できますか。",
          "vi": "Tôi thấy thông báo tuyển làm thêm nên gọi. Quán còn nhận ứng viên không ạ?"
        },
        {
          "id": "bb60eb3d-344a-5c98-a554-42dd7669154d-u02",
          "speaker_id": "b",
          "ja": "はい。面接をご希望でしたら、採用担当におつなぎします。",
          "vi": "Còn ạ. Nếu chị muốn phỏng vấn, tôi sẽ nối máy với người phụ trách tuyển dụng."
        },
        {
          "id": "bb60eb3d-344a-5c98-a554-42dd7669154d-u03",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, tôi muốn xin phỏng vấn."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "bb60eb3d-344a-5c98-a554-42dd7669154d-u01": {
            "kind": "original_extension"
          },
          "bb60eb3d-344a-5c98-a554-42dd7669154d-u02": {
            "kind": "original_extension"
          },
          "bb60eb3d-344a-5c98-a554-42dd7669154d-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3a326184-0d26-58fc-836d-6142eaf2df37",
      "event_id": "E01",
      "context_vi": "Ban đầu nhân viên tưởng quán còn nhận ứng viên, nhưng sau khi hỏi người tuyển, họ báo vị trí đã đủ người. Bạn hỏi khi nào có thể liên hệ lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3a326184-0d26-58fc-836d-6142eaf2df37-u01",
          "speaker_id": "b",
          "ja": "すみません。担当に確認したところ、今回はもう募集を締め切っていました。",
          "vi": "Xin lỗi chị. Tôi hỏi bộ phận tuyển dụng thì đợt này đã ngừng nhận hồ sơ rồi ạ."
        },
        {
          "id": "3a326184-0d26-58fc-836d-6142eaf2df37-u02",
          "speaker_id": "a",
          "ja": "また募集する予定はありますか。いつ聞けばいいですか。",
          "vi": "Quán có định tuyển lại không? Khi nào tôi nên hỏi lại ạ?"
        },
        {
          "id": "3a326184-0d26-58fc-836d-6142eaf2df37-u03",
          "speaker_id": "b",
          "ja": "来月の初めに店の募集ページを見てください。",
          "vi": "Đầu tháng tới, bạn xem trang tuyển dụng của quán nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "phone",
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3a326184-0d26-58fc-836d-6142eaf2df37-u01": {
            "kind": "original_extension"
          },
