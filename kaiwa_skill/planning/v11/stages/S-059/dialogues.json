    {
      "situation_uid": "3447b987-e168-587b-9773-15060fd4706c",
      "event_id": "E04",
      "context_vi": "Sau khi cân nhắc lời mời làm ở quán, bạn quyết định không nhận. Bạn gọi báo lịch sự để quán không chờ.",
