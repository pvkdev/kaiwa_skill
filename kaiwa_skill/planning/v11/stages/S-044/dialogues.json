          }
        }
      }
    },
    {
      "situation_uid": "e7779c36-1f9e-58e1-bb25-0c762761f850",
      "event_id": "E03",
      "context_vi": "Anh Tanaka đã đồng ý nghe máy lúc 2 giờ 15, rồi phát hiện mình có lịch gọi khác trùng giờ. Anh gọi lại cho Linh để đổi giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người được hẹn gọi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e7779c36-1f9e-58e1-bb25-0c762761f850-u01",
          "speaker_id": "b",
          "ja": "すみません。二時十五分で大丈夫と言いましたが、その時間に別の電話の予定がありました。",
          "vi": "Xin lỗi. Lúc nãy tôi bảo 2 giờ 15 được, nhưng tôi vừa thấy mình có hẹn gọi điện vào đúng giờ đó."
        },
        {
          "id": "e7779c36-1f9e-58e1-bb25-0c762761f850-u02",
          "speaker_id": "a",
          "ja": "では、三時はいかがですか。",
          "vi": "Vậy 3 giờ được không ạ?"
        },
        {
