        }
      }
    },
    {
      "situation_uid": "cd7b5e08-2793-5531-9b4c-efac9e184e43",
      "event_id": "E03",
      "context_vi": "Bạn đã hẹn gọi cho anh Tanaka lúc 2 giờ, nhưng sẽ muộn 15 phút.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người được hẹn gọi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cd7b5e08-2793-5531-9b4c-efac9e184e43-u01",
          "speaker_id": "a",
          "ja": "田中さん、二時のお電話ですが、すみません、十五分ほど遅れます。二時十五分に電話してもいいですか。",
          "vi": "Anh Tanaka, xin lỗi anh, tôi sẽ gọi muộn khoảng 15 phút so với giờ hẹn. Tôi gọi lúc 2 giờ 15 được không ạ?"
        },
        {
          "id": "cd7b5e08-2793-5531-9b4c-efac9e184e43-u02",
          "speaker_id": "b",
          "ja": "はい、二時十五分なら大丈夫です。",
          "vi": "Được, 2 giờ 15 tôi nghe được."
        }
      ],
      "admin": {
        "source_refs": [
          "telephone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "cd7b5e08-2793-5531-9b4c-efac9e184e43-u01": {
            "kind": "original_extension"
          },
          "cd7b5e08-2793-5531-9b4c-efac9e184e43-u02": {
