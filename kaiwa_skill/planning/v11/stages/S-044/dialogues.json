      "start_line": 1,
      "end_line": 80,
      "use_vi": "Lấy cách nhận lời nhắn, xác nhận nội dung và người gọi; lời thoại viết mới."
    }
  },
  "dialogues": [
    {
      "situation_uid": "ce221693-1868-5ee3-8834-3e46bd0f2cc0",
      "event_id": "E01",
      "context_vi": "Bạn gọi từ phòng kinh doanh sang tổng vụ để hỏi ai phụ trách cuộc họp thứ Sáu. Người nghe cần kiểm lại người phụ trách.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người nhận máy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ce221693-1868-5ee3-8834-3e46bd0f2cc0-u01",
          "speaker_id": "a",
          "ja": "お疲れさまです。営業のリンです。会議の予定はどなたに聞けばいいですか。",
          "vi": "Chào anh, tôi là Linh bên kinh doanh. Tôi nên hỏi ai về lịch họp ạ?"
        },
        {
          "id": "ce221693-1868-5ee3-8834-3e46bd0f2cc0-u02",
          "speaker_id": "b",
          "ja": "はい、総務の田中です。どの会議ですか。",
          "vi": "Tôi là Tanaka bên tổng vụ. Bạn hỏi cuộc họp nào?"
        },
        {
          "id": "ce221693-1868-5ee3-8834-3e46bd0f2cc0-u03",
          "speaker_id": "a",
          "ja": "金曜日の会議です。",
          "vi": "Cuộc họp thứ Sáu ạ."
        },
        {
          "id": "ce221693-1868-5ee3-8834-3e46bd0f2cc0-u04",
          "speaker_id": "b",
          "ja": "担当を確認します。",
          "vi": "Để tôi kiểm tra người phụ trách."
        }
      ],
      "admin": {
        "source_refs": [
          "telephone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ce221693-1868-5ee3-8834-3e46bd0f2cc0-u01": {
