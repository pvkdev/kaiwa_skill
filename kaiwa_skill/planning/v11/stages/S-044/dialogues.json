          },
          "15c1d1d2-c4aa-58b2-b0f7-bb1c288fbb00-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3ae5d262-a762-52dc-87fe-d8976a682eb6",
      "event_id": "E02",
      "context_vi": "Linh gọi lại phòng của Sato để hỏi lời nhắn về tài liệu đã được chuyển chưa. Lần gọi trước Linh chưa nhờ Sato gọi lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người nhận máy thay",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3ae5d262-a762-52dc-87fe-d8976a682eb6-u01",
          "speaker_id": "a",
          "ja": "先ほど佐藤さんへの伝言をお願いしたリンです。もう伝えていただけましたか。",
          "vi": "Tôi là Linh, lúc nãy có nhờ anh nhắn chị Sato. Anh đã chuyển lời cho chị ấy chưa ạ?"
        },
        {
          "id": "3ae5d262-a762-52dc-87fe-d8976a682eb6-u02",
          "speaker_id": "b",
          "ja": "はい、伝えました。佐藤さんは今、会議中です。",
          "vi": "Tôi đã báo rồi. Chị Sato hiện đang họp."
        },
        {
          "id": "3ae5d262-a762-52dc-87fe-d8976a682eb6-u03",
          "speaker_id": "a",
          "ja": "分かりました。後でこちらからかけ直します。",
          "vi": "Vâng, lát nữa tôi sẽ gọi lại."
        }
      ],
      "admin": {
        "source_refs": [
          "telephone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3ae5d262-a762-52dc-87fe-d8976a682eb6-u01": {
            "kind": "original_extension"
          },
