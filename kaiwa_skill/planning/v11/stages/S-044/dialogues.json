        }
      }
    },
    {
      "situation_uid": "2cfd0d46-86d6-5921-bec5-7efa156cfc08",
      "event_id": "E01",
      "context_vi": "Tanaka ở phòng tổng vụ kiểm tra và xác nhận anh phụ trách cuộc họp thứ Sáu. Bạn hỏi anh giờ bắt đầu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người nhận máy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2cfd0d46-86d6-5921-bec5-7efa156cfc08-u04",
          "speaker_id": "b",
          "ja": "金曜日の会議は私が担当しています。",
          "vi": "Tôi phụ trách cuộc họp thứ Sáu."
        },
        {
          "id": "2cfd0d46-86d6-5921-bec5-7efa156cfc08-u01",
          "speaker_id": "a",
          "ja": "金曜日の会議は何時からですか。",
          "vi": "Cuộc họp thứ Sáu bắt đầu lúc mấy giờ ạ?"
        },
        {
          "id": "2cfd0d46-86d6-5921-bec5-7efa156cfc08-u02",
          "speaker_id": "b",
          "ja": "午後二時からです。",
          "vi": "Từ 2 giờ chiều."
        },
        {
          "id": "2cfd0d46-86d6-5921-bec5-7efa156cfc08-u03",
          "speaker_id": "a",
          "ja": "金曜日の午後二時ですね。",
          "vi": "Vậy là 2 giờ chiều thứ Sáu, đúng không ạ?"
        }
      ],
      "admin": {
        "source_refs": [
          "telephone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "2cfd0d46-86d6-5921-bec5-7efa156cfc08-u01": {
            "kind": "original_extension"
