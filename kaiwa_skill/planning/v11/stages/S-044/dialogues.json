          }
        }
      }
    },
    {
      "situation_uid": "856fdd29-c851-5c75-94ce-05c196612c86",
      "event_id": "E01",
      "context_vi": "Tanaka ở phòng tổng vụ kiểm tra và cho biết cuộc họp thứ Sáu do phòng kế hoạch phụ trách. Bạn ở phòng kinh doanh cần số máy để gọi đúng người.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người nhận máy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "856fdd29-c851-5c75-94ce-05c196612c86-u01",
          "speaker_id": "b",
          "ja": "金曜日の会議は企画部が担当です。",
          "vi": "Cuộc họp thứ Sáu do phòng kế hoạch phụ trách."
        },
        {
          "id": "856fdd29-c851-5c75-94ce-05c196612c86-u02",
          "speaker_id": "a",
          "ja": "すみません。企画部の内線番号を教えてください。",
          "vi": "Xin lỗi. Cho tôi xin số máy nội bộ của phòng kế hoạch được không?"
        },
        {
          "id": "856fdd29-c851-5c75-94ce-05c196612c86-u03",
          "speaker_id": "b",
          "ja": "三二一です。",
          "vi": "Số 321."
        }
      ],
      "admin": {
        "source_refs": [
          "telephone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "856fdd29-c851-5c75-94ce-05c196612c86-u01": {
            "kind": "original_extension"
          },
          "856fdd29-c851-5c75-94ce-05c196612c86-u02": {
            "kind": "original_extension"
          },
          "856fdd29-c851-5c75-94ce-05c196612c86-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "357c8af6-3125-5891-a669-4cb710da4571",
      "event_id": "E01",
      "context_vi": "Sau cuộc gọi xác nhận cuộc họp thứ Sáu lúc 2 giờ, bạn thấy ghi chú của mình thành 3 giờ. Bạn gọi lại người phụ trách để sửa ghi chú.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người nhận máy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "357c8af6-3125-5891-a669-4cb710da4571-u01",
          "speaker_id": "a",
          "ja": "すみません。金曜日の会議は三時でしたか。",
          "vi": "Xin lỗi. Cuộc họp thứ Sáu là lúc 3 giờ phải không ạ?"
        },
        {
          "id": "357c8af6-3125-5891-a669-4cb710da4571-u02",
          "speaker_id": "b",
          "ja": "いいえ、午後二時です。",
          "vi": "Không, lúc 2 giờ chiều."
        },
        {
          "id": "357c8af6-3125-5891-a669-4cb710da4571-u03",
          "speaker_id": "a",
          "ja": "金曜日の午後二時ですね。分かりました。",
          "vi": "Thứ Sáu lúc 2 giờ chiều. Tôi đã rõ."
        }
      ],
      "admin": {
        "source_refs": [
          "telephone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "357c8af6-3125-5891-a669-4cb710da4571-u01": {
            "kind": "original_extension"
          },
          "357c8af6-3125-5891-a669-4cb710da4571-u02": {
            "kind": "original_extension"
          },
          "357c8af6-3125-5891-a669-4cb710da4571-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7120124f-727c-52de-b190-c3b9e0f27a83",
      "event_id": "E02",
      "context_vi": "Bạn gọi chị Sato về tài liệu, nhưng đồng nghiệp của chị ấy nghe máy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người nhận máy thay",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7120124f-727c-52de-b190-c3b9e0f27a83-u01",
          "speaker_id": "a",
          "ja": "営業のリンです。佐藤さんに、資料のことで電話があったと伝えてもらえますか。",
          "vi": "Tôi là Linh bên kinh doanh. Anh nhắn giúp chị Sato là tôi có gọi về tài liệu được không ạ?"
        },
        {
          "id": "7120124f-727c-52de-b190-c3b9e0f27a83-u02",
          "speaker_id": "b",
          "ja": "分かりました。佐藤さんに伝えます。",
          "vi": "Được, tôi sẽ báo chị Sato."
        }
      ],
      "admin": {
        "source_refs": [
          "telephone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7120124f-727c-52de-b190-c3b9e0f27a83-u01": {
            "kind": "original_extension"
          },
          "7120124f-727c-52de-b190-c3b9e0f27a83-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "c386d8d9-46f3-5296-b9b7-836b274d9ffd",
      "event_id": "E02",
      "context_vi": "Linh đã nhờ đồng nghiệp báo cho chị Sato về tài liệu. Đồng nghiệp chưa biết khi nào Sato quay lại bàn; Linh để giờ và số máy nội bộ để nhận cuộc gọi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người nhận máy thay",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c386d8d9-46f3-5296-b9b7-836b274d9ffd-u01",
          "speaker_id": "b",
          "ja": "佐藤さんがいつ戻るか、まだ分かりません。",
          "vi": "Tôi chưa biết khi nào chị Sato quay lại bàn."
        },
        {
          "id": "c386d8d9-46f3-5296-b9b7-836b274d9ffd-u02",
          "speaker_id": "a",
          "ja": "では、三時から席にいます。佐藤さんに、内線三二一に電話をお願いしますと伝えてもらえますか。",
          "vi": "Vậy từ 3 giờ tôi sẽ có mặt ở bàn. Anh nhắn chị Sato gọi lại giúp tôi qua số máy nội bộ 321 được không ạ?"
        },
        {
          "id": "c386d8d9-46f3-5296-b9b7-836b274d9ffd-u03",
          "speaker_id": "b",
          "ja": "三時から、内線三二一ですね。伝えます。",
          "vi": "Từ 3 giờ, số nội bộ 321. Tôi sẽ chuyển lời."
        }
      ],
      "admin": {
        "source_refs": [
          "telephone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c386d8d9-46f3-5296-b9b7-836b274d9ffd-u01": {
            "kind": "original_extension"
          },
          "c386d8d9-46f3-5296-b9b7-836b274d9ffd-u02": {
            "kind": "original_extension"
          },
          "c386d8d9-46f3-5296-b9b7-836b274d9ffd-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "15c1d1d2-c4aa-58b2-b0f7-bb1c288fbb00",
      "event_id": "E02",
      "context_vi": "Sau 3 giờ, chị Sato gọi vào số máy nội bộ bạn đã nhắn. Bạn hỏi hôm nay đã xem được tài liệu mới chưa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "chị Sato",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "15c1d1d2-c4aa-58b2-b0f7-bb1c288fbb00-u01",
          "speaker_id": "b",
          "ja": "佐藤です。資料のことで電話をくれましたか。",
          "vi": "Tôi là Sato đây. Bạn gọi tôi về tài liệu phải không?"
        },
        {
          "id": "15c1d1d2-c4aa-58b2-b0f7-bb1c288fbb00-u02",
          "speaker_id": "a",
          "ja": "はい。新しい資料は今日中に見られますか。",
          "vi": "Vâng. Tôi có thể xem tài liệu mới trong hôm nay được không ạ?"
        },
        {
          "id": "15c1d1d2-c4aa-58b2-b0f7-bb1c288fbb00-u03",
          "speaker_id": "b",
          "ja": "はい。今、共有します。",
          "vi": "Được. Tôi sẽ chia sẻ ngay."
        }
      ],
      "admin": {
        "source_refs": [
          "telephone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "15c1d1d2-c4aa-58b2-b0f7-bb1c288fbb00-u01": {
            "kind": "original_extension"
          },
