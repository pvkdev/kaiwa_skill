    {
      "situation_uid": "44f85ca0-dc27-57b2-a182-f140f7746d9c",
      "event_id": "E03",
      "context_vi": "Sau khi báo chưa liên lạc được với mẹ, bạn vừa nhận được cuộc gọi từ bà. Bạn cập nhật ngay với bàn hỗ trợ.",
      "speakers": [
