    {
      "situation_uid": "27a5bbc6-5838-5113-9a45-206fada4f963",
      "event_id": "E04",
      "context_vi": "Bạn đã báo kế hoạch chuyển nơi nhưng xe đưa đón chưa tới. Bạn nhờ giữ thông tin rằng cả nhóm vẫn chờ ở đây.",
