        }
      }
    },
    {
      "situation_uid": "e121b96f-acf8-52b8-b496-8d7d2e5d1988",
      "event_id": "E03",
      "context_vi": "Bạn đến điểm sơ tán một mình, chưa liên lạc được với mẹ. Bạn nêu nơi và lúc cuối cùng gặp bà cho người phụ trách.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e121b96f-acf8-52b8-b496-8d7d2e5d1988-u01",
          "speaker_id": "a",
          "ja": "母とまだ連絡が取れません。今日の朝、さくら町の家で最後に会いました。",
          "vi": "Tôi vẫn chưa liên lạc được với mẹ. Sáng nay tôi gặp mẹ lần cuối ở nhà tại khu Sakura."
        },
        {
          "id": "e121b96f-acf8-52b8-b496-8d7d2e5d1988-u02",
          "speaker_id": "b",
          "ja": "お母様のお名前を教えてください。担当に伝えます。",
          "vi": "Cho tôi xin tên mẹ chị. Tôi sẽ báo người phụ trách ạ."
        },
        {
          "id": "e121b96f-acf8-52b8-b496-8d7d2e5d1988-u03",
          "speaker_id": "a",
          "ja": "グエン・マイです。",
          "vi": "Mẹ tôi tên Nguyễn Mai."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "cabinet"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e121b96f-acf8-52b8-b496-8d7d2e5d1988-u01": {
