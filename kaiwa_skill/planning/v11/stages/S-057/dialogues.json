    {
      "situation_uid": "f59b74ab-7676-5c74-9e26-1b29877be288",
      "event_id": "E04",
      "context_vi": "Trước khi rời điểm sơ tán, bạn đã nhận lại túi đồ gửi ở bàn tiếp nhận. Bạn hỏi sau khi đi còn có thể liên hệ nơi này qua đâu.",
      "speakers": [
