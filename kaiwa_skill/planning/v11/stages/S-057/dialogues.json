    },
    {
      "situation_uid": "f5ee27c1-39f1-54bf-9ceb-c2021e815a6e",
      "event_id": "E03",
      "context_vi": "Người phụ trách báo có người cùng tên Nguyễn Mai đến một điểm khác. Bạn hỏi cách xác nhận trước khi đi tìm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f5ee27c1-39f1-54bf-9ceb-c2021e815a6e-u01",
          "speaker_id": "b",
          "ja": "別の場所に、同じ名前の方がいます。",
          "vi": "Có một người cùng tên ở điểm khác ạ."
        },
        {
          "id": "f5ee27c1-39f1-54bf-9ceb-c2021e815a6e-u02",
          "speaker_id": "a",
          "ja": "母かどうか、どう確認できますか。",
          "vi": "Làm sao xác nhận có phải mẹ tôi không ạ?"
        },
        {
          "id": "f5ee27c1-39f1-54bf-9ceb-c2021e815a6e-u03",
          "speaker_id": "b",
          "ja": "こちらの担当から先方に連絡して、情報を照合します。確認できてからお伝えします。",
