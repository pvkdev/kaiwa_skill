    {
      "situation_uid": "f5ee27c1-39f1-54bf-9ceb-c2021e815a6e",
      "event_id": "E03",
      "context_vi": "Người phụ trách báo có người cùng tên Nguyễn Mai đến một điểm khác. Bạn hỏi cách xác nhận trước khi đi tìm.",
      "speakers": [
