      "path": "kaiwa_skill/knowledge/すぐに使える 接客日本語会話大特訓［英語版］決まり文句700/chapters/09-ch8-kinkyu.md",
      "start_line": 103,
      "end_line": 143,
      "use_vi": "Lời hỏi chỗ sơ tán, chỉ dẫn và xác nhận thông tin nơi tập trung."
    },
    "cabinet": {
      "kind": "web",
      "title": "内閣府 避難所運営ガイドライン",
      "url": "https://www.bousai.go.jp/taisaku/hinanjo/pdf/1604hinanjo_guideline.pdf",
      "accessed": "2026-11-17",
      "use_vi": "Vận hành điểm sơ tán, tiếp nhận và hỗ trợ nhu cầu người cần quan tâm; chi tiết vị trí trong cảnh là hư cấu."
    }
  },
  "dialogues": [
    {
      "situation_uid": "e9efb752-8d67-5c69-9131-04127ecf134e",
      "event_id": "E01",
      "context_vi": "Mưa lớn khiến bạn đến điểm sơ tán ghi trên bản đồ thành phố. Bạn hỏi nơi này có nhận cư dân khu Sakura không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e9efb752-8d67-5c69-9131-04127ecf134e-u01",
          "speaker_id": "a",
          "ja": "さくら町から来ました。ここで受け付けてもらえますか。",
          "vi": "Tôi đến từ khu Sakura. Ở đây có tiếp nhận người từ khu đó không ạ?"
        },
        {
          "id": "e9efb752-8d67-5c69-9131-04127ecf134e-u02",
          "speaker_id": "b",
          "ja": "はい、さくら町の方も対象です。今の空きを確認します。満員なら、きた小学校をご案内します。",
          "vi": "Có, người khu Sakura thuộc diện được tiếp nhận. Tôi sẽ kiểm tra chỗ trống lúc này. Nếu đã đầy, tôi sẽ chỉ bạn tới Trường Tiểu học Kita."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e9efb752-8d67-5c69-9131-04127ecf134e-u01": {
            "kind": "original_extension"
          },
          "e9efb752-8d67-5c69-9131-04127ecf134e-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7de57272-adca-5835-a04e-7c3fcbfe4904",
      "event_id": "E01",
      "context_vi": "Bạn đi cùng một trẻ nhỏ và một người lớn tuổi. Ở bàn tiếp nhận, bạn hỏi khu nào phù hợp cho cả nhóm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7de57272-adca-5835-a04e-7c3fcbfe4904-u01",
          "speaker_id": "a",
          "ja": "子どもと年を取った家族と一緒です。どこで休めますか。",
          "vi": "Tôi đi cùng trẻ nhỏ và một người lớn tuổi trong nhà. Chúng tôi có thể nghỉ ở đâu ạ?"
        },
        {
          "id": "7de57272-adca-5835-a04e-7c3fcbfe4904-u02",
          "speaker_id": "b",
          "ja": "奥に家族用の場所があります。まず人数を確認します。",
          "vi": "Phía trong có khu dành cho gia đình. Trước tiên tôi sẽ ghi số người."
        },
        {
          "id": "7de57272-adca-5835-a04e-7c3fcbfe4904-u03",
          "speaker_id": "a",
          "ja": "三人です。",
          "vi": "Chúng tôi có ba người."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7de57272-adca-5835-a04e-7c3fcbfe4904-u01": {
            "kind": "original_extension"
          },
