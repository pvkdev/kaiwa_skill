    {
      "situation_uid": "9569504e-e2cd-517a-aea3-c49cf8298f81",
      "event_id": "E04",
      "context_vi": "Bạn dự định chuyển sang điểm sơ tán khác cùng gia đình. Bạn hỏi bàn tiếp nhận cần báo những gì trước khi đi.",
