      ],
      "turns": [
        {
          "id": "44f85ca0-dc27-57b2-a182-f140f7746d9c-u01",
          "speaker_id": "a",
          "ja": "母と連絡が取れました。今は北小学校にいて、無事だそうです。",
          "vi": "Tôi đã liên lạc được với mẹ. Mẹ nói đang ở Trường Tiểu học Kita và an toàn."
        },
        {
          "id": "44f85ca0-dc27-57b2-a182-f140f7746d9c-u02",
          "speaker_id": "b",
          "ja": "よかったです。お母様と連絡が取れたと、記録を更新しておきます。",
          "vi": "May quá. Tôi sẽ cập nhật là chị đã liên lạc được với mẹ ạ."
        }
