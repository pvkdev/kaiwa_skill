        }
      }
    },
    {
      "situation_uid": "e5f6c697-c08b-50b3-a3f2-beceac58f060",
      "event_id": "E02",
      "context_vi": "Sau khi nghe nơi ngủ, nước và bảng thông báo, bạn nhắc lại việc mình cần làm để khỏi đi nhầm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách khu",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e5f6c697-c08b-50b3-a3f2-beceac58f060-u01",
          "speaker_id": "a",
          "ja": "寝る場所は二階、水は入口の横ですね。お知らせは一階の掲示板を見ます。",
          "vi": "Chỗ nghỉ ở tầng hai, nước cạnh cửa vào. Tôi xem bảng thông báo ở tầng một, đúng không ạ?"
        },
        {
          "id": "e5f6c697-c08b-50b3-a3f2-beceac58f060-u02",
          "speaker_id": "b",
          "ja": "はい。場所が分からなければ受付で聞いてください。",
          "vi": "Đúng. Nếu không tìm thấy, bạn hỏi bàn tiếp nhận nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "cabinet"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e5f6c697-c08b-50b3-a3f2-beceac58f060-u01": {
            "kind": "original_extension"
          },
          "e5f6c697-c08b-50b3-a3f2-beceac58f060-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "e121b96f-acf8-52b8-b496-8d7d2e5d1988",
      "event_id": "E03",
      "context_vi": "Bạn đến điểm sơ tán một mình, chưa liên lạc được với mẹ. Bạn nêu nơi và lúc cuối cùng gặp bà cho người phụ trách.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e121b96f-acf8-52b8-b496-8d7d2e5d1988-u01",
          "speaker_id": "a",
          "ja": "母とまだ連絡が取れません。今日の朝、さくら町の家で最後に会いました。",
          "vi": "Tôi vẫn chưa liên lạc được với mẹ. Sáng nay tôi gặp mẹ lần cuối ở nhà tại khu Sakura."
        },
        {
          "id": "e121b96f-acf8-52b8-b496-8d7d2e5d1988-u02",
          "speaker_id": "b",
          "ja": "お名前を教えてください。確認する係に伝えます。",
          "vi": "Cho tôi xin tên của bà. Tôi sẽ báo người phụ trách tìm kiếm."
        },
        {
          "id": "e121b96f-acf8-52b8-b496-8d7d2e5d1988-u03",
          "speaker_id": "a",
          "ja": "グエン・マイです。",
          "vi": "Mẹ tôi tên Nguyễn Mai."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "cabinet"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e121b96f-acf8-52b8-b496-8d7d2e5d1988-u01": {
            "kind": "original_extension"
