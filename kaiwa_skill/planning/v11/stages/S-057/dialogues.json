            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0de67a02-97fe-5f16-8ada-6ee65d986423",
      "event_id": "E01",
      "context_vi": "Bàn tiếp nhận cho biết điểm này tạm chưa nhận thêm người từ khu Sakura. Bạn hỏi địa điểm kế tiếp và đường đi an toàn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0de67a02-97fe-5f16-8ada-6ee65d986423-u01",
          "speaker_id": "b",
          "ja": "今、こちらは新しい方を受け付けられません。",
          "vi": "Hiện nơi này chưa nhận thêm người mới được ạ."
        },
        {
          "id": "0de67a02-97fe-5f16-8ada-6ee65d986423-u02",
          "speaker_id": "a",
          "ja": "次はどこへ行けばいいですか。安全な道も教えてください。",
          "vi": "Tôi nên đến nơi nào tiếp theo? Xin chỉ cả đường đi an toàn ạ."
        },
        {
          "id": "0de67a02-97fe-5f16-8ada-6ee65d986423-u03",
          "speaker_id": "b",
          "ja": "市の案内では、北小学校です。道の状況を係に確認してから案内します。",
          "vi": "Theo thông báo của thành phố, là Trường Tiểu học Kita. Tôi sẽ hỏi người phụ trách tình trạng đường rồi chỉ bạn."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "cabinet"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0de67a02-97fe-5f16-8ada-6ee65d986423-u01": {
            "kind": "original_extension"
          },
