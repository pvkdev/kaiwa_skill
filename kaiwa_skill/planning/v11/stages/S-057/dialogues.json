    {
      "situation_uid": "57af70e7-eace-51ad-b1bc-b86606f70425",
      "event_id": "E03",
      "context_vi": "Bạn vẫn chưa liên lạc được với mẹ và điện thoại không có sóng. Bạn hỏi cách để lại nơi và đầu mối liên hệ cho bà.",
