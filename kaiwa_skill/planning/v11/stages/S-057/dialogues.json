          "0de67a02-97fe-5f16-8ada-6ee65d986423-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "dd6b9a0f-4eee-5e7a-be57-15e2bf8731e8",
      "event_id": "E01",
      "context_vi": "Nhân viên vừa nhắc Trường Tiểu học Kita là địa điểm kế tiếp nếu nơi này đầy, nhưng bạn chưa nghe rõ tên. Bạn xin nói lại chậm và chỉ trên bản đồ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "dd6b9a0f-4eee-5e7a-be57-15e2bf8731e8-u01",
          "speaker_id": "a",
          "ja": "名前をもう一度、ゆっくりお願いします。地図でも教えてください。",
          "vi": "Xin nhắc lại tên nơi đó chậm giúp tôi, và chỉ trên bản đồ ạ."
        },
        {
          "id": "dd6b9a0f-4eee-5e7a-be57-15e2bf8731e8-u02",
          "speaker_id": "b",
          "ja": "きた小学校です。地図のここです。",
          "vi": "Trường Tiểu học Kita. Trên bản đồ là chỗ này."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "cabinet"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "dd6b9a0f-4eee-5e7a-be57-15e2bf8731e8-u01": {
            "kind": "original_extension"
          },
          "dd6b9a0f-4eee-5e7a-be57-15e2bf8731e8-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3e9b45c5-044f-5b14-b367-75bce5307c16",
      "event_id": "E02",
      "context_vi": "Bạn vừa đăng ký vào điểm sơ tán. Bạn muốn biết chỗ ngủ, nơi lấy nước và cách nghe thông báo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách khu",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3e9b45c5-044f-5b14-b367-75bce5307c16-u01",
          "speaker_id": "a",
          "ja": "寝る場所と水をもらう場所はどこですか。お知らせは、どうやって分かりますか。",
          "vi": "Chỗ ngủ và nơi lấy nước ở đâu ạ? Tôi xem thông báo bằng cách nào?"
        },
        {
          "id": "3e9b45c5-044f-5b14-b367-75bce5307c16-u02",
          "speaker_id": "b",
          "ja": "寝る場所は二階、水は入口の横です。お知らせは一階の掲示板に出します。",
          "vi": "Chỗ nghỉ ở tầng hai, nước ở cạnh lối vào. Thông báo dán ở bảng tầng một."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "cabinet"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3e9b45c5-044f-5b14-b367-75bce5307c16-u01": {
            "kind": "original_extension"
          },
          "3e9b45c5-044f-5b14-b367-75bce5307c16-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "80d42b85-eac5-543b-a42b-49c8156126b3",
      "event_id": "E02",
      "context_vi": "Con bạn cần tã. Thuốc thường dùng của bà đi cùng cũng sắp hết. Bạn hỏi phải gặp ai ở điểm sơ tán.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách khu",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "80d42b85-eac5-543b-a42b-49c8156126b3-u01",
          "speaker_id": "a",
          "ja": "子どものおむつが必要です。それと、祖母の薬がもうすぐなくなります。どこで相談できますか。",
          "vi": "Tôi cần tã cho con. Thuốc bà tôi đang uống cũng sắp hết. Tôi có thể hỏi ở đâu ạ?"
        },
        {
          "id": "80d42b85-eac5-543b-a42b-49c8156126b3-u02",
          "speaker_id": "b",
          "ja": "おむつは入口の相談係に聞いてください。薬のことは医療スタッフにつなぎます。薬の名前が分かれば伝えてください。",
          "vi": "Về tã, chị hỏi bàn hỗ trợ ở lối vào nhé. Về thuốc, tôi sẽ giới thiệu nhân viên y tế. Nếu biết tên thuốc, chị nói với họ ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "cabinet",
          "medication"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "80d42b85-eac5-543b-a42b-49c8156126b3-u01": {
            "kind": "original_extension"
          },
          "80d42b85-eac5-543b-a42b-49c8156126b3-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0e425f6e-a7bc-55a6-aebc-a4f58acc4277",
      "event_id": "E02",
      "context_vi": "Ở bàn hỗ trợ lối vào, nhân viên nói cỡ tã con bạn cần hiện đã hết. Bạn hỏi khi nào và ở đâu có thể hỏi lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách khu",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0e425f6e-a7bc-55a6-aebc-a4f58acc4277-u01",
          "speaker_id": "b",
          "ja": "そのサイズのおむつは、今はありません。",
          "vi": "Hiện chưa có tã cỡ đó ạ."
        },
        {
          "id": "0e425f6e-a7bc-55a6-aebc-a4f58acc4277-u02",
          "speaker_id": "a",
          "ja": "いつ、どこでまた聞けますか。",
          "vi": "Khi nào và ở đâu tôi có thể hỏi lại ạ?"
        },
        {
          "id": "0e425f6e-a7bc-55a6-aebc-a4f58acc4277-u03",
          "speaker_id": "b",
          "ja": "午後三時にこの相談係へ来てください。届いたかどうか、お伝えします。",
          "vi": "Chị quay lại bàn hỗ trợ này lúc 3 giờ chiều nhé. Tôi sẽ báo tã đã về chưa ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "cabinet"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0e425f6e-a7bc-55a6-aebc-a4f58acc4277-u01": {
            "kind": "original_extension"
