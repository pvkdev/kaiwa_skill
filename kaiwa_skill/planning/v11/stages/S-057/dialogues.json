          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách khu",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f59b74ab-7676-5c74-9e26-1b29877be288-u01",
