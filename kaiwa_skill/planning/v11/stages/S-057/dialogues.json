  "dialogues": [
    {
      "situation_uid": "e9efb752-8d67-5c69-9131-04127ecf134e",
      "event_id": "E01",
      "context_vi": "Mưa lớn khiến bạn đến điểm sơ tán ghi trên bản đồ thành phố. Bạn hỏi nơi này có nhận cư dân khu Sakura không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e9efb752-8d67-5c69-9131-04127ecf134e-u01",
          "speaker_id": "a",
          "ja": "さくら町から来ました。ここに避難してもいいですか。",
          "vi": "Tôi từ khu Sakura tới. Tôi có thể sơ tán ở đây không ạ?"
        },
        {
          "id": "e9efb752-8d67-5c69-9131-04127ecf134e-u02",
          "speaker_id": "b",
          "ja": "はい、さくら町の方も受け付けています。空きがあるか確認します。いっぱいなら、北小学校をご案内します。",
          "vi": "Có ạ, ở đây tiếp nhận cả người ở khu Sakura. Tôi sẽ kiểm còn chỗ không. Nếu hết chỗ, tôi sẽ hướng dẫn chị tới Trường Tiểu học Kita."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "cabinet"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e9efb752-8d67-5c69-9131-04127ecf134e-u01": {
            "kind": "original_extension"
          },
          "e9efb752-8d67-5c69-9131-04127ecf134e-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7de57272-adca-5835-a04e-7c3fcbfe4904",
      "event_id": "E01",
      "context_vi": "Bạn đi cùng một trẻ nhỏ và một người lớn tuổi. Ở bàn tiếp nhận, bạn hỏi khu nào phù hợp cho cả nhóm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7de57272-adca-5835-a04e-7c3fcbfe4904-u01",
          "speaker_id": "a",
          "ja": "小さい子どもと祖母と一緒です。三人で休める場所はありますか。",
          "vi": "Tôi đi cùng con nhỏ và bà tôi. Có chỗ nào cho cả ba người nghỉ không ạ?"
        },
        {
          "id": "7de57272-adca-5835-a04e-7c3fcbfe4904-u02",
          "speaker_id": "b",
          "ja": "奥に家族で休める場所があります。三人でよろしいですか。",
          "vi": "Phía trong có chỗ để gia đình nghỉ cùng nhau. Tổng cộng ba người, đúng không ạ?"
        },
        {
          "id": "7de57272-adca-5835-a04e-7c3fcbfe4904-u03",
          "speaker_id": "a",
          "ja": "はい、私を入れて三人です。",
          "vi": "Vâng, tính cả tôi là ba người ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "cabinet"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7de57272-adca-5835-a04e-7c3fcbfe4904-u01": {
            "kind": "original_extension"
