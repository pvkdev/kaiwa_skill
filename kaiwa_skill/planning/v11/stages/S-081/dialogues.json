          },
          "a69c0c66-6b96-5407-8b5f-7e9333fff3a6-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "1007a149-619c-5ef0-aac9-af0505e033e9",
      "event_id": "E01",
      "context_vi": "Điện thoại của bạn cũng ở trong túi bị giật. Bạn đang ở trong cửa hàng an toàn và xin chờ tại quầy để người hỗ trợ tìm được mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1007a149-619c-5ef0-aac9-af0505e033e9-u01",
          "speaker_id": "a",
          "ja": "スマホもかばんに入っていました。レジのそばで待っていいですか。警察に場所を伝えてください。",
          "vi": "Điện thoại cũng ở trong túi. Tôi đợi cạnh quầy tính tiền được không ạ? Anh báo chỗ đó cho cảnh sát giúp tôi."
        },
        {
          "id": "1007a149-619c-5ef0-aac9-af0505e033e9-u02",
          "speaker_id": "b",
          "ja": "はい。さくら商店のレジのそばだと伝えます。",
          "vi": "Được ạ. Tôi sẽ báo chị đang ở cạnh quầy tính tiền cửa hàng Sakura."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa",
          "dispatch"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1007a149-619c-5ef0-aac9-af0505e033e9-u01": {
            "kind": "original_extension"
          },
          "1007a149-619c-5ef0-aac9-af0505e033e9-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "469b79cd-270e-5a27-a609-ddefdfc78adc",
      "event_id": "E02",
      "context_vi": "Bạn đã tránh xa người vừa chặn đường lấy ví. Bạn hỏi một người qua đường có thể đứng cùng trong lúc gọi 110 không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người qua đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "469b79cd-270e-5a27-a609-ddefdfc78adc-u01",
          "speaker_id": "a",
          "ja": "さっき道をふさがれて、財布を取られました。警察に電話するので、そばにいてもらえますか。",
          "vi": "Vừa rồi tôi bị chặn đường rồi bị lấy ví. Tôi sẽ gọi cảnh sát. Anh đứng cạnh tôi một lát được không ạ?"
        },
        {
          "id": "469b79cd-270e-5a27-a609-ddefdfc78adc-u02",
          "speaker_id": "b",
          "ja": "はい。ここで一緒にいます。",
          "vi": "Được, tôi sẽ đứng cùng bạn ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "469b79cd-270e-5a27-a609-ddefdfc78adc-u01": {
            "kind": "original_extension"
          },
          "469b79cd-270e-5a27-a609-ddefdfc78adc-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0ba918c4-3cf6-5cb1-b507-87368c9215ac",
      "event_id": "E02",
      "context_vi": "Người qua đường hỏi người lấy ví còn ở gần không. Bạn chỉ thấy họ rẽ ở góc đường rồi mất dấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người qua đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0ba918c4-3cf6-5cb1-b507-87368c9215ac-u01",
          "speaker_id": "b",
          "ja": "取った人はまだ近くにいますか。",
          "vi": "Người lấy ví còn gần đây không ạ?"
        },
        {
          "id": "0ba918c4-3cf6-5cb1-b507-87368c9215ac-u02",
          "speaker_id": "a",
          "ja": "まだ近くにいるかは分かりません。角を曲がるところまで見ました。",
          "vi": "Tôi không biết họ còn gần đây không. Tôi chỉ thấy đến lúc họ rẽ ở góc đường ạ."
        },
        {
          "id": "0ba918c4-3cf6-5cb1-b507-87368c9215ac-u03",
          "speaker_id": "b",
          "ja": "分かりました。見えた所まで伝えましょう。",
          "vi": "Tôi hiểu. Ta báo đúng những gì chị nhìn thấy nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0ba918c4-3cf6-5cb1-b507-87368c9215ac-u01": {
