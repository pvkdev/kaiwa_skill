      }
    },
    {
      "situation_uid": "8e5da5ad-0821-52a4-aada-417d56dbcee2",
      "event_id": "E03",
      "context_vi": "Bạn không thấy xe đạp ở bãi. Bạn nhớ rõ dãy và ô đã khóa xe buổi sáng, hỏi nhân viên bãi có chuyển xe không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8e5da5ad-0821-52a4-aada-417d56dbcee2-u01",
          "speaker_id": "a",
          "ja": "今朝、二番の列の五番に自転車を止めて、鍵をかけました。この自転車を別の場所に移しましたか。",
          "vi": "Sáng nay tôi đỗ và khóa xe ở ô số 5 dãy 2. Bên mình có chuyển chiếc xe đó sang chỗ khác không ạ?"
        },
        {
          "id": "8e5da5ad-0821-52a4-aada-417d56dbcee2-u02",
          "speaker_id": "b",
          "ja": "今日は移していません。その場所を一緒に確認します。",
          "vi": "Hôm nay chúng tôi không chuyển. Tôi sẽ cùng bạn kiểm tra chỗ ấy."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8e5da5ad-0821-52a4-aada-417d56dbcee2-u01": {
            "kind": "original_extension"
          },
          "8e5da5ad-0821-52a4-aada-417d56dbcee2-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "81e2fcb0-3e94-5324-803d-d1f591a9be23",
      "event_id": "E03",
      "context_vi": "Nhân viên bãi xe hỏi bạn có thấy ai lấy xe không. Bạn chỉ thấy chiếc khóa rời cạnh chỗ đỗ và không suy đoán người lấy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "81e2fcb0-3e94-5324-803d-d1f591a9be23-u01",
          "speaker_id": "b",
          "ja": "自転車を持って行く人を見ましたか。",
          "vi": "Bạn có thấy ai mang xe đi không ạ?"
        },
        {
          "id": "81e2fcb0-3e94-5324-803d-d1f591a9be23-u02",
          "speaker_id": "a",
          "ja": "いいえ、見ていません。止めた場所の横に鍵だけ落ちていました。",
          "vi": "Không, tôi không thấy. Tôi chỉ thấy khóa rơi cạnh chỗ đỗ."
        },
        {
          "id": "81e2fcb0-3e94-5324-803d-d1f591a9be23-u03",
          "speaker_id": "b",
          "ja": "見たことをそのまま記録します。",
          "vi": "Tôi sẽ ghi đúng điều bạn nhìn thấy."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
