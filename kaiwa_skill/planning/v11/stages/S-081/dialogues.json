    {
      "situation_uid": "802a224e-68db-504d-9608-586149f0b9df",
      "event_id": "E05",
      "context_vi": "Cảnh sát nhắc lại lời bạn thành hai người cùng giật túi. Bạn sửa rằng mình chỉ thấy một người kéo quai, người còn lại chỉ đứng gần.",
      "speakers": [
