    {
      "situation_uid": "5d3f766c-f61f-570e-8e38-b814e2618916",
      "event_id": "E04",
      "context_vi": "Xuống tàu bạn thấy ngăn túi mở và không thấy ví. Bạn báo nhân viên ga, nêu lần cuối còn cầm ví khi mua nước trước lúc lên tàu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5d3f766c-f61f-570e-8e38-b814e2618916-u01",
          "speaker_id": "a",
          "ja": "電車を降りたら、かばんのポケットが開いていて、財布がありませんでした。乗る前に水を買ったときはありました。",
          "vi": "Lúc xuống tàu, tôi thấy ngăn túi mở và ví không còn. Lúc mua nước trước khi lên tàu tôi vẫn còn ví ạ."
        },
        {
          "id": "5d3f766c-f61f-570e-8e38-b814e2618916-u02",
          "speaker_id": "b",
          "ja": "水を買ったのは、どの駅ですか。",
          "vi": "Chị mua nước ở ga nào ạ?"
        },
        {
          "id": "5d3f766c-f61f-570e-8e38-b814e2618916-u03",
          "speaker_id": "a",
          "ja": "あおい駅の売店です。",
          "vi": "Ở quầy bán hàng ga Aoi ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
