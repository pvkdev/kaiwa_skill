    {
      "situation_uid": "bcdc749a-d2ce-5028-b50c-ca0fb9bb2d8a",
      "event_id": "E04",
      "context_vi": "Một hành khách nói đã thấy ai đó mở túi bạn. Bạn xin người ấy trực tiếp kể với nhân viên ga phần họ tận mắt thấy.",
      "speakers": [
