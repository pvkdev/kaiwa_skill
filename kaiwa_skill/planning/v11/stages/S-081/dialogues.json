    {
      "situation_uid": "c35126d2-ca3f-5aa0-bc73-7c86c901eaa7",
      "event_id": "E05",
      "context_vi": "Một người chứng kiến nhớ thời gian khác bạn. Bạn giải thích mình chỉ nhớ đã rời cửa hàng gần 3 giờ, nên giờ xảy ra việc là ước chừng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát tiếp nhận",
          "gender": "male"
