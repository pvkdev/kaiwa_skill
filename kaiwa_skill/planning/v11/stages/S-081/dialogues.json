        }
      }
    },
    {
      "situation_uid": "acfe2fba-cd87-5eb9-8f76-0ed0bc1d404b",
      "event_id": "E02",
      "context_vi": "Khi bị lấy ví, bạn bị xô ngã, đầu gối đau. Bạn nhờ người cạnh mình báo cả việc bị thương khi gọi hỗ trợ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người qua đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "acfe2fba-cd87-5eb9-8f76-0ed0bc1d404b-u01",
          "speaker_id": "a",
          "ja": "押されて転びました。右のひざが痛いです。けがも110に伝えてください。",
          "vi": "Tôi bị xô ngã, đầu gối phải đau. Nhờ anh báo với 110 cả việc tôi bị thương."
        },
        {
          "id": "acfe2fba-cd87-5eb9-8f76-0ed0bc1d404b-u02",
          "speaker_id": "b",
          "ja": "分かりました。転んで、右のひざが痛いことも伝えます。",
          "vi": "Tôi hiểu. Tôi sẽ báo thêm là chị bị ngã và đau đầu gối phải."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa",
          "dispatch"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "acfe2fba-cd87-5eb9-8f76-0ed0bc1d404b-u01": {
