    {
      "situation_uid": "c630ac36-7c54-5d1f-af29-f55d68806055",
      "event_id": "E04",
      "context_vi": "Nhân viên ga đã tìm thấy và trả lại ví. Các thẻ vẫn còn nhưng không thấy tiền mặt. Bạn chỉ nhớ gần đúng số tiền đã để trong ví.",
