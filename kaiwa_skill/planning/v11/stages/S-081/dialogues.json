    {
      "situation_uid": "8eb55d48-60e6-5149-8c2c-b7aa20df5918",
      "event_id": "E03",
      "context_vi": "Bạn đã kiểm tra dãy được nhân viên chỉ nhưng vẫn chưa thấy xe. Bạn xin tên bãi và số ô để trình bày đúng khi báo cảnh sát.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8eb55d48-60e6-5149-8c2c-b7aa20df5918-u01",
          "speaker_id": "a",
          "ja": "そこにもありませんでした。この駐輪場の名前と、私の場所の番号を教えてください。",
          "vi": "Ở dãy đó cũng không có xe. Xin cho tôi tên bãi và số ô tôi đỗ để báo đúng ạ?"
        },
        {
          "id": "8eb55d48-60e6-5149-8c2c-b7aa20df5918-u02",
          "speaker_id": "b",
          "ja": "あおい駅北口駐輪場、二番の列の五番です。",
          "vi": "Bãi xe cửa bắc ga Aoi, ô 5 dãy 2 ạ."
        },
        {
          "id": "8eb55d48-60e6-5149-8c2c-b7aa20df5918-u03",
          "speaker_id": "a",
          "ja": "あおい駅北口駐輪場、二番の列の五番ですね。",
          "vi": "Bãi xe cửa bắc ga Aoi, ô số 5 dãy 2, đúng không ạ?"
        }
      ],
