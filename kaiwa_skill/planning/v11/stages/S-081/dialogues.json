          }
        }
      }
    },
    {
      "situation_uid": "a69c0c66-6b96-5407-8b5f-7e9333fff3a6",
      "event_id": "E01",
      "context_vi": "Nhân viên đang nói chuyện với 110 và hỏi hướng người giật túi đã chạy. Bạn chỉ biết họ chạy về phía cầu, nhìn từ sau lưng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a69c0c66-6b96-5407-8b5f-7e9333fff3a6-u01",
          "speaker_id": "b",
          "ja": "その人はどちらへ行きましたか。",
          "vi": "Người đó chạy về đâu ạ?"
        },
        {
          "id": "a69c0c66-6b96-5407-8b5f-7e9333fff3a6-u02",
          "speaker_id": "a",
          "ja": "橋の方へ走っていきました。後ろ姿しか見ていません。",
          "vi": "Người đó chạy về phía cầu. Tôi chỉ nhìn thấy họ từ phía sau ạ."
        },
        {
          "id": "a69c0c66-6b96-5407-8b5f-7e9333fff3a6-u03",
          "speaker_id": "b",
          "ja": "橋の方ですね。見たことだけ伝えます。",
          "vi": "Hướng cầu. Tôi sẽ báo đúng phần bạn nhìn thấy."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa",
          "dispatch"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a69c0c66-6b96-5407-8b5f-7e9333fff3a6-u01": {
            "kind": "original_extension"
          },
