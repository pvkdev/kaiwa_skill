  "dialogues": [
    {
      "situation_uid": "de5b453b-a26d-5e1f-a9bc-b041fa9985bb",
      "event_id": "E01",
      "context_vi": "Bạn vừa bị giật túi trước cửa hàng. Bạn đã lùi vào trong và nhờ nhân viên gọi cảnh sát ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "de5b453b-a26d-5e1f-a9bc-b041fa9985bb-u01",
          "speaker_id": "a",
          "ja": "今、この店の前でかばんをひったくられました。警察に電話してもらえますか。",
          "vi": "Tôi vừa bị giật túi ngay trước cửa hàng này. Anh gọi cảnh sát giúp tôi được không ạ?"
        },
        {
          "id": "de5b453b-a26d-5e1f-a9bc-b041fa9985bb-u02",
          "speaker_id": "b",
          "ja": "はい、今ここから百十番に電話します。",
          "vi": "Vâng, tôi sẽ gọi 110 từ đây ngay."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "de5b453b-a26d-5e1f-a9bc-b041fa9985bb-u01": {
            "kind": "original_extension"
          },
          "de5b453b-a26d-5e1f-a9bc-b041fa9985bb-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "c4abca50-fa55-5462-aad8-3995d3aaf9c3",
      "event_id": "E01",
      "context_vi": "Nhân viên nghĩ bạn để quên túi tại quầy. Bạn làm rõ một người đã kéo túi khỏi vai mình ở ngoài cửa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c4abca50-fa55-5462-aad8-3995d3aaf9c3-u01",
          "speaker_id": "b",
          "ja": "かばんを店に忘れましたか。",
          "vi": "Bạn để quên túi trong cửa hàng phải không ạ?"
        },
        {
          "id": "c4abca50-fa55-5462-aad8-3995d3aaf9c3-u02",
          "speaker_id": "a",
          "ja": "いいえ。外で肩にかけていたかばんを、急に引っ張られて取られました。",
          "vi": "Không ạ. Ở ngoài, tôi đang đeo túi trên vai thì có người bất ngờ giật lấy."
        },
        {
          "id": "c4abca50-fa55-5462-aad8-3995d3aaf9c3-u03",
          "speaker_id": "b",
          "ja": "分かりました。取られたと110に伝えます。",
          "vi": "Tôi hiểu. Tôi sẽ báo 110 rằng túi bị lấy."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c4abca50-fa55-5462-aad8-3995d3aaf9c3-u01": {
