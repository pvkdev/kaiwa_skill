    {
      "situation_uid": "a509e00a-f8b7-5d2a-86bf-6f045e7230c6",
      "event_id": "E04",
      "context_vi": "Một người bên cạnh đoán người đứng sát bạn trên tàu đã lấy ví. Bạn không tận mắt thấy nên sửa lời kể trước nhân viên ga.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a509e00a-f8b7-5d2a-86bf-6f045e7230c6-u01",
          "speaker_id": "b",
          "ja": "近くにいた人が取ったと聞きましたが、取るところを見ましたか。",
          "vi": "Tôi nghe có người nói người đứng gần đã lấy. Chị có tận mắt thấy lúc ví bị lấy không ạ?"
        },
        {
          "id": "a509e00a-f8b7-5d2a-86bf-6f045e7230c6-u02",
          "speaker_id": "a",
          "ja": "それは横にいた人の話です。私は、財布を取るところは見ていません。",
          "vi": "Đó là lời người đi cạnh tôi kể. Tôi không tận mắt thấy lúc ví bị lấy ạ."
        },
        {
          "id": "a509e00a-f8b7-5d2a-86bf-6f045e7230c6-u03",
          "speaker_id": "b",
          "ja": "分かりました。見ていないと記録します。",
          "vi": "Tôi hiểu. Tôi sẽ ghi rằng bạn không nhìn thấy."
        }
      ],
      "admin": {
