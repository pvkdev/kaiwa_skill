          }
        }
      }
    },
    {
      "situation_uid": "604c3a49-c4cb-5016-8023-9aa6b552e5b2",
      "event_id": "E02",
      "context_vi": "Một người chứng kiến định chạy theo kẻ lấy ví. Bạn xin họ ở lại nơi an toàn để kể điều tận mắt thấy cho cảnh sát.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người chứng kiến",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "604c3a49-c4cb-5016-8023-9aa6b552e5b2-u01",
          "speaker_id": "b",
          "ja": "私が追いかけましょうか。",
          "vi": "Để tôi đuổi theo nhé?"
        },
        {
          "id": "604c3a49-c4cb-5016-8023-9aa6b552e5b2-u02",
          "speaker_id": "a",
          "ja": "危ないので、ここにいてください。見たことを警察に話してもらえますか。",
          "vi": "Nguy hiểm ạ, xin anh ở lại đây. Anh kể với cảnh sát những gì anh thấy được không?"
        },
        {
          "id": "604c3a49-c4cb-5016-8023-9aa6b552e5b2-u03",
          "speaker_id": "b",
          "ja": "はい、ここで待ちます。",
          "vi": "Được, tôi sẽ đợi ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
