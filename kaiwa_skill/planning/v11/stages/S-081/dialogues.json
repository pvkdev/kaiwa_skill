    {
      "situation_uid": "41d48264-cfbd-5f3c-832d-1f81d42e3fcb",
      "event_id": "E03",
      "context_vi": "Có chiếc xe cùng màu ở dãy bên. Bạn hỏi được đối chiếu ghế trẻ em và vết xước trên xe trước khi nhận đó là xe mình.",
      "speakers": [
