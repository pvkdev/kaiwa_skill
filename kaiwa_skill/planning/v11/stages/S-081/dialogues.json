    {
      "situation_uid": "bd6acb9a-d8a5-5539-86c3-2dd11051c885",
      "event_id": "E05",
      "context_vi": "Về nhà sau khi trình báo túi bị giật trước cửa hàng, bạn nhớ thêm chìa khóa nằm trong túi. Bạn gọi lại đầu mối đã tiếp nhận.",
