  "dialogues": [
    {
      "situation_uid": "39974159-e183-5203-8726-b410d0a56e8b",
      "event_id": "E01",
      "context_vi": "Buổi sáng tại văn phòng hư cấu, bạn mới bắt đầu ca và gặp đồng nghiệp nam ở cửa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "39974159-e183-5203-8726-b410d0a56e8b-u01",
          "speaker_id": "a",
          "ja": "おはようございます。今日もよろしくお願いします。",
          "vi": "Chào buổi sáng. Hôm nay cũng mong anh giúp đỡ."
        },
        {
          "id": "39974159-e183-5203-8726-b410d0a56e8b-u02",
          "speaker_id": "b",
          "ja": "おはようございます。こちらこそ、よろしくお願いします。",
          "vi": "Chào buổi sáng. Tôi cũng mong được làm việc cùng chị."
        }
      ],
      "admin": {
        "source_refs": [
          "work"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "39974159-e183-5203-8726-b410d0a56e8b-u01": {
            "kind": "original_extension"
          },
          "39974159-e183-5203-8726-b410d0a56e8b-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "f314f38b-453a-548a-8bf8-9c94df098ad8",
      "event_id": "E01",
      "context_vi": "Hôm nay bạn đến văn phòng sớm hơn mọi ngày để chuẩn bị giấy tờ. Đồng nghiệp vừa tới hỏi thăm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f314f38b-453a-548a-8bf8-9c94df098ad8-u01",
          "speaker_id": "b",
          "ja": "今日は早いですね。",
          "vi": "Hôm nay chị đến sớm nhỉ."
        },
        {
          "id": "f314f38b-453a-548a-8bf8-9c94df098ad8-u02",
          "speaker_id": "a",
          "ja": "はい。朝の会議の資料を見たいので。",
          "vi": "Vâng, tôi muốn xem tài liệu cho cuộc họp sáng."
        },
        {
          "id": "f314f38b-453a-548a-8bf8-9c94df098ad8-u03",
          "speaker_id": "b",
          "ja": "そうですか。私もあとで見ます。",
          "vi": "Vậy à. Lát nữa tôi cũng xem."
        }
      ],
      "admin": {
        "source_refs": [
          "work"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f314f38b-453a-548a-8bf8-9c94df098ad8-u01": {
            "kind": "original_extension"
          },
          "f314f38b-453a-548a-8bf8-9c94df098ad8-u02": {
            "kind": "original_extension"
          },
          "f314f38b-453a-548a-8bf8-9c94df098ad8-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "544f4b0d-826b-5d92-b633-a608d6171f46",
      "event_id": "E01",
      "context_vi": "Cuối ngày ở văn phòng hư cấu, đồng nghiệp nam vẫn ở lại. Bạn ra về trước và anh ấy hứa gửi một lời nhắn về cuộc họp sáng mai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "544f4b0d-826b-5d92-b633-a608d6171f46-u01",
          "speaker_id": "a",
          "ja": "お先に失礼します。",
          "vi": "Tôi xin phép về trước."
        },
        {
          "id": "544f4b0d-826b-5d92-b633-a608d6171f46-u02",
          "speaker_id": "b",
          "ja": "お疲れさまでした。明日の会議のこと、あとでメッセージを送ります。",
          "vi": "Chị vất vả rồi. Lát nữa tôi sẽ nhắn về cuộc họp ngày mai."
        },
        {
          "id": "544f4b0d-826b-5d92-b633-a608d6171f46-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。帰ってから見ます。",
          "vi": "Cảm ơn anh. Về nhà tôi sẽ xem."
        }
      ],
      "admin": {
        "source_refs": [
          "greet"
        ],
        "specialty_item_ids": [
          "sj-so-04-b07-156"
        ],
        "turn_origins": {
          "544f4b0d-826b-5d92-b633-a608d6171f46-u01": {
            "kind": "original_extension"
          },
          "544f4b0d-826b-5d92-b633-a608d6171f46-u02": {
            "kind": "original_extension"
          },
          "544f4b0d-826b-5d92-b633-a608d6171f46-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "5d094ee3-edc0-54f7-ab6d-c84ae68964ed",
      "event_id": "E01",
      "context_vi": "Sáng hôm sau, bạn gặp lại đúng đồng nghiệp đã hứa nhắn khi bạn về trước. Bạn đã đọc tin nhắn về việc họp lúc 9 giờ và hồi đáp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5d094ee3-edc0-54f7-ab6d-c84ae68964ed-u01",
          "speaker_id": "a",
          "ja": "おはようございます。昨日のメッセージ、読みました。",
          "vi": "Chào buổi sáng. Tôi đã đọc tin nhắn hôm qua."
        },
        {
          "id": "5d094ee3-edc0-54f7-ab6d-c84ae68964ed-u02",
          "speaker_id": "b",
          "ja": "九時の会議、大丈夫ですか。",
          "vi": "Cuộc họp lúc 9 giờ, chị tham gia được chứ?"
        },
        {
          "id": "5d094ee3-edc0-54f7-ab6d-c84ae68964ed-u03",
          "speaker_id": "a",
          "ja": "はい。資料も持ってきました。",
          "vi": "Được. Tôi cũng mang tài liệu rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "work"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5d094ee3-edc0-54f7-ab6d-c84ae68964ed-u01": {
            "kind": "original_extension"
          },
          "5d094ee3-edc0-54f7-ab6d-c84ae68964ed-u02": {
            "kind": "original_extension"
          },
          "5d094ee3-edc0-54f7-ab6d-c84ae68964ed-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "4aa580d1-fde2-53a8-8e2a-2545ffb1b464",
      "event_id": "E01",
      "context_vi": "Đồng nghiệp nam đi công tác vài ngày vừa trở lại văn phòng. Bạn hỏi thăm ngắn, rồi để anh ấy vào làm việc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4aa580d1-fde2-53a8-8e2a-2545ffb1b464-u01",
          "speaker_id": "a",
          "ja": "お久しぶりです。出張はどうでしたか。",
          "vi": "Lâu rồi mới gặp. Chuyến công tác thế nào ạ?"
        },
        {
          "id": "4aa580d1-fde2-53a8-8e2a-2545ffb1b464-u02",
          "speaker_id": "b",
          "ja": "無事に終わりました。ありがとう。",
          "vi": "Xong xuôi cả rồi. Cảm ơn chị."
        },
        {
          "id": "4aa580d1-fde2-53a8-8e2a-2545ffb1b464-u03",
          "speaker_id": "a",
          "ja": "よかったです。またあとで。",
          "vi": "Tốt quá. Lát nữa gặp anh."
        }
      ],
      "admin": {
        "source_refs": [
          "again"
        ],
        "specialty_item_ids": [
          "sj-so-04-b07-177"
        ],
        "turn_origins": {
          "4aa580d1-fde2-53a8-8e2a-2545ffb1b464-u01": {
            "kind": "original_extension"
          },
          "4aa580d1-fde2-53a8-8e2a-2545ffb1b464-u02": {
            "kind": "original_extension"
          },
          "4aa580d1-fde2-53a8-8e2a-2545ffb1b464-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "fcddf811-93ae-5f27-a866-3196a1931f19",
      "event_id": "E02",
      "context_vi": "Ở hành lang công ty hư cấu, bạn gặp đồng nghiệp bộ phận khác đã nói chuyện một lần trong buổi hướng dẫn. Bạn nhớ anh ấy là Tanaka.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp bộ phận khác",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fcddf811-93ae-5f27-a866-3196a1931f19-u01",
          "speaker_id": "a",
          "ja": "田中さん、お疲れさまです。先日の説明会でお会いしましたね。",
          "vi": "Anh Tanaka, chào anh. Mình đã gặp ở buổi hướng dẫn hôm trước nhỉ."
        },
        {
          "id": "fcddf811-93ae-5f27-a866-3196a1931f19-u02",
          "speaker_id": "b",
          "ja": "ああ、はい。お疲れさまです。",
          "vi": "À, vâng. Chào chị."
        }
      ],
      "admin": {
        "source_refs": [
          "work"
        ],
        "specialty_item_ids": [
          "sj-so-04-b07-161"
        ],
        "turn_origins": {
          "fcddf811-93ae-5f27-a866-3196a1931f19-u01": {
            "kind": "original_extension"
          },
          "fcddf811-93ae-5f27-a866-3196a1931f19-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3223be87-1bc4-5711-93bc-3a62fbff3c48",
      "event_id": "E02",
      "context_vi": "Tiếp ngay cuộc gặp ở hành lang: người bạn vừa gọi là Tanaka nói tên mình là Tanabe. Bạn xin lỗi và hỏi lại để nhớ đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp bộ phận khác",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3223be87-1bc4-5711-93bc-3a62fbff3c48-u01",
          "speaker_id": "b",
          "ja": "すみません、田中ではなく田辺です。",
          "vi": "Xin lỗi, tôi là Tanabe, không phải Tanaka."
        },
        {
          "id": "3223be87-1bc4-5711-93bc-3a62fbff3c48-u02",
          "speaker_id": "a",
          "ja": "あ、失礼しました。田辺さんですね。",
          "vi": "À, tôi xin lỗi. Anh Tanabe nhỉ."
        },
        {
          "id": "3223be87-1bc4-5711-93bc-3a62fbff3c48-u03",
          "speaker_id": "b",
          "ja": "はい。よろしくお願いします。",
          "vi": "Vâng. Mong được làm việc cùng chị."
        }
      ],
      "admin": {
        "source_refs": [
          "work"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3223be87-1bc4-5711-93bc-3a62fbff3c48-u01": {
