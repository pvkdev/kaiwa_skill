          },
          "3223be87-1bc4-5711-93bc-3a62fbff3c48-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "8cdaf80f-7e56-5d34-b3f5-e104fb8eeb9a",
      "event_id": "E02",
      "context_vi": "Trong khu chung của văn phòng, bạn gặp đồng nghiệp nam bộ phận khác. Hai người nói một câu về mưa rồi chuyển sang lịch họp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp bộ phận khác",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8cdaf80f-7e56-5d34-b3f5-e104fb8eeb9a-u01",
          "speaker_id": "a",
          "ja": "今日は雨ですね。傘、持ってきましたか。",
          "vi": "Hôm nay mưa nhỉ. Anh có mang ô không?"
        },
        {
          "id": "8cdaf80f-7e56-5d34-b3f5-e104fb8eeb9a-u02",
          "speaker_id": "b",
          "ja": "はい、持ってきました。午後の会議は何時ですか。",
          "vi": "Có, tôi mang rồi. Cuộc họp chiều lúc mấy giờ?"
        },
        {
          "id": "8cdaf80f-7e56-5d34-b3f5-e104fb8eeb9a-u03",
          "speaker_id": "a",
          "ja": "三時です。会議室で会いましょう。",
          "vi": "3 giờ. Mình gặp ở phòng họp nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "work"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8cdaf80f-7e56-5d34-b3f5-e104fb8eeb9a-u01": {
            "kind": "original_extension"
          },
          "8cdaf80f-7e56-5d34-b3f5-e104fb8eeb9a-u02": {
            "kind": "original_extension"
          },
          "8cdaf80f-7e56-5d34-b3f5-e104fb8eeb9a-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "63cd2295-588b-5306-bb69-0bab1d46859a",
      "event_id": "E02",
      "context_vi": "Bạn đang nói chuyện ngắn ở hành lang thì đồng nghiệp nam nhìn đồng hồ và chuẩn bị vào họp. Bạn kết thúc để anh ấy đi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp bộ phận khác",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "63cd2295-588b-5306-bb69-0bab1d46859a-u01",
          "speaker_id": "b",
          "ja": "そろそろ会議に行きます。",
          "vi": "Tôi sắp vào họp."
        },
        {
          "id": "63cd2295-588b-5306-bb69-0bab1d46859a-u02",
          "speaker_id": "a",
          "ja": "そうですね。お時間を取ってすみません。またあとで。",
          "vi": "Vâng. Xin lỗi đã giữ anh lại. Lát nữa gặp nhé."
        },
        {
          "id": "63cd2295-588b-5306-bb69-0bab1d46859a-u03",
          "speaker_id": "b",
          "ja": "はい、また。",
          "vi": "Vâng, gặp sau."
        }
      ],
      "admin": {
        "source_refs": [
          "work"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
