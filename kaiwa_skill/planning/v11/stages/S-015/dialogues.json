    {
      "situation_uid": "797814aa-369d-51ca-a205-022fcd64cb3a",
      "event_id": "E02",
      "context_vi": "Ở hành lang, đồng nghiệp nam ôm nhiều tập tài liệu. Bạn chỉ hỏi có cần giúp mang một tập không, không đoán công việc của anh ấy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp bộ phận khác",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "797814aa-369d-51ca-a205-022fcd64cb3a-u01",
          "speaker_id": "a",
          "ja": "一つ持ちましょうか。",
          "vi": "Để tôi cầm giúp một tập nhé?"
        },
        {
          "id": "797814aa-369d-51ca-a205-022fcd64cb3a-u02",
          "speaker_id": "b",
          "ja": "ありがとう。この青いファイルをお願いします。",
          "vi": "Cảm ơn. Nhờ chị cầm tập bìa xanh này."
        },
