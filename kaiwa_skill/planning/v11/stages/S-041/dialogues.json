    },
    {
      "situation_uid": "0659e411-1f4b-5bc5-9532-ac06a81c7465",
      "event_id": "E01",
      "context_vi": "Đang chuẩn bị 20 túi tài liệu ở Tori hư cấu, bạn hỏi leader khi nào cần báo tiến độ lần tiếp theo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0659e411-1f4b-5bc5-9532-ac06a81c7465-u01",
          "speaker_id": "a",
          "ja": "次はいつ進み具合を報告すればいいですか。",
          "vi": "Lần tiếp theo tôi cần báo tiến độ lúc nào ạ?"
        },
        {
          "id": "0659e411-1f4b-5bc5-9532-ac06a81c7465-u02",
          "speaker_id": "b",
          "ja": "午後二時に、できた数を教えてください。",
          "vi": "2 giờ chiều báo tôi số túi đã làm xong nhé."
        },
        {
          "id": "0659e411-1f4b-5bc5-9532-ac06a81c7465-u03",
          "speaker_id": "a",
          "ja": "分かりました。二時に数を確認して報告します。",
          "vi": "Tôi hiểu. 2 giờ tôi kiểm số lượng rồi báo."
        },
        {
          "id": "0659e411-1f4b-5bc5-9532-ac06a81c7465-u04",
          "speaker_id": "b",
          "ja": "はい。",
          "vi": "Ừ."
        }
      ],
      "admin": {
        "source_refs": [
          "report"
        ],
        "specialty_item_ids": [],
