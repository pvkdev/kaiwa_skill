    {
      "situation_uid": "2295eb6e-d962-5cbe-9796-9e18bdba348f",
      "event_id": "E02",
      "context_vi": "Đúng 16 giờ, kiện hàng đã đến quầy Tori như giờ mới bên giao hàng báo. Bạn báo đồng nghiệp phụ trách nhận, nhưng chưa nói hàng đã được kiểm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp liên quan",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2295eb6e-d962-5cbe-9796-9e18bdba348f-u01",
          "speaker_id": "a",
          "ja": "荷物が今、受付に届きました。四時です。",
          "vi": "Kiện hàng vừa đến quầy lễ tân. Bây giờ 4 giờ."
        },
        {
          "id": "2295eb6e-d962-5cbe-9796-9e18bdba348f-u02",
          "speaker_id": "b",
          "ja": "分かりました。これから受け取りと中身を確認します。",
          "vi": "Tôi hiểu. Bây giờ tôi đi nhận và kiểm bên trong."
        },
        {
          "id": "2295eb6e-d962-5cbe-9796-9e18bdba348f-u03",
          "speaker_id": "a",
          "ja": "はい。確認が終わったら教えてください。",
          "vi": "Vâng. Kiểm xong chị báo tôi nhé."
        },
        {
          "id": "2295eb6e-d962-5cbe-9796-9e18bdba348f-u04",
          "speaker_id": "b",
          "ja": "そうします。",
          "vi": "Tôi sẽ báo."
        }
      ],
      "admin": {
