    {
      "situation_uid": "f000e016-b541-50d6-ba14-aa1dd6e2be67",
      "event_id": "E03",
      "context_vi": "Sau bàn giao tại Tori, ca sau nói chỉ kịp xử lý phần cần trước 10 giờ, không thể tự nhận việc kiểm kho nhãn còn lại. Bạn hỏi ai sẽ nhận phần đó.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ca sau",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "f000e016-b541-50d6-ba14-aa1dd6e2be67-u01",
          "speaker_id": "b",
          "ja": "十時までの五セットは見ますが、ほかの在庫確認まではできません。",
          "vi": "Tôi sẽ lo năm bộ cần trước 10 giờ, nhưng không kiểm toàn bộ kho được."
        },
        {
          "id": "f000e016-b541-50d6-ba14-aa1dd6e2be67-u02",
          "speaker_id": "a",
          "ja": "分かりました。残りの確認は誰にお願いすればいいですか。",
          "vi": "Tôi hiểu. Phần kiểm còn lại nên nhờ ai?"
        },
        {
          "id": "f000e016-b541-50d6-ba14-aa1dd6e2be67-u03",
          "speaker_id": "b",
          "ja": "リーダーに相談してください。まだ担当は決まっていません。",
          "vi": "Anh hỏi leader nhé. Vẫn chưa phân người."
        },
        {
          "id": "f000e016-b541-50d6-ba14-aa1dd6e2be67-u04",
          "speaker_id": "a",
          "ja": "はい。決まるまで、担当済みとは報告しません。",
          "vi": "Được. Chừng nào chưa phân người, tôi sẽ không báo là đã có người nhận."
        }
      ],
