    {
      "situation_uid": "8a2fe17d-e910-55f1-8d11-2c81c9601a60",
      "event_id": "E03",
      "context_vi": "Sáng hôm sau ở Tori, bạn hỏi leader về phần kiểm kho nhãn còn lại sau khi ca sau chỉ nhận năm bộ khẩn. Bạn cần biết đã được xử lý hay chưa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8a2fe17d-e910-55f1-8d11-2c81c9601a60-u01",
          "speaker_id": "a",
          "ja": "昨日の在庫確認は、誰か担当しましたか。結果は出ていますか。",
          "vi": "Việc kiểm kho hôm qua có ai phụ trách chưa? Đã có kết quả chưa ạ?"
        },
        {
          "id": "8a2fe17d-e910-55f1-8d11-2c81c9601a60-u02",
          "speaker_id": "b",
          "ja": "山田さんが確認しました。シールは追加で十枚ありました。",
          "vi": "Chị Yamada đã kiểm. Có thêm 10 nhãn ạ."
        },
        {
          "id": "8a2fe17d-e910-55f1-8d11-2c81c9601a60-u03",
          "speaker_id": "a",
          "ja": "分かりました。五セットは完成したかも確認します。",
          "vi": "Tôi hiểu. Tôi sẽ kiểm thêm xem năm bộ đã hoàn thành chưa."
        },
        {
          "id": "8a2fe17d-e910-55f1-8d11-2c81c9601a60-u04",
          "speaker_id": "b",
          "ja": "はい。完成はまだ私も確認していません。",
          "vi": "Ừ. Tôi cũng chưa kiểm việc đó đã xong chưa."
        }
      ],
