    {
      "situation_uid": "7cc6ea44-b6b8-5eab-8124-b88293f0797f",
      "event_id": "E03",
      "context_vi": "Trước khi rời ca ở Tori hư cấu, bạn phát hiện một kiện hàng ở quầy chưa có tên người nhận. Bạn báo leader, chưa tự giao cho ai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "7cc6ea44-b6b8-5eab-8124-b88293f0797f-u01",
          "speaker_id": "a",
          "ja": "一つご報告があります。受付の荷物に、受取人の名前がありません。",
          "vi": "Tôi xin báo một việc. Kiện hàng ở quầy không có tên người nhận."
        },
        {
          "id": "7cc6ea44-b6b8-5eab-8124-b88293f0797f-u02",
          "speaker_id": "b",
          "ja": "分かりました。差出人の情報はありますか。",
          "vi": "Tôi hiểu. Có thông tin người gửi không?"
        },
        {
          "id": "7cc6ea44-b6b8-5eab-8124-b88293f0797f-u03",
          "speaker_id": "a",
          "ja": "送り状に会社名はあります。誰の荷物かはまだ分かりません。",
          "vi": "Phiếu gửi có tên công ty. Tôi vẫn chưa biết kiện hàng của ai."
        },
        {
          "id": "7cc6ea44-b6b8-5eab-8124-b88293f0797f-u04",
          "speaker_id": "b",
          "ja": "私が確認します。それまでは渡さずに置いてください。",
          "vi": "Tôi sẽ kiểm tra. Trước lúc đó cứ để lại, chưa giao nhé."
        },
        {
          "id": "7cc6ea44-b6b8-5eab-8124-b88293f0797f-u05",
          "speaker_id": "a",
          "ja": "分かりました。ここに置いておきます。",
          "vi": "Tôi hiểu. Tôi sẽ để ở đây."
        }
      ],
