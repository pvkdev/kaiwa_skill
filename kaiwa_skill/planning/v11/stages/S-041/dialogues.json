  "dialogues": [
    {
      "situation_uid": "72a43e58-76dd-5bb0-8e81-54efb5157ac0",
      "event_id": "E01",
      "context_vi": "Ở công ty Tori hư cấu, bạn đã nhận 20 bộ phong bì và bắt đầu chuẩn bị túi tài liệu cho cuộc họp. Bạn báo leader đúng số đã nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "72a43e58-76dd-5bb0-8e81-54efb5157ac0-u01",
          "speaker_id": "a",
          "ja": "封筒を二十セット受け取りました。今から会議用の袋を作ります。",
          "vi": "Tôi đã nhận 20 bộ phong bì. Bây giờ tôi bắt đầu chuẩn bị túi tài liệu cho cuộc họp."
        },
        {
          "id": "72a43e58-76dd-5bb0-8e81-54efb5157ac0-u02",
          "speaker_id": "b",
          "ja": "分かりました。中身を一つずつ確認してください。",
          "vi": "Tôi hiểu. Anh kiểm từng bộ bên trong nhé."
        },
        {
          "id": "72a43e58-76dd-5bb0-8e81-54efb5157ac0-u03",
          "speaker_id": "a",
          "ja": "はい。数を確認しながら進めます。",
          "vi": "Vâng. Tôi sẽ làm và kiểm số lượng cùng lúc."
        },
        {
          "id": "72a43e58-76dd-5bb0-8e81-54efb5157ac0-u04",
          "speaker_id": "b",
          "ja": "お願いします。",
          "vi": "Nhờ anh."
        }
      ],
      "admin": {
        "source_refs": [
          "report"
        ],
        "specialty_item_ids": [],
