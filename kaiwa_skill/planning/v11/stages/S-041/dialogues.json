    {
      "situation_uid": "f57923dc-c07a-5f33-a387-1562f9474b4d",
      "event_id": "E02",
      "context_vi": "Ở Tori hư cấu, phòng họp 203 tầng hai đổi sang phòng 305 tầng ba. Bạn báo đồng nghiệp liên quan kèm cả số phòng và tầng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp liên quan",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "f57923dc-c07a-5f33-a387-1562f9474b4d-u01",
          "speaker_id": "a",
          "ja": "今日の会議は二階の二〇三ではなく、三階の三〇五になりました。",
          "vi": "Cuộc họp hôm nay chuyển từ phòng 203 tầng hai sang phòng 305 tầng ba."
        },
        {
          "id": "f57923dc-c07a-5f33-a387-1562f9474b4d-u02",
          "speaker_id": "b",
          "ja": "三階の三〇五ですね。時間は同じですか。",
          "vi": "Phòng 305 tầng ba nhé. Giờ vẫn như cũ chứ?"
        },
        {
          "id": "f57923dc-c07a-5f33-a387-1562f9474b4d-u03",
          "speaker_id": "a",
          "ja": "はい。午後三時のままです。",
          "vi": "Vâng, vẫn 3 giờ chiều."
        },
        {
          "id": "f57923dc-c07a-5f33-a387-1562f9474b4d-u04",
          "speaker_id": "b",
          "ja": "分かりました。ほかの人にも伝えます。",
          "vi": "Tôi hiểu. Tôi sẽ báo những người khác."
        }
      ],
      "admin": {
        "source_refs": [
          "report"
        ],
        "specialty_item_ids": [],
