    {
      "situation_uid": "b0c9d727-af95-5ae6-a9a1-b5c2627350c0",
      "event_id": "E03",
      "context_vi": "Cuối ca tại Tori hư cấu, bạn bàn giao cho ca sau: 15 túi tài liệu đã xong, năm túi còn chờ nhãn tên. Bạn phân biệt việc đã xong và chưa xong.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ca sau",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b0c9d727-af95-5ae6-a9a1-b5c2627350c0-u01",
          "speaker_id": "a",
          "ja": "二十セットのうち十五セットできました。五セットは名前のシールを待っています。",
          "vi": "Trong 20 bộ, tôi làm xong 15 bộ. Năm bộ còn chờ nhãn tên."
        },
        {
          "id": "b0c9d727-af95-5ae6-a9a1-b5c2627350c0-u02",
          "speaker_id": "b",
          "ja": "分かりました。何時までに必要ですか。",
          "vi": "Tôi hiểu. Cần trước mấy giờ?"
        },
        {
          "id": "b0c9d727-af95-5ae6-a9a1-b5c2627350c0-u03",
          "speaker_id": "a",
          "ja": "明日の午前十時までです。シールが来たか、まだ確認できていません。",
          "vi": "Cần trước 10 giờ sáng mai. Tôi chưa xác nhận nhãn đã đến hay chưa."
        },
        {
          "id": "b0c9d727-af95-5ae6-a9a1-b5c2627350c0-u04",
          "speaker_id": "b",
          "ja": "まず、入荷を確認します。",
          "vi": "Trước hết tôi sẽ kiểm tra nhãn đã đến chưa."
        }
      ],
      "admin": {
