    {
      "situation_uid": "2640ec3f-5a81-5613-a7ac-537c97c244db",
      "event_id": "E01",
      "context_vi": "Sau khi đã báo 10 trong 20 túi xong ở Tori, bạn phát hiện nhãn tên chỉ đủ cho 15 túi. Bạn báo leader phần thiếu và ảnh hưởng tới hạn hoàn thành.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2640ec3f-5a81-5613-a7ac-537c97c244db-u01",
          "speaker_id": "a",
          "ja": "確認したら、名前のシールが十五枚しかありません。残り五セットは完成できません。",
          "vi": "Tôi kiểm rồi, nhãn tên chỉ có 15 tờ. Năm bộ còn lại chưa thể hoàn thành."
        },
        {
          "id": "2640ec3f-5a81-5613-a7ac-537c97c244db-u02",
          "speaker_id": "b",
          "ja": "分かりました。追加を確認します。いつまでに必要ですか。",
          "vi": "Tôi hiểu. Tôi kiểm tra nhãn bổ sung. Anh cần trước lúc nào?"
        },
        {
          "id": "2640ec3f-5a81-5613-a7ac-537c97c244db-u03",
          "speaker_id": "a",
          "ja": "三時までにあれば、会議前に終えられます。",
          "vi": "Nếu có trước 3 giờ, tôi có thể xong trước cuộc họp."
        },
        {
          "id": "2640ec3f-5a81-5613-a7ac-537c97c244db-u04",
          "speaker_id": "b",
          "ja": "確約はまだできません。確認して連絡します。",
          "vi": "Tôi chưa hứa được. Tôi kiểm rồi báo."
        }
      ],
      "admin": {
        "source_refs": [
          "report"
        ],
