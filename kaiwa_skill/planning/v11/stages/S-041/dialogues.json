    {
      "situation_uid": "4d3aa5a1-3a0b-57d6-ac8a-cca3f152ddd0",
      "event_id": "E01",
      "context_vi": "Đúng 14 giờ ở Tori, theo hẹn bạn báo leader số túi tài liệu đã hoàn thành trong tổng 20 bộ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4d3aa5a1-3a0b-57d6-ac8a-cca3f152ddd0-u01",
          "speaker_id": "a",
          "ja": "二時になりました。二十セットのうち、十セットできました。",
          "vi": "Đã 2 giờ. Trong 20 bộ, tôi làm xong 10 bộ."
        },
        {
          "id": "4d3aa5a1-3a0b-57d6-ac8a-cca3f152ddd0-u02",
          "speaker_id": "b",
          "ja": "残り十セットですね。困っていることはありますか。",
          "vi": "Còn 10 bộ nhỉ. Có vướng gì không?"
        },
        {
          "id": "4d3aa5a1-3a0b-57d6-ac8a-cca3f152ddd0-u03",
          "speaker_id": "a",
          "ja": "今のところ作業は続けられます。残りも確認します。",
          "vi": "Lúc này tôi vẫn làm tiếp được. Tôi sẽ kiểm phần còn lại."
        },
        {
          "id": "4d3aa5a1-3a0b-57d6-ac8a-cca3f152ddd0-u04",
          "speaker_id": "b",
          "ja": "分かりました。変化があれば知らせてください。",
          "vi": "Tôi hiểu. Có thay đổi thì báo tôi nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "report"
        ],
        "specialty_item_ids": [],
