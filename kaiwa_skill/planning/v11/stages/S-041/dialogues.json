    {
      "situation_uid": "2ae60f07-6614-53b3-af4f-05e88d7b6e0f",
      "event_id": "E02",
      "context_vi": "Sau khi bạn báo cuộc họp chuyển sang phòng 305 tầng ba, đồng nghiệp nghe nhầm thành phòng 305 tầng hai. Bạn sửa đủ cả tầng và phòng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp liên quan",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2ae60f07-6614-53b3-af4f-05e88d7b6e0f-u01",
          "speaker_id": "b",
          "ja": "二階の三〇五に行けばいいんですね。",
          "vi": "Vậy tôi đến phòng 305 tầng hai nhé."
        },
        {
          "id": "2ae60f07-6614-53b3-af4f-05e88d7b6e0f-u02",
          "speaker_id": "a",
          "ja": "すみません、三階です。三階の三〇五です。",
          "vi": "Xin lỗi, là tầng ba. Phòng 305 tầng ba."
        },
        {
          "id": "2ae60f07-6614-53b3-af4f-05e88d7b6e0f-u03",
          "speaker_id": "b",
          "ja": "三階の三〇五ですね。確認しました。",
          "vi": "Phòng 305 tầng ba. Tôi đã rõ."
        },
        {
          "id": "2ae60f07-6614-53b3-af4f-05e88d7b6e0f-u04",
          "speaker_id": "a",
          "ja": "はい。時間は三時のままです。",
          "vi": "Vâng. Giờ vẫn 3 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "report"
        ],
