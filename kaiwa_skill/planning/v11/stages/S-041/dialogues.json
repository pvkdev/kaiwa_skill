    {
      "situation_uid": "d8213e39-f937-564e-80e7-866c5a9b70b0",
      "event_id": "E02",
      "context_vi": "Ở Tori hư cấu, bên giao hàng vừa gọi báo giờ đến đổi từ 15 giờ sang 16 giờ. Bạn báo đồng nghiệp phụ trách nhận hàng và nói đây là giờ họ vừa thông báo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp liên quan",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d8213e39-f937-564e-80e7-866c5a9b70b0-u01",
          "speaker_id": "a",
          "ja": "配送の人から連絡がありました。到着予定が三時から四時に変わりました。",
          "vi": "Bên giao hàng vừa báo: giờ dự kiến đến đổi từ 3 giờ sang 4 giờ."
        },
        {
          "id": "d8213e39-f937-564e-80e7-866c5a9b70b0-u02",
          "speaker_id": "b",
          "ja": "四時の予定ですね。確定ですか。",
          "vi": "Dự kiến 4 giờ nhỉ. Đã chắc chưa?"
        },
        {
          "id": "d8213e39-f937-564e-80e7-866c5a9b70b0-u03",
          "speaker_id": "a",
          "ja": "まだ予定です。着いたら、すぐお伝えします。",
          "vi": "Vẫn là dự kiến thôi. Khi hàng đến tôi báo ngay."
        },
        {
          "id": "d8213e39-f937-564e-80e7-866c5a9b70b0-u04",
          "speaker_id": "b",
          "ja": "分かりました。四時ごろ、受け取りの準備をします。",
          "vi": "Tôi hiểu. Khoảng 4 giờ tôi chuẩn bị nhận."
        }
      ],
      "admin": {
        "source_refs": [
          "report"
        ],
        "specialty_item_ids": [],
