  "dialogues": [
    {
      "situation_uid": "ba98763c-a13b-5db5-8f3e-3b4cc5335cd1",
      "event_id": "E01",
      "context_vi": "Ở văn phòng Aoba hư cấu, bạn cần đến phòng họp 302. Bạn hỏi đồng nghiệp nam đường đi theo số phòng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ba98763c-a13b-5db5-8f3e-3b4cc5335cd1-u01",
          "speaker_id": "a",
          "ja": "会議室三〇二はどこですか。",
          "vi": "Phòng họp 302 ở đâu ạ?"
        },
        {
          "id": "ba98763c-a13b-5db5-8f3e-3b4cc5335cd1-u02",
          "speaker_id": "b",
          "ja": "三階です。エレベーターを出て右です。",
          "vi": "Tầng ba. Ra khỏi thang máy rồi rẽ phải."
        },
        {
          "id": "ba98763c-a13b-5db5-8f3e-3b4cc5335cd1-u03",
          "speaker_id": "a",
          "ja": "三階で右ですね。ありがとうございます。",
          "vi": "Tầng ba rồi rẽ phải nhỉ. Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [],
        "specialty_item_ids": [],
