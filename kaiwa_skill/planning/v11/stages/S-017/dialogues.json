          },
          "123458dd-3904-5235-80c2-6dbb64ea8706-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "aae63ea3-32c1-54a9-a663-03f0e66b58b9",
      "event_id": "E01",
      "context_vi": "Ở văn phòng Aoba hư cấu, bạn muốn nghỉ vài phút trong khoảng nghỉ của ca và hỏi phòng nghỉ nằm đâu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "aae63ea3-32c1-54a9-a663-03f0e66b58b9-u01",
          "speaker_id": "a",
          "ja": "休憩の時間です。少し休める場所はどこですか。",
          "vi": "Đến giờ nghỉ rồi. Tôi nghỉ một chút ở đâu được ạ?"
        },
        {
          "id": "aae63ea3-32c1-54a9-a663-03f0e66b58b9-u02",
          "speaker_id": "b",
          "ja": "奥の休憩室です。ここをまっすぐ行ってください。",
          "vi": "Ở phòng nghỉ phía trong. Chị đi thẳng lối này."
        },
        {
          "id": "aae63ea3-32c1-54a9-a663-03f0e66b58b9-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [],
        "specialty_item_ids": [],
        "turn_origins": {
          "aae63ea3-32c1-54a9-a663-03f0e66b58b9-u01": {
