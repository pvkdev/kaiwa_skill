            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "eed2f805-6ecc-588f-8dc5-ea4968cec751",
      "event_id": "E01",
      "context_vi": "Tiếp đường tới phòng 302: bạn đi nhầm tầng hai và chỉ thấy phòng 202. Bạn hỏi lại cùng đồng nghiệp qua điện thoại, nêu mốc đang thấy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp qua điện thoại",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "eed2f805-6ecc-588f-8dc5-ea4968cec751-u01",
          "speaker_id": "a",
          "ja": "二〇二の前にいます。三〇二がありません。",
          "vi": "Tôi đang trước phòng 202, không thấy 302."
        },
        {
          "id": "eed2f805-6ecc-588f-8dc5-ea4968cec751-u02",
          "speaker_id": "b",
          "ja": "そこは二階です。もう一つ上ですよ。",
          "vi": "Đó là tầng hai. Lên thêm một tầng nữa."
        },
        {
          "id": "eed2f805-6ecc-588f-8dc5-ea4968cec751-u03",
          "speaker_id": "a",
          "ja": "あ、三階ですね。上がります。",
          "vi": "À, tầng ba nhỉ. Tôi lên ngay."
        }
      ],
      "admin": {
        "source_refs": [],
        "specialty_item_ids": [],
        "turn_origins": {
          "eed2f805-6ecc-588f-8dc5-ea4968cec751-u01": {
