    {
      "situation_uid": "982645fd-7df6-55df-8a8e-a2f9c4a52d69",
      "event_id": "E03",
      "context_vi": "Tiếp ngay sau khi bạn báo đã đặt bút bên phải bàn: có hai cây bút đen giống nhau. Đồng nghiệp hỏi cây nào của anh ấy; bạn nhìn dấu trắng trên bút trước khi xác nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "982645fd-7df6-55df-8a8e-a2f9c4a52d69-u01",
          "speaker_id": "b",
          "ja": "黒いペンが二本あります。どちらが私のですか。",
          "vi": "Có hai bút đen. Cây nào là của tôi?"
        },
        {
          "id": "982645fd-7df6-55df-8a8e-a2f9c4a52d69-u02",
          "speaker_id": "a",
          "ja": "白い印があるほうですか。借りたペンに印がありました。",
          "vi": "Cây có dấu trắng phải không? Cây tôi mượn có dấu ấy."
        },
        {
          "id": "982645fd-7df6-55df-8a8e-a2f9c4a52d69-u03",
          "speaker_id": "b",
          "ja": "はい、それが私のです。",
          "vi": "Đúng, đó là bút của tôi."
        },
        {
          "id": "982645fd-7df6-55df-8a8e-a2f9c4a52d69-u04",
          "speaker_id": "a",
          "ja": "よかったです。机の右端に置いたのはそのペンです。",
          "vi": "May quá. Cây tôi để ở mép phải bàn chính là cây ấy."
        }
      ],
