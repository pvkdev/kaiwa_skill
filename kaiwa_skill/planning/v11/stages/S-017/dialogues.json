    },
    {
      "situation_uid": "25bb02f1-c3ab-59af-b700-03d6d23caa78",
      "event_id": "E02",
      "context_vi": "Ở Aoba hư cấu, bạn lần đầu dùng máy in chung để in một trang. Bạn xin đồng nghiệp chỉ cách dùng, không tự thử các nút.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "25bb02f1-c3ab-59af-b700-03d6d23caa78-u01",
          "speaker_id": "a",
          "ja": "このプリンターを使いたいです。使い方を教えてもらえますか。",
          "vi": "Tôi muốn dùng máy in này. Anh chỉ giúp cách dùng được không ạ?"
        },
        {
          "id": "25bb02f1-c3ab-59af-b700-03d6d23caa78-u02",
          "speaker_id": "b",
          "ja": "はい。一枚だけ印刷しますか。",
          "vi": "Được. Chị in một trang thôi à?"
        },
        {
          "id": "25bb02f1-c3ab-59af-b700-03d6d23caa78-u03",
          "speaker_id": "a",
          "ja": "はい、一枚です。",
          "vi": "Vâng, một trang."
        }
      ],
      "admin": {
        "source_refs": [
          "copy"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "25bb02f1-c3ab-59af-b700-03d6d23caa78-u01": {
            "kind": "original_extension"
          },
          "25bb02f1-c3ab-59af-b700-03d6d23caa78-u02": {
            "kind": "original_extension"
          },
          "25bb02f1-c3ab-59af-b700-03d6d23caa78-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "85271af7-f815-5f73-acab-a9fe8b4424db",
      "event_id": "E02",
      "context_vi": "Tiếp việc in một trang: đồng nghiệp chỉ máy Aoba hư cấu chọn tài liệu trên màn hình rồi bấm nút xanh. Bạn nhắc lại hai bước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "85271af7-f815-5f73-acab-a9fe8b4424db-u01",
          "speaker_id": "b",
          "ja": "画面でファイルを選んで、青いボタンを押してください。",
          "vi": "Chị chọn tệp trên màn hình, rồi nhấn nút xanh."
        },
        {
          "id": "85271af7-f815-5f73-acab-a9fe8b4424db-u02",
          "speaker_id": "a",
          "ja": "ファイルを選んで、青いボタンですね。",
          "vi": "Chọn tệp rồi nhấn nút xanh nhỉ."
        },
        {
          "id": "85271af7-f815-5f73-acab-a9fe8b4424db-u03",
          "speaker_id": "b",
          "ja": "はい。まず一枚、確認しましょう。",
          "vi": "Đúng. Mình in thử một trang để xem nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "copy"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "85271af7-f815-5f73-acab-a9fe8b4424db-u01": {
