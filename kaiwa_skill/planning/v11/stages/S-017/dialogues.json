    {
      "situation_uid": "7609de33-651f-5721-acd8-480535c633c6",
      "event_id": "E03",
      "context_vi": "Một nhánh khác trong buổi họp: đồng nghiệp cũng cần dùng cây bút duy nhất nên không cho mượn. Bạn hỏi chỗ lấy bút khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7609de33-651f-5721-acd8-480535c633c6-u01",
          "speaker_id": "b",
          "ja": "すみません。このペンは今、私も使います。",
          "vi": "Xin lỗi, tôi cũng đang cần cây bút này."
        },
        {
          "id": "7609de33-651f-5721-acd8-480535c633c6-u02",
          "speaker_id": "a",
          "ja": "わかりました。ほかにペンはありますか。",
          "vi": "Tôi hiểu. Có bút nào khác không ạ?"
        },
        {
          "id": "7609de33-651f-5721-acd8-480535c633c6-u03",
          "speaker_id": "b",
          "ja": "入口の机に予備があります。",
          "vi": "Có bút dự phòng ở bàn gần cửa."
        }
      ],
      "admin": {
        "source_refs": [
          "supplies"
        ],
