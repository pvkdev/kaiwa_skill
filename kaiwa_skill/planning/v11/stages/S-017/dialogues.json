    },
    {
      "situation_uid": "3c524431-97ac-5769-9411-51c6e4db3ceb",
      "event_id": "E02",
      "context_vi": "Ở Aoba hư cấu, bạn cần một tập giấy ghi chú từ tủ vật tư đang khóa. Bạn hỏi đồng nghiệp nam ai giữ chìa khóa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3c524431-97ac-5769-9411-51c6e4db3ceb-u01",
          "speaker_id": "a",
          "ja": "文房具の棚の鍵は、誰が持っていますか。",
          "vi": "Ai giữ chìa khóa tủ văn phòng phẩm ạ?"
        },
        {
          "id": "3c524431-97ac-5769-9411-51c6e4db3ceb-u02",
          "speaker_id": "b",
          "ja": "森さんです。今、向こうの席にいます。",
          "vi": "Anh Mori giữ. Anh ấy đang ở bàn bên kia."
        },
        {
          "id": "3c524431-97ac-5769-9411-51c6e4db3ceb-u03",
          "speaker_id": "a",
          "ja": "森さんに聞きます。",
          "vi": "Tôi sẽ hỏi anh Mori."
        }
      ],
      "admin": {
        "source_refs": [
          "supplies"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3c524431-97ac-5769-9411-51c6e4db3ceb-u01": {
