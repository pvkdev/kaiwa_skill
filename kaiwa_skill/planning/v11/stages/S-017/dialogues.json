    {
      "situation_uid": "6be222d3-c24c-5a60-95ac-b67688a2b3ff",
      "event_id": "E03",
      "context_vi": "Trong buổi họp Aoba hư cấu, bạn quên bút và cần ghi chép. Bạn hỏi đồng nghiệp ngồi cạnh mượn bút đến cuối buổi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6be222d3-c24c-5a60-95ac-b67688a2b3ff-u01",
          "speaker_id": "a",
          "ja": "すみません。会議の間、ペンを一本借りてもいいですか。",
          "vi": "Xin lỗi, tôi mượn một cây bút trong buổi họp được không ạ?"
        },
        {
          "id": "6be222d3-c24c-5a60-95ac-b67688a2b3ff-u02",
          "speaker_id": "b",
          "ja": "はい。この黒いペンをどうぞ。",
          "vi": "Được. Chị dùng cây bút đen này."
        },
        {
          "id": "6be222d3-c24c-5a60-95ac-b67688a2b3ff-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。終わったら返します。",
          "vi": "Cảm ơn anh. Họp xong tôi sẽ trả."
        }
      ],
