            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "123458dd-3904-5235-80c2-6dbb64ea8706",
      "event_id": "E01",
      "context_vi": "Tại văn phòng Aoba hư cấu, bạn muốn cất áo khoác và biết nơi đặt giấy dùng chung. Đồng nghiệp chỉ hai chỗ khác nhau.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "123458dd-3904-5235-80c2-6dbb64ea8706-u01",
          "speaker_id": "a",
          "ja": "コートはどこに置きますか。紙はどこですか。",
          "vi": "Áo khoác để đâu ạ? Giấy ở đâu?"
        },
        {
          "id": "123458dd-3904-5235-80c2-6dbb64ea8706-u02",
          "speaker_id": "b",
          "ja": "コートはこのロッカー、紙はあの棚です。",
          "vi": "Áo ở tủ này, giấy ở kệ kia."
        },
        {
          "id": "123458dd-3904-5235-80c2-6dbb64ea8706-u03",
          "speaker_id": "a",
          "ja": "別の場所ですね。わかりました。",
          "vi": "Hai chỗ khác nhau nhỉ. Tôi rõ rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "supplies"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "123458dd-3904-5235-80c2-6dbb64ea8706-u01": {
            "kind": "original_extension"
          },
