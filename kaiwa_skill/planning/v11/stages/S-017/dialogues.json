          },
          "3c524431-97ac-5769-9411-51c6e4db3ceb-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "6ac420d3-b67d-5a24-bf03-bbf0e9e38a06",
      "event_id": "E02",
      "context_vi": "Tiếp khi hỏi Mori về tủ vật tư: Mori nói hôm nay mỗi người chỉ lấy một tập giấy ghi chú. Bạn cần hai tập nên hỏi phần còn lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người giữ tủ Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6ac420d3-b67d-5a24-bf03-bbf0e9e38a06-u01",
          "speaker_id": "b",
          "ja": "今日は一人一冊です。",
          "vi": "Hôm nay mỗi người lấy một tập thôi."
        },
        {
          "id": "6ac420d3-b67d-5a24-bf03-bbf0e9e38a06-u02",
          "speaker_id": "a",
          "ja": "わかりました。一冊取ります。もう一冊必要です。どうすればいいですか。",
          "vi": "Tôi rõ rồi. Tôi lấy một tập. Tôi cần thêm một tập nữa, vậy phải làm thế nào ạ?"
        },
        {
          "id": "6ac420d3-b67d-5a24-bf03-bbf0e9e38a06-u03",
          "speaker_id": "b",
          "ja": "もう一冊は、あとで私に聞いてください。",
          "vi": "Về tập thứ hai, lát nữa chị hỏi lại tôi nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "supplies"
        ],
        "specialty_item_ids": [],
