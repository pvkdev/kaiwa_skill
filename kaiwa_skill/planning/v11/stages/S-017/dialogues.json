    {
      "situation_uid": "db40235b-94aa-52f1-b2df-b024f5bbd4fe",
      "event_id": "E03",
      "context_vi": "Sau buổi họp, bạn trả đúng cây bút đen đã mượn. Đồng nghiệp đang bận, bạn đặt ở mép bàn bên phải và báo vị trí.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "db40235b-94aa-52f1-b2df-b024f5bbd4fe-u01",
          "speaker_id": "a",
          "ja": "ペン、ありがとうございました。机の右端に置きました。",
          "vi": "Cảm ơn anh đã cho mượn bút. Tôi để ở mép phải bàn rồi."
        },
        {
          "id": "db40235b-94aa-52f1-b2df-b024f5bbd4fe-u02",
          "speaker_id": "b",
          "ja": "ありがとう。あとで取ります。",
          "vi": "Cảm ơn. Lát nữa tôi lấy."
        }
      ],
      "admin": {
