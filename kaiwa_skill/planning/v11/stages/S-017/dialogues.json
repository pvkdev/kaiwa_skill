    {
      "situation_uid": "f779b081-3a21-52aa-a965-41490e608990",
      "event_id": "E02",
      "context_vi": "Một nhánh khác sau khi bạn hỏi cách in một trang: màn hình máy Aoba hư cấu báo hết giấy. Bạn nói đúng thông báo cho đồng nghiệp, chưa tự mở máy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f779b081-3a21-52aa-a965-41490e608990-u01",
          "speaker_id": "a",
          "ja": "画面に「紙がありません」と出ています。どうしますか。",
          "vi": "Màn hình báo “hết giấy”. Tôi nên làm gì ạ?"
        },
        {
          "id": "f779b081-3a21-52aa-a965-41490e608990-u02",
          "speaker_id": "b",
          "ja": "私が見ます。少し待ってください。",
          "vi": "Để tôi xem. Chị chờ một chút nhé."
        },
        {
          "id": "f779b081-3a21-52aa-a965-41490e608990-u03",
          "speaker_id": "a",
          "ja": "はい。ここで待ちます。",
          "vi": "Vâng, tôi đợi ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "copy"
        ],
