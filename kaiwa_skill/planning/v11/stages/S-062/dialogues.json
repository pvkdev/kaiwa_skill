    {
      "situation_uid": "2abc21d4-bffd-5329-ac01-5a53905526f0",
      "event_id": "E01",
      "context_vi": "Đối tác gọi lại: thứ Ba lúc 2 giờ không tiện. Bạn hỏi một giờ khác và đề xuất thứ Tư lúc 10 giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên công ty Midori",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đối tác công ty Sakura",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2abc21d4-bffd-5329-ac01-5a53905526f0-u01",
          "speaker_id": "b",
          "ja": "申し訳ありませんが、火曜日の午後二時は都合がつきません。",
          "vi": "Xin lỗi chị, bên tôi không sắp xếp được 2 giờ chiều thứ Ba ạ."
        },
        {
          "id": "2abc21d4-bffd-5329-ac01-5a53905526f0-u02",
          "speaker_id": "a",
          "ja": "では、水曜日の午前十時はいかがですか。",
          "vi": "Vậy 10 giờ sáng thứ Tư có tiện không ạ?"
        },
        {
          "id": "2abc21d4-bffd-5329-ac01-5a53905526f0-u03",
          "speaker_id": "b",
          "ja": "水曜日の予定を確認します。",
          "vi": "Tôi sẽ kiểm tra lịch thứ Tư."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "2abc21d4-bffd-5329-ac01-5a53905526f0-u01": {
            "kind": "original_extension"
