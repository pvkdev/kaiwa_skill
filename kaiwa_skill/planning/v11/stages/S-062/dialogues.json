    {
      "situation_uid": "9243bb58-749a-5806-96ce-e49615d0c151",
      "event_id": "E02",
      "context_vi": "Lễ tân nhắc tên gần giống là Kato. Bạn sửa người hẹn là Sato và xác nhận bộ phận kinh doanh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: khách đến thăm",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên lễ tân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9243bb58-749a-5806-96ce-e49615d0c151-u01",
          "speaker_id": "b",
          "ja": "加藤とのお約束でしょうか。",
          "vi": "Chị có hẹn với chị Kato phải không ạ?"
        },
        {
          "id": "9243bb58-749a-5806-96ce-e49615d0c151-u02",
          "speaker_id": "a",
          "ja": "いえ、営業部の佐藤様です。",
          "vi": "Dạ, tôi có hẹn với chị Sato ở phòng kinh doanh ạ."
        },
        {
          "id": "9243bb58-749a-5806-96ce-e49615d0c151-u03",
          "speaker_id": "b",
          "ja": "失礼いたしました。営業部の佐藤ですね。",
          "vi": "Xin lỗi chị, tôi nghe nhầm. Chị có hẹn với chị Sato bên kinh doanh ạ."
        }
      ],
