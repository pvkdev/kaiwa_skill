          },
          "2abc21d4-bffd-5329-ac01-5a53905526f0-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "564a8079-d817-5d70-984b-d873318a314e",
      "event_id": "E01",
      "context_vi": "Đối tác đã kiểm tra và nhận giờ thứ Tư 10 giờ. Bạn hỏi ai sẽ tiếp mình rồi chốt cuộc gặp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên công ty Midori",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đối tác công ty Sakura",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "564a8079-d817-5d70-984b-d873318a314e-u01",
          "speaker_id": "b",
          "ja": "水曜日の午前十時でしたら、お会いできます。",
          "vi": "10 giờ sáng thứ Tư thì bên tôi có thể gặp chị ạ."
        },
        {
          "id": "564a8079-d817-5d70-984b-d873318a314e-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。当日はどなたにお会いできますか。",
          "vi": "Cảm ơn anh. Hôm đó tôi sẽ gặp ai ạ?"
        },
        {
          "id": "564a8079-d817-5d70-984b-d873318a314e-u03",
          "speaker_id": "b",
          "ja": "営業部の佐藤がお話を伺います。",
          "vi": "Chị Sato ở phòng kinh doanh sẽ tiếp chị ạ."
        },
        {
          "id": "564a8079-d817-5d70-984b-d873318a314e-u04",
          "speaker_id": "a",
          "ja": "水曜日の十時、佐藤さんですね。",
          "vi": "Thứ Tư lúc 10 giờ, gặp chị Sato ạ."
        }
      ],
      "admin": {
