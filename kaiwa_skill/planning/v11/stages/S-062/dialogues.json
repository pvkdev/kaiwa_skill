    {
      "situation_uid": "ff18e0bd-b990-556f-a429-c31f1b9277fa",
      "event_id": "E03",
      "context_vi": "Bạn gặp Tanaka lần đầu và muốn biết nên gọi anh thế nào, đồng thời xác nhận mình có 15 phút để trao đổi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên công ty Midori",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đối tác công ty Sakura",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ff18e0bd-b990-556f-a429-c31f1b9277fa-u01",
          "speaker_id": "a",
          "ja": "田中さんとお呼びしてよろしいですか。今日は十五分ほど、お時間をいただけますか。",
          "vi": "Tôi gọi anh là Tanaka được chứ ạ? Hôm nay anh có thể dành khoảng 15 phút không?"
