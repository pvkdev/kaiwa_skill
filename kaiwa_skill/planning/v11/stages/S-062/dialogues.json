    {
      "situation_uid": "3f90c018-e2f0-52ba-b533-9de6826b213a",
      "event_id": "E03",
      "context_vi": "Bạn gặp đối tác lần đầu tại phòng họp. Bạn tự giới thiệu và trao danh thiếp bằng hai tay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên công ty Midori",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đối tác công ty Sakura",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3f90c018-e2f0-52ba-b533-9de6826b213a-u01",
          "speaker_id": "a",
          "ja": "はじめまして。みどり商事のリンと申します。こちら、名刺です。よろしくお願いいたします。",
          "vi": "Rất vui được gặp anh. Tôi là Linh bên công ty Midori. Đây là danh thiếp của tôi. Rất mong được hợp tác với anh ạ."
        },
        {
          "id": "3f90c018-e2f0-52ba-b533-9de6826b213a-u02",
          "speaker_id": "b",
          "ja": "さくら商事の田中です。私の名刺です。こちらこそ、よろしくお願いいたします。",
          "vi": "Tôi là Tanaka bên công ty Sakura. Đây là danh thiếp của tôi. Tôi cũng rất mong được hợp tác với chị."
        }
      ],
