    {
      "situation_uid": "b05563bf-798f-5a72-8f82-e114b22c4a5f",
      "event_id": "E02",
      "context_vi": "Lễ tân cho biết Sato vẫn ở trong một cuộc họp. Bạn hỏi có thể chờ ở đâu và sẽ được báo bằng cách nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: khách đến thăm",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên lễ tân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b05563bf-798f-5a72-8f82-e114b22c4a5f-u01",
          "speaker_id": "b",
          "ja": "佐藤はまだ会議中です。",
          "vi": "Chị Sato vẫn đang họp ạ."
        },
        {
          "id": "b05563bf-798f-5a72-8f82-e114b22c4a5f-u02",
          "speaker_id": "a",
          "ja": "どちらで待てばよろしいですか。会議が終わりましたら、教えていただけますか。",
          "vi": "Tôi nên chờ ở đâu ạ? Khi cuộc họp kết thúc, anh báo giúp tôi được không?"
        },
        {
          "id": "b05563bf-798f-5a72-8f82-e114b22c4a5f-u03",
          "speaker_id": "b",
          "ja": "こちらの席でお待ちください。終わり次第、お呼びします。",
          "vi": "Mời chị chờ ở ghế này. Khi xong, chúng tôi sẽ gọi."
        }
      ],
      "admin": {
