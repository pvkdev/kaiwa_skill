    {
      "situation_uid": "676589ab-bd73-565d-b76d-04f20b266ae6",
      "event_id": "E02",
      "context_vi": "Bạn tới quầy lễ tân công ty Sakura, có hẹn với Sato ở phòng kinh doanh. Bạn nói rõ công ty, tên mình và người cần gặp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: khách đến thăm",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên lễ tân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "676589ab-bd73-565d-b76d-04f20b266ae6-u01",
          "speaker_id": "a",
          "ja": "みどり商事のリンと申します。午前十時に、営業部の佐藤様とお約束しています。",
          "vi": "Tôi là Linh bên công ty Midori. Tôi có hẹn lúc 10 giờ sáng với chị Sato ở phòng kinh doanh ạ."
        },
        {
          "id": "676589ab-bd73-565d-b76d-04f20b266ae6-u02",
          "speaker_id": "b",
          "ja": "リン様ですね。お約束を確認いたします。",
          "vi": "Chị Linh phải không ạ? Để tôi kiểm tra lịch hẹn."
        }
      ],
      "admin": {
        "source_refs": [
          "visit",
          "main"
        ],
