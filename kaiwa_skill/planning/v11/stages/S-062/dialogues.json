    {
      "situation_uid": "2d3ff9cc-c1b5-572f-91f0-ce3dcea7d1c4",
      "event_id": "E02",
      "context_vi": "Lễ tân báo chị Sato đã họp xong và mời bạn lên phòng họp tầng ba. Bạn cảm ơn và nhắc lại tầng để chắc mình nghe đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: khách đến thăm",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên lễ tân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2d3ff9cc-c1b5-572f-91f0-ce3dcea7d1c4-u01",
          "speaker_id": "b",
          "ja": "お待たせしました。佐藤の会議が終わりましたので、三階の会議室へご案内します。",
          "vi": "Cảm ơn chị đã chờ. Chị Sato đã họp xong. Mời chị theo tôi lên phòng họp tầng ba ạ."
        },
        {
          "id": "2d3ff9cc-c1b5-572f-91f0-ce3dcea7d1c4-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。三階の会議室ですね。",
          "vi": "Cảm ơn anh. Phòng họp tầng ba phải không ạ?"
        },
        {
          "id": "2d3ff9cc-c1b5-572f-91f0-ce3dcea7d1c4-u03",
          "speaker_id": "b",
          "ja": "はい、こちらへどうぞ。",
          "vi": "Vâng. Mời chị theo lối này ạ."
        }
      ],
