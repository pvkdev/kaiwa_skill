          }
        }
      }
    },
    {
      "situation_uid": "61a043c6-250f-5c44-ba06-13570fac5b24",
      "event_id": "E01",
      "context_vi": "Đối tác gọi lại xác nhận cuộc gặp thứ Ba lúc 2 giờ. Bạn hỏi địa điểm, rồi nhắc lại để đi đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên công ty Midori",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đối tác công ty Sakura",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "61a043c6-250f-5c44-ba06-13570fac5b24-u01",
          "speaker_id": "b",
          "ja": "火曜日の二時にお会いできます。",
          "vi": "Tôi gặp bạn lúc 2 giờ thứ Ba được."
        },
        {
          "id": "61a043c6-250f-5c44-ba06-13570fac5b24-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。場所はどちらですか。",
          "vi": "Cảm ơn anh. Địa điểm ở đâu ạ?"
        },
        {
          "id": "61a043c6-250f-5c44-ba06-13570fac5b24-u03",
          "speaker_id": "b",
          "ja": "さくら商事の三階の会議室です。",
          "vi": "Phòng họp tầng ba của công ty Sakura."
        },
        {
          "id": "61a043c6-250f-5c44-ba06-13570fac5b24-u04",
          "speaker_id": "a",
          "ja": "火曜日の二時、三階ですね。",
          "vi": "Thứ Ba lúc 2 giờ, tầng ba ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
