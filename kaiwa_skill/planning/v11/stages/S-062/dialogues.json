    {
      "situation_uid": "3f90c018-e2f0-52ba-b533-9de6826b213a",
      "event_id": "E03",
      "context_vi": "Bạn gặp đối tác lần đầu tại phòng họp. Bạn tự giới thiệu và trao danh thiếp bằng hai tay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên công ty Midori",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đối tác công ty Sakura",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3f90c018-e2f0-52ba-b533-9de6826b213a-u01",
          "speaker_id": "a",
          "ja": "みどり商事のリンと申します。こちら、私の名刺です。よろしくお願いします。",
          "vi": "Tôi là Linh của công ty Midori. Đây là danh thiếp của tôi. Rất mong được làm việc cùng anh."
        },
        {
          "id": "3f90c018-e2f0-52ba-b533-9de6826b213a-u02",
          "speaker_id": "b",
          "ja": "さくら商事の田中です。こちらこそよろしくお願いします。",
          "vi": "Tôi là Tanaka của công ty Sakura. Rất mong được hợp tác với chị."
        }
      ],
