  "dialogues": [
    {
      "situation_uid": "ba028223-a0d1-5aff-a3f5-d94ba9fa5b69",
      "event_id": "E01",
      "context_vi": "Bạn gọi công ty Sakura để xin một cuộc gặp ngắn về tài liệu mới. Bạn đề xuất thứ Ba lúc 2 giờ và chờ họ xác nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên công ty Midori",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đối tác công ty Sakura",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ba028223-a0d1-5aff-a3f5-d94ba9fa5b69-u01",
          "speaker_id": "a",
          "ja": "みどり商事のリンです。新しい資料について、火曜日の二時に少しお会いできますか。",
          "vi": "Tôi là Linh của công ty Midori. Tôi có thể gặp anh ít phút lúc 2 giờ thứ Ba để trao đổi về tài liệu mới không ạ?"
        },
        {
          "id": "ba028223-a0d1-5aff-a3f5-d94ba9fa5b69-u02",
          "speaker_id": "b",
          "ja": "予定を確認して、今日中にお返事します。",
          "vi": "Tôi sẽ kiểm tra lịch và trả lời trong hôm nay."
        },
        {
          "id": "ba028223-a0d1-5aff-a3f5-d94ba9fa5b69-u03",
          "speaker_id": "a",
          "ja": "分かりました。お返事を待ちます。",
          "vi": "Tôi hiểu. Tôi sẽ chờ tin."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ba028223-a0d1-5aff-a3f5-d94ba9fa5b69-u01": {
