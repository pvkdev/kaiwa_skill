          "id": "6e15bebd-4fea-5b91-9a86-01ac9527eec5-u03",
          "speaker_id": "b",
          "ja": "はい、資料を見せていただけますか。",
          "vi": "Vâng, chị cho tôi xem tài liệu được không ạ?"
        }
