  "dialogues": [
    {
      "situation_uid": "e94cafb9-25ad-5799-9b12-4794016bd215",
      "event_id": "E01",
      "context_vi": "Ở công ty Aoba hư cấu, bạn tới văn phòng đúng giờ và báo leader nam đã có mặt để bắt đầu ca.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e94cafb9-25ad-5799-9b12-4794016bd215-u01",
          "speaker_id": "a",
          "ja": "おはようございます。今、着きました。九時から始めます。",
          "vi": "Chào buổi sáng. Tôi vừa đến. Tôi sẽ bắt đầu lúc 9 giờ."
        },
        {
          "id": "e94cafb9-25ad-5799-9b12-4794016bd215-u02",
          "speaker_id": "b",
          "ja": "おはようございます。今日もお願いします。",
          "vi": "Chào buổi sáng. Hôm nay nhờ chị nhé."
        },
        {
          "id": "e94cafb9-25ad-5799-9b12-4794016bd215-u03",
          "speaker_id": "a",
          "ja": "よろしくお願いします。",
          "vi": "Mong anh giúp đỡ."
        }
      ],
      "admin": {
        "source_refs": [
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e94cafb9-25ad-5799-9b12-4794016bd215-u01": {
            "kind": "original_extension"
          },
          "e94cafb9-25ad-5799-9b12-4794016bd215-u02": {
            "kind": "original_extension"
          },
          "e94cafb9-25ad-5799-9b12-4794016bd215-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "84d6eaa8-913b-5fb3-b9f0-768ea6b31bfc",
      "event_id": "E01",
      "context_vi": "Một buổi khác, chuyến tàu bạn đang đi bị trễ trong câu chuyện. Bạn gọi thẳng cho leader Aoba, ước sẽ tới lúc 9:20 thay vì 9:00.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader qua điện thoại",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "84d6eaa8-913b-5fb3-b9f0-768ea6b31bfc-u01",
          "speaker_id": "a",
          "ja": "おはようございます。電車が遅れています。九時二十分ごろ着きます。",
          "vi": "Chào buổi sáng. Tàu tôi đi đang trễ. Khoảng 9 giờ 20 tôi sẽ tới."
        },
        {
          "id": "84d6eaa8-913b-5fb3-b9f0-768ea6b31bfc-u02",
          "speaker_id": "b",
          "ja": "わかりました。着いたら、また教えてください。",
          "vi": "Tôi rõ rồi. Đến nơi thì báo lại nhé."
        },
        {
          "id": "84d6eaa8-913b-5fb3-b9f0-768ea6b31bfc-u03",
          "speaker_id": "a",
          "ja": "はい、連絡します。",
          "vi": "Vâng, tôi sẽ báo."
        }
      ],
      "admin": {
        "source_refs": [
          "contact",
          "brief"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "84d6eaa8-913b-5fb3-b9f0-768ea6b31bfc-u01": {
            "kind": "original_extension"
          },
          "84d6eaa8-913b-5fb3-b9f0-768ea6b31bfc-u02": {
            "kind": "original_extension"
          },
          "84d6eaa8-913b-5fb3-b9f0-768ea6b31bfc-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0f4edf7d-eb2a-5f85-82ac-8d34993e1331",
      "event_id": "E01",
      "context_vi": "Tiếp cuộc gọi báo tàu trễ: bạn thực tế tới Aoba lúc 9:15, sớm hơn dự kiến 9:20. Bạn báo leader và hỏi việc cần làm trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0f4edf7d-eb2a-5f85-82ac-8d34993e1331-u01",
          "speaker_id": "a",
          "ja": "今、着きました。九時十五分です。遅れてすみません。先に何をしますか。",
          "vi": "Tôi vừa tới lúc 9 giờ 15. Xin lỗi vì đến trễ. Tôi làm gì trước ạ?"
        },
        {
          "id": "0f4edf7d-eb2a-5f85-82ac-8d34993e1331-u02",
          "speaker_id": "b",
          "ja": "まず、朝の資料を見てください。",
          "vi": "Trước hết chị xem tài liệu buổi sáng nhé."
        },
        {
          "id": "0f4edf7d-eb2a-5f85-82ac-8d34993e1331-u03",
          "speaker_id": "a",
          "ja": "わかりました。",
          "vi": "Tôi rõ rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "contact",
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0f4edf7d-eb2a-5f85-82ac-8d34993e1331-u01": {
            "kind": "original_extension"
          },
          "0f4edf7d-eb2a-5f85-82ac-8d34993e1331-u02": {
            "kind": "original_extension"
          },
          "0f4edf7d-eb2a-5f85-82ac-8d34993e1331-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "e2f1df04-39b1-5108-9261-139d57d6a35f",
      "event_id": "E01",
      "context_vi": "Một nhánh khác trong cuộc gọi báo tàu trễ: leader tưởng bạn còn ở ga Tokyo, nhưng bạn đang ở ga Shinagawa. Bạn sửa vị trí để anh ấy hiểu ước lượng 9:20.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader qua điện thoại",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e2f1df04-39b1-5108-9261-139d57d6a35f-u01",
          "speaker_id": "b",
          "ja": "まだ東京駅ですか。",
          "vi": "Chị vẫn ở ga Tokyo à?"
        },
        {
          "id": "e2f1df04-39b1-5108-9261-139d57d6a35f-u02",
          "speaker_id": "a",
          "ja": "いいえ、今は品川駅です。九時二十分ごろ着きます。",
          "vi": "Không, giờ tôi ở ga Shinagawa. Khoảng 9 giờ 20 tôi sẽ tới."
        },
        {
          "id": "e2f1df04-39b1-5108-9261-139d57d6a35f-u03",
          "speaker_id": "b",
          "ja": "品川ですね。わかりました。",
          "vi": "Shinagawa nhỉ. Tôi rõ rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "contact"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e2f1df04-39b1-5108-9261-139d57d6a35f-u01": {
            "kind": "original_extension"
          },
          "e2f1df04-39b1-5108-9261-139d57d6a35f-u02": {
            "kind": "original_extension"
          },
          "e2f1df04-39b1-5108-9261-139d57d6a35f-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "941f55c2-bc4d-5da0-a0d8-63ded333d49d",
      "event_id": "E02",
      "context_vi": "Aoba hư cấu cử bạn đi một chuyến công tác ngắn tới đối tác Sakura. Bạn hỏi leader giờ xuất phát và nơi gặp trước khi đi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "941f55c2-bc4d-5da0-a0d8-63ded333d49d-u01",
          "speaker_id": "a",
          "ja": "今日は何時に出ますか。どこで会いますか。",
          "vi": "Hôm nay mình đi lúc mấy giờ? Gặp ở đâu ạ?"
        },
        {
          "id": "941f55c2-bc4d-5da0-a0d8-63ded333d49d-u02",
          "speaker_id": "b",
          "ja": "十時に会社を出ます。入口で会いましょう。",
          "vi": "10 giờ rời công ty. Gặp ở cửa ra vào nhé."
        },
        {
          "id": "941f55c2-bc4d-5da0-a0d8-63ded333d49d-u03",
          "speaker_id": "a",
          "ja": "十時に入口ですね。",
          "vi": "10 giờ ở cửa nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "contact",
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "941f55c2-bc4d-5da0-a0d8-63ded333d49d-u01": {
            "kind": "original_extension"
          },
          "941f55c2-bc4d-5da0-a0d8-63ded333d49d-u02": {
            "kind": "original_extension"
          },
          "941f55c2-bc4d-5da0-a0d8-63ded333d49d-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "54cf86ff-31fe-58bd-8896-138d6725d64d",
      "event_id": "E02",
      "context_vi": "Tiếp kế hoạch rời Aoba lúc 10 giờ: đối tác Sakura hư cấu báo đổi cuộc gặp sang tòa nhà phía nam. Bạn hỏi leader lối vào mới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "54cf86ff-31fe-58bd-8896-138d6725d64d-u01",
          "speaker_id": "b",
          "ja": "さくら社での待ち合わせ場所が南の建物に変わりました。",
          "vi": "Nơi gặp ở Công ty Sakura đổi sang tòa phía nam."
        },
        {
          "id": "54cf86ff-31fe-58bd-8896-138d6725d64d-u02",
          "speaker_id": "a",
          "ja": "南の建物は、どの入口ですか。",
          "vi": "Tòa phía nam vào cửa nào ạ?"
        },
        {
          "id": "54cf86ff-31fe-58bd-8896-138d6725d64d-u03",
          "speaker_id": "b",
          "ja": "一階の正面入口です。",
          "vi": "Cửa chính tầng một."
        },
        {
          "id": "54cf86ff-31fe-58bd-8896-138d6725d64d-u04",
          "speaker_id": "a",
          "ja": "南の建物の正面ですね。",
          "vi": "Cửa chính tòa phía nam nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "contact"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "54cf86ff-31fe-58bd-8896-138d6725d64d-u01": {
            "kind": "original_extension"
          },
