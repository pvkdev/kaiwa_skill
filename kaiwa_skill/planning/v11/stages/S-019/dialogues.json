    {
      "situation_uid": "f18a4f53-4878-5c43-a281-ee8bcc71ce45",
      "event_id": "E03",
      "context_vi": "Một chuyến đi việc ngoài khác tại Sakura kết thúc sớm hơn dự kiến. Bạn báo leader Aoba còn thời gian và hỏi có việc nào nhận tiếp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader qua điện thoại",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f18a4f53-4878-5c43-a281-ee8bcc71ce45-u01",
          "speaker_id": "a",
          "ja": "さくら社の仕事が早く終わりました。次にできる仕事はありますか。",
          "vi": "Việc ở Công ty Sakura xong sớm. Tôi có thể nhận việc nào tiếp ạ?"
        },
        {
          "id": "f18a4f53-4878-5c43-a281-ee8bcc71ce45-u02",
          "speaker_id": "b",
          "ja": "では、戻ってから資料を見てください。",
          "vi": "Vậy khi về, chị xem tài liệu nhé."
        },
        {
          "id": "f18a4f53-4878-5c43-a281-ee8bcc71ce45-u03",
          "speaker_id": "a",
          "ja": "わかりました。今から戻ります。",
          "vi": "Tôi rõ rồi. Tôi về ngay."
        }
      ],
