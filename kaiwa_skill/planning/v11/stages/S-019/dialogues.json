          }
        }
      }
    },
    {
      "situation_uid": "8ba0306f-2836-525b-bd7b-bdf13f940cb0",
      "event_id": "E02",
      "context_vi": "Tiếp sau khi bạn đã tới quầy Sakura và được mời chờ. Bạn không thấy Sato ở sảnh, gọi cho anh ấy để biết đang đợi đâu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hẹn Sato qua điện thoại",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8ba0306f-2836-525b-bd7b-bdf13f940cb0-u01",
          "speaker_id": "a",
          "ja": "さくら社の南の建物、正面受付にいます。佐藤さんはどちらですか。",
          "vi": "Tôi đang ở quầy chính tòa phía nam Công ty Sakura. Anh Sato ở đâu ạ?"
        },
        {
          "id": "8ba0306f-2836-525b-bd7b-bdf13f940cb0-u02",
          "speaker_id": "b",
          "ja": "すみません。今、二階から下ります。そこで待ってください。",
          "vi": "Xin lỗi. Tôi đang xuống từ tầng hai. Chị đợi ở đó nhé."
        },
        {
          "id": "8ba0306f-2836-525b-bd7b-bdf13f940cb0-u03",
          "speaker_id": "a",
          "ja": "はい、受付で待ちます。",
          "vi": "Vâng, tôi sẽ đợi tại quầy."
        }
      ],
      "admin": {
        "source_refs": [
          "visit"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8ba0306f-2836-525b-bd7b-bdf13f940cb0-u01": {
