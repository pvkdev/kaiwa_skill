    {
      "situation_uid": "9ec2abea-ffef-5227-8756-f8a1aba4b93f",
      "event_id": "E03",
      "context_vi": "Một buổi khác, cuộc gặp ở Sakura hư cấu kéo dài. Bạn gọi cho leader Aoba báo sẽ không kịp cuộc họp nội bộ lúc 15 giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader qua điện thoại",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9ec2abea-ffef-5227-8756-f8a1aba4b93f-u01",
          "speaker_id": "a",
          "ja": "さくら社での話が長くなっています。三時の会議に間に合いません。",
          "vi": "Cuộc trao đổi ở Sakura đang kéo dài. Tôi sẽ không kịp cuộc họp lúc 3 giờ."
        },
        {
          "id": "9ec2abea-ffef-5227-8756-f8a1aba4b93f-u02",
          "speaker_id": "b",
          "ja": "わかりました。いつ戻れそうですか。",
          "vi": "Tôi rõ rồi. Khoảng khi nào chị về được?"
        },
        {
          "id": "9ec2abea-ffef-5227-8756-f8a1aba4b93f-u03",
          "speaker_id": "a",
          "ja": "四時ごろです。また連絡します。",
          "vi": "Khoảng 4 giờ. Tôi sẽ báo lại."
        }
      ],
