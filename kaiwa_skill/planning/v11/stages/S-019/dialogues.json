        }
      }
    },
    {
      "situation_uid": "c0b4dc0f-d3f7-5960-88c0-f7dffd4eeca4",
      "event_id": "E02",
      "context_vi": "Bạn tới quầy tòa nhà phía nam của đối tác Sakura hư cấu để gặp anh Sato. Bạn nói mình đã tới và hỏi chỗ đợi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên lễ tân đối tác",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c0b4dc0f-d3f7-5960-88c0-f7dffd4eeca4-u01",
          "speaker_id": "a",
          "ja": "青葉のリンです。佐藤さんに会う約束で来ました。",
          "vi": "Tôi là Linh ở Công ty Aoba. Tôi đến theo hẹn với anh Sato."
        },
        {
          "id": "c0b4dc0f-d3f7-5960-88c0-f7dffd4eeca4-u02",
          "speaker_id": "b",
          "ja": "お待ちしていました。こちらでお待ちください。",
          "vi": "Chúng tôi đang chờ chị. Chị vui lòng đợi bên này."
        },
        {
          "id": "c0b4dc0f-d3f7-5960-88c0-f7dffd4eeca4-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "visit"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c0b4dc0f-d3f7-5960-88c0-f7dffd4eeca4-u01": {
            "kind": "original_extension"
          },
