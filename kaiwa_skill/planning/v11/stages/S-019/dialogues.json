    {
      "situation_uid": "706fb793-7a5f-55de-bd3d-25000a060cae",
      "event_id": "E03",
      "context_vi": "Tiếp cuộc gọi báo không kịp họp lúc 15 giờ. Bạn hỏi đồng nghiệp nam ở Aoba có thể nói phần mở đầu đã chuẩn bị giúp mình không, đồng thời hứa gửi ghi chú.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp qua điện thoại",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "706fb793-7a5f-55de-bd3d-25000a060cae-u01",
          "speaker_id": "a",
          "ja": "三時に間に合いません。最初の説明をお願いできますか。メモを送ります。",
          "vi": "Tôi không kịp lúc 3 giờ. Anh trình bày phần mở đầu giúp được không? Tôi sẽ gửi ghi chú."
        },
        {
          "id": "706fb793-7a5f-55de-bd3d-25000a060cae-u02",
          "speaker_id": "b",
          "ja": "いいですよ。メモを見て話します。",
          "vi": "Được. Tôi sẽ xem ghi chú rồi nói."
        },
        {
          "id": "706fb793-7a5f-55de-bd3d-25000a060cae-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。今、送ります。",
          "vi": "Cảm ơn anh. Tôi gửi ngay."
        }
      ],
