    {
      "situation_uid": "7aae2b82-6d45-5abb-b090-b75e0b28e913",
      "event_id": "E03",
      "context_vi": "Sau khi đồng nghiệp nói giúp phần mở đầu cuộc họp 15 giờ, bạn quay lại Aoba lúc 16 giờ. Bạn hỏi anh ấy mình đã bỏ lỡ phần nào và cảm ơn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7aae2b82-6d45-5abb-b090-b75e0b28e913-u01",
          "speaker_id": "a",
          "ja": "戻りました。最初の説明、ありがとうございました。何を話しましたか。",
          "vi": "Tôi về rồi. Cảm ơn anh đã nói phần mở đầu. Anh đã trình bày những gì?"
        },
        {
          "id": "7aae2b82-6d45-5abb-b090-b75e0b28e913-u02",
          "speaker_id": "b",
          "ja": "資料の一ページ目まで話しました。次は二ページ目です。",
          "vi": "Tôi đã nói đến hết trang một. Tiếp theo là trang hai."
        },
        {
          "id": "7aae2b82-6d45-5abb-b090-b75e0b28e913-u03",
          "speaker_id": "a",
          "ja": "わかりました。二ページ目から確認します。",
          "vi": "Tôi rõ rồi. Tôi sẽ xem từ trang hai."
        }
      ],
