        }
      }
    },
    {
      "situation_uid": "cb43236f-c528-582e-89e6-54d117db2b87",
      "event_id": "E02",
      "context_vi": "Sau khi Sato từ tầng hai xuống quầy Sakura, hai người gặp nhau. Bạn cần quay về Aoba lúc 15 giờ và xác nhận lịch kết thúc với anh ấy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hẹn Sato",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cb43236f-c528-582e-89e6-54d117db2b87-u01",
          "speaker_id": "b",
          "ja": "リンさん、お待たせしました。",
          "vi": "Chị Linh, xin lỗi đã để chị chờ."
        },
        {
          "id": "cb43236f-c528-582e-89e6-54d117db2b87-u02",
          "speaker_id": "a",
          "ja": "お会いできてよかったです。今日は二時半までで大丈夫ですか。三時に会社へ戻る予定です。",
          "vi": "May quá, gặp được anh rồi. Hôm nay mình làm đến 2 giờ rưỡi được không ạ? Tôi dự định về công ty lúc 3 giờ."
        },
        {
          "id": "cb43236f-c528-582e-89e6-54d117db2b87-u03",
          "speaker_id": "b",
          "ja": "はい、その予定です。",
          "vi": "Đúng, lịch là vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "visit",
          "contact"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "cb43236f-c528-582e-89e6-54d117db2b87-u01": {
            "kind": "original_extension"
          },
          "cb43236f-c528-582e-89e6-54d117db2b87-u02": {
            "kind": "original_extension"
          },
