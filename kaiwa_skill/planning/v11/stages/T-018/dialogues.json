          }
        }
      }
    },
    {
      "situation_uid": "57821fbc-0021-5c81-858f-49a0d3f06c0c",
      "event_id": "E02",
      "context_vi": "Bạn gọi trung tâm rác cồng kềnh Suginami đăng ký một ghế và một kệ nhỏ, cho đủ kích thước và địa chỉ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "57821fbc-0021-5c81-858f-49a0d3f06c0c-u01",
          "speaker_id": "a",
          "ja": "椅子一脚と小さな棚一台を申し込みたいです。椅子は八十、四十、四十センチ、棚は九十、六十、三十センチです。",
          "vi": "Tôi muốn đăng ký một ghế và một kệ nhỏ. Ghế 80 x 40 x 40 cm, kệ 90 x 60 x 30 cm."
        },
        {
          "id": "57821fbc-0021-5c81-858f-49a0d3f06c0c-u02",
          "speaker_id": "b",
          "ja": "お住まいの住所と建物名、部屋番号をお願いします。",
          "vi": "Xin địa chỉ, tên tòa nhà và số phòng."
        },
        {
          "id": "57821fbc-0021-5c81-858f-49a0d3f06c0c-u03",
          "speaker_id": "a",
          "ja": "杉並区南町二丁目、さくらハイツ三〇二号室です。",
          "vi": "Sakura Heights phòng 302, Minamimachi 2, Suginami."
        },
        {
          "id": "57821fbc-0021-5c81-858f-49a0d3f06c0c-u04",
          "speaker_id": "b",
          "ja": "二点ですね。収集できる品目と手数料を確認します。",
          "vi": "Hai món ạ. Tôi sẽ kiểm danh mục nhận và phí."
        }
      ],
      "admin": {
        "source_refs": [
          "ward",
          "b08"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "57821fbc-0021-5c81-858f-49a0d3f06c0c-u01": {
