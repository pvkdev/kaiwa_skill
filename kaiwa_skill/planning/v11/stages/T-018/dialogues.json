    {
      "situation_uid": "d0acc54e-fd41-53d7-a3c5-3953ed668b35",
      "event_id": "E05",
      "context_vi": "Ghế không được nhận vì kích thước thực tế khác đăng ký. Bạn thừa nhận đã đo sai và đưa số thật.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đơn vị thu gom",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d0acc54e-fd41-53d7-a3c5-3953ed668b35-u01",
          "speaker_id": "b",
          "ja": "登録では幅四十センチですが、現物はもっと大きいようです。",
          "vi": "Trong đăng ký ghi ngang 40 cm, nhưng đồ thực tế có vẻ lớn hơn."
        },
        {
          "id": "d0acc54e-fd41-53d7-a3c5-3953ed668b35-u02",
          "speaker_id": "a",
          "ja": "すみません。測り直したら幅は六十五センチでした。私の測り間違いです。",
          "vi": "Xin lỗi. Tôi đo lại thấy ngang 65 cm. Tôi đã đo sai."
        },
        {
          "id": "d0acc54e-fd41-53d7-a3c5-3953ed668b35-u03",
          "speaker_id": "b",
          "ja": "その寸法で品目と手数料を確認し直します。",
          "vi": "Tôi sẽ kiểm lại loại đồ và phí theo kích thước đó."
        },
        {
          "id": "d0acc54e-fd41-53d7-a3c5-3953ed668b35-u04",
          "speaker_id": "a",
          "ja": "お願いします。今は椅子を部屋に戻します。",
          "vi": "Nhờ anh. Giờ tôi mang ghế về phòng."
        }
      ],
