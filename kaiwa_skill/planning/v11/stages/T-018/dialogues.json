        {
          "id": "051105d8-671e-59af-80db-20b28990a4e1-u04",
          "speaker_id": "b",
          "ja": "はい。差額の扱いも含めてご案内します。",
          "vi": "Vâng. Tôi sẽ hướng dẫn cả cách xử lý phần chênh."
        }
