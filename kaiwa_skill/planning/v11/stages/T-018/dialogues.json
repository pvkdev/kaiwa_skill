    {
      "situation_uid": "51e72452-564a-5e24-80fa-75680eae11dc",
      "event_id": "E03",
      "context_vi": "Nhân viên nêu lựa chọn đổi ngày hoặc tự mang đến điểm tiếp nhận sau khi đặt lịch. Bạn cân nhắc khả năng của mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "51e72452-564a-5e24-80fa-75680eae11dc-u01",
          "speaker_id": "b",
          "ja": "今週木曜日の椅子はそのままで、棚は別の収集日に変更するか、持ち込みを別に申し込めます。",
          "vi": "Ghế vẫn giữ lịch thứ Năm tuần này; kệ có thể đổi sang ngày gom khác, hoặc đăng ký tự mang tới điểm nhận."
        },
        {
          "id": "51e72452-564a-5e24-80fa-75680eae11dc-u02",
          "speaker_id": "a",
          "ja": "車がないので、別の収集日に変更したいです。空いている日を教えてください。",
          "vi": "Tôi không có xe, nên muốn đổi sang ngày gom khác. Xin cho biết ngày còn lịch."
        },
        {
          "id": "51e72452-564a-5e24-80fa-75680eae11dc-u03",
          "speaker_id": "b",
          "ja": "来週の月曜日なら空いています。",
          "vi": "Thứ Hai tuần sau còn lịch."
        },
        {
          "id": "51e72452-564a-5e24-80fa-75680eae11dc-u04",
          "speaker_id": "a",
          "ja": "その日なら運ぶ人を頼めそうです。確認してから折り返します。",
          "vi": "Hôm đó có lẽ tôi nhờ được người mang giúp. Tôi kiểm rồi gọi lại."
        }
      ],
      "admin": {
