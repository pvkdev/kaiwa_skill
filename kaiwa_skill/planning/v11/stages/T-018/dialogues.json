    {
      "situation_uid": "79821b61-a9c1-5575-8841-82b10985c802",
      "event_id": "E03",
      "context_vi": "Sau khi đặt lịch ghế và kệ, bạn muốn thêm một bàn nhỏ. Bạn gọi hỏi thay đổi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "79821b61-a9c1-5575-8841-82b10985c802-u01",
          "speaker_id": "a",
          "ja": "木曜日の予約に、小さい机を一台追加できますか。",
          "vi": "Tôi thêm một bàn nhỏ vào lịch thứ Năm được không?"
        },
        {
          "id": "79821b61-a9c1-5575-8841-82b10985c802-u02",
          "speaker_id": "b",
          "ja": "大きさと受付番号を伺って、変更できるか確認します。",
          "vi": "Xin kích thước và mã tiếp nhận, tôi sẽ kiểm có thể đổi không."
        },
        {
          "id": "79821b61-a9c1-5575-8841-82b10985c802-u03",
          "speaker_id": "a",
          "ja": "幅七十、奥行き五十、高さ七十五センチです。番号は四五六七です。",
          "vi": "Bàn rộng 70, sâu 50, cao 75 cm. Mã là 4567."
        },
        {
          "id": "79821b61-a9c1-5575-8841-82b10985c802-u04",
          "speaker_id": "b",
          "ja": "ありがとうございます。現在の申込内容を見ます。",
          "vi": "Cảm ơn chị. Tôi xem đăng ký hiện tại."
        }
      ],
