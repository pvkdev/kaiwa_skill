    {
      "situation_uid": "6ae22c1e-6893-5101-9007-2849f20c9aa9",
      "event_id": "E02",
      "context_vi": "Bạn muốn thu gom thứ Ba nhưng lịch đã kín. Bạn hỏi ngày khác phù hợp trước khi chốt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6ae22c1e-6893-5101-9007-2849f20c9aa9-u01",
          "speaker_id": "a",
          "ja": "火曜日を希望していましたが、空きはありませんか。",
          "vi": "Tôi muốn thứ Ba, nhưng không còn lịch phải không?"
        },
        {
          "id": "6ae22c1e-6893-5101-9007-2849f20c9aa9-u02",
          "speaker_id": "b",
          "ja": "火曜日は埋まっています。木曜日なら受け付けられます。",
          "vi": "Thứ Ba đã kín. Thứ Năm thì nhận được."
        },
        {
          "id": "6ae22c1e-6893-5101-9007-2849f20c9aa9-u03",
          "speaker_id": "a",
          "ja": "木曜日なら準備できます。椅子と棚の二点で申し込みます。",
          "vi": "Thứ Năm tôi chuẩn bị được. Xin đăng ký hai món ghế và kệ."
        },
        {
          "id": "6ae22c1e-6893-5101-9007-2849f20c9aa9-u04",
