    {
      "situation_uid": "1690838d-0612-58c9-875f-601e7a96fa65",
      "event_id": "E02",
      "context_vi": "Bạn đã đăng ký ghế và kệ cho thứ Năm tuần sau trước tám giờ. Bạn tưởng phải đặt ở điểm rác chung góc phố, nhưng nhân viên ghi trước tòa nhà. Bạn hỏi lại chính xác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1690838d-0612-58c9-875f-601e7a96fa65-u01",
          "speaker_id": "a",
          "ja": "来週木曜の朝八時までに出す椅子と棚の置き場所を確認したいです。角の普段のごみ集積所ですか。",
          "vi": "Tôi muốn xác nhận chỗ đặt ghế và kệ trước tám giờ sáng thứ Năm tuần sau. Có phải điểm tập kết rác thường ở góc phố không?"
        },
        {
          "id": "1690838d-0612-58c9-875f-601e7a96fa65-u02",
          "speaker_id": "b",
          "ja": "いいえ、今回の申し込みでは、さくらハイツの建物の前です。",
          "vi": "Không, đăng ký lần này ghi trước tòa Sakura Heights."
        },
        {
          "id": "1690838d-0612-58c9-875f-601e7a96fa65-u03",
          "speaker_id": "a",
          "ja": "分かりました。道路側の入口付近で、管理人にも場所を確認します。",
          "vi": "Tôi hiểu. Gần lối vào phía đường, tôi sẽ hỏi quản lý tòa nhà chỗ đặt."
        },
        {
          "id": "1690838d-0612-58c9-875f-601e7a96fa65-u04",
          "speaker_id": "b",
          "ja": "はい。集積所には置かないでください。",
          "vi": "Vâng. Xin đừng đặt ở điểm rác chung."
        }
      ],
      "admin": {
        "source_refs": [
          "ward"
        ],
