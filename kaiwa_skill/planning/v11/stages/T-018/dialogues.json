    {
      "situation_uid": "23c285dc-cf9a-53b7-8e34-7afa12466325",
      "event_id": "E04",
      "context_vi": "Chiếc kệ quá nặng để chuyển ngay; bạn xin hàng xóm ít thời gian và tự gọi người giúp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "hàng xóm hoặc quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "23c285dc-cf9a-53b7-8e34-7afa12466325-u01",
          "speaker_id": "b",
          "ja": "この棚も通路にあります。移動できますか。",
          "vi": "Cái kệ cũng ở lối đi. Chị chuyển được không?"
        },
        {
          "id": "23c285dc-cf9a-53b7-8e34-7afa12466325-u02",
          "speaker_id": "a",
          "ja": "一人では重くて動かせません。申し訳ありません。手伝ってくれる人に今連絡して、時間をお知らせします。",
          "vi": "Một mình tôi không chuyển nổi, xin lỗi. Tôi sẽ gọi người giúp ngay và báo giờ cụ thể."
        },
        {
          "id": "23c285dc-cf9a-53b7-8e34-7afa12466325-u03",
          "speaker_id": "b",
          "ja": "通りにくいので、できるだけ早くお願いします。",
          "vi": "Đi qua khó, xin càng sớm càng tốt."
        },
        {
          "id": "23c285dc-cf9a-53b7-8e34-7afa12466325-u04",
          "speaker_id": "a",
          "ja": "分かりました。まず邪魔にならないよう周りを片づけます。",
          "vi": "Tôi hiểu. Trước mắt tôi dọn đồ xung quanh để đỡ chắn lối."
        }
