    {
      "situation_uid": "4ba719e6-2585-55ea-a532-f25edf17b380",
      "event_id": "E03",
      "context_vi": "Bạn đã đặt lịch nhưng hôm đó không thể tự mang kệ xuống. Bạn báo trước, hỏi cách thay đổi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4ba719e6-2585-55ea-a532-f25edf17b380-u01",
          "speaker_id": "a",
          "ja": "木曜日に棚を下へ運べなくなりました。予約を変更したいんです。",
          "vi": "Thứ Năm tôi không mang kệ xuống được nữa. Tôi muốn đổi lịch."
        },
        {
          "id": "4ba719e6-2585-55ea-a532-f25edf17b380-u02",
          "speaker_id": "b",
          "ja": "椅子も変更しますか。それとも棚だけですか。",
          "vi": "Chị đổi cả ghế hay chỉ kệ?"
        },
        {
          "id": "4ba719e6-2585-55ea-a532-f25edf17b380-u03",
          "speaker_id": "a",
          "ja": "棚だけです。椅子は予定どおり出せます。",
          "vi": "Chỉ kệ thôi. Ghế tôi vẫn đem ra theo lịch."
        },
        {
          "id": "4ba719e6-2585-55ea-a532-f25edf17b380-u04",
          "speaker_id": "b",
          "ja": "では棚の変更方法を確認します。",
          "vi": "Vậy tôi sẽ kiểm cách đổi riêng kệ."
        }
      ],
      "admin": {
