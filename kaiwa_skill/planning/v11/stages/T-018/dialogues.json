    {
      "situation_uid": "fd0473a7-3b13-56ce-a50a-49ba84ef76d2",
      "event_id": "E02",
      "context_vi": "Tiếp lần nhầm chỗ, bạn xác nhận hai món, thứ Năm, trước tám giờ và trước tòa nhà.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fd0473a7-3b13-56ce-a50a-49ba84ef76d2-u01",
          "speaker_id": "a",
          "ja": "確認します。椅子一脚と棚一台、来週木曜日の朝八時までに、さくらハイツの前ですね。",
          "vi": "Tôi xin xác nhận: một ghế, một kệ, trước tám giờ sáng thứ Năm tuần sau, trước tòa Sakura Heights."
        },
        {
          "id": "fd0473a7-3b13-56ce-a50a-49ba84ef76d2-u02",
          "speaker_id": "b",
          "ja": "はい。各品目に必要な処理券を貼り、受付番号も記入してください。",
          "vi": "Vâng. Dán tem xử lý cần thiết cho từng món và ghi mã tiếp nhận."
        },
        {
          "id": "fd0473a7-3b13-56ce-a50a-49ba84ef76d2-u03",
          "speaker_id": "a",
          "ja": "角の集積所ではなく建物の前ですね。ありがとうございます。",
          "vi": "Là trước tòa, không phải điểm ở góc phố. Cảm ơn anh."
        }
      ],
      "admin": {
