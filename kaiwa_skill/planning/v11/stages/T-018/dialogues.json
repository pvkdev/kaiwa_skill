    {
      "situation_uid": "8f8ac343-9c21-5b05-91bc-d7ad0be7b9d7",
      "event_id": "E03",
      "context_vi": "Tiếp lựa chọn đổi kệ sang thứ Hai, bạn gọi lại sau khi tìm được người giúp mang và chốt hai lịch riêng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8f8ac343-9c21-5b05-91bc-d7ad0be7b9d7-u01",
          "speaker_id": "a",
          "ja": "先ほど棚の日を相談しました。運ぶ人が見つかったので、棚は来週月曜日に変更したいです。",
          "vi": "Tôi vừa hỏi đổi ngày cho kệ. Đã tìm được người giúp mang, xin đổi kệ sang thứ Hai tuần sau."
        },
        {
          "id": "8f8ac343-9c21-5b05-91bc-d7ad0be7b9d7-u02",
          "speaker_id": "b",
          "ja": "変更できました。椅子は今週木曜日のままです。",
          "vi": "Đã đổi được. Ghế vẫn là thứ Năm tuần này."
        },
        {
          "id": "8f8ac343-9c21-5b05-91bc-d7ad0be7b9d7-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。棚は月曜日、椅子は木曜日ですね。処理券の記載も確認します。",
          "vi": "Cảm ơn anh. Kệ thứ Hai, ghế thứ Năm. Tôi sẽ kiểm lại chữ ghi trên tem."
        },
        {
          "id": "8f8ac343-9c21-5b05-91bc-d7ad0be7b9d7-u04",
          "speaker_id": "b",
          "ja": "はい。それぞれの日付でご準備ください。",
          "vi": "Vâng. Xin chuẩn bị theo từng ngày."
        }
      ],
      "admin": {
