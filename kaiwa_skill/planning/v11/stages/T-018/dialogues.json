      "event_id": "E03",
      "context_vi": "Lịch thứ Năm không nhận thêm bàn. Bạn hỏi đăng ký ngày khác cho món mới, giữ lịch ghế và kệ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "40a9eab0-5648-5700-8f1e-afd252e94820-u01",
          "speaker_id": "b",
          "ja": "木曜日の予約には、もう机を追加できません。",
          "vi": "Không thể thêm bàn vào lịch thứ Năm."
        },
        {
          "id": "40a9eab0-5648-5700-8f1e-afd252e94820-u02",
          "speaker_id": "a",
          "ja": "分かりました。椅子と棚の予約はそのままで、机だけ別の日に申し込めますか。",
          "vi": "Tôi hiểu. Giữ lịch ghế và kệ, chỉ đăng ký bàn vào ngày khác được không?"
        },
        {
          "id": "40a9eab0-5648-5700-8f1e-afd252e94820-u03",
          "speaker_id": "b",
          "ja": "はい。机の新しい収集日を確認します。",
          "vi": "Được. Tôi sẽ kiểm ngày gom mới cho bàn."
        },
        {
          "id": "40a9eab0-5648-5700-8f1e-afd252e94820-u04",
          "speaker_id": "a",
          "ja": "お願いします。二つの受付番号を混同しないようにします。",
          "vi": "Nhờ anh. Tôi sẽ ghi riêng hai mã để khỏi lẫn."
        }
