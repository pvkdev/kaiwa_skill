          }
        }
      }
    },
    {
      "situation_uid": "d65f87c4-d942-578d-bed8-c4d694c0e2b6",
      "event_id": "E01",
      "context_vi": "Bạn định bỏ ghế cùng chiếc tủ lạnh cũ; bạn hỏi liệu tủ lạnh có cùng luồng thu gom của Suginami không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d65f87c4-d942-578d-bed8-c4d694c0e2b6-u01",
          "speaker_id": "a",
          "ja": "椅子と一緒に冷蔵庫も出せますか。",
          "vi": "Tôi bỏ tủ lạnh cùng ghế được không?"
        },
        {
          "id": "d65f87c4-d942-578d-bed8-c4d694c0e2b6-u02",
          "speaker_id": "b",
          "ja": "冷蔵庫は区の粗大ごみ収集では受け付けません。",
          "vi": "Tủ lạnh không nằm trong chương trình rác cồng kềnh của quận."
        },
        {
          "id": "d65f87c4-d942-578d-bed8-c4d694c0e2b6-u03",
          "speaker_id": "a",
          "ja": "そうですか。冷蔵庫はどこへ相談すればいいですか。",
          "vi": "Vậy à. Tôi nên hỏi bên nào về tủ lạnh?"
        },
        {
          "id": "d65f87c4-d942-578d-bed8-c4d694c0e2b6-u04",
          "speaker_id": "b",
          "ja": "購入店か家電リサイクル受付センターにご相談ください。",
          "vi": "Xin hỏi cửa hàng đã bán hoặc trung tâm tiếp nhận tái chế thiết bị gia dụng."
        }
      ],
      "admin": {
        "source_refs": [
          "ward"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d65f87c4-d942-578d-bed8-c4d694c0e2b6-u01": {
            "kind": "original_extension"
          },
