            "kind": "original_extension"
          },
          "d65f87c4-d942-578d-bed8-c4d694c0e2b6-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "040d6336-e14b-5a8f-bed9-0477a08892d3",
      "event_id": "E01",
      "context_vi": "Nhân viên tưởng bạn muốn trao ghế còn dùng được cho người khác. Bạn đính chính ghế đã gãy và muốn bỏ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "040d6336-e14b-5a8f-bed9-0477a08892d3-u01",
          "speaker_id": "b",
          "ja": "まだ使える椅子なら、譲る方法をお探しですか。",
          "vi": "Nếu ghế còn dùng được, chị muốn tìm cách tặng lại à?"
        },
        {
          "id": "040d6336-e14b-5a8f-bed9-0477a08892d3-u02",
          "speaker_id": "a",
          "ja": "いえ、脚が折れていて使えません。処分したいんです。",
          "vi": "Không ạ, chân ghế đã gãy, không dùng được. Tôi muốn bỏ."
        },
        {
          "id": "040d6336-e14b-5a8f-bed9-0477a08892d3-u03",
          "speaker_id": "b",
          "ja": "分かりました。粗大ごみの申し込みをご案内します。",
          "vi": "Tôi hiểu. Tôi sẽ hướng dẫn đăng ký rác cồng kềnh."
        },
        {
          "id": "040d6336-e14b-5a8f-bed9-0477a08892d3-u04",
          "speaker_id": "a",
          "ja": "お願いします。椅子一脚です。",
          "vi": "Nhờ anh. Một chiếc ghế ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "ward"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "040d6336-e14b-5a8f-bed9-0477a08892d3-u01": {
