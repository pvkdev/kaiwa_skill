    {
      "situation_uid": "5170f635-fba4-5459-aa6d-90ec05476b83",
      "event_id": "E04",
      "context_vi": "Hàng xóm chỉ chiếc ghế chắn lối; bạn tưởng của người khác rồi nhìn lại mã trên tem.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "hàng xóm hoặc quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5170f635-fba4-5459-aa6d-90ec05476b83-u01",
          "speaker_id": "b",
          "ja": "この椅子、リンさんのものですか。通路に置かれています。",
          "vi": "Ghế này của Linh phải không? Nó đang ở lối đi."
        },
        {
          "id": "5170f635-fba4-5459-aa6d-90ec05476b83-u02",
          "speaker_id": "a",
          "ja": "最初は別の方のだと思いましたが、処理券の番号を見ると私のです。すみません。",
          "vi": "Ban đầu tôi tưởng của người khác, nhưng mã trên tem là của tôi. Xin lỗi."
        },
        {
          "id": "5170f635-fba4-5459-aa6d-90ec05476b83-u03",
          "speaker_id": "b",
          "ja": "分かれば大丈夫です。移していただけますか。",
          "vi": "Biết được là tốt rồi. Chị chuyển giúp nhé?"
        },
        {
          "id": "5170f635-fba4-5459-aa6d-90ec05476b83-u04",
          "speaker_id": "a",
          "ja": "はい、私が戻します。",
          "vi": "Vâng, tôi tự mang về."
