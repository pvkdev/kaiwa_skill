      "turns": [
        {
          "id": "44a7e338-c9e2-5c81-91ad-570a3514d69f-u01",
          "speaker_id": "a",
          "ja": "今日の収集に申し込んだ椅子が、まだ建物の前にあります。受付番号四五六七です。",
          "vi": "Ghế tôi đăng ký gom hôm nay vẫn ở trước tòa. Mã tiếp nhận là 4567."
        },
        {
          "id": "44a7e338-c9e2-5c81-91ad-570a3514d69f-u02",
          "speaker_id": "b",
          "ja": "置かれた場所と処理券の記載を確認してもよろしいですか。",
          "vi": "Xin cho tôi kiểm chỗ đặt và chữ ghi trên tem được không?"
        },
        {
          "id": "44a7e338-c9e2-5c81-91ad-570a3514d69f-u03",
          "speaker_id": "a",
          "ja": "入口の道路側に置き、券に日付と番号を書きました。",
          "vi": "Tôi đặt phía đường gần cổng, trên tem ghi ngày và mã."
        },
        {
          "id": "44a7e338-c9e2-5c81-91ad-570a3514d69f-u04",
          "speaker_id": "b",
          "ja": "収集記録を確認します。",
          "vi": "Tôi sẽ kiểm biên bản thu gom."
        }
