    {
      "situation_uid": "c414e140-151d-510a-9165-feee3bbf17eb",
      "event_id": "E04",
      "context_vi": "Bạn đặt ghế ngoài trước ngày hẹn; hàng xóm nhắc gây vướng. Bạn hỏi khi nào đúng lịch.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "hàng xóm hoặc quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c414e140-151d-510a-9165-feee3bbf17eb-u01",
          "speaker_id": "b",
          "ja": "この椅子、収集日より早く出ていて、通りにくいんです。",
          "vi": "Ghế này đặt sớm hơn ngày gom, đi qua khó quá."
        },
        {
          "id": "c414e140-151d-510a-9165-feee3bbf17eb-u02",
          "speaker_id": "a",
          "ja": "すみません。収集日は木曜日です。いつ出すのがよいか、受付で確認します。",
          "vi": "Xin lỗi. Lịch gom là thứ Năm. Tôi sẽ hỏi trung tâm khi nào nên mang ra."
        },
        {
          "id": "c414e140-151d-510a-9165-feee3bbf17eb-u03",
          "speaker_id": "b",
          "ja": "今は通路から移してもらえますか。",
          "vi": "Giờ chị chuyển khỏi lối đi được không?"
        },
        {
