      "path": "kaiwa_skill/knowledge/どんどん話せる！日本語会話フレーズ大特訓 必須700/chapters/04-part4-bamen.md",
      "start_line": 620,
      "end_line": 636,
      "use_vi": "Đọc mẫu hỏi cách bỏ đồ nội thất và lời lưu ý quy tắc địa phương; thoại mới đi vào đăng ký và xử lý sai."
    },
    "ward": {
      "kind": "web",
      "title": "杉並区 — 2026年 ごみと資源の分け方・出し方",
      "url": "https://www.city.suginami.tokyo.jp/documents/715/t2026zentiiki.pdf",
      "accessed": "2026-11-16",
      "use_vi": "Nguồn chính thức của Suginami về cỡ đồ, vật loại trừ, đăng ký, tem, nơi đặt trước nhà và hạn 8 giờ sáng. Lịch trống, mã, tòa nhà và kết quả xe là tình huống giả định."
    }
  },
  "dialogues": [
    {
      "situation_uid": "4a521591-1e1e-5f92-bd3f-45cacb7d8fff",
      "event_id": "E01",
      "context_vi": "Bạn ở Suginami, muốn bỏ một ghế gỗ cũ. Bạn mô tả kích thước với quầy tư vấn rác của quận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4a521591-1e1e-5f92-bd3f-45cacb7d8fff-u01",
          "speaker_id": "a",
          "ja": "古い木の椅子を一脚捨てたいです。高さは八十センチくらいです。粗大ごみになりますか。",
          "vi": "Tôi muốn bỏ một ghế gỗ cũ, cao khoảng 80 cm. Nó là rác cồng kềnh phải không?"
        },
        {
          "id": "4a521591-1e1e-5f92-bd3f-45cacb7d8fff-u02",
          "speaker_id": "b",
          "ja": "杉並区では、家具で一辺がおおむね三十センチを超えるものは、粗大ごみの対象です。",
          "vi": "Ở Suginami, đồ nội thất có một cạnh trên khoảng 30 cm thuộc diện rác cồng kềnh."
        },
        {
          "id": "4a521591-1e1e-5f92-bd3f-45cacb7d8fff-u03",
          "speaker_id": "a",
          "ja": "では、幅と奥行きも測ってから申し込みます。",
          "vi": "Vậy tôi sẽ đo cả ngang và sâu trước khi đăng ký."
        },
        {
          "id": "4a521591-1e1e-5f92-bd3f-45cacb7d8fff-u04",
          "speaker_id": "b",
          "ja": "はい。品目と大きさをお伝えください。",
          "vi": "Vâng. Xin báo loại đồ và kích thước."
        }
      ],
      "admin": {
        "source_refs": [
          "b08",
          "ward"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "4a521591-1e1e-5f92-bd3f-45cacb7d8fff-u01": {
            "kind": "original_extension"
