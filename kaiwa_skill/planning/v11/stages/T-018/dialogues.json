        }
      }
    },
    {
      "situation_uid": "b54c247c-a6e4-5f59-906d-4d807077c92f",
      "event_id": "E01",
      "context_vi": "Tiếp câu hỏi phân loại, bạn nhắc lại ghế thuộc lịch cồng kềnh còn tủ lạnh có đầu mối khác ở Suginami.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b54c247c-a6e4-5f59-906d-4d807077c92f-u01",
          "speaker_id": "a",
          "ja": "確認します。木の椅子は大きさを測って粗大ごみ受付へ、冷蔵庫は購入店か家電リサイクル受付センターですね。",
          "vi": "Tôi xin nhắc lại: ghế gỗ thì đo kích thước rồi đăng ký rác cồng kềnh; tủ lạnh thì hỏi cửa hàng hoặc trung tâm tái chế đồ gia dụng."
        },
        {
          "id": "b54c247c-a6e4-5f59-906d-4d807077c92f-u02",
          "speaker_id": "b",
          "ja": "はい。杉並区ではその扱いです。",
          "vi": "Vâng, Suginami xử lý theo cách đó."
        },
        {
          "id": "b54c247c-a6e4-5f59-906d-4d807077c92f-u03",
          "speaker_id": "a",
          "ja": "分かりました。別々に手続きします。",
          "vi": "Tôi hiểu. Tôi sẽ làm riêng hai việc."
        }
      ],
      "admin": {
        "source_refs": [
          "ward"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b54c247c-a6e4-5f59-906d-4d807077c92f-u01": {
