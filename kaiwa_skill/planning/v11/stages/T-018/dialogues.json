          "040d6336-e14b-5a8f-bed9-0477a08892d3-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "aa4a4245-2325-55c9-935e-573ee167cbf6",
      "event_id": "E01",
      "context_vi": "Tủ lạnh không được thu như rác cồng kềnh ở Suginami. Bạn xin tên đầu mối để hỏi cách xử lý.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "aa4a4245-2325-55c9-935e-573ee167cbf6-u01",
          "speaker_id": "a",
          "ja": "冷蔵庫は粗大ごみと別なんですね。連絡先の名前をもう一度教えてください。",
          "vi": "Tủ lạnh đi theo cách khác rác cồng kềnh nhỉ. Xin nhắc lại tên nơi tôi cần liên hệ."
        },
        {
          "id": "aa4a4245-2325-55c9-935e-573ee167cbf6-u02",
          "speaker_id": "b",
          "ja": "買ったお店、または家電リサイクル受付センターです。",
          "vi": "Là cửa hàng chị mua hoặc trung tâm tiếp nhận tái chế thiết bị gia dụng."
        },
        {
          "id": "aa4a4245-2325-55c9-935e-573ee167cbf6-u03",
          "speaker_id": "a",
          "ja": "先に店へ相談し、難しければセンターへ聞きます。",
          "vi": "Tôi sẽ hỏi cửa hàng trước, nếu không được thì hỏi trung tâm."
        }
      ],
      "admin": {
        "source_refs": [
          "ward"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "aa4a4245-2325-55c9-935e-573ee167cbf6-u01": {
