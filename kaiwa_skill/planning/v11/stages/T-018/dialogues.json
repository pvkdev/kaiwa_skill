        }
      }
    },
    {
      "situation_uid": "e2465c13-e7c5-5b98-9840-1bba16d61170",
      "event_id": "E02",
      "context_vi": "Sau khi đăng ký hai món, bạn hỏi ngày gần nhất và nơi đặt được chỉ định cho tòa nhà.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e2465c13-e7c5-5b98-9840-1bba16d61170-u01",
          "speaker_id": "a",
          "ja": "一番早い収集日はいつですか。置く場所も教えてください。",
          "vi": "Ngày thu sớm nhất là khi nào? Xin cho biết chỗ đặt đồ."
        },
        {
          "id": "e2465c13-e7c5-5b98-9840-1bba16d61170-u02",
          "speaker_id": "b",
          "ja": "今の空きは来週の木曜日です。指定日は朝八時までに建物の前へ出してください。",
          "vi": "Hiện còn thứ Năm tuần sau. Ngày được chỉ định, xin đặt trước tòa nhà trước tám giờ sáng."
        },
        {
          "id": "e2465c13-e7c5-5b98-9840-1bba16d61170-u03",
          "speaker_id": "a",
          "ja": "建物の前のどの辺りか、管理人にも確認します。",
          "vi": "Tôi sẽ hỏi quản lý tòa nhà chỗ cụ thể phía trước."
        },
        {
          "id": "e2465c13-e7c5-5b98-9840-1bba16d61170-u04",
          "speaker_id": "b",
          "ja": "はい。通行を妨げない場所にお願いします。",
          "vi": "Vâng. Xin chọn chỗ không chắn lối đi."
        }
      ],
      "admin": {
        "source_refs": [
          "ward"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e2465c13-e7c5-5b98-9840-1bba16d61170-u01": {
