    {
      "situation_uid": "474c0361-fd17-5e11-a9f6-5f8945f076d7",
      "event_id": "E04",
      "context_vi": "Bạn chấp nhận lời nhắc và chuyển ghế về phòng, hẹn đưa ra đúng sáng thu gom.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "hàng xóm hoặc quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "474c0361-fd17-5e11-a9f6-5f8945f076d7-u01",
          "speaker_id": "a",
          "ja": "椅子を部屋へ戻しました。通路をふさいでしまい、すみませんでした。",
          "vi": "Tôi đã mang ghế về phòng. Xin lỗi vì chắn lối đi."
        },
        {
          "id": "474c0361-fd17-5e11-a9f6-5f8945f076d7-u02",
          "speaker_id": "b",
          "ja": "ありがとうございます。これで通れます。",
          "vi": "Cảm ơn chị. Giờ đi lại được rồi."
        },
        {
          "id": "474c0361-fd17-5e11-a9f6-5f8945f076d7-u03",
          "speaker_id": "a",
          "ja": "木曜日の朝、指定された場所に出します。",
          "vi": "Sáng thứ Năm tôi sẽ đặt đúng nơi đã chỉ."
        },
        {
          "id": "474c0361-fd17-5e11-a9f6-5f8945f076d7-u04",
          "speaker_id": "b",
          "ja": "お願いします。",
          "vi": "Nhờ chị nhé."
        }
      ],
