    {
      "situation_uid": "34abb57f-a39a-58e3-b7aa-29b961a65825",
      "event_id": "E05",
      "context_vi": "Lần sau bạn quay lại Kaze. Bạn thích kiểu phần sau lần trước nhưng muốn dài hơn một chút.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "34abb57f-a39a-58e3-b7aa-29b961a65825-u01",
          "speaker_id": "a",
          "ja": "前回の後ろの形が好きでした。今回は少し長めにしたいです。",
          "vi": "Tôi thích dáng tóc phía sau lần trước. Lần này muốn dài hơn chút."
        },
        {
          "id": "34abb57f-a39a-58e3-b7aa-29b961a65825-u02",
          "speaker_id": "b",
          "ja": "肩より下に残しますか。",
          "vi": "Giữ tóc dài quá vai nhé?"
        },
        {
          "id": "34abb57f-a39a-58e3-b7aa-29b961a65825-u03",
          "speaker_id": "a",
          "ja": "はい。肩より二センチくらい下でお願いします。",
          "vi": "Vâng. Xin để dài hơn vai khoảng hai xăng ti mét."
        },
        {
          "id": "34abb57f-a39a-58e3-b7aa-29b961a65825-u04",
          "speaker_id": "b",
          "ja": "分かりました。切る前に長さを確認します。",
          "vi": "Vâng. Trước khi cắt tôi xác nhận độ dài."
        }
      ],
      "admin": {
