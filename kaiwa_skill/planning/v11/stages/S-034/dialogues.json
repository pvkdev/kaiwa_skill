    {
      "situation_uid": "3317726e-3e84-5210-9155-42efeb656c9d",
      "event_id": "E04",
      "context_vi": "Tại quầy Kaze hư cấu, bạn hiểu giá cắt là 3.000 yên nhưng hóa đơn ghi 4.000 yên. Bạn nhờ nhân viên giải thích, chưa thanh toán.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "3317726e-3e84-5210-9155-42efeb656c9d-u01",
          "speaker_id": "a",
          "ja": "カットは三千円と聞きましたが、会計は四千円ですね。内訳を教えてください。",
          "vi": "Tôi nghe giá cắt là 3.000 yên, nhưng hóa đơn là 4.000 yên. Xin giải thích từng khoản ạ."
        },
        {
          "id": "3317726e-3e84-5210-9155-42efeb656c9d-u02",
          "speaker_id": "b",
          "ja": "確認します。シャンプー千円が入っています。",
          "vi": "Để tôi kiểm tra. Có thêm 1.000 yên tiền gội ạ."
        },
        {
          "id": "3317726e-3e84-5210-9155-42efeb656c9d-u03",
          "speaker_id": "a",
          "ja": "今日はシャンプーを頼んだか、もう一度確認したいです。",
          "vi": "Tôi muốn xác nhận lại hôm nay mình có gọi gội không ạ."
        },
        {
          "id": "3317726e-3e84-5210-9155-42efeb656c9d-u04",
          "speaker_id": "b",
          "ja": "承知しました。記録を確認してからお会計します。",
          "vi": "Vâng. Tôi kiểm lại ghi chép rồi mới thanh toán ạ."
        }
      ],
      "admin": {
