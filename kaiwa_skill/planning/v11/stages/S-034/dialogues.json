    {
      "situation_uid": "e83137b1-a69b-5db2-80f3-a035ba4860fe",
      "event_id": "E05",
      "context_vi": "Bạn đặt lịch lần nữa ở Kaze, nhưng thợ cũ không rảnh. Bạn muốn biết thợ mới có thể xem ghi chú kiểu tóc cũ hay không; chưa giả định tiệm có lưu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e83137b1-a69b-5db2-80f3-a035ba4860fe-u01",
          "speaker_id": "a",
          "ja": "前の担当者は空いていないんですね。前回の髪型のメモはありますか。",
          "vi": "Thợ lần trước không rảnh nhỉ. Tiệm có ghi chú kiểu tóc cũ không ạ?"
        },
        {
          "id": "e83137b1-a69b-5db2-80f3-a035ba4860fe-u02",
          "speaker_id": "b",
          "ja": "記録があるか確認します。写真はお持ちですか。",
          "vi": "Tôi sẽ kiểm tra có lưu không. Anh/chị có ảnh không ạ?"
        },
        {
          "id": "e83137b1-a69b-5db2-80f3-a035ba4860fe-u03",
          "speaker_id": "a",
          "ja": "はい、あります。新しい担当者にも見せたいです。",
          "vi": "Có ạ. Tôi muốn cho thợ mới xem nữa."
        },
        {
          "id": "e83137b1-a69b-5db2-80f3-a035ba4860fe-u04",
          "speaker_id": "b",
          "ja": "分かりました。確認してからご案内します。",
          "vi": "Vâng. Tôi kiểm tra rồi báo anh/chị."
        }
      ],
