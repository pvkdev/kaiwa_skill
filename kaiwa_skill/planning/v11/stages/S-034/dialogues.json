    {
      "situation_uid": "1585a088-144a-53f8-af29-d9f96fc0e86c",
      "event_id": "E04",
      "context_vi": "Vài ngày sau khi cắt ở Kaze, bạn gọi vì ở nhà khó tự sấy giống lúc ở tiệm. Bạn hỏi có thể quay lại nhờ hướng dẫn, chưa giả định miễn phí.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "1585a088-144a-53f8-af29-d9f96fc0e86c-u01",
          "speaker_id": "a",
          "ja": "先日カットしてもらいました。家で同じ形にするのが難しいです。",
          "vi": "Mấy hôm trước tôi cắt tóc ở tiệm. Ở nhà tôi khó tạo dáng giống vậy."
        },
        {
          "id": "1585a088-144a-53f8-af29-d9f96fc0e86c-u02",
          "speaker_id": "b",
          "ja": "そうですか。どの部分でしょうか。",
          "vi": "Vậy ạ. Phần nào khó ạ?"
        },
        {
          "id": "1585a088-144a-53f8-af29-d9f96fc0e86c-u03",
          "speaker_id": "a",
          "ja": "前髪です。もう一度伺って、やり方を聞けますか。",
          "vi": "Phần mái ạ. Tôi ghé lại hỏi cách làm được không?"
        },
        {
          "id": "1585a088-144a-53f8-af29-d9f96fc0e86c-u04",
          "speaker_id": "b",
          "ja": "予定と対応を確認して、折り返します。",
          "vi": "Tôi kiểm tra lịch và cách hỗ trợ rồi gọi lại ạ."
        }
      ],
      "admin": {
