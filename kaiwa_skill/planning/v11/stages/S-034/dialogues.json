    },
    {
      "situation_uid": "26818d73-162a-53a3-8beb-8fc5a5d34aa8",
      "event_id": "E02",
      "context_vi": "Bạn ngồi trước gương tại Kaze. Bạn muốn cắt tóc đến ngang vai nhưng giữ độ dài mái như hiện tại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "26818d73-162a-53a3-8beb-8fc5a5d34aa8-u01",
          "speaker_id": "b",
          "ja": "今日はどのようにしますか。",
          "vi": "Hôm nay anh/chị muốn cắt thế nào?"
        },
        {
          "id": "26818d73-162a-53a3-8beb-8fc5a5d34aa8-u02",
          "speaker_id": "a",
          "ja": "肩くらいの長さにしてください。前髪は今の長さを残したいです。",
          "vi": "Xin cắt đến ngang vai. Tóc mái tôi muốn giữ độ dài hiện tại."
        },
        {
          "id": "26818d73-162a-53a3-8beb-8fc5a5d34aa8-u03",
          "speaker_id": "b",
          "ja": "肩のあたりまで切って、前髪は切らないですね。",
          "vi": "Cắt đến ngang vai, không cắt mái nhé."
        },
        {
          "id": "26818d73-162a-53a3-8beb-8fc5a5d34aa8-u04",
          "speaker_id": "a",
          "ja": "はい、そのとおりです。",
          "vi": "Vâng, đúng vậy ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "salon",
          "shadow_bangs"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "26818d73-162a-53a3-8beb-8fc5a5d34aa8-u01": {
