    {
      "situation_uid": "c50b8f7b-503e-56bf-aea5-b812b31f6560",
      "event_id": "E05",
      "context_vi": "Tóc bạn mọc ra sau lần cắt trước ở Kaze và mái khó giữ nếp như dự tính. Bạn hỏi thợ lần này nên đổi phần nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c50b8f7b-503e-56bf-aea5-b812b31f6560-u01",
          "speaker_id": "a",
          "ja": "前回のあと、前髪が思ったより早く目にかかりました。",
          "vi": "Sau lần trước, mái chạm mắt sớm hơn tôi tưởng."
        },
        {
          "id": "c50b8f7b-503e-56bf-aea5-b812b31f6560-u02",
          "speaker_id": "b",
          "ja": "今回は前髪の量を少し減らしましょうか。",
          "vi": "Lần này giảm độ dày mái một chút nhé?"
        },
        {
          "id": "c50b8f7b-503e-56bf-aea5-b812b31f6560-u03",
          "speaker_id": "a",
          "ja": "長さはあまり短くしたくありません。ほかに方法はありますか。",
          "vi": "Tôi không muốn cắt ngắn nhiều. Còn cách nào khác không?"
        },
        {
          "id": "c50b8f7b-503e-56bf-aea5-b812b31f6560-u04",
          "speaker_id": "b",
          "ja": "分け目を変える方法もあります。鏡で試しましょう。",
          "vi": "Cũng có thể đổi ngôi. Mình thử trước gương nhé."
        }
      ],
      "admin": {
