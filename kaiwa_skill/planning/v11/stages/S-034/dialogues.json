          }
        }
      }
    },
    {
      "situation_uid": "68858b74-c1c7-52f8-81d6-e870feb350a1",
      "event_id": "E01",
      "context_vi": "Bạn hỏi tiệm Kaze hư cấu về lịch ngày mai lúc 14 giờ. Nhân viên phải kiểm tra lịch thợ và hẹn gọi lại chậm nhất 17 giờ hôm nay, nên chưa xác nhận đặt hẹn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "68858b74-c1c7-52f8-81d6-e870feb350a1-u01",
          "speaker_id": "a",
          "ja": "明日の二時にカットをお願いできますか。",
          "vi": "Ngày mai lúc 2 giờ tôi cắt tóc được không ạ?"
        },
        {
          "id": "68858b74-c1c7-52f8-81d6-e870feb350a1-u02",
          "speaker_id": "b",
          "ja": "担当者の予定を確認します。まだ予約は確定していません。",
          "vi": "Tôi kiểm tra lịch thợ. Lịch hẹn chưa được xác nhận ạ."
        },
        {
          "id": "68858b74-c1c7-52f8-81d6-e870feb350a1-u03",
          "speaker_id": "a",
          "ja": "分かりました。いつごろ電話をいただけますか。",
          "vi": "Tôi hiểu. Khoảng khi nào chị gọi lại cho tôi được ạ?"
        },
        {
          "id": "68858b74-c1c7-52f8-81d6-e870feb350a1-u04",
          "speaker_id": "b",
          "ja": "今日の五時までにお電話します。",
          "vi": "Chậm nhất 5 giờ hôm nay tôi sẽ gọi ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "shadow_booking"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "68858b74-c1c7-52f8-81d6-e870feb350a1-u01": {
            "kind": "original_extension"
