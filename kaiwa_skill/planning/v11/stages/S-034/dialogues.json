    {
      "situation_uid": "82250d4d-0331-567c-b6dd-8f5e4a443f54",
      "event_id": "E04",
      "context_vi": "Sau khi thợ Kaze sấy và đổi ngôi mái mà không cắt thêm, bạn nhìn gương và xác nhận đã vừa ý.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "82250d4d-0331-567c-b6dd-8f5e4a443f54-u01",
          "speaker_id": "b",
          "ja": "分け目を変えました。今はいかがですか。",
          "vi": "Tôi đã đổi ngôi. Bây giờ anh/chị thấy sao?"
        },
        {
          "id": "82250d4d-0331-567c-b6dd-8f5e4a443f54-u02",
          "speaker_id": "a",
          "ja": "前髪が軽く見えます。これで気に入りました。",
          "vi": "Mái trông nhẹ hơn. Tôi thích kiểu này rồi."
        },
        {
          "id": "82250d4d-0331-567c-b6dd-8f5e4a443f54-u03",
          "speaker_id": "b",
          "ja": "よかったです。このまま仕上げますね。",
          "vi": "Tốt quá. Tôi hoàn thiện như thế này nhé."
        },
        {
          "id": "82250d4d-0331-567c-b6dd-8f5e4a443f54-u04",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ anh/chị."
        }
      ],
      "admin": {
