    },
    {
      "situation_uid": "2efa1242-7d93-5486-8c14-745ccd71bd4f",
      "event_id": "E02",
      "context_vi": "Thợ ở Kaze gợi ý kiểu tóc có lớp nhẹ. Bạn muốn biết ở nhà có thể tự chăm đơn giản không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2efa1242-7d93-5486-8c14-745ccd71bd4f-u01",
          "speaker_id": "b",
          "ja": "少し段を入れると軽く見えますよ。",
          "vi": "Tỉa một chút lớp thì tóc trông nhẹ hơn đấy."
        },
        {
          "id": "2efa1242-7d93-5486-8c14-745ccd71bd4f-u02",
          "speaker_id": "a",
          "ja": "家で手入れしやすいですか。",
          "vi": "Ở nhà có dễ tự chăm không ạ?"
        },
        {
          "id": "2efa1242-7d93-5486-8c14-745ccd71bd4f-u03",
          "speaker_id": "b",
          "ja": "乾かしてから、手で形を整えるくらいで大丈夫です。",
          "vi": "Sấy khô rồi dùng tay chỉnh dáng một chút là được."
        },
        {
          "id": "2efa1242-7d93-5486-8c14-745ccd71bd4f-u04",
          "speaker_id": "a",
          "ja": "それなら、そのくらいの段にしてください。",
          "vi": "Vậy xin tỉa mức đó ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "salon"
        ],
