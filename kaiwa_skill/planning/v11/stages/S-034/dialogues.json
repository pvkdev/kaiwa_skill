  "dialogues": [
    {
      "situation_uid": "3df7fc70-c3b6-5ba8-a04c-d55677f59a56",
      "event_id": "E01",
      "context_vi": "Bạn gọi tiệm tóc Kaze hư cấu vào buổi sáng và muốn biết chiều nay còn giờ cắt tóc không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "3df7fc70-c3b6-5ba8-a04c-d55677f59a56-u01",
          "speaker_id": "a",
          "ja": "今日の午後、カットできる時間はありますか。",
          "vi": "Chiều nay tiệm còn giờ cắt tóc không ạ?"
        },
        {
          "id": "3df7fc70-c3b6-5ba8-a04c-d55677f59a56-u02",
          "speaker_id": "b",
          "ja": "三時なら空いています。ご希望ですか。",
          "vi": "3 giờ còn trống. Anh/chị muốn giờ đó không ạ?"
        },
        {
          "id": "3df7fc70-c3b6-5ba8-a04c-d55677f59a56-u03",
          "speaker_id": "a",
          "ja": "はい。三時でお願いします。",
          "vi": "Vâng. Cho tôi đặt 3 giờ ạ."
        },
        {
          "id": "3df7fc70-c3b6-5ba8-a04c-d55677f59a56-u04",
          "speaker_id": "b",
          "ja": "お名前を伺ってもいいですか。",
          "vi": "Cho tôi xin tên được không ạ?"
        },
        {
          "id": "3df7fc70-c3b6-5ba8-a04c-d55677f59a56-u05",
          "speaker_id": "a",
          "ja": "グエンです。",
          "vi": "Tôi là Nguyễn ạ."
        },
        {
          "id": "3df7fc70-c3b6-5ba8-a04c-d55677f59a56-u06",
          "speaker_id": "b",
          "ja": "では、グエン様、三時にお待ちしています。",
          "vi": "Vậy chúng tôi chờ anh/chị Nguyễn lúc 3 giờ ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "shadow_booking",
          "salon"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
