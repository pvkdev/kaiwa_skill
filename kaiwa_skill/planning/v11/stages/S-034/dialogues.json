    {
      "situation_uid": "a1563a38-aabd-5478-8fa4-c4e3610daf45",
      "event_id": "E01",
      "context_vi": "Bạn đang đặt lịch tại Kaze hư cấu; nhân viên hỏi muốn chỉ cắt tóc hay gội rồi cắt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "a1563a38-aabd-5478-8fa4-c4e3610daf45-u01",
          "speaker_id": "b",
          "ja": "カットだけですか。シャンプーもしますか。",
          "vi": "Anh/chị chỉ cắt hay gội rồi cắt ạ?"
        },
        {
          "id": "a1563a38-aabd-5478-8fa4-c4e3610daf45-u02",
          "speaker_id": "a",
          "ja": "シャンプーとカットをお願いします。",
          "vi": "Cho tôi gội và cắt ạ."
        },
        {
          "id": "a1563a38-aabd-5478-8fa4-c4e3610daf45-u03",
          "speaker_id": "b",
          "ja": "分かりました。両方で予約します。",
          "vi": "Vâng, tôi đặt cả hai dịch vụ."
        },
        {
          "id": "a1563a38-aabd-5478-8fa4-c4e3610daf45-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn chị."
        }
      ],
      "admin": {
        "source_refs": [
          "shadow_booking",
          "salon"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a1563a38-aabd-5478-8fa4-c4e3610daf45-u01": {
