    {
      "situation_uid": "7ee3c203-8c6c-5d13-8323-4148106ffa7d",
      "event_id": "E04",
      "context_vi": "Bạn thấy phần mái hơi nặng sau cắt. Thợ Kaze đề nghị sấy và rẽ ngôi thay vì cắt ngắn thêm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "7ee3c203-8c6c-5d13-8323-4148106ffa7d-u01",
          "speaker_id": "b",
          "ja": "短く切らずに、乾かして分け目を変えてみますか。",
          "vi": "Không cắt ngắn, tôi sấy và đổi ngôi thử nhé?"
        },
        {
          "id": "7ee3c203-8c6c-5d13-8323-4148106ffa7d-u02",
          "speaker_id": "a",
          "ja": "それなら試したいです。長さは変わりませんね。",
          "vi": "Vậy tôi muốn thử. Độ dài vẫn giữ nguyên chứ?"
        },
        {
          "id": "7ee3c203-8c6c-5d13-8323-4148106ffa7d-u03",
          "speaker_id": "b",
          "ja": "はい。切らずに形だけ変えます。",
          "vi": "Vâng. Không cắt, chỉ đổi dáng thôi."
        },
        {
          "id": "7ee3c203-8c6c-5d13-8323-4148106ffa7d-u04",
          "speaker_id": "a",
          "ja": "お願いします。鏡で見ながら決めます。",
          "vi": "Nhờ anh/chị. Tôi sẽ nhìn gương rồi quyết định."
        }
      ],
