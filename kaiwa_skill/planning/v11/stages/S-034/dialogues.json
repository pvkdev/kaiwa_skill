    {
      "situation_uid": "b946ff89-6986-5d3b-b71f-fc21c4b7885d",
      "event_id": "E05",
      "context_vi": "Sau khi nói mái lần trước sớm chạm mắt, bạn và thợ Kaze thử đổi ngôi trước gương. Bạn chốt giữ độ dài và giảm ít độ dày mái.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b946ff89-6986-5d3b-b71f-fc21c4b7885d-u01",
          "speaker_id": "b",
          "ja": "分け目を変えると、目にかかりにくいですね。",
          "vi": "Đổi ngôi thì mái bớt chạm mắt nhỉ."
        },
        {
          "id": "b946ff89-6986-5d3b-b71f-fc21c4b7885d-u02",
          "speaker_id": "a",
          "ja": "はい。この分け目で、前髪の量だけ少し減らしてください。",
          "vi": "Vâng. Giữ ngôi này và chỉ giảm độ dày mái một chút ạ."
        },
        {
          "id": "b946ff89-6986-5d3b-b71f-fc21c4b7885d-u03",
          "speaker_id": "b",
          "ja": "長さはほとんど変えずに整えます。",
          "vi": "Tôi chỉnh mà gần như không đổi độ dài."
        },
        {
          "id": "b946ff89-6986-5d3b-b71f-fc21c4b7885d-u04",
          "speaker_id": "a",
          "ja": "それでお願いします。途中で一度見せてください。",
          "vi": "Xin làm vậy. Giữa chừng cho tôi xem một lần nhé."
        }
      ],
