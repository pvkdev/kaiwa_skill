          }
        }
      }
    },
    {
      "situation_uid": "23107e6e-75bb-5c4e-9723-146ea4ef5785",
      "event_id": "E01",
      "context_vi": "Tại Kaze hư cấu, bạn muốn cắt lúc 15 giờ với thợ quen, nhưng giờ đó chỉ một thợ khác còn lịch. Bạn quyết định nhận thợ mới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "23107e6e-75bb-5c4e-9723-146ea4ef5785-u01",
          "speaker_id": "b",
          "ja": "三時はいつもの担当者が空いていません。別の者ならできます。",
          "vi": "3 giờ thợ anh/chị thường gặp không rảnh. Thợ khác có thể làm ạ."
        },
        {
          "id": "23107e6e-75bb-5c4e-9723-146ea4ef5785-u02",
          "speaker_id": "a",
          "ja": "その方にお願いできますか。",
          "vi": "Tôi nhờ người đó được không ạ?"
        },
        {
          "id": "23107e6e-75bb-5c4e-9723-146ea4ef5785-u03",
          "speaker_id": "b",
          "ja": "はい。三時にその者で予約します。",
          "vi": "Được ạ. Tôi đặt 3 giờ với người đó nhé."
        },
        {
          "id": "23107e6e-75bb-5c4e-9723-146ea4ef5785-u04",
          "speaker_id": "a",
          "ja": "お願いします。髪型は当日相談します。",
          "vi": "Nhờ chị. Hôm đó tôi sẽ trao đổi kiểu tóc."
        }
      ],
      "admin": {
        "source_refs": [
          "shadow_booking"
        ],
        "specialty_item_ids": [],
