    {
      "situation_uid": "c0f4142f-426e-5f33-807c-f6d802216397",
      "event_id": "E01",
      "context_vi": "Tiệm Kaze gọi lại trước 17 giờ và báo đã có lịch ngày mai 14 giờ cho dịch vụ cắt tóc. Bạn đọc lại trước khi chốt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c0f4142f-426e-5f33-807c-f6d802216397-u01",
          "speaker_id": "b",
          "ja": "お待たせしました。明日の二時、カットでお取りできます。",
          "vi": "Xin lỗi để anh/chị đợi. Ngày mai 2 giờ, tiệm đặt lịch cắt được ạ."
        },
        {
          "id": "c0f4142f-426e-5f33-807c-f6d802216397-u02",
          "speaker_id": "a",
          "ja": "明日の二時に、カットだけですね。",
          "vi": "Ngày mai 2 giờ, chỉ cắt tóc đúng không ạ?"
        },
        {
          "id": "c0f4142f-426e-5f33-807c-f6d802216397-u03",
          "speaker_id": "b",
          "ja": "はい、カットだけで確定します。",
          "vi": "Vâng, tôi xác nhận chỉ cắt tóc."
        },
        {
          "id": "c0f4142f-426e-5f33-807c-f6d802216397-u04",
          "speaker_id": "a",
          "ja": "分かりました。明日伺います。",
          "vi": "Tôi hiểu rồi. Mai tôi đến."
        }
      ],
      "admin": {
        "source_refs": [
          "shadow_booking"
        ],
        "specialty_item_ids": [
          "sj-so-07-b07-162"
        ],
