    {
      "situation_uid": "567e338a-96e9-5142-89e0-9e6ee2934cdc",
      "event_id": "E02",
      "context_vi": "Bạn đưa ảnh kiểu tóc có phần sau rất ngắn nhưng mái trong ảnh dài hơn mái hiện tại. Thợ nói hôm nay không thể làm đúng phần mái trong ảnh; bạn chọn giữ mái và chỉ cắt phần sau.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ tóc",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "567e338a-96e9-5142-89e0-9e6ee2934cdc-u01",
          "speaker_id": "b",
          "ja": "この写真の前髪は今より長いので、今日は同じ形にできません。",
          "vi": "Mái trong ảnh dài hơn mái hiện tại, nên hôm nay không thể làm đúng y như ảnh ạ."
        },
