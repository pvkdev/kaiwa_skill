          "id": "0902a38e-ad39-57cf-b94b-7a5b57ca7ceb-u03",
          "speaker_id": "a",
          "ja": "二階で、左ですね。ありがとうございます。",
          "vi": "Tầng hai, bên trái nhỉ. Cảm ơn anh."
        }
