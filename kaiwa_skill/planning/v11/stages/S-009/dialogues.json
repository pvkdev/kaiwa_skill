            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "aae264c6-0a31-5c77-897a-91c3e432c044",
      "event_id": "E02",
      "context_vi": "Tại một thư viện công của quận Suginami, bạn muốn tìm sách học nấu ăn. Bạn hỏi nhân viên cách tìm theo chủ đề.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thư viện",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "aae264c6-0a31-5c77-897a-91c3e432c044-u01",
          "speaker_id": "a",
          "ja": "料理の本を探しています。どうやって探しますか。",
          "vi": "Tôi đang tìm sách nấu ăn. Tìm thế nào ạ?"
        },
        {
          "id": "aae264c6-0a31-5c77-897a-91c3e432c044-u02",
          "speaker_id": "b",
          "ja": "この機械で「料理」と入れてください。場所も見られます。",
          "vi": "Chị nhập “nấu ăn” vào máy này. Máy cũng cho biết vị trí sách."
        },
        {
          "id": "aae264c6-0a31-5c77-897a-91c3e432c044-u03",
          "speaker_id": "a",
          "ja": "場所もわかるんですね。",
          "vi": "Vậy là biết cả chỗ để sách nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "library",
          "w_find"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "aae264c6-0a31-5c77-897a-91c3e432c044-u01": {
            "kind": "original_extension"
          },
