          },
          "7837ca74-74ed-5073-96c1-34d4511e2308-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "e65239de-ce0a-502e-9eea-c9f85d5d86e4",
      "event_id": "E02",
      "context_vi": "Tại thư viện quận Suginami, bạn chưa mang giấy tờ để làm thẻ mượn. Bạn hỏi nhân viên liệu có thể xem cuốn sách trên kệ tại chỗ hôm nay không; không hỏi dùng phòng đọc phải đặt chỗ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thư viện",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e65239de-ce0a-502e-9eea-c9f85d5d86e4-u01",
          "speaker_id": "a",
          "ja": "今日は書類がありません。この棚の本を、ここで読んでもいいですか。",
          "vi": "Hôm nay tôi không mang giấy tờ. Tôi đọc cuốn trên kệ này tại đây được không ạ?"
        },
        {
          "id": "e65239de-ce0a-502e-9eea-c9f85d5d86e4-u02",
          "speaker_id": "b",
          "ja": "はい、この本はここで読めます。借りるときは登録してください。",
          "vi": "Được, cuốn này chị đọc tại đây được. Khi mượn mang về thì đăng ký nhé."
        },
        {
          "id": "e65239de-ce0a-502e-9eea-c9f85d5d86e4-u03",
          "speaker_id": "a",
          "ja": "わかりました。今日はここで読みます。",
          "vi": "Tôi hiểu rồi. Hôm nay tôi đọc tại đây."
        }
      ],
      "admin": {
        "source_refs": [
          "library",
          "w_reg"
        ],
