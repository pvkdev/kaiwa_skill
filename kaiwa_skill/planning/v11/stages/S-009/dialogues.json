    {
      "situation_uid": "638557bc-6b91-5244-bc29-511a43940698",
      "event_id": "E02",
      "context_vi": "Ở thư viện quận Suginami, màn hình chỉ một cuốn sách nấu ăn ở kệ A, nhưng bạn tìm trên kệ không thấy. Bạn hỏi nhân viên kiểm trạng thái.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thư viện",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "638557bc-6b91-5244-bc29-511a43940698-u01",
          "speaker_id": "a",
          "ja": "この本が棚にありません。もう一度調べてもらえますか。",
          "vi": "Tôi không thấy cuốn này trên kệ. Anh kiểm lại giúp tôi được không ạ?"
        },
        {
          "id": "638557bc-6b91-5244-bc29-511a43940698-u02",
          "speaker_id": "b",
          "ja": "はい。今は貸出中です。",
          "vi": "Vâng. Hiện sách đang được mượn."
        },
        {
          "id": "638557bc-6b91-5244-bc29-511a43940698-u03",
          "speaker_id": "a",
          "ja": "そうですか。また後で来ます。",
          "vi": "Vậy à. Lúc khác tôi quay lại."
        }
      ],
