          "7ec58b68-c5bb-5398-a4f3-aa346d7e46f3-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "6f3e5345-f299-5ebf-8981-1e7233827e41",
      "event_id": "E01",
      "context_vi": "Sau khi biết phòng đọc đóng và thư viện gần cửa bắc ga đang mở trong khu phố Aoba giả định, bạn nhắc lại lối đi trước khi đi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6f3e5345-f299-5ebf-8981-1e7233827e41-u01",
          "speaker_id": "a",
          "ja": "駅の前を通って、北口の図書館ですね。",
          "vi": "Đi ngang trước ga rồi tới thư viện gần cửa bắc nhỉ."
        },
        {
          "id": "6f3e5345-f299-5ebf-8981-1e7233827e41-u02",
          "speaker_id": "b",
          "ja": "はい。北口の右にあります。",
          "vi": "Đúng. Nó ở bên phải cửa bắc."
        },
        {
          "id": "6f3e5345-f299-5ebf-8981-1e7233827e41-u03",
          "speaker_id": "a",
          "ja": "右ですね。助かりました。",
          "vi": "Bên phải nhỉ. Cảm ơn anh, vậy tôi tìm được rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "direction"
        ],
        "specialty_item_ids": [
          "sj-so-02-b07-38"
        ],
        "turn_origins": {
