          "id": "72c6135c-1eeb-5ff1-bb95-a2133be162f4-u02",
          "speaker_id": "b",
          "ja": "五時に来てください。七時までに部屋を出てください。",
          "vi": "Chị đến lúc năm giờ. Rời phòng trước bảy giờ nhé."
        },
        {
          "id": "72c6135c-1eeb-5ff1-bb95-a2133be162f4-u03",
          "speaker_id": "a",
          "ja": "五時に受付、七時までに出ます。",
          "vi": "Năm giờ tới quầy, trước bảy giờ rời phòng ạ."
        }
      ],
