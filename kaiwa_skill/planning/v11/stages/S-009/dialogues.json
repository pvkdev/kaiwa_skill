  "dialogues": [
    {
      "situation_uid": "a83bf3a1-f54e-5ea5-b707-b70ae372d8af",
      "event_id": "E01",
      "context_vi": "Trong khu phố Aoba giả định, bạn mới chuyển đến và hỏi một người địa phương thư viện gần đây ở đâu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a83bf3a1-f54e-5ea5-b707-b70ae372d8af-u01",
          "speaker_id": "a",
          "ja": "すみません、この近くに図書館はありますか。",
          "vi": "Xin lỗi, gần đây có thư viện không ạ?"
        },
        {
          "id": "a83bf3a1-f54e-5ea5-b707-b70ae372d8af-u02",
          "speaker_id": "b",
          "ja": "はい。駅の北口の近くにあります。",
          "vi": "Có. Gần cửa bắc của ga."
        },
        {
          "id": "a83bf3a1-f54e-5ea5-b707-b70ae372d8af-u03",
          "speaker_id": "a",
          "ja": "北口の近くですね。ありがとうございます。",
          "vi": "Gần cửa bắc nhỉ. Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "direction"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a83bf3a1-f54e-5ea5-b707-b70ae372d8af-u01": {
