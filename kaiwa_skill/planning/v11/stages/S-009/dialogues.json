          "b587beea-6b83-580a-a6c2-f1d29c30a8a0-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7ec58b68-c5bb-5398-a4f3-aa346d7e46f3",
      "event_id": "E01",
      "context_vi": "Trong khu phố Aoba giả định, phòng đọc nhỏ bạn định tới hôm nay đóng cửa. Bạn hỏi người địa phương chỗ tương tự đang mở.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7ec58b68-c5bb-5398-a4f3-aa346d7e46f3-u01",
          "speaker_id": "a",
          "ja": "この読書室は今日、閉まっています。ほかに本を読める所はありますか。",
          "vi": "Phòng đọc này hôm nay đóng. Có nơi nào khác đọc sách được không ạ?"
        },
        {
          "id": "7ec58b68-c5bb-5398-a4f3-aa346d7e46f3-u02",
          "speaker_id": "b",
          "ja": "北口の図書館が今日は開いています。駅の前を通ってください。",
          "vi": "Thư viện gần cửa bắc hôm nay mở. Chị đi ngang trước ga nhé."
        },
        {
          "id": "7ec58b68-c5bb-5398-a4f3-aa346d7e46f3-u03",
          "speaker_id": "a",
          "ja": "駅の前を通るんですね。",
          "vi": "Đi ngang trước ga nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "direction"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7ec58b68-c5bb-5398-a4f3-aa346d7e46f3-u01": {
            "kind": "original_extension"
