            "kind": "original_extension"
          },
          "aae264c6-0a31-5c77-897a-91c3e432c044-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7837ca74-74ed-5073-96c1-34d4511e2308",
      "event_id": "E02",
      "context_vi": "Bạn sống ở quận Suginami và đến một thư viện công của quận. Bạn muốn mượn sách mang về nhưng chưa đăng ký.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thư viện",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7837ca74-74ed-5073-96c1-34d4511e2308-u01",
          "speaker_id": "a",
          "ja": "本を借りたいです。何が必要ですか。",
          "vi": "Tôi muốn mượn sách về. Tôi cần gì ạ?"
        },
        {
          "id": "7837ca74-74ed-5073-96c1-34d4511e2308-u02",
          "speaker_id": "b",
          "ja": "利用登録が必要です。住所などを確認できるものはありますか。",
          "vi": "Chị cần đăng ký sử dụng. Chị có giấy tờ xác nhận địa chỉ và thông tin của mình không?"
        },
        {
          "id": "7837ca74-74ed-5073-96c1-34d4511e2308-u03",
          "speaker_id": "a",
          "ja": "今日は持っていません。今度持ってきます。",
          "vi": "Hôm nay tôi không mang. Lần sau tôi sẽ mang ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "library",
          "w_reg"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7837ca74-74ed-5073-96c1-34d4511e2308-u01": {
            "kind": "original_extension"
          },
          "7837ca74-74ed-5073-96c1-34d4511e2308-u02": {
