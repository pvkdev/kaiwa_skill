    {
      "situation_uid": "fb003cc6-86c0-5b0a-8d94-4b49cfcbf37f",
      "event_id": "E03",
      "context_vi": "Tại trung tâm Aoba giả định, bạn muốn dự buổi gặp người mới thứ Bảy này. Bạn hỏi còn chỗ và giờ đến.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fb003cc6-86c0-5b0a-8d94-4b49cfcbf37f-u01",
          "speaker_id": "a",
          "ja": "今週の土曜日の会は、まだ入れますか。何時からですか。",
          "vi": "Buổi thứ Bảy tuần này còn chỗ không ạ? Bắt đầu mấy giờ?"
