          }
        }
      }
    },
    {
      "situation_uid": "7be267bb-a29f-5bbd-9055-058bfcc748cd",
      "event_id": "E01",
      "context_vi": "Trong khu phố Aoba giả định, bạn đã nghe trung tâm cộng đồng nằm sau cửa hàng. Bạn hỏi người địa phương rẽ ở ngã nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7be267bb-a29f-5bbd-9055-058bfcc748cd-u01",
          "speaker_id": "a",
          "ja": "交流センターへは、どこで曲がりますか。",
          "vi": "Đến trung tâm cộng đồng thì rẽ ở đâu ạ?"
        },
        {
          "id": "7be267bb-a29f-5bbd-9055-058bfcc748cd-u02",
          "speaker_id": "b",
          "ja": "あの店の角を右です。",
          "vi": "Rẽ phải ở góc cửa hàng kia."
        },
        {
          "id": "7be267bb-a29f-5bbd-9055-058bfcc748cd-u03",
          "speaker_id": "a",
          "ja": "あの店の角ですね。",
          "vi": "Góc cửa hàng kia nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "direction"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7be267bb-a29f-5bbd-9055-058bfcc748cd-u01": {
            "kind": "original_extension"
