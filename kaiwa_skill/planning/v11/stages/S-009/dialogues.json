          },
          "7be267bb-a29f-5bbd-9055-058bfcc748cd-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "b587beea-6b83-580a-a6c2-f1d29c30a8a0",
      "event_id": "E01",
      "context_vi": "Bạn muốn đi thư viện vào cuối tuần trong khu phố Aoba giả định. Bạn hỏi quầy thông tin nơi nào còn mở, để tự chọn nơi tới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở quầy thông tin",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b587beea-6b83-580a-a6c2-f1d29c30a8a0-u01",
          "speaker_id": "a",
          "ja": "週末に開いている図書館はありますか。",
          "vi": "Cuối tuần có thư viện nào mở không ạ?"
        },
        {
          "id": "b587beea-6b83-580a-a6c2-f1d29c30a8a0-u02",
          "speaker_id": "b",
          "ja": "この地域では、北口の図書館が土曜日に開いています。",
          "vi": "Ở khu này, thư viện gần cửa bắc mở thứ Bảy."
        },
        {
          "id": "b587beea-6b83-580a-a6c2-f1d29c30a8a0-u03",
          "speaker_id": "a",
          "ja": "土曜日ですね。時間も後で確認します。",
          "vi": "Thứ Bảy nhỉ. Tôi sẽ kiểm thêm giờ mở cửa."
        }
      ],
      "admin": {
        "source_refs": [
          "direction"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b587beea-6b83-580a-a6c2-f1d29c30a8a0-u01": {
            "kind": "original_extension"
          },
