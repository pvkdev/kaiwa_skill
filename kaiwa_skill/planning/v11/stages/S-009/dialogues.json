          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thư viện",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5575b364-bb57-5456-af2e-e659cb0b6366-u01",
          "speaker_id": "a",
          "ja": "先日聞いた料理の本は、もう戻りましたか。",
          "vi": "Cuốn sách nấu ăn tôi hỏi hôm trước đã được trả chưa ạ?"
