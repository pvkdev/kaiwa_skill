    {
      "situation_uid": "c04ddadf-d39c-5ba6-b0ee-2e8fe9e3c00a",
      "event_id": "E01",
      "context_vi": "Hai bạn chọn quán ăn để vừa ăn vừa trò chuyện. Bạn nói vì sao thích quán nhỏ mà cả hai từng ghé.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn nêu ý kiến",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng chọn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c04ddadf-d39c-5ba6-b0ee-2e8fe9e3c00a-u01",
          "speaker_id": "A",
          "ja": "前に行った小さい店がいいと思う。",
          "vi": "Tớ nghĩ quán nhỏ lần trước mình đi thì được."
        },
        {
          "id": "c04ddadf-d39c-5ba6-b0ee-2e8fe9e3c00a-u02",
          "speaker_id": "B",
          "ja": "あそこがいいのはどうして？",
          "vi": "Sao cậu thích chỗ đó?"
        },
        {
          "id": "c04ddadf-d39c-5ba6-b0ee-2e8fe9e3c00a-u03",
          "speaker_id": "A",
          "ja": "静かで、ゆっくり話せるから。",
          "vi": "Vì yên tĩnh, mình nói chuyện thong thả được."
        },
        {
          "id": "c04ddadf-d39c-5ba6-b0ee-2e8fe9e3c00a-u04",
          "speaker_id": "B",
          "ja": "そうだね。奥の席なら特に静かだったね。",
          "vi": "Ừ nhỉ. Bàn phía trong đặc biệt yên tĩnh."
        }
      ],
      "admin": {
        "source_refs": [
          "opinion"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c04ddadf-d39c-5ba6-b0ee-2e8fe9e3c00a-u01": {
