    {
      "situation_uid": "8e8c5f9b-e8fc-53a0-8bb1-a7c9650ec6ae",
      "event_id": "E02",
      "context_vi": "Bạn sắp đi chơi trong ngày cùng người quen. Bạn hỏi nên mang gì cho đoạn đi bộ dọc biển mà người đó đã từng đi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người xin lời khuyên",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người từng đi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8e8c5f9b-e8fc-53a0-8bb1-a7c9650ec6ae-u01",
          "speaker_id": "A",
          "ja": "海のそばを歩くとき、何を持っていけばいいですか。",
          "vi": "Đi dọc bờ biển tôi nên mang gì ạ?"
        },
        {
          "id": "8e8c5f9b-e8fc-53a0-8bb1-a7c9650ec6ae-u02",
          "speaker_id": "B",
          "ja": "飲み物と、風が強いときに着る上着があるといいですよ。",
          "vi": "Có nước uống và áo khoác để mặc lúc gió mạnh thì tiện chị ạ."
        },
        {
          "id": "8e8c5f9b-e8fc-53a0-8bb1-a7c9650ec6ae-u03",
          "speaker_id": "A",
          "ja": "大きいリュックはいりますか。",
          "vi": "Tôi có cần balô lớn không?"
        },
        {
          "id": "8e8c5f9b-e8fc-53a0-8bb1-a7c9650ec6ae-u04",
          "speaker_id": "B",
          "ja": "その二つなら、小さいかばんにも入りますよ。",
          "vi": "Hai thứ đó thì túi nhỏ cũng đựng vừa."
        }
      ],
      "admin": {
        "source_refs": [
          "opinion"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8e8c5f9b-e8fc-53a0-8bb1-a7c9650ec6ae-u01": {
