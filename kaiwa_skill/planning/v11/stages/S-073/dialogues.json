    {
      "situation_uid": "b31a65fc-89f8-5585-bb43-1026de89e040",
      "event_id": "E01",
      "context_vi": "Bạn đang chọn chỗ gặp giữa quán cà phê và phòng nghỉ trong thư viện. Bạn muốn nghe bạn mình cân nhắc hai phương án.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hỏi ý kiến",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng chọn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b31a65fc-89f8-5585-bb43-1026de89e040-u01",
          "speaker_id": "A",
          "ja": "カフェと図書館の休憩室、どっちがいいと思う？",
          "vi": "Cậu thấy quán cà phê hay phòng nghỉ ở thư viện tốt hơn?"
        },
        {
          "id": "b31a65fc-89f8-5585-bb43-1026de89e040-u02",
          "speaker_id": "B",
          "ja": "話したいならカフェのほうがいいかな。",
          "vi": "Nếu muốn nói chuyện thì chắc quán cà phê hợp hơn."
        },
        {
          "id": "b31a65fc-89f8-5585-bb43-1026de89e040-u03",
          "speaker_id": "A",
          "ja": "うん。今日は少し話したいな。",
          "vi": "Ừ. Hôm nay tớ muốn ngồi nói chuyện một chút."
        },
        {
          "id": "b31a65fc-89f8-5585-bb43-1026de89e040-u04",
          "speaker_id": "B",
          "ja": "じゃ、カフェにしよう。",
          "vi": "Vậy mình chọn quán cà phê nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "opinion"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b31a65fc-89f8-5585-bb43-1026de89e040-u01": {
