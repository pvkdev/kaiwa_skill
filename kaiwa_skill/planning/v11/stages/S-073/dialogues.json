    {
      "situation_uid": "486f29fe-4f71-57da-882a-fe163585e9fe",
      "event_id": "E04",
      "context_vi": "Bạn nghe hai người nói về “chợ mùa xuân”. Bạn nghĩ là buổi ở trường, người kia nghe tin về chợ ở công viên. Bạn muốn kiểm tên và địa điểm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Thành viên nhóm",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "486f29fe-4f71-57da-882a-fe163585e9fe-u01",
          "speaker_id": "B",
          "ja": "春の市、午後に変わるらしいよ。",
          "vi": "Nghe nói chợ mùa xuân sẽ chuyển sang buổi chiều."
        },
        {
          "id": "486f29fe-4f71-57da-882a-fe163585e9fe-u02",
          "speaker_id": "A",
          "ja": "学校の「春の市」のこと？",
          "vi": "Cậu nói chợ mùa xuân ở trường à?"
        },
        {
          "id": "486f29fe-4f71-57da-882a-fe163585e9fe-u03",
          "speaker_id": "B",
          "ja": "ううん。公園でやるほうだよ。",
          "vi": "Không. Buổi tổ chức ở công viên cơ."
        },
        {
          "id": "486f29fe-4f71-57da-882a-fe163585e9fe-u04",
          "speaker_id": "A",
          "ja": "あ、名前は同じだけど、別のイベントだね。",
          "vi": "À, tên giống nhau nhưng là hai sự kiện khác nhau nhỉ."
        }
      ],
