    {
      "situation_uid": "b0afe0cd-9bd0-51a0-a6b7-bac9d386822b",
      "event_id": "E01",
      "context_vi": "Bạn đề xuất quán lớn ngay trước ga để trò chuyện, nhưng bạn mình không đồng ý. Bạn hỏi lý do trước khi bàn phương án khác.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn nêu ý kiến",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng chọn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b0afe0cd-9bd0-51a0-a6b7-bac9d386822b-u01",
          "speaker_id": "B",
          "ja": "駅前の大きい店は、ちょっとやめたいな。",
          "vi": "Tớ không muốn chọn quán lớn trước ga lắm."
        },
        {
          "id": "b0afe0cd-9bd0-51a0-a6b7-bac9d386822b-u02",
          "speaker_id": "A",
          "ja": "そっか。どうして？",
          "vi": "Vậy à. Sao thế?"
        },
        {
          "id": "b0afe0cd-9bd0-51a0-a6b7-bac9d386822b-u03",
          "speaker_id": "B",
          "ja": "いつも混んでいて、話が聞こえにくいんだ。",
          "vi": "Lúc nào cũng đông nên khó nghe nhau nói."
        },
        {
          "id": "b0afe0cd-9bd0-51a0-a6b7-bac9d386822b-u04",
          "speaker_id": "A",
          "ja": "なるほど。ゆっくり話せるところがいいんだね。",
          "vi": "Ra vậy. Cậu muốn chỗ nói chuyện thong thả được nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "opinion"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b0afe0cd-9bd0-51a0-a6b7-bac9d386822b-u01": {
