      ],
      "turns": [
        {
          "id": "19c47016-a302-513e-a19d-716a246ef232-u01",
          "speaker_id": "A",
          "ja": "係からのお知らせはもう見た？",
          "vi": "Cậu xem thông báo của ban phụ trách chưa?"
        },
        {
          "id": "19c47016-a302-513e-a19d-716a246ef232-u02",
          "speaker_id": "B",
          "ja": "まだ見てない。友達から聞いただけ。",
          "vi": "Tớ chưa thấy. Tớ chỉ nghe một người bạn kể thôi."
        },
        {
          "id": "19c47016-a302-513e-a19d-716a246ef232-u03",
          "speaker_id": "A",
          "ja": "じゃ、掲示板を見てみよう。",
          "vi": "Vậy mình ra xem bảng thông báo thử."
        },
        {
          "id": "19c47016-a302-513e-a19d-716a246ef232-u04",
          "speaker_id": "B",
          "ja": "うん。まだみんなには言わないでおくね。",
          "vi": "Ừ. Tớ sẽ chưa báo cho mọi người."
