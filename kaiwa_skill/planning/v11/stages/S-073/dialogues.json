    {
      "situation_uid": "d53e89da-2a15-5329-8388-929ea68bd6bd",
      "event_id": "E01",
      "context_vi": "Bạn vừa nghe lý do quán lớn trước ga không hợp vì ồn. Hai bạn muốn chốt điều cùng ưu tiên để chọn chỗ khác.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn nêu ý kiến",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng chọn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d53e89da-2a15-5329-8388-929ea68bd6bd-u01",
          "speaker_id": "A",
          "ja": "ふたりとも、静かに話せるところがいいね。",
          "vi": "Cả hai mình đều muốn chỗ yên tĩnh để nói chuyện nhỉ."
        },
        {
          "id": "d53e89da-2a15-5329-8388-929ea68bd6bd-u02",
          "speaker_id": "B",
          "ja": "うん。駅から近いともっといいな。",
          "vi": "Ừ. Gần ga nữa thì càng tốt."
        },
        {
          "id": "d53e89da-2a15-5329-8388-929ea68bd6bd-u03",
          "speaker_id": "A",
          "ja": "じゃ、駅の裏の小さいカフェはどう？ 静かだったよ。",
          "vi": "Vậy quán nhỏ phía sau ga thì sao? Hôm trước tớ thấy yên tĩnh."
        },
        {
          "id": "d53e89da-2a15-5329-8388-929ea68bd6bd-u04",
          "speaker_id": "B",
          "ja": "いいね。そこにしよう。",
          "vi": "Hay đấy. Mình tới đó nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "agree"
        ],
        "specialty_item_ids": [
          "sj-so-16-b11-1"
        ],
        "turn_origins": {
