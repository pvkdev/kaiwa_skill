  "dialogues": [
    {
      "situation_uid": "950f9e3e-e416-5142-9059-08a217d66e06",
      "event_id": "E01",
      "context_vi": "Bạn và bạn mình chọn chỗ gặp một nhóm. Bạn thích phương án gần ga để người lần đầu đến tìm được dễ hơn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn nêu ý kiến",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng chọn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "950f9e3e-e416-5142-9059-08a217d66e06-u01",
          "speaker_id": "A",
          "ja": "私は駅に近いほうがいいな。",
          "vi": "Tớ thích chỗ gần ga hơn."
        },
        {
          "id": "950f9e3e-e416-5142-9059-08a217d66e06-u02",
          "speaker_id": "B",
          "ja": "公園のそばの店もよさそうだよ。",
          "vi": "Quán cạnh công viên cũng có vẻ được đấy."
        },
        {
          "id": "950f9e3e-e416-5142-9059-08a217d66e06-u03",
          "speaker_id": "A",
          "ja": "でも、駅の近くなら初めて来る人も見つけやすいと思う。",
          "vi": "Nhưng tớ nghĩ gần ga thì cả người tới lần đầu cũng dễ tìm."
        },
        {
          "id": "950f9e3e-e416-5142-9059-08a217d66e06-u04",
          "speaker_id": "B",
          "ja": "そっか。じゃ、駅の近くで探そう。",
          "vi": "Ừ nhỉ. Vậy mình tìm quanh ga."
        }
      ],
      "admin": {
        "source_refs": [
          "opinion"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "950f9e3e-e416-5142-9059-08a217d66e06-u01": {
