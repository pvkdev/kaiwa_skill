    {
      "situation_uid": "7188382b-3a15-5264-905e-3610a7f18b4d",
      "event_id": "E04",
      "context_vi": "Bạn và bạn mình chưa thấy thông báo chính thức về giờ bán sách cũ ở trường. Hai người muốn thống nhất ai hỏi thầy phụ trách và khi nào báo lại.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Thành viên nhóm",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng nhóm",
