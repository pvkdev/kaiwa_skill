        {
          "id": "6d0d02b6-08aa-5b6d-8ea2-ec2d6c67a093-u02",
          "speaker_id": "B",
          "ja": "誰から聞いたの？",
          "vi": "Cậu nghe ai nói?"
        },
        {
          "id": "6d0d02b6-08aa-5b6d-8ea2-ec2d6c67a093-u03",
          "speaker_id": "A",
          "ja": "同じクラスの友達だよ。先生には聞いてない。",
          "vi": "Bạn cùng lớp kể. Tớ chưa hỏi thầy."
        },
        {
          "id": "6d0d02b6-08aa-5b6d-8ea2-ec2d6c67a093-u04",
          "speaker_id": "B",
          "ja": "そっか。お知らせが出るまで待とう。",
          "vi": "Vậy à. Mình đợi có thông báo nhé."
        }
