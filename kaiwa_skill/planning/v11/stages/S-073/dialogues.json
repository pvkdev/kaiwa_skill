      "turns": [
        {
          "id": "7188382b-3a15-5264-905e-3610a7f18b4d-u01",
          "speaker_id": "B",
          "ja": "時間のお知らせ、まだ見てないよね。",
          "vi": "Mình vẫn chưa thấy thông báo về giờ nhỉ."
        },
        {
          "id": "7188382b-3a15-5264-905e-3610a7f18b4d-u02",
          "speaker_id": "A",
          "ja": "うん。明日、授業のあとで担当の先生に聞くよ。",
          "vi": "Ừ. Mai tan học tớ hỏi thầy phụ trách."
        },
        {
          "id": "7188382b-3a15-5264-905e-3610a7f18b4d-u03",
          "speaker_id": "B",
          "ja": "わかったら、グループに教えてくれる？",
          "vi": "Biết rồi cậu báo nhóm được không?"
        },
        {
          "id": "7188382b-3a15-5264-905e-3610a7f18b4d-u04",
          "speaker_id": "A",
          "ja": "うん。先生に聞いてから、時間を送るね。",
          "vi": "Ừ. Hỏi thầy xong tớ nhắn giờ nhé."
        }
      ],
