    {
      "situation_uid": "2123dd41-6ae5-5c5d-b7cd-27ceb3c97766",
      "event_id": "E02",
      "context_vi": "Bạn muốn tìm cách nhớ từ tiếng Nhật tốt hơn. Khi xin góp ý, bạn kể mình từng làm gì và ở đâu vẫn vướng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người xin lời khuyên",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2123dd41-6ae5-5c5d-b7cd-27ceb3c97766-u01",
          "speaker_id": "A",
          "ja": "単語のカードはもう作りました。",
          "vi": "Tôi đã làm thẻ từ vựng rồi ạ."
        },
        {
          "id": "2123dd41-6ae5-5c5d-b7cd-27ceb3c97766-u02",
          "speaker_id": "B",
          "ja": "使ってみて、どうでしたか。",
          "vi": "Chị dùng thử thấy thế nào?"
        },
        {
          "id": "2123dd41-6ae5-5c5d-b7cd-27ceb3c97766-u03",
          "speaker_id": "A",
          "ja": "見たらわかります。でも、話すときに出てきません。",
          "vi": "Nhìn thì tôi hiểu. Nhưng khi nói thì không nhớ ra."
        },
        {
          "id": "2123dd41-6ae5-5c5d-b7cd-27ceb3c97766-u04",
          "speaker_id": "B",
          "ja": "じゃ、カードを見て、短い文を声に出すといいですよ。",
          "vi": "Vậy chị thử nhìn thẻ rồi nói thành tiếng một câu ngắn nhé."
        }
      ],
      "admin": {
