    {
      "situation_uid": "22d19b85-b9de-5b88-a4cf-95cc1c7ca36b",
      "event_id": "E04",
      "context_vi": "Hôm sau, bạn đã hỏi trực tiếp thầy phụ trách sau tiết học như đã hẹn. Bạn gặp bạn cùng nhóm và báo giờ mới của buổi bán sách cũ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Thành viên nhóm",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "22d19b85-b9de-5b88-a4cf-95cc1c7ca36b-u01",
          "speaker_id": "A",
          "ja": "先生に聞いたよ。古本市は午後二時の予定だったけど、三時に変わったって。",
          "vi": "Tớ đã hỏi thầy. Buổi bán sách cũ chuyển từ hai giờ sang ba giờ chiều."
        },
        {
          "id": "22d19b85-b9de-5b88-a4cf-95cc1c7ca36b-u02",
          "speaker_id": "B",
          "ja": "場所も変わったの？",
          "vi": "Chỗ tổ chức có đổi không?"
        },
        {
          "id": "22d19b85-b9de-5b88-a4cf-95cc1c7ca36b-u03",
          "speaker_id": "A",
          "ja": "場所は変わってないよ。体育館のままだって。",
          "vi": "Chỗ tổ chức không đổi. Thầy nói vẫn ở nhà thi đấu."
        },
        {
          "id": "22d19b85-b9de-5b88-a4cf-95cc1c7ca36b-u04",
          "speaker_id": "B",
          "ja": "じゃ、三時に体育館だね。",
          "vi": "Vậy ba giờ ở nhà thi đấu nhé."
        },
        {
          "id": "22d19b85-b9de-5b88-a4cf-95cc1c7ca36b-u05",
          "speaker_id": "A",
          "ja": "うん。今、グループにも送るね。",
          "vi": "Ừ. Tớ nhắn cả nhóm ngay đây."
        }
      ],
