    {
      "situation_uid": "1a44850a-4aac-5177-8fe8-fd86fb57aca9",
      "event_id": "E02",
      "context_vi": "Bạn muốn mượn vợt ở buổi tập thử. Người quen chỉ biết giờ tập, nên bạn hỏi ai phụ trách đồ cho mượn và có thể gặp ở đâu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người xin thông tin",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1a44850a-4aac-5177-8fe8-fd86fb57aca9-u01",
          "speaker_id": "A",
          "ja": "初めて行く日に、ラケットを借りられますか。",
          "vi": "Hôm đầu tới tôi có mượn vợt được không ạ?"
        },
        {
