    {
      "situation_uid": "19c47016-a302-513e-a19d-716a246ef232",
      "event_id": "E04",
      "context_vi": "Người cùng nhóm nhắc có thể đổi giờ bán sách cũ. Bạn muốn phân biệt họ đã thấy thông báo chính thức hay chỉ nghe người khác nói.",
      "speakers": [
