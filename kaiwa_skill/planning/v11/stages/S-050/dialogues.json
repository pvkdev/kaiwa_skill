    {
      "situation_uid": "81849603-06ec-5091-97b2-f9c0a688cd3b",
      "event_id": "E04",
      "context_vi": "Bạn quay lại với hộp thuốc đã mua. Trên nhãn ghi 一日一回, nhưng bạn chưa chắc tổng cộng uống mấy lần một ngày.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "81849603-06ec-5091-97b2-f9c0a688cd3b-u01",
          "speaker_id": "a",
          "ja": "ここに「一日一回」とあります。朝と夜に一回ずつですか。",
          "vi": "Ở đây ghi “ichinichi ikkai”. Có phải uống một lần sáng và một lần tối không ạ?"
        },
        {
          "id": "81849603-06ec-5091-97b2-f9c0a688cd3b-u02",
          "speaker_id": "b",
          "ja": "いいえ、この薬は一日の間に一回という意味です。",
          "vi": "Không ạ. Với thuốc này, dòng đó nghĩa là trong cả ngày uống một lần."
        }
      ],
