    {
      "situation_uid": "959c401a-57f5-52d1-b1e5-4f4764f55b17",
      "event_id": "E04",
      "context_vi": "Bạn đang ở hiệu thuốc Midori và hỏi nơi nên liên hệ nếu thấy khó chịu sau khi dùng thuốc. Gần đây bạn đã khám ở phòng khám Midori.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "959c401a-57f5-52d1-b1e5-4f4764f55b17-u01",
          "speaker_id": "a",
          "ja": "この薬を飲んで、具合が悪くなったら、どこに相談すればいいですか。",
          "vi": "Nếu uống thuốc này rồi thấy trong người khó chịu, tôi nên hỏi ở đâu ạ?"
        },
        {
          "id": "959c401a-57f5-52d1-b1e5-4f4764f55b17-u02",
          "speaker_id": "b",
          "ja": "薬について心配なことがあれば、こちらの薬局か、診てもらった先生に相談してください。",
          "vi": "Nếu có điều gì lo về thuốc, chị hỏi nhà thuốc này hoặc bác sĩ đã khám cho chị nhé."
        }
      ],
