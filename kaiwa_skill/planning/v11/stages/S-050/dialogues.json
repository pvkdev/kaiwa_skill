            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d915875d-f139-5125-904f-7325318f7e05",
      "event_id": "E02",
      "context_vi": "Bạn đang dùng thuốc khác và có sổ thuốc. Trước khi chọn thêm sản phẩm, bạn cần dược sĩ kiểm tên thuốc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d915875d-f139-5125-904f-7325318f7e05-u01",
          "speaker_id": "a",
          "ja": "今、別の薬も飲んでいます。この薬と一緒に飲んでも大丈夫ですか。",
          "vi": "Tôi đang uống một loại thuốc khác. Tôi có thể uống cùng thuốc này được không ạ?"
        },
        {
          "id": "d915875d-f139-5125-904f-7325318f7e05-u02",
          "speaker_id": "b",
          "ja": "お薬手帳か、今飲んでいる薬の名前が分かるものを見せてください。確認します。",
          "vi": "Chị cho tôi xem sổ theo dõi thuốc hoặc giấy ghi tên thuốc đang uống nhé. Để tôi kiểm tra ạ."
        },
        {
          "id": "d915875d-f139-5125-904f-7325318f7e05-u03",
          "speaker_id": "a",
          "ja": "お薬手帳を持っています。こちらです。",
          "vi": "Tôi có mang sổ thuốc. Đây ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d915875d-f139-5125-904f-7325318f7e05-u01": {
            "kind": "original_extension"
          },
