    {
      "situation_uid": "1bf2f647-abed-5c00-ab57-d7b516657219",
      "event_id": "E04",
      "context_vi": "Sau khi được dặn liên hệ nhà thuốc hoặc nơi đã khám, bạn hỏi tên đầu mối cụ thể để gọi tiếp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1bf2f647-abed-5c00-ab57-d7b516657219-u01",
          "speaker_id": "a",
          "ja": "こちらに電話するときは、どなたに相談すればいいですか。お名前を聞いてもいいですか。",
          "vi": "Khi gọi nhà thuốc, tôi nên hỏi ai ạ? Cho tôi xin tên anh được không?"
        },
        {
          "id": "1bf2f647-abed-5c00-ab57-d7b516657219-u02",
          "speaker_id": "b",
          "ja": "この薬局の薬剤師、田中です。または、診てもらったみどりクリニックに連絡してください。",
          "vi": "Tôi là Tanaka, dược sĩ ở nhà thuốc này. Bạn cũng có thể liên hệ phòng khám Midori nơi đã khám."
        },
        {
          "id": "1bf2f647-abed-5c00-ab57-d7b516657219-u03",
          "speaker_id": "a",
          "ja": "田中さんか、みどりクリニックですね。ありがとうございます。",
          "vi": "Tôi sẽ hỏi anh Tanaka hoặc phòng khám Midori. Cảm ơn anh."
        }
      ],
