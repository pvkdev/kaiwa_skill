  "dialogues": [
    {
      "situation_uid": "fd3908d7-0b64-5e2c-9e53-957b8da1019f",
      "event_id": "E01",
      "context_vi": "Trong hiệu thuốc Midori hư cấu, bạn muốn hỏi về thuốc và cần tìm quầy có dược sĩ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fd3908d7-0b64-5e2c-9e53-957b8da1019f-u01",
          "speaker_id": "a",
          "ja": "薬のことで相談したいです。薬剤師さんにはどこで聞けますか。",
          "vi": "Tôi muốn hỏi về thuốc. Tôi gặp dược sĩ để hỏi ở đâu ạ?"
        },
        {
          "id": "fd3908d7-0b64-5e2c-9e53-957b8da1019f-u02",
          "speaker_id": "b",
          "ja": "薬のご相談は、奥のカウンターへどうぞ。",
          "vi": "Để hỏi về thuốc, mời chị đến quầy tư vấn phía trong ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fd3908d7-0b64-5e2c-9e53-957b8da1019f-u01": {
            "kind": "original_extension"
          },
          "fd3908d7-0b64-5e2c-9e53-957b8da1019f-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "92c7aa97-e595-5682-96b4-fde94a04cd61",
      "event_id": "E01",
      "context_vi": "Bạn đã đến quầy tư vấn, nhưng dược sĩ phụ trách loại thuốc bạn định hỏi đang vắng. Bạn hỏi lúc nào có thể gặp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "92c7aa97-e595-5682-96b4-fde94a04cd61-u01",
          "speaker_id": "b",
          "ja": "この薬についてお答えできる薬剤師が、今は席を外しています。",
          "vi": "Dược sĩ có thể tư vấn loại thuốc này hiện đang vắng mặt ạ."
        },
        {
          "id": "92c7aa97-e595-5682-96b4-fde94a04cd61-u02",
          "speaker_id": "a",
          "ja": "いつなら相談できますか。",
          "vi": "Khi nào tôi có thể hỏi ạ?"
        },
        {
          "id": "92c7aa97-e595-5682-96b4-fde94a04cd61-u03",
          "speaker_id": "b",
          "ja": "今日の午後二時から薬剤師が戻ります。",
          "vi": "Dược sĩ sẽ có mặt từ 2 giờ chiều nay ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "otc_rules"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "92c7aa97-e595-5682-96b4-fde94a04cd61-u01": {
