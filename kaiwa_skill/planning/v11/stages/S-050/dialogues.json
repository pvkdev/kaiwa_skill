    {
      "situation_uid": "0a50e153-83cf-5133-b635-8223b98e7cbd",
      "event_id": "E03",
      "context_vi": "Dược sĩ vừa chỉ chữ 朝食後 trên hộp. Trước khi mua, bạn kiểm lại bằng lời của mình rằng thuốc này uống sau khi ăn sáng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0a50e153-83cf-5133-b635-8223b98e7cbd-u01",
          "speaker_id": "a",
          "ja": "この薬は、朝ごはんを食べたあとに飲むんですね。",
          "vi": "Vậy thuốc này uống sau khi ăn sáng, đúng không ạ?"
        },
        {
          "id": "0a50e153-83cf-5133-b635-8223b98e7cbd-u02",
          "speaker_id": "b",
          "ja": "はい、この薬は朝ごはんのあとです。",
          "vi": "Đúng ạ, thuốc này uống sau bữa sáng."
        }
      ],
