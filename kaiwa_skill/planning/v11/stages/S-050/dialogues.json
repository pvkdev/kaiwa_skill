          }
        }
      }
    },
    {
      "situation_uid": "f9183463-4bcd-5a71-977a-c351d93b16d6",
      "event_id": "E02",
      "context_vi": "Dược sĩ chỉ vào một hộp sau khi nghe bạn mô tả, nhưng bạn không nghe rõ tên. Bạn xin chỉ chữ trên hộp để nhận đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f9183463-4bcd-5a71-977a-c351d93b16d6-u01",
          "speaker_id": "a",
          "ja": "商品の名前が聞き取れませんでした。箱のどこを見ればいいですか。",
          "vi": "Tôi không nghe rõ tên sản phẩm. Tôi xem chỗ nào trên hộp để nhận đúng ạ?"
        },
        {
          "id": "f9183463-4bcd-5a71-977a-c351d93b16d6-u02",
          "speaker_id": "b",
          "ja": "正面の大きい文字が商品名です。ここです。",
          "vi": "Chữ lớn ở mặt trước là tên sản phẩm. Ở đây ạ."
        },
        {
          "id": "f9183463-4bcd-5a71-977a-c351d93b16d6-u03",
          "speaker_id": "a",
          "ja": "この名前ですね。",
          "vi": "Là tên này phải không ạ?"
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f9183463-4bcd-5a71-977a-c351d93b16d6-u01": {
            "kind": "original_extension"
          },
          "f9183463-4bcd-5a71-977a-c351d93b16d6-u02": {
