    {
      "situation_uid": "8864bbd4-7515-5c9f-aabc-c0c35ac69d10",
      "event_id": "E03",
      "context_vi": "Dược sĩ vừa nói nhãn ghi 朝食後. Bạn xin giải thích bằng từ ngắn, dễ hiểu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8864bbd4-7515-5c9f-aabc-c0c35ac69d10-u01",
          "speaker_id": "a",
          "ja": "すみません。「朝食後」を短い言葉で言ってください。",
          "vi": "Xin lỗi, anh giải thích ngắn gọn “sau bữa sáng” được không ạ?"
        },
        {
