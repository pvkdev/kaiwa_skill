          },
          "f9183463-4bcd-5a71-977a-c351d93b16d6-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "de82c323-cd7b-530f-a2e2-eb9f737ec602",
      "event_id": "E03",
      "context_vi": "Bạn cầm một hộp thuốc giả định tại quầy. Trên nhãn có ghi 朝食後 nhưng bạn chưa hiểu lúc nào dùng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "de82c323-cd7b-530f-a2e2-eb9f737ec602-u01",
          "speaker_id": "a",
          "ja": "この箱には、いつ飲むと書いてありますか。",
          "vi": "Trên hộp này ghi uống khi nào ạ?"
        },
        {
          "id": "de82c323-cd7b-530f-a2e2-eb9f737ec602-u02",
          "speaker_id": "b",
          "ja": "「朝食後」と書いてあります。",
          "vi": "Trên hộp ghi “sau bữa sáng”."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "de82c323-cd7b-530f-a2e2-eb9f737ec602-u01": {
            "kind": "original_extension"
          },
          "de82c323-cd7b-530f-a2e2-eb9f737ec602-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "37cf564c-2b65-570d-a3b3-bb5fe1e48b1d",
      "event_id": "E03",
      "context_vi": "Bạn cầm một hộp thuốc giả định có phần cảnh báo buồn ngủ. Bạn hỏi dược sĩ đọc đúng thông tin trên hộp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "37cf564c-2b65-570d-a3b3-bb5fe1e48b1d-u01",
          "speaker_id": "a",
          "ja": "この薬の箱には、眠気の注意はありますか。",
          "vi": "Trên hộp thuốc này có cảnh báo buồn ngủ không ạ?"
        },
        {
          "id": "37cf564c-2b65-570d-a3b3-bb5fe1e48b1d-u02",
          "speaker_id": "b",
          "ja": "はい。「眠くなることがあります」と書いてあります。",
          "vi": "Có. Trên hộp ghi “có thể gây buồn ngủ”."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
