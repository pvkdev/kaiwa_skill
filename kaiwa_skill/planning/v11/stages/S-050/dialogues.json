          },
          "7a5db36f-57fa-504e-a65e-218c3ba09d69-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d915875d-f139-5125-904f-7325318f7e05",
      "event_id": "E02",
      "context_vi": "Bạn đang dùng thuốc khác và có sổ thuốc. Trước khi chọn thêm sản phẩm, bạn cần dược sĩ kiểm tên thuốc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d915875d-f139-5125-904f-7325318f7e05-u01",
          "speaker_id": "a",
          "ja": "別の薬も飲んでいます。この商品と一緒に使えるか、先に確認してください。",
          "vi": "Tôi còn đang dùng thuốc khác. Nhờ anh kiểm tra trước xem có dùng cùng sản phẩm này được không."
        },
        {
          "id": "d915875d-f139-5125-904f-7325318f7e05-u02",
          "speaker_id": "b",
          "ja": "はい。お薬手帳か薬の名前を見せてください。確認するまで、選ばないでおきましょう。",
          "vi": "Được. Bạn cho tôi xem sổ thuốc hoặc tên thuốc. Ta chưa chọn sản phẩm trước khi kiểm tra."
        },
        {
          "id": "d915875d-f139-5125-904f-7325318f7e05-u03",
          "speaker_id": "a",
          "ja": "お薬手帳を持っています。こちらです。",
          "vi": "Tôi có mang sổ thuốc. Đây ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d915875d-f139-5125-904f-7325318f7e05-u01": {
            "kind": "original_extension"
          },
