    {
      "situation_uid": "db088552-831c-595f-ac3f-051f2120bb8a",
      "event_id": "E04",
      "context_vi": "Bạn đối chiếu hộp vừa mua với tên sản phẩm đã trao đổi ở quầy và thấy khác. Bạn mang hộp quay lại hỏi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "db088552-831c-595f-ac3f-051f2120bb8a-u01",
          "speaker_id": "a",
          "ja": "買った薬の名前が、さっき相談した薬と違います。この箱を見てもらえますか。",
          "vi": "Tên thuốc tôi mua khác với tên thuốc tôi hỏi lúc nãy. Anh xem giúp hộp này được không ạ?"
        },
        {
          "id": "db088552-831c-595f-ac3f-051f2120bb8a-u02",
          "speaker_id": "b",
          "ja": "名前が違いますね。こちらで購入時の内容を確認します。まだ使わずにお待ちください。",
          "vi": "Tên đúng là khác. Để tôi kiểm lại thông tin lúc mua. Chị chờ một chút và khoan dùng thuốc này nhé."
        },
        {
          "id": "db088552-831c-595f-ac3f-051f2120bb8a-u03",
          "speaker_id": "a",
          "ja": "はい、使っていません。ここで待ちます。",
          "vi": "Vâng, tôi chưa dùng. Tôi sẽ chờ ở đây."
        }
      ],
      "admin": {
