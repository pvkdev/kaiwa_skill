  "dialogues": [
    {
      "situation_uid": "fd3908d7-0b64-5e2c-9e53-957b8da1019f",
      "event_id": "E01",
      "context_vi": "Trong hiệu thuốc Midori hư cấu, bạn muốn hỏi về thuốc và cần tìm quầy có dược sĩ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fd3908d7-0b64-5e2c-9e53-957b8da1019f-u01",
          "speaker_id": "a",
          "ja": "薬のことで聞きたいです。薬剤師さんはどちらですか。",
          "vi": "Tôi muốn hỏi về thuốc. Dược sĩ ở đâu ạ?"
        },
        {
          "id": "fd3908d7-0b64-5e2c-9e53-957b8da1019f-u02",
          "speaker_id": "b",
          "ja": "奥の相談カウンターにいます。",
          "vi": "Ở quầy tư vấn phía trong ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fd3908d7-0b64-5e2c-9e53-957b8da1019f-u01": {
            "kind": "original_extension"
          },
          "fd3908d7-0b64-5e2c-9e53-957b8da1019f-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "92c7aa97-e595-5682-96b4-fde94a04cd61",
      "event_id": "E01",
      "context_vi": "Bạn hỏi mua một loại thuốc tại hiệu thuốc Midori hư cấu, nhưng người phụ trách loại đó hiện vắng. Bạn hỏi lúc nào có thể quay lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "92c7aa97-e595-5682-96b4-fde94a04cd61-u01",
          "speaker_id": "b",
          "ja": "今、この薬を相談できる担当者はいません。",
          "vi": "Hiện người phụ trách tư vấn loại thuốc này không có mặt ạ."
        },
        {
          "id": "92c7aa97-e595-5682-96b4-fde94a04cd61-u02",
          "speaker_id": "a",
          "ja": "いつなら相談できますか。",
          "vi": "Khi nào tôi có thể hỏi ạ?"
        },
        {
          "id": "92c7aa97-e595-5682-96b4-fde94a04cd61-u03",
          "speaker_id": "b",
          "ja": "今日は午後二時から担当者がいます。",
          "vi": "Hôm nay từ 2 giờ chiều người phụ trách có mặt."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "92c7aa97-e595-5682-96b4-fde94a04cd61-u01": {
            "kind": "original_extension"
          },
          "92c7aa97-e595-5682-96b4-fde94a04cd61-u02": {
            "kind": "original_extension"
          },
          "92c7aa97-e595-5682-96b4-fde94a04cd61-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "082e8338-68bb-5e7f-bf80-31186557f90c",
      "event_id": "E01",
      "context_vi": "Sản phẩm bạn định mua đã hết ở hiệu thuốc Midori hư cấu. Bạn hỏi người nào có thể tư vấn một lựa chọn phù hợp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "082e8338-68bb-5e7f-bf80-31186557f90c-u01",
          "speaker_id": "a",
          "ja": "探している商品がありません。ほかの選び方を誰に相談できますか。",
          "vi": "Tôi không thấy sản phẩm mình tìm. Tôi nên hỏi ai về lựa chọn khác ạ?"
        },
        {
          "id": "082e8338-68bb-5e7f-bf80-31186557f90c-u02",
          "speaker_id": "b",
          "ja": "奥の相談カウンターにいる薬剤師に聞いてください。",
          "vi": "Bạn hỏi dược sĩ ở quầy tư vấn phía trong nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "082e8338-68bb-5e7f-bf80-31186557f90c-u01": {
            "kind": "original_extension"
          },
          "082e8338-68bb-5e7f-bf80-31186557f90c-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "b7ce67ee-fdac-5597-b040-6cfdf528f656",
      "event_id": "E01",
      "context_vi": "Bạn đang đứng trước kệ mỹ phẩm nhưng tưởng là kệ thuốc ở hiệu thuốc Midori. Bạn hỏi nhân viên để đi đúng kệ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b7ce67ee-fdac-5597-b040-6cfdf528f656-u01",
          "speaker_id": "a",
          "ja": "これは薬ではなく、化粧品ですか。",
          "vi": "Đây không phải thuốc mà là mỹ phẩm phải không ạ?"
        },
        {
          "id": "b7ce67ee-fdac-5597-b040-6cfdf528f656-u02",
          "speaker_id": "b",
          "ja": "はい、化粧品です。薬はこちらの棚です。",
          "vi": "Đúng, là mỹ phẩm. Thuốc ở kệ bên này."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b7ce67ee-fdac-5597-b040-6cfdf528f656-u01": {
            "kind": "original_extension"
          },
          "b7ce67ee-fdac-5597-b040-6cfdf528f656-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7a5db36f-57fa-504e-a65e-218c3ba09d69",
      "event_id": "E02",
      "context_vi": "Bạn đến quầy dược Midori vì đau bụng từ hôm nay. Bạn hỏi dược sĩ có thể nghe nhu cầu trước khi chọn sản phẩm không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7a5db36f-57fa-504e-a65e-218c3ba09d69-u01",
          "speaker_id": "a",
          "ja": "今日からお腹が痛いです。薬について相談できますか。",
          "vi": "Từ hôm nay tôi đau bụng. Tôi có thể hỏi về thuốc không ạ?"
        },
        {
          "id": "7a5db36f-57fa-504e-a65e-218c3ba09d69-u02",
          "speaker_id": "b",
          "ja": "はい。痛む場所と、今の様子を教えてください。",
          "vi": "Được. Bạn cho tôi biết chỗ đau và hiện giờ thấy thế nào."
        },
        {
          "id": "7a5db36f-57fa-504e-a65e-218c3ba09d69-u03",
          "speaker_id": "a",
          "ja": "お腹の真ん中です。今は歩けます。",
          "vi": "Tôi đau giữa bụng. Bây giờ tôi vẫn đi lại được."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7a5db36f-57fa-504e-a65e-218c3ba09d69-u01": {
            "kind": "original_extension"
