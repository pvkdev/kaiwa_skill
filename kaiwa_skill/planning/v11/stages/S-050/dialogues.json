            "kind": "original_extension"
          },
          "d915875d-f139-5125-904f-7325318f7e05-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "03be73d2-16be-55ec-952a-e24b1936a9b6",
      "event_id": "E02",
      "context_vi": "Dược sĩ ở Midori sau khi nghe mô tả bảo bạn nên hỏi cơ sở y tế. Bạn hỏi nơi gần đó có thể liên hệ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "03be73d2-16be-55ec-952a-e24b1936a9b6-u01",
          "speaker_id": "b",
          "ja": "今のお話なら、医療機関に相談してください。",
          "vi": "Với điều bạn vừa kể, bạn nên liên hệ cơ sở y tế ạ."
        },
        {
          "id": "03be73d2-16be-55ec-952a-e24b1936a9b6-u02",
          "speaker_id": "a",
          "ja": "どこに連絡できますか。",
          "vi": "Tôi có thể liên hệ nơi nào ạ?"
        },
        {
          "id": "03be73d2-16be-55ec-952a-e24b1936a9b6-u03",
          "speaker_id": "b",
          "ja": "駅前のみどりクリニックに電話して、今の症状を相談できます。",
          "vi": "Bạn có thể gọi phòng khám Midori trước ga để kể triệu chứng hiện giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "03be73d2-16be-55ec-952a-e24b1936a9b6-u01": {
