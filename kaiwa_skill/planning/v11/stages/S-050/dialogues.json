            "kind": "original_extension"
          },
          "d915875d-f139-5125-904f-7325318f7e05-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "03be73d2-16be-55ec-952a-e24b1936a9b6",
      "event_id": "E02",
      "context_vi": "Dược sĩ ở Midori sau khi nghe mô tả bảo bạn nên hỏi cơ sở y tế. Bạn hỏi nơi gần đó có thể liên hệ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "03be73d2-16be-55ec-952a-e24b1936a9b6-u01",
          "speaker_id": "b",
          "ja": "今のお話なら、まず医療機関で相談したほうがいいです。",
          "vi": "Với tình trạng chị vừa kể, chị nên hỏi cơ sở y tế trước ạ."
        },
        {
          "id": "03be73d2-16be-55ec-952a-e24b1936a9b6-u02",
          "speaker_id": "a",
          "ja": "近くでは、どこに聞けばいいですか。",
          "vi": "Ở gần đây tôi nên hỏi chỗ nào ạ?"
        },
        {
          "id": "03be73d2-16be-55ec-952a-e24b1936a9b6-u03",
          "speaker_id": "b",
          "ja": "駅前のみどりクリニックに電話して、今の症状を伝えてください。診てもらえるか聞いてみてください。",
          "vi": "Chị gọi phòng khám Midori trước ga, nói các triệu chứng hiện tại rồi hỏi họ có thể khám cho chị không nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "medical_search"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "03be73d2-16be-55ec-952a-e24b1936a9b6-u01": {
