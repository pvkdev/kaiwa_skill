    {
      "situation_uid": "37cf564c-2b65-570d-a3b3-bb5fe1e48b1d",
      "event_id": "E03",
      "context_vi": "Bạn muốn biết thuốc đang cầm có thể làm mình buồn ngủ không. Dược sĩ xem mục lưu ý trên hộp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "37cf564c-2b65-570d-a3b3-bb5fe1e48b1d-u01",
          "speaker_id": "a",
          "ja": "この薬を飲むと、眠くなることがありますか。",
          "vi": "Uống thuốc này có thể bị buồn ngủ không ạ?"
        },
        {
          "id": "37cf564c-2b65-570d-a3b3-bb5fe1e48b1d-u02",
          "speaker_id": "b",
          "ja": "はい。「眠くなることがあります」と書いてあります。",
          "vi": "Có. Trên hộp ghi “có thể gây buồn ngủ”."
        }
      ],
      "admin": {
