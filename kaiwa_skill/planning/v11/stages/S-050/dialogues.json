            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "b7ce67ee-fdac-5597-b040-6cfdf528f656",
      "event_id": "E01",
      "context_vi": "Trên đường ra quầy tư vấn, bạn thấy một hộp mình tưởng là thuốc nhưng không chắc. Bạn hỏi nhân viên đang đứng gần kệ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b7ce67ee-fdac-5597-b040-6cfdf528f656-u01",
          "speaker_id": "a",
          "ja": "これは薬ですか。それとも、化粧品ですか。",
          "vi": "Đây là thuốc hay mỹ phẩm ạ?"
        },
        {
          "id": "b7ce67ee-fdac-5597-b040-6cfdf528f656-u02",
          "speaker_id": "b",
          "ja": "はい、化粧品です。薬はこちらの棚です。",
          "vi": "Đây là mỹ phẩm ạ. Thuốc ở kệ bên này."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b7ce67ee-fdac-5597-b040-6cfdf528f656-u01": {
            "kind": "original_extension"
          },
          "b7ce67ee-fdac-5597-b040-6cfdf528f656-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7a5db36f-57fa-504e-a65e-218c3ba09d69",
      "event_id": "E02",
      "context_vi": "Bạn đến quầy dược Midori vì đau bụng từ hôm nay. Bạn hỏi dược sĩ có thể nghe nhu cầu trước khi chọn sản phẩm không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7a5db36f-57fa-504e-a65e-218c3ba09d69-u01",
          "speaker_id": "a",
          "ja": "今日からお腹が痛いです。薬について相談できますか。",
          "vi": "Từ hôm nay tôi đau bụng. Tôi có thể hỏi về thuốc không ạ?"
        },
        {
          "id": "7a5db36f-57fa-504e-a65e-218c3ba09d69-u02",
          "speaker_id": "b",
          "ja": "はい。どの辺りが痛みますか。ずっと痛いですか。",
          "vi": "Được ạ. Chị đau ở chỗ nào? Đau liên tục à chị?"
        },
        {
          "id": "7a5db36f-57fa-504e-a65e-218c3ba09d69-u03",
          "speaker_id": "a",
          "ja": "お腹の真ん中です。痛くなったり、少し楽になったりします。",
          "vi": "Tôi đau ở giữa bụng. Lúc thì đau, lúc lại đỡ một chút ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7a5db36f-57fa-504e-a65e-218c3ba09d69-u01": {
            "kind": "original_extension"
          },
          "7a5db36f-57fa-504e-a65e-218c3ba09d69-u02": {
            "kind": "original_extension"
          },
