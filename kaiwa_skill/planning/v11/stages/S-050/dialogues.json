    },
    {
      "situation_uid": "de82c323-cd7b-530f-a2e2-eb9f737ec602",
      "event_id": "E03",
      "context_vi": "Bạn đưa một hộp thuốc chưa mua cho dược sĩ. Bạn chỉ vào cách dùng trên nhãn và hỏi khi nào uống.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "dược sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "de82c323-cd7b-530f-a2e2-eb9f737ec602-u01",
          "speaker_id": "a",
          "ja": "この薬はいつ飲めばいいですか。",
          "vi": "Thuốc này tôi nên uống khi nào ạ?"
        },
        {
          "id": "de82c323-cd7b-530f-a2e2-eb9f737ec602-u02",
          "speaker_id": "b",
          "ja": "こちらには、「朝食後」と書いてあります。",
          "vi": "Trên nhãn này ghi uống sau bữa sáng ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
