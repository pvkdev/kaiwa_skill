    },
    {
      "situation_uid": "05e4297a-5144-5d2c-b6da-48be3408bf93",
      "event_id": "E01",
      "context_vi": "Ở Komorebi, bàn gần cửa hơi ồn. Bạn hỏi nhân viên đón khách liệu có bàn yên hơn trước khi ngồi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đón khách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "05e4297a-5144-5d2c-b6da-48be3408bf93-u01",
          "speaker_id": "a",
          "ja": "もう少し静かな席はありますか。",
          "vi": "Có bàn nào yên hơn một chút không ạ?"
        },
        {
          "id": "05e4297a-5144-5d2c-b6da-48be3408bf93-u02",
          "speaker_id": "b",
          "ja": "奥の二人席が空いています。そちらはいかがですか。",
          "vi": "Bàn hai người phía trong còn trống. Anh thấy bàn đó được không?"
        },
        {
          "id": "05e4297a-5144-5d2c-b6da-48be3408bf93-u03",
          "speaker_id": "a",
          "ja": "はい、奥の席がいいです。",
          "vi": "Vâng, chúng tôi muốn bàn phía trong."
        },
        {
          "id": "05e4297a-5144-5d2c-b6da-48be3408bf93-u04",
          "speaker_id": "b",
          "ja": "ご案内します。",
          "vi": "Tôi dẫn anh tới nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "entry"
        ],
        "specialty_item_ids": [
          "sj-so-07-b18-10"
        ],
        "turn_origins": {
