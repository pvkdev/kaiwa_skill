    {
      "situation_uid": "77e8a9a6-1981-5576-aa8d-c6f560d917d2",
      "event_id": "E03",
      "context_vi": "Ở Komorebi, món udon bạn đã gọi chưa được mang ra, còn người đi cùng đã có món. Bạn hỏi thời gian ước tính.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phục vụ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "77e8a9a6-1981-5576-aa8d-c6f560d917d2-u01",
          "speaker_id": "a",
          "ja": "うどんはまだですか。あとどれくらいかかりますか。",
          "vi": "Udon của tôi chưa có ạ? Còn khoảng bao lâu nữa?"
        },
        {
          "id": "77e8a9a6-1981-5576-aa8d-c6f560d917d2-u02",
          "speaker_id": "b",
          "ja": "厨房に確認します。少々お待ちください。",
          "vi": "Tôi hỏi bếp rồi báo anh nhé. Xin chờ chút."
        },
        {
          "id": "77e8a9a6-1981-5576-aa8d-c6f560d917d2-u03",
          "speaker_id": "a",
          "ja": "はい、ここで待ちます。",
          "vi": "Vâng, tôi đợi ở bàn."
        }
      ],
