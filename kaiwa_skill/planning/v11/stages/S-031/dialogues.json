    {
      "situation_uid": "5f6bb335-3018-53c4-83c9-0e93cb596648",
      "event_id": "E01",
      "context_vi": "Bạn đến Komorebi hư cấu với hai người nhưng nhà hàng đang hết bàn. Bạn hỏi lúc nào có thể quay lại, chưa có bàn được giữ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đón khách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "5f6bb335-3018-53c4-83c9-0e93cb596648-u01",
          "speaker_id": "b",
          "ja": "申し訳ありません。今は満席です。",
          "vi": "Xin lỗi, hiện quán hết bàn ạ."
        },
        {
          "id": "5f6bb335-3018-53c4-83c9-0e93cb596648-u02",
          "speaker_id": "a",
          "ja": "何時ごろ、もう一度聞けばいいですか。",
          "vi": "Khoảng mấy giờ tôi nên hỏi lại ạ?"
        },
        {
          "id": "5f6bb335-3018-53c4-83c9-0e93cb596648-u03",
          "speaker_id": "b",
          "ja": "七時ごろなら空くかもしれませんが、お約束はできません。",
          "vi": "Khoảng 7 giờ có thể có bàn, nhưng tôi chưa hứa được ạ."
        },
        {
          "id": "5f6bb335-3018-53c4-83c9-0e93cb596648-u04",
          "speaker_id": "a",
          "ja": "分かりました。七時ごろまた聞きます。",
          "vi": "Tôi hiểu rồi. Khoảng 7 giờ tôi hỏi lại."
        }
      ],
      "admin": {
        "source_refs": [
          "entry"
        ],
        "specialty_item_ids": [],
