      "event_id": "E04",
      "context_vi": "Sau khi kiểm đơn ở Komorebi, nhân viên xác nhận salad 300 yên ghi nhầm và bỏ khỏi hóa đơn. Hai ramen 900 yên mỗi bát và trà 200 yên còn tổng 2.000 yên; giá là ví dụ hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "ac29f778-c6a9-5d75-9f87-720e97d99ff8-u01",
          "speaker_id": "b",
          "ja": "サラダは間違いでした。外して、合計二千円です。",
          "vi": "Salad bị ghi nhầm. Tôi bỏ món đó rồi, tổng là 2.000 yên ạ."
        },
        {
          "id": "ac29f778-c6a9-5d75-9f87-720e97d99ff8-u02",
          "speaker_id": "a",
          "ja": "ラーメン二つとお茶一つで、二千円ですね。",
          "vi": "Hai ramen và một trà, 2.000 yên nhỉ."
        },
        {
          "id": "ac29f778-c6a9-5d75-9f87-720e97d99ff8-u03",
          "speaker_id": "b",
          "ja": "はい、その三点です。",
          "vi": "Đúng ạ, ba món đó."
        },
        {
          "id": "ac29f778-c6a9-5d75-9f87-720e97d99ff8-u04",
          "speaker_id": "a",
          "ja": "では、二千円を払います。",
          "vi": "Vậy tôi trả 2.000 yên."
        }
      ],
      "admin": {
