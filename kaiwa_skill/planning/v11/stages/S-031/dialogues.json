          },
          "1a6bc6b7-db0b-5950-a541-f772fe2e6e38-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "699e94ce-9504-5fa7-b0aa-4443aafc41fc",
      "event_id": "E02",
      "context_vi": "Ở Komorebi, bạn và bạn đi cùng định chia món salad, hỏi một phần có đủ cho hai người không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phục vụ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "699e94ce-9504-5fa7-b0aa-4443aafc41fc-u01",
          "speaker_id": "a",
          "ja": "このサラダ一つは、二人で分けられますか。",
          "vi": "Một phần salad này hai người chia được không ạ?"
        },
        {
          "id": "699e94ce-9504-5fa7-b0aa-4443aafc41fc-u02",
          "speaker_id": "b",
          "ja": "小さめです。二人なら二つのほうがよいと思います。",
          "vi": "Phần này hơi nhỏ. Hai người thì tôi nghĩ gọi hai phần hợp hơn."
        },
        {
          "id": "699e94ce-9504-5fa7-b0aa-4443aafc41fc-u03",
          "speaker_id": "a",
          "ja": "では、二つにします。",
          "vi": "Vậy chúng tôi lấy hai phần."
        }
      ],
      "admin": {
        "source_refs": [
          "order"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "699e94ce-9504-5fa7-b0aa-4443aafc41fc-u01": {
