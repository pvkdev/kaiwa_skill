          }
        }
      }
    },
    {
      "situation_uid": "061d58d3-0328-5c7a-99d3-f592d3fb7f33",
      "event_id": "E02",
      "context_vi": "Tại bàn Komorebi, bạn muốn gọi một cơm gà, một mì udon và hai ly trà. Bạn nói rõ số lượng để nhân viên ghi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phục vụ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "061d58d3-0328-5c7a-99d3-f592d3fb7f33-u01",
          "speaker_id": "a",
          "ja": "親子丼を一つ、うどんを一つ、冷たいお茶を二つください。",
          "vi": "Cho chúng tôi một cơm gà trứng, một udon và hai trà lạnh ạ."
        },
        {
          "id": "061d58d3-0328-5c7a-99d3-f592d3fb7f33-u02",
          "speaker_id": "b",
          "ja": "親子丼一つ、うどん一つ、お茶二つですね。",
          "vi": "Một cơm gà trứng, một udon, hai trà nhé ạ."
        },
        {
          "id": "061d58d3-0328-5c7a-99d3-f592d3fb7f33-u03",
          "speaker_id": "a",
          "ja": "はい、それでお願いします。",
          "vi": "Vâng, đúng vậy ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "order"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "061d58d3-0328-5c7a-99d3-f592d3fb7f33-u01": {
