    {
      "situation_uid": "9c8677e4-7096-5fae-bba4-fada80e0ebf3",
      "event_id": "E04",
      "context_vi": "Sau bữa ăn ở Komorebi, bạn về nhà mới thấy quên chiếc ô màu xanh cạnh bàn gần cửa. Bạn gọi quán hỏi, chưa biết ô còn đó không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9c8677e4-7096-5fae-bba4-fada80e0ebf3-u01",
          "speaker_id": "a",
          "ja": "今日そちらで食事をしました。青い傘を忘れたかもしれません。",
          "vi": "Hôm nay tôi ăn ở quán. Có thể tôi quên ô màu xanh ạ."
        },
        {
          "id": "9c8677e4-7096-5fae-bba4-fada80e0ebf3-u02",
          "speaker_id": "b",
          "ja": "どの席でしたか。",
          "vi": "Anh ngồi bàn nào ạ?"
        },
        {
          "id": "9c8677e4-7096-5fae-bba4-fada80e0ebf3-u03",
          "speaker_id": "a",
          "ja": "入口の近くの二人席です。",
          "vi": "Bàn hai người gần cửa ạ."
        },
        {
          "id": "9c8677e4-7096-5fae-bba4-fada80e0ebf3-u04",
          "speaker_id": "b",
          "ja": "確認します。お名前と電話番号を伺ってもいいですか。",
          "vi": "Tôi sẽ kiểm tra. Anh cho tôi xin tên và số điện thoại được không ạ?"
        },
        {
          "id": "9c8677e4-7096-5fae-bba4-fada80e0ebf3-u05",
          "speaker_id": "a",
          "ja": "はい、グエン・アンです。番号を言います。",
          "vi": "Vâng, tôi là Nguyễn An. Tôi đọc số nhé."
        }
      ],
