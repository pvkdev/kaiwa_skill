    {
      "situation_uid": "301fe56d-b82e-5a63-bc6c-2abff30682d7",
      "event_id": "E04",
      "context_vi": "Tại quầy Komorebi, hóa đơn hư cấu của bạn là 1.300 yên, bạn đưa 2.000 yên và kiểm tiền thừa 700 yên.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "301fe56d-b82e-5a63-bc6c-2abff30682d7-u01",
          "speaker_id": "b",
          "ja": "二千円お預かりします。七百円のお返しです。",
          "vi": "Tôi nhận 2.000 yên. Gửi lại anh 700 yên ạ."
        },
        {
          "id": "301fe56d-b82e-5a63-bc6c-2abff30682d7-u02",
          "speaker_id": "a",
          "ja": "七百円ですね。ありがとうございます。",
          "vi": "700 yên nhỉ. Cảm ơn chị."
        },
        {
          "id": "301fe56d-b82e-5a63-bc6c-2abff30682d7-u03",
          "speaker_id": "b",
          "ja": "ありがとうございました。",
          "vi": "Cảm ơn anh ạ."
        },
        {
          "id": "301fe56d-b82e-5a63-bc6c-2abff30682d7-u04",
          "speaker_id": "a",
          "ja": "ごちそうさまでした。",
          "vi": "Cảm ơn bữa ăn ạ."
        }
      ],
