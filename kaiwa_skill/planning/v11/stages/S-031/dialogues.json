          }
        }
      }
    },
    {
      "situation_uid": "9c24d4d6-f694-539b-88f3-cd4f8f98f34e",
      "event_id": "E01",
      "context_vi": "Sau khi đồng ý dùng bàn Komorebi đến 19:00, bạn và người đi cùng được dẫn tới bàn cho hai người. Bạn xác nhận đúng số ghế.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đón khách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9c24d4d6-f694-539b-88f3-cd4f8f98f34e-u01",
          "speaker_id": "b",
          "ja": "お待たせしました。こちらが二名様のお席です。",
          "vi": "Xin lỗi để anh chờ. Bàn hai người của anh ở đây ạ."
        },
        {
          "id": "9c24d4d6-f694-539b-88f3-cd4f8f98f34e-u02",
          "speaker_id": "a",
          "ja": "二人です。ここで大丈夫です。",
          "vi": "Chúng tôi có hai người. Bàn này được ạ."
        },
        {
          "id": "9c24d4d6-f694-539b-88f3-cd4f8f98f34e-u03",
          "speaker_id": "b",
          "ja": "では、ごゆっくりどうぞ。",
          "vi": "Vậy mời anh ngồi ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "entry"
        ],
        "specialty_item_ids": [
          "sj-so-07-b07-162"
        ],
        "turn_origins": {
          "9c24d4d6-f694-539b-88f3-cd4f8f98f34e-u01": {
            "kind": "original_extension"
          },
