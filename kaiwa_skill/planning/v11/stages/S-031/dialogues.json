  "dialogues": [
    {
      "situation_uid": "24d7ec27-7a30-5973-98ef-61bcc26a8de5",
      "event_id": "E01",
      "context_vi": "Tại nhà hàng Komorebi hư cấu, bạn đi cùng một người nữa và hỏi còn chỗ ngồi không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đón khách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "24d7ec27-7a30-5973-98ef-61bcc26a8de5-u01",
          "speaker_id": "a",
          "ja": "二人です。今、席はありますか。",
          "vi": "Chúng tôi có hai người. Bây giờ còn bàn không ạ?"
        },
        {
          "id": "24d7ec27-7a30-5973-98ef-61bcc26a8de5-u02",
          "speaker_id": "b",
          "ja": "はい、二名様のお席があります。",
          "vi": "Có ạ, còn bàn cho hai người."
        },
        {
          "id": "24d7ec27-7a30-5973-98ef-61bcc26a8de5-u03",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Vậy cho chúng tôi vào ạ."
        },
        {
          "id": "24d7ec27-7a30-5973-98ef-61bcc26a8de5-u04",
          "speaker_id": "b",
          "ja": "こちらへどうぞ。",
          "vi": "Mời anh đi lối này."
        }
      ],
      "admin": {
        "source_refs": [
          "entry"
        ],
        "specialty_item_ids": [],
