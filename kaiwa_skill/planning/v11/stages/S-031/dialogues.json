          }
        }
      }
    },
    {
      "situation_uid": "1a6bc6b7-db0b-5950-a541-f772fe2e6e38",
      "event_id": "E02",
      "context_vi": "Tại Komorebi, bạn chỉ vào ảnh trong thực đơn và hỏi tên món trước khi gọi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phục vụ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "1a6bc6b7-db0b-5950-a541-f772fe2e6e38-u01",
          "speaker_id": "a",
          "ja": "この写真の料理は何ですか。",
          "vi": "Món trong ảnh này là món gì ạ?"
        },
        {
          "id": "1a6bc6b7-db0b-5950-a541-f772fe2e6e38-u02",
          "speaker_id": "b",
          "ja": "鶏の親子丼です。ご飯の上に鶏と卵がのっています。",
          "vi": "Đó là cơm gà trứng oyakodon. Gà và trứng đặt trên cơm ạ."
        },
        {
          "id": "1a6bc6b7-db0b-5950-a541-f772fe2e6e38-u03",
          "speaker_id": "a",
          "ja": "分かりました。別の料理も見ます。",
          "vi": "Tôi hiểu. Để tôi xem thêm món khác."
        }
      ],
      "admin": {
        "source_refs": [
          "order",
          "restaurant_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1a6bc6b7-db0b-5950-a541-f772fe2e6e38-u01": {
            "kind": "original_extension"
          },
