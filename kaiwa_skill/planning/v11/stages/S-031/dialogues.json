          },
          "05e4297a-5144-5d2c-b6da-48be3408bf93-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "fbe80144-8837-5021-bfdc-3c126150c842",
      "event_id": "E01",
      "context_vi": "Tại Komorebi hư cấu, lúc này là 18:20, chỉ còn bàn cần trả trước 19:00. Bạn dự tính ăn trong 30 phút và xác nhận điều kiện của bàn này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đón khách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "fbe80144-8837-5021-bfdc-3c126150c842-u01",
          "speaker_id": "b",
          "ja": "この席は七時までですが、よろしいですか。",
          "vi": "Bàn này dùng đến 7 giờ thôi, anh thấy được không ạ?"
        },
        {
          "id": "fbe80144-8837-5021-bfdc-3c126150c842-u02",
          "speaker_id": "a",
          "ja": "今は六時二十分ですね。三十分ほどで食べます。",
          "vi": "Bây giờ 6 giờ 20 nhỉ. Chúng tôi ăn khoảng 30 phút."
        },
        {
          "id": "fbe80144-8837-5021-bfdc-3c126150c842-u03",
          "speaker_id": "b",
          "ja": "はい。七時までにお願いします。",
          "vi": "Vâng, nhờ anh dùng bàn đến trước 7 giờ ạ."
        },
        {
          "id": "fbe80144-8837-5021-bfdc-3c126150c842-u04",
          "speaker_id": "a",
          "ja": "分かりました。その席でお願いします。",
          "vi": "Tôi hiểu. Cho chúng tôi bàn đó ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "entry"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fbe80144-8837-5021-bfdc-3c126150c842-u01": {
