    {
      "situation_uid": "518f5f92-6566-54e1-9051-248356d94d0f",
      "event_id": "E03",
      "context_vi": "Tại bàn Komorebi, bạn đã gọi pasta xốt cà chua nhưng nhân viên mang xốt kem. Bạn chỉ rõ điểm khác trước khi ăn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phục vụ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "518f5f92-6566-54e1-9051-248356d94d0f-u01",
          "speaker_id": "b",
          "ja": "お待たせしました。クリームソースのパスタです。",
          "vi": "Xin lỗi để anh đợi. Pasta xốt kem đây ạ."
        },
        {
          "id": "518f5f92-6566-54e1-9051-248356d94d0f-u02",
          "speaker_id": "a",
          "ja": "すみません。注文したのはトマトソースです。これはクリームですね。",
          "vi": "Xin lỗi, tôi gọi xốt cà chua. Món này là xốt kem nhỉ."
        },
        {
          "id": "518f5f92-6566-54e1-9051-248356d94d0f-u03",
          "speaker_id": "b",
          "ja": "失礼しました。注文を確認します。",
          "vi": "Xin lỗi anh. Tôi kiểm lại đơn ạ."
        },
        {
          "id": "518f5f92-6566-54e1-9051-248356d94d0f-u04",
          "speaker_id": "a",
          "ja": "お願いします。まだ食べていません。",
          "vi": "Nhờ chị nhé. Tôi chưa ăn món này."
        }
      ],
