        {
          "id": "8f19e1ed-27b5-5cb7-b73a-519f9546ec4b-u03",
          "speaker_id": "a",
          "ja": "すみません、ラーメンは二つです。",
          "vi": "Xin lỗi, ramen là hai bát ạ."
        },
        {
          "id": "8f19e1ed-27b5-5cb7-b73a-519f9546ec4b-u04",
          "speaker_id": "b",
          "ja": "失礼しました。もう一度確認します。",
          "vi": "Xin lỗi anh. Tôi xác nhận lại nhé."
