  "dialogues": [
    {
      "situation_uid": "af82f59b-70a6-53c2-9ab0-d8c93fc31a18",
      "event_id": "E01",
      "context_vi": "Bạn đã được xếp ca chiều thứ Sáu tại quán. Bạn báo không thể làm ca ấy và xin trao đổi cách đổi ca với trưởng ca.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "trưởng ca",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "af82f59b-70a6-53c2-9ab0-d8c93fc31a18-u01",
          "speaker_id": "a",
          "ja": "金曜日の午後のシフトに入れません。変更を相談できますか。",
          "vi": "Tôi không làm được ca chiều thứ Sáu. Tôi xin trao đổi việc đổi ca được không ạ?"
        },
        {
          "id": "af82f59b-70a6-53c2-9ab0-d8c93fc31a18-u02",
          "speaker_id": "b",
          "ja": "分かりました。まず代わりに入れる人を探しましょう。決まったら私に知らせてください。",
          "vi": "Tôi hiểu. Trước tiên ta tìm người có thể nhận thay. Khi chốt được, bạn báo tôi."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "af82f59b-70a6-53c2-9ab0-d8c93fc31a18-u01": {
            "kind": "original_extension"
          },
          "af82f59b-70a6-53c2-9ab0-d8c93fc31a18-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "dbd11d11-8ecf-5a18-8ece-b0d06c5162ef",
      "event_id": "E01",
      "context_vi": "Sau khi bạn báo không thể làm chiều thứ Sáu, trưởng ca nói chỉ có thể xác nhận đổi ca khi có người nhận thay. Bạn hỏi bước cụ thể.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "trưởng ca",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "dbd11d11-8ecf-5a18-8ece-b0d06c5162ef-u01",
          "speaker_id": "b",
          "ja": "代わりの人が決まれば、変更を確認できます。",
          "vi": "Khi có người nhận thay, tôi mới có thể xác nhận đổi ca."
        },
        {
          "id": "dbd11d11-8ecf-5a18-8ece-b0d06c5162ef-u02",
          "speaker_id": "a",
          "ja": "分かりました。決まったら、名前と時間を伝えます。",
          "vi": "Tôi hiểu. Khi có người, tôi sẽ báo tên và giờ cụ thể."
        },
        {
          "id": "dbd11d11-8ecf-5a18-8ece-b0d06c5162ef-u03",
          "speaker_id": "b",
          "ja": "はい。私からも勤務表を直します。",
          "vi": "Được. Tôi cũng sẽ cập nhật bảng ca."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "dbd11d11-8ecf-5a18-8ece-b0d06c5162ef-u01": {
            "kind": "original_extension"
