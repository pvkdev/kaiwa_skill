    {
      "situation_uid": "9ce94693-dc04-576f-96c0-c1fd1b5d51cb",
      "event_id": "E03",
      "context_vi": "Một nhân viên của quán nghỉ đột xuất. Bạn là trưởng ca, báo cho nhân viên đang trực và hỏi ai có thể hỗ trợ quầy tính tiền.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "trưởng ca",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đang trực",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9ce94693-dc04-576f-96c0-c1fd1b5d51cb-u01",
          "speaker_id": "a",
          "ja": "今日は一人休みです。レジを手伝える人はいますか。",
          "vi": "Hôm nay có một người nghỉ. Có ai giúp được quầy tính tiền không?"
        },
        {
          "id": "9ce94693-dc04-576f-96c0-c1fd1b5d51cb-u02",
          "speaker_id": "b",
          "ja": "私が休憩の十二時まで入れます。",
          "vi": "Tôi có thể vào quầy đến giờ nghỉ lúc 12 giờ."
        },
        {
          "id": "9ce94693-dc04-576f-96c0-c1fd1b5d51cb-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。その後の人は私が確認します。",
          "vi": "Cảm ơn bạn. Tôi sẽ tìm người làm tiếp sau 12 giờ."
        }
      ],
