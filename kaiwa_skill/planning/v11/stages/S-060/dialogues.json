      }
    },
    {
      "situation_uid": "57ad7c12-b563-5984-8bad-a6385b120d8e",
      "event_id": "E02",
      "context_vi": "Đồng nghiệp cũng bận nên không nhận ca 8 đến 12 giờ. Bạn cảm ơn rồi tìm người khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "57ad7c12-b563-5984-8bad-a6385b120d8e-u01",
          "speaker_id": "b",
          "ja": "すみません、明日は予定があって入れません。",
          "vi": "Xin lỗi, mai tôi có việc nên không nhận được."
        },
        {
          "id": "57ad7c12-b563-5984-8bad-a6385b120d8e-u02",
          "speaker_id": "a",
          "ja": "分かりました。聞いてくれてありがとうございます。ほかの人にも聞いてみます。",
          "vi": "Tôi hiểu. Cảm ơn bạn đã nghe tôi hỏi. Tôi sẽ hỏi người khác."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
