    {
      "situation_uid": "0aa813e3-3d86-5f3a-b2c0-410f020ff1c2",
      "event_id": "E03",
      "context_vi": "Quán thiếu người nên nhân viên đang trực hỏi bạn, trưởng ca, nên ưu tiên quầy tính tiền hay sắp kệ. Bạn đưa chỉ dẫn cụ thể.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "trưởng ca",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đang trực",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0aa813e3-3d86-5f3a-b2c0-410f020ff1c2-u01",
          "speaker_id": "b",
          "ja": "今、人が足りません。レジと棚の整理、どちらを先にしますか。",
          "vi": "Giờ thiếu người. Tôi nên ưu tiên quầy tính tiền hay sắp kệ ạ?"
        },
        {
          "id": "0aa813e3-3d86-5f3a-b2c0-410f020ff1c2-u02",
          "speaker_id": "a",
          "ja": "先にレジをお願いします。棚は私があとで確認します。",
          "vi": "Bạn ưu tiên quầy tính tiền. Tôi sẽ kiểm kệ sau."
        }
      ],
