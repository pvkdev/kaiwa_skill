            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "b0adf183-1136-55df-a685-f6121bf07bce",
      "event_id": "E01",
      "context_vi": "Bạn đã tìm được Suzuki nhận thay toàn bộ ca chiều thứ Sáu từ 2 đến 6 giờ. Bạn báo trưởng ca để xác nhận và sửa bảng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "trưởng ca",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b0adf183-1136-55df-a685-f6121bf07bce-u01",
          "speaker_id": "a",
          "ja": "鈴木さんが金曜日の二時から六時まで代わってくれます。変更を確認できますか。",
          "vi": "Suzuki nhận thay ca thứ Sáu từ 2 đến 6 giờ. Anh xác nhận đổi ca được không ạ?"
        },
        {
          "id": "b0adf183-1136-55df-a685-f6121bf07bce-u02",
          "speaker_id": "b",
          "ja": "鈴木さんにも確認しました。勤務表を変更します。",
          "vi": "Tôi cũng đã hỏi Suzuki. Tôi sẽ sửa bảng ca."
        },
        {
          "id": "b0adf183-1136-55df-a685-f6121bf07bce-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。金曜日は鈴木さんですね。",
          "vi": "Cảm ơn anh. Ca thứ Sáu sẽ do Suzuki làm."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b0adf183-1136-55df-a685-f6121bf07bce-u01": {
