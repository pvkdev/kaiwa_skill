          }
        }
      }
    },
    {
      "situation_uid": "8aeedc51-dfea-5023-ae60-6211288555c9",
      "event_id": "E01",
      "context_vi": "Bạn đã hỏi đổi ca chiều thứ Sáu nhưng chưa tìm được người thay. Bạn hỏi trưởng ca còn cách nào để cùng xử lý.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "trưởng ca",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8aeedc51-dfea-5023-ae60-6211288555c9-u01",
          "speaker_id": "a",
          "ja": "代わりの人がまだ見つかりません。ほかにできることはありますか。",
          "vi": "Tôi vẫn chưa tìm được người nhận thay. Còn cách nào chúng ta có thể xử lý không ạ?"
        },
        {
          "id": "8aeedc51-dfea-5023-ae60-6211288555c9-u02",
          "speaker_id": "b",
          "ja": "分かりました。私もほかの人に聞きます。変更は決まるまで待ってください。",
          "vi": "Tôi hiểu. Tôi cũng sẽ hỏi những người khác. Việc đổi ca vẫn chờ xác nhận."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8aeedc51-dfea-5023-ae60-6211288555c9-u01": {
            "kind": "original_extension"
