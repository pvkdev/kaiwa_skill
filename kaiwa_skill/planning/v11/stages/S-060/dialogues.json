        }
      ],
      "turns": [
        {
          "id": "f5683080-b192-58bc-b732-156deeeed27b-u01",
          "speaker_id": "a",
          "ja": "この注文はまだ確認中です。伝票はここにあります。次の人に見てもらえますか。",
          "vi": "Đơn này vẫn đang chờ xác nhận. Phiếu ở đây. Bạn xem tiếp giúp tôi được không?"
        },
        {
          "id": "f5683080-b192-58bc-b732-156deeeed27b-u02",
          "speaker_id": "b",
          "ja": "分かった。確認してからお客様に伝えるね。",
          "vi": "Tôi hiểu. Tôi sẽ xác nhận rồi báo khách."
        }
      ],
