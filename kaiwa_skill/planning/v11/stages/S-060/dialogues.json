          }
        }
      }
    },
    {
      "situation_uid": "bacf91e7-64d6-5e86-9f25-563bc9a3634f",
      "event_id": "E02",
      "context_vi": "Bạn cần người nhận giúp ca sáng bắt đầu 8 giờ. Bạn hỏi đồng nghiệp có thể đến từ đầu ca không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp khác ca",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bacf91e7-64d6-5e86-9f25-563bc9a3634f-u01",
          "speaker_id": "a",
          "ja": "明日の八時からのシフトを代わってもらえますか。",
          "vi": "Ngày mai bạn nhận giúp ca bắt đầu lúc 8 giờ được không?"
        },
        {
          "id": "bacf91e7-64d6-5e86-9f25-563bc9a3634f-u02",
          "speaker_id": "b",
          "ja": "八時から何時までですか。",
          "vi": "Từ 8 giờ đến mấy giờ?"
        },
        {
          "id": "bacf91e7-64d6-5e86-9f25-563bc9a3634f-u03",
          "speaker_id": "a",
          "ja": "十二時までです。",
          "vi": "Đến 12 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "bacf91e7-64d6-5e86-9f25-563bc9a3634f-u01": {
            "kind": "original_extension"
          },
          "bacf91e7-64d6-5e86-9f25-563bc9a3634f-u02": {
            "kind": "original_extension"
          },
          "bacf91e7-64d6-5e86-9f25-563bc9a3634f-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "91aeb8f6-f725-5237-9daf-1a8e02adcc27",
      "event_id": "E02",
      "context_vi": "Đồng nghiệp vừa nghe ca 8 đến 12 giờ và đồng ý nhận toàn bộ. Bạn nhắc lại giờ trước khi báo trưởng ca.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp khác ca",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "91aeb8f6-f725-5237-9daf-1a8e02adcc27-u01",
          "speaker_id": "b",
          "ja": "八時から十二時まで、全部入れます。",
          "vi": "Tôi nhận được toàn bộ ca từ 8 đến 12 giờ."
        },
        {
          "id": "91aeb8f6-f725-5237-9daf-1a8e02adcc27-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。八時開始ですね。これから責任者にも確認します。",
          "vi": "Cảm ơn bạn. Bắt đầu lúc 8 giờ nhé. Tôi sẽ báo người phụ trách để xác nhận."
        },
        {
          "id": "91aeb8f6-f725-5237-9daf-1a8e02adcc27-u03",
          "speaker_id": "b",
          "ja": "はい、お願いします。",
          "vi": "Ừ, nhờ bạn báo nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
