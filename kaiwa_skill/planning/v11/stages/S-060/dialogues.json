    {
      "situation_uid": "2a78d690-e6f7-5889-ad31-d01fa7a7e93d",
      "event_id": "E03",
      "context_vi": "Sau khi phân công nhân viên ưu tiên quầy tính tiền, bạn là trưởng ca và cũng ra hỗ trợ. Khách hỏi bao giờ đến lượt; bạn báo mốc ước tính, không hứa chắc.",
      "speakers": [
