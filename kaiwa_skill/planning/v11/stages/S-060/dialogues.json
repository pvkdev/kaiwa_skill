          "id": "a",
          "role_vi": "trưởng ca đang hỗ trợ quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2a78d690-e6f7-5889-ad31-d01fa7a7e93d-u01",
          "speaker_id": "a",
          "ja": "お待たせしてすみません。あと五分ほどでご案内できる見込みです。",
          "vi": "Xin lỗi đã để anh chờ. Dự kiến khoảng năm phút nữa tôi có thể phục vụ anh."
        },
        {
          "id": "2a78d690-e6f7-5889-ad31-d01fa7a7e93d-u02",
          "speaker_id": "b",
          "ja": "分かりました。ここで待ちます。",
          "vi": "Tôi hiểu. Tôi sẽ chờ ở đây."
        }
      ],
