    {
      "situation_uid": "f5683080-b192-58bc-b732-156deeeed27b",
      "event_id": "E04",
      "context_vi": "Bạn sắp giao ca quầy cho đồng nghiệp. Một đơn của khách còn chờ xác nhận, bạn nêu rõ trạng thái và giấy ghi chú.",
      "speakers": [
