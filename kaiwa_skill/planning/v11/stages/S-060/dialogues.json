    {
      "situation_uid": "92c34088-e8c2-5267-a14a-8b2e8d3af94c",
      "event_id": "E03",
      "context_vi": "Nhân viên đã nhận hỗ trợ quầy đến 12 giờ. Bạn là trưởng ca, đã xếp Tanaka làm tiếp và thông báo thời điểm bàn giao.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "trưởng ca",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đang trực",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "92c34088-e8c2-5267-a14a-8b2e8d3af94c-u01",
          "speaker_id": "b",
          "ja": "私は十二時までレジに入れます。その後の人は決まりましたか。",
          "vi": "Tôi có thể hỗ trợ quầy đến 12 giờ. Đã có người làm sau đó chưa ạ?"
        },
        {
          "id": "92c34088-e8c2-5267-a14a-8b2e8d3af94c-u02",
          "speaker_id": "a",
          "ja": "はい。十二時から田中さんが入ります。十一時五十分に引き継いでください。",
          "vi": "Có. Từ 12 giờ Tanaka sẽ làm. Bạn bàn giao lúc 11 giờ 50 nhé."
        },
        {
          "id": "92c34088-e8c2-5267-a14a-8b2e8d3af94c-u03",
          "speaker_id": "b",
          "ja": "田中さんに十一時五十分ですね。",
          "vi": "Tôi bàn giao cho Tanaka lúc 11 giờ 50."
        }
      ],
      "admin": {
