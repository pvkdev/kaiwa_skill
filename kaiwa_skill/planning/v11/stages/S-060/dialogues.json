        }
      }
    },
    {
      "situation_uid": "d87bfd90-21d3-51a5-97a4-d06d7b96a312",
      "event_id": "E02",
      "context_vi": "Đồng nghiệp chỉ nhận được nửa đầu ca 8 đến 10 giờ. Bạn hỏi ai có thể giúp nửa còn lại trước khi báo trưởng ca.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp khác ca",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d87bfd90-21d3-51a5-97a4-d06d7b96a312-u01",
          "speaker_id": "b",
          "ja": "八時から十時までなら入れます。",
          "vi": "Tôi chỉ làm được từ 8 đến 10 giờ."
        },
        {
          "id": "d87bfd90-21d3-51a5-97a4-d06d7b96a312-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。十時から十二時は、誰に聞けばいいですか。",
          "vi": "Cảm ơn bạn. Từ 10 đến 12 giờ tôi nên hỏi ai ạ?"
        },
        {
          "id": "d87bfd90-21d3-51a5-97a4-d06d7b96a312-u03",
          "speaker_id": "b",
          "ja": "田中さんに聞いてみてください。責任者にも伝えてくださいね。",
          "vi": "Bạn thử hỏi Tanaka. Nhớ báo cả người phụ trách nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d87bfd90-21d3-51a5-97a4-d06d7b96a312-u01": {
