    {
      "situation_uid": "d409d9c2-83d3-5924-88de-4382c608be36",
      "event_id": "E04",
      "context_vi": "Đồng nghiệp ca sau tưởng đơn vừa bàn giao đã xong. Bạn sửa trạng thái trước khi họ báo khách.",
