    {
      "situation_uid": "a620797e-71ea-5f8d-83b0-494b0493f7e4",
      "event_id": "E02",
      "context_vi": "Đồng nghiệp nhận nửa đầu ca 8 đến 10 giờ, bạn đang tìm người cho nửa sau. Hai người chốt nơi và cách bàn giao lúc 10 giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a620797e-71ea-5f8d-83b0-494b0493f7e4-u01",
          "speaker_id": "a",
          "ja": "十時にレジの横で、次の人に引き継いでもらえますか。",
          "vi": "Lúc 10 giờ bạn bàn giao cho người tiếp theo ở cạnh quầy tính tiền được không?"
        },
        {
          "id": "a620797e-71ea-5f8d-83b0-494b0493f7e4-u02",
          "speaker_id": "b",
          "ja": "はい。十時にレジの横で待ちます。次の人の名前が決まったら教えてください。",
          "vi": "Được. 10 giờ tôi sẽ đợi cạnh quầy. Khi biết tên người tiếp theo, bạn báo tôi nhé."
        },
        {
          "id": "a620797e-71ea-5f8d-83b0-494b0493f7e4-u03",
          "speaker_id": "a",
          "ja": "分かりました。責任者にも確認します。",
          "vi": "Tôi hiểu. Tôi cũng sẽ hỏi người phụ trách."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "mhlw"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a620797e-71ea-5f8d-83b0-494b0493f7e4-u01": {
