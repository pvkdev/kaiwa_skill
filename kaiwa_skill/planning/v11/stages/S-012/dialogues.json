    {
      "situation_uid": "545cf95b-894d-5ea0-a7f2-9c3c1608e36e",
      "event_id": "E03",
      "context_vi": "Bạn mất thẻ PASMO và chưa nhớ đó là thẻ có tên hay thẻ vô danh. Bạn hỏi nhân viên Tokyo Metro cách xác định loại trước khi bàn cấp lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "545cf95b-894d-5ea0-a7f2-9c3c1608e36e-u01",
          "speaker_id": "a",
          "ja": "PASMOをなくしました。名前があるカードか、わかりません。",
          "vi": "Tôi làm mất PASMO. Tôi không nhớ thẻ có tên không."
        },
        {
          "id": "545cf95b-894d-5ea0-a7f2-9c3c1608e36e-u02",
          "speaker_id": "b",
          "ja": "買ったときに、名前を登録しましたか。",
          "vi": "Khi mua chị có đăng ký tên không ạ?"
        },
        {
          "id": "545cf95b-894d-5ea0-a7f2-9c3c1608e36e-u03",
          "speaker_id": "a",
          "ja": "覚えていません。調べる方法を教えてください。",
          "vi": "Tôi không nhớ. Anh chỉ cách kiểm giúp tôi ạ."
        },
        {
          "id": "545cf95b-894d-5ea0-a7f2-9c3c1608e36e-u04",
          "speaker_id": "b",
          "ja": "窓口で、登録した情報を確認しましょう。",
          "vi": "Mình kiểm thông tin đã đăng ký tại quầy nhé."
        }
