    {
      "situation_uid": "a5378705-87b3-5e81-aea2-7456c72bddaa",
      "event_id": "E05",
      "context_vi": "Chiều hôm sau, bạn quay lại đúng quầy Tokyo Metro để hỏi kết quả kiểm hai lượt PASMO thứ Ba và thứ Năm từ Asakusa tới Shibuya.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a5378705-87b3-5e81-aea2-7456c72bddaa-u01",
          "speaker_id": "a",
          "ja": "昨日のPASMOの件です。火曜日と木曜日の、浅草から渋谷までです。",
          "vi": "Tôi hỏi tiếp việc PASMO hôm qua. Hai lượt thứ Ba và thứ Năm từ Asakusa tới Shibuya ạ."
        },
        {
          "id": "a5378705-87b3-5e81-aea2-7456c72bddaa-u02",
          "speaker_id": "b",
          "ja": "はい、二つの履歴を見ました。金額は違います。理由はまだ確認中です。",
          "vi": "Vâng, tôi đã xem hai lượt. Số tiền đúng là khác nhau. Chúng tôi vẫn đang kiểm nguyên nhân."
        },
        {
          "id": "a5378705-87b3-5e81-aea2-7456c72bddaa-u03",
          "speaker_id": "a",
          "ja": "わかりました。次はいつ聞けばいいですか。",
          "vi": "Tôi hiểu. Khi nào tôi hỏi tiếp được ạ?"
        },
        {
          "id": "a5378705-87b3-5e81-aea2-7456c72bddaa-u04",
          "speaker_id": "b",
          "ja": "明日の午後に、またこちらでお願いします。",
          "vi": "Chiều mai chị quay lại quầy này nhé."
        }
      ],
