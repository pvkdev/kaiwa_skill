            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "ec177d85-3820-5f52-aeb9-9dbf6a3f2aaf",
      "event_id": "E02",
      "context_vi": "Ở ga Tokyo Metro, thẻ PASMO của bạn không mở cổng lúc vào. Bạn hỏi nhân viên cổng mà chưa đoán lý do.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ec177d85-3820-5f52-aeb9-9dbf6a3f2aaf-u01",
          "speaker_id": "a",
          "ja": "すみません、PASMOで改札に入れません。",
          "vi": "Xin lỗi, tôi không vào cổng được bằng PASMO."
        },
        {
          "id": "ec177d85-3820-5f52-aeb9-9dbf6a3f2aaf-u02",
          "speaker_id": "b",
          "ja": "カードを見せてください。確認します。",
          "vi": "Chị cho tôi xem thẻ. Tôi kiểm tra ạ."
        },
        {
          "id": "ec177d85-3820-5f52-aeb9-9dbf6a3f2aaf-u03",
          "speaker_id": "a",
          "ja": "はい、どうぞ。",
          "vi": "Vâng, đây ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "w_pasmo"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ec177d85-3820-5f52-aeb9-9dbf6a3f2aaf-u01": {
            "kind": "original_extension"
          },
