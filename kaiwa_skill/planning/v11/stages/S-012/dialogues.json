  "dialogues": [
    {
      "situation_uid": "3ffecf69-43db-54d6-88fb-0d632a46e7f9",
      "event_id": "E01",
      "context_vi": "Tại quầy Tokyo Metro, bạn đi làm hằng ngày từ Asakusa tới Ginza và muốn hỏi loại vé tháng đi làm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3ffecf69-43db-54d6-88fb-0d632a46e7f9-u01",
          "speaker_id": "a",
          "ja": "毎日、浅草から銀座まで通います。定期券はどれですか。",
          "vi": "Ngày nào tôi cũng đi từ Asakusa tới Ginza. Tôi nên chọn vé tháng nào ạ?"
        },
        {
          "id": "3ffecf69-43db-54d6-88fb-0d632a46e7f9-u02",
          "speaker_id": "b",
          "ja": "通勤定期券ですね。出発は浅草、到着は銀座ですか。",
          "vi": "Vé tháng đi làm nhỉ. Ga đầu Asakusa, ga đến Ginza ạ?"
        },
        {
          "id": "3ffecf69-43db-54d6-88fb-0d632a46e7f9-u03",
          "speaker_id": "a",
          "ja": "はい、その区間です。",
          "vi": "Vâng, đúng chặng đó."
        }
      ],
      "admin": {
        "source_refs": [
          "train",
          "w_pass"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3ffecf69-43db-54d6-88fb-0d632a46e7f9-u01": {
