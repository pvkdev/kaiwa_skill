        {
          "id": "a38cdd5f-2feb-577e-a2b9-e10ee1852fbf-u03",
          "speaker_id": "b",
          "ja": "切符を買うか、新しいカードを買ってください。",
          "vi": "Chị mua vé lẻ hoặc thẻ mới nhé."
        },
