    {
      "situation_uid": "57478d80-f4a7-5b8e-989e-8648affc0b1f",
      "event_id": "E05",
      "context_vi": "Tại ga Tokyo Metro, bạn thấy hai lần gần đây PASMO bị trừ số tiền khác nhau dù bạn nghĩ mình đi cùng chặng. Bạn nêu thắc mắc, chưa tự kết luận sai phí.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "57478d80-f4a7-5b8e-989e-8648affc0b1f-u01",
          "speaker_id": "a",
          "ja": "同じ区間に乗ったつもりですが、引かれた金額が違います。",
          "vi": "Tôi nghĩ hai lần mình đi cùng chặng, nhưng số tiền bị trừ khác nhau."
        },
        {
          "id": "57478d80-f4a7-5b8e-989e-8648affc0b1f-u02",
          "speaker_id": "b",
          "ja": "利用履歴を一緒に確認しましょう。",
          "vi": "Mình cùng xem lịch sử sử dụng nhé."
        },
        {
          "id": "57478d80-f4a7-5b8e-989e-8648affc0b1f-u03",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ anh."
        }
      ],
      "admin": {
