    {
      "situation_uid": "ce504d6d-3af3-566d-9110-abc7b7174f5c",
      "event_id": "E03",
      "context_vi": "Bạn xác định thẻ PASMO bị mất có tên mình. Tại quầy Tokyo Metro, bạn hỏi cần mang giấy tờ gì để xin xử lý cấp lại.",
