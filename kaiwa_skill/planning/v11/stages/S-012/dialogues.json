            "kind": "original_extension"
          },
          "cdc2018d-d9e2-5f73-bbcf-cd60eb4ee8f1-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "1e2167b7-37e6-593b-a529-1d4eda6086db",
      "event_id": "E01",
      "context_vi": "Đang hỏi mua vé tháng Tokyo Metro từ Asakusa tới Ginza, bạn được báo nơi làm chuyển tới gần Shibuya. Bạn hỏi lại loại vé phù hợp trước khi trả tiền.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1e2167b7-37e6-593b-a529-1d4eda6086db-u01",
          "speaker_id": "a",
          "ja": "行く駅が渋谷に変わりました。どの定期券がいいですか。",
          "vi": "Ga tôi đi làm đổi thành Shibuya. Vé tháng nào phù hợp ạ?"
        },
        {
          "id": "1e2167b7-37e6-593b-a529-1d4eda6086db-u02",
          "speaker_id": "b",
          "ja": "では、浅草から渋谷までの経路を確認しましょう。",
          "vi": "Vậy mình kiểm lộ trình từ Asakusa tới Shibuya nhé."
        },
        {
          "id": "1e2167b7-37e6-593b-a529-1d4eda6086db-u03",
          "speaker_id": "a",
          "ja": "はい。まだ買っていません。",
          "vi": "Vâng. Tôi chưa mua vé."
        }
      ],
      "admin": {
        "source_refs": [
          "w_pass"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1e2167b7-37e6-593b-a529-1d4eda6086db-u01": {
            "kind": "original_extension"
          },
          "1e2167b7-37e6-593b-a529-1d4eda6086db-u02": {
            "kind": "original_extension"
          },
          "1e2167b7-37e6-593b-a529-1d4eda6086db-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "ca78b147-b4b7-5d6b-aa71-38d8d80bba20",
      "event_id": "E01",
      "context_vi": "Bạn chưa biết ngày đi làm đầu tiên nên chưa muốn chốt ngày bắt đầu vé tháng Tokyo Metro. Bạn hỏi có thể quay lại mua sau khi có lịch không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ca78b147-b4b7-5d6b-aa71-38d8d80bba20-u01",
          "speaker_id": "a",
          "ja": "仕事の開始日はまだわかりません。後で買ってもいいですか。",
          "vi": "Tôi chưa biết ngày bắt đầu đi làm. Tôi quay lại mua sau được không ạ?"
        },
        {
          "id": "ca78b147-b4b7-5d6b-aa71-38d8d80bba20-u02",
          "speaker_id": "b",
          "ja": "はい。日が決まったら、開始日と経路を確認してください。",
          "vi": "Được. Khi biết ngày, chị kiểm ngày bắt đầu và lộ trình nhé."
        },
        {
          "id": "ca78b147-b4b7-5d6b-aa71-38d8d80bba20-u03",
          "speaker_id": "a",
          "ja": "わかりました。また来ます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ quay lại."
        }
      ],
      "admin": {
        "source_refs": [
          "w_pass"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ca78b147-b4b7-5d6b-aa71-38d8d80bba20-u01": {
            "kind": "original_extension"
