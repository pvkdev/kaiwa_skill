          }
        }
      }
    },
    {
      "situation_uid": "cdc2018d-d9e2-5f73-bbcf-cd60eb4ee8f1",
      "event_id": "E01",
      "context_vi": "Tại quầy Tokyo Metro, bạn đã nói chặng Asakusa–Ginza. Bạn cần xác nhận ngày vé bắt đầu và hai ga ghi trên vé trước khi mua.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cdc2018d-d9e2-5f73-bbcf-cd60eb4ee8f1-u01",
          "speaker_id": "a",
          "ja": "来週の月曜日から使いたいです。浅草から銀座までですね。",
          "vi": "Tôi muốn dùng từ thứ Hai tuần sau. Vé từ Asakusa đến Ginza nhỉ?"
        },
        {
          "id": "cdc2018d-d9e2-5f73-bbcf-cd60eb4ee8f1-u02",
          "speaker_id": "b",
          "ja": "はい。開始日を月曜日にして、その区間で確認します。",
          "vi": "Vâng. Tôi sẽ kiểm ngày bắt đầu là thứ Hai và chặng đó."
        },
        {
          "id": "cdc2018d-d9e2-5f73-bbcf-cd60eb4ee8f1-u03",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Nhờ anh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "w_pass"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "cdc2018d-d9e2-5f73-bbcf-cd60eb4ee8f1-u01": {
            "kind": "original_extension"
          },
