    {
      "situation_uid": "4158cbde-75fb-54ab-9d3c-21e3708ee583",
      "event_id": "E04",
      "context_vi": "Bạn chưa biết ngày bắt đầu tới nơi làm mới gần Shibuya nên chưa thể chốt ngày vé tháng Tokyo Metro mới. Bạn hỏi lúc nào cần quyết định.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4158cbde-75fb-54ab-9d3c-21e3708ee583-u01",
          "speaker_id": "a",
          "ja": "新しい仕事の日がまだ決まりません。今日、決めないとだめですか。",
          "vi": "Tôi chưa biết ngày bắt đầu ở chỗ làm mới. Hôm nay phải quyết định luôn ạ?"
        },
        {
          "id": "4158cbde-75fb-54ab-9d3c-21e3708ee583-u02",
          "speaker_id": "b",
          "ja": "今日でなくても大丈夫です。日が決まったら、また経路を確認しましょう。",
          "vi": "Không cần hôm nay. Khi biết ngày, mình kiểm lại lộ trình nhé."
        },
        {
          "id": "4158cbde-75fb-54ab-9d3c-21e3708ee583-u03",
          "speaker_id": "a",
          "ja": "では、決まってから来ます。",
          "vi": "Vậy khi có lịch tôi sẽ quay lại."
        }
      ],
      "admin": {
        "source_refs": [
          "w_pass"
        ],
        "specialty_item_ids": [],
