    {
      "situation_uid": "9e5ca611-e80e-5614-a8fd-87a371fc8b8c",
      "event_id": "E05",
      "context_vi": "Để nhân viên Tokyo Metro kiểm hai lần bị trừ khác nhau, bạn nêu lượt đang hỏi: thứ Ba Asakusa tới Shibuya, rồi thứ Năm cũng vậy theo trí nhớ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9e5ca611-e80e-5614-a8fd-87a371fc8b8c-u01",
          "speaker_id": "a",
          "ja": "火曜日と木曜日です。どちらも浅草から渋谷まで乗ったと思います。",
          "vi": "Là thứ Ba và thứ Năm. Tôi nhớ cả hai lần đều đi từ Asakusa tới Shibuya."
        },
        {
          "id": "9e5ca611-e80e-5614-a8fd-87a371fc8b8c-u02",
          "speaker_id": "b",
          "ja": "わかりました。二つの日を見ます。",
          "vi": "Tôi hiểu. Tôi xem hai ngày đó."
        },
        {
          "id": "9e5ca611-e80e-5614-a8fd-87a371fc8b8c-u03",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Nhờ anh ạ."
        }
      ],
