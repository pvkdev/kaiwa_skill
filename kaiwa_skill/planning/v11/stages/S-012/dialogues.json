          },
          "ec177d85-3820-5f52-aeb9-9dbf6a3f2aaf-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d593c2c2-2eed-5fcb-9526-971326c66011",
      "event_id": "E02",
      "context_vi": "Bạn đã đi bằng PASMO từ Asakusa tới Shibuya nhưng cổng ra không mở. Bạn nói rõ ga lên và ga xuống dự định để nhân viên ga Tokyo Metro kiểm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d593c2c2-2eed-5fcb-9526-971326c66011-u01",
          "speaker_id": "a",
          "ja": "浅草から乗って、渋谷で降りたいです。改札を出られません。",
          "vi": "Tôi lên ở Asakusa, muốn xuống Shibuya. Nhưng tôi không ra cổng được."
        },
        {
          "id": "d593c2c2-2eed-5fcb-9526-971326c66011-u02",
          "speaker_id": "b",
          "ja": "わかりました。カードを確認します。",
          "vi": "Tôi hiểu rồi. Để tôi kiểm thẻ."
        },
        {
          "id": "d593c2c2-2eed-5fcb-9526-971326c66011-u03",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Nhờ anh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "w_pasmo"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d593c2c2-2eed-5fcb-9526-971326c66011-u01": {
