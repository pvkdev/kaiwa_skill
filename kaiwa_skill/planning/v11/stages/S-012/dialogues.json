    {
      "situation_uid": "b59dd4fb-b406-5a8e-9ae6-8f76ba84b3d2",
      "event_id": "E05",
      "context_vi": "Quầy Tokyo Metro cần xem lịch sử giao dịch PASMO để kiểm hai lượt đi thứ Ba và thứ Năm. Bạn hỏi khi nào biết kết quả và ai báo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b59dd4fb-b406-5a8e-9ae6-8f76ba84b3d2-u01",
          "speaker_id": "b",
          "ja": "履歴をもう少し調べます。",
          "vi": "Tôi sẽ kiểm lịch sử thêm một chút."
        },
        {
          "id": "b59dd4fb-b406-5a8e-9ae6-8f76ba84b3d2-u02",
          "speaker_id": "a",
          "ja": "いつわかりますか。誰に聞けばいいですか。",
          "vi": "Khi nào biết ạ? Tôi hỏi ai?"
        },
        {
          "id": "b59dd4fb-b406-5a8e-9ae6-8f76ba84b3d2-u03",
          "speaker_id": "b",
          "ja": "明日の午後、この窓口で私に聞いてください。",
          "vi": "Chiều mai chị hỏi tôi tại quầy này nhé."
        },
        {
          "id": "b59dd4fb-b406-5a8e-9ae6-8f76ba84b3d2-u04",
          "speaker_id": "a",
          "ja": "明日の午後、こちらですね。",
          "vi": "Chiều mai, tại quầy này nhỉ."
        }
      ],
