          }
        }
      }
    },
    {
      "situation_uid": "c5e410e1-b68c-5a9d-bff8-7dc67fc98226",
      "event_id": "E01",
      "context_vi": "Sau khi nơi làm đổi sang gần Shibuya và nhân viên bắt đầu kiểm lộ trình mới, bạn nhắc lại ga đầu, ga đến và ngày bắt đầu giả định là thứ Hai tuần sau trước khi trả.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c5e410e1-b68c-5a9d-bff8-7dc67fc98226-u01",
          "speaker_id": "a",
          "ja": "浅草から渋谷まで、来週の月曜日からですね。",
          "vi": "Từ Asakusa tới Shibuya, bắt đầu thứ Hai tuần sau nhỉ?"
        },
        {
          "id": "c5e410e1-b68c-5a9d-bff8-7dc67fc98226-u02",
          "speaker_id": "b",
          "ja": "はい。その内容です。お支払いの前に画面も見てください。",
          "vi": "Vâng, đúng nội dung đó. Trước khi trả, chị xem lại trên màn hình nhé."
        },
        {
          "id": "c5e410e1-b68c-5a9d-bff8-7dc67fc98226-u03",
          "speaker_id": "a",
          "ja": "はい、確認します。",
          "vi": "Vâng, tôi sẽ kiểm."
        }
      ],
      "admin": {
        "source_refs": [
          "w_pass"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c5e410e1-b68c-5a9d-bff8-7dc67fc98226-u01": {
            "kind": "original_extension"
          },
