    {
      "situation_uid": "84606ab6-2abd-5b13-a499-bac4e6350b39",
      "event_id": "E05",
      "context_vi": "Nhân viên đang xem lịch sử PASMO và hỏi nhầm một lượt đi thứ Tư. Bạn cần chỉ rõ đang hỏi thứ Ba và thứ Năm từ Asakusa tới Shibuya.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "84606ab6-2abd-5b13-a499-bac4e6350b39-u01",
          "speaker_id": "b",
          "ja": "水曜日の利用ですか。",
          "vi": "Là lượt đi thứ Tư ạ?"
        },
        {
          "id": "84606ab6-2abd-5b13-a499-bac4e6350b39-u02",
          "speaker_id": "a",
          "ja": "いいえ、火曜日と木曜日です。浅草から渋谷までだったと思います。",
          "vi": "Không, thứ Ba và thứ Năm ạ. Tôi nhớ là từ Asakusa tới Shibuya."
        },
        {
          "id": "84606ab6-2abd-5b13-a499-bac4e6350b39-u03",
          "speaker_id": "b",
          "ja": "わかりました。その二日を見ます。",
          "vi": "Tôi hiểu rồi. Tôi xem đúng hai ngày đó."
        }
      ],
      "admin": {
        "source_refs": [
