    {
      "situation_uid": "543fde9d-027e-5aee-be68-84b3e34b2f3b",
      "event_id": "E04",
      "context_vi": "Bạn đã biết thứ Hai tuần sau bắt đầu đi làm gần Shibuya. Bạn quay lại quầy Tokyo Metro để chốt chặng vé tháng mới từ Asakusa tới Shibuya.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "543fde9d-027e-5aee-be68-84b3e34b2f3b-u01",
          "speaker_id": "a",
          "ja": "来週の月曜日からです。浅草から渋谷までの定期券をお願いします。",
          "vi": "Tôi bắt đầu thứ Hai tuần sau. Cho tôi vé tháng từ Asakusa tới Shibuya ạ."
        },
        {
          "id": "543fde9d-027e-5aee-be68-84b3e34b2f3b-u02",
          "speaker_id": "b",
          "ja": "開始日と経路を画面で確認してください。",
          "vi": "Chị kiểm ngày bắt đầu và lộ trình trên màn hình nhé."
        },
        {
          "id": "543fde9d-027e-5aee-be68-84b3e34b2f3b-u03",
          "speaker_id": "a",
          "ja": "はい、確認します。",
          "vi": "Vâng, tôi sẽ kiểm."
        }
      ],
      "admin": {
