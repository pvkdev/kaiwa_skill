    {
      "situation_uid": "becde68f-4a8c-5991-9c5c-f178d2bb262e",
      "event_id": "E02",
      "context_vi": "Tại cổng Tokyo Metro, nhân viên đoán PASMO thiếu tiền. Bạn vừa nạp tiền và muốn nói rõ điều đó để anh ấy kiểm nguyên nhân khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga Tokyo Metro",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "becde68f-4a8c-5991-9c5c-f178d2bb262e-u01",
          "speaker_id": "b",
          "ja": "残額が足りないかもしれません。",
          "vi": "Có thể số dư chưa đủ ạ."
        },
        {
          "id": "becde68f-4a8c-5991-9c5c-f178d2bb262e-u02",
          "speaker_id": "a",
          "ja": "さっきチャージしました。もう一度見てもらえますか。",
          "vi": "Tôi vừa nạp tiền. Anh kiểm lại giúp tôi được không ạ?"
        },
        {
          "id": "becde68f-4a8c-5991-9c5c-f178d2bb262e-u03",
          "speaker_id": "b",
          "ja": "はい、履歴も確認します。",
          "vi": "Vâng, tôi kiểm cả lịch sử thẻ."
        }
      ],
      "admin": {
        "source_refs": [
          "w_pasmo",
          "w_hist"
        ],
