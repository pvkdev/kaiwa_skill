    {
      "situation_uid": "e33c9110-d6d0-501a-a3f2-0001970728a7",
      "event_id": "E03",
      "context_vi": "Tiếp sau khi biết thùng quá nặng để hàng xóm bê một mình: anh ấy xin đợi đến chiều có người nhà giúp. Bạn cần chốt thời điểm, lối đi tạm thời vẫn phải thông.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e33c9110-d6d0-501a-a3f2-0001970728a7-u01",
          "speaker_id": "b",
          "ja": "ありがとう。でも、午後、家族が来ます。それまで待ってもらえますか。",
          "vi": "Cảm ơn chị. Nhưng chiều người nhà tôi đến. Chị đợi đến lúc đó được không?"
        },
        {
          "id": "e33c9110-d6d0-501a-a3f2-0001970728a7-u02",
          "speaker_id": "a",
          "ja": "何時ごろですか。今は通れるように、少し動かせますか。",
          "vi": "Khoảng mấy giờ? Trước mắt mình nhích thùng để đi qua được không?"
        },
        {
          "id": "e33c9110-d6d0-501a-a3f2-0001970728a7-u03",
          "speaker_id": "b",
          "ja": "三時ごろです。今、端に寄せます。",
          "vi": "Khoảng ba giờ. Giờ tôi nhích vào mép."
        },
        {
          "id": "e33c9110-d6d0-501a-a3f2-0001970728a7-u04",
          "speaker_id": "a",
          "ja": "三時ですね。ありがとうございます。",
          "vi": "Ba giờ nhỉ. Cảm ơn anh."
        }
      ],
