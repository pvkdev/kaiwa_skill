    {
      "situation_uid": "92570942-3525-5bc1-990f-80ba4a5c0d91",
      "event_id": "E02",
      "context_vi": "Bạn đang giặt đồ bằng máy chung thì máy dừng giữa chừng. Bạn báo người ở cùng mà chưa đoán nguyên nhân.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "92570942-3525-5bc1-990f-80ba4a5c0d91-u01",
          "speaker_id": "a",
          "ja": "洗濯機が途中で止まりました。どうしましょう。",
          "vi": "Máy giặt dừng giữa chừng. Giờ làm sao nhỉ?"
        },
        {
          "id": "92570942-3525-5bc1-990f-80ba4a5c0d91-u02",
          "speaker_id": "b",
          "ja": "私も原因はわかりません。管理の人に聞きましょう。",
          "vi": "Tôi cũng không biết nguyên nhân. Mình hỏi người quản lý nhé."
        },
        {
          "id": "92570942-3525-5bc1-990f-80ba4a5c0d91-u03",
          "speaker_id": "a",
          "ja": "わかりました。私から連絡します。",
          "vi": "Được. Để tôi liên lạc."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "92570942-3525-5bc1-990f-80ba4a5c0d91-u01": {
            "kind": "original_extension"
          },
