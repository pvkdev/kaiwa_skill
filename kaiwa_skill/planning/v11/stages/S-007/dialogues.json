          },
          "f463eb47-404f-5749-8279-e07007ff9a10-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0de8e2a5-97df-5025-94a6-6da53a5ca858",
      "event_id": "E02",
      "context_vi": "Trong khu bếp chung của nhà ở ghép giả định, bạn không biết dùng bếp điện. Bạn nhờ người ở cùng chỉ bước đầu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0de8e2a5-97df-5025-94a6-6da53a5ca858-u01",
          "speaker_id": "a",
          "ja": "このコンロの使い方を教えてください。",
          "vi": "Anh chỉ tôi cách dùng bếp này với."
        },
        {
          "id": "0de8e2a5-97df-5025-94a6-6da53a5ca858-u02",
          "speaker_id": "b",
          "ja": "まず、このボタンを押します。",
          "vi": "Đầu tiên bấm nút này."
        },
        {
          "id": "0de8e2a5-97df-5025-94a6-6da53a5ca858-u03",
          "speaker_id": "a",
          "ja": "このボタンですね。助かります。",
          "vi": "Nút này nhỉ. Anh giúp tôi nhiều quá."
        }
      ],
      "admin": {
        "source_refs": [
          "home",
          "help"
        ],
        "specialty_item_ids": [
          "sj-so-02-b07-38"
        ],
        "turn_origins": {
          "0de8e2a5-97df-5025-94a6-6da53a5ca858-u01": {
            "kind": "original_extension"
          },
          "0de8e2a5-97df-5025-94a6-6da53a5ca858-u02": {
