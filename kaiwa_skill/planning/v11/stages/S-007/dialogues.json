            "kind": "original_extension"
          },
          "af6501ab-f771-5bbb-9e17-df28765c0b92-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "f463eb47-404f-5749-8279-e07007ff9a10",
      "event_id": "E01",
      "context_vi": "Ngay sau khi hàng xóm nhắc thùng đồ đang chắn hành lang chung, bạn chuyển thùng vào phòng 203.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f463eb47-404f-5749-8279-e07007ff9a10-u01",
          "speaker_id": "a",
          "ja": "今、箱を部屋に入れます。",
          "vi": "Tôi chuyển thùng vào phòng ngay đây."
        },
        {
          "id": "f463eb47-404f-5749-8279-e07007ff9a10-u02",
          "speaker_id": "b",
          "ja": "ありがとうございます。ここを通りますので。",
          "vi": "Cảm ơn chị. Mọi người cần đi qua lối này."
        },
        {
          "id": "f463eb47-404f-5749-8279-e07007ff9a10-u03",
          "speaker_id": "a",
          "ja": "はい。もうここには置きません。",
          "vi": "Vâng. Tôi sẽ không để ở đây nữa."
        }
      ],
      "admin": {
        "source_refs": [
          "w_hall"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f463eb47-404f-5749-8279-e07007ff9a10-u01": {
            "kind": "original_extension"
          },
