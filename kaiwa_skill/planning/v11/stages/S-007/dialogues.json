  "dialogues": [
    {
      "situation_uid": "0442a0e4-e850-5534-9a2d-667a972f079d",
      "event_id": "E01",
      "context_vi": "Bạn vừa chuyển đến phòng 203 trong một tòa nhà giả định. Bạn gặp hàng xóm ở hành lang và muốn chào ngắn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0442a0e4-e850-5534-9a2d-667a972f079d-u01",
          "speaker_id": "a",
          "ja": "こんにちは。二〇三号室に引っ越してきたリンです。",
          "vi": "Chào anh. Tôi là Linh, vừa chuyển đến phòng 203."
        },
        {
          "id": "0442a0e4-e850-5534-9a2d-667a972f079d-u02",
          "speaker_id": "b",
          "ja": "こんにちは。二〇二号室の田中です。",
          "vi": "Chào chị. Tôi là Tanaka, ở phòng 202."
        },
        {
          "id": "0442a0e4-e850-5534-9a2d-667a972f079d-u03",
          "speaker_id": "a",
          "ja": "田中さん、よろしくお願いします。",
          "vi": "Anh Tanaka, mong được anh giúp đỡ."
        },
        {
          "id": "0442a0e4-e850-5534-9a2d-667a972f079d-u04",
          "speaker_id": "b",
          "ja": "こちらこそ。",
          "vi": "Tôi cũng vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "neighbor"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0442a0e4-e850-5534-9a2d-667a972f079d-u01": {
