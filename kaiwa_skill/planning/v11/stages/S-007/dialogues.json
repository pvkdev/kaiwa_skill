          },
          "0de8e2a5-97df-5025-94a6-6da53a5ca858-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "8d647bd9-2dfe-5c27-a62b-4091cc6cb792",
      "event_id": "E02",
      "context_vi": "Trong nhà ở ghép, bạn thấy một chiếc nồi của người ở cùng trên kệ. Bạn muốn mượn và hỏi trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8d647bd9-2dfe-5c27-a62b-4091cc6cb792-u01",
          "speaker_id": "a",
          "ja": "この鍋を借りてもいいですか。",
          "vi": "Tôi mượn cái nồi này được không?"
        },
        {
          "id": "8d647bd9-2dfe-5c27-a62b-4091cc6cb792-u02",
          "speaker_id": "b",
          "ja": "はい、今日ならいいですよ。",
          "vi": "Được, hôm nay thì cứ dùng."
        },
        {
          "id": "8d647bd9-2dfe-5c27-a62b-4091cc6cb792-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。使った後、洗って返します。",
          "vi": "Cảm ơn anh. Dùng xong tôi rửa rồi trả."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8d647bd9-2dfe-5c27-a62b-4091cc6cb792-u01": {
