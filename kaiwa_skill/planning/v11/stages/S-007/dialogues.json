          }
        }
      }
    },
    {
      "situation_uid": "b113dba4-5bc8-5836-8b2d-a1ce740fb677",
      "event_id": "E02",
      "context_vi": "Bạn muốn dùng bếp chung tối nay. Người ở cùng đồng ý, nhưng nhờ dọn bếp trước chín giờ theo lịch riêng của nhà.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b113dba4-5bc8-5836-8b2d-a1ce740fb677-u01",
          "speaker_id": "a",
          "ja": "今夜、台所を使ってもいいですか。",
          "vi": "Tối nay tôi dùng bếp được không?"
        },
        {
          "id": "b113dba4-5bc8-5836-8b2d-a1ce740fb677-u02",
          "speaker_id": "b",
          "ja": "はい。九時までに片づけてもらえますか。",
          "vi": "Được. Chị dọn xong trước chín giờ nhé?"
        },
        {
          "id": "b113dba4-5bc8-5836-8b2d-a1ce740fb677-u03",
          "speaker_id": "a",
          "ja": "はい、九時までに片づけます。",
          "vi": "Được, tôi sẽ dọn xong trước chín giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b113dba4-5bc8-5836-8b2d-a1ce740fb677-u01": {
