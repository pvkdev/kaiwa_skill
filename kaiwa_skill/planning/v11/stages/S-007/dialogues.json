    {
      "situation_uid": "6660f2cd-f6e6-56a4-9d73-df52450387c0",
      "event_id": "E03",
      "context_vi": "Tối qua bạn nói hơi lớn trong phòng. Sáng nay gặp người hàng xóm, bạn xin lỗi ngắn và hỏi anh ấy có bị làm phiền không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6660f2cd-f6e6-56a4-9d73-df52450387c0-u01",
          "speaker_id": "a",
          "ja": "昨夜は声が大きくて、すみませんでした。",
          "vi": "Tối qua tôi nói hơi to, xin lỗi anh."
        },
        {
          "id": "6660f2cd-f6e6-56a4-9d73-df52450387c0-u02",
          "speaker_id": "b",
          "ja": "少し聞こえましたが、大丈夫です。",
          "vi": "Tôi có nghe thấy một chút, nhưng không sao."
        },
        {
          "id": "6660f2cd-f6e6-56a4-9d73-df52450387c0-u03",
          "speaker_id": "a",
          "ja": "今夜から気をつけます。",
          "vi": "Từ tối nay tôi sẽ chú ý hơn."
        }
      ],
      "admin": {
        "source_refs": [
          "neighbor"
        ],
        "specialty_item_ids": [],
