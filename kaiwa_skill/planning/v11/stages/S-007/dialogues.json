    {
      "situation_uid": "7777157e-2937-5177-9fc8-22ac55eb9f8a",
      "event_id": "E02",
      "context_vi": "Sau khi máy giặt chung dừng giữa chừng, bạn quay lại gặp người ở cùng để hỏi đã báo người quản lý chưa, tránh gọi trùng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7777157e-2937-5177-9fc8-22ac55eb9f8a-u01",
          "speaker_id": "a",
          "ja": "管理の人に、もう連絡しましたか。",
          "vi": "Anh đã báo người quản lý chưa?"
        },
        {
          "id": "7777157e-2937-5177-9fc8-22ac55eb9f8a-u02",
          "speaker_id": "b",
          "ja": "まだです。リンさんが連絡すると聞きました。",
          "vi": "Chưa. Tôi nghe chị nói sẽ liên lạc."
        },
        {
          "id": "7777157e-2937-5177-9fc8-22ac55eb9f8a-u03",
          "speaker_id": "a",
          "ja": "はい、今から電話します。",
          "vi": "Ừ, giờ tôi sẽ gọi."
        },
        {
          "id": "7777157e-2937-5177-9fc8-22ac55eb9f8a-u04",
          "speaker_id": "b",
          "ja": "お願いします。",
          "vi": "Nhờ chị nhé."
        }
      ],
      "admin": {
