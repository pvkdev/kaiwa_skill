    {
      "situation_uid": "920db456-6053-53ee-9ea6-e2d613f6d7c2",
      "event_id": "E03",
      "context_vi": "Ngay sau khi hàng xóm đồng ý sẽ chuyển thùng khỏi lối đi chung nhưng nói sẽ làm sau, bạn cảm ơn và khép chuyện. Thùng chưa được chuyển.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "920db456-6053-53ee-9ea6-e2d613f6d7c2-u01",
          "speaker_id": "a",
          "ja": "ありがとうございます。では、お願いします。",
          "vi": "Cảm ơn anh. Vậy nhờ anh nhé."
        },
        {
          "id": "920db456-6053-53ee-9ea6-e2d613f6d7c2-u02",
          "speaker_id": "b",
          "ja": "はい、あとで入れます。",
          "vi": "Ừ, lát nữa tôi sẽ chuyển vào."
        },
        {
          "id": "920db456-6053-53ee-9ea6-e2d613f6d7c2-u03",
          "speaker_id": "a",
          "ja": "わかりました。",
          "vi": "Tôi hiểu rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "w_hall"
        ],
