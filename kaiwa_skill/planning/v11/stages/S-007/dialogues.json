    {
      "situation_uid": "661f46f6-5ffe-59a5-81bf-c7f447e6f3e4",
      "event_id": "E03",
      "context_vi": "Hôm sau, thùng vẫn ở lối đi. Bạn hỏi lại hàng xóm vì sao chưa chuyển; bạn cần đi qua nhưng chưa biết anh ấy gặp khó khăn gì.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "661f46f6-5ffe-59a5-81bf-c7f447e6f3e4-u01",
          "speaker_id": "a",
          "ja": "すみません、箱はまだここにあります。何か困っていますか。",
          "vi": "Xin lỗi, thùng vẫn ở đây. Anh có gặp khó khăn gì không?"
        },
        {
          "id": "661f46f6-5ffe-59a5-81bf-c7f447e6f3e4-u02",
          "speaker_id": "b",
          "ja": "重くて、一人では運べません。",
          "vi": "Nó nặng, tôi không bê một mình được."
        },
        {
          "id": "661f46f6-5ffe-59a5-81bf-c7f447e6f3e4-u03",
          "speaker_id": "a",
          "ja": "そうですか。私も手伝いましょうか。",
          "vi": "Vậy à. Tôi giúp anh một tay nhé?"
        }
      ],
      "admin": {
        "source_refs": [
          "w_hall"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
