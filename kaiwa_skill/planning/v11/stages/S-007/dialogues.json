          }
        }
      }
    },
    {
      "situation_uid": "0f16089c-150b-5ece-84f2-d43eca4bbcdb",
      "event_id": "E01",
      "context_vi": "Ở khu máy giặt dùng chung của tòa nhà, bạn hỏi người quản lý giờ được dùng. Giờ trả lời chỉ là nội quy của tòa nhà giả định.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý tòa nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0f16089c-150b-5ece-84f2-d43eca4bbcdb-u01",
          "speaker_id": "a",
          "ja": "洗濯機は何時から使えますか。",
          "vi": "Máy giặt dùng từ mấy giờ ạ?"
        },
        {
          "id": "0f16089c-150b-5ece-84f2-d43eca4bbcdb-u02",
          "speaker_id": "b",
          "ja": "この建物では、朝七時から夜九時までです。",
          "vi": "Ở tòa nhà này, từ bảy giờ sáng đến chín giờ tối."
        },
        {
          "id": "0f16089c-150b-5ece-84f2-d43eca4bbcdb-u03",
          "speaker_id": "a",
          "ja": "夜九時までですね。",
          "vi": "Đến chín giờ tối nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0f16089c-150b-5ece-84f2-d43eca4bbcdb-u01": {
            "kind": "original_extension"
          },
          "0f16089c-150b-5ece-84f2-d43eca4bbcdb-u02": {
            "kind": "original_extension"
          },
          "0f16089c-150b-5ece-84f2-d43eca4bbcdb-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7b519c33-6f61-5fac-9d24-ecbf125929d4",
      "event_id": "E01",
      "context_vi": "Bạn có xe đạp và chưa biết chỗ để xe của tòa nhà. Bạn hỏi người quản lý trước khi dắt xe vào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý tòa nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7b519c33-6f61-5fac-9d24-ecbf125929d4-u01",
          "speaker_id": "a",
          "ja": "自転車はどこに置けばいいですか。",
          "vi": "Tôi để xe đạp ở đâu ạ?"
        },
        {
          "id": "7b519c33-6f61-5fac-9d24-ecbf125929d4-u02",
          "speaker_id": "b",
          "ja": "この建物の駐輪場は、入口の右です。",
          "vi": "Chỗ để xe của tòa nhà này ở bên phải cửa vào."
        },
        {
          "id": "7b519c33-6f61-5fac-9d24-ecbf125929d4-u03",
          "speaker_id": "a",
          "ja": "入口の右ですね。ありがとうございます。",
          "vi": "Bên phải cửa vào nhỉ. Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7b519c33-6f61-5fac-9d24-ecbf125929d4-u01": {
            "kind": "original_extension"
          },
          "7b519c33-6f61-5fac-9d24-ecbf125929d4-u02": {
            "kind": "original_extension"
          },
          "7b519c33-6f61-5fac-9d24-ecbf125929d4-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "af6501ab-f771-5bbb-9e17-df28765c0b92",
      "event_id": "E01",
      "context_vi": "Bạn đặt một thùng đồ của mình ở hành lang chung cạnh phòng 203, tưởng có thể để tạm. Hàng xóm nói khu này cần để lối đi trống.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "af6501ab-f771-5bbb-9e17-df28765c0b92-u01",
          "speaker_id": "b",
          "ja": "すみません、この箱はリンさんのですか。",
          "vi": "Xin lỗi, thùng này của chị Linh à?"
        },
        {
          "id": "af6501ab-f771-5bbb-9e17-df28765c0b92-u02",
          "speaker_id": "a",
          "ja": "はい。ここに置いてもいいと思いました。",
          "vi": "Vâng. Tôi tưởng để ở đây được."
        },
        {
          "id": "af6501ab-f771-5bbb-9e17-df28765c0b92-u03",
          "speaker_id": "b",
          "ja": "ここはみんなの通り道です。箱は部屋にお願いします。",
          "vi": "Đây là lối đi chung. Chị để thùng vào phòng nhé."
        },
        {
          "id": "af6501ab-f771-5bbb-9e17-df28765c0b92-u04",
          "speaker_id": "a",
          "ja": "そうでしたか。すみません。",
          "vi": "Vậy à. Tôi xin lỗi."
        }
      ],
      "admin": {
        "source_refs": [
          "w_hall",
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "af6501ab-f771-5bbb-9e17-df28765c0b92-u01": {
            "kind": "original_extension"
          },
