    {
      "situation_uid": "dd454a66-ae51-5b6d-bec1-14614f9cc0e6",
      "event_id": "E03",
      "context_vi": "Thùng đồ của hàng xóm đang chắn một phần lối đi chung. Bạn hỏi anh ấy có thể chuyển vào phòng không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "dd454a66-ae51-5b6d-bec1-14614f9cc0e6-u01",
          "speaker_id": "a",
          "ja": "すみません、この箱を部屋に入れてもらえますか。",
          "vi": "Xin lỗi, anh chuyển thùng này vào phòng được không?"
        },
        {
          "id": "dd454a66-ae51-5b6d-bec1-14614f9cc0e6-u02",
          "speaker_id": "b",
          "ja": "あ、私のです。後で入れます。",
          "vi": "À, của tôi. Lát nữa tôi sẽ chuyển vào."
        },
        {
          "id": "dd454a66-ae51-5b6d-bec1-14614f9cc0e6-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。ここを通りたいので。",
          "vi": "Cảm ơn anh. Tôi cần đi qua lối này."
        }
      ],
      "admin": {
        "source_refs": [
          "w_hall",
          "neighbor"
        ],
        "specialty_item_ids": [],
