          },
          "1602c4c1-8e5e-54f1-bb76-9952259b202e-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "293f81a6-a917-560b-a316-fcd619535035",
      "event_id": "E02",
      "context_vi": "Quầy đang đứng không xử lý mở tài khoản. Bạn nhờ nhân viên chỉ quầy tư vấn trong cùng chi nhánh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ngân hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "293f81a6-a917-560b-a316-fcd619535035-u01",
          "speaker_id": "b",
          "ja": "こちらでは口座開設を扱っていません。",
          "vi": "Quầy này không xử lý mở tài khoản ạ."
        },
        {
          "id": "293f81a6-a917-560b-a316-fcd619535035-u02",
          "speaker_id": "a",
          "ja": "どちらで聞けばいいですか。",
          "vi": "Vậy tôi nên hỏi ở đâu ạ?"
        },
        {
          "id": "293f81a6-a917-560b-a316-fcd619535035-u03",
          "speaker_id": "b",
          "ja": "奥の相談窓口です。",
          "vi": "Quầy tư vấn phía trong ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "293f81a6-a917-560b-a316-fcd619535035-u01": {
