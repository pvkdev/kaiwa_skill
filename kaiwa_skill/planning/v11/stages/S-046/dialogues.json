    {
      "situation_uid": "32f42eda-38b5-5599-a671-78461e01ac28",
      "event_id": "E06",
      "context_vi": "Vừa rời cửa hàng tiện lợi hư cấu, bạn thấy nhãn kiện thiếu số phòng 205. Kiện vẫn đang ở cửa hàng nên bạn quay lại hỏi ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người gửi",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên konbini",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "32f42eda-38b5-5599-a671-78461e01ac28-u01",
          "speaker_id": "a",
          "ja": "部屋番号を書き忘れました。荷物はもうヤマトに渡しましたか。",
          "vi": "Tôi quên ghi số phòng. Gói hàng đã được giao cho Yamato chưa ạ?"
        },
        {
          "id": "32f42eda-38b5-5599-a671-78461e01ac28-u02",
          "speaker_id": "b",
          "ja": "まだ店にあります。こちらで送り状を確認できます。",
          "vi": "Gói vẫn ở cửa hàng. Chúng tôi có thể kiểm tra nhãn gửi tại đây."
        },
        {
          "id": "32f42eda-38b5-5599-a671-78461e01ac28-u03",
          "speaker_id": "a",
          "ja": "部屋番号は二〇五です。ここで直せますか。",
          "vi": "Số phòng là 205. Tôi sửa ở đây được không ạ?"
        },
        {
          "id": "32f42eda-38b5-5599-a671-78461e01ac28-u04",
          "speaker_id": "b",
          "ja": "はい。送り状を確認して、二〇五号室に直しました。",
          "vi": "Được. Tôi đã kiểm nhãn và sửa thành phòng 205."
        }
      ],
