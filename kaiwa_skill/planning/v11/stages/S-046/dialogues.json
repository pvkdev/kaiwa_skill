    {
      "situation_uid": "e70153c9-ad41-504e-9fbb-0455d60f423f",
      "event_id": "E06",
      "context_vi": "Bạn chưa mang thùng vào một cửa hàng tiện lợi hư cấu. Bạn hỏi cửa hàng này có nhận kiện nội địa Yamato không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người gửi",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên konbini",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e70153c9-ad41-504e-9fbb-0455d60f423f-u01",
          "speaker_id": "a",
          "ja": "この店でヤマトの国内の荷物を出せますか。",
          "vi": "Cửa hàng này có nhận gửi kiện nội địa qua Yamato không ạ?"
        },
        {
          "id": "e70153c9-ad41-504e-9fbb-0455d60f423f-u02",
          "speaker_id": "b",
          "ja": "はい、こちらで受け付けています。",
          "vi": "Có, cửa hàng này có nhận ạ."
        }
      ],
