    {
      "situation_uid": "6df74f37-eb00-5ebc-b600-7a19e28f8d23",
      "event_id": "E02",
      "context_vi": "Bạn đứng ở chi nhánh Sakura hư cấu và hỏi quầy này có nhận tư vấn mở tài khoản không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ngân hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6df74f37-eb00-5ebc-b600-7a19e28f8d23-u01",
          "speaker_id": "a",
          "ja": "口座を開きたいです。この窓口で相談できますか。",
          "vi": "Tôi muốn mở tài khoản. Tôi có thể hỏi ở quầy này không ạ?"
        },
        {
          "id": "6df74f37-eb00-5ebc-b600-7a19e28f8d23-u02",
          "speaker_id": "b",
          "ja": "はい、こちらで伺います。",
          "vi": "Được, tôi sẽ tiếp nhận tại đây."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "6df74f37-eb00-5ebc-b600-7a19e28f8d23-u01": {
            "kind": "original_extension"
          },
          "6df74f37-eb00-5ebc-b600-7a19e28f8d23-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "71a958fd-e43f-536f-9a75-820dd7cbec31",
      "event_id": "E02",
      "context_vi": "Bạn đã hỏi mở tài khoản ở chi nhánh Sakura hư cấu. Bạn hỏi chính chi nhánh ấy cần mang giấy tờ gì.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ngân hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "71a958fd-e43f-536f-9a75-820dd7cbec31-u01",
          "speaker_id": "a",
          "ja": "口座の相談には、何を持って来ればいいですか。",
          "vi": "Khi đến hỏi mở tài khoản, tôi cần mang gì ạ?"
        },
        {
          "id": "71a958fd-e43f-536f-9a75-820dd7cbec31-u02",
          "speaker_id": "b",
          "ja": "この支店では、在留カードと住所が分かるものをお持ちください。",
          "vi": "Tại chi nhánh này, bạn mang thẻ cư trú và giấy tờ thể hiện địa chỉ nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "71a958fd-e43f-536f-9a75-820dd7cbec31-u01": {
            "kind": "original_extension"
          },
          "71a958fd-e43f-536f-9a75-820dd7cbec31-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "1602c4c1-8e5e-54f1-bb76-9952259b202e",
      "event_id": "E02",
      "context_vi": "Bạn chưa mang đủ giấy tờ chi nhánh Sakura hư cấu vừa nêu. Bạn hỏi ngày giờ có thể quay lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ngân hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1602c4c1-8e5e-54f1-bb76-9952259b202e-u01",
          "speaker_id": "a",
          "ja": "今日は必要なものを持っていません。明日、また来てもいいですか。",
          "vi": "Hôm nay tôi chưa mang đủ. Ngày mai tôi quay lại được không ạ?"
        },
        {
          "id": "1602c4c1-8e5e-54f1-bb76-9952259b202e-u02",
          "speaker_id": "b",
          "ja": "はい。明日は九時から三時までです。在留カードと住所が分かるものを持って来てください。",
          "vi": "Được. Ngày mai tiếp nhận từ 9 giờ đến 3 giờ. Bạn mang thẻ cư trú và giấy thể hiện địa chỉ nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1602c4c1-8e5e-54f1-bb76-9952259b202e-u01": {
