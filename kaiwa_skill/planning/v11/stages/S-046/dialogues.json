    {
      "situation_uid": "b06e5ce7-38c5-5909-9d29-9ab9927baa6e",
      "event_id": "E03",
      "context_vi": "Bạn gửi một phong bì tài liệu 100 g từ bưu cục hư cấu đến Osaka. Bạn hỏi cách gửi nhanh hơn thư thường và chọn sau khi nghe mức phí thêm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bưu điện",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b06e5ce7-38c5-5909-9d29-9ab9927baa6e-u01",
          "speaker_id": "a",
          "ja": "この封筒を大阪へ早く送りたいです。普通郵便と何が違いますか。",
          "vi": "Tôi muốn gửi nhanh phong bì này đến Osaka. Khác thư thường thế nào ạ?"
        },
        {
          "id": "b06e5ce7-38c5-5909-9d29-9ab9927baa6e-u02",
          "speaker_id": "b",
          "ja": "速達にできます。この重さなら追加料金は三百円です。お届け予定日は別に確認します。",
          "vi": "Có thể chọn chuyển phát nhanh. Với trọng lượng này, phụ phí là 300 yên. Tôi sẽ kiểm tra riêng ngày dự kiến đến."
        },
        {
          "id": "b06e5ce7-38c5-5909-9d29-9ab9927baa6e-u03",
          "speaker_id": "a",
          "ja": "では、速達でお願いします。",
          "vi": "Vậy cho tôi gửi chuyển phát nhanh."
