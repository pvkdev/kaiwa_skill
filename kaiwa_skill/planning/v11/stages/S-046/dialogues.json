    {
      "situation_uid": "4cd5a94d-6c0d-582e-9b8f-8315a6b7c271",
      "event_id": "E06",
      "context_vi": "Bạn mang hai kiện tới cửa hàng tiện lợi: kiện đỏ tự trả cước, kiện xanh người nhận trả. Bạn chỉ rõ từng kiện.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người gửi",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên konbini",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4cd5a94d-6c0d-582e-9b8f-8315a6b7c271-u01",
          "speaker_id": "a",
          "ja": "赤い箱は私が払います。青い箱は受取人が払います。",
          "vi": "Kiện đỏ tôi trả cước. Kiện xanh người nhận trả cước."
        },
        {
          "id": "4cd5a94d-6c0d-582e-9b8f-8315a6b7c271-u02",
          "speaker_id": "b",
          "ja": "赤は発払い、青は着払いですね。",
          "vi": "Đỏ người gửi trả, xanh người nhận trả phải không ạ?"
        },
        {
          "id": "4cd5a94d-6c0d-582e-9b8f-8315a6b7c271-u03",
          "speaker_id": "a",
          "ja": "はい。その二つでお願いします。",
          "vi": "Vâng. Nhờ anh nhận đúng như vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
