  "dialogues": [
    {
      "situation_uid": "fd2459b0-f558-5a01-9a82-745f53d4669d",
      "event_id": "E01",
      "context_vi": "Ngân hàng Sakura hư cấu có nhiều quầy. Bạn cần tìm quầy giao dịch gửi và rút tiền mặt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ngân hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fd2459b0-f558-5a01-9a82-745f53d4669d-u01",
          "speaker_id": "a",
          "ja": "現金の預け入れと引き出しは、どちらの窓口ですか。",
          "vi": "Quầy nào nhận gửi và rút tiền mặt ạ?"
        },
        {
          "id": "fd2459b0-f558-5a01-9a82-745f53d4669d-u02",
          "speaker_id": "b",
          "ja": "三番窓口です。",
          "vi": "Quầy số 3 ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fd2459b0-f558-5a01-9a82-745f53d4669d-u01": {
            "kind": "original_extension"
          },
          "fd2459b0-f558-5a01-9a82-745f53d4669d-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d4ca0c24-f05b-57da-a014-9f6f87527839",
      "event_id": "E01",
      "context_vi": "Bạn đang ở quầy giao dịch tiền mặt của Ngân hàng Sakura hư cấu vào buổi sáng và muốn biết giờ tiếp nhận hôm nay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ngân hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d4ca0c24-f05b-57da-a014-9f6f87527839-u01",
          "speaker_id": "a",
          "ja": "現金の窓口は今日は何時までですか。",
          "vi": "Hôm nay quầy giao dịch tiền mặt mở đến mấy giờ ạ?"
        },
        {
          "id": "d4ca0c24-f05b-57da-a014-9f6f87527839-u02",
          "speaker_id": "b",
          "ja": "今日は三時までです。",
          "vi": "Hôm nay đến 3 giờ ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d4ca0c24-f05b-57da-a014-9f6f87527839-u01": {
            "kind": "original_extension"
          },
