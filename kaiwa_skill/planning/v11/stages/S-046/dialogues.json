            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "b597e699-311f-5869-a531-7ec7dfea16a3",
      "event_id": "E01",
      "context_vi": "Sau khi sửa số tiền, bạn kiểm lại với nhân viên rằng khoản gửi là 15.000 yên.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ngân hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b597e699-311f-5869-a531-7ec7dfea16a3-u01",
          "speaker_id": "a",
          "ja": "預けるのは一万五千円ですね。",
          "vi": "Số tiền gửi là 15.000 yên phải không ạ?"
        },
        {
          "id": "b597e699-311f-5869-a531-7ec7dfea16a3-u02",
          "speaker_id": "b",
          "ja": "はい、一万五千円です。",
          "vi": "Vâng, 15.000 yên."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
