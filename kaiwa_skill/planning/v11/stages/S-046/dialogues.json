    {
      "situation_uid": "0d1e0f6e-aa93-55ec-9b80-05546a688e01",
      "event_id": "E05",
      "context_vi": "Quà là bánh cần giữ lạnh. Bạn hỏi nhân viên Yamato cần chuẩn bị thế nào trước khi họ nhận kiện.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người gửi",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên Yamato",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0d1e0f6e-aa93-55ec-9b80-05546a688e01-u01",
          "speaker_id": "a",
          "ja": "冷やして送るケーキです。預ける前に何をすればいいですか。",
          "vi": "Đây là bánh cần gửi lạnh. Trước khi giao cho quầy, tôi cần làm gì ạ?"
        },
        {
          "id": "0d1e0f6e-aa93-55ec-9b80-05546a688e01-u02",
          "speaker_id": "b",
          "ja": "発送直前まで冷やし、水分が漏れないよう袋に入れてから箱に詰めてください。",
          "vi": "Bạn cần giữ bánh lạnh tới sát lúc gửi, cho vào túi chống rò nước rồi đóng hộp."
        },
        {
          "id": "0d1e0f6e-aa93-55ec-9b80-05546a688e01-u03",
          "speaker_id": "a",
          "ja": "分かりました。準備してから持って来ます。",
          "vi": "Tôi hiểu. Tôi sẽ chuẩn bị rồi mang tới."
        }
      ],
      "admin": {
