          }
        }
      }
    },
    {
      "situation_uid": "b9f1cf70-039b-51a9-82f2-cf87cb88322e",
      "event_id": "E01",
      "context_vi": "Bạn mang 15.000 yên tiền mặt tới quầy ngân hàng hư cấu và muốn nhân viên nghe đúng số tiền.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ngân hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b9f1cf70-039b-51a9-82f2-cf87cb88322e-u01",
          "speaker_id": "a",
          "ja": "一万五千円を預けたいです。",
          "vi": "Tôi muốn gửi 15.000 yên."
        },
        {
          "id": "b9f1cf70-039b-51a9-82f2-cf87cb88322e-u02",
          "speaker_id": "b",
          "ja": "一万五千円ですね。",
          "vi": "15.000 yên ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b9f1cf70-039b-51a9-82f2-cf87cb88322e-u01": {
            "kind": "original_extension"
          },
          "b9f1cf70-039b-51a9-82f2-cf87cb88322e-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "aab30a45-6a65-5dcb-acec-3f89ed000403",
      "event_id": "E01",
      "context_vi": "Nhân viên ngân hàng hư cấu nhắc nhầm 15.000 yên thành 50.000 yên trước khi xử lý. Bạn sửa ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ngân hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "aab30a45-6a65-5dcb-acec-3f89ed000403-u01",
          "speaker_id": "b",
          "ja": "五万円ですね。",
          "vi": "50.000 yên phải không ạ?"
        },
        {
          "id": "aab30a45-6a65-5dcb-acec-3f89ed000403-u02",
          "speaker_id": "a",
          "ja": "いいえ、一万五千円です。",
          "vi": "Không, 15.000 yên ạ."
        },
        {
          "id": "aab30a45-6a65-5dcb-acec-3f89ed000403-u03",
          "speaker_id": "b",
          "ja": "失礼しました。一万五千円ですね。",
          "vi": "Xin lỗi tôi nghe nhầm. 15.000 yên ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "aab30a45-6a65-5dcb-acec-3f89ed000403-u01": {
