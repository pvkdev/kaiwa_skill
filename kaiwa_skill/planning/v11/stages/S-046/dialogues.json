        }
      }
    },
    {
      "situation_uid": "ed7f9eb0-5b9f-5332-a940-034d6c9189de",
      "event_id": "E02",
      "context_vi": "Ngày hôm sau, bạn quay lại chi nhánh Sakura hư cấu theo hướng dẫn trước và mang hai giấy tờ đã được nêu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ngân hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ed7f9eb0-5b9f-5332-a940-034d6c9189de-u01",
          "speaker_id": "a",
          "ja": "前に口座のことで相談しました。在留カードと住所が分かるものを持って来ました。",
          "vi": "Lần trước tôi đã hỏi về mở tài khoản. Hôm nay tôi mang thẻ cư trú và giấy thể hiện địa chỉ."
        },
        {
          "id": "ed7f9eb0-5b9f-5332-a940-034d6c9189de-u02",
          "speaker_id": "b",
          "ja": "ありがとうございます。二つとも確認します。こちらへどうぞ。",
          "vi": "Cảm ơn bạn. Tôi sẽ kiểm tra cả hai. Mời bạn vào quầy này."
        }
      ],
      "admin": {
