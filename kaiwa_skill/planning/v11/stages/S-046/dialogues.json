    {
      "situation_uid": "28c3ab45-b785-5133-9e4b-6b761681878d",
      "event_id": "E03",
      "context_vi": "Tại bưu điện hư cấu, bạn mang một bưu phẩm cần gửi trong nước đến Osaka.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bưu điện",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "28c3ab45-b785-5133-9e4b-6b761681878d-u01",
          "speaker_id": "a",
          "ja": "この荷物を国内に送りたいです。",
          "vi": "Tôi muốn gửi gói đồ này trong nước."
        },
        {
          "id": "28c3ab45-b785-5133-9e4b-6b761681878d-u02",
          "speaker_id": "b",
          "ja": "お届け先はどちらですか。",
          "vi": "Địa chỉ nhận ở đâu ạ?"
        },
        {
