    {
      "situation_uid": "db15865e-bebe-50fb-b3d5-2fbeb5361cfc",
      "event_id": "E05",
      "context_vi": "Người nhận quà chỉ ở nhà buổi tối. Bạn hỏi quầy Yamato khung giờ chọn được cho kiện này và ngày dự kiến.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người gửi",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên Yamato",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "db15865e-bebe-50fb-b3d5-2fbeb5361cfc-u01",
          "speaker_id": "a",
          "ja": "受け取る人は夜だけ家にいます。この荷物は何時を選べますか。届ける日はいつの予定ですか。",
          "vi": "Người nhận chỉ có nhà buổi tối. Gói này chọn khung giờ nào và dự kiến giao ngày nào ạ?"
        },
        {
          "id": "db15865e-bebe-50fb-b3d5-2fbeb5361cfc-u02",
          "speaker_id": "b",
          "ja": "今の確認では、金曜日の十八時から二十時、または十九時から二十一時を選べます。",
          "vi": "Theo thông tin vừa kiểm tra, bạn có thể chọn thứ Sáu từ 18 đến 20 giờ, hoặc từ 19 đến 21 giờ."
        },
        {
          "id": "db15865e-bebe-50fb-b3d5-2fbeb5361cfc-u03",
          "speaker_id": "a",
          "ja": "では、金曜日の十九時から二十一時でお願いします。",
          "vi": "Vậy cho tôi chọn thứ Sáu từ 19 đến 21 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
