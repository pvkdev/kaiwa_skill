    {
      "situation_uid": "3cebc670-358f-516e-8b50-af3883244015",
      "event_id": "E06",
      "context_vi": "Nhân viên cửa hàng hư cấu báo lượt lấy kiện hôm nay đã qua. Bạn hỏi lượt tiếp và chọn mang tới quầy Yamato.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người gửi",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên konbini",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3cebc670-358f-516e-8b50-af3883244015-u01",
          "speaker_id": "b",
          "ja": "今日の集荷はもう終わりました。次は明日の午前です。",
          "vi": "Lượt lấy kiện hôm nay đã qua. Lượt tiếp theo là sáng mai."
        },
        {
          "id": "3cebc670-358f-516e-8b50-af3883244015-u02",
          "speaker_id": "a",
          "ja": "では、今日はヤマトの営業所に持っていきます。場所を教えてください。",
          "vi": "Vậy hôm nay tôi mang tới quầy Yamato. Cho tôi biết đường đi ạ?"
        },
        {
          "id": "3cebc670-358f-516e-8b50-af3883244015-u03",
          "speaker_id": "b",
          "ja": "駅の東口を出て右です。",
          "vi": "Ra cửa đông nhà ga rồi rẽ phải."
        }
      ],
      "admin": {
