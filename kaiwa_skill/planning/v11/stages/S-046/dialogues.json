    {
      "situation_uid": "50313ef9-6668-5ed1-a8da-8a3650f72ec1",
      "event_id": "E05",
      "context_vi": "Quầy Yamato đã nhận kiện. Bạn chỉ vào biên nhận và hỏi số nào để người thân tra cứu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người gửi",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên Yamato",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "50313ef9-6668-5ed1-a8da-8a3650f72ec1-u01",
          "speaker_id": "a",
          "ja": "家族に知らせたいです。送り状のどの番号で荷物を調べられますか。",
          "vi": "Tôi muốn báo cho gia đình. Dùng số nào trên biên nhận để theo dõi gói hàng ạ?"
        },
        {
          "id": "50313ef9-6668-5ed1-a8da-8a3650f72ec1-u02",
          "speaker_id": "b",
          "ja": "こちらのお問い合わせ番号です。",
          "vi": "Là mã tra cứu ở đây ạ."
        }
      ],
