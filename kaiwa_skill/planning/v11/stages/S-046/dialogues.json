    {
      "situation_uid": "dc62fd10-f555-503f-a400-7f36eb9f66b0",
      "event_id": "E05",
      "context_vi": "Tại một quầy Yamato ở Tokyo, bạn gửi quà đến địa chỉ hư cấu ở Osaka trước sinh nhật thứ Bảy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người gửi",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên Yamato",
