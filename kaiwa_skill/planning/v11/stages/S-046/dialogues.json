    {
      "situation_uid": "5b0cebc1-a06d-5cc1-a3c6-f6860ac91f7b",
      "event_id": "E06",
      "context_vi": "Cửa hàng tiện lợi không nhận kiện gửi lạnh. Bạn hỏi đường tới quầy Yamato gần ga.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người gửi",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên konbini",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5b0cebc1-a06d-5cc1-a3c6-f6860ac91f7b-u01",
          "speaker_id": "b",
          "ja": "クール便はここでは預かれません。",
          "vi": "Chúng tôi không nhận kiện gửi lạnh tại đây."
        },
        {
          "id": "5b0cebc1-a06d-5cc1-a3c6-f6860ac91f7b-u02",
          "speaker_id": "a",
          "ja": "近くのヤマトの窓口はどこですか。",
          "vi": "Quầy Yamato gần đây ở đâu ạ?"
        },
        {
          "id": "5b0cebc1-a06d-5cc1-a3c6-f6860ac91f7b-u03",
          "speaker_id": "b",
          "ja": "駅の東口の近くです。",
          "vi": "Gần cửa đông nhà ga ạ."
        }
      ],
