        {
          "id": "b",
          "role_vi": "nhân viên giao món",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "73e917e2-a24c-50bf-a4b2-d5712972611c-u01",
          "speaker_id": "a",
          "ja": "すみません。自分で飲み物をこぼしました。片づけを手伝ってもらえますか。",
          "vi": "Xin lỗi, tôi làm đổ đồ uống. Chị giúp tôi dọn được không ạ?"
