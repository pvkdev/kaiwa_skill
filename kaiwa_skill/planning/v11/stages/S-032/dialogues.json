    },
    {
      "situation_uid": "fb6afc3b-991e-5dff-b418-375164f99cff",
      "event_id": "E02",
      "context_vi": "Tại Kumo, bạn gọi trà lạnh và muốn ít đá hơn. Bạn hỏi trước khi quầy pha.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "fb6afc3b-991e-5dff-b418-375164f99cff-u01",
          "speaker_id": "a",
          "ja": "氷を少なめにできますか。",
          "vi": "Cho ít đá hơn được không ạ?"
        },
        {
          "id": "fb6afc3b-991e-5dff-b418-375164f99cff-u02",
          "speaker_id": "b",
          "ja": "はい、この飲み物はできます。",
          "vi": "Được ạ, món này làm được."
        },
        {
          "id": "fb6afc3b-991e-5dff-b418-375164f99cff-u03",
          "speaker_id": "a",
          "ja": "では、少なめでお願いします。",
          "vi": "Vậy cho ít đá giúp tôi."
        }
      ],
      "admin": {
        "source_refs": [
          "cafe_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fb6afc3b-991e-5dff-b418-375164f99cff-u01": {
