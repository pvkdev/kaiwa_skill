            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "af8836b0-b87e-51ec-9937-75f6e82bd70c",
      "event_id": "E01",
      "context_vi": "Ở Kumo, bạn chọn trà nóng cỡ nhỏ và muốn uống tại quán. Bạn nói đủ cỡ, nhiệt độ và cách dùng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "af8836b0-b87e-51ec-9937-75f6e82bd70c-u01",
          "speaker_id": "a",
          "ja": "温かい紅茶を小さいサイズで。店内で飲みます。",
          "vi": "Cho tôi trà nóng cỡ nhỏ. Tôi uống tại quán ạ."
        },
        {
          "id": "af8836b0-b87e-51ec-9937-75f6e82bd70c-u02",
          "speaker_id": "b",
          "ja": "ホットの小さいサイズ、店内ですね。",
          "vi": "Trà nóng cỡ nhỏ, uống tại quán nhé ạ."
        },
        {
          "id": "af8836b0-b87e-51ec-9937-75f6e82bd70c-u03",
          "speaker_id": "a",
          "ja": "はい、それでお願いします。",
          "vi": "Vâng, đúng vậy ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "cafe_book",
          "drink"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "af8836b0-b87e-51ec-9937-75f6e82bd70c-u01": {
            "kind": "original_extension"
