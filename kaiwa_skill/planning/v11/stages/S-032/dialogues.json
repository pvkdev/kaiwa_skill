        {
          "id": "73e917e2-a24c-50bf-a4b2-d5712972611c-u02",
          "speaker_id": "b",
          "ja": "はい。まずこちらを拭きます。けがはありませんか。",
          "vi": "Được ạ. Tôi lau chỗ này trước. Anh có bị thương không?"
        },
