    {
      "situation_uid": "3ec3cbf4-dcf8-5e94-92eb-1028ce577f4b",
      "event_id": "E02",
      "context_vi": "Tại Kumo, nhân viên hiểu bạn muốn mang đồ uống đi, nhưng bạn định ngồi uống ở quán. Bạn nhận ra trước khi thanh toán.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "3ec3cbf4-dcf8-5e94-92eb-1028ce577f4b-u01",
          "speaker_id": "b",
          "ja": "お持ち帰りですね。",
          "vi": "Anh mang đi nhé ạ."
        },
        {
          "id": "3ec3cbf4-dcf8-5e94-92eb-1028ce577f4b-u02",
          "speaker_id": "a",
          "ja": "すみません、店内で飲みます。",
          "vi": "Xin lỗi, tôi uống tại quán ạ."
        },
        {
          "id": "3ec3cbf4-dcf8-5e94-92eb-1028ce577f4b-u03",
          "speaker_id": "b",
          "ja": "失礼しました。店内ですね。",
