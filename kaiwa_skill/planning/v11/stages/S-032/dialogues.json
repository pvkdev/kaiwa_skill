          }
        }
      }
    },
    {
      "situation_uid": "819c15f9-34b7-535d-bda2-bc6036ade2f1",
      "event_id": "E02",
      "context_vi": "Tại Kumo hư cấu, loại latte pha sẵn không thể bỏ sữa trong đơn này. Bạn cần tránh sữa và chọn trà đen không thêm sữa, nhưng vẫn yêu cầu quầy kiểm thành phần cụ thể.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "819c15f9-34b7-535d-bda2-bc6036ade2f1-u01",
          "speaker_id": "b",
          "ja": "このラテは牛乳を抜けません。",
          "vi": "Latte này không bỏ sữa được ạ."
        },
        {
          "id": "819c15f9-34b7-535d-bda2-bc6036ade2f1-u02",
          "speaker_id": "a",
          "ja": "では、紅茶を見たいです。牛乳が入らないか確認できますか。",
          "vi": "Vậy tôi muốn xem trà đen. Chị kiểm xem có sữa không được chứ ạ?"
        },
        {
          "id": "819c15f9-34b7-535d-bda2-bc6036ade2f1-u03",
          "speaker_id": "b",
          "ja": "はい。材料を確認してお伝えします。",
          "vi": "Vâng, tôi kiểm nguyên liệu rồi báo anh."
        },
        {
          "id": "819c15f9-34b7-535d-bda2-bc6036ade2f1-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。待ちます。",
          "vi": "Cảm ơn chị. Tôi chờ ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "caa_allergy",
          "cafe_book"
        ],
