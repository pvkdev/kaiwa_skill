            "kind": "original_extension"
          },
          "fb6afc3b-991e-5dff-b418-375164f99cff-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "defef31a-4f9c-53d0-8ca0-84e289ae738b",
      "event_id": "E02",
      "context_vi": "Bạn cần tránh sữa và đang xem một món đồ uống của Kumo. Bạn hỏi thành phần, nhân viên kiểm thông tin của đúng món thay vì đoán.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "defef31a-4f9c-53d0-8ca0-84e289ae738b-u01",
          "speaker_id": "a",
          "ja": "この飲み物に牛乳は入っていますか。",
          "vi": "Đồ uống này có sữa bò không ạ?"
        },
        {
          "id": "defef31a-4f9c-53d0-8ca0-84e289ae738b-u02",
          "speaker_id": "b",
          "ja": "材料の表示を確認します。少々お待ちください。",
          "vi": "Tôi kiểm phần nguyên liệu. Anh chờ chút nhé."
        },
        {
          "id": "defef31a-4f9c-53d0-8ca0-84e289ae738b-u03",
          "speaker_id": "a",
          "ja": "お願いします。確認してから決めます。",
          "vi": "Nhờ chị kiểm tra. Tôi sẽ quyết định sau khi biết rõ."
        }
      ],
      "admin": {
        "source_refs": [
          "caa_allergy",
          "cafe_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "defef31a-4f9c-53d0-8ca0-84e289ae738b-u01": {
