          },
          "fd86984d-5930-51e7-b916-4f7847b0fa4d-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7e5be73d-070b-54f7-b579-bb96b201c717",
      "event_id": "E01",
      "context_vi": "Tại Kumo, nước táo đã hết. Bạn chọn trà lạnh thay thế và chờ nhân viên nhắc lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "7e5be73d-070b-54f7-b579-bb96b201c717-u01",
          "speaker_id": "a",
          "ja": "りんごジュースを一つください。",
          "vi": "Cho tôi một nước táo ạ."
        },
        {
          "id": "7e5be73d-070b-54f7-b579-bb96b201c717-u02",
          "speaker_id": "b",
          "ja": "すみません。今日は売り切れです。冷たい紅茶ならあります。",
          "vi": "Xin lỗi, hôm nay nước táo hết rồi. Trà lạnh thì còn ạ."
        },
        {
          "id": "7e5be73d-070b-54f7-b579-bb96b201c717-u03",
          "speaker_id": "a",
          "ja": "では、冷たい紅茶を一つください。",
          "vi": "Vậy cho tôi một trà lạnh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "cafe_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7e5be73d-070b-54f7-b579-bb96b201c717-u01": {
