          "af8836b0-b87e-51ec-9937-75f6e82bd70c-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "fd86984d-5930-51e7-b916-4f7847b0fa4d",
      "event_id": "E01",
      "context_vi": "Tại quán fast-food Kumo, bạn hỏi set burger của cửa hàng này gồm gì trước khi gọi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "fd86984d-5930-51e7-b916-4f7847b0fa4d-u01",
          "speaker_id": "a",
          "ja": "このセットには何が付きますか。",
          "vi": "Set này gồm những món gì ạ?"
        },
        {
          "id": "fd86984d-5930-51e7-b916-4f7847b0fa4d-u02",
          "speaker_id": "b",
          "ja": "バーガーと小さいポテト、飲み物が一つです。",
          "vi": "Có burger, khoai tây cỡ nhỏ và một đồ uống ạ."
        },
        {
          "id": "fd86984d-5930-51e7-b916-4f7847b0fa4d-u03",
          "speaker_id": "a",
          "ja": "飲み物は紅茶にできますか。",
          "vi": "Tôi chọn trà làm đồ uống được không ạ?"
        },
        {
          "id": "fd86984d-5930-51e7-b916-4f7847b0fa4d-u04",
          "speaker_id": "b",
          "ja": "はい、このセットではできます。",
          "vi": "Được ạ, set này chọn trà được."
        }
      ],
      "admin": {
        "source_refs": [
          "cafe_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fd86984d-5930-51e7-b916-4f7847b0fa4d-u01": {
            "kind": "original_extension"
          },
