          },
          "7e5be73d-070b-54f7-b579-bb96b201c717-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "851ce580-178c-5c45-b7fd-ce7f8b57dac5",
      "event_id": "E01",
      "context_vi": "Sau khi nước táo hết ở Kumo, bạn đã chọn một trà lạnh. Nhân viên nhắc lại món và cách nhận tại quầy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "851ce580-178c-5c45-b7fd-ce7f8b57dac5-u01",
          "speaker_id": "b",
          "ja": "冷たい紅茶を一つですね。こちらの番号でお呼びします。",
          "vi": "Một trà lạnh nhé. Tôi sẽ gọi theo số này ạ."
        },
        {
          "id": "851ce580-178c-5c45-b7fd-ce7f8b57dac5-u02",
          "speaker_id": "a",
          "ja": "はい、冷たい紅茶一つです。番号を待ちます。",
          "vi": "Vâng, một trà lạnh. Tôi sẽ chờ gọi số."
        },
        {
          "id": "851ce580-178c-5c45-b7fd-ce7f8b57dac5-u03",
          "speaker_id": "b",
          "ja": "かしこまりました。",
          "vi": "Vâng ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "cafe_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "851ce580-178c-5c45-b7fd-ce7f8b57dac5-u01": {
