  "dialogues": [
    {
      "situation_uid": "c5308851-070d-5573-a1cf-d6367f0823e4",
      "event_id": "E01",
      "context_vi": "Tại quán cà phê Kumo hư cấu, bạn muốn đồ uống không có cà phê và hỏi lựa chọn hiện có.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c5308851-070d-5573-a1cf-d6367f0823e4-u01",
          "speaker_id": "a",
          "ja": "コーヒーが入っていない飲み物はありますか。",
          "vi": "Có đồ uống nào không có cà phê không ạ?"
        },
        {
          "id": "c5308851-070d-5573-a1cf-d6367f0823e4-u02",
          "speaker_id": "b",
          "ja": "紅茶とりんごジュースがあります。",
          "vi": "Có trà đen và nước táo ạ."
        },
        {
          "id": "c5308851-070d-5573-a1cf-d6367f0823e4-u03",
          "speaker_id": "a",
          "ja": "では、紅茶を見たいです。",
          "vi": "Vậy cho tôi xem loại trà đen ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "cafe_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c5308851-070d-5573-a1cf-d6367f0823e4-u01": {
            "kind": "original_extension"
          },
