    {
      "situation_uid": "e1f96a31-0b83-57ea-b5a6-8d8cd649caa1",
      "event_id": "E02",
      "context_vi": "Tại Tsuki hư cấu, khách gọi muốn gặp chị Sato nhưng chị đang họp. Bạn nói tình trạng hiện tại và hỏi khách có muốn để lại lời nhắn không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người gọi ngoài công ty",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e1f96a31-0b83-57ea-b5a6-8d8cd649caa1-u01",
          "speaker_id": "a",
          "ja": "申し訳ありません。佐藤はただ今、会議中です。ご伝言をお預かりしましょうか。",
          "vi": "Xin lỗi, chị Sato hiện đang họp. Tôi nhận lời nhắn giúp anh được không ạ?"
        },
        {
          "id": "e1f96a31-0b83-57ea-b5a6-8d8cd649caa1-u02",
          "speaker_id": "b",
          "ja": "そうですか。いつ終わるか分かりますか。",
          "vi": "Vậy à. Chị có biết khi nào họp xong không?"
        },
        {
          "id": "e1f96a31-0b83-57ea-b5a6-8d8cd649caa1-u03",
          "speaker_id": "a",
          "ja": "今は終了時刻を確認できていません。確認してからお伝えできます。",
          "vi": "Hiện tôi chưa xác nhận giờ kết thúc. Tôi có thể kiểm rồi báo lại."
        },
        {
          "id": "e1f96a31-0b83-57ea-b5a6-8d8cd649caa1-u04",
          "speaker_id": "b",
          "ja": "分かりました。少し考えます。",
          "vi": "Tôi hiểu. Để tôi nghĩ một chút."
        }
      ],
      "admin": {
        "source_refs": [
          "away"
        ],
        "specialty_item_ids": [],
