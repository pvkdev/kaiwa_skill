  "dialogues": [
    {
      "situation_uid": "079c0f95-14ae-58df-930d-76075c5d77f4",
      "event_id": "E01",
      "context_vi": "Tại công ty Tsuki hư cấu, bạn trực điện thoại. Người gọi từ Morita Shōji muốn gặp chị Tanaka ở phòng kinh doanh; tiếng tên người gọi hơi nhiễu, bạn cần nghe rõ trước khi chuyển.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người gọi ngoài công ty",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "079c0f95-14ae-58df-930d-76075c5d77f4-u01",
          "speaker_id": "a",
          "ja": "はい、月商事でございます。",
          "vi": "Vâng, công ty Tsuki xin nghe ạ."
        },
        {
          "id": "079c0f95-14ae-58df-930d-76075c5d77f4-u02",
          "speaker_id": "b",
          "ja": "森田商事の伊藤です。営業の田中さんをお願いします。",
          "vi": "Tôi là Ito của Morita Shōji. Xin cho gặp chị Tanaka phòng kinh doanh."
        },
        {
          "id": "079c0f95-14ae-58df-930d-76075c5d77f4-u03",
          "speaker_id": "a",
          "ja": "森田商事様から、営業の田中ですね。恐れ入りますが、お名前をもう一度伺えますか。",
          "vi": "Từ Morita Shōji, cần gặp chị Tanaka phòng kinh doanh nhỉ. Xin lỗi, anh nhắc lại tên giúp tôi được không ạ?"
        },
        {
          "id": "079c0f95-14ae-58df-930d-76075c5d77f4-u04",
          "speaker_id": "b",
          "ja": "伊藤です。",
          "vi": "Tôi là Ito ạ."
        }
      ],
      "admin": {
