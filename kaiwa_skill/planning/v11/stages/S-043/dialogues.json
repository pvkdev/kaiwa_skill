    {
      "situation_uid": "2951a304-aa9e-5c78-b3c6-55bae5dbc78d",
      "event_id": "E03",
      "context_vi": "Tại Tsuki hư cấu, khi bạn thử chuyển cuộc gọi của Ito từ Morita Shōji sang Tanaka, đường dây bị ngắt. Bạn có số công ty Ito đã cung cấp và gọi lại, xin lỗi, xác nhận người nghe.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người gọi ngoài công ty",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2951a304-aa9e-5c78-b3c6-55bae5dbc78d-u01",
          "speaker_id": "a",
          "ja": "森田商事の伊藤様でしょうか。月商事です。先ほど電話が切れてしまい、申し訳ありません。",
          "vi": "Anh Ito của Morita Shōji phải không ạ? Tôi gọi từ Tsuki. Xin lỗi, lúc nãy đường dây bị ngắt."
        },
        {
          "id": "2951a304-aa9e-5c78-b3c6-55bae5dbc78d-u02",
          "speaker_id": "b",
          "ja": "はい、伊藤です。田中さんと話せますか。",
          "vi": "Vâng, Ito đây. Tôi nói chuyện với chị Tanaka được không?"
        },
        {
          "id": "2951a304-aa9e-5c78-b3c6-55bae5dbc78d-u03",
          "speaker_id": "a",
          "ja": "もう一度、田中へつなぎます。先に本人の都合を確認します。",
          "vi": "Tôi sẽ chuyển lại cho chị Tanaka. Trước hết tôi kiểm xem chị ấy có nhận máy được không."
        },
        {
          "id": "2951a304-aa9e-5c78-b3c6-55bae5dbc78d-u04",
          "speaker_id": "b",
          "ja": "お願いします。",
          "vi": "Nhờ chị."
        }
