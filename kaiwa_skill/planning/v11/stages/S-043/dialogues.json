        }
      }
    },
    {
      "situation_uid": "54b92424-5828-5b86-ab37-47cb7503d6d1",
      "event_id": "E02",
      "context_vi": "Sau khi nghe Sato đang họp ở Tsuki và giờ kết thúc chưa rõ, người gọi muốn chờ trên máy ít phút. Bạn xác nhận rằng không thể hứa Sato sẽ nghe ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người gọi ngoài công ty",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "54b92424-5828-5b86-ab37-47cb7503d6d1-u01",
          "speaker_id": "b",
          "ja": "少し待ってみてもいいですか。",
          "vi": "Tôi chờ máy một chút được không?"
        },
        {
          "id": "54b92424-5828-5b86-ab37-47cb7503d6d1-u02",
          "speaker_id": "a",
          "ja": "はい。ただ、いつ会議が終わるかはまだ分かりません。",
          "vi": "Được ạ. Nhưng tôi vẫn chưa biết khi nào cuộc họp kết thúc."
        },
        {
          "id": "54b92424-5828-5b86-ab37-47cb7503d6d1-u03",
          "speaker_id": "b",
          "ja": "では、一分だけ待ちます。",
          "vi": "Vậy tôi chờ một phút thôi."
        },
        {
          "id": "54b92424-5828-5b86-ab37-47cb7503d6d1-u04",
          "speaker_id": "a",
          "ja": "承知しました。一分後、まだ会議中ならお声をかけます。",
          "vi": "Vâng. Sau một phút nếu chị ấy vẫn họp, tôi sẽ báo anh."
        }
      ],
      "admin": {
