    {
      "situation_uid": "038543c0-935e-59cf-8d86-1e1548eadd77",
      "event_id": "E01",
      "context_vi": "Ở Tsuki hư cấu, người gọi Ito của Morita Shōji muốn gặp Tanaka phòng kinh doanh. Bạn đã nghe rõ thông tin, xác nhận Tanaka có thể nhận và báo sẽ chuyển.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người gọi ngoài công ty",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "038543c0-935e-59cf-8d86-1e1548eadd77-u01",
          "speaker_id": "a",
          "ja": "森田商事の伊藤様ですね。営業の田中は今、電話に出られます。",
          "vi": "Anh Ito của Morita Shōji phải không ạ? Chị Tanaka phòng kinh doanh hiện nghe máy được."
        },
        {
          "id": "038543c0-935e-59cf-8d86-1e1548eadd77-u02",
          "speaker_id": "b",
          "ja": "はい。つないでいただけますか。",
          "vi": "Vâng. Chị chuyển máy giúp tôi được không?"
        },
        {
          "id": "038543c0-935e-59cf-8d86-1e1548eadd77-u03",
          "speaker_id": "a",
          "ja": "承知しました。田中へおつなぎしますので、少々お待ちください。",
          "vi": "Vâng. Tôi sẽ chuyển cho chị Tanaka, xin anh chờ một chút."
        },
        {
          "id": "038543c0-935e-59cf-8d86-1e1548eadd77-u04",
          "speaker_id": "b",
          "ja": "お願いします。",
          "vi": "Nhờ chị ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "transfer"
        ],
