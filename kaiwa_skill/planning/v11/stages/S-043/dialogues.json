    {
      "situation_uid": "cfe1962b-e579-508b-bf04-4c6004088170",
      "event_id": "E01",
      "context_vi": "Sau cuộc gọi từ Morita Shōji tới Tsuki, bạn chưa nghe rõ tên khách. Người gọi nhắc lại là Ito; bạn đọc lại đủ tên công ty, người gọi và người cần gặp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người gọi ngoài công ty",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "cfe1962b-e579-508b-bf04-4c6004088170-u01",
          "speaker_id": "b",
          "ja": "森田商事の伊藤です。",
          "vi": "Tôi là Ito của Morita Shōji."
        },
        {
          "id": "cfe1962b-e579-508b-bf04-4c6004088170-u02",
          "speaker_id": "a",
          "ja": "森田商事の伊藤様ですね。営業の田中へおつなぎします。",
          "vi": "Anh Ito của Morita Shōji phải không ạ? Tôi sẽ chuyển cho chị Tanaka phòng kinh doanh."
        },
        {
          "id": "cfe1962b-e579-508b-bf04-4c6004088170-u03",
          "speaker_id": "b",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ chị."
        },
        {
          "id": "cfe1962b-e579-508b-bf04-4c6004088170-u04",
          "speaker_id": "a",
          "ja": "少々お待ちください。",
          "vi": "Xin anh chờ chút ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "transfer"
        ],
