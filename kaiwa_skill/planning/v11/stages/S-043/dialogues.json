    {
      "situation_uid": "4d53acce-c7c4-5e77-a419-b23e67adc520",
      "event_id": "E02",
      "context_vi": "Tại Tsuki hư cấu, Sato không thể nghe máy và bạn chưa biết khi nào chị ấy xong việc. Người gọi muốn biết thời điểm; bạn xin xác minh, hỏi tên và số để tự gọi lại, không đoán giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người gọi ngoài công ty",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4d53acce-c7c4-5e77-a419-b23e67adc520-u01",
          "speaker_id": "b",
          "ja": "佐藤さんは何時に戻りますか。",
          "vi": "Mấy giờ chị Sato quay lại ạ?"
        },
        {
          "id": "4d53acce-c7c4-5e77-a419-b23e67adc520-u02",
          "speaker_id": "a",
          "ja": "まだ確認できていません。確認してからご連絡してもよろしいですか。",
          "vi": "Tôi chưa xác nhận được. Tôi kiểm rồi liên hệ lại anh được không ạ?"
        },
        {
          "id": "4d53acce-c7c4-5e77-a419-b23e67adc520-u03",
          "speaker_id": "b",
          "ja": "はい。会社の代表番号にお願いします。",
          "vi": "Được. Xin gọi về số tổng đài công ty tôi."
        },
        {
          "id": "4d53acce-c7c4-5e77-a419-b23e67adc520-u04",
          "speaker_id": "a",
          "ja": "承知しました。お名前と代表番号を伺ってもよろしいですか。確認してから折り返します。",
          "vi": "Vâng. Cho tôi xin tên và số tổng đài được không ạ? Tôi kiểm rồi gọi lại."
        },
        {
          "id": "4d53acce-c7c4-5e77-a419-b23e67adc520-u05",
          "speaker_id": "b",
          "ja": "山本です。番号をお伝えします。",
          "vi": "Tôi là Yamamoto. Tôi sẽ đọc số ạ."
