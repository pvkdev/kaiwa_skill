    {
      "situation_uid": "c7d6cc60-939a-523d-8793-6dfff9ed045d",
      "event_id": "E01",
      "context_vi": "Sau khi báo với Ito của Morita Shōji rằng sẽ chuyển máy, bạn gọi nội bộ cho Tanaka ở phòng kinh doanh. Bạn nhắc lại tên khách và công ty trước khi nối.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách nhận máy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c7d6cc60-939a-523d-8793-6dfff9ed045d-u01",
          "speaker_id": "a",
          "ja": "田中さん、森田商事の伊藤様からお電話です。おつなぎしてよろしいですか。",
          "vi": "Chị Tanaka, anh Ito từ Morita Shōji gọi. Tôi chuyển máy cho chị được không?"
        },
        {
          "id": "c7d6cc60-939a-523d-8793-6dfff9ed045d-u02",
          "speaker_id": "b",
          "ja": "はい、お願いします。",
          "vi": "Được, chuyển cho tôi nhé."
        },
        {
          "id": "c7d6cc60-939a-523d-8793-6dfff9ed045d-u03",
          "speaker_id": "a",
          "ja": "分かりました。今おつなぎします。",
          "vi": "Vâng, tôi chuyển ngay."
        },
        {
          "id": "c7d6cc60-939a-523d-8793-6dfff9ed045d-u04",
          "speaker_id": "b",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "transfer"
        ],
        "specialty_item_ids": [],
