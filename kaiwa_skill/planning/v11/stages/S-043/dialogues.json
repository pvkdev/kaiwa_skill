    {
      "situation_uid": "467d0852-6bfb-52ab-99fb-48b148dc55a6",
      "event_id": "E02",
      "context_vi": "Sau khi nghe Sato đang họp ở Tsuki, người gọi chọn tự gọi lại thay vì để lời nhắn. Bạn hỏi giờ họ dự tính gọi, không hứa Sato sẽ rảnh lúc đó.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người gọi ngoài công ty",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "467d0852-6bfb-52ab-99fb-48b148dc55a6-u01",
          "speaker_id": "b",
          "ja": "伝言は大丈夫です。私からかけ直します。",
          "vi": "Không cần nhắn đâu. Tôi sẽ tự gọi lại."
        },
        {
          "id": "467d0852-6bfb-52ab-99fb-48b148dc55a6-u02",
          "speaker_id": "a",
          "ja": "承知しました。何時ごろおかけ直しになりますか。",
          "vi": "Vâng. Khoảng mấy giờ anh dự định gọi lại ạ?"
        },
        {
          "id": "467d0852-6bfb-52ab-99fb-48b148dc55a6-u03",
          "speaker_id": "b",
          "ja": "三時ごろにします。",
          "vi": "Khoảng 3 giờ."
        },
        {
          "id": "467d0852-6bfb-52ab-99fb-48b148dc55a6-u04",
          "speaker_id": "a",
          "ja": "分かりました。三時ごろにお電話があると佐藤に伝えます。",
          "vi": "Tôi hiểu. Tôi sẽ nhắn chị Sato rằng khoảng 3 giờ anh sẽ gọi."
        }
      ],
      "admin": {
