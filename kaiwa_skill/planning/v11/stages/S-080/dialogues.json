      }
    },
    {
      "situation_uid": "d56f20e8-1c0b-54f4-b4d2-6a9e557d8d08",
      "event_id": "E02",
      "context_vi": "Bạn ghé siêu thị mua nguyên liệu nấu cơm tối. Bạn không thấy cà rốt ở quầy rau nên hỏi nhân viên còn hàng và nằm ở đâu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d56f20e8-1c0b-54f4-b4d2-6a9e557d8d08-u01",
          "speaker_id": "A",
          "ja": "にんじんはまだありますか。",
          "vi": "Còn cà rốt không ạ?"
        },
        {
          "id": "d56f20e8-1c0b-54f4-b4d2-6a9e557d8d08-u02",
          "speaker_id": "B",
          "ja": "はい。じゃがいもの隣にございます。",
          "vi": "Có ạ. Ở cạnh khoai tây."
        },
        {
          "id": "d56f20e8-1c0b-54f4-b4d2-6a9e557d8d08-u03",
          "speaker_id": "A",
          "ja": "一本だけでも買えますか。",
          "vi": "Tôi mua một củ được không ạ?"
        },
        {
          "id": "d56f20e8-1c0b-54f4-b4d2-6a9e557d8d08-u04",
          "speaker_id": "B",
          "ja": "はい。手前のかごが一本売りです。",
          "vi": "Được. Cà rốt bán lẻ ở rổ phía trước ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "receipt"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d56f20e8-1c0b-54f4-b4d2-6a9e557d8d08-u01": {
