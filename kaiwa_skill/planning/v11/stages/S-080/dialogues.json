          "id": "A",
          "role_vi": "Khách Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "34370ecd-96a8-5520-86ca-c09c7d82703c-u01",
          "speaker_id": "B",
          "ja": "こちらが新しいレシートです。",
          "vi": "Đây là phiếu mới của chị ạ."
        },
        {
          "id": "34370ecd-96a8-5520-86ca-c09c7d82703c-u02",
          "speaker_id": "A",
          "ja": "卵は一パックで、合計六百二十円ですね。",
          "vi": "Một hộp trứng, tổng sáu trăm hai mươi yên ạ."
        },
        {
          "id": "34370ecd-96a8-5520-86ca-c09c7d82703c-u03",
          "speaker_id": "B",
          "ja": "はい。差額の百八十円をお返しします。",
          "vi": "Vâng. Tôi gửi lại chị một trăm tám mươi yên tiền chênh."
        },
        {
          "id": "34370ecd-96a8-5520-86ca-c09c7d82703c-u04",
          "speaker_id": "A",
          "ja": "百八十円ですね。ありがとうございます。",
          "vi": "Một trăm tám mươi yên ạ. Cảm ơn anh."
