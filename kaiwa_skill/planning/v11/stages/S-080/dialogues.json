    {
      "situation_uid": "924c6949-f440-5537-8c71-ab4840c0d593",
      "event_id": "E03",
      "context_vi": "Bạn gọi tiệm tóc vì có thể đến muộn. Tiệm chỉ giữ lịch thêm mười phút, còn bạn tính mình trễ hai mươi phút nên cần quyết định.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên tiệm tóc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "924c6949-f440-5537-8c71-ab4840c0d593-u01",
          "speaker_id": "B",
          "ja": "二時十分まででしたら、お待ちできます。",
          "vi": "Chúng tôi có thể đợi chị đến hai giờ mười ạ."
        },
        {
          "id": "924c6949-f440-5537-8c71-ab4840c0d593-u02",
          "speaker_id": "A",
          "ja": "二時二十分ごろになりそうなので、間に合いません。",
          "vi": "Chắc khoảng hai giờ hai mươi tôi mới tới, vậy tôi không kịp ạ."
        },
        {
          "id": "924c6949-f440-5537-8c71-ab4840c0d593-u03",
          "speaker_id": "A",
          "ja": "別の日に変えられますか。",
          "vi": "Tôi đổi sang hôm khác được không ạ?"
        },
        {
          "id": "924c6949-f440-5537-8c71-ab4840c0d593-u04",
          "speaker_id": "B",
          "ja": "はい。次に空いている時間をお伝えしますね。",
          "vi": "Được ạ. Tôi sẽ báo giờ trống tiếp theo cho chị."
        }
      ],
