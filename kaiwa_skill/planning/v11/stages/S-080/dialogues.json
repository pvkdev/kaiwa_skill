    {
      "situation_uid": "1e81babd-7cb8-5da3-a5f3-cadc4140a3aa",
      "event_id": "E04",
      "context_vi": "Bạn về nhà muộn hơn giờ đã nói với người ở cùng. Bạn xin lỗi vì họ đã đợi và giải thích ngắn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cư dân Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người ở cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1e81babd-7cb8-5da3-a5f3-cadc4140a3aa-u01",
          "speaker_id": "A",
          "ja": "七時に帰るって言ったのに、遅くなってごめん。",
          "vi": "Tớ nói bảy giờ về mà lại về muộn. Xin lỗi cậu."
        },
        {
          "id": "1e81babd-7cb8-5da3-a5f3-cadc4140a3aa-u02",
          "speaker_id": "B",
          "ja": "連絡がなくて、ちょっと心配したよ。",
          "vi": "Không thấy cậu báo nên tớ hơi lo."
        },
        {
          "id": "1e81babd-7cb8-5da3-a5f3-cadc4140a3aa-u03",
          "speaker_id": "A",
          "ja": "ごめん。話し込んで、時間を見てなかったんだ。次は遅れそうなときにメッセージするね。",
          "vi": "Xin lỗi nhé. Tớ mải nói chuyện nên không để ý giờ. Lần sau thấy sắp trễ tớ sẽ nhắn."
        },
        {
          "id": "1e81babd-7cb8-5da3-a5f3-cadc4140a3aa-u04",
          "speaker_id": "B",
          "ja": "うん。一言知らせてもらえると安心するよ。",
          "vi": "Ừ. Cậu nhắn một câu là tớ yên tâm."
        }
      ],
      "admin": {
