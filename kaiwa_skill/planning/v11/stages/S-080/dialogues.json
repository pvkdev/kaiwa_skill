    },
    {
      "situation_uid": "6302ab7e-503e-5c6c-8ab8-a390837dd9cd",
      "event_id": "E01",
      "context_vi": "Bạn phải đi vòng qua lối Bắc chung cư và sẽ đến điểm hẹn ở ga chậm. Bạn gọi cho bạn mình để báo lý do và khoảng giờ đến.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Lan, người đến muộn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đang đợi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6302ab7e-503e-5c6c-8ab8-a390837dd9cd-u01",
          "speaker_id": "A",
          "ja": "もしもし。ごめん、駅に着くのが少し遅れる。",
          "vi": "A lô. Xin lỗi, tớ sẽ ra ga muộn một chút."
        },
        {
          "id": "6302ab7e-503e-5c6c-8ab8-a390837dd9cd-u02",
          "speaker_id": "B",
          "ja": "うん。どうした？",
          "vi": "Ừ. Có chuyện gì thế?"
        },
        {
          "id": "6302ab7e-503e-5c6c-8ab8-a390837dd9cd-u03",
          "speaker_id": "A",
          "ja": "マンションの出口が閉まってて、遠回りした。十分ぐらい遅れるよ。",
          "vi": "Cửa chung cư đóng nên tớ phải đi vòng. Chắc muộn khoảng mười phút."
        },
        {
          "id": "6302ab7e-503e-5c6c-8ab8-a390837dd9cd-u04",
          "speaker_id": "B",
          "ja": "わかった。駅の中で待ってるね。",
          "vi": "Ừ, tớ đợi trong ga nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "call"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "6302ab7e-503e-5c6c-8ab8-a390837dd9cd-u01": {
