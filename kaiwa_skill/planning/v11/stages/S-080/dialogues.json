            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d5fcd7f3-f59a-534e-82f9-e4f7557421f3",
      "event_id": "E01",
      "context_vi": "Bạn báo tới Shinjuku muộn vì phải đi vòng khỏi chung cư. Người bạn đang đợi đổi điểm gặp sang quán cạnh hiệu sách. Bạn kiểm lại chỗ mới và mốc giờ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Lan, người đến muộn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đang đợi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d5fcd7f3-f59a-534e-82f9-e4f7557421f3-u01",
          "speaker_id": "B",
          "ja": "じゃ、改札じゃなくて、カフェで会おう。",
          "vi": "Vậy mình gặp ở quán cà phê nhé, đừng gặp ở cổng soát vé nữa."
        },
        {
          "id": "d5fcd7f3-f59a-534e-82f9-e4f7557421f3-u02",
          "speaker_id": "A",
          "ja": "駅の本屋の隣のカフェ？",
          "vi": "Quán ngay cạnh hiệu sách ở ga à?"
        },
        {
          "id": "d5fcd7f3-f59a-534e-82f9-e4f7557421f3-u03",
          "speaker_id": "B",
          "ja": "うん。十時十五分でいい？",
          "vi": "Ừ. Mười giờ mười lăm được không?"
        },
        {
          "id": "d5fcd7f3-f59a-534e-82f9-e4f7557421f3-u04",
          "speaker_id": "A",
          "ja": "いいよ。十時十五分、本屋の隣のカフェね。",
          "vi": "Được. Mười giờ mười lăm, quán cạnh hiệu sách nhé."
        },
        {
          "id": "d5fcd7f3-f59a-534e-82f9-e4f7557421f3-u05",
          "speaker_id": "B",
          "ja": "うん。中で待ってるね。",
          "vi": "Ừ. Tớ đợi ở trong."
        }
      ],
      "admin": {
        "source_refs": [
          "call",
          "rail"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d5fcd7f3-f59a-534e-82f9-e4f7557421f3-u01": {
