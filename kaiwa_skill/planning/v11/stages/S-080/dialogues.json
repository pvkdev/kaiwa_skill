    {
      "situation_uid": "eb0e823a-6038-5ce2-ad2d-c17e9c52d1ba",
      "event_id": "E04",
      "context_vi": "Cuối ngày, bạn kể với người ở cùng rằng lịch cắt tóc thay đổi bất ngờ và bạn đã dùng khoảng trống để gặp bạn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cư dân Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người ở cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "eb0e823a-6038-5ce2-ad2d-c17e9c52d1ba-u01",
          "speaker_id": "A",
          "ja": "電車が遅れて、今日の美容院に間に合わなかったよ。",
          "vi": "Tàu chậm nên hôm nay tớ lỡ hẹn cắt tóc."
        },
        {
          "id": "eb0e823a-6038-5ce2-ad2d-c17e9c52d1ba-u02",
          "speaker_id": "B",
          "ja": "それで、どうしたの？",
          "vi": "Rồi cậu làm sao?"
        },
        {
          "id": "eb0e823a-6038-5ce2-ad2d-c17e9c52d1ba-u03",
          "speaker_id": "A",
          "ja": "明日の十一時に変えてもらったよ。午後は友達に会った。",
          "vi": "Tớ nhờ đổi sang mười một giờ sáng mai. Buổi chiều tớ gặp bạn."
        },
        {
          "id": "eb0e823a-6038-5ce2-ad2d-c17e9c52d1ba-u04",
          "speaker_id": "B",
          "ja": "そうなんだ。午後は会えてよかったね。",
          "vi": "Ra vậy. May chiều cậu vẫn gặp được bạn nhỉ."
        }
      ],
      "admin": {
