    {
      "situation_uid": "bd5f92ea-2b4b-5ee4-a344-284a7b17127f",
      "event_id": "E04",
      "context_vi": "Cuối ngày, bạn nghĩ cuối tuần muốn thử đi một chợ bán bánh mì gần nhà. Bạn nói lý do và hỏi người ở cùng có hứng thú đi không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cư dân Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người ở cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bd5f92ea-2b4b-5ee4-a344-284a7b17127f-u01",
          "speaker_id": "A",
          "ja": "今度の週末はパンの市に行ってみたいな。",
          "vi": "Cuối tuần này tớ muốn thử đi chợ bánh mì."
        },
        {
          "id": "bd5f92ea-2b4b-5ee4-a344-284a7b17127f-u02",
          "speaker_id": "B",
          "ja": "どんな市なの？",
          "vi": "Chợ đó có gì vậy?"
        },
        {
          "id": "bd5f92ea-2b4b-5ee4-a344-284a7b17127f-u03",
          "speaker_id": "A",
          "ja": "近くのパン屋が集まるんだって。日曜の朝はどう？",
          "vi": "Nghe nói các tiệm bánh gần đây họp lại bán. Sáng Chủ nhật thì sao?"
        },
        {
          "id": "bd5f92ea-2b4b-5ee4-a344-284a7b17127f-u04",
          "speaker_id": "B",
          "ja": "いいね。朝ご飯を買いに行こう。",
          "vi": "Hay đấy. Mình ra đó mua đồ ăn sáng nhé."
        }
      ],
