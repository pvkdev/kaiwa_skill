    {
      "situation_uid": "027b7db7-9dda-5bb9-a505-042161200fca",
      "event_id": "E03",
      "context_vi": "Tiệm tóc báo không thể giữ cuộc hẹn lúc hai giờ hôm nay vì sau đó có khách. Bạn hỏi có thể đổi sang sáng mai và chốt ngay nếu còn chỗ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên tiệm tóc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "027b7db7-9dda-5bb9-a505-042161200fca-u01",
          "speaker_id": "B",
          "ja": "申し訳ありません。次のご予約があるので、本日はお待ちできません。",
          "vi": "Xin lỗi chị. Hôm nay có khách hẹn sau nên chúng tôi không đợi chị được ạ."
        },
        {
          "id": "027b7db7-9dda-5bb9-a505-042161200fca-u02",
          "speaker_id": "A",
          "ja": "わかりました。明日の午前に空きはありますか。",
          "vi": "Tôi hiểu rồi. Sáng mai còn chỗ không ạ?"
        },
        {
          "id": "027b7db7-9dda-5bb9-a505-042161200fca-u03",
          "speaker_id": "B",
          "ja": "午前十一時でしたら空いています。",
          "vi": "Mười một giờ sáng thì còn chỗ ạ."
        },
        {
          "id": "027b7db7-9dda-5bb9-a505-042161200fca-u04",
          "speaker_id": "A",
          "ja": "では、明日の十一時にお願いします。",
          "vi": "Vậy cho tôi mười một giờ sáng mai nhé."
        },
        {
          "id": "027b7db7-9dda-5bb9-a505-042161200fca-u05",
          "speaker_id": "B",
          "ja": "はい、明日の十一時に変更しました。",
          "vi": "Vâng, tôi đã đổi sang mười một giờ sáng mai ạ."
        }
      ],
      "admin": {
