    {
      "situation_uid": "2350fcfd-df74-50b9-864a-1975b89af8ea",
      "event_id": "E03",
      "context_vi": "Bạn có hẹn cắt tóc lúc hai giờ chiều. Tàu chậm nên bạn gọi tiệm, nói tên, giờ đặt và thời gian sẽ tới.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên tiệm tóc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2350fcfd-df74-50b9-864a-1975b89af8ea-u01",
          "speaker_id": "A",
          "ja": "二時に予約したグエンです。少し遅れそうです。",
          "vi": "Tôi là Nguyễn, có hẹn lúc hai giờ. Chắc tôi tới hơi muộn ạ."
        },
        {
          "id": "2350fcfd-df74-50b9-864a-1975b89af8ea-u02",
          "speaker_id": "B",
          "ja": "何分ぐらい遅れそうですか。",
          "vi": "Chị dự kiến muộn khoảng mấy phút ạ?"
        },
        {
          "id": "2350fcfd-df74-50b9-864a-1975b89af8ea-u03",
          "speaker_id": "A",
          "ja": "電車が遅れて、五分ぐらいです。",
          "vi": "Tàu đang chậm. Chắc muộn khoảng năm phút ạ."
        },
        {
          "id": "2350fcfd-df74-50b9-864a-1975b89af8ea-u04",
          "speaker_id": "B",
          "ja": "二時五分でしたら大丈夫です。",
          "vi": "Hai giờ năm thì chúng tôi vẫn đón được ạ."
        },
        {
          "id": "2350fcfd-df74-50b9-864a-1975b89af8ea-u05",
          "speaker_id": "A",
          "ja": "ありがとうございます。着いたら受付に行きます。",
          "vi": "Cảm ơn anh. Tới nơi tôi sẽ ra quầy."
        }
      ],
