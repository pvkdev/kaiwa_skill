    {
      "situation_uid": "4937ee0f-47d2-56d7-89c7-f91790e6c3de",
      "event_id": "E03",
      "context_vi": "Bạn vừa đổi hẹn cắt tóc sang mười một giờ sáng mai, nên chiều nay rảnh hơn dự tính. Bạn gọi báo cho bạn mình và hỏi có thể gặp lúc ba giờ không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Lan, người gọi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe máy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4937ee0f-47d2-56d7-89c7-f91790e6c3de-u01",
          "speaker_id": "A",
          "ja": "もしもし。美容院、明日の午前十一時になったよ。",
          "vi": "A lô. Lịch cắt tóc của tớ đổi sang mười một giờ sáng mai rồi."
        },
        {
          "id": "4937ee0f-47d2-56d7-89c7-f91790e6c3de-u02",
          "speaker_id": "B",
          "ja": "じゃ、今日の午後は空いたの？",
          "vi": "Vậy chiều nay cậu rảnh rồi à?"
        },
        {
          "id": "4937ee0f-47d2-56d7-89c7-f91790e6c3de-u03",
          "speaker_id": "A",
          "ja": "うん。三時から会える？",
          "vi": "Ừ. Từ ba giờ cậu gặp được không?"
        },
        {
          "id": "4937ee0f-47d2-56d7-89c7-f91790e6c3de-u04",
          "speaker_id": "B",
          "ja": "会えるよ。何をするか決めようか。",
          "vi": "Được. Mình bàn xem làm gì nhé?"
        }
      ],
      "admin": {
        "source_refs": [
