      ],
      "turns": [
        {
          "id": "584b9005-13d8-5052-9cea-a2e8280d05b5-u01",
          "speaker_id": "B",
          "ja": "すみません。豆腐は売り切れです。",
          "vi": "Tiếc quá, đậu phụ hết hàng rồi ạ."
        },
        {
          "id": "584b9005-13d8-5052-9cea-a2e8280d05b5-u02",
          "speaker_id": "A",
          "ja": "なるほど。卵はまだありますか。",
          "vi": "Ra vậy. Trứng còn không ạ?"
        },
        {
          "id": "584b9005-13d8-5052-9cea-a2e8280d05b5-u03",
          "speaker_id": "B",
          "ja": "はい。あちらの棚にあります。",
          "vi": "Còn ạ. Trứng ở kệ đằng kia."
        },
        {
          "id": "584b9005-13d8-5052-9cea-a2e8280d05b5-u04",
          "speaker_id": "A",
          "ja": "じゃ、卵を買って、スープにします。",
          "vi": "Vậy tôi mua trứng về nấu canh."
        }
