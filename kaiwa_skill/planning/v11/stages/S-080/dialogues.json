          }
        }
      }
    },
    {
      "situation_uid": "98739be3-2e42-5ce0-86ce-cbbf44ff8934",
      "event_id": "E01",
      "context_vi": "Lối Nam của chung cư đóng nên bạn phải ra cửa Bắc. Bạn nghe nhầm rẽ phải sau cầu thang và hỏi lại hàng xóm để chắc điểm rẽ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cư dân Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "98739be3-2e42-5ce0-86ce-cbbf44ff8934-u01",
          "speaker_id": "A",
          "ja": "階段を下りたら、右ですか。",
          "vi": "Xuống cầu thang rồi rẽ phải ạ?"
        },
        {
          "id": "98739be3-2e42-5ce0-86ce-cbbf44ff8934-u02",
          "speaker_id": "B",
          "ja": "そこは左です。右は駐車場です。",
          "vi": "Rẽ trái chị ạ. Bên phải là bãi xe."
        },
        {
          "id": "98739be3-2e42-5ce0-86ce-cbbf44ff8934-u03",
          "speaker_id": "A",
          "ja": "左ですね。出口はすぐ見えますか。",
          "vi": "Bên trái ạ. Có nhìn thấy lối ra ngay không?"
        },
        {
          "id": "98739be3-2e42-5ce0-86ce-cbbf44ff8934-u04",
          "speaker_id": "B",
          "ja": "はい。左のガラスのドアが出口です。",
          "vi": "Có. Cửa kính bên trái là lối ra."
        }
      ],
      "admin": {
        "source_refs": [
          "rail"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "98739be3-2e42-5ce0-86ce-cbbf44ff8934-u01": {
