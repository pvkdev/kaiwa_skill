    {
      "situation_uid": "c80a709d-fc1e-5d52-8466-fa03fe5d02d8",
      "event_id": "E04",
      "context_vi": "Bạn đã biết người cho mượn ô ra khỏi nhà lúc tám giờ mười lăm sáng mai. Bạn chốt giờ trả sớm hơn và cảm ơn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người mượn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người cho mượn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c80a709d-fc1e-5d52-8466-fa03fe5d02d8-u01",
          "speaker_id": "A",
          "ja": "じゃ、明日の朝八時に玄関で返すね。",
          "vi": "Vậy tám giờ sáng mai tớ trả ô ở cửa nhé."
        },
        {
          "id": "c80a709d-fc1e-5d52-8466-fa03fe5d02d8-u02",
          "speaker_id": "B",
          "ja": "うん。八時ならまだ家にいるよ。",
          "vi": "Ừ. Tám giờ tớ vẫn ở nhà."
        },
        {
          "id": "c80a709d-fc1e-5d52-8466-fa03fe5d02d8-u03",
          "speaker_id": "A",
          "ja": "貸してくれてありがとう。ぬれずに帰れたよ。",
          "vi": "Cảm ơn cậu đã cho mượn. Nhờ vậy tớ về mà không bị ướt."
        },
        {
          "id": "c80a709d-fc1e-5d52-8466-fa03fe5d02d8-u04",
          "speaker_id": "B",
          "ja": "どういたしまして。じゃ、朝八時にね。",
          "vi": "Không có gì. Vậy tám giờ sáng nhé."
        }
      ],
