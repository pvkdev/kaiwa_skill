    {
      "situation_uid": "584b9005-13d8-5052-9cea-a2e8280d05b5",
      "event_id": "E02",
      "context_vi": "Bạn định mua đậu phụ làm canh, nhưng tại siêu thị hôm nay đã hết. Bạn hỏi còn trứng để đổi sang nấu canh trứng không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên cửa hàng",
          "gender": "male"
