    {
      "situation_uid": "d65f4f9a-5fcc-5c8a-b201-06318b9c01aa",
      "event_id": "E02",
      "context_vi": "Bạn đã trả tiền mặt ở siêu thị. Kiểm phiếu thấy một hộp trứng bị tính hai lần nên bạn mang phiếu và hàng tới quầy.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên cửa hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d65f4f9a-5fcc-5c8a-b201-06318b9c01aa-u01",
          "speaker_id": "A",
          "ja": "すみません。レシートでは卵が二パックになっています。",
          "vi": "Cho tôi hỏi. Trên phiếu ghi hai hộp trứng ạ."
        },
        {
          "id": "d65f4f9a-5fcc-5c8a-b201-06318b9c01aa-u02",
          "speaker_id": "A",
          "ja": "買ったのは一パックです。",
          "vi": "Tôi chỉ mua một hộp thôi."
        },
        {
          "id": "d65f4f9a-5fcc-5c8a-b201-06318b9c01aa-u03",
          "speaker_id": "B",
          "ja": "確認しますね。あ、卵が一パック多く入力されていますね。",
          "vi": "Để tôi kiểm. À, phiếu đã tính thừa một hộp trứng ạ."
        },
        {
          "id": "d65f4f9a-5fcc-5c8a-b201-06318b9c01aa-u04",
          "speaker_id": "B",
          "ja": "申し訳ございません。一パック分をお返しします。",
          "vi": "Rất tiếc ạ. Tôi sẽ hoàn lại tiền một hộp."
        }
