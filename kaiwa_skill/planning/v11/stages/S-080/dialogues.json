    {
      "situation_uid": "3bc928ff-462f-5f3c-8db3-ce7c20f67a5a",
      "event_id": "E01",
      "context_vi": "Bạn đã đến quán cạnh hiệu sách gần ga Shinjuku và gặp bạn mình đúng điểm mới. Bạn kể ngắn vì sao tới trễ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Lan, người đến muộn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn ở quán",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3bc928ff-462f-5f3c-8db3-ce7c20f67a5a-u01",
          "speaker_id": "A",
          "ja": "待たせてごめん。ここ、すぐ見つかったよ。",
          "vi": "Xin lỗi để cậu đợi. Tớ tìm được quán ngay."
        },
        {
          "id": "3bc928ff-462f-5f3c-8db3-ce7c20f67a5a-u02",
          "speaker_id": "B",
          "ja": "よかった。家の出口、どうしたの？",
          "vi": "May quá. Lối ra nhà cậu bị sao vậy?"
        },
        {
          "id": "3bc928ff-462f-5f3c-8db3-ce7c20f67a5a-u03",
          "speaker_id": "A",
          "ja": "南の出口が閉まってたから、北から出て遠回りしたんだ。",
          "vi": "Cửa Nam đóng nên tớ ra cửa Bắc rồi đi vòng."
        },
        {
          "id": "3bc928ff-462f-5f3c-8db3-ce7c20f67a5a-u04",
          "speaker_id": "B",
          "ja": "そうだったんだ。じゃ、少し休んでから行こう。",
          "vi": "Ra vậy. Mình nghỉ chút rồi đi tiếp nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "call"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3bc928ff-462f-5f3c-8db3-ce7c20f67a5a-u01": {
