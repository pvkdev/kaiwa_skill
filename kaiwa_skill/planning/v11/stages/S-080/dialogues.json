    {
      "situation_uid": "1ebc2b26-3b89-5450-a805-f803d837f156",
      "event_id": "E03",
      "context_vi": "Lịch cắt tóc đã dời sang ngày mai và hai bạn rảnh từ ba giờ chiều nay. Bây giờ bạn chọn một việc còn có thể làm cùng nhau.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Lan, người hẹn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1ebc2b26-3b89-5450-a805-f803d837f156-u01",
          "speaker_id": "A",
          "ja": "今日の午後は、お茶と映画、どっちがいい？",
          "vi": "Chiều nay cậu thích đi uống cà phê hay xem phim?"
        },
        {
          "id": "1ebc2b26-3b89-5450-a805-f803d837f156-u02",
          "speaker_id": "B",
          "ja": "一時間しかいられないから、お茶がいいな。",
          "vi": "Tớ chỉ ở được một tiếng nên đi uống cà phê nhé."
        },
        {
          "id": "1ebc2b26-3b89-5450-a805-f803d837f156-u03",
          "speaker_id": "A",
          "ja": "じゃ、三時に本屋の向かいのカフェで会おう。",
          "vi": "Vậy ba giờ mình gặp ở quán đối diện hiệu sách nhé."
        },
        {
          "id": "1ebc2b26-3b89-5450-a805-f803d837f156-u04",
          "speaker_id": "B",
          "ja": "うん。カフェで待ってるね。",
          "vi": "Ừ. Tớ đợi ở quán nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "call"
        ],
        "specialty_item_ids": [
          "sj-so-18-b11-67"
