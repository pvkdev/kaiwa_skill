    {
      "situation_uid": "60e6d590-becf-5c80-93d7-65a128db89ec",
      "event_id": "E04",
      "context_vi": "Sáng nay bạn mượn ô của người ở cùng. Bạn hỏi mai họ có cần lấy lại không và lắng nghe giờ phải dùng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người mượn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người cho mượn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "60e6d590-becf-5c80-93d7-65a128db89ec-u01",
          "speaker_id": "A",
          "ja": "今朝借りた傘、明日返したほうがいい？",
          "vi": "Cái ô tớ mượn sáng nay, mai cậu cần tớ trả lại không?"
        },
        {
          "id": "60e6d590-becf-5c80-93d7-65a128db89ec-u02",
          "speaker_id": "B",
          "ja": "うん、明日は仕事に持っていきたい。",
          "vi": "Ừ. Mai tớ muốn mang ô đi làm."
        },
        {
          "id": "60e6d590-becf-5c80-93d7-65a128db89ec-u03",
          "speaker_id": "A",
          "ja": "何時に家を出るの？",
          "vi": "Cậu ra khỏi nhà lúc mấy giờ?"
        },
        {
          "id": "60e6d590-becf-5c80-93d7-65a128db89ec-u04",
          "speaker_id": "B",
          "ja": "朝八時十五分に出るよ。",
          "vi": "Tớ ra lúc tám giờ mười lăm sáng."
        }
      ],
      "admin": {
        "source_refs": [
          "reschedule"
        ],
        "specialty_item_ids": [],
