  "dialogues": [
    {
      "situation_uid": "06179860-1751-5b44-8eb0-dd66e71be539",
      "event_id": "E01",
      "context_vi": "Sáng nay, cửa Nam chung cư đang đóng. Bạn gặp hàng xóm ở hành lang, chào và hỏi còn lối nào ra ngoài.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cư dân Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "06179860-1751-5b44-8eb0-dd66e71be539-u01",
          "speaker_id": "A",
          "ja": "おはようございます。南の出口は閉まっていますか。",
          "vi": "Chào anh. Lối ra phía Nam đang đóng ạ?"
        },
        {
          "id": "06179860-1751-5b44-8eb0-dd66e71be539-u02",
          "speaker_id": "B",
          "ja": "ええ。今日は北の出口を使ってください。",
          "vi": "Vâng. Hôm nay chị dùng lối phía Bắc nhé."
        },
        {
          "id": "06179860-1751-5b44-8eb0-dd66e71be539-u03",
          "speaker_id": "A",
          "ja": "北の出口はどう行きますか。",
          "vi": "Tôi đi tới lối Bắc thế nào ạ?"
        },
        {
          "id": "06179860-1751-5b44-8eb0-dd66e71be539-u04",
          "speaker_id": "B",
          "ja": "階段を下りて、左です。",
          "vi": "Xuống cầu thang rồi rẽ trái."
        }
      ],
      "admin": {
        "source_refs": [
          "rail"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "06179860-1751-5b44-8eb0-dd66e71be539-u01": {
            "kind": "original_extension"
