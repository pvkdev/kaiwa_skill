        }
      }
    },
    {
      "situation_uid": "69463d65-30ba-5ce2-ad85-03f61f573d85",
      "event_id": "E02",
      "context_vi": "Bạn ở ga JR Shinjuku, vừa lỡ chuyến định đi Nakano. Bạn hỏi nhân viên đi chuyến nào tiếp và có phải chuyển tàu không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Hành khách Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "69463d65-30ba-5ce2-ad85-03f61f573d85-u01",
          "speaker_id": "A",
          "ja": "中野に行きたいですが、今の電車に乗り遅れました。次はどれに乗ればいいですか。",
          "vi": "Tôi muốn tới Nakano nhưng vừa lỡ chuyến. Tôi đón chuyến nào tiếp ạ?"
        },
        {
          "id": "69463d65-30ba-5ce2-ad85-03f61f573d85-u02",
          "speaker_id": "B",
          "ja": "十六番線の中央・総武線、各駅停車に乗ってください。三鷹方面です。",
          "vi": "Chị ra sân số 16, đi tàu tuyến Chuo–Sobu dừng mọi ga theo hướng Mitaka nhé."
        },
        {
          "id": "69463d65-30ba-5ce2-ad85-03f61f573d85-u03",
          "speaker_id": "A",
          "ja": "中野まで乗り換えなしですか。",
          "vi": "Tới Nakano không phải đổi tàu ạ?"
        },
        {
          "id": "69463d65-30ba-5ce2-ad85-03f61f573d85-u04",
          "speaker_id": "B",
          "ja": "はい。三鷹行きも中野行きも中野に止まります。次はホームの表示をご覧ください。",
          "vi": "Vâng. Tàu đi Mitaka và tàu đi Nakano đều dừng ở Nakano. Chị xem bảng ở sân ga để biết chuyến tiếp nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "rail",
          "shinjuku",
          "nakano"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "69463d65-30ba-5ce2-ad85-03f61f573d85-u01": {
