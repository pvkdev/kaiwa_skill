    {
      "situation_uid": "92f008bb-5e88-54bd-bc6c-853d782c5a73",
      "event_id": "E03",
      "context_vi": "Tại Momo hư cấu, nhân viên định giá chiếc loa cũ 500 yên. Bạn thấy thấp và quyết định mang về; giá chỉ là ví dụ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thu mua",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "92f008bb-5e88-54bd-bc6c-853d782c5a73-u01",
          "speaker_id": "b",
          "ja": "このスピーカーは五百円になります。",
          "vi": "Chiếc loa này được định giá 500 yên ạ."
        },
        {
          "id": "92f008bb-5e88-54bd-bc6c-853d782c5a73-u02",
          "speaker_id": "a",
          "ja": "思ったより安いので、今日は持って帰ります。",
          "vi": "Thấp hơn tôi nghĩ, nên hôm nay tôi mang về ạ."
        },
        {
          "id": "92f008bb-5e88-54bd-bc6c-853d782c5a73-u03",
          "speaker_id": "b",
          "ja": "承知しました。お品物をお返しします。",
          "vi": "Vâng. Tôi trả lại món cho anh."
        },
        {
          "id": "92f008bb-5e88-54bd-bc6c-853d782c5a73-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。少し考えます。",
          "vi": "Cảm ơn chị. Tôi sẽ suy nghĩ thêm."
        }
      ],
