    {
      "situation_uid": "21ef6cb1-bba4-5e2e-b277-da1c98a8fa80",
      "event_id": "E02",
      "context_vi": "Tại Momo hư cấu, bạn mua một chiếc ghế cũ giá 2.000 yên và hỏi tổng nếu nhờ giao về nhà. Giá chỉ là ví dụ, chưa đặt giao.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "21ef6cb1-bba4-5e2e-b277-da1c98a8fa80-u01",
          "speaker_id": "a",
          "ja": "椅子は二千円ですね。家まで運ぶと、合計はいくらですか。",
          "vi": "Ghế là 2.000 yên nhỉ. Nếu giao về nhà thì tổng bao nhiêu ạ?"
        },
        {
          "id": "21ef6cb1-bba4-5e2e-b277-da1c98a8fa80-u02",
          "speaker_id": "b",
          "ja": "住所を聞いてから、配送料を確認します。",
          "vi": "Tôi cần địa chỉ rồi mới kiểm được phí giao ạ."
        },
        {
          "id": "21ef6cb1-bba4-5e2e-b277-da1c98a8fa80-u03",
          "speaker_id": "a",
          "ja": "分かりました。先に合計を聞いてから決めます。",
          "vi": "Tôi hiểu. Tôi sẽ nghe tổng tiền rồi mới quyết định."
        }
      ],
      "admin": {
