        }
      }
    },
    {
      "situation_uid": "2ecc70ca-b624-5576-9285-749a8ac27d0f",
      "event_id": "E01",
      "context_vi": "Ở Momo hư cấu, quầy không có chỗ cấp điện để thử chiếc quạt cũ. Bạn hỏi cách kiểm khác trước khi quyết định.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên recycle shop",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2ecc70ca-b624-5576-9285-749a8ac27d0f-u01",
          "speaker_id": "a",
          "ja": "ここでこの扇風機を動かしてみてもいいですか。",
          "vi": "Tôi thử chạy chiếc quạt này ở đây được không ạ?"
        },
        {
          "id": "2ecc70ca-b624-5576-9285-749a8ac27d0f-u02",
          "speaker_id": "b",
          "ja": "すみません。この場所では電源が使えません。",
          "vi": "Xin lỗi, chỗ này không dùng được ổ điện ạ."
        },
        {
          "id": "2ecc70ca-b624-5576-9285-749a8ac27d0f-u03",
          "speaker_id": "a",
          "ja": "ほかに動きを確認する方法はありますか。",
          "vi": "Có cách nào khác kiểm tra quạt chạy không ạ?"
        },
        {
          "id": "2ecc70ca-b624-5576-9285-749a8ac27d0f-u04",
          "speaker_id": "b",
          "ja": "担当者に聞きます。少々お待ちください。",
          "vi": "Tôi sẽ hỏi người phụ trách. Anh đợi chút nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "used_book"
        ],
