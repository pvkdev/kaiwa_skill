    {
      "situation_uid": "5c9e7d1d-6bef-5f6d-8aca-166364dddf37",
      "event_id": "E02",
      "context_vi": "Tại quầy Momo, bạn sắp nhận chiếc máy ảnh cũ đã chọn. Bạn muốn kiểm lại máy, sạc và dây đeo trước khi trả tiền.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
