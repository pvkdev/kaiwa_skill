    {
      "situation_uid": "9f7eb09e-9127-5ce8-8ce9-b6be290d28a0",
      "event_id": "E03",
      "context_vi": "Tại Momo, người phụ trách cần khoảng 20 phút để định giá chiếc loa cũ. Bạn hỏi có cần đứng chờ tại quầy không; đây là hẹn riêng của cửa hàng hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thu mua",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9f7eb09e-9127-5ce8-8ce9-b6be290d28a0-u01",
          "speaker_id": "b",
          "ja": "査定に二十分ほどかかります。",
          "vi": "Việc định giá mất khoảng 20 phút ạ."
        },
        {
          "id": "9f7eb09e-9127-5ce8-8ce9-b6be290d28a0-u02",
          "speaker_id": "a",
          "ja": "ここで待つ必要がありますか。",
          "vi": "Tôi có cần đợi ngay ở đây không ạ?"
        },
        {
          "id": "9f7eb09e-9127-5ce8-8ce9-b6be290d28a0-u03",
          "speaker_id": "b",
          "ja": "店内をご覧になっても大丈夫です。二十分後にこのカウンターへお戻りください。",
          "vi": "Anh có thể xem quanh cửa hàng. 20 phút nữa quay lại quầy này nhé."
        },
        {
          "id": "9f7eb09e-9127-5ce8-8ce9-b6be290d28a0-u04",
          "speaker_id": "a",
          "ja": "分かりました。二十分後に戻ります。",
          "vi": "Tôi hiểu rồi. 20 phút nữa tôi quay lại."
        }
      ],
