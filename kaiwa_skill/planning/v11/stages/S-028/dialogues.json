        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thu mua",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b822b7f4-aa62-50c3-a42e-97ef697f5b14-u01",
          "speaker_id": "a",
          "ja": "昨日のスピーカーです。考えて、売ることにしました。",
          "vi": "Chiếc loa hôm qua đây ạ. Tôi đã nghĩ lại và muốn bán."
        },
        {
          "id": "b822b7f4-aa62-50c3-a42e-97ef697f5b14-u02",
          "speaker_id": "b",
          "ja": "ありがとうございます。もう一度状態と金額を確認します。",
          "vi": "Cảm ơn anh. Tôi kiểm lại tình trạng và giá nhé."
        },
        {
          "id": "b822b7f4-aa62-50c3-a42e-97ef697f5b14-u03",
          "speaker_id": "a",
          "ja": "はい。付属のコードも一緒です。",
          "vi": "Vâng. Có cả dây đi kèm."
