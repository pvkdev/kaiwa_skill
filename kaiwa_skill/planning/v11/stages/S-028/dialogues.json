    {
      "situation_uid": "4d7ffdbf-0b09-519f-b680-a0189f362340",
      "event_id": "E04",
      "context_vi": "Bạn đã bán một chiếc máy cũ cho Momo, sau đó phát hiện bộ sạc vẫn ở nhà. Bạn gọi hỏi cửa hàng còn nhận phụ kiện bổ sung không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4d7ffdbf-0b09-519f-b680-a0189f362340-u01",
          "speaker_id": "a",
          "ja": "先ほど売った機械の充電器が家にありました。まだ持って行けますか。",
          "vi": "Tôi thấy bộ sạc của chiếc máy vừa bán vẫn ở nhà. Tôi mang bổ sung được không ạ?"
        },
        {
          "id": "4d7ffdbf-0b09-519f-b680-a0189f362340-u02",
          "speaker_id": "b",
          "ja": "取引を確認します。控えの番号は分かりますか。",
          "vi": "Tôi sẽ kiểm giao dịch. Anh có số trên phiếu không ạ?"
        },
        {
          "id": "4d7ffdbf-0b09-519f-b680-a0189f362340-u03",
          "speaker_id": "a",
          "ja": "はい、手元にあります。番号を言います。",
          "vi": "Có ạ, tôi đang cầm phiếu. Tôi đọc số nhé."
        }
      ],
