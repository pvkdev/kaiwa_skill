  "dialogues": [
    {
      "situation_uid": "64298c4e-02b5-5eea-8921-5c92cf772c32",
      "event_id": "E01",
      "context_vi": "Tại recycle shop Momo hư cấu, bạn thấy chiếc đèn bàn cũ và muốn biết tình trạng bật sáng đã được kiểm ở đây chưa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên recycle shop",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "64298c4e-02b5-5eea-8921-5c92cf772c32-u01",
          "speaker_id": "a",
          "ja": "この中古のランプは、今も点きますか。",
          "vi": "Chiếc đèn bàn cũ này vẫn sáng chứ ạ?"
        },
        {
          "id": "64298c4e-02b5-5eea-8921-5c92cf772c32-u02",
          "speaker_id": "b",
          "ja": "店では点くことを確認しました。ここでも見ますか。",
          "vi": "Cửa hàng đã kiểm tra là đèn sáng. Anh muốn xem lại tại đây không?"
        },
        {
          "id": "64298c4e-02b5-5eea-8921-5c92cf772c32-u03",
          "speaker_id": "a",
          "ja": "はい、見せてください。",
          "vi": "Có ạ, cho tôi xem."
        }
      ],
      "admin": {
        "source_refs": [
          "used_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "64298c4e-02b5-5eea-8921-5c92cf772c32-u01": {
