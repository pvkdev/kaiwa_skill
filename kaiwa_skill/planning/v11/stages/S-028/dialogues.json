          }
        }
      }
    },
    {
      "situation_uid": "7eb7530f-749a-5e86-8ab5-1ee43e913287",
      "event_id": "E01",
      "context_vi": "Ở Momo, nhân viên cho thấy chiếc vali cũ có bánh xe bị kẹt; bạn cần vali kéo đi xa nên quyết định không mua.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên recycle shop",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "7eb7530f-749a-5e86-8ab5-1ee43e913287-u01",
          "speaker_id": "b",
          "ja": "この車輪は少し動きにくいです。",
          "vi": "Bánh xe này hơi khó lăn ạ."
        },
        {
          "id": "7eb7530f-749a-5e86-8ab5-1ee43e913287-u02",
          "speaker_id": "a",
          "ja": "旅行で長く歩きます。これはやめておきます。",
          "vi": "Tôi cần kéo đi bộ nhiều khi du lịch, nên tôi không lấy chiếc này."
        },
        {
          "id": "7eb7530f-749a-5e86-8ab5-1ee43e913287-u03",
          "speaker_id": "b",
          "ja": "分かりました。ほかのスーツケースもご覧になりますか。",
          "vi": "Tôi hiểu rồi. Anh muốn xem vali khác không?"
        },
        {
          "id": "7eb7530f-749a-5e86-8ab5-1ee43e913287-u04",
          "speaker_id": "a",
          "ja": "はい、車輪がよく動くスーツケースを見たいです。",
          "vi": "Có ạ, tôi muốn xem loại bánh lăn tốt."
        }
      ],
      "admin": {
        "source_refs": [
          "used_book"
        ],
