    {
      "situation_uid": "67681167-2de2-5bbc-82d4-5129ec888ffc",
      "event_id": "E02",
      "context_vi": "Sau khi nghe giải thích nhãn 'hiện trạng' ở Momo, bạn hỏi rõ hỗ trợ sau mua của riêng chiếc đèn này. Chưa trả tiền.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "67681167-2de2-5bbc-82d4-5129ec888ffc-u01",
          "speaker_id": "a",
          "ja": "このランプには、店の追加保証はありますか。",
          "vi": "Chiếc đèn này có bảo đảm thêm của cửa hàng không ạ?"
        },
        {
          "id": "67681167-2de2-5bbc-82d4-5129ec888ffc-u02",
          "speaker_id": "b",
          "ja": "この品には追加保証はありません。問題があれば、レシートを持って店にご相談ください。",
          "vi": "Món này không có bảo đảm thêm của cửa hàng. Nếu có vấn đề, anh mang hóa đơn tới hỏi quầy nhé."
        },
        {
          "id": "67681167-2de2-5bbc-82d4-5129ec888ffc-u03",
          "speaker_id": "a",
          "ja": "分かりました。状態をもう一度見て決めます。",
          "vi": "Tôi hiểu. Tôi sẽ xem lại tình trạng rồi mới quyết định."
        }
      ],
