    {
      "situation_uid": "339080f9-ff43-58f0-a0ad-71601a157c52",
      "event_id": "E02",
      "context_vi": "Ở Momo, bạn so hai chiếc ghế cũ cùng kiểu: chiếc A có vết xước ở lưng, chiếc B chân hơi lung lay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "339080f9-ff43-58f0-a0ad-71601a157c52-u01",
          "speaker_id": "a",
          "ja": "この二つの椅子は、状態がどう違いますか。",
          "vi": "Tình trạng hai chiếc ghế này khác nhau thế nào ạ?"
        },
        {
          "id": "339080f9-ff43-58f0-a0ad-71601a157c52-u02",
          "speaker_id": "b",
          "ja": "Aは背に傷があります。Bは脚が少しぐらつきます。",
          "vi": "Chiếc A xước lưng ghế; chiếc B chân hơi lung lay."
        },
        {
          "id": "339080f9-ff43-58f0-a0ad-71601a157c52-u03",
          "speaker_id": "a",
          "ja": "座るので、脚がしっかりしたAを見ます。",
          "vi": "Tôi dùng để ngồi, nên tôi xem chiếc A có chân chắc hơn."
        }
      ],
      "admin": {
        "source_refs": [
          "used_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "339080f9-ff43-58f0-a0ad-71601a157c52-u01": {
