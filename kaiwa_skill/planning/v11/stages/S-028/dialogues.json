          }
        }
      }
    },
    {
      "situation_uid": "660be1c5-ebd3-5666-80ee-a75a2d426f84",
      "event_id": "E01",
      "context_vi": "Tại Momo, bạn cân nhắc mua máy ảnh cũ và hỏi món kèm theo chiếc máy này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên recycle shop",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "660be1c5-ebd3-5666-80ee-a75a2d426f84-u01",
          "speaker_id": "a",
          "ja": "このカメラには何が付いていますか。",
          "vi": "Máy ảnh này có kèm những gì ạ?"
        },
        {
          "id": "660be1c5-ebd3-5666-80ee-a75a2d426f84-u02",
          "speaker_id": "b",
          "ja": "この箱には充電器とストラップがあります。",
          "vi": "Trong hộp này có sạc và dây đeo ạ."
        },
        {
          "id": "660be1c5-ebd3-5666-80ee-a75a2d426f84-u03",
          "speaker_id": "a",
          "ja": "電池も入っていますか。",
          "vi": "Có pin nữa không ạ?"
        },
        {
          "id": "660be1c5-ebd3-5666-80ee-a75a2d426f84-u04",
          "speaker_id": "b",
          "ja": "はい、本体に入っています。",
          "vi": "Có, pin ở trong máy ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "used_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
