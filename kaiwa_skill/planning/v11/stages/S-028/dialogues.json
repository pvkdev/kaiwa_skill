    {
      "situation_uid": "b1211fc9-1b5b-5bf2-9250-1f79360dbbbc",
      "event_id": "E03",
      "context_vi": "Bạn mang một chiếc loa cũ tới quầy thu mua Momo. Bạn đã dùng hai năm và biết nút âm lượng hơi kẹt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thu mua",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b1211fc9-1b5b-5bf2-9250-1f79360dbbbc-u01",
          "speaker_id": "a",
          "ja": "このスピーカーを二年使いました。音量のボタンが少し固いです。",
          "vi": "Tôi đã dùng loa này hai năm. Nút âm lượng hơi kẹt ạ."
        },
        {
          "id": "b1211fc9-1b5b-5bf2-9250-1f79360dbbbc-u02",
          "speaker_id": "b",
          "ja": "教えていただき、ありがとうございます。音も確認します。",
          "vi": "Cảm ơn anh đã báo. Tôi sẽ kiểm cả âm thanh."
        },
        {
          "id": "b1211fc9-1b5b-5bf2-9250-1f79360dbbbc-u03",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ chị kiểm tra."
        }
      ],
