    {
      "situation_uid": "dd140469-9f74-5570-b764-dfcbb6004c5f",
      "event_id": "E04",
      "context_vi": "Bạn vừa mua một chiếc đèn ở Momo. Nhãn món ghi có dây nguồn, nhưng trong hộp không thấy. Bạn gọi cửa hàng nhờ kiểm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "dd140469-9f74-5570-b764-dfcbb6004c5f-u01",
          "speaker_id": "a",
          "ja": "買ったランプの箱に、電源コードがありません。札には付属とありました。",
          "vi": "Hộp đèn tôi mua không có dây nguồn, nhưng nhãn ghi có kèm ạ."
        },
        {
          "id": "dd140469-9f74-5570-b764-dfcbb6004c5f-u02",
          "speaker_id": "b",
          "ja": "お知らせありがとうございます。レシートと商品の番号はありますか。",
          "vi": "Cảm ơn anh đã báo. Anh có hóa đơn và mã món không ạ?"
        },
        {
          "id": "dd140469-9f74-5570-b764-dfcbb6004c5f-u03",
          "speaker_id": "a",
          "ja": "はい、両方あります。",
          "vi": "Có ạ, tôi có cả hai."
        },
        {
          "id": "dd140469-9f74-5570-b764-dfcbb6004c5f-u04",
          "speaker_id": "b",
          "ja": "では、店で確認します。",
          "vi": "Vậy tôi sẽ kiểm tại cửa hàng."
        }
      ],
