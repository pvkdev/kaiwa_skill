          }
        }
      }
    },
    {
      "situation_uid": "1c2120f5-f977-5942-a907-a881fcdde39a",
      "event_id": "E02",
      "context_vi": "Tại Momo, chiếc đèn cũ có nhãn 'hiện trạng'. Bạn tưởng nhãn đó nghĩa là cửa hàng đã bảo đảm dùng lâu dài.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "1c2120f5-f977-5942-a907-a881fcdde39a-u01",
          "speaker_id": "a",
          "ja": "『現状渡し』なら、長く使える保証があるんですか。",
          "vi": "Nhãn 'bán theo hiện trạng' nghĩa là có bảo đảm dùng lâu dài ạ?"
        },
        {
          "id": "1c2120f5-f977-5942-a907-a881fcdde39a-u02",
          "speaker_id": "b",
          "ja": "いいえ、その意味ではありません。今の状態を見て買うということです。",
          "vi": "Không ạ. Nghĩa là anh xem tình trạng hiện tại rồi quyết định mua."
        },
        {
          "id": "1c2120f5-f977-5942-a907-a881fcdde39a-u03",
          "speaker_id": "a",
          "ja": "買った後の対応も知りたいです。",
          "vi": "Tôi muốn biết cả cách cửa hàng xử lý nếu có vấn đề sau mua."
        }
      ],
      "admin": {
        "source_refs": [
          "used_book"
        ],
