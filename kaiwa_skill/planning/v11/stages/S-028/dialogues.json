    {
      "situation_uid": "045b9e4c-8c81-5372-86bf-f37cab772490",
      "event_id": "E04",
      "context_vi": "Tiếp cuộc gọi về đèn M18 ở Momo: nhân viên đã kiểm và tìm được dây nguồn đúng mã trong kho. Bạn cần xác nhận cách nhận, chưa mặc định cửa hàng giao tận nhà.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "045b9e4c-8c81-5372-86bf-f37cab772490-u01",
          "speaker_id": "b",
          "ja": "M18の電源コードが倉庫にありました。",
          "vi": "Kho có dây nguồn của đèn M18 ạ."
        },
        {
          "id": "045b9e4c-8c81-5372-86bf-f37cab772490-u02",
          "speaker_id": "a",
          "ja": "よかったです。どこで受け取れますか。",
          "vi": "May quá. Tôi nhận ở đâu được ạ?"
        },
        {
          "id": "045b9e4c-8c81-5372-86bf-f37cab772490-u03",
          "speaker_id": "b",
          "ja": "この店のレジでお渡しします。レシートをお持ちください。",
          "vi": "Anh nhận tại quầy thu ngân cửa hàng này nhé. Mang hóa đơn theo ạ."
        },
        {
          "id": "045b9e4c-8c81-5372-86bf-f37cab772490-u04",
          "speaker_id": "a",
          "ja": "分かりました。レシートを持って行きます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ mang hóa đơn tới."
        }
      ],
