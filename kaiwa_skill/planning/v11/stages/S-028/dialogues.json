      "situation_uid": "461a06a7-6647-542d-8aa5-1df5bb8f1c96",
      "event_id": "E04",
      "context_vi": "Quầy Momo đang hỏi kho về dây nguồn của chiếc đèn cũ bạn vừa mua. Bạn cần chốt lúc nào sẽ nghe kết quả; mốc 16:00 là hẹn riêng trong cảnh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "461a06a7-6647-542d-8aa5-1df5bb8f1c96-u01",
          "speaker_id": "b",
          "ja": "今、倉庫にコードがあるか聞いています。",
          "vi": "Hiện tôi đang hỏi kho xem có dây nguồn không ạ."
        },
        {
          "id": "461a06a7-6647-542d-8aa5-1df5bb8f1c96-u02",
          "speaker_id": "a",
          "ja": "いつ返事を聞けますか。",
          "vi": "Khi nào tôi hỏi kết quả được ạ?"
        },
        {
          "id": "461a06a7-6647-542d-8aa5-1df5bb8f1c96-u03",
          "speaker_id": "b",
          "ja": "四時ごろ、この店にお電話ください。",
          "vi": "Khoảng 4 giờ anh gọi lại cửa hàng này nhé."
        },
        {
          "id": "461a06a7-6647-542d-8aa5-1df5bb8f1c96-u04",
          "speaker_id": "a",
          "ja": "分かりました。四時に電話します。",
          "vi": "Tôi hiểu rồi. 4 giờ tôi gọi."
        }
      ],
      "admin": {
