    {
      "situation_uid": "f3dc6aa7-672f-5a14-a944-22c37d812c96",
      "event_id": "E03",
      "context_vi": "Tại Momo, bạn mang một chiếc ghế cũ đến bán nhưng chưa biết cửa hàng này có nhận loại đó không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên thu mua",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "f3dc6aa7-672f-5a14-a944-22c37d812c96-u01",
          "speaker_id": "a",
          "ja": "この椅子を買い取っていますか。",
          "vi": "Cửa hàng có thu mua loại ghế này không ạ?"
        },
        {
          "id": "f3dc6aa7-672f-5a14-a944-22c37d812c96-u02",
          "speaker_id": "b",
          "ja": "サイズと状態を見て、担当者に確認します。",
          "vi": "Tôi xem kích thước, tình trạng rồi hỏi người phụ trách ạ."
        },
        {
          "id": "f3dc6aa7-672f-5a14-a944-22c37d812c96-u03",
          "speaker_id": "a",
          "ja": "分かりました。ここで見てもらえますか。",
          "vi": "Tôi hiểu. Tôi để chị xem ở đây được không ạ?"
        },
        {
          "id": "f3dc6aa7-672f-5a14-a944-22c37d812c96-u04",
          "speaker_id": "b",
          "ja": "はい、こちらに置いてください。",
          "vi": "Được ạ, anh đặt ở đây nhé."
        }
      ],
