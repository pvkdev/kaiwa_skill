        {
          "id": "b",
          "role_vi": "nhân viên thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "5c9e7d1d-6bef-5f6d-8aca-166364dddf37-u01",
          "speaker_id": "a",
          "ja": "カメラと充電器とストラップ、三つありますか。",
          "vi": "Có máy ảnh, sạc và dây đeo, đủ ba món chứ ạ?"
        },
        {
          "id": "5c9e7d1d-6bef-5f6d-8aca-166364dddf37-u02",
          "speaker_id": "b",
          "ja": "はい、こちらに三つあります。ご確認ください。",
          "vi": "Có ạ, cả ba ở đây. Anh kiểm giúp nhé."
        },
        {
          "id": "5c9e7d1d-6bef-5f6d-8aca-166364dddf37-u03",
          "speaker_id": "a",
          "ja": "確認しました。このセットを買います。",
          "vi": "Tôi kiểm rồi. Tôi mua bộ này."
