    {
      "situation_uid": "033ec9f1-a097-5e01-9fa5-8aebba04a99f",
      "event_id": "E04",
      "context_vi": "Đúng 16:00 bạn gọi lại Momo hỏi kết quả kiểm kho về dây nguồn của chiếc đèn đã mua. Nhân viên mới nhận cuộc gọi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "033ec9f1-a097-5e01-9fa5-8aebba04a99f-u01",
          "speaker_id": "a",
          "ja": "四時に電話する約束でした。ランプのコードはありましたか。",
          "vi": "Tôi đã hẹn gọi lúc 4 giờ. Đã tìm thấy dây nguồn của đèn chưa ạ?"
        },
        {
          "id": "033ec9f1-a097-5e01-9fa5-8aebba04a99f-u02",
          "speaker_id": "b",
          "ja": "お名前と商品の番号をもう一度お願いします。",
          "vi": "Anh cho tôi xin lại tên và mã món ạ."
        },
        {
          "id": "033ec9f1-a097-5e01-9fa5-8aebba04a99f-u03",
          "speaker_id": "a",
          "ja": "グエン・アンです。番号はM18です。",
          "vi": "Tôi là Nguyễn An. Mã là M18."
        },
        {
          "id": "033ec9f1-a097-5e01-9fa5-8aebba04a99f-u04",
          "speaker_id": "b",
          "ja": "確認しますので、少々お待ちください。",
          "vi": "Tôi kiểm tra, anh đợi chút nhé."
        }
      ],
