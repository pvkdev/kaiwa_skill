          }
        }
      }
    },
    {
      "situation_uid": "ec021d68-ead7-57e6-8883-a9c9ddabb5e0",
      "event_id": "E01",
      "context_vi": "Ở Momo, bạn xem một chiếc vali cũ và muốn tự thử khóa kéo trước khi mua.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên recycle shop",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "ec021d68-ead7-57e6-8883-a9c9ddabb5e0-u01",
          "speaker_id": "a",
          "ja": "このスーツケースのファスナーを動かしてもいいですか。",
          "vi": "Tôi thử kéo khóa chiếc vali này được không ạ?"
        },
        {
          "id": "ec021d68-ead7-57e6-8883-a9c9ddabb5e0-u02",
          "speaker_id": "b",
          "ja": "はい、こちらで一緒に確認しましょう。",
          "vi": "Được ạ, mình cùng kiểm tại đây nhé."
        },
        {
          "id": "ec021d68-ead7-57e6-8883-a9c9ddabb5e0-u03",
          "speaker_id": "a",
          "ja": "開けて、また閉めますね。",
          "vi": "Tôi mở rồi kéo lại nhé."
        },
        {
          "id": "ec021d68-ead7-57e6-8883-a9c9ddabb5e0-u04",
          "speaker_id": "b",
          "ja": "はい、どうぞ。",
          "vi": "Vâng, anh thử đi ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "used_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ec021d68-ead7-57e6-8883-a9c9ddabb5e0-u01": {
            "kind": "original_extension"
