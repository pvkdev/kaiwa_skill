    {
      "situation_uid": "ad0a2f72-1537-5b69-b1b0-d8fe9552c329",
      "event_id": "E04",
      "context_vi": "Quầy dịch vụ đã lùi giờ xe đón của cả nhà tới ba giờ chiều vì tàu chậm. Bạn xác nhận xe đón ở cửa nào và ai phải báo nếu tàu lại trễ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách đặt xe Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên dịch vụ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ad0a2f72-1537-5b69-b1b0-d8fe9552c329-u01",
          "speaker_id": "A",
          "ja": "午後三時に駅のどこで待てばいいですか。",
          "vi": "Ba giờ chiều tôi đợi ở đâu tại ga ạ?"
        },
        {
          "id": "ad0a2f72-1537-5b69-b1b0-d8fe9552c329-u02",
          "speaker_id": "B",
          "ja": "西口でお待ちください。",
          "vi": "Chị đợi ở cửa Tây nhé."
        },
        {
          "id": "ad0a2f72-1537-5b69-b1b0-d8fe9552c329-u03",
          "speaker_id": "A",
          "ja": "もしまた遅れたら、私からここに電話すればいいですか。",
          "vi": "Nếu lại trễ, tôi gọi cho quầy này được không ạ?"
        },
        {
          "id": "ad0a2f72-1537-5b69-b1b0-d8fe9552c329-u04",
          "speaker_id": "B",
          "ja": "はい。この番号にお電話ください。運転手に伝えます。",
          "vi": "Vâng. Chị gọi số này, tôi sẽ báo tài xế."
        },
        {
          "id": "ad0a2f72-1537-5b69-b1b0-d8fe9552c329-u05",
          "speaker_id": "A",
          "ja": "わかりました。三時に西口ですね。遅れたら私から電話します。",
          "vi": "Tôi hiểu rồi. Ba giờ ở cửa Tây ạ. Nếu trễ, tôi sẽ gọi."
        }
