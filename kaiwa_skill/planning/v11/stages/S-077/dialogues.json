      "event_id": "E02",
      "context_vi": "Chú bạn gọi báo đã lên tầng ba nhà ga số 3 Haneda và đang đứng cạnh một tháp đồng hồ. Có hai tháp, nên bạn hỏi tháp đang đứng gần quầy mang ký hiệu nào.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
