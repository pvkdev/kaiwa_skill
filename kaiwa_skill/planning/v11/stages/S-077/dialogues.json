    {
      "situation_uid": "13d8f648-26c4-5f19-b676-a156a3d86510",
      "event_id": "E02",
      "context_vi": "Bạn đang tìm chú ở nhà ga số 3 Haneda. Nhân viên cho biết bạn đứng ở sảnh khởi hành tầng ba, còn người ra khỏi khu lấy đồ thường tìm quầy tầng hai. Bạn xác nhận cách xuống.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên thông tin",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "13d8f648-26c4-5f19-b676-a156a3d86510-u01",
          "speaker_id": "B",
          "ja": "こちらは三階の出発ロビーです。到着ロビーは二階です。",
          "vi": "Đây là sảnh đi tầng ba. Sảnh đến ở tầng hai ạ."
        },
        {
