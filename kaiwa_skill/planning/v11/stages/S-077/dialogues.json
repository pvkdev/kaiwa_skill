    {
      "situation_uid": "81c9e9e5-81b6-5bb8-a2ef-652837c82876",
      "event_id": "E02",
      "context_vi": "Bạn đang ở nhà ga số 3 Haneda và chưa thấy chú. Lần liên lạc cuối, chú mới ra khỏi khu lấy hành lý và nói đang tìm quầy hướng dẫn. Bạn giải thích với nhân viên quầy tầng ba để xin chỉ chỗ gặp.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên thông tin",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "81c9e9e5-81b6-5bb8-a2ef-652837c82876-u01",
          "speaker_id": "A",
          "ja": "到着したおじを迎えに来ましたが、まだ会えていません。",
          "vi": "Tôi tới đón chú vừa hạ cánh mà vẫn chưa gặp được ạ."
        },
        {
          "id": "81c9e9e5-81b6-5bb8-a2ef-652837c82876-u02",
          "speaker_id": "B",
          "ja": "最後にどこにいるとおっしゃっていましたか。",
          "vi": "Lần cuối bác nói đang ở đâu ạ?"
        },
        {
          "id": "81c9e9e5-81b6-5bb8-a2ef-652837c82876-u03",
          "speaker_id": "A",
          "ja": "荷物を取って、案内カウンターを探していると言っていました。",
          "vi": "Chú tôi nói đã lấy hành lý và đang tìm quầy hướng dẫn ạ."
        },
        {
          "id": "81c9e9e5-81b6-5bb8-a2ef-652837c82876-u04",
          "speaker_id": "B",
          "ja": "案内カウンターはこの階にも到着ロビーにもあります。",
          "vi": "Có quầy hướng dẫn ở tầng này và cả ở sảnh đến ạ."
        },
        {
          "id": "81c9e9e5-81b6-5bb8-a2ef-652837c82876-u05",
          "speaker_id": "A",
          "ja": "そうなんですね。",
          "vi": "Ra vậy ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "pickup",
