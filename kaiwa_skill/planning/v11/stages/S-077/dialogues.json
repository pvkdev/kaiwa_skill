    {
      "situation_uid": "6c4a6667-4a80-5201-ae3e-2394501a0d14",
      "event_id": "E04",
      "context_vi": "Bạn vừa đề nghị rút lịch vì cả nhà mệt. Chú vẫn muốn ghé công viên, nên bạn hỏi chú muốn xem gì và thử thỏa thuận nghỉ trước rồi đi một đoạn ngắn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Chú muốn đi tiếp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6c4a6667-4a80-5201-ae3e-2394501a0d14-u01",
          "speaker_id": "B",
          "ja": "でも、公園にはちょっと寄りたいな。",
          "vi": "Nhưng chú vẫn muốn ghé công viên một chút."
        },
        {
          "id": "6c4a6667-4a80-5201-ae3e-2394501a0d14-u02",
          "speaker_id": "A",
          "ja": "どこを見たいの？",
          "vi": "Chú muốn xem chỗ nào ạ?"
        },
        {
          "id": "6c4a6667-4a80-5201-ae3e-2394501a0d14-u03",
          "speaker_id": "B",
          "ja": "池だけ見られたらいいよ。",
          "vi": "Chú chỉ cần xem cái ao là được."
        },
        {
