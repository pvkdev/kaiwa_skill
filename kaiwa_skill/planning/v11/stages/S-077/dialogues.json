        {
          "id": "b58ee982-4934-5613-a856-f9f396be3bdb-u03",
          "speaker_id": "A",
          "ja": "じゃ、Ｈの近くの時計だね。そこに行くよ。",
          "vi": "Vậy đồng hồ gần quầy H nhé. Cháu tới đó."
