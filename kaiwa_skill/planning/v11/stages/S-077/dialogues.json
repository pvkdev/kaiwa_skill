      }
    },
    {
      "situation_uid": "c06a13aa-630d-5965-b35b-301faffbe830",
      "event_id": "E01",
      "context_vi": "Chú bạn đến nhà ga số 3 Haneda và báo có thể chưa liên lạc qua điện thoại được lúc vừa tới. Hai chú cháu thống nhất sẽ làm gì nếu ra sảnh đến mà chưa nhìn thấy nhau.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Chú đến chơi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c06a13aa-630d-5965-b35b-301faffbe830-u01",
          "speaker_id": "B",
          "ja": "空港に着いたら、まだスマホで連絡できないかも。",
          "vi": "Đến sân bay rồi, có lẽ chú chưa liên lạc qua điện thoại được."
        },
        {
          "id": "c06a13aa-630d-5965-b35b-301faffbe830-u02",
          "speaker_id": "A",
          "ja": "じゃ、二階の案内カウンターの前で会おう。",
          "vi": "Vậy mình gặp trước quầy hướng dẫn ở tầng hai nhé chú."
        },
        {
          "id": "c06a13aa-630d-5965-b35b-301faffbe830-u03",
          "speaker_id": "B",
          "ja": "着いたとき、まだいなかったらどうする？",
          "vi": "Lúc tới mà chưa thấy cháu thì chú làm sao?"
        },
        {
          "id": "c06a13aa-630d-5965-b35b-301faffbe830-u04",
          "speaker_id": "A",
          "ja": "別のところへ行かないで、そこで待っててね。私が行くから。",
          "vi": "Chú cứ đợi đó, đừng sang nơi khác nhé. Cháu sẽ tới."
        },
        {
          "id": "c06a13aa-630d-5965-b35b-301faffbe830-u05",
          "speaker_id": "B",
          "ja": "うん、そこで待つよ。",
          "vi": "Ừ, chú đợi ở đó."
        }
      ],
      "admin": {
        "source_refs": [
          "meet",
          "counter"
        ],
        "specialty_item_ids": [],
