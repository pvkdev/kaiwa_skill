    {
      "situation_uid": "28b95046-9ef7-51a6-88de-e7652864c073",
      "event_id": "E04",
      "context_vi": "Sau buổi sáng tham quan, bạn thấy cả nhà đã mệt. Buổi chiều còn định đi công viên rồi mới tới chỗ ăn. Bạn đề nghị rút lịch và nghe người thân nghĩ sao.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Chú đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "28b95046-9ef7-51a6-88de-e7652864c073-u01",
          "speaker_id": "A",
          "ja": "みんな、少し疲れてるね。",
          "vi": "Mọi người có vẻ hơi mệt rồi chú nhỉ."
        },
        {
          "id": "28b95046-9ef7-51a6-88de-e7652864c073-u02",
          "speaker_id": "A",
          "ja": "午後は公園をやめて、食事だけにしない？",
          "vi": "Chiều nay mình bỏ công viên, chỉ đi ăn thôi nhé chú?"
        },
        {
          "id": "28b95046-9ef7-51a6-88de-e7652864c073-u03",
          "speaker_id": "B",
          "ja": "そうだね。ちょっと座ってから考えようか。",
          "vi": "Ừ nhỉ. Mình ngồi một lát rồi tính nhé?"
        },
        {
          "id": "28b95046-9ef7-51a6-88de-e7652864c073-u04",
          "speaker_id": "A",
          "ja": "うん、休んでから決めよう。",
          "vi": "Vâng, mình nghỉ rồi quyết định."
        }
      ],
