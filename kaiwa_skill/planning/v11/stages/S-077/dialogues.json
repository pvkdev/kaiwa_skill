    {
      "situation_uid": "4ec6eb44-2e79-5fe1-b17c-d4369f0aaa89",
      "event_id": "E03",
      "context_vi": "Bạn đã đón được chú ở sảnh công cộng nhà ga số 3 Haneda. Quãng đường tới chỗ người nhà đón hơi xa với chú, nên bạn hỏi quầy có xe lăn dùng trong nhà ga không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên thông tin",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4ec6eb44-2e79-5fe1-b17c-d4369f0aaa89-u01",
          "speaker_id": "A",
          "ja": "おじが長く歩くのは難しいです。車いすは借りられますか。",
          "vi": "Chú tôi khó đi bộ lâu. Tôi có thể mượn xe lăn không ạ?"
        },
        {
          "id": "4ec6eb44-2e79-5fe1-b17c-d4369f0aaa89-u02",
          "speaker_id": "B",
          "ja": "こちらで貸し出しています。空いている車いすがあるか確認しますね。",
          "vi": "Quầy này có cho mượn xe lăn. Tôi xem còn xe nào trống không nhé."
        },
        {
          "id": "4ec6eb44-2e79-5fe1-b17c-d4369f0aaa89-u03",
          "speaker_id": "A",
          "ja": "借りられたら、ここに返せばいいですか。",
          "vi": "Nếu mượn được thì dùng xong tôi trả tại đây ạ?"
        },
        {
          "id": "4ec6eb44-2e79-5fe1-b17c-d4369f0aaa89-u04",
          "speaker_id": "B",
          "ja": "はい、ここへお戻しください。",
          "vi": "Vâng. Chị mang trả tại quầy này nhé."
        }
      ],
