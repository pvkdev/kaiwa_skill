        {
          "id": "13d8f648-26c4-5f19-b676-a156a3d86510-u03",
          "speaker_id": "B",
          "ja": "あちらのエレベーターで二階へどうぞ。",
          "vi": "Chị đi thang máy đằng kia xuống tầng hai nhé."
        },
        {
          "id": "13d8f648-26c4-5f19-b676-a156a3d86510-u04",
          "speaker_id": "A",
          "ja": "二階の到着ロビーの案内カウンターへ行きます。ありがとうございます。",
          "vi": "Tôi sẽ tới quầy hướng dẫn ở sảnh đến tầng hai. Cảm ơn anh."
