    {
      "situation_uid": "d208f053-cb43-5f18-a709-a6aece9bd7db",
      "event_id": "E04",
      "context_vi": "Cả nhà đã rút ngắn lịch tham quan. Bạn có đặt xe đón ở ga lúc hai giờ chiều để tới chỗ ăn. Tàu chậm nên bạn gọi quầy dịch vụ xin lùi giờ xe.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách đặt xe Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên dịch vụ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d208f053-cb43-5f18-a709-a6aece9bd7db-u01",
          "speaker_id": "A",
          "ja": "午後二時の駅のお迎えを予約したグエンです。",
          "vi": "Tôi là Nguyễn, có đặt xe đón ở ga lúc hai giờ chiều ạ."
        },
        {
          "id": "d208f053-cb43-5f18-a709-a6aece9bd7db-u02",
          "speaker_id": "A",
          "ja": "電車が遅れています。午後三時に変えられますか。",
          "vi": "Tàu đang chậm. Tôi đổi sang ba giờ chiều được không ạ?"
        },
        {
          "id": "d208f053-cb43-5f18-a709-a6aece9bd7db-u03",
          "speaker_id": "B",
          "ja": "グエン様ですね。はい、午後三時に変更できます。",
          "vi": "Chị Nguyễn ạ. Vâng, chúng tôi đổi sang ba giờ chiều được."
        },
        {
          "id": "d208f053-cb43-5f18-a709-a6aece9bd7db-u04",
          "speaker_id": "A",
          "ja": "ありがとうございます。三時でお願いします。",
          "vi": "Cảm ơn anh. Vậy cho tôi ba giờ nhé."
        },
        {
          "id": "d208f053-cb43-5f18-a709-a6aece9bd7db-u05",
          "speaker_id": "B",
          "ja": "はい、三時に変更しました。",
          "vi": "Vâng, tôi đã đổi sang ba giờ ạ."
        }
