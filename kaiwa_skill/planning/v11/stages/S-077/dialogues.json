    {
      "situation_uid": "4af0b47a-45bd-5093-9063-ef4a05089005",
      "event_id": "E03",
      "context_vi": "Bạn vừa hỏi mượn xe lăn để chú di chuyển trong nhà ga. Hiện xe đang được dùng hết. Bạn hỏi chỗ để chú ngồi chờ thay vì đứng giữa luồng người qua lại.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên thông tin",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4af0b47a-45bd-5093-9063-ef4a05089005-u01",
          "speaker_id": "B",
          "ja": "申し訳ございません。今は空いている車いすがございません。",
          "vi": "Rất tiếc, hiện chưa có xe lăn trống ạ."
        },
        {
          "id": "4af0b47a-45bd-5093-9063-ef4a05089005-u02",
          "speaker_id": "A",
          "ja": "近くに、座って待てる場所はありますか。",
          "vi": "Có chỗ nào gần đây để ngồi chờ không ạ?"
        },
        {
          "id": "4af0b47a-45bd-5093-9063-ef4a05089005-u03",
          "speaker_id": "B",
          "ja": "壁のそばに椅子がございます。空きましたら声をかけます。",
          "vi": "Có ghế sát tường ạ. Có xe trống thì tôi sẽ báo."
        },
        {
          "id": "4af0b47a-45bd-5093-9063-ef4a05089005-u04",
          "speaker_id": "A",
          "ja": "ありがとうございます。あの椅子で待っています。",
          "vi": "Cảm ơn anh. Chú cháu tôi sẽ đợi ở hàng ghế kia."
        }
      ],
