        {
          "id": "c664306b-a377-5787-92dd-34e54b1f959b-u02",
          "speaker_id": "B",
          "ja": "お迎えの方は、二階の到着ロビーへ、という案内です。",
          "vi": "Thông báo là người đi đón xin tới sảnh đến ở tầng hai ạ."
        },
        {
          "id": "c664306b-a377-5787-92dd-34e54b1f959b-u03",
          "speaker_id": "A",
          "ja": "二階の到着ロビーですね。",
          "vi": "Sảnh đến tầng hai phải không ạ?"
        },
        {
          "id": "c664306b-a377-5787-92dd-34e54b1f959b-u04",
          "speaker_id": "B",
          "ja": "はい、二階です。",
