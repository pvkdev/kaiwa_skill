      "event_id": "E02",
      "context_vi": "Bạn đang tìm chú ở Haneda. Vừa nghe loa chỉ người đi đón tới sảnh nào đó nhưng bạn chưa nghe rõ. Bạn nhờ nhân viên quầy nói chậm lại để xác nhận tầng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên thông tin",
