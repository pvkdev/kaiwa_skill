    {
      "situation_uid": "1a8cc34f-f2f9-57cc-8f87-01d763649522",
      "event_id": "E03",
      "context_vi": "Bạn vừa hỏi nhân viên về xe lăn cho chú. Quầy đã có một xe để dùng trong nhà ga và dặn trả về đúng quầy. Bạn giải thích lại điều đó cho chú bằng lời đơn giản.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Chú cần xe lăn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1a8cc34f-f2f9-57cc-8f87-01d763649522-u01",
          "speaker_id": "A",
          "ja": "おじさん、あのカウンターで車いすを借りられるって。",
          "vi": "Chú ơi, quầy kia có xe lăn cho mượn ạ."
        },
        {
          "id": "1a8cc34f-f2f9-57cc-8f87-01d763649522-u02",
          "speaker_id": "B",
          "ja": "空港の外まで使っていいの？",
          "vi": "Chú dùng ra ngoài sân bay được không?"
        },
        {
          "id": "1a8cc34f-f2f9-57cc-8f87-01d763649522-u03",
          "speaker_id": "A",
          "ja": "空港の中だけだよ。使い終わったら、あのカウンターに返すんだって。",
          "vi": "Chỉ dùng trong sân bay thôi chú. Dùng xong mình trả ở quầy kia."
        },
        {
          "id": "1a8cc34f-f2f9-57cc-8f87-01d763649522-u04",
          "speaker_id": "B",
          "ja": "そうか。じゃ、空港の中だけ借りよう。",
          "vi": "Ra vậy. Thế mình mượn để đi trong sân bay nhé."
        }
      ],
