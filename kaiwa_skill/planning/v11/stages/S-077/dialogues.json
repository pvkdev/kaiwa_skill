    {
      "situation_uid": "a8783bb6-e5a4-5c14-952a-e27f9d4f3d37",
      "event_id": "E01",
      "context_vi": "Bạn đã hẹn đón chú tại Haneda nhưng chú nghe nhầm thành Narita. Bạn nhắc tên đầy đủ để chú đối chiếu trước khi đi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Chú nghe nhầm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a8783bb6-e5a4-5c14-952a-e27f9d4f3d37-u01",
          "speaker_id": "B",
          "ja": "成田国際空港で会うんだよね。",
          "vi": "Mình gặp ở sân bay quốc tế Narita, đúng không cháu?"
        },
        {
          "id": "a8783bb6-e5a4-5c14-952a-e27f9d4f3d37-u02",
          "speaker_id": "A",
          "ja": "成田じゃなくて、東京国際空港だよ。羽田空港のこと。チケットを見てみて。",
          "vi": "Là sân bay quốc tế Tokyo, tức Haneda, chú ạ. Không phải Narita. Chú xem lại vé đi."
        },
        {
          "id": "a8783bb6-e5a4-5c14-952a-e27f9d4f3d37-u03",
          "speaker_id": "B",
          "ja": "あ、チケットに「羽田」って書いてある。",
          "vi": "À, trên vé có ghi “Haneda”."
        },
        {
          "id": "a8783bb6-e5a4-5c14-952a-e27f9d4f3d37-u04",
          "speaker_id": "A",
          "ja": "うん。羽田の第３ターミナルで会おうね。",
          "vi": "Vâng. Mình gặp ở nhà ga số 3 Haneda nhé chú."
        }
      ],
      "admin": {
        "source_refs": [
          "pickup",
          "name",
          "narita",
          "counter"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
