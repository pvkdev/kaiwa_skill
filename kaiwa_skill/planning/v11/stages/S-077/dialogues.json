  "dialogues": [
    {
      "situation_uid": "303abbcb-4928-5297-89af-9bfcf52b618c",
      "event_id": "E01",
      "context_vi": "Chú bạn sắp sang Nhật và vé ghi đến nhà ga số 3 Haneda lúc hai giờ chiều thứ Tư. Bạn gọi nói tầng và quầy dễ thấy để chú có thể gặp bạn sau khi lấy đồ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Chú đến chơi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "303abbcb-4928-5297-89af-9bfcf52b618c-u01",
          "speaker_id": "A",
          "ja": "水曜の午後二時に、羽田の第３ターミナルに着くんだね。",
          "vi": "Chú đến nhà ga số 3 Haneda lúc hai giờ chiều thứ Tư nhỉ."
        },
        {
          "id": "303abbcb-4928-5297-89af-9bfcf52b618c-u02",
          "speaker_id": "B",
          "ja": "そうだよ。出たら、どこで会う？",
          "vi": "Ừ. Ra ngoài rồi thì mình gặp ở đâu?"
        },
        {
          "id": "303abbcb-4928-5297-89af-9bfcf52b618c-u03",
          "speaker_id": "A",
          "ja": "二階の到着ロビーの案内カウンターの前で会おう。",
          "vi": "Mình gặp trước quầy hướng dẫn ở sảnh đến tầng hai nhé chú."
        },
        {
          "id": "303abbcb-4928-5297-89af-9bfcf52b618c-u04",
          "speaker_id": "B",
          "ja": "わかった。二階の案内カウンターの前だね。",
          "vi": "Chú hiểu rồi. Trước quầy hướng dẫn tầng hai nhé."
        },
        {
          "id": "303abbcb-4928-5297-89af-9bfcf52b618c-u05",
          "speaker_id": "A",
          "ja": "うん。会えるの、楽しみにしてるね。",
          "vi": "Vâng. Cháu mong được gặp chú."
        }
      ],
      "admin": {
        "source_refs": [
          "pickup",
          "meet",
          "counter"
        ],
        "specialty_item_ids": [
          "sj-so-17-b24-34"
