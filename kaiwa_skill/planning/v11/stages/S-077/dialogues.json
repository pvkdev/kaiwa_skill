    {
      "situation_uid": "d6ac6333-6ae1-5f84-9c96-3fb6d0bacfd5",
      "event_id": "E01",
      "context_vi": "Chú bạn đã đổi chuyến nên không còn tới Haneda lúc hai giờ chiều thứ Tư. Bạn gọi hỏi giờ mới và kiểm điểm gặp có đổi không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Chú đổi chuyến",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d6ac6333-6ae1-5f84-9c96-3fb6d0bacfd5-u01",
          "speaker_id": "A",
          "ja": "便を変えたんだね。今度はいつ着くの？",
          "vi": "Chú đổi chuyến rồi nhỉ. Giờ chú tới lúc nào ạ?"
        },
        {
          "id": "d6ac6333-6ae1-5f84-9c96-3fb6d0bacfd5-u02",
          "speaker_id": "B",
          "ja": "木曜の午後四時に着くよ。",
          "vi": "Chú tới lúc bốn giờ chiều thứ Năm."
        },
        {
          "id": "d6ac6333-6ae1-5f84-9c96-3fb6d0bacfd5-u03",
          "speaker_id": "A",
          "ja": "着くのは、前と同じ羽田の第３ターミナル？",
          "vi": "Vẫn là nhà ga số 3 Haneda, đúng không chú?"
        },
        {
          "id": "d6ac6333-6ae1-5f84-9c96-3fb6d0bacfd5-u04",
          "speaker_id": "B",
          "ja": "うん、そこは同じ。",
          "vi": "Ừ, chỗ đó vẫn vậy."
        },
        {
          "id": "d6ac6333-6ae1-5f84-9c96-3fb6d0bacfd5-u05",
          "speaker_id": "A",
          "ja": "じゃ、木曜の午後四時だね。着いたら二階の案内カウンターの前で会おう。",
          "vi": "Vậy bốn giờ chiều thứ Năm nhé. Chú tới rồi mình gặp trước quầy hướng dẫn tầng hai."
        }
      ],
      "admin": {
        "source_refs": [
          "pickup",
          "delay",
          "counter"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
