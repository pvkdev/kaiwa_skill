    {
      "situation_uid": "d834da18-3b4e-5310-b1a2-88938bb86b84",
      "event_id": "E03",
      "context_vi": "Sau khi gặp chú lớn tuổi ở sảnh đến, bạn thấy chú đi chậm và muốn ngồi nghỉ trước khi đi tiếp. Bạn hỏi quầy thông tin có chỗ ngồi gần không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Cháu Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên thông tin",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d834da18-3b4e-5310-b1a2-88938bb86b84-u01",
          "speaker_id": "A",
          "ja": "おじは歩くのがゆっくりです。近くに座れるところはありますか。",
          "vi": "Chú tôi đi chậm. Gần đây có chỗ ngồi không ạ?"
        },
        {
          "id": "d834da18-3b4e-5310-b1a2-88938bb86b84-u02",
          "speaker_id": "B",
          "ja": "はい。あちらに椅子があります。",
          "vi": "Có. Đằng kia có ghế ạ."
        },
        {
          "id": "d834da18-3b4e-5310-b1a2-88938bb86b84-u03",
          "speaker_id": "A",
          "ja": "そこで少し休んでから、タクシー乗り場に行きます。",
          "vi": "Chú cháu tôi nghỉ một chút ở đó rồi ra điểm đón taxi ạ."
        },
        {
          "id": "d834da18-3b4e-5310-b1a2-88938bb86b84-u04",
          "speaker_id": "B",
          "ja": "はい。タクシーは一階です。",
          "vi": "Vâng. Điểm taxi ở tầng một ạ."
        }
      ],
