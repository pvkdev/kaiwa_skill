    {
      "situation_uid": "fdba1dab-afd7-54a6-b363-8b12190f425b",
      "event_id": "E03",
      "context_vi": "Chiều ở Hoshi hư cấu, bạn đã nghỉ hôm nay nhưng chưa biết ngày mai có đủ sức đi làm. Bạn hẹn leader sáng mai xác nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "fdba1dab-afd7-54a6-b363-8b12190f425b-u01",
          "speaker_id": "a",
          "ja": "明日出勤できるか、まだ分かりません。朝、確認して連絡してもいいですか。",
          "vi": "Tôi chưa biết mai đi làm được không. Sáng mai tôi kiểm lại rồi báo được không ạ?"
        },
        {
          "id": "fdba1dab-afd7-54a6-b363-8b12190f425b-u02",
          "speaker_id": "b",
          "ja": "はい。始業前に連絡してください。",
          "vi": "Được. Anh báo trước giờ bắt đầu nhé."
        },
        {
          "id": "fdba1dab-afd7-54a6-b363-8b12190f425b-u03",
          "speaker_id": "a",
          "ja": "分かりました。明日の八時に電話します。",
          "vi": "Tôi hiểu. Mai 8 giờ tôi sẽ gọi."
        },
        {
          "id": "fdba1dab-afd7-54a6-b363-8b12190f425b-u04",
          "speaker_id": "b",
          "ja": "お願いします。",
          "vi": "Nhờ anh."
        }
      ],
