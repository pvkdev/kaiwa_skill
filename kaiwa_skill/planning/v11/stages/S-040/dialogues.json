    {
      "situation_uid": "dcd9a3c8-942b-5b30-a49b-cd20ac1259c2",
      "event_id": "E02",
      "context_vi": "Khi nghỉ ở Hoshi hư cấu, bạn báo cho đồng nghiệp trực vị trí tài liệu cần cho cuộc gọi khách. Tài liệu ở thư mục chung, không phải tài khoản riêng của bạn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp trực",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "dcd9a3c8-942b-5b30-a49b-cd20ac1259c2-u01",
          "speaker_id": "a",
          "ja": "必要な資料は、共有フォルダーの「納品」の中にあります。",
          "vi": "Tài liệu cần dùng ở thư mục chung, trong mục “Giao hàng”."
        },
        {
          "id": "dcd9a3c8-942b-5b30-a49b-cd20ac1259c2-u02",
          "speaker_id": "b",
          "ja": "共有フォルダーですね。自分のアカウントで見ます。",
          "vi": "Thư mục chung nhỉ. Tôi sẽ xem bằng tài khoản của mình."
        },
        {
          "id": "dcd9a3c8-942b-5b30-a49b-cd20ac1259c2-u03",
          "speaker_id": "a",
          "ja": "はい。私の個人用の場所には入る必要はありません。",
          "vi": "Vâng. Chị không cần vào chỗ riêng của tôi."
        },
        {
          "id": "dcd9a3c8-942b-5b30-a49b-cd20ac1259c2-u04",
          "speaker_id": "b",
          "ja": "分かりました。共有の資料だけ確認します。",
          "vi": "Tôi hiểu. Tôi chỉ xem tài liệu chung."
        }
      ],
      "admin": {
