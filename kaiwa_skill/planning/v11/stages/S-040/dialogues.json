      "turns": [
        {
          "id": "842bdf7c-9c80-5322-9a4c-63780becc85e-u01",
          "speaker_id": "a",
          "ja": "佐藤さんは資料を見られますが、二時まで電話できません。お客様への折り返しはまだ担当者がいません。",
          "vi": "Chị Sato xem được tài liệu nhưng không thể gọi trước 2 giờ. Cuộc gọi lại cho khách vẫn chưa có người phụ trách."
        },
        {
          "id": "842bdf7c-9c80-5322-9a4c-63780becc85e-u02",
          "speaker_id": "b",
          "ja": "分かりました。私が別の担当者を確認します。",
          "vi": "Tôi hiểu. Tôi sẽ tìm người khác phụ trách."
        },
        {
          "id": "842bdf7c-9c80-5322-9a4c-63780becc85e-u03",
          "speaker_id": "a",
          "ja": "二時までに必要です。決まったら教えていただけますか。",
          "vi": "Cần gọi chậm nhất 2 giờ. Khi phân người xong chị báo tôi được không?"
        },
        {
          "id": "842bdf7c-9c80-5322-9a4c-63780becc85e-u04",
          "speaker_id": "b",
          "ja": "はい。決まったら連絡します。",
          "vi": "Được, chốt xong tôi sẽ báo."
        }
      ],
