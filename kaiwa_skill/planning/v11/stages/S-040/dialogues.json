          }
        }
      }
    },
    {
      "situation_uid": "014daf92-459d-5608-9d31-9de81fd99b9e",
      "event_id": "E01",
      "context_vi": "Sau khi leader Hoshi nhận tin bạn không thể làm hôm nay và hẹn cập nhật lúc 15 giờ, bạn chưa biết ngày mai có đi làm được không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "014daf92-459d-5608-9d31-9de81fd99b9e-u01",
          "speaker_id": "b",
          "ja": "明日は来られそうですか。",
          "vi": "Ngày mai anh đi làm được không?"
        },
        {
          "id": "014daf92-459d-5608-9d31-9de81fd99b9e-u02",
          "speaker_id": "a",
          "ja": "まだ分かりません。今日の三時に状態をお伝えします。",
          "vi": "Tôi vẫn chưa biết. 3 giờ chiều nay tôi sẽ báo tình hình."
        },
        {
          "id": "014daf92-459d-5608-9d31-9de81fd99b9e-u03",
          "speaker_id": "b",
          "ja": "分かりました。今日の分だけ調整します。",
          "vi": "Tôi hiểu. Trước mắt tôi sắp xếp ca hôm nay."
        },
        {
          "id": "014daf92-459d-5608-9d31-9de81fd99b9e-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。三時に連絡します。",
          "vi": "Cảm ơn chị. Tôi sẽ gọi lúc 3 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "absence",
          "phone"
        ],
        "specialty_item_ids": [],
