    {
      "situation_uid": "ccdb47e6-7a0b-590c-ad11-d469ec1d3b69",
      "event_id": "E03",
      "context_vi": "Sáng hôm sau 8 giờ, theo hẹn bạn gọi leader Hoshi. Bạn vẫn không đủ sức đi làm và hỏi ai sẽ nhận phần việc còn dở.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "ccdb47e6-7a0b-590c-ad11-d469ec1d3b69-u01",
          "speaker_id": "a",
          "ja": "おはようございます。昨日の約束で電話しました。今日も出勤できません。",
          "vi": "Chào buổi sáng. Tôi gọi theo hẹn hôm qua. Hôm nay tôi vẫn không đi làm được."
        },
        {
          "id": "ccdb47e6-7a0b-590c-ad11-d469ec1d3b69-u02",
          "speaker_id": "b",
          "ja": "分かりました。今日の勤務も調整します。",
          "vi": "Tôi hiểu. Tôi sẽ sắp xếp ca hôm nay."
        },
        {
          "id": "ccdb47e6-7a0b-590c-ad11-d469ec1d3b69-u03",
          "speaker_id": "a",
          "ja": "昨日の仕事の続きは、誰に伝えればいいですか。",
          "vi": "Phần việc còn lại từ hôm qua, tôi nên báo cho ai?"
        },
        {
          "id": "ccdb47e6-7a0b-590c-ad11-d469ec1d3b69-u04",
          "speaker_id": "b",
          "ja": "今日は山本さんが担当します。急ぎの点だけ伝えてください。",
          "vi": "Hôm nay chị Yamamoto phụ trách. Anh chỉ báo phần gấp thôi nhé."
        },
        {
          "id": "ccdb47e6-7a0b-590c-ad11-d469ec1d3b69-u05",
          "speaker_id": "a",
          "ja": "分かりました。短く連絡します。",
          "vi": "Tôi hiểu. Tôi sẽ báo ngắn gọn."
        }
      ],
