          }
        }
      }
    },
    {
      "situation_uid": "6130f81c-48de-5d3c-ae5f-ad7912bc0fc7",
      "event_id": "E02",
      "context_vi": "Sau khi bạn báo cuộc gọi khách cần thực hiện chậm nhất 14 giờ ở Hoshi, đồng nghiệp Sato chỉ có thể xem hồ sơ, không thể gọi vì đang trực quầy. Bạn cần leader phân người gọi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp trực",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "6130f81c-48de-5d3c-ae5f-ad7912bc0fc7-u01",
          "speaker_id": "b",
          "ja": "資料は確認できますが、私は二時まで受付で電話できません。",
          "vi": "Tôi xem được hồ sơ, nhưng trước 2 giờ tôi trực quầy nên không gọi được."
        },
        {
          "id": "6130f81c-48de-5d3c-ae5f-ad7912bc0fc7-u02",
          "speaker_id": "a",
          "ja": "分かりました。電話の担当はまだ決まっていませんね。",
          "vi": "Tôi hiểu. Vậy vẫn chưa có người phụ trách cuộc gọi nhỉ."
        },
        {
          "id": "6130f81c-48de-5d3c-ae5f-ad7912bc0fc7-u03",
          "speaker_id": "b",
          "ja": "はい。リーダーに相談してください。",
          "vi": "Đúng. Anh trao đổi với trưởng nhóm nhé."
        },
        {
          "id": "6130f81c-48de-5d3c-ae5f-ad7912bc0fc7-u04",
          "speaker_id": "a",
          "ja": "そうします。確認ありがとう。",
          "vi": "Tôi sẽ làm vậy. Cảm ơn chị đã kiểm tra."
        }
      ],
      "admin": {
        "source_refs": [
          "handoff"
        ],
        "specialty_item_ids": [],
