  "dialogues": [
    {
      "situation_uid": "0d74966e-b4ac-5b7c-b6ce-2453b85b91f8",
      "event_id": "E01",
      "context_vi": "Trước ca sáng ở công ty Hoshi hư cấu, bạn thấy không đủ sức đi làm hôm nay. Bạn gọi leader, nêu ngắn tình trạng và hỏi cách báo nghỉ tại công ty này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0d74966e-b4ac-5b7c-b6ce-2453b85b91f8-u01",
          "speaker_id": "a",
          "ja": "おはようございます。グエンです。今日は体調が悪く、出勤できません。休みの連絡はこれでよろしいですか。",
          "vi": "Chào buổi sáng. Tôi là Nguyễn. Hôm nay tôi không khỏe, không thể đi làm. Tôi báo nghỉ như thế này đã đúng cách ở công ty mình chưa ạ?"
        },
        {
          "id": "0d74966e-b4ac-5b7c-b6ce-2453b85b91f8-u02",
          "speaker_id": "b",
          "ja": "連絡を受けました。今日の勤務はこちらで調整します。午後、状況を教えてください。",
          "vi": "Tôi đã nhận tin. Ca hôm nay bên tôi sẽ sắp xếp. Chiều anh báo tình hình nhé."
        },
        {
          "id": "0d74966e-b4ac-5b7c-b6ce-2453b85b91f8-u03",
          "speaker_id": "a",
          "ja": "分かりました。午後三時にもう一度連絡します。",
          "vi": "Tôi hiểu. 3 giờ chiều tôi sẽ liên hệ lại."
        },
        {
          "id": "0d74966e-b4ac-5b7c-b6ce-2453b85b91f8-u04",
          "speaker_id": "b",
          "ja": "お願いします。お大事に。",
          "vi": "Nhờ anh. Anh giữ sức nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "absence",
          "phone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
