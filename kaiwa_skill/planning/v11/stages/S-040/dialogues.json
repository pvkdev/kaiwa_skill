    {
      "situation_uid": "5b84b5ef-06a6-5ae2-85a1-776f2b06c5ba",
      "event_id": "E02",
      "context_vi": "Bạn nghỉ hôm nay ở Hoshi hư cấu. Một khách đang chờ công ty gọi lại chậm nhất 14 giờ; bạn báo cho đồng nghiệp trực Sato việc gì còn chờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp trực",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "5b84b5ef-06a6-5ae2-85a1-776f2b06c5ba-u01",
          "speaker_id": "a",
          "ja": "お客様への折り返し電話がまだです。今日の二時までに連絡が必要です。",
          "vi": "Công ty vẫn chưa gọi lại cho khách. Cần liên hệ chậm nhất 2 giờ hôm nay."
        },
        {
          "id": "5b84b5ef-06a6-5ae2-85a1-776f2b06c5ba-u02",
          "speaker_id": "b",
          "ja": "分かりました。どの件ですか。",
          "vi": "Tôi hiểu. Về việc gì?"
        },
        {
          "id": "5b84b5ef-06a6-5ae2-85a1-776f2b06c5ba-u03",
          "speaker_id": "a",
          "ja": "昨日の納品時間の確認です。内容は共有フォルダーにあります。",
          "vi": "Xác nhận giờ giao hàng hôm qua. Nội dung ở thư mục chung."
        },
        {
          "id": "5b84b5ef-06a6-5ae2-85a1-776f2b06c5ba-u04",
          "speaker_id": "b",
          "ja": "確認します。電話できるか、予定を見ます。",
          "vi": "Tôi sẽ xem. Để tôi kiểm tra lịch xem có gọi được không."
        }
      ],
      "admin": {
        "source_refs": [
          "handoff"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5b84b5ef-06a6-5ae2-85a1-776f2b06c5ba-u01": {
