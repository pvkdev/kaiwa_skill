    {
      "situation_uid": "a489f5ae-3b37-5f9f-b939-a25ecd2b38af",
      "event_id": "E01",
      "context_vi": "Trước ca ở Hoshi hư cấu, bạn đã báo không thể tới hôm nay. Có một việc dở cần người khác biết; bạn hỏi leader nên báo cho ai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "a489f5ae-3b37-5f9f-b939-a25ecd2b38af-u01",
          "speaker_id": "a",
          "ja": "途中の仕事があります。誰に引き継ぎを伝えればいいですか。",
          "vi": "Tôi có việc đang làm dở. Tôi nên báo bàn giao cho ai ạ?"
        },
        {
          "id": "a489f5ae-3b37-5f9f-b939-a25ecd2b38af-u02",
          "speaker_id": "b",
          "ja": "今日の担当は佐藤さんです。急ぎの部分だけ伝えてください。",
          "vi": "Hôm nay chị Sato trực. Anh báo phần gấp thôi nhé."
        },
        {
          "id": "a489f5ae-3b37-5f9f-b939-a25ecd2b38af-u03",
          "speaker_id": "a",
          "ja": "分かりました。佐藤さんに内容と期限を伝えます。",
          "vi": "Tôi hiểu. Tôi sẽ báo nội dung và hạn cho chị Sato."
        },
        {
          "id": "a489f5ae-3b37-5f9f-b939-a25ecd2b38af-u04",
          "speaker_id": "b",
          "ja": "お願いします。長く話す必要はありません。",
          "vi": "Nhờ anh. Không cần nói dài đâu."
        }
      ],
      "admin": {
        "source_refs": [
          "handoff"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a489f5ae-3b37-5f9f-b939-a25ecd2b38af-u01": {
            "kind": "original_extension"
