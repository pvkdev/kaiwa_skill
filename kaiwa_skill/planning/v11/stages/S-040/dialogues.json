    {
      "situation_uid": "1a596824-af81-53e1-b370-29bff68fbd28",
      "event_id": "E03",
      "context_vi": "Sau vài ngày nghỉ ở Hoshi hư cấu, bạn đã quay lại công ty. Bạn gặp leader và hỏi lịch, việc thay đổi trong thời gian vắng mặt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "1a596824-af81-53e1-b370-29bff68fbd28-u01",
          "speaker_id": "a",
          "ja": "今日から戻りました。休んでいる間に、予定の変更はありましたか。",
          "vi": "Hôm nay tôi đi làm lại. Trong lúc tôi nghỉ có thay đổi lịch nào không ạ?"
        },
        {
          "id": "1a596824-af81-53e1-b370-29bff68fbd28-u02",
          "speaker_id": "b",
          "ja": "午後の会議が三時に変わりました。まず共有の予定を見てください。",
          "vi": "Cuộc họp chiều chuyển sang 3 giờ. Trước hết anh xem lịch chung nhé."
        },
        {
          "id": "1a596824-af81-53e1-b370-29bff68fbd28-u03",
          "speaker_id": "a",
          "ja": "分かりました。担当した方にも、進み具合を聞きます。",
          "vi": "Tôi hiểu. Tôi cũng sẽ hỏi người đã nhận việc về tiến độ."
        },
        {
          "id": "1a596824-af81-53e1-b370-29bff68fbd28-u04",
          "speaker_id": "b",
          "ja": "はい。必要なら私にも聞いてください。",
          "vi": "Ừ. Cần gì anh hỏi tôi thêm."
        }
      ],
