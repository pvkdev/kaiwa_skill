    {
      "situation_uid": "d7b1586f-dc93-5a71-8086-fd6fecef9976",
      "event_id": "E01",
      "context_vi": "Sau cuộc gọi báo nghỉ hôm nay ở Hoshi, leader tưởng bạn xin nghỉ cả hôm nay lẫn ngày mai. Bạn sửa: chắc chắn chỉ hôm nay, ngày mai chưa rõ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d7b1586f-dc93-5a71-8086-fd6fecef9976-u01",
          "speaker_id": "b",
          "ja": "二日間休むということですね。",
          "vi": "Vậy anh nghỉ hai ngày nhé."
        },
        {
          "id": "d7b1586f-dc93-5a71-8086-fd6fecef9976-u02",
          "speaker_id": "a",
          "ja": "すみません。確実に休むのは今日だけです。明日はまだ分かりません。",
          "vi": "Xin lỗi. Chắc chắn tôi nghỉ chỉ hôm nay. Ngày mai tôi vẫn chưa biết."
        },
        {
          "id": "d7b1586f-dc93-5a71-8086-fd6fecef9976-u03",
          "speaker_id": "b",
          "ja": "分かりました。明日のことはまた連絡してください。",
          "vi": "Tôi hiểu. Việc ngày mai anh báo lại nhé."
        },
        {
          "id": "d7b1586f-dc93-5a71-8086-fd6fecef9976-u04",
          "speaker_id": "a",
          "ja": "はい。今日の午後、まず状況をお伝えします。",
          "vi": "Vâng. Chiều nay tôi sẽ báo tình hình trước."
        }
      ],
      "admin": {
        "source_refs": [
          "absence",
          "phone"
        ],
