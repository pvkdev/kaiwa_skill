    {
      "situation_uid": "a3ff305f-8b84-510f-a024-e4f01a69558a",
      "event_id": "E03",
      "context_vi": "Đến chiều ở Hoshi hư cấu, bạn đã nghỉ hôm nay và thấy có thể đi làm lại ngày mai. Bạn gọi leader để báo kế hoạch ngày mai, không đưa chẩn đoán y tế.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "a3ff305f-8b84-510f-a024-e4f01a69558a-u01",
          "speaker_id": "a",
          "ja": "今日は休ませていただき、ありがとうございました。明日は出勤できそうです。",
          "vi": "Cảm ơn chị đã cho tôi nghỉ hôm nay. Ngày mai tôi nghĩ mình đi làm được."
        },
        {
          "id": "a3ff305f-8b84-510f-a024-e4f01a69558a-u02",
          "speaker_id": "b",
          "ja": "分かりました。明日の朝も状況を確認して連絡してください。",
          "vi": "Tôi hiểu. Sáng mai anh kiểm lại tình trạng rồi báo nhé."
        },
        {
          "id": "a3ff305f-8b84-510f-a024-e4f01a69558a-u03",
          "speaker_id": "a",
          "ja": "はい。朝、出勤前に連絡します。",
          "vi": "Vâng. Sáng mai trước giờ làm tôi sẽ báo."
        },
        {
          "id": "a3ff305f-8b84-510f-a024-e4f01a69558a-u04",
          "speaker_id": "b",
          "ja": "お大事に。",
          "vi": "Anh giữ sức nhé."
        }
      ],
