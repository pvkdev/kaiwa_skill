            "kind": "original_extension"
          },
          "1c26b0e0-92fe-54c6-bf71-9a2980eefcdc-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "25c2c0dd-b518-5e07-abc8-ba5d53e73d1d",
      "event_id": "E01",
      "context_vi": "Bạn chỉ có thể phụ hội chợ từ chín tới mười một giờ sáng. Người phụ trách gợi ý nhập tên ở bàn tiếp đón nhưng bạn chưa quen dùng máy tính.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "25c2c0dd-b518-5e07-abc8-ba5d53e73d1d-u01",
          "speaker_id": "A",
          "ja": "パソコンはあまり使えません。ほかの仕事はありますか。",
          "vi": "Tôi không rành dùng máy tính. Có việc nào khác không ạ?"
        },
        {
          "id": "25c2c0dd-b518-5e07-abc8-ba5d53e73d1d-u02",
          "speaker_id": "B",
          "ja": "じゃ、九時からチラシを並べてもらえますか。",
          "vi": "Vậy từ chín giờ chị giúp bày tờ rơi được không?"
        },
        {
          "id": "25c2c0dd-b518-5e07-abc8-ba5d53e73d1d-u03",
          "speaker_id": "A",
          "ja": "はい、それならできます。どこに並べますか。",
          "vi": "Được ạ, việc đó tôi làm được. Tôi bày ở đâu ạ?"
        },
        {
          "id": "25c2c0dd-b518-5e07-abc8-ba5d53e73d1d-u04",
          "speaker_id": "B",
          "ja": "入口の机にお願いします。",
          "vi": "Chị bày trên bàn ở lối vào nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "enrol"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "25c2c0dd-b518-5e07-abc8-ba5d53e73d1d-u01": {
