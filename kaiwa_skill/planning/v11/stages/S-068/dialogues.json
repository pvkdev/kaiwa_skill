    {
      "situation_uid": "6dcfd853-b660-57db-ba49-1db5493f0f0f",
      "event_id": "E03",
      "context_vi": "Bạn không đi được ca sáng nhưng được nhờ tới giúp từ một giờ chiều. Vì mưa, nhóm chuyển chỗ tập trung. Bạn xác nhận lại phòng mới và xem giờ có đổi không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6dcfd853-b660-57db-ba49-1db5493f0f0f-u01",
          "speaker_id": "B",
          "ja": "雨なので、午後は外に集まりません。",
          "vi": "Vì mưa nên chiều nay mình không tập trung ngoài trời."
        },
        {
          "id": "6dcfd853-b660-57db-ba49-1db5493f0f0f-u02",
          "speaker_id": "A",
          "ja": "どこに行けばいいですか。",
          "vi": "Tôi nên tới đâu ạ?"
        },
        {
          "id": "6dcfd853-b660-57db-ba49-1db5493f0f0f-u03",
          "speaker_id": "B",
          "ja": "建物の中のＢ室です。",
          "vi": "Phòng B trong tòa nhà."
        },
        {
          "id": "6dcfd853-b660-57db-ba49-1db5493f0f0f-u04",
          "speaker_id": "A",
          "ja": "一時にＢ室ですね。時間は同じですか。",
          "vi": "Một giờ ở phòng B ạ. Giờ vẫn như cũ đúng không?"
        },
        {
          "id": "6dcfd853-b660-57db-ba49-1db5493f0f0f-u05",
          "speaker_id": "B",
          "ja": "はい、一時のままです。",
          "vi": "Đúng rồi, vẫn một giờ."
        }
      ],
