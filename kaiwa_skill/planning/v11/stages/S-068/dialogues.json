        },
        {
          "id": "101cc38f-9789-5551-b28b-7494612f7e30-u02",
          "speaker_id": "B",
          "ja": "もう行って大丈夫です。地図は私が預かります。",
          "vi": "Chị đi được rồi. Tôi giữ bản đồ giúp."
        },
        {
          "id": "101cc38f-9789-5551-b28b-7494612f7e30-u03",
          "speaker_id": "A",
          "ja": "じゃ、お願いします。地図はこの袋の一番上です。",
          "vi": "Vậy nhờ anh nhé. Xấp bản đồ nằm trên cùng trong túi này."
        },
        {
          "id": "101cc38f-9789-5551-b28b-7494612f7e30-u04",
          "speaker_id": "B",
          "ja": "はい。来たら私から渡します。",
          "vi": "Được. Người thay đến thì tôi đưa."
        }
      ],
