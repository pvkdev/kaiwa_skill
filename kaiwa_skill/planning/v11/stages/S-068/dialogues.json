          }
        }
      }
    },
    {
      "situation_uid": "1c26b0e0-92fe-54c6-bf71-9a2980eefcdc",
      "event_id": "E01",
      "context_vi": "Bạn chỉ rảnh buổi sáng cho hội chợ khu phố. Bạn báo rõ giờ có thể làm và hỏi người phụ trách việc nào vừa với ca của mình.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1c26b0e0-92fe-54c6-bf71-9a2980eefcdc-u01",
          "speaker_id": "A",
          "ja": "午前中だけ手伝えます。九時から十一時までです。",
          "vi": "Tôi giúp được buổi sáng thôi ạ, từ chín đến mười một giờ."
        },
        {
          "id": "1c26b0e0-92fe-54c6-bf71-9a2980eefcdc-u02",
          "speaker_id": "B",
          "ja": "二時間ですね。",
          "vi": "Hai tiếng nhỉ."
        },
        {
          "id": "1c26b0e0-92fe-54c6-bf71-9a2980eefcdc-u03",
          "speaker_id": "A",
          "ja": "その時間にできる仕事はありますか。",
          "vi": "Trong khoảng đó có việc nào tôi làm được không ạ?"
        },
        {
          "id": "1c26b0e0-92fe-54c6-bf71-9a2980eefcdc-u04",
          "speaker_id": "B",
          "ja": "受付で、名前をパソコンに入れる仕事があります。",
          "vi": "Có việc nhập tên vào máy tính ở bàn tiếp đón."
        }
      ],
      "admin": {
        "source_refs": [
          "enrol"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1c26b0e0-92fe-54c6-bf71-9a2980eefcdc-u01": {
            "kind": "original_extension"
          },
          "1c26b0e0-92fe-54c6-bf71-9a2980eefcdc-u02": {
            "kind": "original_extension"
