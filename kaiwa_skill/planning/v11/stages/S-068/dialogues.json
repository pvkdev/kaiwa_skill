    {
      "situation_uid": "e21e510a-1955-59b3-a037-57b3aac68341",
      "event_id": "E02",
      "context_vi": "Người hướng dẫn giao bạn phát một xấp bản đồ ở lối vào hội chợ. Bạn kiểm lại có bao nhiêu tờ và đứng phát đúng khu nào.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e21e510a-1955-59b3-a037-57b3aac68341-u01",
          "speaker_id": "B",
          "ja": "この会場の地図を配ってください。",
          "vi": "Chị phát bản đồ hội chợ này giúp tôi nhé."
        },
        {
          "id": "e21e510a-1955-59b3-a037-57b3aac68341-u02",
          "speaker_id": "A",
          "ja": "何枚ですか。どこで配りますか。",
          "vi": "Bao nhiêu tờ ạ? Tôi đứng phát ở đâu?"
        },
        {
          "id": "e21e510a-1955-59b3-a037-57b3aac68341-u03",
          "speaker_id": "B",
          "ja": "二十枚です。入口でお願いします。",
          "vi": "Hai mươi tờ. Chị phát ở lối vào nhé."
        },
        {
          "id": "e21e510a-1955-59b3-a037-57b3aac68341-u04",
          "speaker_id": "A",
          "ja": "はい、入口で二十枚ですね。",
          "vi": "Vâng, hai mươi tờ ở lối vào ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
