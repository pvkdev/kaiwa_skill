    {
      "situation_uid": "c3444e37-9c6b-57e3-9dee-409103b2b816",
      "event_id": "E03",
      "context_vi": "Bạn đã nhận phát bản đồ từ chín giờ sáng Chủ nhật. Biết có việc gia đình trùng ca, bạn gọi trước vài ngày để người phụ trách sắp lại. Bạn có thể giúp từ một giờ chiều.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c3444e37-9c6b-57e3-9dee-409103b2b816-u01",
          "speaker_id": "A",
          "ja": "すみません。日曜の朝九時の係に出られなくなりました。",
          "vi": "Xin lỗi anh. Tôi không trực được ca chín giờ sáng Chủ nhật nữa."
        },
        {
          "id": "c3444e37-9c6b-57e3-9dee-409103b2b816-u02",
          "speaker_id": "B",
          "ja": "わかりました。朝は別の人に頼みます。",
          "vi": "Được rồi. Ca sáng tôi sẽ nhờ người khác."
        },
        {
          "id": "c3444e37-9c6b-57e3-9dee-409103b2b816-u03",
          "speaker_id": "A",
          "ja": "午後一時からなら行けます。",
          "vi": "Từ một giờ chiều trở đi thì tôi tới được."
        },
        {
          "id": "c3444e37-9c6b-57e3-9dee-409103b2b816-u04",
          "speaker_id": "B",
          "ja": "午後も人が必要なら、土曜までに連絡します。",
          "vi": "Nếu buổi chiều cũng cần người, tôi sẽ báo chị chậm nhất vào thứ Bảy."
        }
      ],
