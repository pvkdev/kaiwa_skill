    {
      "situation_uid": "d14a8970-7a3d-5dc9-9dba-636f8f579f17",
      "event_id": "E04",
      "context_vi": "Ca phát bản đồ sắp hết. Bạn báo người phụ trách đã phát bao nhiêu, còn lại bao nhiêu và giao phần còn lại cho anh ấy.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d14a8970-7a3d-5dc9-9dba-636f8f579f17-u01",
          "speaker_id": "A",
          "ja": "地図を三十枚配りました。あと十枚残っています。",
          "vi": "Tôi đã phát ba mươi bản đồ. Còn lại mười bản."
        },
        {
          "id": "d14a8970-7a3d-5dc9-9dba-636f8f579f17-u02",
          "speaker_id": "B",
          "ja": "残りはこっちに持ってきてください。",
          "vi": "Chị mang phần còn lại sang đây nhé."
        },
        {
          "id": "d14a8970-7a3d-5dc9-9dba-636f8f579f17-u03",
          "speaker_id": "A",
          "ja": "はい。この机に置きますね。",
          "vi": "Vâng. Tôi để trên bàn này nhé."
        },
        {
          "id": "d14a8970-7a3d-5dc9-9dba-636f8f579f17-u04",
          "speaker_id": "B",
          "ja": "ありがとうございます。あとは私がやります。",
          "vi": "Cảm ơn chị. Phần còn lại để tôi lo."
        }
      ],
