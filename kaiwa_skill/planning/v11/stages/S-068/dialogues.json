    {
      "situation_uid": "657fb0e4-1f33-5eb6-b4b1-cd25a76a23a6",
      "event_id": "E01",
      "context_vi": "Bạn vừa hỏi về buổi tình nguyện Chủ nhật của hội chợ. Người phụ trách xem danh sách xong báo buổi này đã đủ người, nên bạn hỏi xem dịp sau có còn chỗ không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người muốn tình nguyện Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "657fb0e4-1f33-5eb6-b4b1-cd25a76a23a6-u01",
          "speaker_id": "B",
          "ja": "すみません。今週の日曜はもう人数が足りています。",
          "vi": "Tiếc quá. Chủ nhật tuần này đã đủ người rồi."
        },
        {
          "id": "657fb0e4-1f33-5eb6-b4b1-cd25a76a23a6-u02",
          "speaker_id": "A",
          "ja": "そうですか。来週の日曜はどうですか。",
          "vi": "Vậy ạ. Chủ nhật tuần sau thì sao?"
        },
        {
          "id": "657fb0e4-1f33-5eb6-b4b1-cd25a76a23a6-u03",
          "speaker_id": "B",
          "ja": "来週はまだ二人入れますよ。",
          "vi": "Tuần sau còn nhận thêm được hai người."
        },
        {
          "id": "657fb0e4-1f33-5eb6-b4b1-cd25a76a23a6-u04",
          "speaker_id": "A",
          "ja": "じゃ、来週の分をお願いします。",
          "vi": "Vậy cho tôi đăng ký tuần sau ạ."
        },
        {
          "id": "657fb0e4-1f33-5eb6-b4b1-cd25a76a23a6-u05",
          "speaker_id": "B",
          "ja": "はい、お名前をお願いします。",
          "vi": "Được. Chị cho tôi xin tên nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "cancel"
        ],
        "specialty_item_ids": [
          "sj-so-15-b12-11"
        ],
        "turn_origins": {
