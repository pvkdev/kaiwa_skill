    {
      "situation_uid": "b5935163-dffa-50e8-8cee-94a2d5904ffa",
      "event_id": "E02",
      "context_vi": "Bạn đã biết nhóm tập trung ở cửa Đông và người đầu mối cầm bảng màu xanh. Bạn nghe tên người đó thành Ueno nên hỏi lại trước khi sang nhận việc.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b5935163-dffa-50e8-8cee-94a2d5904ffa-u01",
          "speaker_id": "A",
          "ja": "すみません。東口では、上野さんに声をかけるんですか。",
          "vi": "Cho tôi hỏi lại. Ở cửa Đông tôi gặp anh Ueno ạ?"
        },
        {
          "id": "b5935163-dffa-50e8-8cee-94a2d5904ffa-u02",
          "speaker_id": "B",
          "ja": "上野さんじゃなくて、上田さんです。「うえだ」です。",
          "vi": "Anh Ueda chị ạ. Tên đọc là Ueda."
        },
        {
          "id": "b5935163-dffa-50e8-8cee-94a2d5904ffa-u03",
          "speaker_id": "A",
          "ja": "上田さんですね。青い札を持っている方ですね。",
          "vi": "Anh Ueda ạ. Là người cầm bảng xanh đúng không?"
        },
        {
          "id": "b5935163-dffa-50e8-8cee-94a2d5904ffa-u04",
          "speaker_id": "B",
          "ja": "はい、その方です。",
          "vi": "Vâng, đúng người đó."
        }
      ],
      "admin": {
