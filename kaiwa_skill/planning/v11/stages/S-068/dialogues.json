    {
      "situation_uid": "51bc0711-378e-5ba8-b630-82573b5920c7",
      "event_id": "E02",
      "context_vi": "Bạn mới tới hội chợ khu phố và gặp một người hướng dẫn. Bạn hỏi nhóm phát tài liệu của mình tập trung chỗ nào và gặp ai.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "51bc0711-378e-5ba8-b630-82573b5920c7-u01",
          "speaker_id": "A",
          "ja": "チラシを配る班はどこに集まりますか。",
          "vi": "Nhóm phát tờ rơi tập trung ở đâu ạ?"
        },
        {
          "id": "51bc0711-378e-5ba8-b630-82573b5920c7-u02",
          "speaker_id": "B",
          "ja": "東口に集まります。",
          "vi": "Tập trung ở cửa Đông chị ạ."
        },
        {
          "id": "51bc0711-378e-5ba8-b630-82573b5920c7-u03",
          "speaker_id": "A",
          "ja": "東口ですね。誰に声をかければいいですか。",
          "vi": "Cửa Đông ạ. Tôi đến gặp ai ở đó ạ?"
        },
        {
          "id": "51bc0711-378e-5ba8-b630-82573b5920c7-u04",
          "speaker_id": "B",
          "ja": "上田さんです。青い札を持っていますよ。",
          "vi": "Anh Ueda. Anh ấy cầm một tấm bảng xanh."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
        "specialty_item_ids": [],
