    {
      "situation_uid": "101cc38f-9789-5551-b28b-7494612f7e30",
      "event_id": "E03",
      "context_vi": "Bạn không thể trực ca từ chín giờ sáng nhưng ghé hội chợ trước giờ đó để giao xấp bản đồ cho người thay. Người thay chưa đến, còn bạn sắp phải đi xử lý việc gia đình.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "101cc38f-9789-5551-b28b-7494612f7e30-u01",
          "speaker_id": "A",
          "ja": "代わりの方がまだ来ていません。待ったほうがいいですか。",
