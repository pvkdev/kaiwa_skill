      "event_id": "E02",
      "context_vi": "Bạn đang phụ phát hai mươi bản đồ ở lối vào. Người hướng dẫn nhờ chuyển ghế nữa, nhưng bạn chỉ còn mười phút và cần biết nên làm việc nào trước.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "45981d8f-c6e4-5a22-995f-66630d0298dd-u01",
          "speaker_id": "B",
          "ja": "あとで、あの椅子も運んでもらえますか。",
          "vi": "Lát nữa chị chuyển mấy cái ghế kia giúp được không?"
        },
        {
          "id": "45981d8f-c6e4-5a22-995f-66630d0298dd-u02",
          "speaker_id": "A",
          "ja": "あと十分しかいられません。どちらを先にしますか。",
          "vi": "Tôi chỉ còn mười phút. Tôi làm việc nào trước ạ?"
        },
        {
          "id": "45981d8f-c6e4-5a22-995f-66630d0298dd-u03",
          "speaker_id": "B",
          "ja": "地図のほうをお願いします。椅子は私が運びます。",
          "vi": "Chị phát bản đồ tiếp nhé. Ghế để tôi chuyển."
        },
        {
          "id": "45981d8f-c6e4-5a22-995f-66630d0298dd-u04",
          "speaker_id": "A",
          "ja": "わかりました。帰る前に、地図が何枚残ったか伝えます。",
          "vi": "Vâng. Trước khi về tôi báo còn bao nhiêu bản đồ."
        }
      ],
