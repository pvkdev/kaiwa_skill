    {
      "situation_uid": "5854424d-6e7c-5073-8344-437b5d022457",
      "event_id": "E03",
      "context_vi": "Sau khi bạn báo vắng ca sáng, người phụ trách nhắn nhờ bạn tới giúp lúc một giờ chiều. Bạn đã tới nhưng thấy thùng cần chuyển nặng quá sức và xin đổi phần việc.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Tình nguyện viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5854424d-6e7c-5073-8344-437b5d022457-u01",
          "speaker_id": "A",
          "ja": "この箱、私には重すぎます。",
          "vi": "Thùng này nặng quá sức tôi ạ."
        },
        {
          "id": "5854424d-6e7c-5073-8344-437b5d022457-u02",
          "speaker_id": "A",
          "ja": "別の仕事に変えてもらえますか。",
          "vi": "Anh đổi cho tôi phần việc khác được không ạ?"
        },
        {
          "id": "5854424d-6e7c-5073-8344-437b5d022457-u03",
          "speaker_id": "B",
          "ja": "はい。あの机で地図を折ってください。",
          "vi": "Được. Chị gấp bản đồ ở cái bàn kia nhé."
        },
        {
          "id": "5854424d-6e7c-5073-8344-437b5d022457-u04",
          "speaker_id": "A",
          "ja": "それならできます。今からやりますね。",
          "vi": "Việc đó tôi làm được. Tôi làm ngay nhé."
        }
      ],
