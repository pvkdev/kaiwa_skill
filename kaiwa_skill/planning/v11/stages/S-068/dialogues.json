  "dialogues": [
    {
      "situation_uid": "9e8a7f04-ccc4-5450-9e82-2905d564dc1a",
      "event_id": "E01",
      "context_vi": "Bạn muốn phụ buổi hội chợ của khu phố. Bạn gọi người phụ trách để hỏi Chủ nhật này nhóm còn nhận người tham gia lần đầu không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người muốn tình nguyện Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9e8a7f04-ccc4-5450-9e82-2905d564dc1a-u01",
          "speaker_id": "A",
          "ja": "日曜のイベントで手伝いたいです。初めての人も参加できますか。",
          "vi": "Tôi muốn phụ sự kiện Chủ nhật. Người mới lần đầu có tham gia được không ạ?"
        },
        {
          "id": "9e8a7f04-ccc4-5450-9e82-2905d564dc1a-u02",
          "speaker_id": "B",
          "ja": "はい、初めての方も参加できます。日曜の人数を見ますね。",
          "vi": "Được, người mới có thể tham gia. Tôi xem số người Chủ nhật đã nhé."
        },
        {
          "id": "9e8a7f04-ccc4-5450-9e82-2905d564dc1a-u03",
          "speaker_id": "A",
          "ja": "お願いします。空きがあれば参加したいです。",
          "vi": "Vâng, nhờ anh xem giúp. Tôi muốn tham gia nếu còn chỗ."
        }
      ],
      "admin": {
        "source_refs": [
          "enrol",
          "volunteer"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9e8a7f04-ccc4-5450-9e82-2905d564dc1a-u01": {
