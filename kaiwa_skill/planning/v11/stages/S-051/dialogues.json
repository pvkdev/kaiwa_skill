    {
      "situation_uid": "81c64250-df31-5351-bbd8-ce61c606d1ab",
      "event_id": "E04",
      "context_vi": "Sau điều trị có gây tê tại chỗ, môi và má bạn vẫn còn tê. Bạn hỏi nha sĩ có thể ăn khi nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "81c64250-df31-5351-bbd8-ce61c606d1ab-u01",
          "speaker_id": "a",
          "ja": "食事はいつからしてもいいですか。まだ口の周りがしびれています。",
          "vi": "Tôi có thể ăn từ khi nào ạ? Quanh miệng tôi vẫn còn tê."
        },
        {
          "id": "81c64250-df31-5351-bbd8-ce61c606d1ab-u02",
          "speaker_id": "b",
          "ja": "唇や頬のしびれがなくなるまでは、食事を待ってください。",
          "vi": "Chị chờ đến khi môi và má hết tê rồi hãy ăn nhé."
        },
        {
          "id": "81c64250-df31-5351-bbd8-ce61c606d1ab-u03",
          "speaker_id": "a",
          "ja": "しびれがなくなってから食べるんですね。",
          "vi": "Vậy tôi chờ hết tê rồi mới ăn, đúng không ạ?"
        },
        {
          "id": "81c64250-df31-5351-bbd8-ce61c606d1ab-u04",
          "speaker_id": "b",
          "ja": "はい、そうです。",
          "vi": "Vâng, đúng ạ."
