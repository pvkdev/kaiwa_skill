          "id": "f95b4a55-f63a-5234-8377-987e2d0a155c-u01",
          "speaker_id": "b",
          "ja": "左の歯ですね。始めます。",
          "vi": "Răng bên trái nhé. Tôi bắt đầu."
        },
        {
          "id": "f95b4a55-f63a-5234-8377-987e2d0a155c-u02",
          "speaker_id": "a",
          "ja": "いいえ、痛いのは右下です。始める前に確認してください。",
          "vi": "Không, răng hàm dưới bên phải mới đau. Nhờ bác sĩ kiểm lại trước khi làm."
        },
        {
          "id": "f95b4a55-f63a-5234-8377-987e2d0a155c-u03",
          "speaker_id": "b",
          "ja": "右下ですね。もう一度確認します。",
          "vi": "Hàm dưới bên phải. Tôi sẽ kiểm lại lần nữa."
        }
