    {
      "situation_uid": "087d7200-5a73-503c-ab80-536a73bd3a50",
      "event_id": "E03",
      "context_vi": "Sau khi nghỉ trong buổi khám, bạn hỏi hôm nay đã làm phần nào và dự kiến còn buổi nào để trao đổi.",
