  "dialogues": [
    {
      "situation_uid": "ac690015-2312-5121-9f21-443dab07b034",
      "event_id": "E01",
      "context_vi": "Bạn gọi phòng nha Sakura hư cấu vì đau răng khi nhai. Nhân viên báo lịch gần nhất vào thứ Ba lúc 10 giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nha khoa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ac690015-2312-5121-9f21-443dab07b034-u01",
          "speaker_id": "a",
          "ja": "かむと歯が痛いです。いちばん早く診てもらえるのはいつですか。",
          "vi": "Tôi đau răng khi nhai. Sớm nhất khi nào tôi đến khám được ạ?"
        },
        {
          "id": "ac690015-2312-5121-9f21-443dab07b034-u02",
          "speaker_id": "b",
          "ja": "一番早いのは火曜日の十時です。予約しますか。",
          "vi": "Lịch sớm nhất là thứ Ba lúc 10 giờ. Bạn muốn đặt không?"
        },
        {
          "id": "ac690015-2312-5121-9f21-443dab07b034-u03",
          "speaker_id": "a",
          "ja": "はい、火曜日の十時にお願いします。名前はリンです。",
          "vi": "Vâng, cho tôi đặt 10 giờ thứ Ba. Tôi tên Linh ạ."
        },
        {
          "id": "ac690015-2312-5121-9f21-443dab07b034-u04",
          "speaker_id": "b",
          "ja": "予約しました。",
          "vi": "Tôi đã đặt lịch."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
