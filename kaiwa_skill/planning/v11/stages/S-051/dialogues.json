          }
        }
      }
    },
    {
      "situation_uid": "457200ac-8930-50d2-a23c-7923bc7fca92",
      "event_id": "E02",
      "context_vi": "Nha sĩ biết bạn đau răng hàm dưới bên phải. Bác sĩ hỏi đau lúc nhai hay cả lúc nghỉ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "457200ac-8930-50d2-a23c-7923bc7fca92-u01",
          "speaker_id": "b",
          "ja": "食べる時だけ痛いですか。",
          "vi": "Bạn chỉ đau khi ăn phải không?"
        },
        {
          "id": "457200ac-8930-50d2-a23c-7923bc7fca92-u02",
          "speaker_id": "a",
          "ja": "はい、かむと痛いです。何もかんでいないときは痛くありません。",
          "vi": "Vâng, lúc nhai thì đau. Khi không nhai thì tôi không đau ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
