    {
      "situation_uid": "f95b4a55-f63a-5234-8377-987e2d0a155c",
      "event_id": "E03",
      "context_vi": "Trước khi nha sĩ bắt đầu phần tiếp, bạn nghe bác sĩ nói răng bên trái; bạn đau răng hàm dưới bên phải và sửa ngay.",
      "speakers": [
