    {
      "situation_uid": "4c8616f4-462e-58e2-9955-5188af1b0234",
      "event_id": "E05",
      "context_vi": "Sau khi đối chiếu dự toán với nha sĩ, bạn nói với nhân viên hẹn rằng chưa thể quyết ngay và hỏi cách phản hồi.",
      "speakers": [
        {
          "id": "a",
