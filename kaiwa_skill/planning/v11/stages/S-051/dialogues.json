    {
      "situation_uid": "cde1651a-0310-5eeb-9ef9-b9a56c69ffad",
      "event_id": "E04",
      "context_vi": "Lịch tái khám thứ Ba đã đổi xong, nhưng bạn chưa xác nhận buổi điều trị thêm. Bạn hỏi dự toán cũ 3.000 yên gồm phần nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nha khoa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cde1651a-0310-5eeb-9ef9-b9a56c69ffad-u01",
          "speaker_id": "a",
          "ja": "前の見積もりの三千円は、何の分ですか。追加の治療を決める前に知りたいです。",
          "vi": "Dự toán 3.000 yên trước là cho phần nào? Tôi muốn biết trước khi quyết buổi điều trị thêm."
        },
        {
          "id": "cde1651a-0310-5eeb-9ef9-b9a56c69ffad-u02",
          "speaker_id": "b",
          "ja": "その三千円は次回の診察の見込みです。追加の治療費は、内容が決まってから別に説明します。",
          "vi": "3.000 yên đó là dự toán cho lần khám tiếp. Chi phí điều trị thêm sẽ được giải thích riêng sau khi xác định nội dung."
        },
        {
          "id": "cde1651a-0310-5eeb-9ef9-b9a56c69ffad-u03",
          "speaker_id": "a",
          "ja": "追加分はまだ決まっていないのですね。",
          "vi": "Vậy phần thêm hiện chưa được chốt."
        }
      ],
