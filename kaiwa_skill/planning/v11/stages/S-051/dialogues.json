    {
      "situation_uid": "ed4e46ed-f0c5-5da2-87d9-53ffa7f9e036",
      "event_id": "E03",
      "context_vi": "Nha sĩ đã dừng theo lời bạn và hỏi có tiếp tục được chưa. Bạn vẫn khó chịu nên cần nghỉ thêm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ed4e46ed-f0c5-5da2-87d9-53ffa7f9e036-u01",
          "speaker_id": "b",
          "ja": "続けても大丈夫ですか。",
          "vi": "Tôi tiếp tục được chứ?"
        },
        {
