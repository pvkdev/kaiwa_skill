    {
      "situation_uid": "f665a4bb-1219-5301-b939-41ccf7b287ba",
      "event_id": "E03",
      "context_vi": "Trong buổi điều trị tại phòng nha Sakura, bạn thấy đau và cần nha sĩ dừng ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f665a4bb-1219-5301-b939-41ccf7b287ba-u01",
          "speaker_id": "a",
          "ja": "痛いです。少し止めてください。",
          "vi": "Tôi đau. Xin dừng một chút ạ."
        },
        {
          "id": "f665a4bb-1219-5301-b939-41ccf7b287ba-u02",
