          }
        }
      }
    },
    {
      "situation_uid": "0d6fde7f-555c-5488-b686-17d4864f3901",
      "event_id": "E02",
      "context_vi": "Nha sĩ vừa dùng từ 詰め物 khi nói về lựa chọn điều trị. Bạn hỏi từ đó nghĩa là gì trước khi quyết định.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0d6fde7f-555c-5488-b686-17d4864f3901-u01",
          "speaker_id": "a",
          "ja": "すみません。「詰め物」は何ですか。簡単に教えてください。",
          "vi": "Xin lỗi, “tsumemono” là gì ạ? Bác sĩ giải thích đơn giản giúp tôi."
        },
        {
          "id": "0d6fde7f-555c-5488-b686-17d4864f3901-u02",
          "speaker_id": "b",
          "ja": "歯に穴があるとき、そこを埋めるための材料です。この歯に必要かどうかは、よく見てからお話しします。",
          "vi": "Đó là vật liệu dùng để lấp lỗ trên răng. Răng này có cần trám không thì tôi sẽ xem kỹ rồi trao đổi với chị."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "consent",
          "filling"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0d6fde7f-555c-5488-b686-17d4864f3901-u01": {
            "kind": "original_extension"
          },
          "0d6fde7f-555c-5488-b686-17d4864f3901-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "a8cc11ec-ff45-54b9-b580-840629393477",
      "event_id": "E02",
      "context_vi": "Nha sĩ đã kiểm tra và đang nói về phương án trám. Bạn lo miếng trám dễ nhìn thấy khi mở miệng, nên muốn nghe các lựa chọn và chi phí.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a8cc11ec-ff45-54b9-b580-840629393477-u01",
          "speaker_id": "a",
          "ja": "詰め物が目立たないか心配です。この歯には、歯と同じ色のものも使えますか。",
          "vi": "Tôi lo miếng trám dễ lộ. Răng này có thể dùng miếng trám cùng màu răng không ạ?"
        },
        {
          "id": "a8cc11ec-ff45-54b9-b580-840629393477-u02",
          "speaker_id": "b",
          "ja": "この歯なら、歯の色に近い材料も金属の材料も使えます。見た目と費用の違いを説明しますね。",
          "vi": "Với răng này có thể dùng vật liệu màu gần giống răng hoặc kim loại. Tôi sẽ giải thích khác nhau về màu sắc và chi phí nhé."
        },
        {
          "id": "a8cc11ec-ff45-54b9-b580-840629393477-u03",
          "speaker_id": "a",
          "ja": "説明を聞いてから決めたいです。",
          "vi": "Tôi muốn nghe giải thích rồi mới quyết."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "consent",
          "filling"
        ],
