        {
          "id": "ed4e46ed-f0c5-5da2-87d9-53ffa7f9e036-u03",
          "speaker_id": "b",
          "ja": "分かりました。まだ始めませんから、少し休みましょう。",
          "vi": "Được. Tôi chưa làm tiếp đâu, chị cứ nghỉ một chút nhé."
        }
