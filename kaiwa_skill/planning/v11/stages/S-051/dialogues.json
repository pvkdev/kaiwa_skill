          }
        }
      }
    },
    {
      "situation_uid": "457200ac-8930-50d2-a23c-7923bc7fca92",
      "event_id": "E02",
      "context_vi": "Nha sĩ biết bạn đau răng hàm dưới bên phải. Bác sĩ hỏi đau lúc nhai hay cả lúc nghỉ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "457200ac-8930-50d2-a23c-7923bc7fca92-u01",
          "speaker_id": "b",
          "ja": "食べる時だけ痛いですか。",
          "vi": "Bạn chỉ đau khi ăn phải không?"
        },
        {
          "id": "457200ac-8930-50d2-a23c-7923bc7fca92-u02",
          "speaker_id": "a",
          "ja": "はい、かむ時に痛みます。休んでいる時は痛くありません。",
          "vi": "Vâng, khi nhai thì đau. Lúc nghỉ tôi không đau."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "457200ac-8930-50d2-a23c-7923bc7fca92-u01": {
            "kind": "original_extension"
          },
          "457200ac-8930-50d2-a23c-7923bc7fca92-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0d6fde7f-555c-5488-b686-17d4864f3901",
      "event_id": "E02",
      "context_vi": "Nha sĩ vừa dùng từ 詰め物 khi nói về lựa chọn điều trị. Bạn hỏi từ đó nghĩa là gì trước khi quyết định.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0d6fde7f-555c-5488-b686-17d4864f3901-u01",
          "speaker_id": "a",
          "ja": "すみません。「詰め物」は何ですか。簡単に教えてください。",
          "vi": "Xin lỗi, “tsumemono” là gì ạ? Bác sĩ giải thích đơn giản giúp tôi."
        },
        {
          "id": "0d6fde7f-555c-5488-b686-17d4864f3901-u02",
          "speaker_id": "b",
          "ja": "歯の欠けた所などを材料で補うことです。今の歯に必要かは、調べてから決めます。",
          "vi": "Là dùng vật liệu để bù phần răng bị khuyết, chẳng hạn. Còn răng của bạn có cần hay không thì phải xem rồi mới quyết."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "consent"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0d6fde7f-555c-5488-b686-17d4864f3901-u01": {
            "kind": "original_extension"
          },
          "0d6fde7f-555c-5488-b686-17d4864f3901-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "a8cc11ec-ff45-54b9-b580-840629393477",
      "event_id": "E02",
      "context_vi": "Bạn hơi lo về lựa chọn vật liệu trám vừa được nha sĩ giải thích, nên xin nghe các phương án trước khi chọn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a8cc11ec-ff45-54b9-b580-840629393477-u01",
          "speaker_id": "a",
          "ja": "材料のことが少し心配です。始める前に、選べるものを聞けますか。",
          "vi": "Tôi hơi lo về vật liệu. Trước khi làm, tôi có thể nghe các lựa chọn không ạ?"
        },
        {
          "id": "a8cc11ec-ff45-54b9-b580-840629393477-u02",
          "speaker_id": "b",
          "ja": "この医院では白い材料と金属の材料があります。費用も違うので、先に説明します。",
          "vi": "Ở phòng nha này có vật liệu màu trắng và vật liệu kim loại. Chi phí khác nhau nên tôi sẽ giải thích trước."
        },
        {
          "id": "a8cc11ec-ff45-54b9-b580-840629393477-u03",
          "speaker_id": "a",
          "ja": "説明を聞いてから決めたいです。",
          "vi": "Tôi muốn nghe giải thích rồi mới quyết."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "consent"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a8cc11ec-ff45-54b9-b580-840629393477-u01": {
            "kind": "original_extension"
          },
