          }
        }
      }
    },
    {
      "situation_uid": "d45d5bd8-d775-5b71-997c-10fc660b40a6",
      "event_id": "E02",
      "context_vi": "Trong buổi khám tại phòng nha Sakura, bạn chỉ răng hàm dưới bên phải đau từ ba ngày trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d45d5bd8-d775-5b71-997c-10fc660b40a6-u01",
          "speaker_id": "a",
          "ja": "右下の奥の歯が、三日前から痛いです。",
          "vi": "Răng hàm dưới bên phải của tôi đau từ ba ngày trước."
        },
        {
          "id": "d45d5bd8-d775-5b71-997c-10fc660b40a6-u02",
          "speaker_id": "b",
          "ja": "その歯を確認します。",
          "vi": "Tôi sẽ kiểm tra răng ấy."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d45d5bd8-d775-5b71-997c-10fc660b40a6-u01": {
