          "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "98209cb8-f4a9-5edd-9c48-14d9cebfc1a8",
      "event_id": "E01",
      "context_vi": "Bạn đến phòng nha Sakura hư cấu và báo mình từng điều trị tại đây để nhân viên tìm lại hồ sơ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nha khoa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "98209cb8-f4a9-5edd-9c48-14d9cebfc1a8-u01",
          "speaker_id": "a",
          "ja": "前にこちらで治療を受けました。今日はまた歯が痛いです。",
          "vi": "Trước đây tôi từng điều trị ở đây. Hôm nay tôi lại đau răng."
        },
        {
          "id": "98209cb8-f4a9-5edd-9c48-14d9cebfc1a8-u02",
          "speaker_id": "b",
          "ja": "前回の記録を確認します。お名前を教えてください。",
          "vi": "Tôi sẽ xem hồ sơ lần trước. Cho tôi xin tên nhé."
        },
        {
          "id": "98209cb8-f4a9-5edd-9c48-14d9cebfc1a8-u03",
          "speaker_id": "a",
          "ja": "リンです。",
          "vi": "Tôi là Linh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "98209cb8-f4a9-5edd-9c48-14d9cebfc1a8-u01": {
            "kind": "original_extension"
          },
          "98209cb8-f4a9-5edd-9c48-14d9cebfc1a8-u02": {
            "kind": "original_extension"
          },
          "98209cb8-f4a9-5edd-9c48-14d9cebfc1a8-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "702b09c2-ead8-5a16-9f16-b546687717ec",
      "event_id": "E01",
      "context_vi": "Bạn đã hẹn phòng nha Sakura lúc 10 giờ thứ Ba, nhưng tàu trễ. Bạn gọi báo và hỏi có thể giữ lịch không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nha khoa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "702b09c2-ead8-5a16-9f16-b546687717ec-u01",
          "speaker_id": "a",
          "ja": "電車が遅れて、十時の予約に間に合いません。まだ診てもらえますか。",
          "vi": "Tàu trễ nên tôi không kịp lịch 10 giờ. Tôi còn được khám không ạ?"
        },
        {
          "id": "702b09c2-ead8-5a16-9f16-b546687717ec-u02",
          "speaker_id": "b",
          "ja": "今日なら十時半に変更できます。いかがですか。",
          "vi": "Hôm nay có thể đổi sang 10 giờ 30. Bạn thấy được không?"
        },
        {
          "id": "702b09c2-ead8-5a16-9f16-b546687717ec-u03",
          "speaker_id": "a",
          "ja": "はい、十時半にお願いします。",
          "vi": "Vâng, cho tôi đổi sang 10 giờ 30."
        },
        {
          "id": "702b09c2-ead8-5a16-9f16-b546687717ec-u04",
          "speaker_id": "b",
          "ja": "変更しました。気をつけてお越しください。",
          "vi": "Tôi đã đổi lịch. Bạn đi cẩn thận nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
