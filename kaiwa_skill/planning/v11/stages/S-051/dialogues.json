    },
    {
      "situation_uid": "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac",
      "event_id": "E01",
      "context_vi": "Sau khi đặt lịch khám, bạn xem lại lịch làm và thấy trùng với giờ khám 10 giờ thứ Ba. Bạn gọi phòng nha xin đổi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nha khoa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac-u01",
          "speaker_id": "a",
          "ja": "火曜日の十時に予約したリンです。その時間は仕事なので、別の日に変えられますか。",
          "vi": "Tôi là Linh, đã đặt lịch 10 giờ thứ Ba. Giờ đó tôi phải đi làm. Tôi đổi sang ngày khác được không ạ?"
        },
        {
          "id": "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac-u02",
          "speaker_id": "b",
          "ja": "木曜日の九時なら空いています。",
          "vi": "Thứ Năm lúc 9 giờ còn trống."
        },
        {
          "id": "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac-u03",
          "speaker_id": "a",
          "ja": "では、木曜日の九時に変えてください。",
          "vi": "Vậy đổi sang thứ Năm lúc 9 giờ giúp tôi."
        },
        {
          "id": "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac-u04",
          "speaker_id": "b",
          "ja": "では、木曜日の午前九時に変更しました。",
          "vi": "Vâng, tôi đã chuyển sang 9 giờ sáng thứ Năm ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
