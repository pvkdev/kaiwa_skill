    {
      "situation_uid": "ed4e46ed-f0c5-5da2-87d9-53ffa7f9e036",
      "event_id": "E03",
      "context_vi": "Nha sĩ đã dừng theo lời bạn. Bạn vẫn đau nên xin nghỉ thêm trước khi quyết định có tiếp tục được không.",
