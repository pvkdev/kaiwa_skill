          }
        }
      }
    },
    {
      "situation_uid": "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac",
      "event_id": "E01",
      "context_vi": "Sau khi nghe lịch thứ Ba lúc 10 giờ, bạn nhận ra giờ ấy vướng công việc và hỏi một giờ khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nha khoa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac-u01",
          "speaker_id": "a",
          "ja": "火曜日の十時は仕事があります。ほかの時間に変えられますか。",
          "vi": "Thứ Ba lúc 10 giờ tôi phải làm việc. Có thể đổi giờ khác không ạ?"
        },
        {
          "id": "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac-u02",
          "speaker_id": "b",
          "ja": "木曜日の九時なら空いています。",
          "vi": "Thứ Năm lúc 9 giờ còn trống."
        },
        {
          "id": "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac-u03",
          "speaker_id": "a",
          "ja": "では、木曜日の九時に変えてください。",
          "vi": "Vậy đổi sang thứ Năm lúc 9 giờ giúp tôi."
        },
        {
          "id": "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac-u04",
          "speaker_id": "b",
          "ja": "変更しました。",
          "vi": "Tôi đã đổi lịch."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9dbf3584-4fd8-57e6-9a85-a1c34dfd62ac-u01": {
