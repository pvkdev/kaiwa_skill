    {
      "situation_uid": "fe6d3b23-b4a6-54ca-8367-0de30800e275",
      "event_id": "E05",
      "context_vi": "Nha sĩ đưa dự toán mới 8.000 yên cho buổi điều trị thêm, khác dự toán kiểm tra 3.000 yên trước đó. Bạn xin đối chiếu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fe6d3b23-b4a6-54ca-8367-0de30800e275-u01",
          "speaker_id": "a",
          "ja": "新しい見積もりは八千円ですか。前の三千円と何が違いますか。",
          "vi": "Dự toán mới là 8.000 yên ạ? Khác dự toán 3.000 yên trước ở phần nào?"
        },
        {
          "id": "fe6d3b23-b4a6-54ca-8367-0de30800e275-u02",
          "speaker_id": "b",
          "ja": "三千円は診察の見込みでした。八千円は、追加で相談している処置の見込みです。まだ確定額ではありません。",
          "vi": "3.000 yên là dự toán lần khám. 8.000 yên là dự toán cho phần điều trị thêm đang bàn, chưa phải số tiền cuối cùng."
        },
        {
          "id": "fe6d3b23-b4a6-54ca-8367-0de30800e275-u03",
          "speaker_id": "a",
          "ja": "別の内容の見積もりなのですね。",
          "vi": "Vậy hai khoản dự toán là cho hai phần khác nhau."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "consent"
        ],
