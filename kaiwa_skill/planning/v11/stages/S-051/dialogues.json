    {
      "situation_uid": "399b20f4-53df-5b8f-80b5-4081444010f4",
      "event_id": "E04",
      "context_vi": "Sau buổi điều trị ở phòng nha Sakura, bạn gọi quầy vì cơn đau khiến mình lo và muốn nói với nha sĩ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nha khoa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "399b20f4-53df-5b8f-80b5-4081444010f4-u01",
          "speaker_id": "a",
          "ja": "治療のあと、気になる痛みがあります。歯科医に相談できますか。",
          "vi": "Sau điều trị, tôi có cơn đau khiến mình lo. Tôi có thể hỏi nha sĩ không ạ?"
        },
        {
          "id": "399b20f4-53df-5b8f-80b5-4081444010f4-u02",
          "speaker_id": "b",
          "ja": "はい。今の様子を伺って、すぐ歯科医につなぎます。",
          "vi": "Được. Tôi sẽ hỏi tình trạng lúc này rồi chuyển ngay cho nha sĩ."
        },
        {
          "id": "399b20f4-53df-5b8f-80b5-4081444010f4-u03",
          "speaker_id": "a",
          "ja": "今は右下が強く痛みます。",
          "vi": "Lúc này răng hàm dưới bên phải đau nhiều."
        },
        {
          "id": "399b20f4-53df-5b8f-80b5-4081444010f4-u04",
          "speaker_id": "b",
          "ja": "分かりました。歯科医につなぎます。",
          "vi": "Tôi hiểu. Tôi sẽ nối máy cho nha sĩ."
        }
      ],
