    {
      "situation_uid": "22de9802-c27f-50ca-a802-c6332805c24d",
      "event_id": "E05",
      "context_vi": "Bạn đã quyết sẽ đặt buổi điều trị thêm. Bạn gọi quầy hẹn của phòng nha Sakura để chốt giờ và chuyển câu hỏi cho nha sĩ.",
      "speakers": [
