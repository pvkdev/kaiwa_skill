    {
      "situation_uid": "399b20f4-53df-5b8f-80b5-4081444010f4",
      "event_id": "E04",
      "context_vi": "Sau buổi điều trị ở phòng nha Sakura, bạn gọi quầy vì cơn đau khiến mình lo và muốn nói với nha sĩ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nha khoa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "399b20f4-53df-5b8f-80b5-4081444010f4-u01",
          "speaker_id": "a",
          "ja": "今日、治療を受けたリンです。帰ってから痛くなりました。先生と話せますか。",
          "vi": "Tôi là Linh, hôm nay có đến điều trị. Về nhà thì tôi thấy đau. Tôi nói chuyện với nha sĩ được không ạ?"
        },
        {
          "id": "399b20f4-53df-5b8f-80b5-4081444010f4-u02",
          "speaker_id": "b",
          "ja": "おつなぎする前に、今どこがどのくらい痛いか、教えていただけますか。",
          "vi": "Trước khi nối máy, cho tôi hỏi chị đang đau chỗ nào và đau đến mức nào ạ?"
        },
        {
          "id": "399b20f4-53df-5b8f-80b5-4081444010f4-u03",
          "speaker_id": "a",
          "ja": "右下の治療した歯が、何もしなくても強く痛みます。",
          "vi": "Răng hàm dưới bên phải vừa điều trị đau nhiều, kể cả khi tôi không làm gì ạ."
        },
        {
          "id": "399b20f4-53df-5b8f-80b5-4081444010f4-u04",
          "speaker_id": "b",
          "ja": "分かりました。歯科医につなぎます。",
          "vi": "Tôi hiểu. Tôi sẽ nối máy cho nha sĩ."
        }
      ],
