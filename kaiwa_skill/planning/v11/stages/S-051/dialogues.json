    {
      "situation_uid": "81c64250-df31-5351-bbd8-ce61c606d1ab",
      "event_id": "E04",
      "context_vi": "Sau buổi điều trị có dùng thuốc tê ở phòng nha Sakura, bạn hỏi lại chính lời nha sĩ đã dặn về lúc ăn uống.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nha sĩ",
