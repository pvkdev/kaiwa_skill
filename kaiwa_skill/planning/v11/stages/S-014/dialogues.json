    {
      "situation_uid": "ae139b3a-f011-5dcd-9686-bc9ff5243434",
      "event_id": "E02",
      "context_vi": "Tiếp ngay sau khi tài xế cho bạn xuống trước biển xanh của khách sạn Aoba hư cấu. Bạn nhìn biển tên và xác nhận nơi xuống.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "tài xế taxi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ae139b3a-f011-5dcd-9686-bc9ff5243434-u01",
          "speaker_id": "b",
          "ja": "こちらでよろしいですか。",
          "vi": "Chỗ này được chứ ạ?"
        },
        {
          "id": "ae139b3a-f011-5dcd-9686-bc9ff5243434-u02",
          "speaker_id": "a",
          "ja": "はい、青葉ホテルの正面ですね。ありがとうございます。",
          "vi": "Vâng, đây là cửa chính khách sạn Aoba. Cảm ơn anh."
        },
        {
          "id": "ae139b3a-f011-5dcd-9686-bc9ff5243434-u03",
          "speaker_id": "b",
          "ja": "お気をつけて。",
          "vi": "Chị đi cẩn thận nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "taxi"
        ],
        "specialty_item_ids": [
          "sj-so-03-b11-77"
        ],
        "turn_origins": {
