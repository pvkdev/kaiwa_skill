          },
          "8dbe2e4e-41e2-5c1b-98db-ce5906556d81-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "a3f88581-7c6c-5806-bbce-fbd3644d3dd7",
      "event_id": "E02",
      "context_vi": "Bạn đi taxi trong Sendai đến khách sạn Aoba hư cấu, hỏi tài xế ước lượng riêng của chuyến này vì cần báo người đón.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "tài xế taxi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a3f88581-7c6c-5806-bbce-fbd3644d3dd7-u01",
          "speaker_id": "a",
          "ja": "ここから、何分ぐらいですか。",
          "vi": "Từ đây khoảng bao nhiêu phút ạ?"
        },
        {
          "id": "a3f88581-7c6c-5806-bbce-fbd3644d3dd7-u02",
          "speaker_id": "b",
          "ja": "今の道なら、十五分ぐらいです。",
          "vi": "Theo đường lúc này thì khoảng 15 phút."
        },
        {
          "id": "a3f88581-7c6c-5806-bbce-fbd3644d3dd7-u03",
          "speaker_id": "a",
          "ja": "わかりました。友達に連絡します。",
          "vi": "Tôi rõ rồi. Tôi sẽ báo bạn."
        }
      ],
      "admin": {
        "source_refs": [
          "taxi"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a3f88581-7c6c-5806-bbce-fbd3644d3dd7-u01": {
            "kind": "original_extension"
          },
          "a3f88581-7c6c-5806-bbce-fbd3644d3dd7-u02": {
            "kind": "original_extension"
          },
          "a3f88581-7c6c-5806-bbce-fbd3644d3dd7-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "28a371d5-9819-529d-a726-413798be33fb",
      "event_id": "E02",
      "context_vi": "Trên chuyến taxi giả định, đường chính đang kẹt. Tài xế gợi đường khác tới khách sạn Aoba; bạn xác nhận vẫn xuống trước cửa chính.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "tài xế taxi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "28a371d5-9819-529d-a726-413798be33fb-u01",
          "speaker_id": "b",
          "ja": "この道は混んでいます。別の道から行きましょうか。",
          "vi": "Đường này đang đông. Tôi đi đường khác nhé?"
        },
        {
          "id": "28a371d5-9819-529d-a726-413798be33fb-u02",
          "speaker_id": "a",
          "ja": "はい。ホテルの正面で降りられますか。",
          "vi": "Vâng. Tôi vẫn xuống trước cửa chính khách sạn được chứ ạ?"
        },
        {
          "id": "28a371d5-9819-529d-a726-413798be33fb-u03",
          "speaker_id": "b",
          "ja": "はい、正面まで行きます。",
          "vi": "Được, tôi sẽ đi tới cửa chính."
        }
      ],
      "admin": {
        "source_refs": [
          "taxi"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "28a371d5-9819-529d-a726-413798be33fb-u01": {
            "kind": "original_extension"
          },
