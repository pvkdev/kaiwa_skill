  "dialogues": [
    {
      "situation_uid": "6361581b-7360-58ab-88a1-5c80efbbe827",
      "event_id": "E01",
      "context_vi": "Tại quầy JR East ở ga Tokyo, bạn muốn đến Sendai vào ngày 20 tháng 11. Bạn hỏi chuyến Hayabusa buổi sáng; giờ trong đoạn là ví dụ, không phải lịch chạy thật.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên vé",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6361581b-7360-58ab-88a1-5c80efbbe827-u01",
          "speaker_id": "a",
          "ja": "二十日に仙台へ行きたいです。朝のはやぶさはありますか。",
          "vi": "Tôi muốn đi Sendai ngày 20. Có chuyến Hayabusa buổi sáng không ạ?"
        },
        {
          "id": "6361581b-7360-58ab-88a1-5c80efbbe827-u02",
          "speaker_id": "b",
          "ja": "はい。九時半の便はいかがですか。",
          "vi": "Có. Chuyến 9 giờ rưỡi được không ạ?"
        },
        {
          "id": "6361581b-7360-58ab-88a1-5c80efbbe827-u03",
          "speaker_id": "a",
          "ja": "その便を見せてください。",
          "vi": "Cho tôi xem chuyến đó ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "rail",
          "hayabusa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "6361581b-7360-58ab-88a1-5c80efbbe827-u01": {
            "kind": "original_extension"
          },
          "6361581b-7360-58ab-88a1-5c80efbbe827-u02": {
            "kind": "original_extension"
          },
          "6361581b-7360-58ab-88a1-5c80efbbe827-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "c6a852d2-2006-5ee0-a98d-1bcb2666c3eb",
      "event_id": "E01",
      "context_vi": "Tại quầy JR East, bạn định đi Hayabusa từ Tokyo đến Sendai và muốn biết có phải đặt ghế không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên vé",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c6a852d2-2006-5ee0-a98d-1bcb2666c3eb-u01",
          "speaker_id": "a",
          "ja": "はやぶさは、席の予約がいりますか。",
          "vi": "Đi Hayabusa có cần đặt ghế không ạ?"
        },
        {
          "id": "c6a852d2-2006-5ee0-a98d-1bcb2666c3eb-u02",
          "speaker_id": "b",
          "ja": "はい、全席指定です。",
          "vi": "Vâng, toàn bộ là ghế đặt trước."
        },
        {
          "id": "c6a852d2-2006-5ee0-a98d-1bcb2666c3eb-u03",
          "speaker_id": "a",
          "ja": "では、一席お願いします。",
          "vi": "Vậy cho tôi đặt một ghế."
        }
      ],
      "admin": {
        "source_refs": [
          "rail",
          "hayabusa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c6a852d2-2006-5ee0-a98d-1bcb2666c3eb-u01": {
            "kind": "original_extension"
          },
          "c6a852d2-2006-5ee0-a98d-1bcb2666c3eb-u02": {
            "kind": "original_extension"
          },
          "c6a852d2-2006-5ee0-a98d-1bcb2666c3eb-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3489c6a5-341a-5401-b5f1-2e892192568f",
      "event_id": "E01",
      "context_vi": "Trong tình huống vé giả định, chuyến Hayabusa 9:30 bạn muốn đã hết chỗ. Nhân viên gợi chuyến 10:00 và bạn chọn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên vé",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3489c6a5-341a-5401-b5f1-2e892192568f-u01",
          "speaker_id": "b",
          "ja": "九時半は満席です。十時なら空いています。",
          "vi": "Chuyến 9 giờ rưỡi đã hết ghế. Chuyến 10 giờ còn chỗ."
        },
        {
          "id": "3489c6a5-341a-5401-b5f1-2e892192568f-u02",
          "speaker_id": "a",
          "ja": "十時の便にします。仙台まで一枚お願いします。",
          "vi": "Tôi lấy chuyến 10 giờ. Cho tôi một vé đến Sendai."
        },
        {
          "id": "3489c6a5-341a-5401-b5f1-2e892192568f-u03",
          "speaker_id": "b",
          "ja": "かしこまりました。",
          "vi": "Vâng ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "rail",
          "hayabusa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3489c6a5-341a-5401-b5f1-2e892192568f-u01": {
            "kind": "original_extension"
          },
          "3489c6a5-341a-5401-b5f1-2e892192568f-u02": {
            "kind": "original_extension"
          },
          "3489c6a5-341a-5401-b5f1-2e892192568f-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "a3309c2f-0cff-5e51-906a-98ed65fd8026",
      "event_id": "E01",
      "context_vi": "Nhân viên vé nói trong ví dụ chuyến Hayabusa rời Tokyo lúc 10:00 và đến Sendai lúc 11:30. Bạn nghe nhầm giờ đến là giờ khởi hành.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên vé",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a3309c2f-0cff-5e51-906a-98ed65fd8026-u01",
          "speaker_id": "b",
          "ja": "東京を十時に出て、仙台に十一時半に着きます。",
          "vi": "Tàu rời Tokyo lúc 10 giờ, đến Sendai lúc 11 giờ rưỡi."
        },
        {
          "id": "a3309c2f-0cff-5e51-906a-98ed65fd8026-u02",
          "speaker_id": "a",
          "ja": "すみません。十一時半に東京を出ますか。",
          "vi": "Xin lỗi, tàu rời Tokyo lúc 11 giờ rưỡi ạ?"
        },
        {
          "id": "a3309c2f-0cff-5e51-906a-98ed65fd8026-u03",
          "speaker_id": "b",
          "ja": "いいえ、出るのは十時です。十一時半は着く時間です。",
          "vi": "Không, tàu đi lúc 10 giờ. 11 giờ rưỡi là giờ đến."
        }
      ],
      "admin": {
        "source_refs": [
          "rail"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a3309c2f-0cff-5e51-906a-98ed65fd8026-u01": {
            "kind": "original_extension"
          },
          "a3309c2f-0cff-5e51-906a-98ed65fd8026-u02": {
            "kind": "original_extension"
          },
          "a3309c2f-0cff-5e51-906a-98ed65fd8026-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0035bd32-4026-5c00-9732-745ed9700647",
      "event_id": "E01",
      "context_vi": "Tiếp ngay sau khi bạn nhầm giờ đi với giờ đến của vé giả định. Bạn nhắc lại ngày 20, giờ rời Tokyo và ga đến để chốt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên vé",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0035bd32-4026-5c00-9732-745ed9700647-u01",
          "speaker_id": "a",
          "ja": "二十日、十時に東京を出て、仙台に行く便ですね。",
          "vi": "Ngày 20, chuyến rời Tokyo lúc 10 giờ và đi Sendai nhỉ?"
        },
        {
          "id": "0035bd32-4026-5c00-9732-745ed9700647-u02",
          "speaker_id": "b",
          "ja": "はい。仙台には十一時半に着きます。",
          "vi": "Đúng. Tàu đến Sendai lúc 11 giờ rưỡi."
        },
        {
          "id": "0035bd32-4026-5c00-9732-745ed9700647-u03",
          "speaker_id": "a",
          "ja": "わかりました。お願いします。",
          "vi": "Tôi rõ rồi. Nhờ anh làm vé."
        }
      ],
      "admin": {
        "source_refs": [
          "rail"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0035bd32-4026-5c00-9732-745ed9700647-u01": {
