    {
      "situation_uid": "c534947f-19c1-521b-a1c9-a08d8eaf8b61",
      "event_id": "E04",
      "context_vi": "Tại bến xe đêm giả định có nhiều điểm đón, bạn cầm vé tuyến do JR Bus Kanto vận hành trong câu chuyện và hỏi điểm tập trung ghi trên vé.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bến",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c534947f-19c1-521b-a1c9-a08d8eaf8b61-u01",
          "speaker_id": "a",
          "ja": "今夜のバスは、どこで待ちますか。乗り場が多くて。",
          "vi": "Xe tối nay tôi đợi ở đâu ạ? Ở đây nhiều điểm lên quá."
        },
        {
          "id": "c534947f-19c1-521b-a1c9-a08d8eaf8b61-u02",
          "speaker_id": "b",
          "ja": "切符を見せてください。こちらの三番乗り場です。",
          "vi": "Cho tôi xem vé. Chị đợi ở điểm lên số 3 bên này."
        },
        {
          "id": "c534947f-19c1-521b-a1c9-a08d8eaf8b61-u03",
          "speaker_id": "a",
          "ja": "三番ですね。",
          "vi": "Số 3 nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "direction",
          "bus"
        ],
        "specialty_item_ids": [],
