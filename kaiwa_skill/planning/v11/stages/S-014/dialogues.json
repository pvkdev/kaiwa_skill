    {
      "situation_uid": "82b68946-5b62-51a2-bb2d-0cedb34c454d",
      "event_id": "E03",
      "context_vi": "Trong lúc chờ chuyến tiếp tại ga Sendai, bạn có vali và hỏi nhân viên ga nơi có tủ gửi đồ. Bạn chỉ hỏi vị trí, chưa giả định còn chỗ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "82b68946-5b62-51a2-bb2d-0cedb34c454d-u01",
          "speaker_id": "a",
          "ja": "荷物を少し預けたいです。コインロッカーはどちらですか。",
          "vi": "Tôi muốn gửi đồ một lúc. Tủ gửi đồ ở đâu ạ?"
        },
        {
          "id": "82b68946-5b62-51a2-bb2d-0cedb34c454d-u02",
          "speaker_id": "b",
          "ja": "この階の中央口の近くにあります。空きはそこで見てください。",
          "vi": "Gần cửa trung tâm tầng này. Chị xem còn ô trống tại đó nhé."
        },
        {
          "id": "82b68946-5b62-51a2-bb2d-0cedb34c454d-u03",
          "speaker_id": "a",
          "ja": "中央口の近くですね。",
          "vi": "Gần cửa trung tâm nhỉ."
        }
      ],
      "admin": {
