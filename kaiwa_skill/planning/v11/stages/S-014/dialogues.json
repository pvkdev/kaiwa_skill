          },
          "ae139b3a-f011-5dcd-9686-bc9ff5243434-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "419a47e3-e866-54fd-bd5d-363ad06fab97",
      "event_id": "E03",
      "context_vi": "Tại ga Sendai, bạn muốn tìm quầy hỏi xe buýt đường dài. Bạn hỏi nhân viên ga hướng đi, không giả định quầy của một hãng cụ thể.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hướng dẫn ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "419a47e3-e866-54fd-bd5d-363ad06fab97-u01",
          "speaker_id": "a",
          "ja": "長距離バスの案内はどちらですか。",
          "vi": "Quầy hỏi xe buýt đường dài ở đâu ạ?"
        },
        {
          "id": "419a47e3-e866-54fd-bd5d-363ad06fab97-u02",
          "speaker_id": "b",
          "ja": "東口のほうです。まず、あちらの出口へどうぞ。",
          "vi": "Về phía cửa đông. Trước tiên chị đi ra lối kia."
        },
        {
          "id": "419a47e3-e866-54fd-bd5d-363ad06fab97-u03",
          "speaker_id": "a",
          "ja": "東口ですね。ありがとうございます。",
          "vi": "Cửa đông nhỉ. Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "direction",
          "sendai"
        ],
        "specialty_item_ids": [
          "sj-so-03-b18-13"
