    {
      "situation_uid": "37c3ed1d-1d36-5d8d-9839-5a49e4c6db19",
      "event_id": "E03",
      "context_vi": "Sau khi đổi từ taxi sang chuyến xe buýt hư cấu khác, bạn gọi cho người bạn nam đang đón ở điểm hẹn để báo mình sẽ tới muộn hơn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đón qua điện thoại",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "37c3ed1d-1d36-5d8d-9839-5a49e4c6db19-u01",
          "speaker_id": "a",
          "ja": "バスに変えたので、着くのが少し遅くなります。",
          "vi": "Tôi đổi sang xe buýt nên sẽ đến muộn một chút."
        },
        {
          "id": "37c3ed1d-1d36-5d8d-9839-5a49e4c6db19-u02",
          "speaker_id": "b",
          "ja": "わかった。どこで待てばいい？",
          "vi": "Tôi hiểu. Tôi đợi ở đâu?"
        },
        {
          "id": "37c3ed1d-1d36-5d8d-9839-5a49e4c6db19-u03",
          "speaker_id": "a",
          "ja": "駅の東口で待っていてください。着いたら電話します。",
          "vi": "Cậu đợi ở cửa đông nhà ga nhé. Tới nơi tôi sẽ gọi."
        }
      ],
      "admin": {
        "source_refs": [
