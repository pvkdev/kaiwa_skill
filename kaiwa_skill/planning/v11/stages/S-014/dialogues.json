    {
      "situation_uid": "a952621e-0a65-51cd-91a5-eedb431a3b34",
      "event_id": "E04",
      "context_vi": "Trên chuyến xe đêm giả định do JR Bus Kanto vận hành trong câu chuyện, tài xế vừa báo có điểm nghỉ. Bạn hỏi lại giờ xe rời chỗ nghỉ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "tài xế xe buýt",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a952621e-0a65-51cd-91a5-eedb431a3b34-u01",
          "speaker_id": "a",
          "ja": "次の休憩はどこですか。",
          "vi": "Điểm nghỉ tiếp theo ở đâu ạ?"
        },
        {
          "id": "a952621e-0a65-51cd-91a5-eedb431a3b34-u02",
          "speaker_id": "b",
          "ja": "次のサービスエリアです。十五分休みます。",
          "vi": "Ở trạm dịch vụ tiếp theo. Nghỉ 15 phút."
        },
        {
          "id": "a952621e-0a65-51cd-91a5-eedb431a3b34-u03",
          "speaker_id": "a",
          "ja": "バスに戻る時間を教えてください。",
          "vi": "Anh cho tôi biết giờ trở lại xe với ạ."
        },
        {
