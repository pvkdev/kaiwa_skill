          },
          "0035bd32-4026-5c00-9732-745ed9700647-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "8dbe2e4e-41e2-5c1b-98db-ce5906556d81",
      "event_id": "E02",
      "context_vi": "Bạn lên taxi ở Sendai và đưa tài xế địa chỉ một khách sạn hư cấu gần ga, đồng thời cho xem màn hình điện thoại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "tài xế taxi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8dbe2e4e-41e2-5c1b-98db-ce5906556d81-u01",
          "speaker_id": "a",
          "ja": "青葉ホテルまでお願いします。住所はここです。",
          "vi": "Cho tôi đến khách sạn Aoba. Địa chỉ ở đây ạ."
        },
        {
          "id": "8dbe2e4e-41e2-5c1b-98db-ce5906556d81-u02",
          "speaker_id": "b",
          "ja": "はい、見ました。駅の近くですね。",
          "vi": "Vâng, tôi xem rồi. Gần ga nhỉ."
        },
        {
          "id": "8dbe2e4e-41e2-5c1b-98db-ce5906556d81-u03",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Nhờ anh."
        }
      ],
      "admin": {
        "source_refs": [
          "taxi"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8dbe2e4e-41e2-5c1b-98db-ce5906556d81-u01": {
            "kind": "original_extension"
          },
