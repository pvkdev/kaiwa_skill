    {
      "situation_uid": "f3da79d5-0b85-5e4a-9fed-2272c6399244",
      "event_id": "E04",
      "context_vi": "Khi lên một chuyến xe đêm giả định, bạn mang vali lớn và hỏi tài xế nơi để; tài xế chỉ cho bạn chỗ trên xe cụ thể.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "tài xế xe buýt",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f3da79d5-0b85-5e4a-9fed-2272c6399244-u01",
          "speaker_id": "a",
          "ja": "大きいスーツケースがあります。どこに置きますか。",
          "vi": "Tôi có vali lớn. Tôi để ở đâu ạ?"
        },
        {
          "id": "f3da79d5-0b85-5e4a-9fed-2272c6399244-u02",
          "speaker_id": "b",
          "ja": "私が下の荷物室に入れます。ここで渡してください。",
          "vi": "Tôi sẽ để vào khoang đồ bên dưới. Chị đưa ở đây nhé."
        },
        {
          "id": "f3da79d5-0b85-5e4a-9fed-2272c6399244-u03",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Nhờ anh."
        }
      ],
      "admin": {
