    {
      "situation_uid": "af2fa0f5-b2c3-5339-818e-fa8967a1e39f",
      "event_id": "E03",
      "context_vi": "Quầy thông tin xe buýt mà bạn định hỏi đã đóng trong câu chuyện. Bạn gặp nhân viên ga còn làm việc và hỏi ai có thể chỉ giúp lối ra.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "af2fa0f5-b2c3-5339-818e-fa8967a1e39f-u01",
          "speaker_id": "a",
          "ja": "バスの案内が閉まっています。今、誰に聞けばいいですか。",
          "vi": "Quầy hỏi xe buýt đóng rồi. Bây giờ tôi hỏi ai được ạ?"
        },
        {
          "id": "af2fa0f5-b2c3-5339-818e-fa8967a1e39f-u02",
          "speaker_id": "b",
          "ja": "出口のことなら、私に聞いてください。",
          "vi": "Nếu hỏi lối ra, chị cứ hỏi tôi."
        },
        {
          "id": "af2fa0f5-b2c3-5339-818e-fa8967a1e39f-u03",
          "speaker_id": "a",
          "ja": "東口はどちらですか。",
          "vi": "Cửa đông ở đâu ạ?"
        },
        {
          "id": "af2fa0f5-b2c3-5339-818e-fa8967a1e39f-u04",
          "speaker_id": "b",
          "ja": "あちらの階段を下りてください。",
          "vi": "Chị xuống cầu thang đằng kia nhé."
        }
      ],
      "admin": {
