          }
        }
      }
    },
    {
      "situation_uid": "5a7a724f-aa06-505e-b986-0b7871a39f3c",
      "event_id": "E02",
      "context_vi": "Taxi sắp đến khách sạn Aoba hư cấu nhưng bản đồ chỉ cửa sau. Bạn thấy biển cửa chính bên kia góc đường và nhờ tài xế dừng ở mốc đó.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "tài xế taxi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5a7a724f-aa06-505e-b986-0b7871a39f3c-u01",
          "speaker_id": "a",
          "ja": "あ、ここは裏口です。あの青い看板の前で止めてください。",
          "vi": "À, đây là cửa sau. Anh dừng trước tấm biển xanh kia nhé."
        },
        {
          "id": "5a7a724f-aa06-505e-b986-0b7871a39f3c-u02",
          "speaker_id": "b",
          "ja": "角の向こうの看板ですね。",
          "vi": "Tấm biển qua góc đường nhỉ?"
        },
        {
          "id": "5a7a724f-aa06-505e-b986-0b7871a39f3c-u03",
          "speaker_id": "a",
          "ja": "はい、そこです。",
          "vi": "Vâng, chỗ đó."
        }
      ],
      "admin": {
        "source_refs": [
          "taxi"
        ],
        "specialty_item_ids": [
          "sj-so-03-b11-75"
        ],
        "turn_origins": {
