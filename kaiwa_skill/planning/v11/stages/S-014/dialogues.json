    {
      "situation_uid": "78f3f01c-7fc0-5966-aea1-c7e36bf72f70",
      "event_id": "E03",
      "context_vi": "Ở sảnh ga Sendai, bạn hỏi nhân viên cách ra bến taxi và điểm hỏi xe buýt, để chọn phương tiện đi tiếp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hướng dẫn ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "78f3f01c-7fc0-5966-aea1-c7e36bf72f70-u01",
          "speaker_id": "a",
          "ja": "タクシー乗り場とバスの案内は、どちらですか。",
          "vi": "Bến taxi và chỗ hỏi xe buýt ở phía nào ạ?"
        },
        {
          "id": "78f3f01c-7fc0-5966-aea1-c7e36bf72f70-u02",
          "speaker_id": "b",
          "ja": "タクシーは右、バスの案内は東口のほうです。",
          "vi": "Taxi ở bên phải, chỗ hỏi xe buýt về phía cửa đông."
        },
        {
          "id": "78f3f01c-7fc0-5966-aea1-c7e36bf72f70-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。まず東口へ行きます。",
          "vi": "Cảm ơn anh. Tôi sẽ ra cửa đông trước."
        }
      ],
      "admin": {
        "source_refs": [
