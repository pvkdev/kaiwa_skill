    {
      "situation_uid": "50cedf57-9928-5b41-a7e8-8e1c83b96eae",
      "event_id": "E04",
      "context_vi": "Tiếp ngay sau khi bạn hỏi điểm lên số 3. Nhân viên bến của chuyến giả định báo đổi sang điểm số 5 và yêu cầu có mặt lúc 21:20.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bến",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "50cedf57-9928-5b41-a7e8-8e1c83b96eae-u01",
          "speaker_id": "b",
          "ja": "すみません。今夜は五番乗り場に変わりました。九時二十分に来てください。",
          "vi": "Xin lỗi. Tối nay đổi sang điểm số 5. Chị đến lúc 9 giờ 20 nhé."
        },
        {
          "id": "50cedf57-9928-5b41-a7e8-8e1c83b96eae-u02",
          "speaker_id": "a",
          "ja": "五番乗り場に、九時二十分ですね。",
          "vi": "Điểm số 5, lúc 9 giờ 20 nhỉ."
        },
        {
          "id": "50cedf57-9928-5b41-a7e8-8e1c83b96eae-u03",
          "speaker_id": "b",
          "ja": "はい。ここから左にあります。",
          "vi": "Vâng. Từ đây đi bên trái là tới."
        }
      ],
      "admin": {
        "source_refs": [
          "direction",
          "bus"
        ],
