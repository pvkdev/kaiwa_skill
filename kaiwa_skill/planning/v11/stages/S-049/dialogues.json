      }
    },
    {
      "situation_uid": "9207ac27-7cfa-57cd-b157-6f1aea48e397",
      "event_id": "E02",
      "context_vi": "Trong phòng khám Midori, bạn nói với bác sĩ chỗ đau bụng và thời điểm bắt đầu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bác sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9207ac27-7cfa-57cd-b157-6f1aea48e397-u01",
          "speaker_id": "a",
          "ja": "右のお腹が昨日の夜から痛いです。",
          "vi": "Từ tối qua tôi đau bụng bên phải."
        },
        {
          "id": "9207ac27-7cfa-57cd-b157-6f1aea48e397-u02",
          "speaker_id": "b",
          "ja": "右側ですね。指で場所を教えてください。",
          "vi": "Bên phải ạ. Bạn chỉ vị trí đau giúp tôi."
        },
        {
          "id": "9207ac27-7cfa-57cd-b157-6f1aea48e397-u03",
          "speaker_id": "a",
          "ja": "ここです。歩くと痛みます。",
          "vi": "Chỗ này ạ. Đi lại thì đau hơn."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9207ac27-7cfa-57cd-b157-6f1aea48e397-u01": {
