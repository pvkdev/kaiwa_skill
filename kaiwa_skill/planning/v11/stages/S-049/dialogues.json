          },
          "9207ac27-7cfa-57cd-b157-6f1aea48e397-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7fd9e227-8b8e-56cf-9fa3-7a868f7fefa7",
      "event_id": "E02",
      "context_vi": "Bác sĩ đã biết bạn đau bụng bên phải từ tối qua. Bác sĩ hỏi cơn đau thay đổi thế nào khi đi và khi ngồi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bác sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7fd9e227-8b8e-56cf-9fa3-7a868f7fefa7-u01",
          "speaker_id": "b",
          "ja": "痛みはどのくらいですか。",
          "vi": "Bạn đau đến mức nào ạ?"
        },
        {
          "id": "7fd9e227-8b8e-56cf-9fa3-7a868f7fefa7-u02",
          "speaker_id": "a",
          "ja": "歩くと、立ち止まりたくなるくらい痛いです。座ると少し楽です。",
          "vi": "Khi đi lại thì tôi đau đến mức muốn dừng lại. Ngồi xuống thì đỡ một chút ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7fd9e227-8b8e-56cf-9fa3-7a868f7fefa7-u01": {
            "kind": "original_extension"
          },
          "7fd9e227-8b8e-56cf-9fa3-7a868f7fefa7-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d5626d12-ed15-5155-9b2c-68e4eade5ff3",
      "event_id": "E02",
      "context_vi": "Bác sĩ nghe nhầm thời điểm đau bụng là từ hôm nay. Bạn sửa thành từ tối qua.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bác sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d5626d12-ed15-5155-9b2c-68e4eade5ff3-u01",
          "speaker_id": "b",
          "ja": "今日から痛いのですね。",
          "vi": "Bạn bắt đầu đau từ hôm nay phải không?"
        },
        {
          "id": "d5626d12-ed15-5155-9b2c-68e4eade5ff3-u02",
          "speaker_id": "a",
          "ja": "いいえ、昨日の夜からです。",
          "vi": "Không, từ tối qua ạ."
        },
        {
          "id": "d5626d12-ed15-5155-9b2c-68e4eade5ff3-u03",
          "speaker_id": "b",
          "ja": "昨日の夜からですね。",
          "vi": "Từ tối qua ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
