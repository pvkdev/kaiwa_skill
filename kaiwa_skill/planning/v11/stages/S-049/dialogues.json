    {
      "situation_uid": "2e1dd2e7-b90a-5b80-9c61-060c93498755",
      "event_id": "E03",
      "context_vi": "Sau khi hỏi cách liên hệ nếu cơn đau không đỡ, bác sĩ hỏi ngày tái khám. Bạn chưa biết lịch rảnh và muốn gọi quầy hẹn sau.",
      "speakers": [
