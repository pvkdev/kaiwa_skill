    {
      "situation_uid": "e39b7b35-eb9a-5847-9b6e-6740c13e5542",
      "event_id": "E03",
      "context_vi": "Bác sĩ dùng từ 検査 trong buổi khám. Bạn xin giải thích bằng câu dễ hiểu trước khi tiếp tục.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bác sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e39b7b35-eb9a-5847-9b6e-6740c13e5542-u01",
          "speaker_id": "a",
          "ja": "すみません。「検査」って何ですか。簡単な言葉で教えてください。",
          "vi": "Xin lỗi bác sĩ, “kensa” là làm gì ạ? Bác sĩ giải thích bằng từ dễ hiểu giúp tôi."
        },
        {
          "id": "e39b7b35-eb9a-5847-9b6e-6740c13e5542-u02",
          "speaker_id": "b",
          "ja": "体の状態を調べることです。今日の内容も、始める前に説明します。",
          "vi": "Là kiểm tra xem cơ thể đang thế nào. Trước khi làm, tôi sẽ giải thích cụ thể hôm nay kiểm tra gì."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
