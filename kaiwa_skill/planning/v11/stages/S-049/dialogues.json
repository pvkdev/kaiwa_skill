          }
        }
      }
    },
    {
      "situation_uid": "62e71a2c-4254-595e-89f3-45c194e6277c",
      "event_id": "E01",
      "context_vi": "Bạn đến sớm trước giờ khám ở phòng khám Midori nhưng chưa biết quầy tiếp nhận ở đâu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phòng khám",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "62e71a2c-4254-595e-89f3-45c194e6277c-u01",
          "speaker_id": "a",
          "ja": "診察の受付はどこですか。",
          "vi": "Quầy tiếp nhận khám bệnh ở đâu ạ?"
        },
        {
          "id": "62e71a2c-4254-595e-89f3-45c194e6277c-u02",
          "speaker_id": "b",
          "ja": "入口の右側です。",
          "vi": "Bên phải cửa vào ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "62e71a2c-4254-595e-89f3-45c194e6277c-u01": {
            "kind": "original_extension"
          },
          "62e71a2c-4254-595e-89f3-45c194e6277c-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "6d21bb55-02ed-5f10-a1d8-f33cb09fd568",
      "event_id": "E01",
      "context_vi": "Sau cuộc gọi đầu, bạn được phòng khám Midori hẹn lúc 3 giờ chiều. Trên đường tới, bạn biết mình sẽ không kịp và gọi xin đổi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phòng khám",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6d21bb55-02ed-5f10-a1d8-f33cb09fd568-u01",
          "speaker_id": "a",
          "ja": "三時の予約に間に合いません。時間を変えられますか。",
          "vi": "Tôi không kịp lịch hẹn 3 giờ. Có thể đổi giờ không ạ?"
        },
        {
          "id": "6d21bb55-02ed-5f10-a1d8-f33cb09fd568-u02",
          "speaker_id": "b",
          "ja": "今日の四時が空いています。変更しますか。",
          "vi": "Hôm nay 4 giờ còn trống. Bạn muốn đổi sang giờ đó chứ?"
        },
        {
          "id": "6d21bb55-02ed-5f10-a1d8-f33cb09fd568-u03",
          "speaker_id": "a",
          "ja": "はい、四時にお願いします。",
          "vi": "Vâng, cho tôi đổi sang 4 giờ."
        },
        {
          "id": "6d21bb55-02ed-5f10-a1d8-f33cb09fd568-u04",
          "speaker_id": "b",
          "ja": "四時に変更しました。",
          "vi": "Tôi đã đổi lịch sang 4 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
