    {
      "situation_uid": "bd005ef3-0055-54dc-9b54-9e1047578420",
      "event_id": "E04",
      "context_vi": "Sau cuộc gọi về tờ dặn, phòng khám đã hẹn bạn tái khám. Khi tới, bạn nói với nhân viên cơn đau lúc đi lại đã giảm so với lần trước.",
