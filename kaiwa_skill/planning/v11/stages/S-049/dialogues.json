    {
      "situation_uid": "9e886675-7a34-5c19-9340-e85cfc2b095b",
      "event_id": "E04",
      "context_vi": "Sau buổi khám, tờ dặn của phòng khám Midori có chữ 再連絡 nhưng bạn không rõ khi nào phải gọi. Bạn gọi quầy hỏi.",
