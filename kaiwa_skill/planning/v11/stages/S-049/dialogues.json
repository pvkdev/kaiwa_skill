    {
      "situation_uid": "338725d9-c0d9-584f-82ce-1a9df05c11f1",
      "event_id": "E04",
      "context_vi": "Quầy Midori nói cần hỏi bác sĩ về chữ 再連絡 trên tờ dặn. Bạn cần biết lúc nào họ sẽ gọi lại.",
