        }
      }
    },
    {
      "situation_uid": "eb272fd4-964e-5c64-a830-97c98a184450",
      "event_id": "E03",
      "context_vi": "Trong buổi khám ở Midori, bạn hỏi bác sĩ khi nào cần liên hệ nếu tình trạng không đỡ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bác sĩ hoặc y tá",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "eb272fd4-964e-5c64-a830-97c98a184450-u01",
          "speaker_id": "a",
          "ja": "よくならない時は、いつ連絡すればいいですか。",
          "vi": "Nếu không đỡ, khi nào tôi cần liên hệ lại ạ?"
        },
        {
          "id": "eb272fd4-964e-5c64-a830-97c98a184450-u02",
          "speaker_id": "b",
          "ja": "よくならなければ、次の受診を待たずにこの医院へ電話してください。急に悪くなった時はすぐに知らせてください。",
          "vi": "Nếu không đỡ, bạn hãy gọi phòng khám này trước lịch khám tiếp. Nếu đột ngột nặng lên, hãy báo ngay."
        }
      ],
      "admin": {
