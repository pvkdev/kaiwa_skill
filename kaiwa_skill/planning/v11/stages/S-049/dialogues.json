          }
        }
      }
    },
    {
      "situation_uid": "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3",
      "event_id": "E02",
      "context_vi": "Bác sĩ đã hỏi về đau bụng. Bạn không biết tên triệu chứng nhưng kể thêm cảm giác buồn nôn khi ăn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bác sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3-u01",
          "speaker_id": "a",
          "ja": "食べると、吐きそうになります。",
          "vi": "Cứ ăn vào là tôi thấy buồn nôn ạ."
        },
        {
          "id": "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3-u02",
          "speaker_id": "b",
          "ja": "食べると吐きそうになるんですね。いつからですか。",
          "vi": "Cứ ăn vào là chị thấy buồn nôn đúng không ạ? Chị thấy vậy từ khi nào?"
        },
        {
          "id": "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3-u03",
          "speaker_id": "a",
          "ja": "昨日の夜からです。",
          "vi": "Từ tối qua ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
