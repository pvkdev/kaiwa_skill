    {
      "situation_uid": "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3",
      "event_id": "E02",
      "context_vi": "Bác sĩ đã hỏi về đau bụng. Bạn không biết tên triệu chứng nhưng kể thêm cảm giác buồn nôn khi ăn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bác sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3-u01",
          "speaker_id": "a",
          "ja": "症状の名前は分かりません。でも、食べると気持ちが悪くなります。",
          "vi": "Tôi không biết tên triệu chứng, nhưng cứ ăn vào là thấy buồn nôn."
        },
        {
          "id": "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3-u02",
          "speaker_id": "b",
          "ja": "食べる時に気持ちが悪くなるのですね。いつからですか。",
          "vi": "Bạn thấy buồn nôn khi ăn. Việc này bắt đầu từ khi nào?"
        },
        {
          "id": "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3-u03",
          "speaker_id": "a",
          "ja": "昨日の夜からです。",
          "vi": "Từ tối qua ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c945c7a7-a99d-507c-8f1c-32d8adc6cfa3-u01": {
