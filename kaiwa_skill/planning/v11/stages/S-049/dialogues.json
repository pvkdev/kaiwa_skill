  "dialogues": [
    {
      "situation_uid": "f2516f08-c7b5-5e99-a97b-07d1dcf3d75a",
      "event_id": "E01",
      "context_vi": "Bạn gọi phòng khám Midori hư cấu vì bị sốt từ hôm qua. Bạn hỏi họ có tiếp nhận triệu chứng này trong hôm nay không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phòng khám",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f2516f08-c7b5-5e99-a97b-07d1dcf3d75a-u01",
          "speaker_id": "a",
          "ja": "昨日から熱があります。今日はそちらで診てもらえますか。",
          "vi": "Từ hôm qua tôi bị sốt. Hôm nay phòng khám có tiếp nhận trường hợp như tôi không ạ?"
        },
        {
          "id": "f2516f08-c7b5-5e99-a97b-07d1dcf3d75a-u02",
          "speaker_id": "b",
          "ja": "はい、熱のある方の診察もしています。今日の空きをお調べします。",
          "vi": "Vâng, phòng khám có tiếp nhận bệnh nhân bị sốt. Để tôi kiểm tra hôm nay còn giờ nào ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f2516f08-c7b5-5e99-a97b-07d1dcf3d75a-u01": {
            "kind": "original_extension"
          },
          "f2516f08-c7b5-5e99-a97b-07d1dcf3d75a-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "6fccf7ed-b499-55dd-81ad-f608958d9569",
      "event_id": "E01",
      "context_vi": "Phòng khám Midori vừa xác nhận có tiếp nhận người bị sốt nhưng lịch hôm nay đã đầy. Bạn hỏi buổi sớm nhất hoặc nơi khác có thể hỏi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phòng khám",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6fccf7ed-b499-55dd-81ad-f608958d9569-u01",
          "speaker_id": "b",
          "ja": "今日は予約がいっぱいです。",
          "vi": "Hôm nay đã kín lịch ạ."
        },
        {
          "id": "6fccf7ed-b499-55dd-81ad-f608958d9569-u02",
          "speaker_id": "a",
          "ja": "いちばん早い時間はいつですか。今日診てもらえるところも探せますか。",
          "vi": "Sớm nhất thì khi nào còn lịch ạ? Tôi có thể tìm nơi khám được trong hôm nay không?"
        },
        {
          "id": "6fccf7ed-b499-55dd-81ad-f608958d9569-u03",
          "speaker_id": "b",
          "ja": "こちらの空きは明日の午前十時です。今日開いている医院は、医療情報ネットで探せます。",
          "vi": "Phòng khám còn lịch lúc 10 giờ sáng mai. Chị có thể tìm nơi đang mở hôm nay trên trang Thông tin Y tế Navii."
        },
        {
          "id": "6fccf7ed-b499-55dd-81ad-f608958d9569-u04",
          "speaker_id": "a",
          "ja": "では、明日の十時でお願いします。",
          "vi": "Vậy cho tôi hẹn 10 giờ ngày mai."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "navii"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "6fccf7ed-b499-55dd-81ad-f608958d9569-u01": {
            "kind": "original_extension"
          },
