    },
    {
      "situation_uid": "eb272fd4-964e-5c64-a830-97c98a184450",
      "event_id": "E03",
      "context_vi": "Bác sĩ vừa khám cơn đau bụng của bạn. Bạn muốn biết nếu đến ngày mai cơn đau vẫn không đỡ thì liên hệ lúc nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bác sĩ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "eb272fd4-964e-5c64-a830-97c98a184450-u01",
          "speaker_id": "a",
          "ja": "明日もお腹の痛みがよくならなかったら、いつ連絡すればいいですか。",
          "vi": "Nếu ngày mai vẫn chưa đỡ đau bụng, tôi nên liên hệ lúc nào ạ?"
        },
        {
          "id": "eb272fd4-964e-5c64-a830-97c98a184450-u02",
          "speaker_id": "b",
          "ja": "同じ痛みが明日も続いたら、診療時間にここへ電話してください。急に激しく痛くなったら、救急車を呼んでください。",
          "vi": "Nếu ngày mai vẫn đau như hôm nay, chị gọi phòng khám trong giờ làm việc. Nếu đột ngột đau dữ dội, chị gọi xe cấp cứu nhé."
        }
