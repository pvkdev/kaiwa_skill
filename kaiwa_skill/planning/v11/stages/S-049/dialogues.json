    {
      "situation_uid": "2e1dd2e7-b90a-5b80-9c61-060c93498755",
      "event_id": "E03",
      "context_vi": "Bạn vừa hỏi bác sĩ cách liên hệ lại. Bạn chưa biết lịch của mình nên muốn tự gọi quầy hẹn sau.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bác sĩ hoặc y tá",
          "gender": "male"
        }
      ],
      "turns": [
        {
