    {
      "situation_uid": "cf06a3f7-38da-5499-ac42-f0c8fb0b1141",
      "event_id": "E02",
      "context_vi": "Trong phòng sinh hoạt chung, bạn thấy túi của mình không còn trên bàn. Bạn hỏi người cùng phòng trước khi nghĩ đồ bị mất.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người cùng phòng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cf06a3f7-38da-5499-ac42-f0c8fb0b1141-u01",
          "speaker_id": "a",
          "ja": "ここに私のかばんがありました。見ましたか。",
          "vi": "Túi tôi vừa để ở đây. Anh có thấy không?"
        },
        {
          "id": "cf06a3f7-38da-5499-ac42-f0c8fb0b1141-u02",
          "speaker_id": "b",
          "ja": "はい。テーブルを使うので、横の棚に置きました。",
          "vi": "Có. Vì cần dùng bàn, tôi đặt nó lên kệ bên cạnh."
        },
        {
          "id": "cf06a3f7-38da-5499-ac42-f0c8fb0b1141-u03",
          "speaker_id": "a",
          "ja": "あ、棚ですね。見てきます。",
          "vi": "À, trên kệ nhỉ. Tôi qua xem."
        }
      ],
      "admin": {
