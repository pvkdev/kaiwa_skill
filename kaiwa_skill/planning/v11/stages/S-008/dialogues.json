    {
      "situation_uid": "47105fdb-c512-545e-aa6a-0ffdcf6ccebf",
      "event_id": "E03",
      "context_vi": "Bạn dự định chuyển khỏi ký túc vào thứ Sáu. Bạn hỏi quản lý cách trả chìa khóa theo quy trình riêng của nơi này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý ký túc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "47105fdb-c512-545e-aa6a-0ffdcf6ccebf-u01",
          "speaker_id": "a",
          "ja": "金曜日に出ます。鍵はどこに返しますか。",
          "vi": "Thứ Sáu tôi chuyển đi. Tôi trả chìa khóa ở đâu ạ?"
        },
        {
          "id": "47105fdb-c512-545e-aa6a-0ffdcf6ccebf-u02",
          "speaker_id": "b",
          "ja": "この受付へ持ってきてください。",
          "vi": "Chị mang đến quầy này nhé."
        },
        {
          "id": "47105fdb-c512-545e-aa6a-0ffdcf6ccebf-u03",
          "speaker_id": "a",
          "ja": "何時までですか。",
          "vi": "Đến mấy giờ ạ?"
        },
        {
          "id": "47105fdb-c512-545e-aa6a-0ffdcf6ccebf-u04",
          "speaker_id": "b",
          "ja": "金曜日の午後五時までです。",
          "vi": "Đến năm giờ chiều thứ Sáu."
        },
        {
          "id": "47105fdb-c512-545e-aa6a-0ffdcf6ccebf-u05",
          "speaker_id": "a",
          "ja": "金曜日の五時までに、ここですね。",
          "vi": "Trước năm giờ chiều thứ Sáu, tại đây nhỉ."
        }
      ],
