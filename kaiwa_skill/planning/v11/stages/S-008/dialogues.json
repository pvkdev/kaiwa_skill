    {
      "situation_uid": "ad5aa6bc-451a-51aa-ad3d-a1dca81dc003",
      "event_id": "E03",
      "context_vi": "Tiếp trao đổi về việc bạn thường về sau mười giờ: quản lý kiểm và nói không thể cho một ngoại lệ cố định. Bạn hỏi cách làm cho từng ca.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý ký túc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ad5aa6bc-451a-51aa-ad3d-a1dca81dc003-u01",
          "speaker_id": "b",
          "ja": "毎回使える特別な方法はありません。",
          "vi": "Không có cách đặc biệt cố định cho mọi lần ạ."
        },
        {
          "id": "ad5aa6bc-451a-51aa-ad3d-a1dca81dc003-u02",
          "speaker_id": "a",
          "ja": "では、遅い日はどうすればいいですか。",
          "vi": "Vậy hôm nào về muộn tôi nên làm gì ạ?"
        },
        {
          "id": "ad5aa6bc-451a-51aa-ad3d-a1dca81dc003-u03",
          "speaker_id": "b",
          "ja": "その日、早めに私に電話してください。",
          "vi": "Hôm đó chị gọi tôi sớm nhé."
        },
        {
          "id": "ad5aa6bc-451a-51aa-ad3d-a1dca81dc003-u04",
          "speaker_id": "a",
          "ja": "わかりました。毎回、先に電話します。",
          "vi": "Tôi hiểu rồi. Lần nào tôi cũng sẽ gọi trước."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
