    {
      "situation_uid": "b55d5566-54a3-578c-9a6f-9cd12fbd8f60",
      "event_id": "E03",
      "context_vi": "Bạn làm ca tối và thường về ký túc sau giờ cửa chính đóng mười giờ. Bạn báo trước cho quản lý để hỏi cách xử lý.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý ký túc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b55d5566-54a3-578c-9a6f-9cd12fbd8f60-u01",
          "speaker_id": "a",
          "ja": "仕事で、週に三回、十時より遅く帰ります。",
          "vi": "Vì công việc, mỗi tuần ba lần tôi về sau mười giờ."
        },
        {
          "id": "b55d5566-54a3-578c-9a6f-9cd12fbd8f60-u02",
          "speaker_id": "b",
          "ja": "そうですか。毎回の入り方を確認します。",
          "vi": "Vậy à. Để tôi kiểm cách vào cho các lần đó."
        },
        {
          "id": "b55d5566-54a3-578c-9a6f-9cd12fbd8f60-u03",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Nhờ anh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b55d5566-54a3-578c-9a6f-9cd12fbd8f60-u01": {
            "kind": "original_extension"
