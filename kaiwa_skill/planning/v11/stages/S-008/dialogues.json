          },
          "f367b00a-5223-51e9-8320-81d72fcaf875-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "633a2611-c207-5f24-ba16-214655ec7900",
      "event_id": "E01",
      "context_vi": "Sau khi sửa rằng cửa chính ký túc đóng lúc mười giờ tối chứ không phải chín giờ, bạn hỏi người quản lý phải làm gì nếu đi làm về trễ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý ký túc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "633a2611-c207-5f24-ba16-214655ec7900-u01",
          "speaker_id": "a",
          "ja": "夜十時ですね。仕事で遅くなる日は、どうしますか。",
          "vi": "Mười giờ tối nhỉ. Hôm nào đi làm về muộn thì tôi làm sao ạ?"
        },
        {
          "id": "633a2611-c207-5f24-ba16-214655ec7900-u02",
          "speaker_id": "b",
          "ja": "先に私に電話してください。入り方は、その時に案内します。",
          "vi": "Chị gọi tôi trước nhé. Lúc đó tôi sẽ chỉ cách vào."
        },
        {
          "id": "633a2611-c207-5f24-ba16-214655ec7900-u03",
          "speaker_id": "a",
          "ja": "わかりました。先に電話します。",
          "vi": "Tôi hiểu rồi. Tôi sẽ gọi trước."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "633a2611-c207-5f24-ba16-214655ec7900-u01": {
            "kind": "original_extension"
          },
          "633a2611-c207-5f24-ba16-214655ec7900-u02": {
            "kind": "original_extension"
          },
          "633a2611-c207-5f24-ba16-214655ec7900-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "21187f5d-23ef-5c73-b13b-8da49c1f2e72",
      "event_id": "E02",
      "context_vi": "Trong bếp chung ký túc, bạn muốn dùng bếp từ sáu đến bảy giờ tối. Bạn hỏi người ở cùng xem có trùng lượt không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở cùng ký túc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "21187f5d-23ef-5c73-b13b-8da49c1f2e72-u01",
          "speaker_id": "a",
          "ja": "今日、六時から七時まで台所を使ってもいいですか。",
          "vi": "Hôm nay tôi dùng bếp từ sáu đến bảy giờ được không?"
        },
        {
          "id": "21187f5d-23ef-5c73-b13b-8da49c1f2e72-u02",
          "speaker_id": "b",
          "ja": "六時半まで私が使います。七時からならどうですか。",
          "vi": "Tôi dùng đến sáu rưỡi. Từ bảy giờ được không?"
        },
        {
          "id": "21187f5d-23ef-5c73-b13b-8da49c1f2e72-u03",
          "speaker_id": "a",
          "ja": "はい、七時から使います。",
          "vi": "Được, tôi dùng từ bảy giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "home",
          "w_shared"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "21187f5d-23ef-5c73-b13b-8da49c1f2e72-u01": {
            "kind": "original_extension"
