    {
      "situation_uid": "7a2d2daf-3ea8-5def-a8d0-58a28d76159b",
      "event_id": "E03",
      "context_vi": "Đã qua trưa hôm sau mà quản lý chưa báo kết quả hỏi công ty như đã hẹn. Bạn gọi để hỏi tình hình và lần cập nhật mới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý ký túc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7a2d2daf-3ea8-5def-a8d0-58a28d76159b-u01",
          "speaker_id": "a",
          "ja": "リンです。昨日、夜遅く帰る話をしました。答えは出ましたか。",
          "vi": "Tôi là Linh. Hôm qua tôi đã trao đổi về chuyện đi làm về muộn. Đã có câu trả lời chưa ạ?"
        },
        {
          "id": "7a2d2daf-3ea8-5def-a8d0-58a28d76159b-u02",
          "speaker_id": "b",
          "ja": "連絡が遅れて、すみません。会社からまだ返事がありません。",
          "vi": "Xin lỗi vì báo muộn. Công ty vẫn chưa trả lời."
        },
        {
          "id": "7a2d2daf-3ea8-5def-a8d0-58a28d76159b-u03",
          "speaker_id": "a",
          "ja": "では、いつまた聞けばいいですか。",
          "vi": "Vậy khi nào tôi hỏi lại được ạ?"
        },
        {
          "id": "7a2d2daf-3ea8-5def-a8d0-58a28d76159b-u04",
          "speaker_id": "b",
          "ja": "今日の五時に、私から電話します。",
          "vi": "Năm giờ hôm nay tôi sẽ gọi cho chị."
        },
        {
          "id": "7a2d2daf-3ea8-5def-a8d0-58a28d76159b-u05",
          "speaker_id": "a",
          "ja": "五時ですね。お願いします。",
          "vi": "Năm giờ nhỉ. Nhờ anh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
