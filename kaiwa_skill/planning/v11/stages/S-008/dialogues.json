          }
        }
      }
    },
    {
      "situation_uid": "74a623bf-0cfc-53b0-b13e-2bf497561fdd",
      "event_id": "E02",
      "context_vi": "Bạn mới vào ký túc và không biết chỗ để giày cá nhân. Bạn hỏi người cùng phòng trước khi đặt lên kệ chung.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người cùng phòng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "74a623bf-0cfc-53b0-b13e-2bf497561fdd-u01",
          "speaker_id": "a",
          "ja": "私の靴は、どこに置けばいいですか。",
          "vi": "Tôi để giày của mình ở đâu?"
        },
        {
          "id": "74a623bf-0cfc-53b0-b13e-2bf497561fdd-u02",
          "speaker_id": "b",
          "ja": "この棚の下の段です。",
          "vi": "Ngăn dưới của kệ này."
        },
        {
          "id": "74a623bf-0cfc-53b0-b13e-2bf497561fdd-u03",
          "speaker_id": "a",
          "ja": "下の段ですね。助かります。",
          "vi": "Ngăn dưới nhỉ. Cảm ơn anh, vậy tiện cho tôi quá."
        }
      ],
      "admin": {
        "source_refs": [
          "home",
          "help"
        ],
        "specialty_item_ids": [
          "sj-so-02-b07-38"
        ],
        "turn_origins": {
