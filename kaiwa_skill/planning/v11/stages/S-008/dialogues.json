    {
      "situation_uid": "cec1bc49-b911-5916-96cc-87751ae90ca0",
      "event_id": "E03",
      "context_vi": "Tiếp trao đổi về ca tối: quản lý Tanaka cần hỏi công ty về cách xử lý lịch làm thường xuyên. Bạn muốn biết ai sẽ gọi lại và khi nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý Tanaka",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cec1bc49-b911-5916-96cc-87751ae90ca0-u01",
          "speaker_id": "b",
          "ja": "会社に確認します。今日はまだ答えられません。",
          "vi": "Tôi sẽ hỏi công ty. Hôm nay chưa trả lời được."
        },
        {
          "id": "cec1bc49-b911-5916-96cc-87751ae90ca0-u02",
          "speaker_id": "a",
          "ja": "わかりました。誰から、いつ連絡がありますか。",
          "vi": "Tôi hiểu. Ai sẽ báo lại và khi nào ạ?"
        },
        {
          "id": "cec1bc49-b911-5916-96cc-87751ae90ca0-u03",
          "speaker_id": "b",
          "ja": "私から、明日の昼までに連絡します。",
          "vi": "Tôi sẽ báo chị trước trưa mai."
        },
        {
          "id": "cec1bc49-b911-5916-96cc-87751ae90ca0-u04",
          "speaker_id": "a",
          "ja": "田中さんから、明日の昼までですね。",
          "vi": "Anh Tanaka báo trước trưa mai nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
