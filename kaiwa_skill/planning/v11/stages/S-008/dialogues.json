          }
        }
      }
    },
    {
      "situation_uid": "ee23aa71-f5e4-5e07-ba60-34c58433c260",
      "event_id": "E01",
      "context_vi": "Ở quầy ký túc, bạn muốn mời một người bạn tới thăm vào cuối tuần. Bạn hỏi người quản lý quy tắc của nơi này trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý ký túc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ee23aa71-f5e4-5e07-ba60-34c58433c260-u01",
          "speaker_id": "a",
          "ja": "友達が来てもいいですか。",
          "vi": "Bạn tôi đến thăm được không ạ?"
        },
        {
          "id": "ee23aa71-f5e4-5e07-ba60-34c58433c260-u02",
          "speaker_id": "b",
          "ja": "この寮では、先に受付に言ってください。",
          "vi": "Ở ký túc này, chị báo quầy trước nhé."
        },
        {
          "id": "ee23aa71-f5e4-5e07-ba60-34c58433c260-u03",
          "speaker_id": "a",
          "ja": "わかりました。来る前に言います。",
          "vi": "Tôi rõ rồi. Tôi sẽ báo trước khi bạn đến."
        }
      ],
      "admin": {
        "source_refs": [
          "home",
          "w_shared"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ee23aa71-f5e4-5e07-ba60-34c58433c260-u01": {
            "kind": "original_extension"
          },
          "ee23aa71-f5e4-5e07-ba60-34c58433c260-u02": {
            "kind": "original_extension"
          },
          "ee23aa71-f5e4-5e07-ba60-34c58433c260-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "47383413-d5aa-50d3-bc59-93720045c647",
      "event_id": "E01",
      "context_vi": "Bạn mới vào ký túc, muốn biết sẽ báo ai nếu máy lạnh trong phòng hỏng. Bạn hỏi người quản lý Tanaka trước khi có sự cố.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý Tanaka",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "47383413-d5aa-50d3-bc59-93720045c647-u01",
          "speaker_id": "a",
          "ja": "部屋のエアコンが壊れたら、誰に言いますか。",
          "vi": "Nếu máy lạnh trong phòng hỏng, tôi báo ai ạ?"
        },
        {
          "id": "47383413-d5aa-50d3-bc59-93720045c647-u02",
          "speaker_id": "b",
          "ja": "まず、私に言ってください。",
          "vi": "Trước tiên chị báo tôi nhé."
        },
        {
          "id": "47383413-d5aa-50d3-bc59-93720045c647-u03",
          "speaker_id": "a",
          "ja": "わかりました。田中さんに言います。",
          "vi": "Tôi hiểu rồi. Tôi sẽ báo anh Tanaka."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "47383413-d5aa-50d3-bc59-93720045c647-u01": {
            "kind": "original_extension"
          },
