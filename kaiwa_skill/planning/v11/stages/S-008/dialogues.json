  "dialogues": [
    {
      "situation_uid": "4abaed24-ea6b-5830-bf0c-1c4bcc901d19",
      "event_id": "E01",
      "context_vi": "Ngày đầu tại ký túc xá công ty giả định, bạn gặp người quản lý để nhận phòng. Bạn cần biết số phòng, chìa khóa và liệu có thể vào ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý ký túc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4abaed24-ea6b-5830-bf0c-1c4bcc901d19-u01",
          "speaker_id": "a",
          "ja": "私の部屋は何号室ですか。",
          "vi": "Phòng của tôi số mấy ạ?"
        },
        {
          "id": "4abaed24-ea6b-5830-bf0c-1c4bcc901d19-u02",
          "speaker_id": "b",
          "ja": "二〇五号室です。こちらが鍵です。",
          "vi": "Phòng 205. Đây là chìa khóa."
        },
        {
          "id": "4abaed24-ea6b-5830-bf0c-1c4bcc901d19-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。今、入れますか。",
          "vi": "Cảm ơn anh. Giờ tôi vào được không ạ?"
        },
        {
          "id": "4abaed24-ea6b-5830-bf0c-1c4bcc901d19-u04",
          "speaker_id": "b",
          "ja": "はい、入れます。",
          "vi": "Vâng, vào được ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "4abaed24-ea6b-5830-bf0c-1c4bcc901d19-u01": {
            "kind": "original_extension"
