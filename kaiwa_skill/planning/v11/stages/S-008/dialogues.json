    },
    {
      "situation_uid": "9087c5ae-87e1-5c60-ac8b-059f16d82c55",
      "event_id": "E02",
      "context_vi": "Bạn hỏi người quản lý phòng sinh hoạt chung còn dùng được không. Ông cho phép đến chín giờ nếu nhóm dọn sạch trước khi đóng cửa theo quy định riêng nơi này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý ký túc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9087c5ae-87e1-5c60-ac8b-059f16d82c55-u01",
          "speaker_id": "a",
          "ja": "今夜、この部屋を使ってもいいですか。",
          "vi": "Tối nay tôi dùng phòng này được không ạ?"
        },
        {
          "id": "9087c5ae-87e1-5c60-ac8b-059f16d82c55-u02",
          "speaker_id": "b",
          "ja": "はい。九時までです。使った後、きれいにしてください。",
          "vi": "Được. Đến chín giờ nhé. Dùng xong chị dọn sạch phòng."
        },
        {
          "id": "9087c5ae-87e1-5c60-ac8b-059f16d82c55-u03",
          "speaker_id": "a",
          "ja": "九時までに片づけます。",
          "vi": "Tôi sẽ dọn xong trước chín giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "home",
          "w_shared"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9087c5ae-87e1-5c60-ac8b-059f16d82c55-u01": {
