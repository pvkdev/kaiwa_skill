    {
      "situation_uid": "7e6d4a9a-0414-5465-8386-91744eab1025",
      "event_id": "E02",
      "context_vi": "Sau khi tìm thấy túi trên kệ bên cạnh bàn chung, bạn nói với người cùng phòng để thống nhất chỗ để túi lần sau.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người cùng phòng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7e6d4a9a-0414-5465-8386-91744eab1025-u01",
          "speaker_id": "a",
          "ja": "かばんは棚にありました。これからはどこに置きましょうか。",
          "vi": "Túi tôi ở trên kệ rồi. Từ giờ mình để ở đâu nhỉ?"
        },
        {
          "id": "7e6d4a9a-0414-5465-8386-91744eab1025-u02",
          "speaker_id": "b",
          "ja": "自分の部屋に置くのはどうですか。",
          "vi": "Để trong phòng riêng thì sao?"
        },
        {
          "id": "7e6d4a9a-0414-5465-8386-91744eab1025-u03",
          "speaker_id": "a",
          "ja": "そうします。教えてくれてありがとう。",
          "vi": "Tôi sẽ làm vậy. Cảm ơn anh đã nói."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
