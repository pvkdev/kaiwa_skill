            "kind": "original_extension"
          },
          "47383413-d5aa-50d3-bc59-93720045c647-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "f367b00a-5223-51e9-8320-81d72fcaf875",
      "event_id": "E01",
      "context_vi": "Tại ký túc giả định, quản lý vừa nói cửa chính khóa lúc mười giờ tối. Bạn nghe thành chín giờ và hỏi lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý ký túc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f367b00a-5223-51e9-8320-81d72fcaf875-u01",
          "speaker_id": "b",
          "ja": "この寮の入口は、夜十時に閉まります。",
          "vi": "Cửa vào ký túc này đóng lúc mười giờ tối."
        },
        {
          "id": "f367b00a-5223-51e9-8320-81d72fcaf875-u02",
          "speaker_id": "a",
          "ja": "九時ですか。",
          "vi": "Chín giờ ạ?"
        },
        {
          "id": "f367b00a-5223-51e9-8320-81d72fcaf875-u03",
          "speaker_id": "b",
          "ja": "いいえ、十時です。夜の十時。",
          "vi": "Không, mười giờ. Mười giờ tối."
        },
        {
          "id": "f367b00a-5223-51e9-8320-81d72fcaf875-u04",
          "speaker_id": "a",
          "ja": "十時ですね。",
          "vi": "Mười giờ nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f367b00a-5223-51e9-8320-81d72fcaf875-u01": {
            "kind": "original_extension"
          },
