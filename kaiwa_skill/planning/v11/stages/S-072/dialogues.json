    {
      "situation_uid": "a3fb7d8c-ac08-51d9-bec0-f9d5acfaab58",
      "event_id": "E04",
      "context_vi": "Hai bạn định đi chợ ngoài trời nhưng đã đổi sang xem một triển lãm nhỏ. Sau buổi đi, bạn nói cảm nhận và xem lần sau muốn thử việc gì.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi chơi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a3fb7d8c-ac08-51d9-bec0-f9d5acfaab58-u01",
          "speaker_id": "A",
          "ja": "最初は外の市場に行きたかったけど、展示もよかったね。",
          "vi": "Lúc đầu tớ muốn đi chợ ngoài trời, nhưng triển lãm cũng hay nhỉ."
        },
        {
          "id": "a3fb7d8c-ac08-51d9-bec0-f9d5acfaab58-u02",
          "speaker_id": "B",
          "ja": "うん。思ったより人が少なかったね。",
          "vi": "Ừ. Ít người hơn tớ nghĩ."
        },
        {
          "id": "a3fb7d8c-ac08-51d9-bec0-f9d5acfaab58-u03",
          "speaker_id": "A",
          "ja": "ゆっくり見られてよかったよ。",
          "vi": "Tớ thích vì được xem thong thả."
        },
        {
          "id": "a3fb7d8c-ac08-51d9-bec0-f9d5acfaab58-u04",
          "speaker_id": "B",
          "ja": "またこういう展示に行きたいな。",
          "vi": "Tớ muốn lại đi xem triển lãm kiểu này."
        },
        {
          "id": "a3fb7d8c-ac08-51d9-bec0-f9d5acfaab58-u05",
          "speaker_id": "A",
          "ja": "うん。晴れた日は市場にも行こう。",
          "vi": "Ừ. Hôm nào trời nắng mình cũng đi chợ nhé."
        }
      ],
