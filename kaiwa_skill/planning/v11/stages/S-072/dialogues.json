    {
      "situation_uid": "0c4e4be6-d72d-5b53-97bd-927bf2a771be",
      "event_id": "E03",
      "context_vi": "Hai bạn muốn đi nhà sách thứ Bảy nhưng bạn chưa biết có phải đi làm không. Bạn hẹn một thời điểm rõ để xác nhận.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn chưa rõ lịch",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn rủ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0c4e4be6-d72d-5b53-97bd-927bf2a771be-u01",
          "speaker_id": "B",
          "ja": "土曜に本屋へ行けそう？",
          "vi": "Thứ Bảy cậu đi hiệu sách được không?"
        },
        {
          "id": "0c4e4be6-d72d-5b53-97bd-927bf2a771be-u02",
          "speaker_id": "A",
          "ja": "まだ仕事の時間がわからないんだ。",
          "vi": "Tớ vẫn chưa biết lịch làm."
        },
        {
          "id": "0c4e4be6-d72d-5b53-97bd-927bf2a771be-u03",
          "speaker_id": "B",
          "ja": "いつわかりそう？",
          "vi": "Chừng nào cậu biết?"
        },
        {
          "id": "0c4e4be6-d72d-5b53-97bd-927bf2a771be-u04",
          "speaker_id": "A",
          "ja": "金曜にはわかるよ。夜にメッセージするね。",
          "vi": "Thứ Sáu tớ sẽ biết. Tối hôm đó tớ nhắn nhé."
        },
        {
          "id": "0c4e4be6-d72d-5b53-97bd-927bf2a771be-u05",
          "speaker_id": "B",
          "ja": "うん。金曜の夜に決めよう。",
          "vi": "Ừ. Tối thứ Sáu mình quyết định."
        }
      ],
