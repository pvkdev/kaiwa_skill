    {
      "situation_uid": "c86e404c-6c16-5cbd-99e2-1ac6efdedd59",
      "event_id": "E03",
      "context_vi": "Dự báo mưa nên hai bạn không đi bộ dọc sông được. Bạn muốn giữ hẹn trưa mai và đề nghị làm một việc trong nhà.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi chơi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c86e404c-6c16-5cbd-99e2-1ac6efdedd59-u01",
          "speaker_id": "A",
          "ja": "明日は雨みたいだから、小さい美術館に行かない？",
          "vi": "Mai có vẻ trời mưa, mình tới bảo tàng mỹ thuật nhỏ nhé?"
        },
        {
          "id": "c86e404c-6c16-5cbd-99e2-1ac6efdedd59-u02",
          "speaker_id": "B",
          "ja": "いいね。中でゆっくり見よう。",
          "vi": "Hay đấy. Mình vào trong xem thong thả."
        },
        {
          "id": "c86e404c-6c16-5cbd-99e2-1ac6efdedd59-u03",
          "speaker_id": "A",
          "ja": "時間はそのままで、明日のお昼に美術館の入口で会おう。",
          "vi": "Vậy mình giữ giờ cũ, trưa mai gặp ở cửa bảo tàng nhé."
        },
        {
          "id": "c86e404c-6c16-5cbd-99e2-1ac6efdedd59-u04",
          "speaker_id": "B",
          "ja": "うん、美術館の入口ね。",
          "vi": "Ừ, lối vào bảo tàng nhé."
        }
      ],
