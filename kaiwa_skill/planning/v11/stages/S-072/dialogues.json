    {
      "situation_uid": "3614ec25-937e-51cd-a562-36b0941cf46d",
      "event_id": "E04",
      "context_vi": "Bạn muốn dời cuộc gặp hai giờ chiều từ công viên vào quán cà phê. Bạn mình tưởng bạn hủy cả buổi và bạn muốn giải thích chỉ đổi chỗ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đổi kế hoạch",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3614ec25-937e-51cd-a562-36b0941cf46d-u01",
          "speaker_id": "B",
          "ja": "今日は会わないってこと？",
          "vi": "Vậy hôm nay mình không gặp à?"
        },
        {
          "id": "3614ec25-937e-51cd-a562-36b0941cf46d-u02",
          "speaker_id": "A",
          "ja": "会うよ。場所だけ変えたいんだ。",
          "vi": "Có gặp chứ. Tớ chỉ muốn đổi chỗ thôi."
        },
        {
          "id": "3614ec25-937e-51cd-a562-36b0941cf46d-u03",
          "speaker_id": "B",
          "ja": "じゃ、二時は同じ？",
          "vi": "Vậy vẫn hai giờ phải không?"
        },
        {
          "id": "3614ec25-937e-51cd-a562-36b0941cf46d-u04",
          "speaker_id": "A",
          "ja": "うん。二時に公園の向かいのカフェで会おう。",
          "vi": "Ừ. Hai giờ mình gặp ở quán cà phê đối diện công viên nhé."
        }
      ],
      "admin": {
