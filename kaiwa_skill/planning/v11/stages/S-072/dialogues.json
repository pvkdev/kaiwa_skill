    {
      "situation_uid": "ea8aed4a-99d3-5e63-b632-8969c08d9d3b",
      "event_id": "E03",
      "context_vi": "Bạn muốn thử một lớp làm đồ gốm. Bạn kể cho bạn mình lý do muốn tham gia và món đồ đầu tiên muốn làm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn muốn học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ea8aed4a-99d3-5e63-b632-8969c08d9d3b-u01",
          "speaker_id": "A",
          "ja": "陶芸の教室に行ってみたいな。",
          "vi": "Tớ muốn thử học một lớp làm gốm."
        },
        {
          "id": "ea8aed4a-99d3-5e63-b632-8969c08d9d3b-u02",
          "speaker_id": "B",
          "ja": "どうして陶芸なの？",
          "vi": "Sao cậu chọn làm gốm?"
        },
        {
          "id": "ea8aed4a-99d3-5e63-b632-8969c08d9d3b-u03",
          "speaker_id": "A",
          "ja": "自分でコップを作ってみたいんだ。",
          "vi": "Tớ muốn thử tự làm một chiếc cốc."
        },
        {
          "id": "ea8aed4a-99d3-5e63-b632-8969c08d9d3b-u04",
          "speaker_id": "B",
          "ja": "初めての人のクラスを探してるの？",
          "vi": "Cậu đang tìm lớp cho người mới à?"
        },
        {
          "id": "ea8aed4a-99d3-5e63-b632-8969c08d9d3b-u05",
          "speaker_id": "A",
          "ja": "うん。一回だけのクラスがあるよ。",
          "vi": "Ừ. Có lớp chỉ học một buổi."
        }
      ],
