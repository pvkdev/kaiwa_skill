    {
      "situation_uid": "8212f4a0-d4f2-5fe1-98c5-efe8cd66c298",
      "event_id": "E01",
      "context_vi": "Bạn và bạn mình vừa vào một quán nhiều tiếng ồn. Bạn hỏi người kia ngồi ở bàn này có thấy thoải mái hay muốn tìm chỗ yên hơn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi cùng",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn chọn chỗ ngồi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8212f4a0-d4f2-5fe1-98c5-efe8cd66c298-u01",
          "speaker_id": "A",
          "ja": "ここ、落ち着けそう？",
          "vi": "Chỗ này cậu thấy ngồi thoải mái không?"
        },
        {
          "id": "8212f4a0-d4f2-5fe1-98c5-efe8cd66c298-u02",
          "speaker_id": "B",
          "ja": "少しうるさいかも。",
          "vi": "Có lẽ hơi ồn."
        },
        {
          "id": "8212f4a0-d4f2-5fe1-98c5-efe8cd66c298-u03",
          "speaker_id": "A",
          "ja": "じゃ、奥の席にしようか。",
          "vi": "Vậy mình ngồi ở bàn phía trong nhé?"
        },
        {
          "id": "8212f4a0-d4f2-5fe1-98c5-efe8cd66c298-u04",
          "speaker_id": "B",
          "ja": "うん。奥のほうが落ち着けそう。",
          "vi": "Ừ. Bàn trong có vẻ dễ chịu hơn."
        }
      ],
      "admin": {
        "source_refs": [
          "calm"
        ],
        "specialty_item_ids": [
          "sj-so-16-b24-65"
        ],
        "turn_origins": {
