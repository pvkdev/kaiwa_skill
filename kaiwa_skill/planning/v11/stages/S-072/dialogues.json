    {
      "situation_uid": "e4e8b601-f7c3-5d45-8394-4db314f9ff7c",
      "event_id": "E02",
      "context_vi": "Bạn muốn ngồi ngoài trời để ngắm cây trong công viên. Bạn đi cùng muốn tránh nắng, nên bạn cùng tìm một nơi có thể đáp ứng cả hai.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi chơi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e4e8b601-f7c3-5d45-8394-4db314f9ff7c-u01",
          "speaker_id": "A",
          "ja": "木が見えるところで座りたいな。",
          "vi": "Tớ muốn ngồi chỗ nhìn thấy cây."
        },
        {
          "id": "e4e8b601-f7c3-5d45-8394-4db314f9ff7c-u02",
          "speaker_id": "B",
          "ja": "私は中に入りたいな。日差しが強いから。",
          "vi": "Tớ muốn vào trong. Nắng gắt quá."
        },
        {
          "id": "e4e8b601-f7c3-5d45-8394-4db314f9ff7c-u03",
          "speaker_id": "A",
          "ja": "じゃ、公園が見えるカフェならどう？",
          "vi": "Vậy quán cà phê nhìn ra công viên thì sao?"
        },
        {
          "id": "e4e8b601-f7c3-5d45-8394-4db314f9ff7c-u04",
          "speaker_id": "B",
          "ja": "それならよさそう。",
          "vi": "Thế thì có vẻ được."
        }
      ],
