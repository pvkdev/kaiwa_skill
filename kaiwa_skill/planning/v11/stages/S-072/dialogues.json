    {
      "situation_uid": "323ccf01-eb06-5cf4-b297-34da90836a87",
      "event_id": "E01",
      "context_vi": "Bạn ít nói khi đang dọn đồ cùng bạn mình. Người kia tưởng bạn đang bực, nên bạn nói rõ mình chỉ mệt vì tối qua ngủ ít.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đang mệt",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng dọn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "323ccf01-eb06-5cf4-b297-34da90836a87-u01",
          "speaker_id": "B",
          "ja": "あまり話さないね。何か怒ってる？",
          "vi": "Cậu ít nói vậy. Có chuyện gì làm cậu giận à?"
        },
        {
          "id": "323ccf01-eb06-5cf4-b297-34da90836a87-u02",
          "speaker_id": "A",
          "ja": "怒ってないよ。ちょっと疲れてるだけ。",
          "vi": "Tớ không giận đâu. Chỉ hơi mệt thôi."
        },
        {
          "id": "323ccf01-eb06-5cf4-b297-34da90836a87-u03",
          "speaker_id": "B",
          "ja": "あ、そっか。",
          "vi": "À, ra vậy."
        },
        {
          "id": "323ccf01-eb06-5cf4-b297-34da90836a87-u04",
          "speaker_id": "A",
          "ja": "きのう、あまり寝られなかったんだ。",
          "vi": "Tối qua tớ không ngủ được nhiều."
        }
      ],
      "admin": {
        "source_refs": [
          "relief"
        ],
        "specialty_item_ids": [],
