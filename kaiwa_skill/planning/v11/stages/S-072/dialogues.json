    {
      "situation_uid": "0b9c8b86-f0d9-522e-95c5-ca78bc0495fd",
      "event_id": "E03",
      "context_vi": "Bạn muốn cuối tuần ghé thư viện tìm sách dễ đọc bằng tiếng Nhật. Bạn nói rõ dự định với bạn mình và nghe một gợi ý.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn dự định",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0b9c8b86-f0d9-522e-95c5-ca78bc0495fd-u01",
          "speaker_id": "A",
          "ja": "日曜に図書館へ行くつもりだよ。",
          "vi": "Chủ nhật tớ định đi thư viện."
        },
        {
          "id": "0b9c8b86-f0d9-522e-95c5-ca78bc0495fd-u02",
          "speaker_id": "B",
          "ja": "何か探してるの？",
          "vi": "Cậu đang tìm gì à?"
        },
        {
          "id": "0b9c8b86-f0d9-522e-95c5-ca78bc0495fd-u03",
          "speaker_id": "A",
          "ja": "やさしい日本語の本を借りたいんだ。",
          "vi": "Tớ muốn mượn sách tiếng Nhật dễ đọc."
        },
        {
          "id": "0b9c8b86-f0d9-522e-95c5-ca78bc0495fd-u04",
          "speaker_id": "B",
          "ja": "前に二階で見たよ。行ってみて。",
          "vi": "Hôm trước tớ thấy ở tầng hai. Cậu qua xem thử."
        }
      ],
