        }
      }
    },
    {
      "situation_uid": "f580fe2a-d4a0-5946-8bfc-421b4ef13c7f",
      "event_id": "E02",
      "context_vi": "Sau khi đi bộ một lúc, bạn thấy có ghế trống và hỏi bạn đi cùng muốn nghỉ hay muốn đi tiếp.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi bộ",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f580fe2a-d4a0-5946-8bfc-421b4ef13c7f-u01",
          "speaker_id": "A",
          "ja": "少し休みたい？ それとも、もう少し歩く？",
          "vi": "Cậu muốn nghỉ một chút hay đi tiếp?"
        },
        {
          "id": "f580fe2a-d4a0-5946-8bfc-421b4ef13c7f-u02",
          "speaker_id": "B",
          "ja": "少し座りたいな。",
          "vi": "Tớ muốn ngồi một chút."
        },
        {
          "id": "f580fe2a-d4a0-5946-8bfc-421b4ef13c7f-u03",
          "speaker_id": "A",
          "ja": "あのベンチで五分ぐらい休もうか。",
          "vi": "Mình nghỉ chừng năm phút ở ghế kia nhé?"
        },
        {
          "id": "f580fe2a-d4a0-5946-8bfc-421b4ef13c7f-u04",
          "speaker_id": "B",
          "ja": "うん、そうしよう。",
          "vi": "Ừ, vậy nhé."
        }
      ],
      "admin": {
