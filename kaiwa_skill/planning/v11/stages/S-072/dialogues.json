    {
      "situation_uid": "d386b686-3447-50ab-bff1-3f4aa2c66be0",
      "event_id": "E02",
      "context_vi": "Bạn và bạn mình đã nghĩ đến quán cà phê nhìn ra công viên để tránh nắng nhưng vẫn thấy cây. Vào quán rồi, hai bạn chọn chỗ ngồi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi chơi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d386b686-3447-50ab-bff1-3f4aa2c66be0-u01",
          "speaker_id": "A",
          "ja": "中の窓側に座るのはどう？",
          "vi": "Mình ngồi bàn sát cửa sổ trong quán nhé?"
        },
        {
          "id": "d386b686-3447-50ab-bff1-3f4aa2c66be0-u02",
          "speaker_id": "B",
          "ja": "あそこなら日が当たらないね。",
          "vi": "Chỗ đó không bị nắng chiếu nhỉ."
        },
        {
          "id": "d386b686-3447-50ab-bff1-3f4aa2c66be0-u03",
          "speaker_id": "A",
          "ja": "うん。木もよく見えるよ。",
          "vi": "Ừ. Cũng nhìn rõ cây nữa."
        },
        {
          "id": "d386b686-3447-50ab-bff1-3f4aa2c66be0-u04",
          "speaker_id": "B",
          "ja": "じゃ、あの席にしよう。",
          "vi": "Vậy mình ngồi bàn đó nhé."
        }
      ],
      "admin": {
