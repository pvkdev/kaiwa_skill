    {
      "situation_uid": "fdfba088-3ff6-530f-8eed-107646b632a7",
      "event_id": "E04",
      "context_vi": "Hai bạn đã đổi từ đi chợ đồ cũ sang xem triển lãm gần ga. Bạn nhắc lại sẽ gặp lúc ba giờ và rời lúc bốn giờ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi chơi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fdfba088-3ff6-530f-8eed-107646b632a7-u01",
          "speaker_id": "A",
          "ja": "じゃ、午後三時にギャラリーの入口だね。",
          "vi": "Vậy ba giờ ở cửa phòng triển lãm nhé."
        },
        {
          "id": "fdfba088-3ff6-530f-8eed-107646b632a7-u02",
          "speaker_id": "B",
          "ja": "うん。四時には出るんだよね。",
          "vi": "Ừ. Bốn giờ mình rời đi đúng không?"
        },
        {
          "id": "fdfba088-3ff6-530f-8eed-107646b632a7-u03",
          "speaker_id": "A",
          "ja": "そう。午後四時までには見終わって、外に出よう。",
          "vi": "Đúng rồi. Mình xem rồi ra chậm nhất lúc bốn giờ."
        },
        {
          "id": "fdfba088-3ff6-530f-8eed-107646b632a7-u04",
          "speaker_id": "B",
          "ja": "わかった。入口で待ってるね。",
          "vi": "Ừ, tớ đợi ở cửa nhé."
        }
      ],
