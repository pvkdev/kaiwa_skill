      "situation_uid": "9a6883d6-d42e-508d-9674-567998b0f615",
      "event_id": "E04",
      "context_vi": "Bạn nói sẽ tới buổi tập thử bóng bàn có các trận đấu. Nghe một người bạn nói có buổi dành cho người mới trước đó, bạn báo mình đổi ý sang buổi này.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đổi ý",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9a6883d6-d42e-508d-9674-567998b0f615-u01",
          "speaker_id": "A",
          "ja": "予定、ちょっと変えたよ。初心者の回に行く。",
          "vi": "Tớ đổi kế hoạch một chút. Tớ đi buổi cho người mới."
        },
        {
          "id": "9a6883d6-d42e-508d-9674-567998b0f615-u02",
          "speaker_id": "B",
          "ja": "試合のある回に行くって言ってたよね。",
          "vi": "Cậu nói định đi buổi có thi đấu mà."
        },
        {
          "id": "9a6883d6-d42e-508d-9674-567998b0f615-u03",
          "speaker_id": "A",
          "ja": "うん。でも、初心者の回なら打ち方を教えてくれるって聞いたんだ。",
          "vi": "Ừ. Nhưng tớ nghe nói buổi cho người mới sẽ có người chỉ cách đánh."
        },
        {
          "id": "9a6883d6-d42e-508d-9674-567998b0f615-u04",
          "speaker_id": "B",
          "ja": "そっか。それなら安心だね。",
          "vi": "Ra vậy. Thế thì yên tâm hơn nhỉ."
        }
      ],
