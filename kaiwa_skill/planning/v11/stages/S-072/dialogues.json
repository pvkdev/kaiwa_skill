      }
    },
    {
      "situation_uid": "95325181-80c2-5e39-8f69-037ad73e27d0",
      "event_id": "E01",
      "context_vi": "Ngày mai là buổi đầu của bạn ở nơi làm việc mới. Bạn nói với bạn mình mình lo vì chưa biết phòng làm việc ở đâu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn sắp đi làm",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "95325181-80c2-5e39-8f69-037ad73e27d0-u01",
          "speaker_id": "A",
          "ja": "明日から新しい職場なんだ。ちょっと不安。",
          "vi": "Ngày mai tớ bắt đầu ở chỗ làm mới. Tớ hơi lo."
        },
        {
          "id": "95325181-80c2-5e39-8f69-037ad73e27d0-u02",
          "speaker_id": "B",
          "ja": "何が心配なの？",
          "vi": "Cậu lo chuyện gì?"
        },
        {
          "id": "95325181-80c2-5e39-8f69-037ad73e27d0-u03",
          "speaker_id": "A",
          "ja": "仕事をする部屋がどこか、まだわからないんだ。",
          "vi": "Tớ vẫn chưa biết phòng làm việc của mình ở đâu."
        },
        {
          "id": "95325181-80c2-5e39-8f69-037ad73e27d0-u04",
          "speaker_id": "B",
          "ja": "着いたら、まず受付で聞いてみたら？",
          "vi": "Đến nơi cậu hỏi ở quầy lễ tân trước xem?"
        },
        {
          "id": "95325181-80c2-5e39-8f69-037ad73e27d0-u05",
          "speaker_id": "A",
          "ja": "そうする。少し安心したよ。",
          "vi": "Tớ sẽ hỏi. Giờ tớ yên tâm hơn chút rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "calm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "95325181-80c2-5e39-8f69-037ad73e27d0-u01": {
