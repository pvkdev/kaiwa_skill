    {
      "situation_uid": "9b5a7995-2fa8-500f-b474-361ac6290f81",
      "event_id": "E02",
      "context_vi": "Bạn muốn đưa nhóm đi ăn mì ramen. Bạn cùng nhóm nhắc có người không ăn thịt. Bạn tôn trọng nhu cầu đó và chọn quán có nhiều lựa chọn hơn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn trong nhóm",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn trong nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9b5a7995-2fa8-500f-b474-361ac6290f81-u01",
          "speaker_id": "A",
          "ja": "駅前のラーメン屋に行きたいな。",
          "vi": "Tớ muốn đến quán ramen trước ga."
        },
        {
          "id": "9b5a7995-2fa8-500f-b474-361ac6290f81-u02",
          "speaker_id": "B",
          "ja": "今日は肉を食べない人もいるよ。",
          "vi": "Hôm nay có người không ăn thịt nữa đấy."
        },
        {
          "id": "9b5a7995-2fa8-500f-b474-361ac6290f81-u03",
          "speaker_id": "A",
          "ja": "そっか。じゃ、野菜の料理がある店にしようか。",
          "vi": "Vậy à. Thế mình chọn quán có món rau nhé?"
        },
        {
          "id": "9b5a7995-2fa8-500f-b474-361ac6290f81-u04",
          "speaker_id": "B",
          "ja": "角の店なら、肉が入っていないセットもあるよ。",
          "vi": "Quán ở góc đường có cả suất không có thịt."
        },
        {
          "id": "9b5a7995-2fa8-500f-b474-361ac6290f81-u05",
          "speaker_id": "A",
          "ja": "じゃ、みんなで角の店に行こう。注文するときに、肉が入っていないか聞こう。",
          "vi": "Vậy cả nhóm mình tới quán ở góc đường nhé. Lúc gọi món mình hỏi lại xem có thịt không."
        }
      ],
