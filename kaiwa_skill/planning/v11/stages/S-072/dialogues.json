    {
      "situation_uid": "0aa6a7e3-19d1-5ec8-b8c3-7c8a4521fe88",
      "event_id": "E01",
      "context_vi": "Bạn vừa giải thích mình chỉ mệt vì ngủ ít. Bạn mình hiểu rồi và đề nghị cùng hoàn thành việc dọn đồ. Bạn chọn phần nhẹ hơn để vẫn giúp được.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đang mệt",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng dọn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0aa6a7e3-19d1-5ec8-b8c3-7c8a4521fe88-u01",
          "speaker_id": "B",
          "ja": "そうだったんだね。怒ってると思ってごめん。",
          "vi": "Ra vậy. Xin lỗi vì tớ tưởng cậu giận."
        },
        {
          "id": "0aa6a7e3-19d1-5ec8-b8c3-7c8a4521fe88-u02",
          "speaker_id": "A",
          "ja": "ううん。話せて少しすっきりしたよ。",
          "vi": "Không sao. Nói ra được, tớ thấy nhẹ lòng hơn chút."
        },
        {
          "id": "0aa6a7e3-19d1-5ec8-b8c3-7c8a4521fe88-u03",
          "speaker_id": "A",
          "ja": "じゃ、私はタオルをたたむね。",
          "vi": "Vậy để tớ gấp khăn nhé."
        },
        {
          "id": "0aa6a7e3-19d1-5ec8-b8c3-7c8a4521fe88-u04",
          "speaker_id": "B",
          "ja": "ありがとう。重い箱は私が運ぶよ。",
          "vi": "Cảm ơn cậu. Các thùng nặng để tớ chuyển."
        }
      ],
      "admin": {
        "source_refs": [
          "relief"
        ],
        "specialty_item_ids": [
          "sj-so-16-b24-66"
        ],
        "turn_origins": {
