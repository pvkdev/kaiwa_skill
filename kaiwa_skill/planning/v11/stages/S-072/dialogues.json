    {
      "situation_uid": "36821315-a77e-59e1-82ee-a4480c03d07b",
      "event_id": "E03",
      "context_vi": "Bạn và bạn mình định đi bộ dọc sông trưa mai. Bạn vừa xem dự báo nói trời mưa và muốn nói rằng phần đi ngoài trời khó thực hiện.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn xem dự báo",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "36821315-a77e-59e1-82ee-a4480c03d07b-u01",
          "speaker_id": "A",
          "ja": "天気予報を見たら、明日のお昼は雨だって。",
          "vi": "Tớ xem dự báo thấy họ nói trưa mai có mưa."
        },
        {
          "id": "36821315-a77e-59e1-82ee-a4480c03d07b-u02",
          "speaker_id": "B",
          "ja": "じゃ、川のそばを歩くのは難しいかな。",
          "vi": "Vậy chắc khó đi bộ dọc sông nhỉ."
        },
        {
          "id": "36821315-a77e-59e1-82ee-a4480c03d07b-u03",
          "speaker_id": "A",
          "ja": "うん。外はちょっと無理そう。",
          "vi": "Ừ. Đi ngoài trời chắc không được rồi."
        },
        {
          "id": "36821315-a77e-59e1-82ee-a4480c03d07b-u04",
          "speaker_id": "B",
          "ja": "じゃ、会う時間はそのままで、何か別のことにしようか。",
          "vi": "Vậy giữ nguyên giờ gặp, mình làm việc khác nhé?"
        }
      ],
