    {
      "situation_uid": "f8f0efc8-1110-5485-b8c9-5a576beef7cc",
      "event_id": "E04",
      "context_vi": "Bạn định ra chợ đồ cũ với bạn mình, nhưng giờ chỉ rảnh tới bốn giờ chiều. Bạn đề nghị qua một phòng triển lãm nhỏ gần ga.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đề nghị",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f8f0efc8-1110-5485-b8c9-5a576beef7cc-u01",
          "speaker_id": "A",
          "ja": "今日は午後四時までしかいられないんだ。",
          "vi": "Hôm nay tớ chỉ ở được tới bốn giờ chiều thôi."
        },
        {
          "id": "f8f0efc8-1110-5485-b8c9-5a576beef7cc-u02",
          "speaker_id": "A",
          "ja": "駅の近くの小さいギャラリーなら、短い時間で見られるよ。",
          "vi": "Phòng triển lãm nhỏ gần ga thì xem nhanh được."
        },
        {
          "id": "f8f0efc8-1110-5485-b8c9-5a576beef7cc-u03",
          "speaker_id": "B",
          "ja": "そこにしよう。午後三時からで間に合う？",
          "vi": "Vậy mình tới đó nhé. Bắt đầu lúc ba giờ có kịp không?"
        },
        {
          "id": "f8f0efc8-1110-5485-b8c9-5a576beef7cc-u04",
          "speaker_id": "A",
          "ja": "うん、三時なら大丈夫。",
          "vi": "Ừ, ba giờ thì kịp."
        }
      ],
      "admin": {
