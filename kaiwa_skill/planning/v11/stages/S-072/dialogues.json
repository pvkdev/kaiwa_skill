  "dialogues": [
    {
      "situation_uid": "71b68bf4-9e22-583d-bc8c-0592cf58412c",
      "event_id": "E01",
      "context_vi": "Bạn gặp lại người bạn đã lâu không gặp ở ga. Bạn muốn bày tỏ mình vui và hỏi có thể ngồi nói chuyện một lúc không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn gặp lại",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cũ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "71b68bf4-9e22-583d-bc8c-0592cf58412c-u01",
          "speaker_id": "A",
          "ja": "久しぶり！",
          "vi": "Lâu quá mới gặp!"
        },
        {
          "id": "71b68bf4-9e22-583d-bc8c-0592cf58412c-u02",
          "speaker_id": "A",
          "ja": "また会えてうれしいよ。",
          "vi": "Gặp lại cậu tớ vui lắm."
        },
        {
          "id": "71b68bf4-9e22-583d-bc8c-0592cf58412c-u03",
          "speaker_id": "B",
          "ja": "私も。前に会ったのは春だったね。",
          "vi": "Tớ cũng vậy. Lần trước mình gặp hồi mùa xuân nhỉ."
        },
        {
          "id": "71b68bf4-9e22-583d-bc8c-0592cf58412c-u04",
          "speaker_id": "A",
          "ja": "うん。時間があったら、少し話さない？",
          "vi": "Ừ. Nếu cậu có thời gian, mình nói chuyện một chút nhé?"
        },
        {
          "id": "71b68bf4-9e22-583d-bc8c-0592cf58412c-u05",
          "speaker_id": "B",
          "ja": "いいね。あそこのベンチに座ろう。",
          "vi": "Được đấy. Mình ngồi ở ghế băng đằng kia nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "calm"
        ],
        "specialty_item_ids": [],
