    {
      "situation_uid": "1fcdd572-d76c-58b4-b2b7-7e1dcd97a4ea",
      "event_id": "E02",
      "context_vi": "Hai bạn tới giờ ăn trưa. Hôm nay bạn chỉ muốn ăn nhẹ và hỏi bạn mình có muốn gọi súp với bánh mì không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi ăn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1fcdd572-d76c-58b4-b2b7-7e1dcd97a4ea-u01",
          "speaker_id": "A",
          "ja": "今日は軽いものが食べたいな。",
          "vi": "Hôm nay tớ muốn ăn nhẹ thôi."
        },
        {
          "id": "1fcdd572-d76c-58b4-b2b7-7e1dcd97a4ea-u02",
          "speaker_id": "B",
          "ja": "どんなものがいい？",
          "vi": "Cậu muốn ăn gì?"
        },
        {
          "id": "1fcdd572-d76c-58b4-b2b7-7e1dcd97a4ea-u03",
          "speaker_id": "A",
          "ja": "スープはどう？",
          "vi": "Súp thì sao?"
        },
        {
          "id": "1fcdd572-d76c-58b4-b2b7-7e1dcd97a4ea-u04",
          "speaker_id": "B",
          "ja": "いいね。パンとスープにしよう。",
          "vi": "Hay đấy. Mình gọi bánh mì với súp nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "wish"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1fcdd572-d76c-58b4-b2b7-7e1dcd97a4ea-u01": {
