    {
      "situation_uid": "b26d90f6-6d98-508f-ad04-9cf7fc241f19",
      "event_id": "E04",
      "context_vi": "Bạn vừa mua đậu phụ ở Hoshi, về nhà mở ra thấy mùi khác thường. Bạn gọi báo tình trạng, không ăn hay kết luận nguyên nhân.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b26d90f6-6d98-508f-ad04-9cf7fc241f19-u01",
          "speaker_id": "a",
          "ja": "さっき買った豆腐を開けたら、変なにおいがしました。",
          "vi": "Đậu phụ tôi vừa mua, mở ra thấy mùi lạ ạ."
        },
        {
          "id": "b26d90f6-6d98-508f-ad04-9cf7fc241f19-u02",
          "speaker_id": "b",
          "ja": "いつ買われましたか。",
          "vi": "Anh mua lúc nào ạ?"
        },
        {
          "id": "b26d90f6-6d98-508f-ad04-9cf7fc241f19-u03",
          "speaker_id": "a",
          "ja": "今日の夕方です。まだ食べていません。",
          "vi": "Chiều nay ạ. Tôi chưa ăn."
        },
        {
          "id": "b26d90f6-6d98-508f-ad04-9cf7fc241f19-u04",
          "speaker_id": "b",
          "ja": "状況を確認します。商品とレシートはありますか。",
          "vi": "Tôi sẽ kiểm tra tình trạng. Anh còn sản phẩm và hóa đơn không ạ?"
