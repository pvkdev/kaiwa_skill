    {
      "situation_uid": "13e0838b-73c9-5c89-9ff2-dc77408cdf05",
      "event_id": "E03",
      "context_vi": "Tại quầy thanh toán Hoshi, bạn đặt thịt sống cùng bánh mì và muốn tách chúng khi đóng túi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "13e0838b-73c9-5c89-9ff2-dc77408cdf05-u01",
          "speaker_id": "a",
          "ja": "すみません。生の肉はパンと別にしてください。",
          "vi": "Xin lỗi, xin để thịt sống riêng với bánh mì ạ."
        },
        {
          "id": "13e0838b-73c9-5c89-9ff2-dc77408cdf05-u02",
          "speaker_id": "b",
          "ja": "はい、別の袋に入れます。",
          "vi": "Vâng, tôi cho vào túi riêng."
        },
        {
          "id": "13e0838b-73c9-5c89-9ff2-dc77408cdf05-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn chị."
        }
      ],
