            "kind": "original_extension"
          },
          "4402911c-8e81-5e35-8b81-35634079b42c-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "39354d84-563f-598a-94aa-56650aae2990",
      "event_id": "E02",
      "context_vi": "Sau cuộc trao đổi trước ở Hoshi, hai gói giá 400 yên, còn giá một gói chưa rõ. Nhân viên kiểm nhãn riêng; các giá là ví dụ hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "39354d84-563f-598a-94aa-56650aae2990-u01",
          "speaker_id": "b",
          "ja": "一袋は二百五十円です。二袋なら合わせて四百円です。",
          "vi": "Một gói 250 yên. Hai gói tổng cộng 400 yên ạ."
        },
        {
          "id": "39354d84-563f-598a-94aa-56650aae2990-u02",
          "speaker_id": "a",
          "ja": "わかりました。今日は一袋だけにします。",
          "vi": "Tôi hiểu rồi. Hôm nay tôi chỉ lấy một gói."
        },
        {
          "id": "39354d84-563f-598a-94aa-56650aae2990-u03",
          "speaker_id": "b",
          "ja": "一袋ですね。",
          "vi": "Một gói nhé ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "market_shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "39354d84-563f-598a-94aa-56650aae2990-u01": {
