  "dialogues": [
    {
      "situation_uid": "929b3436-11bd-592b-80db-c2f1844b266d",
      "event_id": "E01",
      "context_vi": "Ở siêu thị hư cấu Hoshi, bạn muốn nấu súp tối nay nhưng không biết tên loại rau dài màu trắng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên siêu thị",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "929b3436-11bd-592b-80db-c2f1844b266d-u01",
          "speaker_id": "a",
          "ja": "すみません、スープに入れる白くて長い野菜はどこですか。",
          "vi": "Xin lỗi, loại rau trắng dài để nấu súp ở đâu ạ?"
        },
        {
          "id": "929b3436-11bd-592b-80db-c2f1844b266d-u02",
          "speaker_id": "b",
          "ja": "ねぎのことですか。野菜売り場の右側です。",
          "vi": "Anh nói hành dài Nhật (negi) phải không ạ? Ở bên phải khu rau."
        },
        {
          "id": "929b3436-11bd-592b-80db-c2f1844b266d-u03",
          "speaker_id": "a",
          "ja": "はい、ねぎです。右側ですね。",
          "vi": "Vâng, hành negi. Bên phải nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "market_shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "929b3436-11bd-592b-80db-c2f1844b266d-u01": {
            "kind": "original_extension"
          },
          "929b3436-11bd-592b-80db-c2f1844b266d-u02": {
            "kind": "original_extension"
          },
          "929b3436-11bd-592b-80db-c2f1844b266d-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "ebbf8551-31d4-5277-a42b-aa8e490a2977",
      "event_id": "E01",
      "context_vi": "Ở Hoshi, bạn nấu cho hai người và muốn hỏi lượng thịt phù hợp; đây chỉ là gợi ý của nhân viên trong cảnh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên siêu thị",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "ebbf8551-31d4-5277-a42b-aa8e490a2977-u01",
          "speaker_id": "a",
          "ja": "二人分のカレーに、肉はどれくらい買えばいいですか。",
          "vi": "Cà ri cho hai người thì nên mua bao nhiêu thịt ạ?"
        },
        {
          "id": "ebbf8551-31d4-5277-a42b-aa8e490a2977-u02",
          "speaker_id": "b",
          "ja": "この小さいパックは二百グラムです。こちらはいかがですか。",
          "vi": "Gói nhỏ này 200 gram. Anh thấy gói này thế nào?"
        },
        {
          "id": "ebbf8551-31d4-5277-a42b-aa8e490a2977-u03",
          "speaker_id": "a",
          "ja": "そのパックにします。",
          "vi": "Tôi lấy gói đó ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "market_shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ebbf8551-31d4-5277-a42b-aa8e490a2977-u01": {
            "kind": "original_extension"
          },
          "ebbf8551-31d4-5277-a42b-aa8e490a2977-u02": {
            "kind": "original_extension"
          },
          "ebbf8551-31d4-5277-a42b-aa8e490a2977-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d6b1d4da-5e64-5c5d-94be-917124e62a77",
      "event_id": "E01",
      "context_vi": "Tại Hoshi, bạn cần tránh trứng trong món salad đóng gói. Bạn hỏi để tự kiểm đúng nhãn, không nhờ nhân viên bảo đảm an toàn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên siêu thị",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d6b1d4da-5e64-5c5d-94be-917124e62a77-u01",
          "speaker_id": "a",
          "ja": "卵を避けたいです。このサラダの表示はどこですか。",
          "vi": "Tôi cần tránh trứng. Nhãn thành phần của salad này ở đâu ạ?"
        },
        {
          "id": "d6b1d4da-5e64-5c5d-94be-917124e62a77-u02",
          "speaker_id": "b",
          "ja": "裏の原材料のところです。一緒に確認しましょう。",
          "vi": "Ở mặt sau, phần nguyên liệu ạ. Mình cùng xem nhé."
        },
        {
          "id": "d6b1d4da-5e64-5c5d-94be-917124e62a77-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。卵の表示を見ます。",
          "vi": "Cảm ơn chị. Tôi sẽ xem chỗ ghi trứng."
        }
      ],
      "admin": {
        "source_refs": [
          "caa_allergy"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d6b1d4da-5e64-5c5d-94be-917124e62a77-u01": {
            "kind": "original_extension"
          },
          "d6b1d4da-5e64-5c5d-94be-917124e62a77-u02": {
            "kind": "original_extension"
          },
          "d6b1d4da-5e64-5c5d-94be-917124e62a77-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "abdf9419-01b8-57b3-ac34-b4dae48a1f58",
      "event_id": "E01",
      "context_vi": "Ở Hoshi, cá hồi bạn định nấu tối nay đã hết. Bạn muốn tìm một loại cá khác đang bán tại đây.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên siêu thị",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "abdf9419-01b8-57b3-ac34-b4dae48a1f58-u01",
          "speaker_id": "a",
          "ja": "鮭はもうありませんか。",
          "vi": "Cá hồi hết rồi ạ?"
        },
        {
          "id": "abdf9419-01b8-57b3-ac34-b4dae48a1f58-u02",
          "speaker_id": "b",
          "ja": "今日は売り切れです。さばならあります。",
          "vi": "Hôm nay hết rồi. Cá thu thì còn ạ."
        },
        {
          "id": "abdf9419-01b8-57b3-ac34-b4dae48a1f58-u03",
          "speaker_id": "a",
          "ja": "さばはどこにありますか。",
          "vi": "Cá thu ở đâu ạ?"
        },
        {
          "id": "abdf9419-01b8-57b3-ac34-b4dae48a1f58-u04",
          "speaker_id": "b",
          "ja": "魚売り場の手前です。",
          "vi": "Ở phía trước quầy cá ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "market_shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "abdf9419-01b8-57b3-ac34-b4dae48a1f58-u01": {
            "kind": "original_extension"
          },
          "abdf9419-01b8-57b3-ac34-b4dae48a1f58-u02": {
            "kind": "original_extension"
          },
