        }
      }
    },
    {
      "situation_uid": "4402911c-8e81-5e35-8b81-35634079b42c",
      "event_id": "E02",
      "context_vi": "Ở Hoshi hư cấu, nhãn kệ ghi 'mua hai gói 400 yên'. Bạn tưởng một gói cũng có giá 400 yên; giá chỉ là ví dụ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4402911c-8e81-5e35-8b81-35634079b42c-u01",
          "speaker_id": "a",
          "ja": "この一袋が四百円ですか。",
          "vi": "Một gói này giá 400 yên ạ?"
        },
        {
          "id": "4402911c-8e81-5e35-8b81-35634079b42c-u02",
          "speaker_id": "b",
          "ja": "いえ、四百円は二袋買うときの値段です。",
          "vi": "Không ạ, 400 yên là giá khi mua hai gói."
        },
        {
          "id": "4402911c-8e81-5e35-8b81-35634079b42c-u03",
          "speaker_id": "a",
          "ja": "一袋の値段も知りたいです。",
          "vi": "Tôi muốn biết giá một gói nữa ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "market_shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "4402911c-8e81-5e35-8b81-35634079b42c-u01": {
            "kind": "original_extension"
          },
