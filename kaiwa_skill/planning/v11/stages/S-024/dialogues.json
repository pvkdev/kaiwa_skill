          },
          "20ad1af0-c042-53ee-aed0-ae8942b7518e-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "9c01138d-0e99-5765-8e0a-88ffc084be91",
      "event_id": "E02",
      "context_vi": "Ở kệ nước tương của Hoshi, bạn thấy hai chai khác cỡ và hỏi cách phân biệt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9c01138d-0e99-5765-8e0a-88ffc084be91-u01",
          "speaker_id": "a",
          "ja": "この二本は、量が違うだけですか。",
          "vi": "Hai chai này chỉ khác dung tích thôi ạ?"
        },
        {
          "id": "9c01138d-0e99-5765-8e0a-88ffc084be91-u02",
          "speaker_id": "b",
          "ja": "いいえ。小さいほうは減塩タイプです。",
          "vi": "Không ạ. Chai nhỏ là loại giảm muối."
        },
        {
          "id": "9c01138d-0e99-5765-8e0a-88ffc084be91-u03",
          "speaker_id": "a",
          "ja": "そうですか。普通の大きいほうにします。",
          "vi": "Vậy à. Tôi lấy chai lớn loại thường."
        }
      ],
      "admin": {
        "source_refs": [
          "market_shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9c01138d-0e99-5765-8e0a-88ffc084be91-u01": {
            "kind": "original_extension"
          },
