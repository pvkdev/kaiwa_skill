    {
      "situation_uid": "0ba626a3-3ced-541d-bae5-ecb2b56fd31a",
      "event_id": "E03",
      "context_vi": "Tại quầy Hoshi hư cấu, bạn thấy giá tính cho sữa là 180 yên, còn nhớ nhãn kệ 150 yên; cả hai giá chỉ là ví dụ, chưa xác định bên nào đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0ba626a3-3ced-541d-bae5-ecb2b56fd31a-u01",
          "speaker_id": "a",
          "ja": "すみません。この牛乳、棚では百五十円に見えました。今は百八十円ですか。",
          "vi": "Xin lỗi, tôi thấy sữa trên kệ là 150 yên. Bây giờ tính 180 yên ạ?"
        },
        {
          "id": "0ba626a3-3ced-541d-bae5-ecb2b56fd31a-u02",
          "speaker_id": "b",
          "ja": "確認します。どの棚にありましたか。",
          "vi": "Tôi kiểm tra. Anh lấy ở kệ nào ạ?"
        },
        {
          "id": "0ba626a3-3ced-541d-bae5-ecb2b56fd31a-u03",
          "speaker_id": "a",
          "ja": "冷蔵棚の一番下です。",
          "vi": "Ở tầng dưới cùng của kệ lạnh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "market_shelf",
          "market_counter"
        ],
