    {
      "situation_uid": "97585e1f-f366-55f6-ba86-0071c8065bde",
      "event_id": "E03",
      "context_vi": "Tại quầy cá của Hoshi hư cấu, giờ nhận yêu cầu cắt cá hôm nay đã qua; bạn hỏi phương án có sẵn. Giờ 17:00 là quy định riêng trong cảnh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "97585e1f-f366-55f6-ba86-0071c8065bde-u01",
          "speaker_id": "a",
          "ja": "この魚を切ってもらえますか。",
          "vi": "Chị cắt con cá này giúp tôi được không ạ?"
        },
        {
          "id": "97585e1f-f366-55f6-ba86-0071c8065bde-u02",
          "speaker_id": "b",
          "ja": "すみません。この売り場では今日は五時まででした。切った魚ならこちらにあります。",
          "vi": "Xin lỗi, quầy này hôm nay chỉ nhận cắt đến 5 giờ. Cá cắt sẵn ở đây ạ."
        },
        {
          "id": "97585e1f-f366-55f6-ba86-0071c8065bde-u03",
          "speaker_id": "a",
          "ja": "では、切った魚を一パックください。",
          "vi": "Vậy cho tôi một khay cá cắt sẵn ạ."
        }
      ],
      "admin": {
        "source_refs": [
