    {
      "situation_uid": "8c6a720d-dd34-5624-9267-8df2d6e1dfb7",
      "event_id": "E03",
      "context_vi": "Sau cuộc trao đổi trước, nhân viên Hoshi đang kiểm giá của hộp sữa từ tầng dưới cùng kệ lạnh. Hai giá 150 và 180 yên là ví dụ hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8c6a720d-dd34-5624-9267-8df2d6e1dfb7-u01",
          "speaker_id": "a",
          "ja": "棚の札は、この牛乳の写真でした。",
          "vi": "Nhãn trên kệ có ảnh hộp sữa này ạ."
        },
        {
          "id": "8c6a720d-dd34-5624-9267-8df2d6e1dfb7-u02",
          "speaker_id": "b",
          "ja": "ありがとうございます。札を見てきますので、少々お待ちください。",
          "vi": "Cảm ơn anh. Tôi sẽ xem nhãn trên kệ, anh đợi chút nhé."
        },
        {
          "id": "8c6a720d-dd34-5624-9267-8df2d6e1dfb7-u03",
          "speaker_id": "a",
          "ja": "はい、ここで待ちます。",
          "vi": "Vâng, tôi đợi ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "market_shelf",
          "market_counter"
        ],
