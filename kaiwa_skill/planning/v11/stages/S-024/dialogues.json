    {
      "situation_uid": "e2e45f3f-82f0-5851-af20-39a1a97554ae",
      "event_id": "E02",
      "context_vi": "Ở Hoshi, món đậu phụ giảm giá đã hết. Bạn hỏi khi nào có món tương tự; nhân viên chưa có lịch nhập chắc chắn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e2e45f3f-82f0-5851-af20-39a1a97554ae-u01",
          "speaker_id": "a",
          "ja": "この安い豆腐はもうありませんか。",
          "vi": "Đậu phụ giảm giá này hết rồi ạ?"
        },
        {
          "id": "e2e45f3f-82f0-5851-af20-39a1a97554ae-u02",
          "speaker_id": "b",
          "ja": "はい、今日は売り切れです。次の入荷はまだ分かりません。",
          "vi": "Vâng, hôm nay hết rồi. Chúng tôi chưa biết khi nào hàng tới."
        },
        {
          "id": "e2e45f3f-82f0-5851-af20-39a1a97554ae-u03",
          "speaker_id": "a",
          "ja": "では、ほかの豆腐を見ます。どの棚ですか。",
          "vi": "Vậy tôi xem đậu phụ khác. Ở kệ nào ạ?"
        },
        {
          "id": "e2e45f3f-82f0-5851-af20-39a1a97554ae-u04",
          "speaker_id": "b",
          "ja": "同じ棚の下の段です。",
          "vi": "Ở tầng dưới của cùng kệ này ạ."
        }
      ],
      "admin": {
