    {
      "situation_uid": "f4424482-d624-56bd-8906-a7760ae3ae42",
      "event_id": "E04",
      "context_vi": "Về nhà từ Hoshi, bạn thấy hóa đơn có một quả táo nhưng trong túi không có. Bạn gọi quầy hỗ trợ của chính siêu thị.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "f4424482-d624-56bd-8906-a7760ae3ae42-u01",
          "speaker_id": "a",
          "ja": "今日買ったりんごが袋にありません。でもレシートにはあります。",
          "vi": "Táo tôi mua hôm nay không có trong túi, nhưng hóa đơn có ghi ạ."
        },
        {
          "id": "f4424482-d624-56bd-8906-a7760ae3ae42-u02",
          "speaker_id": "b",
          "ja": "ご連絡ありがとうございます。お会計は何時ごろでしたか。",
          "vi": "Cảm ơn anh đã gọi. Anh thanh toán khoảng mấy giờ ạ?"
        },
        {
          "id": "f4424482-d624-56bd-8906-a7760ae3ae42-u03",
          "speaker_id": "a",
          "ja": "三時ごろです。レシートを持っています。",
          "vi": "Khoảng 3 giờ. Tôi còn giữ hóa đơn."
        },
        {
          "id": "f4424482-d624-56bd-8906-a7760ae3ae42-u04",
          "speaker_id": "b",
          "ja": "確認しますので、レシートをお持ちのまま少々お待ちください。",
          "vi": "Tôi kiểm tra. Anh giữ hóa đơn và chờ một chút nhé."
        }
      ],
