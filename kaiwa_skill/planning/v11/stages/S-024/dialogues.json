    {
      "situation_uid": "0445f6d4-b05b-5850-bf67-96035f12d8fd",
      "event_id": "E03",
      "context_vi": "Tại quầy thịt của Hoshi hư cấu, bạn muốn chia thịt thành hai phần cho hai bữa; bạn hỏi xem quầy này có làm được không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0445f6d4-b05b-5850-bf67-96035f12d8fd-u01",
          "speaker_id": "a",
          "ja": "この肉を二つに分けてもらえますか。",
          "vi": "Chị chia phần thịt này làm hai giúp tôi được không ạ?"
        },
        {
          "id": "0445f6d4-b05b-5850-bf67-96035f12d8fd-u02",
          "speaker_id": "b",
          "ja": "この売り場ではできます。半分ずつでいいですか。",
          "vi": "Quầy này làm được ạ. Chia đôi bằng nhau nhé?"
        },
        {
          "id": "0445f6d4-b05b-5850-bf67-96035f12d8fd-u03",
          "speaker_id": "a",
          "ja": "はい、半分ずつお願いします。",
          "vi": "Vâng, chia đôi giúp tôi."
        }
      ],
      "admin": {
        "source_refs": [
          "market_counter"
        ],
