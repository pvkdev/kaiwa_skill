    {
      "situation_uid": "436e5e66-7432-52a3-a32f-b15082543668",
      "event_id": "E04",
      "context_vi": "Nhân viên Hoshi cần kiểm giao dịch của hộp đậu phụ bạn báo có mùi lạ. Bạn muốn biết cần mang gì và khi nào quay lại; mốc 18:00 là hẹn riêng trong cảnh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "436e5e66-7432-52a3-a32f-b15082543668-u01",
          "speaker_id": "b",
          "ja": "店で確認しますので、もう一度来ていただけますか。",
          "vi": "Chúng tôi cần kiểm tại cửa hàng. Anh quay lại được không ạ?"
        },
        {
          "id": "436e5e66-7432-52a3-a32f-b15082543668-u02",
          "speaker_id": "a",
          "ja": "何を持って、いつ行けばいいですか。",
          "vi": "Tôi mang gì và đến lúc nào ạ?"
        },
        {
          "id": "436e5e66-7432-52a3-a32f-b15082543668-u03",
          "speaker_id": "b",
          "ja": "商品とレシートをお持ちください。今日は六時まで担当者がいます。",
          "vi": "Anh mang sản phẩm và hóa đơn nhé. Hôm nay người phụ trách ở đây đến 6 giờ."
        },
        {
          "id": "436e5e66-7432-52a3-a32f-b15082543668-u04",
          "speaker_id": "a",
          "ja": "では、五時半ごろ行きます。",
          "vi": "Vậy khoảng 5 giờ rưỡi tôi đến."
        }
      ],
