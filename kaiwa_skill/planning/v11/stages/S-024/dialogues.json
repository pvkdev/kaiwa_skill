          },
          "abdf9419-01b8-57b3-ac34-b4dae48a1f58-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "20ad1af0-c042-53ee-aed0-ae8942b7518e",
      "event_id": "E01",
      "context_vi": "Sau cuộc trao đổi trước tại Hoshi, cá hồi hết, nhân viên đã chỉ cá thu ở phía trước quầy cá. Bạn chốt loại và lượng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên siêu thị",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "20ad1af0-c042-53ee-aed0-ae8942b7518e-u01",
          "speaker_id": "a",
          "ja": "さばを二切れください。",
          "vi": "Cho tôi hai miếng cá thu ạ."
        },
        {
          "id": "20ad1af0-c042-53ee-aed0-ae8942b7518e-u02",
          "speaker_id": "b",
          "ja": "二切れですね。こちらです。",
          "vi": "Hai miếng nhé. Đây ạ."
        },
        {
          "id": "20ad1af0-c042-53ee-aed0-ae8942b7518e-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。これで夕飯を作ります。",
          "vi": "Cảm ơn chị. Tôi sẽ dùng món này cho bữa tối."
        }
      ],
      "admin": {
        "source_refs": [
          "market_shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "20ad1af0-c042-53ee-aed0-ae8942b7518e-u01": {
            "kind": "original_extension"
          },
