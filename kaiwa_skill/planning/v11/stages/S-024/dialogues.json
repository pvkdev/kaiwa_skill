          },
          "9c01138d-0e99-5765-8e0a-88ffc084be91-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "59ef7745-ee48-5a94-9f60-66a22d1892a2",
      "event_id": "E02",
      "context_vi": "Bạn cầm một chai sốt đóng gói tại Hoshi, muốn hỏi chỗ xem hạn và cách giữ sau mở.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "59ef7745-ee48-5a94-9f60-66a22d1892a2-u01",
          "speaker_id": "a",
          "ja": "このソースの賞味期限はどこですか。",
          "vi": "Hạn dùng tốt nhất của chai sốt này ghi ở đâu ạ?"
        },
        {
          "id": "59ef7745-ee48-5a94-9f60-66a22d1892a2-u02",
          "speaker_id": "b",
          "ja": "ふたの上です。開けた後の保存方法は裏に書いてあります。",
          "vi": "Ở trên nắp ạ. Cách bảo quản sau khi mở ghi ở mặt sau."
        },
        {
          "id": "59ef7745-ee48-5a94-9f60-66a22d1892a2-u03",
          "speaker_id": "a",
          "ja": "では、裏も読んでから買います。",
          "vi": "Vậy tôi đọc cả mặt sau rồi quyết định mua."
        }
      ],
      "admin": {
        "source_refs": [
          "caa_date"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "59ef7745-ee48-5a94-9f60-66a22d1892a2-u01": {
