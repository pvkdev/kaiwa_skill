          }
        }
      }
    },
    {
      "situation_uid": "4f9cac8d-c960-59a8-85f7-38d1571cc52b",
      "event_id": "E01",
      "context_vi": "Người tiếp nhận 119 hỏi còn ai trong tòa Aoi không. Bạn chỉ biết mình đã thấy một người đi ra, còn bên trong chưa rõ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u01",
          "speaker_id": "b",
          "ja": "中に人はいますか。",
          "vi": "Có người ở bên trong không ạ?"
        },
        {
          "id": "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u02",
          "speaker_id": "a",
          "ja": "一人が外に出たのは見ました。まだ中にいる人がいるかは分かりません。",
          "vi": "Tôi thấy một người đã ra ngoài. Tôi không biết còn ai bên trong không."
        },
        {
          "id": "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u03",
          "speaker_id": "b",
          "ja": "不明として伝えます。",
          "vi": "Tôi sẽ báo là chưa rõ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u01": {
            "kind": "original_extension"
          },
