    {
      "situation_uid": "b3057bee-4adb-5fc9-a1cf-51145eee6077",
      "event_id": "E04",
      "context_vi": "Một người nói nhầm có thể quay lại tòa bên cạnh. Bạn hỏi người phụ trách đúng tòa và xác nhận chưa tự vào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách tại chỗ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b3057bee-4adb-5fc9-a1cf-51145eee6077-u01",
          "speaker_id": "a",
          "ja": "さくら町三の十二のあおいビルに戻っていいんですか。念のため聞いています。",
          "vi": "Tôi muốn hỏi cho chắc: tòa Aoi ở Sakura-machi 3-12 đã được phép quay lại chưa ạ?"
        },
        {
          "id": "b3057bee-4adb-5fc9-a1cf-51145eee6077-u02",
          "speaker_id": "b",
          "ja": "いいえ、まだどの建物にも戻らないでください。案内を待ってください。",
          "vi": "Chưa. Hiện đừng quay vào tòa nào. Hãy chờ thông báo."
        },
        {
          "id": "b3057bee-4adb-5fc9-a1cf-51145eee6077-u03",
          "speaker_id": "a",
          "ja": "分かりました。入らないで、案内を待ちます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ đứng ngoài chờ hướng dẫn ạ."
        }
      ],
