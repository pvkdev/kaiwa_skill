  "dialogues": [
    {
      "situation_uid": "d107a576-c456-5f3b-aa2c-7d19d7275aba",
      "event_id": "E01",
      "context_vi": "Trong tòa あおい hư cấu tại Sakura-machi 3-12, bạn thấy khói ở tầng hai và gọi 119 ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d107a576-c456-5f3b-aa2c-7d19d7275aba-u01",
          "speaker_id": "b",
          "ja": "119です。火事ですか、救急ですか。",
          "vi": "119 đây. Có cháy hay cần cấp cứu ạ?"
        },
        {
          "id": "d107a576-c456-5f3b-aa2c-7d19d7275aba-u02",
          "speaker_id": "a",
          "ja": "火事かもしれません。さくら町三の十二、あおいビル二階に煙が見えます。",
          "vi": "Có thể là cháy. Tôi thấy khói ở tầng hai tòa Aoi, Sakura-machi 3-12."
        },
        {
          "id": "d107a576-c456-5f3b-aa2c-7d19d7275aba-u03",
          "speaker_id": "b",
          "ja": "あおいビル二階ですね。",
          "vi": "Tầng hai tòa Aoi, đúng không ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d107a576-c456-5f3b-aa2c-7d19d7275aba-u01": {
            "kind": "original_extension"
          },
          "d107a576-c456-5f3b-aa2c-7d19d7275aba-u02": {
            "kind": "original_extension"
          },
          "d107a576-c456-5f3b-aa2c-7d19d7275aba-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "72bb0605-98e4-57fd-9b56-6848d1ea333d",
      "event_id": "E01",
      "context_vi": "Bạn thấy khói từ tầng hai nhưng chưa thấy lửa. Người tiếp nhận 119 hỏi điều bạn quan sát.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "72bb0605-98e4-57fd-9b56-6848d1ea333d-u01",
          "speaker_id": "b",
          "ja": "炎は見えますか。",
          "vi": "Bạn có thấy lửa không ạ?"
        },
        {
          "id": "72bb0605-98e4-57fd-9b56-6848d1ea333d-u02",
          "speaker_id": "a",
          "ja": "いいえ、煙だけ見えます。原因は分かりません。",
          "vi": "Không, tôi chỉ thấy khói. Tôi không biết nguyên nhân."
        },
        {
          "id": "72bb0605-98e4-57fd-9b56-6848d1ea333d-u03",
          "speaker_id": "b",
          "ja": "煙を見たのですね。",
          "vi": "Bạn đã thấy khói ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "72bb0605-98e4-57fd-9b56-6848d1ea333d-u01": {
            "kind": "original_extension"
          },
