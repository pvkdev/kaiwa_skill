  "dialogues": [
    {
      "situation_uid": "d107a576-c456-5f3b-aa2c-7d19d7275aba",
      "event_id": "E01",
      "context_vi": "Bạn thấy khói ở tầng hai tòa Aoi tại Sakura-machi 3-12. Bạn rời vùng có khói và gọi 119 từ chỗ an toàn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d107a576-c456-5f3b-aa2c-7d19d7275aba-u01",
          "speaker_id": "b",
          "ja": "119です。火事ですか、救急ですか。",
          "vi": "119 đây. Có cháy hay cần cấp cứu ạ?"
        },
        {
          "id": "d107a576-c456-5f3b-aa2c-7d19d7275aba-u02",
          "speaker_id": "a",
          "ja": "火事かもしれません。さくら町三の十二、あおいビルの二階で煙を見ました。",
          "vi": "Có thể là cháy. Tôi thấy khói ở tầng hai tòa Aoi, Sakura-machi 3-12 ạ."
        },
        {
          "id": "d107a576-c456-5f3b-aa2c-7d19d7275aba-u03",
          "speaker_id": "b",
          "ja": "さくら町三の十二、あおいビルの二階ですね。",
          "vi": "Tầng hai tòa Aoi, Sakura-machi 3-12, đúng không ạ?"
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "safety"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d107a576-c456-5f3b-aa2c-7d19d7275aba-u01": {
            "kind": "original_extension"
