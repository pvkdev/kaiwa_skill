        }
      }
    },
    {
      "situation_uid": "59d5bc8d-2642-5b10-b9ec-f532bcc2caf1",
      "event_id": "E03",
      "context_vi": "Bạn đã báo quản lý tòa về khói và 119. Hiện một đồng nghiệp chưa liên lạc được; bạn không khẳng định họ còn ở trong.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý tòa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "59d5bc8d-2642-5b10-b9ec-f532bcc2caf1-u01",
          "speaker_id": "a",
          "ja": "一人とまだ連絡が取れません。中にいるかは分かりません。",
