          },
          "ecb6a686-4204-5ada-904c-8e5d07ea74db-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "2c8bb478-6f5f-566a-a272-483ed6b39fb1",
      "event_id": "E03",
      "context_vi": "Đã ra chỗ an toàn, bạn gặp quản lý tòa Aoi và báo những gì thấy cùng việc đã gọi 119.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý tòa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2c8bb478-6f5f-566a-a272-483ed6b39fb1-u01",
          "speaker_id": "a",
          "ja": "二階に煙が見えました。119にはもう電話しました。",
          "vi": "Tôi thấy khói ở tầng hai. Tôi đã gọi 119 rồi."
        },
        {
          "id": "2c8bb478-6f5f-566a-a272-483ed6b39fb1-u02",
          "speaker_id": "b",
          "ja": "分かりました。建物の人を確認します。",
          "vi": "Tôi hiểu. Tôi sẽ kiểm tra người trong tòa."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "2c8bb478-6f5f-566a-a272-483ed6b39fb1-u01": {
            "kind": "original_extension"
          },
          "2c8bb478-6f5f-566a-a272-483ed6b39fb1-u02": {
