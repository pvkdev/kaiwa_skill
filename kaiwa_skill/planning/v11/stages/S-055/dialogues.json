      "turns": [
        {
          "id": "59d5bc8d-2642-5b10-b9ec-f532bcc2caf1-u01",
          "speaker_id": "a",
          "ja": "同僚の一人と、まだ連絡が取れません。建物の中にいるかは分かりません。",
          "vi": "Tôi vẫn chưa liên lạc được với một đồng nghiệp. Tôi không biết người đó có còn trong tòa nhà không ạ."
        },
        {
          "id": "59d5bc8d-2642-5b10-b9ec-f532bcc2caf1-u02",
          "speaker_id": "b",
          "ja": "分かりました。そのまま消防の人に伝えます。",
          "vi": "Tôi hiểu. Tôi sẽ báo đúng như vậy cho đội cứu hỏa."
        }
