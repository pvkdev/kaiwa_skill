    {
      "situation_uid": "9d660da5-9d3a-5dd3-a44c-719e975d0fd2",
      "event_id": "E04",
      "context_vi": "Bạn đã được ghi nhận ở sân phía bắc, nhưng chưa biết có nên chờ ở đó. Bạn hỏi người phụ trách tại chỗ.",
