          }
        }
      }
    },
    {
      "situation_uid": "4f9cac8d-c960-59a8-85f7-38d1571cc52b",
      "event_id": "E01",
      "context_vi": "Người tiếp nhận 119 hỏi còn ai trong tòa Aoi không. Bạn chỉ biết mình đã thấy một người đi ra, còn bên trong chưa rõ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u01",
          "speaker_id": "b",
          "ja": "中に人はいますか。",
          "vi": "Có người ở bên trong không ạ?"
        },
        {
          "id": "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u02",
          "speaker_id": "a",
          "ja": "一人が外に出たのは見ました。まだ中にいる人がいるかは分かりません。",
          "vi": "Tôi thấy một người đã ra ngoài. Tôi không biết còn ai bên trong không."
        },
        {
          "id": "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u03",
          "speaker_id": "b",
          "ja": "不明として伝えます。",
          "vi": "Tôi sẽ báo là chưa rõ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u01": {
            "kind": "original_extension"
          },
          "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u02": {
            "kind": "original_extension"
          },
          "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "eb841996-d2d2-5872-b0c0-541ad86159f8",
      "event_id": "E02",
      "context_vi": "Bạn đang ở chỗ chưa có khói. Qua điện thoại, tổng đài hỏi về một lối ra nhưng bạn chưa nghe hết. Bạn xin nhắc lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "eb841996-d2d2-5872-b0c0-541ad86159f8-u01",
          "speaker_id": "a",
          "ja": "すみません。どの出口か、もう一度言ってください。",
          "vi": "Xin lỗi, anh nhắc lại là cửa nào giúp tôi với ạ."
        },
        {
          "id": "eb841996-d2d2-5872-b0c0-541ad86159f8-u02",
          "speaker_id": "b",
          "ja": "東側の出口です。今いるところから、煙が見えますか。",
          "vi": "Cửa phía đông ạ. Từ chỗ chị đang đứng có thấy khói ở đó không?"
        },
        {
          "id": "eb841996-d2d2-5872-b0c0-541ad86159f8-u03",
          "speaker_id": "a",
          "ja": "ここからはよく見えません。",
          "vi": "Từ đây tôi không nhìn rõ ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "safety"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "eb841996-d2d2-5872-b0c0-541ad86159f8-u01": {
            "kind": "original_extension"
          },
          "eb841996-d2d2-5872-b0c0-541ad86159f8-u02": {
            "kind": "original_extension"
          },
          "eb841996-d2d2-5872-b0c0-541ad86159f8-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "da8d579c-299a-5e0f-8fae-37faaf357170",
      "event_id": "E02",
      "context_vi": "Sau khi ra ngoài theo lối đã được chỉ, bạn báo với 119 mình đang ở sân phía bắc của tòa Aoi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "da8d579c-299a-5e0f-8fae-37faaf357170-u01",
          "speaker_id": "a",
          "ja": "外に出ました。今、ビルの北側の広場にいます。",
          "vi": "Tôi đã ra ngoài. Giờ tôi ở sân phía bắc tòa nhà."
        },
        {
          "id": "da8d579c-299a-5e0f-8fae-37faaf357170-u02",
          "speaker_id": "b",
          "ja": "北側の広場ですね。安全な場所から、見える範囲で教えてください。",
          "vi": "Sân phía bắc ạ. Từ chỗ an toàn, chị cho biết những gì còn nhìn thấy được."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "safety"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "da8d579c-299a-5e0f-8fae-37faaf357170-u01": {
            "kind": "original_extension"
          },
          "da8d579c-299a-5e0f-8fae-37faaf357170-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "65cd2ce4-0e50-553f-977e-eb94cae91355",
      "event_id": "E02",
      "context_vi": "Bạn vẫn đang ở vị trí chưa có khói. Một nhân viên tòa nhà báo cửa đông bị khói chặn. Bạn nhắc thông tin mới và nói ngay mình ở đâu cho tổng đài 119.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "65cd2ce4-0e50-553f-977e-eb94cae91355-u01",
          "speaker_id": "a",
          "ja": "東側の出口は煙で通れないそうです。私は一階の階段の前にいます。",
          "vi": "Nhân viên vừa báo cửa phía đông có khói, không qua được. Tôi đang ở trước cầu thang tầng một ạ."
        },
        {
          "id": "65cd2ce4-0e50-553f-977e-eb94cae91355-u02",
          "speaker_id": "b",
          "ja": "一階の階段の前ですね。煙の中には入らないでください。今いる場所を消防隊に伝えます。",
          "vi": "Trước cầu thang tầng một ạ. Chị đừng đi vào chỗ có khói. Tôi sẽ báo đội cứu hỏa chỗ chị đang đứng."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "safety"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "65cd2ce4-0e50-553f-977e-eb94cae91355-u01": {
            "kind": "original_extension"
          },
          "65cd2ce4-0e50-553f-977e-eb94cae91355-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "ecb6a686-4204-5ada-904c-8e5d07ea74db",
      "event_id": "E02",
      "context_vi": "Bạn chưa rõ từ chỗ đang đứng có thể ra bằng cửa phía đông không. Bạn nhờ người ở gần cùng nghe tổng đài và xác nhận lối.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ecb6a686-4204-5ada-904c-8e5d07ea74db-u01",
          "speaker_id": "a",
          "ja": "東側の出口へ行けるか、よく分かりません。百十九番の人の話を一緒に聞いてもらえますか。",
          "vi": "Tôi chưa biết có ra bằng cửa đông được không. Anh nghe hướng dẫn của tổng đài 119 cùng tôi được không ạ?"
        },
        {
          "id": "ecb6a686-4204-5ada-904c-8e5d07ea74db-u02",
          "speaker_id": "b",
          "ja": "はい。通報の人の話を一緒に聞きます。",
          "vi": "Được. Tôi sẽ cùng nghe lời người tiếp nhận."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ecb6a686-4204-5ada-904c-8e5d07ea74db-u01": {
            "kind": "original_extension"
          },
          "ecb6a686-4204-5ada-904c-8e5d07ea74db-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "2c8bb478-6f5f-566a-a272-483ed6b39fb1",
      "event_id": "E03",
      "context_vi": "Đã ra nơi an toàn, bạn gọi cho quản lý tòa Aoi để báo khói ở tầng hai và xác nhận đã gọi 119.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý tòa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2c8bb478-6f5f-566a-a272-483ed6b39fb1-u01",
          "speaker_id": "a",
          "ja": "二階に煙が見えました。119にはもう電話しました。",
          "vi": "Tôi thấy khói ở tầng hai. Tôi đã gọi 119 rồi."
        },
        {
          "id": "2c8bb478-6f5f-566a-a272-483ed6b39fb1-u02",
          "speaker_id": "b",
          "ja": "分かりました。北側の広場に行って、避難した人を確認します。",
          "vi": "Tôi hiểu rồi. Tôi sẽ ra sân phía bắc để kiểm những người đã ra ngoài."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
