    {
      "situation_uid": "103b1527-99a9-5a30-908a-15abc63701ff",
      "event_id": "E04",
      "context_vi": "Từ sân phía bắc, bạn gọi cho người thân để báo mình đã ra ngoài an toàn và nơi có thể gặp.",
