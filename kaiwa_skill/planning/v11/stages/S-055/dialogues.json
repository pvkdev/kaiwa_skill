    {
      "situation_uid": "f0bf5222-dd89-53c8-ae10-f5457e71dbb3",
      "event_id": "E03",
      "context_vi": "Quản lý tòa Aoi vừa tới sân phía bắc. Bạn nhận ra anh và nói mình là người đã gọi báo khói, để hai bên thống nhất nơi tiếp tục báo tin.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý tòa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f0bf5222-dd89-53c8-ae10-f5457e71dbb3-u01",
          "speaker_id": "a",
          "ja": "さっき電話したリンです。私が二階の煙を百十九番に伝えました。ここにいます。",
          "vi": "Tôi là Linh, người vừa gọi anh. Tôi là người đã báo 119 về khói tầng hai. Tôi đang đợi ở đây ạ."
        },
        {
          "id": "f0bf5222-dd89-53c8-ae10-f5457e71dbb3-u02",
          "speaker_id": "b",
          "ja": "ここで会えましたね。消防隊が来たら、私からもお伝えします。",
          "vi": "Vậy tôi gặp được chị rồi. Khi đội cứu hỏa đến, tôi cũng sẽ báo lại với họ."
        }
      ],
