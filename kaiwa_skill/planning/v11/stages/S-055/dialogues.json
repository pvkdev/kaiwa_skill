          }
        }
      }
    },
    {
      "situation_uid": "d3c63a3e-31a9-57b4-a658-1a2573a36727",
      "event_id": "E03",
      "context_vi": "Quản lý tòa hỏi bạn có nghe chuông báo cháy không. Bạn chỉ nói điều mình nghe.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quản lý tòa",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d3c63a3e-31a9-57b4-a658-1a2573a36727-u01",
          "speaker_id": "b",
          "ja": "非常ベルは鳴りましたか。",
          "vi": "Chuông báo cháy có reo không?"
        },
        {
          "id": "d3c63a3e-31a9-57b4-a658-1a2573a36727-u02",
          "speaker_id": "a",
          "ja": "はい、二回聞こえました。その前は分かりません。",
          "vi": "Có, tôi nghe hai lần. Trước đó thì tôi không biết."
        },
        {
          "id": "d3c63a3e-31a9-57b4-a658-1a2573a36727-u03",
          "speaker_id": "b",
          "ja": "二回ですね。",
          "vi": "Hai lần ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
