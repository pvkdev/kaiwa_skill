    {
      "situation_uid": "b92f4e36-d226-52a7-88cd-87e348da2230",
      "event_id": "E04",
      "context_vi": "Tại sân tập trung phía bắc của tòa Aoi, bạn báo với người phụ trách để được ghi nhận đã ra ngoài.",
