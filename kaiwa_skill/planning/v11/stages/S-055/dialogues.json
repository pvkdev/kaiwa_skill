    {
      "situation_uid": "103b1527-99a9-5a30-908a-15abc63701ff",
      "event_id": "E04",
      "context_vi": "Bạn đã được ghi nhận an toàn ở sân phía bắc. Người phụ trách xác nhận bạn có thể ra cổng bắc nhà ga bên kia đường để gặp chị, nên bạn gọi báo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
