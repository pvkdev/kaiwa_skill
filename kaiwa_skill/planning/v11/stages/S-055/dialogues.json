          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách tại chỗ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b92f4e36-d226-52a7-88cd-87e348da2230-u01",
          "speaker_id": "a",
          "ja": "北側の広場に避難したリンです。名前を確認していただけますか。",
          "vi": "Tôi là Linh, đã sơ tán ra sân phía bắc. Anh ghi nhận tên tôi giúp được không ạ?"
        },
        {
          "id": "b92f4e36-d226-52a7-88cd-87e348da2230-u02",
          "speaker_id": "b",
          "ja": "リンさんですね。避難されたことを記録しました。",
          "vi": "Chị Linh phải không ạ? Tôi đã ghi nhận chị đã ra ngoài."
        }
      ],
