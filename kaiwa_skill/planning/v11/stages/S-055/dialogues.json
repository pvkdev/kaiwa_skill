          },
          "72bb0605-98e4-57fd-9b56-6848d1ea333d-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "bc887a47-9562-5d85-896c-009059bc6898",
      "event_id": "E01",
      "context_vi": "Trong cuộc gọi 119, người tiếp nhận chưa nghe rõ tên tòa Aoi; bạn nhắc lại tên và biển hiệu trước cổng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bc887a47-9562-5d85-896c-009059bc6898-u01",
          "speaker_id": "b",
          "ja": "建物の名前をもう一度お願いします。",
          "vi": "Bạn nhắc lại tên tòa nhà giúp tôi."
        },
        {
          "id": "bc887a47-9562-5d85-896c-009059bc6898-u02",
          "speaker_id": "a",
          "ja": "あおいビルです。入口に大きな青い看板があります。",
          "vi": "Là tòa Aoi. Ở cửa vào có biển xanh lớn."
        },
        {
          "id": "bc887a47-9562-5d85-896c-009059bc6898-u03",
          "speaker_id": "b",
          "ja": "あおいビル、青い看板ですね。",
          "vi": "Tòa Aoi, biển xanh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
