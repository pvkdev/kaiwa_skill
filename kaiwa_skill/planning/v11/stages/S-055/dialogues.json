      ],
      "turns": [
        {
          "id": "103b1527-99a9-5a30-908a-15abc63701ff-u01",
          "speaker_id": "a",
          "ja": "もしもし、お姉ちゃん。無事だよ。もう外に出た。",
          "vi": "A lô, chị ơi. Em an toàn rồi. Em đã ra ngoài."
        },
        {
          "id": "103b1527-99a9-5a30-908a-15abc63701ff-u02",
          "speaker_id": "b",
          "ja": "よかった。どこで会える？",
          "vi": "May quá. Chị gặp em ở đâu được?"
        },
        {
          "id": "103b1527-99a9-5a30-908a-15abc63701ff-u03",
          "speaker_id": "a",
          "ja": "係の人に聞いたよ。向かいにある駅の北口で会える。私も今から行くね。",
          "vi": "Em hỏi người phụ trách rồi. Mình gặp ở cửa bắc của ga bên kia đường nhé. Em ra đó ngay."
        }
