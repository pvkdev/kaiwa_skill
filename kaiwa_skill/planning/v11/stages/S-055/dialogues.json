            "kind": "original_extension"
          },
          "4f9cac8d-c960-59a8-85f7-38d1571cc52b-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "eb841996-d2d2-5872-b0c0-541ad86159f8",
      "event_id": "E02",
      "context_vi": "Người tiếp nhận 119 vừa nêu lối thoát nhưng bạn nghe không rõ. Bạn hỏi lại lối nào an toàn theo tình hình họ vừa nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "eb841996-d2d2-5872-b0c0-541ad86159f8-u01",
          "speaker_id": "a",
          "ja": "すみません、出口が聞こえませんでした。どの出口ですか。",
          "vi": "Xin lỗi, tôi không nghe rõ lối ra. Là cửa nào ạ?"
        },
        {
          "id": "eb841996-d2d2-5872-b0c0-541ad86159f8-u02",
          "speaker_id": "b",
          "ja": "今、煙のない東側に出られますか。無理なら場所を教えてください。",
          "vi": "Hiện bạn có ra được cửa phía đông không có khói không? Nếu không, hãy báo vị trí."
        },
        {
          "id": "eb841996-d2d2-5872-b0c0-541ad86159f8-u03",
          "speaker_id": "a",
          "ja": "東側を確認します。",
          "vi": "Tôi sẽ nhìn cửa phía đông."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "eb841996-d2d2-5872-b0c0-541ad86159f8-u01": {
            "kind": "original_extension"
          },
          "eb841996-d2d2-5872-b0c0-541ad86159f8-u02": {
            "kind": "original_extension"
          },
          "eb841996-d2d2-5872-b0c0-541ad86159f8-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "da8d579c-299a-5e0f-8fae-37faaf357170",
      "event_id": "E02",
      "context_vi": "Sau khi ra ngoài theo lối đã được chỉ, bạn báo với 119 mình đang ở sân phía bắc của tòa Aoi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "da8d579c-299a-5e0f-8fae-37faaf357170-u01",
          "speaker_id": "a",
          "ja": "外に出ました。今、ビルの北側の広場にいます。",
          "vi": "Tôi đã ra ngoài. Giờ tôi ở sân phía bắc tòa nhà."
        },
        {
          "id": "da8d579c-299a-5e0f-8fae-37faaf357170-u02",
          "speaker_id": "b",
          "ja": "北側の広場ですね。そこから今の煙の様子を教えてください。",
          "vi": "Sân phía bắc. Từ chỗ đó, bạn cho biết khói hiện thế nào."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "da8d579c-299a-5e0f-8fae-37faaf357170-u01": {
            "kind": "original_extension"
          },
          "da8d579c-299a-5e0f-8fae-37faaf357170-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "65cd2ce4-0e50-553f-977e-eb94cae91355",
      "event_id": "E02",
      "context_vi": "Cửa phía đông mà bạn vừa được hỏi tới nay bị khói chặn. Bạn lập tức báo 119 thay vì tự chọn đường qua khói.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "65cd2ce4-0e50-553f-977e-eb94cae91355-u01",
          "speaker_id": "a",
          "ja": "東側の出口は煙で通れません。今は階段の前にいます。",
          "vi": "Cửa phía đông có khói, tôi không qua được. Giờ tôi ở trước cầu thang."
        },
        {
          "id": "65cd2ce4-0e50-553f-977e-eb94cae91355-u02",
          "speaker_id": "b",
          "ja": "分かりました。そこから動ける安全な場所を確認します。煙の中に入らないでください。",
          "vi": "Tôi hiểu. Ta sẽ xác định chỗ an toàn bạn có thể đến. Đừng đi vào vùng có khói."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "65cd2ce4-0e50-553f-977e-eb94cae91355-u01": {
            "kind": "original_extension"
          },
          "65cd2ce4-0e50-553f-977e-eb94cae91355-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "ecb6a686-4204-5ada-904c-8e5d07ea74db",
      "event_id": "E02",
      "context_vi": "Bạn không nghe rõ lối 119 vừa hướng dẫn và nhờ người ở gần giúp chỉ đúng đường không có khói, không tự đoán.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ecb6a686-4204-5ada-904c-8e5d07ea74db-u01",
          "speaker_id": "a",
          "ja": "119の案内が聞き取れませんでした。安全な出口を一緒に確認してもらえますか。",
          "vi": "Tôi không nghe rõ hướng dẫn của 119. Anh cùng tôi xác nhận lối ra an toàn được không?"
        },
        {
          "id": "ecb6a686-4204-5ada-904c-8e5d07ea74db-u02",
          "speaker_id": "b",
          "ja": "はい。通報の人の話を一緒に聞きます。",
          "vi": "Được. Tôi sẽ cùng nghe lời người tiếp nhận."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
