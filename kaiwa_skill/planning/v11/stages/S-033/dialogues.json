    {
      "situation_uid": "bb90aba5-e9c4-570f-89ec-1d6b723da349",
      "event_id": "E03",
      "context_vi": "Trong bữa trưa, sau khi hỏi bạn đã làm ở nhóm bao lâu, đồng nghiệp hỏi về cuối tuần. Bạn không muốn nói chuyện riêng và chuyển sang món đang ăn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "bb90aba5-e9c4-570f-89ec-1d6b723da349-u01",
          "speaker_id": "b",
          "ja": "あなたは週末、何をしましたか。",
          "vi": "Cuối tuần anh làm gì?"
        },
        {
          "id": "bb90aba5-e9c4-570f-89ec-1d6b723da349-u02",
          "speaker_id": "a",
          "ja": "その話は今日はちょっと。ところで、このうどんはおいしいですね。",
          "vi": "Chuyện đó hôm nay tôi xin không kể nhé. Mà udon này ngon thật."
        },
        {
          "id": "bb90aba5-e9c4-570f-89ec-1d6b723da349-u03",
          "speaker_id": "b",
          "ja": "そうですね。だしが好きです。",
          "vi": "Đúng vậy. Tôi thích nước dùng."
        },
        {
          "id": "bb90aba5-e9c4-570f-89ec-1d6b723da349-u04",
          "speaker_id": "a",
          "ja": "私もです。ほかにおすすめの料理はありますか。",
          "vi": "Tôi cũng vậy. Chị còn gợi ý món nào khác không?"
        }
      ],
      "admin": {
