          }
        }
      }
    },
    {
      "situation_uid": "382dd245-2ef2-57ea-be42-ce37378198ad",
      "event_id": "E01",
      "context_vi": "Sau lời rủ đi lúc 12 giờ, bạn xem lịch và nhớ ra đã có hẹn ăn với người khác. Bạn báo lại ngay và gợi ý ngày mai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "382dd245-2ef2-57ea-be42-ce37378198ad-u01",
          "speaker_id": "a",
          "ja": "すみません。今日の昼は先に約束がありました。",
          "vi": "Xin lỗi, trưa nay tôi đã có hẹn trước rồi."
        },
        {
          "id": "382dd245-2ef2-57ea-be42-ce37378198ad-u02",
          "speaker_id": "b",
          "ja": "そうでしたか。大丈夫ですよ。",
          "vi": "Vậy à. Không sao đâu."
        },
        {
          "id": "382dd245-2ef2-57ea-be42-ce37378198ad-u03",
          "speaker_id": "a",
          "ja": "明日なら空いています。一緒に行きませんか。",
          "vi": "Ngày mai tôi rảnh. Mình đi cùng nhé?"
        },
        {
          "id": "382dd245-2ef2-57ea-be42-ce37378198ad-u04",
          "speaker_id": "b",
          "ja": "はい。明日、また時間を決めましょう。",
          "vi": "Được. Mai mình chốt giờ nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "coworker"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "382dd245-2ef2-57ea-be42-ce37378198ad-u01": {
            "kind": "original_extension"
          },
