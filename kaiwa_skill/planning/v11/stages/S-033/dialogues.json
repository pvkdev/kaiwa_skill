    {
      "situation_uid": "4b0f01d8-5d94-532d-8302-9a447436c509",
      "event_id": "E03",
      "context_vi": "Trong bữa trưa, bạn muốn làm quen với đồng nghiệp mới gặp và hỏi chị ấy đã làm ở nhóm bao lâu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4b0f01d8-5d94-532d-8302-9a447436c509-u01",
          "speaker_id": "a",
          "ja": "このチームで、どのくらい働いていますか。",
          "vi": "Chị làm ở nhóm này được bao lâu rồi?"
        },
        {
          "id": "4b0f01d8-5d94-532d-8302-9a447436c509-u02",
          "speaker_id": "b",
          "ja": "二年くらいです。最初は別の仕事をしていました。",
          "vi": "Khoảng hai năm. Ban đầu tôi làm việc khác."
        },
        {
          "id": "4b0f01d8-5d94-532d-8302-9a447436c509-u03",
          "speaker_id": "a",
          "ja": "そうなんですね。今の仕事はどうですか。",
          "vi": "Ra vậy. Công việc hiện giờ thế nào?"
        },
        {
          "id": "4b0f01d8-5d94-532d-8302-9a447436c509-u04",
          "speaker_id": "b",
          "ja": "楽しいですよ。あなたは週末、何をしましたか。",
          "vi": "Vui lắm. Cuối tuần anh làm gì?"
        }
      ],
      "admin": {
        "source_refs": [
          "coworker"
        ],
