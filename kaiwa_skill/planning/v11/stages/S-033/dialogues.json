  "dialogues": [
    {
      "situation_uid": "4dfb856e-b6fe-5601-867b-32279c4179b9",
      "event_id": "E01",
      "context_vi": "Giờ nghỉ trưa ở văn phòng Hikari hư cấu. Đồng nghiệp rủ ăn cùng; bạn có thể đi nhưng cần biết giờ xuất phát.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4dfb856e-b6fe-5601-867b-32279c4179b9-u01",
          "speaker_id": "b",
          "ja": "今日、一緒にお昼を食べませんか。",
          "vi": "Hôm nay đi ăn trưa cùng tôi nhé?"
        },
        {
          "id": "4dfb856e-b6fe-5601-867b-32279c4179b9-u02",
          "speaker_id": "a",
          "ja": "いいですね。何時に会社を出ますか。",
          "vi": "Hay đấy. Mấy giờ mình rời văn phòng?"
        },
        {
          "id": "4dfb856e-b6fe-5601-867b-32279c4179b9-u03",
          "speaker_id": "b",
          "ja": "十二時に出ようと思います。",
          "vi": "Tôi định đi lúc 12 giờ."
        },
        {
          "id": "4dfb856e-b6fe-5601-867b-32279c4179b9-u04",
          "speaker_id": "a",
          "ja": "分かりました。予定を確認してから返事します。",
          "vi": "Được, để tôi kiểm tra lịch rồi trả lời nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "coworker",
          "workday"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "4dfb856e-b6fe-5601-867b-32279c4179b9-u01": {
