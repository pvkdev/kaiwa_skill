    {
      "situation_uid": "3c8c949a-d6bb-51f5-868f-a8b9562ab88b",
      "event_id": "E02",
      "context_vi": "Sau khi cả hai hỏi nhân viên tại quán hư cấu, họ được báo hôm nay không có món đáp ứng lựa chọn tránh thịt lợn của bạn. Bạn đề nghị sang quán khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "3c8c949a-d6bb-51f5-868f-a8b9562ab88b-u01",
          "speaker_id": "b",
          "ja": "店の人によると、今日は合う料理がないそうです。",
          "vi": "Theo nhân viên, hôm nay không có món phù hợp."
        },
        {
          "id": "3c8c949a-d6bb-51f5-868f-a8b9562ab88b-u02",
          "speaker_id": "a",
          "ja": "そうですか。別のお店に行きませんか。",
          "vi": "Vậy à. Mình sang quán khác nhé?"
        },
        {
          "id": "3c8c949a-d6bb-51f5-868f-a8b9562ab88b-u03",
          "speaker_id": "b",
          "ja": "近くのうどん屋なら、材料を聞けます。",
          "vi": "Quán udon gần đây thì mình có thể hỏi nguyên liệu."
        },
        {
          "id": "3c8c949a-d6bb-51f5-868f-a8b9562ab88b-u04",
          "speaker_id": "a",
          "ja": "いいですね。そこで確認してから注文します。",
          "vi": "Được đấy. Đến đó tôi sẽ xác nhận trước khi gọi món."
        }
