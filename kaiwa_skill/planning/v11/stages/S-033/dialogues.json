    {
      "situation_uid": "e394f2a6-91a9-51e8-bcde-cf2e0f081730",
      "event_id": "E03",
      "context_vi": "Sau bữa trưa và cuộc họp, bạn gặp lại đồng nghiệp ở văn phòng. Chị ấy đã gợi ý món udon hôm nay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e394f2a6-91a9-51e8-bcde-cf2e0f081730-u01",
          "speaker_id": "a",
          "ja": "さっきはうどんを教えてくれて、ありがとうございました。",
          "vi": "Lúc nãy cảm ơn chị đã gợi ý món udon."
        },
        {
          "id": "e394f2a6-91a9-51e8-bcde-cf2e0f081730-u02",
          "speaker_id": "b",
          "ja": "気に入ってもらえて、よかったです。会議はどうでしたか。",
          "vi": "Mừng là anh thích. Cuộc họp thế nào?"
        },
        {
          "id": "e394f2a6-91a9-51e8-bcde-cf2e0f081730-u03",
          "speaker_id": "a",
          "ja": "無事に終わりました。また一緒にお昼を食べましょう。",
          "vi": "Xong ổn rồi. Hôm nào lại đi ăn trưa cùng nhé."
        },
        {
          "id": "e394f2a6-91a9-51e8-bcde-cf2e0f081730-u04",
          "speaker_id": "b",
          "ja": "はい、ぜひ。",
          "vi": "Ừ, nhất định rồi."
        }
      ],
