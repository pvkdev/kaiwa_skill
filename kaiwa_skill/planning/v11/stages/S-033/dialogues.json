    {
      "situation_uid": "6135067c-2709-5770-8e67-42e0b7552772",
      "event_id": "E01",
      "context_vi": "Hôm sau, sau khi bạn phải từ chối lời rủ hôm qua vì đã có hẹn, đồng nghiệp lại rủ. Cả hai đều rảnh từ 12 giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "6135067c-2709-5770-8e67-42e0b7552772-u01",
          "speaker_id": "b",
          "ja": "今日は一緒にお昼、どうですか。",
          "vi": "Hôm nay đi ăn trưa cùng tôi nhé?"
        },
        {
          "id": "6135067c-2709-5770-8e67-42e0b7552772-u02",
          "speaker_id": "a",
          "ja": "はい、今日は大丈夫です。十二時に出ましょうか。",
          "vi": "Được, hôm nay tôi đi được. Mình đi lúc 12 giờ nhé?"
        },
        {
          "id": "6135067c-2709-5770-8e67-42e0b7552772-u03",
          "speaker_id": "b",
          "ja": "いいですね。入口で会いましょう。",
          "vi": "Được đấy. Gặp nhau ở cửa ra vào nhé."
        },
        {
          "id": "6135067c-2709-5770-8e67-42e0b7552772-u04",
          "speaker_id": "a",
          "ja": "分かりました。十二時に入口ですね。",
          "vi": "Được rồi. 12 giờ ở cửa ra vào nhé."
        }
      ],
      "admin": {
        "source_refs": [
