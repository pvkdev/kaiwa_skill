    {
      "situation_uid": "3971aa7a-0a65-5be0-a925-44c8bc1a4d46",
      "event_id": "E03",
      "context_vi": "Bữa trưa gần xong. Đồng nghiệp đã gợi ý món udon; bạn có cuộc họp sắp bắt đầu và cần đứng dậy trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "3971aa7a-0a65-5be0-a925-44c8bc1a4d46-u01",
          "speaker_id": "a",
          "ja": "すみません。もうすぐ会議なので、先に席を立ってもいいですか。",
          "vi": "Xin lỗi, tôi sắp có cuộc họp, tôi đứng dậy trước được không?"
        },
        {
          "id": "3971aa7a-0a65-5be0-a925-44c8bc1a4d46-u02",
          "speaker_id": "b",
          "ja": "もちろんです。うどんはどうでしたか。",
          "vi": "Tất nhiên rồi. Món udon thế nào?"
        },
        {
          "id": "3971aa7a-0a65-5be0-a925-44c8bc1a4d46-u03",
          "speaker_id": "a",
          "ja": "おいしかったです。おすすめしてくれて、ありがとうございます。",
          "vi": "Ngon lắm. Cảm ơn chị đã gợi ý."
        },
        {
          "id": "3971aa7a-0a65-5be0-a925-44c8bc1a4d46-u04",
          "speaker_id": "b",
          "ja": "よかったです。会議、頑張ってください。",
          "vi": "Mừng là anh thích. Chúc anh họp thuận lợi."
        }
      ],
