    {
      "situation_uid": "b692a03e-ab10-5bae-bff0-949e28218603",
      "event_id": "E02",
      "context_vi": "Tại một quán ăn hư cấu, bạn tránh ăn thịt lợn vì lựa chọn cá nhân. Bạn hỏi đồng nghiệp quán có món nào không có nguyên liệu đó; người kia chưa chắc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b692a03e-ab10-5bae-bff0-949e28218603-u01",
          "speaker_id": "a",
          "ja": "私は豚肉を食べません。この店に豚肉の入っていない料理はありますか。",
          "vi": "Tôi không ăn thịt lợn. Quán này có món nào không có thịt lợn không?"
        },
        {
          "id": "b692a03e-ab10-5bae-bff0-949e28218603-u02",
          "speaker_id": "b",
          "ja": "メニューだけでは分かりませんね。店の人に聞きましょうか。",
          "vi": "Chỉ nhìn thực đơn thì khó biết. Mình hỏi nhân viên nhé?"
        },
        {
          "id": "b692a03e-ab10-5bae-bff0-949e28218603-u03",
          "speaker_id": "a",
          "ja": "はい。材料を確認してから決めたいです。",
          "vi": "Vâng. Tôi muốn xác nhận nguyên liệu rồi mới chọn."
        },
        {
          "id": "b692a03e-ab10-5bae-bff0-949e28218603-u04",
          "speaker_id": "b",
          "ja": "分かりました。一緒に聞きましょう。",
          "vi": "Được, mình cùng hỏi nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "restaurant"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b692a03e-ab10-5bae-bff0-949e28218603-u01": {
