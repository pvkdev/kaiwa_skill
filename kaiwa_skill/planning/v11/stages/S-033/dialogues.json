    {
      "situation_uid": "1eae70a3-43b5-5eaf-9df1-8769c1cd9e55",
      "event_id": "E02",
      "context_vi": "Trước hai quán ăn hư cấu cạnh văn phòng, bạn muốn thử cà ri ở quán thứ nhất và hỏi đồng nghiệp thích ăn gì.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "1eae70a3-43b5-5eaf-9df1-8769c1cd9e55-u01",
          "speaker_id": "a",
          "ja": "あのお店のカレーを食べてみたいです。何を食べたいですか。",
          "vi": "Tôi muốn thử cà ri quán kia. Chị muốn ăn gì?"
        },
        {
          "id": "1eae70a3-43b5-5eaf-9df1-8769c1cd9e55-u02",
          "speaker_id": "b",
          "ja": "私はうどんが好きです。カレーは辛いですよ。",
          "vi": "Tôi thích udon. Cà ri ở đó cay đấy."
        },
        {
          "id": "1eae70a3-43b5-5eaf-9df1-8769c1cd9e55-u03",
          "speaker_id": "a",
          "ja": "そうですか。辛さを聞いてから決めたいです。",
          "vi": "Vậy à. Tôi muốn hỏi độ cay rồi mới quyết định."
        },
        {
          "id": "1eae70a3-43b5-5eaf-9df1-8769c1cd9e55-u04",
          "speaker_id": "b",
          "ja": "では、店の前でメニューを見ましょう。",
          "vi": "Vậy mình xem thực đơn trước quán nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "restaurant",
          "coworker"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1eae70a3-43b5-5eaf-9df1-8769c1cd9e55-u01": {
            "kind": "original_extension"
