    {
      "situation_uid": "11ad27d1-8c83-59bc-9c51-2788a643bf22",
      "event_id": "E03",
      "context_vi": "Trong bữa trưa với đồng nghiệp, cuối tuần bạn đã đi dạo ở công viên gần nhà. Bạn kể ngắn rồi hỏi lại người kia.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "11ad27d1-8c83-59bc-9c51-2788a643bf22-u01",
          "speaker_id": "a",
          "ja": "週末は近くの公園を散歩しました。天気がよくて、気持ちよかったです。",
          "vi": "Cuối tuần tôi đi dạo công viên gần nhà. Trời đẹp, thấy rất dễ chịu."
        },
        {
          "id": "11ad27d1-8c83-59bc-9c51-2788a643bf22-u02",
          "speaker_id": "b",
          "ja": "いいですね。私は家で料理をしました。",
          "vi": "Hay nhỉ. Tôi nấu ăn ở nhà."
        },
        {
          "id": "11ad27d1-8c83-59bc-9c51-2788a643bf22-u03",
          "speaker_id": "a",
          "ja": "何を作りましたか。",
          "vi": "Chị nấu món gì?"
        },
        {
          "id": "11ad27d1-8c83-59bc-9c51-2788a643bf22-u04",
          "speaker_id": "b",
          "ja": "簡単なカレーです。今度、作り方を話しますね。",
          "vi": "Món cà ri đơn giản thôi. Hôm nào tôi kể cách làm nhé."
        }
      ],
      "admin": {
        "source_refs": [
