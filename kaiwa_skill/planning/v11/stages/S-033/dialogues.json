          },
          "382dd245-2ef2-57ea-be42-ce37378198ad-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "ad825f58-4bca-5b01-9eac-c3a41b04460d",
      "event_id": "E01",
      "context_vi": "Sau lời rủ ăn lúc 12 giờ, bạn kiểm tra lịch: 12 giờ 30 có cuộc họp. Bạn hỏi liệu có quán gần văn phòng phục vụ nhanh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "ad825f58-4bca-5b01-9eac-c3a41b04460d-u01",
          "speaker_id": "a",
          "ja": "十二時半から会議があります。三十分しかありません。",
          "vi": "Từ 12 giờ 30 tôi có họp. Tôi chỉ có 30 phút thôi."
        },
        {
          "id": "ad825f58-4bca-5b01-9eac-c3a41b04460d-u02",
          "speaker_id": "b",
          "ja": "それなら、近くのうどん屋はどうですか。",
          "vi": "Vậy quán udon gần đây thì sao?"
        },
        {
          "id": "ad825f58-4bca-5b01-9eac-c3a41b04460d-u03",
          "speaker_id": "a",
          "ja": "そこはすぐ食べられますか。",
          "vi": "Ở đó ăn nhanh được chứ?"
        },
        {
          "id": "ad825f58-4bca-5b01-9eac-c3a41b04460d-u04",
          "speaker_id": "b",
          "ja": "普段は早いですが、今日は混み具合を見て決めましょう。",
          "vi": "Thường thì nhanh, nhưng hôm nay mình xem có đông không rồi quyết định nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "coworker",
          "workday"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ad825f58-4bca-5b01-9eac-c3a41b04460d-u01": {
