    {
      "situation_uid": "22898a8f-be12-582f-b9d3-a4a3bb28bd7b",
      "event_id": "E02",
      "context_vi": "Trước thực đơn quán cà ri, đồng nghiệp tưởng bạn ăn cay giỏi vì bạn muốn thử món này. Bạn chỉ ăn được hơi cay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "22898a8f-be12-582f-b9d3-a4a3bb28bd7b-u01",
          "speaker_id": "b",
          "ja": "辛いものが好きなんですね。いちばん辛いカレーにしますか。",
          "vi": "Anh thích đồ cay nhỉ. Chọn cà ri cay nhất nhé?"
        },
        {
          "id": "22898a8f-be12-582f-b9d3-a4a3bb28bd7b-u02",
          "speaker_id": "a",
          "ja": "いえ、辛いものは少しだけ食べられます。",
          "vi": "Không, tôi chỉ ăn được hơi cay thôi."
        },
        {
          "id": "22898a8f-be12-582f-b9d3-a4a3bb28bd7b-u03",
          "speaker_id": "b",
          "ja": "そうでしたか。普通の辛さにしますか。",
          "vi": "Vậy à. Chọn mức cay thường nhé?"
        },
        {
          "id": "22898a8f-be12-582f-b9d3-a4a3bb28bd7b-u04",
          "speaker_id": "a",
          "ja": "それも聞いてから決めます。甘口があるか見ましょう。",
          "vi": "Mức đó tôi cũng muốn hỏi trước. Mình xem có loại ít cay không nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "restaurant"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "22898a8f-be12-582f-b9d3-a4a3bb28bd7b-u01": {
