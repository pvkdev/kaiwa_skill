  "dialogues": [
    {
      "situation_uid": "6e5c961e-9092-58ce-975f-0684a48e21a9",
      "event_id": "E01",
      "context_vi": "Bạn đang ở cửa hàng tiện lợi hư cấu Midori. Muốn tìm cơm hộp để ăn nhanh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên konbini",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "6e5c961e-9092-58ce-975f-0684a48e21a9-u01",
          "speaker_id": "a",
          "ja": "すみません、お弁当はどこですか。",
          "vi": "Xin lỗi, cơm hộp ở đâu ạ?"
        },
        {
          "id": "6e5c961e-9092-58ce-975f-0684a48e21a9-u02",
          "speaker_id": "b",
          "ja": "奥の冷蔵棚です。飲み物の隣ですよ。",
          "vi": "Ở kệ lạnh phía trong, cạnh đồ uống ạ."
        },
        {
          "id": "6e5c961e-9092-58ce-975f-0684a48e21a9-u03",
          "speaker_id": "a",
          "ja": "あの棚ですね。ありがとうございます。",
          "vi": "Kệ đằng kia nhỉ. Cảm ơn chị."
        }
      ],
      "admin": {
        "source_refs": [
          "shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "6e5c961e-9092-58ce-975f-0684a48e21a9-u01": {
            "kind": "original_extension"
          },
