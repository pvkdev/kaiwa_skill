          }
        }
      }
    },
    {
      "situation_uid": "deb5a58e-3545-55e1-8cee-4884e0ecb76f",
      "event_id": "E02",
      "context_vi": "Tại quầy Midori, bạn mua cơm hộp và muốn hâm trước khi đi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "deb5a58e-3545-55e1-8cee-4884e0ecb76f-u01",
          "speaker_id": "b",
          "ja": "こちらのお弁当は温めますか。",
          "vi": "Cơm hộp này anh có muốn hâm không ạ?"
        },
        {
          "id": "deb5a58e-3545-55e1-8cee-4884e0ecb76f-u02",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Có ạ, nhờ chị hâm giúp."
        },
        {
          "id": "deb5a58e-3545-55e1-8cee-4884e0ecb76f-u03",
          "speaker_id": "b",
          "ja": "かしこまりました。少々お待ちください。",
          "vi": "Vâng ạ. Anh đợi chút nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "food"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
        "turn_origins": {
