            "kind": "original_extension"
          },
          "6e5c961e-9092-58ce-975f-0684a48e21a9-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "21fe626f-60ac-5136-8e3c-0507fe4eca99",
      "event_id": "E01",
      "context_vi": "Tại kệ đồ ăn của Midori, bạn phân vân giữa cơm cà ri và cơm trứng; muốn món không cay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên konbini",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "21fe626f-60ac-5136-8e3c-0507fe4eca99-u01",
          "speaker_id": "a",
          "ja": "この二つなら、辛くないのはどちらですか。",
          "vi": "Trong hai món này, món nào không cay ạ?"
        },
        {
          "id": "21fe626f-60ac-5136-8e3c-0507fe4eca99-u02",
          "speaker_id": "b",
          "ja": "こちらの卵のお弁当は辛くありません。",
          "vi": "Cơm hộp trứng này không cay ạ."
        },
        {
          "id": "21fe626f-60ac-5136-8e3c-0507fe4eca99-u03",
          "speaker_id": "a",
          "ja": "では、卵のほうをお願いします。",
          "vi": "Vậy cho tôi món trứng ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "shelf"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
        "turn_origins": {
          "21fe626f-60ac-5136-8e3c-0507fe4eca99-u01": {
            "kind": "original_extension"
          },
          "21fe626f-60ac-5136-8e3c-0507fe4eca99-u02": {
            "kind": "original_extension"
          },
          "21fe626f-60ac-5136-8e3c-0507fe4eca99-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d42ca499-b151-536d-b7a0-d563e7a91951",
      "event_id": "E01",
      "context_vi": "Ở Midori hư cấu, bạn thấy nhãn 300 yên giữa hai món bánh; chưa rõ nhãn áp dụng cho món nào. Giá chỉ là ví dụ của cửa hàng này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên konbini",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d42ca499-b151-536d-b7a0-d563e7a91951-u01",
          "speaker_id": "a",
          "ja": "すみません。この三百円は、どちらの値段ですか。",
          "vi": "Xin lỗi, 300 yên này là giá của món nào ạ?"
        },
        {
          "id": "d42ca499-b151-536d-b7a0-d563e7a91951-u02",
          "speaker_id": "b",
          "ja": "少々お待ちください。棚の札を確認します。",
          "vi": "Anh đợi chút, tôi kiểm tra nhãn trên kệ ạ."
        },
        {
          "id": "d42ca499-b151-536d-b7a0-d563e7a91951-u03",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ chị kiểm tra giúp."
        }
      ],
      "admin": {
        "source_refs": [
          "shelf"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
        "turn_origins": {
          "d42ca499-b151-536d-b7a0-d563e7a91951-u01": {
            "kind": "original_extension"
          },
          "d42ca499-b151-536d-b7a0-d563e7a91951-u02": {
            "kind": "original_extension"
          },
          "d42ca499-b151-536d-b7a0-d563e7a91951-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "be2b597f-4810-50b1-b900-4f8f1ea38544",
      "event_id": "E01",
      "context_vi": "Ở Midori, nhân viên vừa xem lại nhãn 300 yên giữa hai món bánh và chỉ rõ món bên phải.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên konbini",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "be2b597f-4810-50b1-b900-4f8f1ea38544-u01",
          "speaker_id": "b",
          "ja": "お待たせしました。三百円は右のパン一つの値段です。",
          "vi": "Xin lỗi đã để anh đợi. 300 yên là giá một chiếc bánh bên phải ạ."
        },
        {
          "id": "be2b597f-4810-50b1-b900-4f8f1ea38544-u02",
          "speaker_id": "a",
          "ja": "二つで三百円ではないんですね。",
          "vi": "Vậy không phải hai chiếc 300 yên nhỉ?"
        },
        {
          "id": "be2b597f-4810-50b1-b900-4f8f1ea38544-u03",
          "speaker_id": "b",
          "ja": "はい、一つの値段です。",
          "vi": "Đúng ạ, đó là giá một chiếc."
        },
        {
          "id": "be2b597f-4810-50b1-b900-4f8f1ea38544-u04",
          "speaker_id": "a",
          "ja": "わかりました。右のパンを一つください。",
          "vi": "Tôi hiểu rồi. Cho tôi một chiếc bên phải."
        }
      ],
      "admin": {
        "source_refs": [
          "shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "be2b597f-4810-50b1-b900-4f8f1ea38544-u01": {
            "kind": "original_extension"
          },
          "be2b597f-4810-50b1-b900-4f8f1ea38544-u02": {
