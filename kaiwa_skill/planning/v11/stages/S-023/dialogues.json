            "kind": "original_extension"
          },
          "be2b597f-4810-50b1-b900-4f8f1ea38544-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "30111bbf-02d6-5398-b8a2-717af051a5ab",
      "event_id": "E01",
      "context_vi": "Ở Midori, cơm cá bạn định mua đã hết. Bạn muốn một phần ăn khác ở cùng mức 400 yên, giá chỉ là ví dụ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên konbini",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "30111bbf-02d6-5398-b8a2-717af051a5ab-u01",
          "speaker_id": "a",
          "ja": "魚のお弁当はもうありませんか。",
          "vi": "Cơm hộp cá hết rồi ạ?"
        },
        {
          "id": "30111bbf-02d6-5398-b8a2-717af051a5ab-u02",
          "speaker_id": "b",
          "ja": "はい、今日は売り切れです。",
          "vi": "Vâng, hôm nay hết rồi ạ."
        },
        {
          "id": "30111bbf-02d6-5398-b8a2-717af051a5ab-u03",
          "speaker_id": "a",
          "ja": "四百円くらいで、ほかのお弁当はありますか。",
          "vi": "Có cơm hộp khác khoảng 400 yên không ạ?"
        },
        {
          "id": "30111bbf-02d6-5398-b8a2-717af051a5ab-u04",
          "speaker_id": "b",
          "ja": "こちらの鶏のお弁当が四百円です。",
          "vi": "Cơm hộp gà này 400 yên ạ."
        },
        {
          "id": "30111bbf-02d6-5398-b8a2-717af051a5ab-u05",
          "speaker_id": "a",
          "ja": "それを一つお願いします。",
          "vi": "Vậy cho tôi một phần đó ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "shelf"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
        "turn_origins": {
          "30111bbf-02d6-5398-b8a2-717af051a5ab-u01": {
            "kind": "original_extension"
          },
