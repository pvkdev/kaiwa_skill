    {
      "situation_uid": "54ca3553-9a2d-5aa8-a97f-58126fabdf3a",
      "event_id": "E02",
      "context_vi": "Tại Midori, thu ngân định hâm cả cơm hộp lẫn mì lạnh. Bạn nhận ra mì lạnh phải để nguyên.",
      "speakers": [
        {
