          },
          "deb5a58e-3545-55e1-8cee-4884e0ecb76f-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "493bca4c-9a5b-5254-a7eb-f251c132d91e",
      "event_id": "E02",
      "context_vi": "Bạn mang túi riêng tới quầy Midori; thu ngân hỏi về túi của cửa hàng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "493bca4c-9a5b-5254-a7eb-f251c132d91e-u01",
          "speaker_id": "b",
          "ja": "袋はご利用ですか。",
          "vi": "Anh có cần túi không ạ?"
        },
        {
          "id": "493bca4c-9a5b-5254-a7eb-f251c132d91e-u02",
          "speaker_id": "a",
          "ja": "いいえ、自分の袋があります。",
          "vi": "Không ạ, tôi có túi riêng rồi."
        },
        {
          "id": "493bca4c-9a5b-5254-a7eb-f251c132d91e-u03",
          "speaker_id": "b",
          "ja": "かしこまりました。このままお渡しします。",
          "vi": "Vâng, tôi đưa hàng cho anh như thế này nhé."
        }
      ],
      "admin": {
