    {
      "situation_uid": "90bc1607-2c91-54ec-b961-a47bdf1fae43",
      "event_id": "E02",
      "context_vi": "Bạn mua mì hộp cần đũa và sữa chua cần muỗng tại Midori.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "90bc1607-2c91-54ec-b961-a47bdf1fae43-u01",
          "speaker_id": "a",
          "ja": "この麺にお箸を一膳ください。",
          "vi": "Cho tôi một đôi đũa để ăn mì này ạ."
        },
        {
          "id": "90bc1607-2c91-54ec-b961-a47bdf1fae43-u02",
          "speaker_id": "b",
          "ja": "はい。ヨーグルトにスプーンもお付けしますか。",
          "vi": "Vâng. Sữa chua anh có cần muỗng không ạ?"
        },
        {
          "id": "90bc1607-2c91-54ec-b961-a47bdf1fae43-u03",
          "speaker_id": "a",
          "ja": "はい、スプーンも一つお願いします。",
          "vi": "Có, cho tôi thêm một cái muỗng ạ."
        },
        {
          "id": "90bc1607-2c91-54ec-b961-a47bdf1fae43-u04",
          "speaker_id": "b",
          "ja": "お箸一膳とスプーン一つですね。",
          "vi": "Một đôi đũa và một cái muỗng nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "food"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
