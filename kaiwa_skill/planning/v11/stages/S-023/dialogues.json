    {
      "situation_uid": "f7cdbc74-d9c5-5390-af41-d765c34b8798",
      "event_id": "E04",
      "context_vi": "Tại quầy Midori hư cấu, bạn vừa trả 1.000 yên cho món 380 yên. Thu ngân đưa tiền thừa, bạn đếm thấy khác; các số tiền chỉ là ví dụ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "f7cdbc74-d9c5-5390-af41-d765c34b8798-u01",
          "speaker_id": "a",
          "ja": "すみません。お釣りが六百円しかありません。確認していただけますか。",
          "vi": "Xin lỗi, tôi chỉ thấy 600 yên tiền thừa. Chị kiểm tra giúp được không ạ?"
        },
        {
          "id": "f7cdbc74-d9c5-5390-af41-d765c34b8798-u02",
          "speaker_id": "b",
          "ja": "はい。千円をお預かりして、商品は三百八十円です。お釣りは六百二十円ですね。今のお釣りを見せていただけますか。",
          "vi": "Vâng. Tôi nhận 1.000 yên, món hàng là 380 yên. Tiền thừa phải là 620 yên ạ. Anh cho tôi xem số tiền vừa nhận được không?"
        },
        {
          "id": "f7cdbc74-d9c5-5390-af41-d765c34b8798-u03",
          "speaker_id": "a",
          "ja": "はい、こちらです。二十円足りませんね。",
          "vi": "Vâng, đây ạ. Thiếu 20 yên nhỉ."
        },
        {
          "id": "f7cdbc74-d9c5-5390-af41-d765c34b8798-u04",
          "speaker_id": "b",
          "ja": "失礼しました。二十円をお渡しします。こちらでお確かめください。",
          "vi": "Tôi xin lỗi. Tôi gửi thêm 20 yên. Anh kiểm lại giúp ạ."
        }
      ],
