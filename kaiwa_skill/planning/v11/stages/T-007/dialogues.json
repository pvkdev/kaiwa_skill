    {
      "situation_uid": "faf379b6-d767-52e9-911f-f3fce93b1dd2",
      "event_id": "E02",
      "context_vi": "Bạn và đồng nghiệp Kato muốn thử cách phối hợp mới khi lịch họp đổi. Bạn đề nghị hành động cụ thể.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "faf379b6-d767-52e9-911f-f3fce93b1dd2-u01",
          "speaker_id": "a",
          "ja": "予定が変わったら、変更点だけ先に短く共有していただけますか。詳しい説明はあとでも大丈夫です。",
          "vi": "Khi lịch đổi, anh báo ngắn phần thay đổi trước giúp tôi được không? Giải thích chi tiết sau cũng được."
        },
        {
          "id": "faf379b6-d767-52e9-911f-f3fce93b1dd2-u02",
          "speaker_id": "b",
          "ja": "分かりました。僕が分かった時点で、まず時間と場所を送ります。",
          "vi": "Được. Khi tôi biết, tôi gửi giờ và địa điểm trước."
        },
        {
          "id": "faf379b6-d767-52e9-911f-f3fce93b1dd2-u03",
          "speaker_id": "a",
          "ja": "助かります。私も確認したら一言返信します。",
          "vi": "Thế giúp tôi nhiều lắm. Tôi xem xong sẽ trả lời một tiếng."
        },
        {
          "id": "faf379b6-d767-52e9-911f-f3fce93b1dd2-u04",
          "speaker_id": "b",
          "ja": "では、今週それで試しましょう。",
          "vi": "Vậy tuần này ta thử cách đó."
        }
      ],
      "admin": {
        "source_refs": [
