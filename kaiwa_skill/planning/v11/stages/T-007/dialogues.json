    {
      "situation_uid": "ddc5404c-fb4b-5dc1-8518-0e1587b76ae8",
      "event_id": "E03",
      "context_vi": "Sau khi bạn xin Yuta chỉ nghe trước, anh hỏi sâu chuyện gia đình. Bạn chưa muốn kể thêm và đặt giới hạn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn bè",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ddc5404c-fb4b-5dc1-8518-0e1587b76ae8-u01",
          "speaker_id": "b",
          "ja": "家でも何かあったの？",
          "vi": "Ở nhà cũng có chuyện à?"
        },
        {
          "id": "ddc5404c-fb4b-5dc1-8518-0e1587b76ae8-u02",
          "speaker_id": "a",
          "ja": "そこはまだ話したくないんだ。今は仕事の予定の話だけ聞いてもらえる？",
          "vi": "Phần đó tớ chưa muốn kể. Giờ cậu nghe chuyện lịch làm việc thôi nhé?"
        },
        {
          "id": "ddc5404c-fb4b-5dc1-8518-0e1587b76ae8-u03",
          "speaker_id": "b",
          "ja": "うん、分かった。聞きすぎてごめん。",
          "vi": "Ừ, tớ hiểu. Xin lỗi vì hỏi sâu."
        },
        {
          "id": "ddc5404c-fb4b-5dc1-8518-0e1587b76ae8-u04",
          "speaker_id": "a",
          "ja": "ありがとう。仕事のほうは、変更が続いて疲れたんだ。",
          "vi": "Cảm ơn cậu. Còn chuyện công việc là lịch cứ đổi nên tớ mệt."
        }
      ],
      "admin": {
