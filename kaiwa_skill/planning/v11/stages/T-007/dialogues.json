    {
      "situation_uid": "8f4f2a77-cfa7-5e67-9843-a91dc272b22e",
      "event_id": "E03",
      "context_vi": "Yuta nghĩ bạn nên nghỉ một ngày, còn bạn không thể sắp ngay. Bạn nhắc lại ý anh trước khi đáp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn bè",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8f4f2a77-cfa7-5e67-9843-a91dc272b22e-u01",
          "speaker_id": "b",
          "ja": "一日休んで、何も考えないほうがいいんじゃない？",
          "vi": "Hay cậu nghỉ một ngày, đừng nghĩ gì nữa?"
        },
        {
          "id": "8f4f2a77-cfa7-5e67-9843-a91dc272b22e-u02",
          "speaker_id": "a",
          "ja": "休む時間を作ったほうがいい、って心配してくれてるんだよね。",
          "vi": "Ý cậu là lo cho tớ và muốn tớ dành thời gian nghỉ, đúng không?"
        },
        {
          "id": "8f4f2a77-cfa7-5e67-9843-a91dc272b22e-u03",
          "speaker_id": "b",
          "ja": "うん。すぐ一日休めって決めつけたいわけじゃないよ。",
          "vi": "Ừ. Tớ không có ý ép cậu phải nghỉ nguyên ngày ngay."
        },
        {
          "id": "8f4f2a77-cfa7-5e67-9843-a91dc272b22e-u04",
          "speaker_id": "a",
          "ja": "ありがとう。まずは週末の午前を空けてみる。",
          "vi": "Cảm ơn. Trước mắt tớ sẽ để trống sáng cuối tuần."
        }
      ],
      "admin": {
