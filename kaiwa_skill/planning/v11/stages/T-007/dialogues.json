  "dialogues": [
    {
      "situation_uid": "7df9b972-d985-5b0b-8dea-7fcc3fc501c9",
      "event_id": "E01",
      "context_vi": "Sau một tuần bận rộn, bạn gặp Yuta và kể niềm vui nhỏ: cây ban công ra lá mới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn thân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7df9b972-d985-5b0b-8dea-7fcc3fc501c9-u01",
          "speaker_id": "a",
          "ja": "今週は忙しかったけど、ベランダの植物に新しい葉が出たんだ。ちょっとうれしくて。",
          "vi": "Tuần này bận quá, nhưng cây ngoài ban công ra lá mới. Tớ vui ghê."
        },
        {
          "id": "7df9b972-d985-5b0b-8dea-7fcc3fc501c9-u02",
          "speaker_id": "b",
          "ja": "いいね。毎朝水をやってた甲斐があったね。",
          "vi": "Hay quá. Công tưới mỗi sáng đã có kết quả rồi."
        },
        {
          "id": "7df9b972-d985-5b0b-8dea-7fcc3fc501c9-u03",
          "speaker_id": "a",
          "ja": "うん。帰って見るのが楽しみになったよ。",
          "vi": "Ừ. Giờ về nhà tớ lại mong ra xem cây."
        },
        {
          "id": "7df9b972-d985-5b0b-8dea-7fcc3fc501c9-u04",
          "speaker_id": "b",
          "ja": "写真、今度見せて。",
          "vi": "Hôm nào cho tớ xem ảnh nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "joy"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7df9b972-d985-5b0b-8dea-7fcc3fc501c9-u01": {
            "kind": "original_extension"
          },
