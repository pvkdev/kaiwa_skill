    {
      "situation_uid": "24fd427a-667a-5487-a8b3-439f84389da3",
      "event_id": "E02",
      "context_vi": "Bạn đề nghị Kato cố định lịch, nhưng anh không thể. Bạn hỏi phần phối hợp còn làm được.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "24fd427a-667a-5487-a8b3-439f84389da3-u01",
          "speaker_id": "a",
          "ja": "今週の打ち合わせ、時間を固定するのは難しいですか。",
          "vi": "Buổi họp tuần này khó giữ cố định giờ ạ?"
        },
        {
          "id": "24fd427a-667a-5487-a8b3-439f84389da3-u02",
          "speaker_id": "b",
          "ja": "すみません。相手先の予定もあるので、固定はできないんです。",
          "vi": "Xin lỗi chị. Còn phụ thuộc lịch phía đối tác nên tôi không cố định được."
        },
        {
          "id": "24fd427a-667a-5487-a8b3-439f84389da3-u03",
          "speaker_id": "a",
          "ja": "分かりました。では、変わる可能性が出た時点で一度知らせてもらえますか。",
          "vi": "Tôi hiểu. Vậy khi thấy có khả năng đổi, anh báo sơ cho tôi trước được không?"
        },
        {
          "id": "24fd427a-667a-5487-a8b3-439f84389da3-u04",
          "speaker_id": "b",
          "ja": "それならできます。決定前でも「調整中」と送ります。",
          "vi": "Việc đó làm được. Dù chưa chốt, tôi sẽ nhắn “đang điều chỉnh”."
        },
        {
          "id": "24fd427a-667a-5487-a8b3-439f84389da3-u05",
          "speaker_id": "a",
          "ja": "ありがとうございます。それなら準備の順番を変えやすいです。",
          "vi": "Cảm ơn anh. Như vậy tôi dễ đổi thứ tự chuẩn bị."
        }
      ],
      "admin": {
        "source_refs": [
          "worry"
