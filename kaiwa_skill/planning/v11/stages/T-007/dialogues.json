    {
      "situation_uid": "1aff0e2b-4b1a-5b00-b65d-709e11184905",
      "event_id": "E02",
      "context_vi": "Sau một tuần thử cách báo giờ và địa điểm trước, bạn nói với Kato cảm nhận thực tế và một điểm cần sửa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1aff0e2b-4b1a-5b00-b65d-709e11184905-u01",
          "speaker_id": "a",
          "ja": "今週は変更点を先に送ってもらえて、準備がしやすくなりました。ありがとうございます。",
          "vi": "Tuần này anh báo phần thay đổi trước nên tôi chuẩn bị dễ hơn. Cảm ơn anh."
        },
        {
          "id": "1aff0e2b-4b1a-5b00-b65d-709e11184905-u02",
          "speaker_id": "b",
          "ja": "よかったです。ほかに困ったところはありましたか。",
          "vi": "Vậy thì tốt. Còn chỗ nào bất tiện không?"
        },
        {
          "id": "1aff0e2b-4b1a-5b00-b65d-709e11184905-u03",
          "speaker_id": "a",
          "ja": "一度だけ、場所が後から変わったのを見落としました。次は件名にも「場所変更」と入れてもらえますか。",
          "vi": "Có một lần tôi bỏ sót việc địa điểm đổi sau đó. Lần sau anh ghi “đổi địa điểm” ngay ở tiêu đề giúp tôi nhé?"
        },
        {
          "id": "1aff0e2b-4b1a-5b00-b65d-709e11184905-u04",
          "speaker_id": "b",
          "ja": "分かりました。次からそうします。",
          "vi": "Được. Lần sau tôi làm vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "worry"
        ],
        "specialty_item_ids": [],
