          }
        }
      }
    },
    {
      "situation_uid": "d835f8b0-7b73-5d95-bd52-f9c4322d84b2",
      "event_id": "E01",
      "context_vi": "Tối đó Yuta đã nghe bạn kể hết chuyện lịch đổi. Bạn cảm ơn và hỏi thăm anh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn thân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d835f8b0-7b73-5d95-bd52-f9c4322d84b2-u01",
          "speaker_id": "a",
          "ja": "最後まで聞いてくれてありがとう。言葉にしたら少し整理できたよ。",
          "vi": "Cảm ơn cậu đã nghe đến cuối. Kể ra xong tớ thấy rõ lòng mình hơn."
        },
        {
          "id": "d835f8b0-7b73-5d95-bd52-f9c4322d84b2-u02",
          "speaker_id": "b",
          "ja": "それならよかった。明日は少し休めそう？",
          "vi": "Thế thì tốt. Mai cậu nghỉ được chút không?"
        },
        {
          "id": "d835f8b0-7b73-5d95-bd52-f9c4322d84b2-u03",
          "speaker_id": "a",
          "ja": "うん。午前は空けたよ。Yutaのほうは最近どう？",
          "vi": "Ừ, sáng mai tớ để trống rồi. Còn cậu dạo này thế nào?"
        },
        {
          "id": "d835f8b0-7b73-5d95-bd52-f9c4322d84b2-u04",
          "speaker_id": "b",
          "ja": "僕も話したいことがあるんだ。今度、時間ある？",
          "vi": "Tớ cũng có chuyện muốn kể. Hôm nào cậu rảnh?"
        }
      ],
      "admin": {
        "source_refs": [
          "worry"
        ],
