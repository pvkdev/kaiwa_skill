          },
          "1ad5b3a9-b1d1-5fd5-91cd-fd43b8f192f5-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "30ba6618-acbb-5775-81df-391481b2be9f",
      "event_id": "E01",
      "context_vi": "Bạn gặp Yuta sau một buổi làm việc căng. Bạn nói về áp lực vì lịch đổi liên tục, không buộc tội đồng nghiệp vắng mặt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn thân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "30ba6618-acbb-5775-81df-391481b2be9f-u01",
          "speaker_id": "a",
          "ja": "今週は予定が何度も変わって、準備が追いつかなくて疲れたよ。",
          "vi": "Tuần này lịch đổi mấy lần, tớ chuẩn bị không kịp nên mệt quá."
        },
        {
          "id": "30ba6618-acbb-5775-81df-391481b2be9f-u02",
          "speaker_id": "b",
          "ja": "それは落ち着かないね。何が一番大変だった？",
          "vi": "Thế thì khó yên tâm thật. Điều gì vất vả nhất?"
        },
        {
          "id": "30ba6618-acbb-5775-81df-391481b2be9f-u03",
          "speaker_id": "a",
          "ja": "変更そのものより、次に何を優先するか決め直すのが大変だった。",
          "vi": "Không hẳn là việc đổi lịch, mà là mỗi lần lại phải chọn việc ưu tiên."
        },
        {
          "id": "30ba6618-acbb-5775-81df-391481b2be9f-u04",
          "speaker_id": "b",
          "ja": "そうか。頭を切り替える回数が多かったんだね。",
          "vi": "Ra vậy. Cậu phải chuyển hướng suy nghĩ nhiều lần."
        }
      ],
      "admin": {
        "source_refs": [
          "worry"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "30ba6618-acbb-5775-81df-391481b2be9f-u01": {
            "kind": "original_extension"
