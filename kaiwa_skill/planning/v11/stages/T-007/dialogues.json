          }
        }
      }
    },
    {
      "situation_uid": "4e6c3a45-9406-506a-8986-5567ac81639b",
      "event_id": "E01",
      "context_vi": "Sau khi bạn kể chuyện lịch đổi liên tục, Yuta đang bận và chưa thể nghe tiếp. Hai bạn hẹn lúc khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn thân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4e6c3a45-9406-506a-8986-5567ac81639b-u01",
          "speaker_id": "b",
          "ja": "ごめん、今から出るところなんだ。続きは夜でもいい？",
          "vi": "Xin lỗi, tớ sắp đi. Tối nay nghe tiếp được không?"
        },
        {
          "id": "4e6c3a45-9406-506a-8986-5567ac81639b-u02",
          "speaker_id": "a",
          "ja": "うん、急ぎじゃないよ。何時ごろなら落ち着く？",
          "vi": "Ừ, không gấp đâu. Khoảng mấy giờ cậu rảnh?"
        },
        {
          "id": "4e6c3a45-9406-506a-8986-5567ac81639b-u03",
          "speaker_id": "b",
          "ja": "八時半なら家にいると思う。連絡するね。",
          "vi": "Tám rưỡi chắc tớ ở nhà. Tớ sẽ nhắn."
        },
        {
          "id": "4e6c3a45-9406-506a-8986-5567ac81639b-u04",
          "speaker_id": "a",
          "ja": "ありがとう。無理なら明日でも大丈夫。",
          "vi": "Cảm ơn cậu. Nếu không tiện thì mai cũng được."
        }
      ],
      "admin": {
        "source_refs": [
          "worry"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "4e6c3a45-9406-506a-8986-5567ac81639b-u01": {
