    {
      "situation_uid": "3be6e097-2532-5639-9c74-d2895a8c901d",
      "event_id": "E03",
      "context_vi": "Bạn tâm sự với Yuta. Anh bắt đầu cho lời khuyên, nhưng lúc này bạn chỉ muốn được nghe. Bạn nói nhu cầu nhẹ nhàng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn bè",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3be6e097-2532-5639-9c74-d2895a8c901d-u01",
          "speaker_id": "b",
          "ja": "それなら、すぐ上司に話したほうがいいよ。",
          "vi": "Thế cậu nên nói với cấp trên ngay."
        },
        {
          "id": "3be6e097-2532-5639-9c74-d2895a8c901d-u02",
          "speaker_id": "a",
          "ja": "考えてくれてありがとう。ただ、今日はまだ決めずに、まず話を聞いてもらえるとうれしい。",
          "vi": "Cảm ơn cậu đã nghĩ cho tớ. Nhưng hôm nay tớ chưa muốn quyết, trước mắt cậu nghe tớ kể nhé."
        },
        {
          "id": "3be6e097-2532-5639-9c74-d2895a8c901d-u03",
          "speaker_id": "b",
          "ja": "分かった。先に結論を出そうとしたね。続けて。",
          "vi": "Tớ hiểu. Tớ vội đưa kết luận rồi. Cậu kể tiếp đi."
        },
        {
          "id": "3be6e097-2532-5639-9c74-d2895a8c901d-u04",
          "speaker_id": "a",
          "ja": "ありがとう。予定がまた変わるかもしれないと思うと、落ち着かなくて。",
          "vi": "Cảm ơn cậu. Cứ nghĩ lịch lại có thể đổi là tớ không yên."
        }
      ],
      "admin": {
