          }
        }
      }
    },
    {
      "situation_uid": "ac49217d-ddc0-5c70-a035-c2e939478453",
      "event_id": "E02",
      "context_vi": "Sau khi bạn nói lịch đổi liên tục khiến mình khó chuẩn bị, anh Kato tưởng bạn trách anh. Bạn làm rõ mục đích.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ac49217d-ddc0-5c70-a035-c2e939478453-u01",
          "speaker_id": "b",
          "ja": "変更を伝えた僕を責めているように聞こえたんですが。",
          "vi": "Tôi nghe như chị đang trách người báo đổi lịch là tôi."
        },
        {
          "id": "ac49217d-ddc0-5c70-a035-c2e939478453-u02",
          "speaker_id": "a",
          "ja": "そう聞こえたならすみません。加藤さんを責めたいわけではなく、次の準備をどう進めるか相談したかったんです。",
          "vi": "Nếu nghe thành vậy thì xin lỗi anh. Tôi không định trách anh Kato; tôi muốn bàn cách chuẩn bị tiếp."
        },
        {
          "id": "ac49217d-ddc0-5c70-a035-c2e939478453-u03",
          "speaker_id": "b",
          "ja": "そういうことでしたか。今、分かっている変更は二件です。",
          "vi": "Ra vậy. Hiện có hai thay đổi đã biết."
        },
        {
          "id": "ac49217d-ddc0-5c70-a035-c2e939478453-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。まずその二件を確認してもいいですか。",
          "vi": "Cảm ơn anh. Ta kiểm hai việc đó trước được không?"
        }
      ],
      "admin": {
