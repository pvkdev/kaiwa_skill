    {
      "situation_uid": "5becafed-4744-5bba-90e0-c5f55b0083f6",
      "event_id": "E03",
      "context_vi": "Yuta gợi ý bạn ghi lại các lần lịch đổi. Bạn thấy một phần hữu ích và chọn thử phần đó.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn bè",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5becafed-4744-5bba-90e0-c5f55b0083f6-u01",
          "speaker_id": "b",
          "ja": "変更があった日だけ、短くメモしてみたら？",
          "vi": "Hay cậu ghi ngắn những ngày lịch đổi?"
        },
        {
          "id": "5becafed-4744-5bba-90e0-c5f55b0083f6-u02",
          "speaker_id": "a",
          "ja": "それならできそう。細かい感情まで書くのは今は大変だけど、日時なら残せる。",
          "vi": "Phần đó tớ làm được. Ghi cả cảm xúc thì giờ hơi quá sức, nhưng ghi ngày giờ thì được."
        },
        {
          "id": "5becafed-4744-5bba-90e0-c5f55b0083f6-u03",
          "speaker_id": "b",
          "ja": "それで十分だよ。後で振り返りやすくなるかも。",
          "vi": "Thế là đủ rồi. Có lẽ sau này dễ nhìn lại hơn."
        },
        {
          "id": "5becafed-4744-5bba-90e0-c5f55b0083f6-u04",
          "speaker_id": "a",
          "ja": "うん。今週は日時だけ試してみる。",
          "vi": "Ừ. Tuần này tớ chỉ thử ghi ngày giờ."
        }
      ],
      "admin": {
