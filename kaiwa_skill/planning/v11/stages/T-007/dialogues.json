      }
    },
    {
      "situation_uid": "71d55277-256e-5443-be54-9eb27412d054",
      "event_id": "E02",
      "context_vi": "Bạn nói với đồng nghiệp anh Kato rằng mình căng vì lịch họp đổi liên tục, nêu tác động lên phần chuẩn bị của mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "71d55277-256e-5443-be54-9eb27412d054-u01",
          "speaker_id": "a",
          "ja": "最近、打ち合わせの時間が何度か変わって、準備の順番を組み直すのが少し大変なんです。",
          "vi": "Gần đây giờ họp đổi mấy lần, tôi hơi khó sắp lại thứ tự chuẩn bị."
        },
        {
          "id": "71d55277-256e-5443-be54-9eb27412d054-u02",
          "speaker_id": "b",
          "ja": "そうでしたか。急な変更が続きましたね。",
          "vi": "Vậy à. Đúng là đã đổi gấp liên tục."
        },
        {
          "id": "71d55277-256e-5443-be54-9eb27412d054-u03",
          "speaker_id": "a",
          "ja": "はい。どこを先に確認すればいいか、相談したくて。",
          "vi": "Vâng. Tôi muốn bàn xem phần nào cần kiểm trước."
        },
        {
          "id": "71d55277-256e-5443-be54-9eb27412d054-u04",
          "speaker_id": "b",
          "ja": "分かりました。今の予定を一緒に見ましょう。",
          "vi": "Được. Ta cùng xem lịch hiện tại."
        }
      ],
      "admin": {
        "source_refs": [
          "worry"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "71d55277-256e-5443-be54-9eb27412d054-u01": {
