    {
      "situation_uid": "b4e80813-4047-560c-8481-31faf0f5bdd4",
      "event_id": "E03",
      "context_vi": "Sau khi Yuta giải thích lời khuyên về nghỉ ngơi, bạn muốn để cả hai bình tĩnh trước khi bàn tiếp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn bè",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b4e80813-4047-560c-8481-31faf0f5bdd4-u01",
          "speaker_id": "a",
          "ja": "気にかけてくれてありがとう。今は少し頭がいっぱいだから、続きは明日でもいい？",
          "vi": "Cảm ơn cậu đã lo cho tớ. Giờ đầu óc tớ hơi rối, mai nói tiếp được không?"
        },
        {
          "id": "b4e80813-4047-560c-8481-31faf0f5bdd4-u02",
          "speaker_id": "b",
          "ja": "もちろん。今日はここまでにしよう。",
          "vi": "Được chứ. Hôm nay dừng ở đây."
        },
        {
          "id": "b4e80813-4047-560c-8481-31faf0f5bdd4-u03",
          "speaker_id": "a",
          "ja": "明日の夜なら落ち着いて話せそう。",
          "vi": "Tối mai có lẽ tớ sẽ nói chuyện bình tĩnh hơn."
        },
        {
          "id": "b4e80813-4047-560c-8481-31faf0f5bdd4-u04",
          "speaker_id": "b",
          "ja": "分かった。明日、都合を聞いてから連絡するね。",
          "vi": "Ừ. Mai tớ sẽ hỏi xem cậu có tiện rồi mới gọi."
        }
      ],
