          }
        }
      }
    },
    {
      "situation_uid": "1ad5b3a9-b1d1-5fd5-91cd-fd43b8f192f5",
      "event_id": "E01",
      "context_vi": "Yuta không hiểu vì sao một lá cây khiến bạn vui. Bạn thêm bối cảnh tuần khó khăn mà không làm quá.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn thân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1ad5b3a9-b1d1-5fd5-91cd-fd43b8f192f5-u01",
          "speaker_id": "b",
          "ja": "葉っぱ一枚で、そんなにうれしかったの？",
          "vi": "Chỉ một chiếc lá mà cậu vui đến vậy à?"
        },
        {
          "id": "1ad5b3a9-b1d1-5fd5-91cd-fd43b8f192f5-u02",
          "speaker_id": "a",
          "ja": "今週は仕事で思うように進まないことが多くて。毎日少しずつ育つのを見たら、ほっとしたんだ。",
          "vi": "Tuần này công việc nhiều thứ không theo ý. Thấy cây lớn từng chút mỗi ngày, tớ nhẹ lòng."
        },
        {
          "id": "1ad5b3a9-b1d1-5fd5-91cd-fd43b8f192f5-u03",
          "speaker_id": "b",
          "ja": "そういうことか。小さい変化でも励みになるよね。",
          "vi": "Ra thế. Một thay đổi nhỏ cũng có thể động viên mình nhỉ."
        },
        {
          "id": "1ad5b3a9-b1d1-5fd5-91cd-fd43b8f192f5-u04",
          "speaker_id": "a",
          "ja": "うん。Yutaは最近、何かうれしかったことある？",
          "vi": "Ừ. Gần đây cậu có chuyện gì vui không?"
        }
      ],
      "admin": {
        "source_refs": [
          "joy"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1ad5b3a9-b1d1-5fd5-91cd-fd43b8f192f5-u01": {
            "kind": "original_extension"
          },
