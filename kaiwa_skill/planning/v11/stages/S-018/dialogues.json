    {
      "situation_uid": "2782e9cf-93c0-5a2d-aee6-b20ab88924f1",
      "event_id": "E03",
      "context_vi": "Ở Aoba hư cấu, hai đồng nghiệp nói khác nhau về việc có thể dùng phòng họp lúc trưa. Bạn nói với leader điều mình nghe và xin thông tin chắc chắn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2782e9cf-93c0-5a2d-aee6-b20ab88924f1-u01",
          "speaker_id": "a",
          "ja": "会議室は昼に使えると聞きました。でも、使えないとも聞きました。どちらですか。",
