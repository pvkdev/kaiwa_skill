    {
      "situation_uid": "15b93aab-deef-5be1-8a56-6ec22c21986d",
      "event_id": "E02",
      "context_vi": "Tại Aoba hư cấu, bạn mang túi và áo khoác. Bạn hỏi người hướng dẫn chỗ để đồ cá nhân của mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "15b93aab-deef-5be1-8a56-6ec22c21986d-u01",
          "speaker_id": "a",
          "ja": "私のかばんとコートはどこに置きますか。",
          "vi": "Túi và áo khoác của tôi để đâu ạ?"
        },
        {
          "id": "15b93aab-deef-5be1-8a56-6ec22c21986d-u02",
          "speaker_id": "b",
          "ja": "名前のあるロッカーに入れてください。",
          "vi": "Chị để vào tủ có tên mình nhé."
        },
        {
          "id": "15b93aab-deef-5be1-8a56-6ec22c21986d-u03",
          "speaker_id": "a",
          "ja": "はい、名前を見ます。",
          "vi": "Vâng, tôi sẽ xem tên."
        }
      ],
      "admin": {
        "source_refs": [
          "supplies"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "15b93aab-deef-5be1-8a56-6ec22c21986d-u01": {
