        }
      }
    },
    {
      "situation_uid": "52ae30a4-9a8d-54f0-90e9-39f8a80b0db3",
      "event_id": "E02",
      "context_vi": "Ở Aoba hư cấu, bạn cần mang máy tính của công ty về nhà để chuẩn bị nhưng chưa biết quy tắc. Bạn hỏi người phụ trách trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "52ae30a4-9a8d-54f0-90e9-39f8a80b0db3-u01",
          "speaker_id": "a",
          "ja": "会社のパソコンを家に持って帰ってもいいですか。",
          "vi": "Tôi mang máy tính công ty về nhà được không ạ?"
        },
        {
          "id": "52ae30a4-9a8d-54f0-90e9-39f8a80b0db3-u02",
          "speaker_id": "b",
          "ja": "このパソコンは、持ち出せません。",
          "vi": "Máy này không được mang ra ngoài."
        },
        {
          "id": "52ae30a4-9a8d-54f0-90e9-39f8a80b0db3-u03",
          "speaker_id": "a",
          "ja": "わかりました。ここで使います。",
          "vi": "Tôi hiểu. Tôi sẽ dùng ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "supplies"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "52ae30a4-9a8d-54f0-90e9-39f8a80b0db3-u01": {
