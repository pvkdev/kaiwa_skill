        }
      }
    },
    {
      "situation_uid": "2b2d1964-e97f-5af5-b577-97ea4a2b1cef",
      "event_id": "E02",
      "context_vi": "Tiếp lời từ chối mang chiếc máy Aoba này ra ngoài. Bạn cần xem tài liệu trên máy, nên hỏi cách làm ngay tại văn phòng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2b2d1964-e97f-5af5-b577-97ea4a2b1cef-u01",
          "speaker_id": "a",
          "ja": "では、今日、ここで資料を見てもいいですか。",
          "vi": "Vậy hôm nay tôi xem tài liệu ở đây được không ạ?"
        },
        {
          "id": "2b2d1964-e97f-5af5-b577-97ea4a2b1cef-u02",
          "speaker_id": "b",
          "ja": "はい。奥の席を使ってください。",
          "vi": "Được. Chị dùng bàn phía trong nhé."
        },
        {
          "id": "2b2d1964-e97f-5af5-b577-97ea4a2b1cef-u03",
          "speaker_id": "a",
          "ja": "奥の席ですね。ありがとうございます。",
          "vi": "Bàn phía trong nhỉ. Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "supplies"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "2b2d1964-e97f-5af5-b577-97ea4a2b1cef-u01": {
