  "dialogues": [
    {
      "situation_uid": "00eb83f8-90a4-5abe-92fd-9ea2c0d73e50",
      "event_id": "E01",
      "context_vi": "Ngày đầu ở công ty Aoba hư cấu, leader nam nói ca bắt đầu lúc 9 giờ. Bạn hỏi cần có mặt trước mấy giờ và phải báo cho ai nếu tàu trễ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "00eb83f8-90a4-5abe-92fd-9ea2c0d73e50-u01",
          "speaker_id": "a",
          "ja": "仕事は九時からですね。何時に来ればいいですか。電車が遅れたら、誰に連絡しますか。",
          "vi": "Ca bắt đầu lúc 9 giờ nhỉ. Tôi nên đến lúc mấy giờ? Nếu tàu trễ, tôi báo ai ạ?"
        },
        {
          "id": "00eb83f8-90a4-5abe-92fd-9ea2c0d73e50-u02",
          "speaker_id": "b",
          "ja": "八時五十分までに来てください。遅れるときは私に電話してください。",
          "vi": "Chị có mặt muộn nhất lúc 8 giờ 50. Nếu đến trễ thì gọi cho tôi."
        },
        {
          "id": "00eb83f8-90a4-5abe-92fd-9ea2c0d73e50-u03",
          "speaker_id": "a",
          "ja": "八時五十分までに来て、遅れるときはリーダーに電話ですね。",
          "vi": "Tôi có mặt muộn nhất 8 giờ 50, nếu trễ thì gọi cho anh nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "00eb83f8-90a4-5abe-92fd-9ea2c0d73e50-u01": {
            "kind": "original_extension"
          },
