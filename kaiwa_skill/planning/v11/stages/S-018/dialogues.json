          },
          "1bc076ba-95d3-580e-b745-3077a2ec095b-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "ecc3353f-021f-567b-8686-1f407c81f4b9",
      "event_id": "E01",
      "context_vi": "Sáng hôm sau ở Aoba, bạn nhắc lại hạn có mặt sau khi đã hiểu nhầm 8:50 với 9:00 hôm trước. Leader xác nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ecc3353f-021f-567b-8686-1f407c81f4b9-u01",
          "speaker_id": "a",
          "ja": "今日は八時五十分までに来ました。仕事は九時からですね。",
          "vi": "Hôm nay tôi đã có mặt đúng hạn 8 giờ 50. Ca bắt đầu 9 giờ nhỉ."
        },
        {
          "id": "ecc3353f-021f-567b-8686-1f407c81f4b9-u02",
          "speaker_id": "b",
          "ja": "はい、そのとおりです。",
          "vi": "Đúng rồi."
        },
        {
          "id": "ecc3353f-021f-567b-8686-1f407c81f4b9-u03",
          "speaker_id": "a",
          "ja": "では、九時に始めます。",
          "vi": "Vậy tôi bắt đầu lúc 9 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ecc3353f-021f-567b-8686-1f407c81f4b9-u01": {
