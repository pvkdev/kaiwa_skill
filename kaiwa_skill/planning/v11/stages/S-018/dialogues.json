            "kind": "original_extension"
          },
          "00eb83f8-90a4-5abe-92fd-9ea2c0d73e50-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7cfbcdc5-db20-52da-b596-c33801d714f4",
      "event_id": "E01",
      "context_vi": "Tiếp cuộc trao đổi ở Aoba: bạn tưởng 8:50 là giờ bắt đầu ca, trong khi leader đã nói 9:00. Bạn hỏi lại để phân biệt hai mốc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7cfbcdc5-db20-52da-b596-c33801d714f4-u01",
          "speaker_id": "a",
          "ja": "八時五十分から仕事を始めますか。",
          "vi": "Tôi bắt đầu làm từ 8 giờ 50 ạ?"
        },
        {
          "id": "7cfbcdc5-db20-52da-b596-c33801d714f4-u02",
          "speaker_id": "b",
          "ja": "いいえ。八時五十分までに来て、仕事は九時からです。",
          "vi": "Không. Chị có mặt muộn nhất lúc 8 giờ 50, ca bắt đầu lúc 9 giờ."
        },
        {
          "id": "7cfbcdc5-db20-52da-b596-c33801d714f4-u03",
          "speaker_id": "a",
          "ja": "来る時間と始める時間が違うんですね。",
          "vi": "Giờ có mặt và giờ bắt đầu khác nhau nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7cfbcdc5-db20-52da-b596-c33801d714f4-u01": {
            "kind": "original_extension"
          },
          "7cfbcdc5-db20-52da-b596-c33801d714f4-u02": {
            "kind": "original_extension"
          },
          "7cfbcdc5-db20-52da-b596-c33801d714f4-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "42c2ed8b-1745-586a-9a06-4d49af944fed",
      "event_id": "E01",
      "context_vi": "Trong tòa nhà Aoba hư cấu, một phòng chứa hồ sơ có biển chỉ nhân viên phụ trách vào. Bạn hỏi leader khu nào cần xin phép trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "42c2ed8b-1745-586a-9a06-4d49af944fed-u01",
          "speaker_id": "a",
          "ja": "この部屋には、入る前に聞きますか。",
          "vi": "Trước khi vào phòng này tôi cần hỏi ạ?"
        },
        {
          "id": "42c2ed8b-1745-586a-9a06-4d49af944fed-u02",
          "speaker_id": "b",
          "ja": "はい。資料室は私に聞いてから入ってください。",
          "vi": "Vâng. Trước khi vào phòng hồ sơ, chị hỏi tôi nhé."
        },
        {
          "id": "42c2ed8b-1745-586a-9a06-4d49af944fed-u03",
          "speaker_id": "a",
          "ja": "わかりました。今日は入りません。",
          "vi": "Tôi rõ rồi. Hôm nay tôi chưa vào."
        }
      ],
      "admin": {
        "source_refs": [
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "42c2ed8b-1745-586a-9a06-4d49af944fed-u01": {
            "kind": "original_extension"
          },
          "42c2ed8b-1745-586a-9a06-4d49af944fed-u02": {
            "kind": "original_extension"
          },
          "42c2ed8b-1745-586a-9a06-4d49af944fed-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "1bc076ba-95d3-580e-b745-3077a2ec095b",
      "event_id": "E01",
      "context_vi": "Ca làm ở Aoba hư cấu có một khoảng nghỉ giữa buổi. Bạn hỏi leader hôm nay mình nghỉ lúc nào, không suy đoán từ lịch người khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1bc076ba-95d3-580e-b745-3077a2ec095b-u01",
          "speaker_id": "a",
          "ja": "今日の休憩は何時ですか。",
          "vi": "Hôm nay tôi nghỉ lúc mấy giờ ạ?"
        },
        {
          "id": "1bc076ba-95d3-580e-b745-3077a2ec095b-u02",
          "speaker_id": "b",
          "ja": "十一時から十五分です。",
          "vi": "Từ 11 giờ, 15 phút."
        },
        {
          "id": "1bc076ba-95d3-580e-b745-3077a2ec095b-u03",
          "speaker_id": "a",
          "ja": "十一時からですね。",
          "vi": "Từ 11 giờ nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1bc076ba-95d3-580e-b745-3077a2ec095b-u01": {
            "kind": "original_extension"
          },
