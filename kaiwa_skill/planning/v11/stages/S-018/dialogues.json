        }
      }
    },
    {
      "situation_uid": "a034b71f-7851-5a0b-804f-34c8c9b54787",
      "event_id": "E02",
      "context_vi": "Bạn thấy một tập tài liệu Aoba hư cấu bị để quên ở bàn chung. Bạn không biết của ai và báo người phụ trách để giao đúng người.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a034b71f-7851-5a0b-804f-34c8c9b54787-u01",
          "speaker_id": "a",
          "ja": "共用の机に、この資料がありました。誰に渡せばいいですか。",
          "vi": "Có tập tài liệu này trên bàn chung. Tôi nên đưa cho ai ạ?"
        },
        {
          "id": "a034b71f-7851-5a0b-804f-34c8c9b54787-u02",
          "speaker_id": "b",
          "ja": "私に渡してください。持ち主を確認します。",
          "vi": "Chị đưa tôi. Tôi sẽ kiểm tra chủ của nó."
        },
        {
          "id": "a034b71f-7851-5a0b-804f-34c8c9b54787-u03",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Nhờ anh."
        }
      ],
      "admin": {
        "source_refs": [
          "supplies"
        ],
        "specialty_item_ids": [],
