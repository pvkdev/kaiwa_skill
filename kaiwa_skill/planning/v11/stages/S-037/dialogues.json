          }
        }
      }
    },
    {
      "situation_uid": "cacac922-a00f-5b0a-853b-883b229d414c",
      "event_id": "E01",
      "context_vi": "Sau khi bạn hỏi chỗ cất mẫu giấy ở Kiri, đồng nghiệp có cuộc họp ngay nhưng có thể chỉ sau 14 giờ. Hai người hẹn lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "cacac922-a00f-5b0a-853b-883b229d414c-u01",
          "speaker_id": "b",
          "ja": "今から会議です。二時のあとなら案内できます。",
          "vi": "Giờ tôi vào họp. Sau 2 giờ tôi có thể chỉ cho bạn."
        },
        {
          "id": "cacac922-a00f-5b0a-853b-883b229d414c-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。二時十分にここへ戻ってもいいですか。",
          "vi": "Cảm ơn. Tôi quay lại đây lúc 2 giờ 10 được không?"
        },
        {
          "id": "cacac922-a00f-5b0a-853b-883b229d414c-u03",
          "speaker_id": "b",
          "ja": "はい。そのころなら大丈夫です。",
          "vi": "Được, lúc đó tôi rảnh."
        },
        {
          "id": "cacac922-a00f-5b0a-853b-883b229d414c-u04",
          "speaker_id": "a",
          "ja": "では、二時十分に伺います。",
          "vi": "Vậy 2 giờ 10 tôi quay lại."
        }
      ],
      "admin": {
        "source_refs": [
          "help"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "cacac922-a00f-5b0a-853b-883b229d414c-u01": {
