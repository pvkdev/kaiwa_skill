    {
      "situation_uid": "c040e525-6248-524e-ae56-3b84b5cf2b5f",
      "event_id": "E03",
      "context_vi": "Ở quầy công ty Kiri hư cấu, bạn đến nhận tài liệu in cho cuộc họp nhóm mình. Người phụ trách hỏi tên và bộ phận trước khi đưa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c040e525-6248-524e-ae56-3b84b5cf2b5f-u01",
          "speaker_id": "a",
          "ja": "会議の資料を受け取りに来ました。グエンです。",
          "vi": "Tôi đến nhận tài liệu họp. Tôi là Nguyễn ạ."
        },
        {
          "id": "c040e525-6248-524e-ae56-3b84b5cf2b5f-u02",
          "speaker_id": "b",
          "ja": "どの部署の資料ですか。",
          "vi": "Tài liệu của bộ phận nào ạ?"
        },
        {
          "id": "c040e525-6248-524e-ae56-3b84b5cf2b5f-u03",
          "speaker_id": "a",
          "ja": "営業一課です。名前と部署を確認してください。",
          "vi": "Phòng kinh doanh nhóm một ạ. Chị kiểm tra tên và bộ phận giúp tôi."
        },
        {
          "id": "c040e525-6248-524e-ae56-3b84b5cf2b5f-u04",
          "speaker_id": "b",
          "ja": "はい。資料の表紙を見ますね。",
          "vi": "Vâng. Tôi xem bìa tài liệu nhé."
        }
      ],
