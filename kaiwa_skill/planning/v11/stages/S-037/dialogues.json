          "ja": "仮カードの準備はできましたか。受け取りに来ました。",
          "vi": "Thẻ tạm đã sẵn sàng chưa ạ? Tôi đến nhận."
        },
        {
          "id": "ac65f8e9-f5c2-55c7-9fb1-086cb63c0e64-u02",
          "speaker_id": "b",
          "ja": "はい。こちらです。お名前を確認してください。",
          "vi": "Rồi ạ. Đây, anh kiểm tra tên nhé."
        },
        {
          "id": "ac65f8e9-f5c2-55c7-9fb1-086cb63c0e64-u03",
          "speaker_id": "a",
          "ja": "グエンと書いてあります。私の名前です。受け取ります。",
          "vi": "Thẻ ghi Nguyễn, đúng tên tôi. Tôi xin nhận."
        },
        {
          "id": "ac65f8e9-f5c2-55c7-9fb1-086cb63c0e64-u04",
          "speaker_id": "b",
          "ja": "はい。どうぞ。",
          "vi": "Vâng, mời anh."
        }
