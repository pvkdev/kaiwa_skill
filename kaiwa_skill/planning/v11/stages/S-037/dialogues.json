    {
      "situation_uid": "d300417f-825e-5bbe-8c17-9aeb10a09c20",
      "event_id": "E02",
      "context_vi": "Người quản lý văn phòng Kiri báo máy chiếu đã được đặt đúng giờ bạn cần. Bạn hỏi xem có màn hình hoặc thiết bị khác dùng được không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người quản lý văn phòng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d300417f-825e-5bbe-8c17-9aeb10a09c20-u01",
          "speaker_id": "b",
          "ja": "その時間、プロジェクターは別の人が予約しています。",
          "vi": "Giờ đó máy chiếu đã có người khác đặt rồi ạ."
        },
        {
          "id": "d300417f-825e-5bbe-8c17-9aeb10a09c20-u02",
          "speaker_id": "a",
          "ja": "分かりました。代わりに使える画面はありますか。",
          "vi": "Tôi hiểu. Có màn hình nào dùng thay được không ạ?"
        },
        {
          "id": "d300417f-825e-5bbe-8c17-9aeb10a09c20-u03",
          "speaker_id": "b",
          "ja": "会議室のモニターなら空いています。接続を確認しますか。",
          "vi": "Màn hình trong phòng họp còn trống. Anh muốn kiểm tra kết nối không?"
        },
        {
          "id": "d300417f-825e-5bbe-8c17-9aeb10a09c20-u04",
          "speaker_id": "a",
          "ja": "はい。先に見てから決めます。",
          "vi": "Vâng. Tôi xem trước rồi quyết định."
        }
      ],
      "admin": {
        "source_refs": [
          "office_permission",
          "projector"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d300417f-825e-5bbe-8c17-9aeb10a09c20-u01": {
