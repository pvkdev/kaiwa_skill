    {
      "situation_uid": "aaaa8ab5-e3e5-55e0-91e3-390f008f92d6",
      "event_id": "E01",
      "context_vi": "Sau khi bạn hỏi chỗ cất mẫu giấy ở Kiri, đồng nghiệp báo đang bận và không thể chỉ lúc này. Bạn hỏi người khác có thể giúp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "aaaa8ab5-e3e5-55e0-91e3-390f008f92d6-u01",
          "speaker_id": "b",
          "ja": "すみません。今は急ぎの仕事があって案内できません。",
          "vi": "Xin lỗi, giờ tôi có việc gấp nên không dẫn bạn đi được."
        },
        {
          "id": "aaaa8ab5-e3e5-55e0-91e3-390f008f92d6-u02",
          "speaker_id": "a",
          "ja": "分かりました。ほかに場所を知っている人はいますか。",
          "vi": "Tôi hiểu. Có ai khác biết chỗ cất không?"
        },
        {
          "id": "aaaa8ab5-e3e5-55e0-91e3-390f008f92d6-u03",
          "speaker_id": "b",
          "ja": "受付の田中さんに聞いてみてください。",
          "vi": "Bạn thử hỏi chị Tanaka ở quầy lễ tân nhé."
        },
        {
          "id": "aaaa8ab5-e3e5-55e0-91e3-390f008f92d6-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。田中さんに聞きます。",
          "vi": "Cảm ơn. Tôi sẽ hỏi chị Tanaka."
        }
      ],
      "admin": {
        "source_refs": [
          "help"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "aaaa8ab5-e3e5-55e0-91e3-390f008f92d6-u01": {
            "kind": "original_extension"
