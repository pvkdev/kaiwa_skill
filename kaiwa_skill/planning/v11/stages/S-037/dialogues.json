    {
      "situation_uid": "66cde448-c1a2-583b-b48d-01fe5a4b0914",
      "event_id": "E02",
      "context_vi": "Sau khi mượn máy chiếu từ 14 đến 15 giờ ở Kiri, bạn mang trả đúng quầy trước 15 giờ và báo máy hoạt động bình thường.",
      "speakers": [
