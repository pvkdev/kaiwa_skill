    {
      "situation_uid": "7bf41e16-a60c-50cf-8671-2f8fc454c22c",
      "event_id": "E03",
      "context_vi": "Ở quầy công ty Kiri hư cấu, thẻ nhân viên của bạn đang được thay mới, còn thẻ tạm mang tên bạn chưa chuẩn bị xong. Bạn hỏi lúc nào có thể nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "7bf41e16-a60c-50cf-8671-2f8fc454c22c-u01",
          "speaker_id": "a",
          "ja": "私の仮カードは、いつ受け取れますか。",
          "vi": "Thẻ tạm của tôi thì khi nào nhận được ạ?"
        },
        {
          "id": "7bf41e16-a60c-50cf-8671-2f8fc454c22c-u02",
          "speaker_id": "b",
          "ja": "今、準備しています。三時ごろの予定です。",
          "vi": "Chúng tôi đang chuẩn bị. Dự kiến khoảng 3 giờ ạ."
        },
        {
          "id": "7bf41e16-a60c-50cf-8671-2f8fc454c22c-u03",
          "speaker_id": "a",
          "ja": "分かりました。三時にここへ来てもいいですか。",
          "vi": "Tôi hiểu. 3 giờ tôi quay lại đây được không?"
        },
        {
          "id": "7bf41e16-a60c-50cf-8671-2f8fc454c22c-u04",
          "speaker_id": "b",
          "ja": "はい。準備ができたか、先に確認してください。",
          "vi": "Được. Trước khi nhận, anh hỏi lại xem đã sẵn sàng nhé."
        }
      ],
