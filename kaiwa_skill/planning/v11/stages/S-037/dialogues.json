        }
      }
    },
    {
      "situation_uid": "828c41e8-be92-5b92-888f-eb3a4628df74",
      "event_id": "E01",
      "context_vi": "Sau khi bạn hỏi mẫu ghi tên người dự họp ở Kiri, đồng nghiệp dẫn tới tủ bên cạnh máy in. Bạn nhắc lại đúng chỗ cất.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "828c41e8-be92-5b92-888f-eb3a4628df74-u01",
          "speaker_id": "b",
          "ja": "こちらです。印刷機の隣の棚、上から二段目です。",
          "vi": "Ở đây. Tủ cạnh máy in, ngăn thứ hai từ trên xuống."
        },
        {
          "id": "828c41e8-be92-5b92-888f-eb3a4628df74-u02",
          "speaker_id": "a",
          "ja": "印刷機の隣の棚、二段目ですね。",
          "vi": "Tủ cạnh máy in, ngăn thứ hai nhé."
        },
        {
          "id": "828c41e8-be92-5b92-888f-eb3a4628df74-u03",
          "speaker_id": "b",
          "ja": "はい。この箱に入っています。",
          "vi": "Đúng, trong hộp này."
        },
        {
          "id": "828c41e8-be92-5b92-888f-eb3a4628df74-u04",
          "speaker_id": "a",
          "ja": "見つかりました。案内してくれてありがとうございます。",
          "vi": "Tôi thấy rồi. Cảm ơn chị đã dẫn tới."
        }
      ],
      "admin": {
        "source_refs": [
          "help"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "828c41e8-be92-5b92-888f-eb3a4628df74-u01": {
