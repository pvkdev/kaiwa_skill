    {
      "situation_uid": "4e7f2f73-ed5a-5d30-8934-86ed1d80a5be",
      "event_id": "E02",
      "context_vi": "Sau khi bạn hỏi mượn máy chiếu chiều nay ở Kiri, người quản lý cần kiểm lịch của phòng khác; chưa có lời cho mượn. Bạn hẹn giờ nhận câu trả lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người quản lý văn phòng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4e7f2f73-ed5a-5d30-8934-86ed1d80a5be-u01",
          "speaker_id": "b",
          "ja": "別の部屋でも使う予定があるか確認します。まだ貸せるとは言えません。",
          "vi": "Tôi kiểm tra xem phòng khác có dùng không. Giờ chưa thể nói cho mượn được."
        },
        {
          "id": "4e7f2f73-ed5a-5d30-8934-86ed1d80a5be-u02",
          "speaker_id": "a",
          "ja": "分かりました。何時ごろ返事をいただけますか。",
          "vi": "Tôi hiểu. Khoảng mấy giờ chị trả lời được ạ?"
        },
        {
          "id": "4e7f2f73-ed5a-5d30-8934-86ed1d80a5be-u03",
          "speaker_id": "b",
          "ja": "十一時までにお知らせします。",
          "vi": "Trước 11 giờ tôi sẽ báo."
        },
        {
          "id": "4e7f2f73-ed5a-5d30-8934-86ed1d80a5be-u04",
          "speaker_id": "a",
