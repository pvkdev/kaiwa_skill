          }
        }
      }
    },
    {
      "situation_uid": "3d179c97-6eee-5182-bd7d-ce48f8000881",
      "event_id": "E02",
      "context_vi": "Người quản lý văn phòng ở Kiri kiểm lịch và đồng ý cho bạn mượn máy chiếu từ 14 đến 15 giờ. Bạn hỏi giờ và nơi trả.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người quản lý văn phòng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "3d179c97-6eee-5182-bd7d-ce48f8000881-u01",
          "speaker_id": "b",
          "ja": "二時から三時まで、お貸しできます。",
          "vi": "Anh mượn được từ 2 đến 3 giờ ạ."
        },
        {
          "id": "3d179c97-6eee-5182-bd7d-ce48f8000881-u02",
          "speaker_id": "a",
          "ja": "三時までに、どこへ返せばいいですか。",
          "vi": "Trước 3 giờ tôi trả ở đâu ạ?"
        },
        {
          "id": "3d179c97-6eee-5182-bd7d-ce48f8000881-u03",
          "speaker_id": "b",
          "ja": "この窓口へ戻してください。",
          "vi": "Anh mang về quầy này nhé."
        },
        {
          "id": "3d179c97-6eee-5182-bd7d-ce48f8000881-u04",
          "speaker_id": "a",
          "ja": "分かりました。三時までにここへ返します。",
          "vi": "Tôi hiểu. Tôi sẽ trả ở đây trước 3 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "office_permission",
          "projector"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3d179c97-6eee-5182-bd7d-ce48f8000881-u01": {
