          }
        }
      }
    },
    {
      "situation_uid": "9605e558-05b7-5fde-929d-438561e7807b",
      "event_id": "E02",
      "context_vi": "Ở công ty Kiri hư cấu, bạn cần mượn máy chiếu cho cuộc họp chiều nay từ 14 đến 15 giờ. Người quản lý văn phòng cần kiểm lịch.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người quản lý văn phòng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9605e558-05b7-5fde-929d-438561e7807b-u01",
          "speaker_id": "a",
          "ja": "今日の二時から三時まで、プロジェクターをお借りできますか。",
          "vi": "Hôm nay từ 2 đến 3 giờ tôi mượn máy chiếu được không ạ?"
        },
        {
          "id": "9605e558-05b7-5fde-929d-438561e7807b-u02",
          "speaker_id": "b",
          "ja": "予定を確認します。どの会議で使いますか。",
          "vi": "Tôi kiểm tra lịch. Anh dùng cho cuộc họp nào?"
        },
        {
          "id": "9605e558-05b7-5fde-929d-438561e7807b-u03",
          "speaker_id": "a",
          "ja": "新しい企画の会議です。まだ借りずに返事を待ちます。",
          "vi": "Cuộc họp về kế hoạch mới ạ. Tôi sẽ đợi câu trả lời trước khi lấy."
        },
        {
          "id": "9605e558-05b7-5fde-929d-438561e7807b-u04",
          "speaker_id": "b",
          "ja": "はい。確認してお知らせします。",
          "vi": "Vâng. Tôi kiểm tra rồi báo anh."
        }
      ],
      "admin": {
        "source_refs": [
          "office_permission",
          "projector"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9605e558-05b7-5fde-929d-438561e7807b-u01": {
