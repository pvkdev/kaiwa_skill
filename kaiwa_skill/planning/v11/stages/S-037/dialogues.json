    {
      "situation_uid": "8094caaa-0b27-59c1-9e93-cb8f950d4b65",
      "event_id": "E03",
      "context_vi": "Sau khi bạn nói tên Nguyễn và bộ phận Kinh doanh nhóm một, người phụ trách cầm nhầm tài liệu của nhóm hai. Bạn nhận ra bìa khác và xác nhận lại trước khi nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8094caaa-0b27-59c1-9e93-cb8f950d4b65-u01",
          "speaker_id": "b",
          "ja": "こちらが営業二課の資料です。",
          "vi": "Đây là tài liệu của phòng kinh doanh nhóm hai ạ."
        },
        {
          "id": "8094caaa-0b27-59c1-9e93-cb8f950d4b65-u02",
          "speaker_id": "a",
          "ja": "すみません。私は営業一課です。表紙は二課になっています。",
          "vi": "Xin lỗi, tôi thuộc nhóm một. Bìa này ghi nhóm hai."
        },
        {
          "id": "8094caaa-0b27-59c1-9e93-cb8f950d4b65-u03",
          "speaker_id": "b",
          "ja": "失礼しました。一課の資料を探します。",
          "vi": "Xin lỗi anh. Tôi tìm tài liệu nhóm một."
        },
        {
          "id": "8094caaa-0b27-59c1-9e93-cb8f950d4b65-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。確認してから受け取ります。",
          "vi": "Cảm ơn chị. Tôi sẽ xác nhận rồi mới nhận."
        }
