          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người quản lý văn phòng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "66cde448-c1a2-583b-b48d-01fe5a4b0914-u01",
          "speaker_id": "a",
          "ja": "プロジェクターを返します。会議では問題なく使えました。",
          "vi": "Tôi trả máy chiếu. Trong cuộc họp máy chạy bình thường ạ."
        },
        {
          "id": "66cde448-c1a2-583b-b48d-01fe5a4b0914-u02",
          "speaker_id": "b",
          "ja": "ありがとうございます。三時前ですね。",
          "vi": "Cảm ơn anh. Vẫn trước 3 giờ ạ."
        },
        {
          "id": "66cde448-c1a2-583b-b48d-01fe5a4b0914-u03",
          "speaker_id": "a",
          "ja": "はい。ケーブルも一緒にあります。",
          "vi": "Vâng. Dây cáp cũng ở đây."
        },
        {
          "id": "66cde448-c1a2-583b-b48d-01fe5a4b0914-u04",
          "speaker_id": "b",
          "ja": "確認しました。ありがとうございました。",
          "vi": "Tôi đã kiểm tra. Cảm ơn anh."
        }
