  "dialogues": [
    {
      "situation_uid": "e5df3fec-e0ce-56d2-bf40-d2a50af84866",
      "event_id": "E01",
      "context_vi": "Ở công ty Kiri hư cấu, bạn cần biểu mẫu giấy cho cuộc họp và hỏi đồng nghiệp nó được cất ở đâu. Đồng nghiệp chưa trả lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e5df3fec-e0ce-56d2-bf40-d2a50af84866-u01",
          "speaker_id": "a",
          "ja": "ちょっといいですか。会議用の用紙はどこにありますか。",
          "vi": "Tôi hỏi chút được không? Mẫu giấy dùng cho cuộc họp ở đâu vậy?"
        },
        {
          "id": "e5df3fec-e0ce-56d2-bf40-d2a50af84866-u02",
          "speaker_id": "b",
          "ja": "どの用紙ですか。",
          "vi": "Mẫu nào vậy?"
        },
        {
          "id": "e5df3fec-e0ce-56d2-bf40-d2a50af84866-u03",
          "speaker_id": "a",
          "ja": "出席者の名前を書く用紙です。場所を教えてもらえますか。",
          "vi": "Mẫu ghi tên người dự họp ấy. Chị chỉ chỗ giúp tôi được không?"
        },
        {
          "id": "e5df3fec-e0ce-56d2-bf40-d2a50af84866-u04",
          "speaker_id": "b",
          "ja": "分かりました。場所を確認しますね。",
          "vi": "Được, để tôi xem chỗ cất nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "help"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e5df3fec-e0ce-56d2-bf40-d2a50af84866-u01": {
