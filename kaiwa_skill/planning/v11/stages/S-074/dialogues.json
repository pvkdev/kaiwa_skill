    {
      "situation_uid": "a91d4169-c3a1-5652-b6ea-33f1da4b8768",
      "event_id": "E02",
      "context_vi": "Bạn muốn ra bờ sông cùng người quen. Người đó nói trời có thể đổi nhanh, nên hai người chuẩn bị sẵn một điểm trong nhà.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người đi chơi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a91d4169-c3a1-5652-b6ea-33f1da4b8768-u01",
          "speaker_id": "B",
          "ja": "今日は天気が変わりやすいみたいですよ。",
          "vi": "Hôm nay hình như thời tiết dễ thay đổi đấy."
        },
        {
          "id": "a91d4169-c3a1-5652-b6ea-33f1da4b8768-u02",
          "speaker_id": "A",
          "ja": "雨が降ったら、どこに行きましょうか。",
          "vi": "Nếu trời mưa thì mình đi đâu ạ?"
        },
        {
          "id": "a91d4169-c3a1-5652-b6ea-33f1da4b8768-u03",
          "speaker_id": "B",
          "ja": "川の近くに小さい美術館がありますよ。",
          "vi": "Gần bờ sông có bảo tàng mỹ thuật nhỏ đấy."
        },
        {
          "id": "a91d4169-c3a1-5652-b6ea-33f1da4b8768-u04",
          "speaker_id": "A",
          "ja": "じゃ、雨ならそこに入りましょう。",
          "vi": "Vậy nếu mưa thì mình vào đó nhé."
        }
      ],
