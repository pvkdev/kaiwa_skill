    {
      "situation_uid": "067b6046-942a-511a-9c56-815524aaef98",
      "event_id": "E04",
      "context_vi": "Bạn bị lạc bạn mình giữa đám đông ở lễ hội. Bạn gọi điện và muốn chọn một mốc dễ thấy để gặp lại.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn gọi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn bị lạc",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "067b6046-942a-511a-9c56-815524aaef98-u01",
          "speaker_id": "A",
          "ja": "今どこにいる？",
          "vi": "Cậu đang ở đâu?"
        },
        {
          "id": "067b6046-942a-511a-9c56-815524aaef98-u02",
          "speaker_id": "B",
          "ja": "ステージの近くだけど、人が多くて見えない。",
          "vi": "Tớ ở gần sân khấu nhưng đông quá, tớ không thấy cậu."
        },
        {
          "id": "067b6046-942a-511a-9c56-815524aaef98-u03",
          "speaker_id": "A",
          "ja": "大きい時計の下に案内所があるよ。そこで会おう。",
          "vi": "Dưới đồng hồ lớn có bàn thông tin. Mình gặp ở đó nhé."
        },
        {
          "id": "067b6046-942a-511a-9c56-815524aaef98-u04",
          "speaker_id": "B",
          "ja": "わかった。時計の下の案内所に行くね。",
          "vi": "Ừ. Tớ tới bàn thông tin dưới đồng hồ nhé."
        }
      ],
