    {
      "situation_uid": "ca01242c-db48-50f6-a0c5-f5ba34fb69f6",
      "event_id": "E02",
      "context_vi": "Đây là lần đầu bạn sống ở một vùng có mùa mưa ở Nhật. Bạn nói với người quen mình chưa quen mưa nhiều ngày và hỏi họ đối phó trong sinh hoạt thế nào.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người mới tới",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ca01242c-db48-50f6-a0c5-f5ba34fb69f6-u01",
          "speaker_id": "A",
          "ja": "まだ梅雨に慣れていません。雨の日が多いですね。",
          "vi": "Tôi vẫn chưa quen mùa mưa. Nhiều ngày mưa nhỉ."
        },
        {
          "id": "ca01242c-db48-50f6-a0c5-f5ba34fb69f6-u02",
          "speaker_id": "B",
          "ja": "そうですね。この時期はよく降りますね。",
          "vi": "Vâng. Dạo này hay mưa."
        },
        {
          "id": "ca01242c-db48-50f6-a0c5-f5ba34fb69f6-u03",
          "speaker_id": "A",
          "ja": "洗濯物はどうしていますか。",
          "vi": "Anh phơi đồ giặt thế nào ạ?"
        },
        {
          "id": "ca01242c-db48-50f6-a0c5-f5ba34fb69f6-u04",
          "speaker_id": "B",
          "ja": "私は部屋の中に干していますよ。",
          "vi": "Tôi thường phơi trong phòng."
        }
      ],
      "admin": {
        "source_refs": [
          "weather",
          "climate"
        ],
