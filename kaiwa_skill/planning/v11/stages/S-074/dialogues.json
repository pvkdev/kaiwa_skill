    {
      "situation_uid": "ef9defdf-1acb-55f6-8a22-e629447f388f",
      "event_id": "E02",
      "context_vi": "Bạn mới tới Tokyo vào đầu năm và muốn hỏi người sống ở đây hoa anh đào thường nở vào tháng nào.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người mới tới",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người sống ở Tokyo",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ef9defdf-1acb-55f6-8a22-e629447f388f-u01",
          "speaker_id": "A",
          "ja": "東京では、桜は何月ごろ咲きますか。",
          "vi": "Ở Tokyo, hoa anh đào thường nở vào khoảng tháng mấy ạ?"
        },
        {
          "id": "ef9defdf-1acb-55f6-8a22-e629447f388f-u02",
          "speaker_id": "B",
          "ja": "だいたい三月の終わりごろです。年によって違いますよ。",
          "vi": "Thường khoảng cuối tháng Ba. Mỗi năm có thể khác chị ạ."
        },
        {
          "id": "ef9defdf-1acb-55f6-8a22-e629447f388f-u03",
          "speaker_id": "A",
          "ja": "じゃ、近くなったら調べたほうがいいですか。",
          "vi": "Vậy gần đến mùa tôi xem lại thông tin thì tốt hơn ạ?"
        },
        {
          "id": "ef9defdf-1acb-55f6-8a22-e629447f388f-u04",
          "speaker_id": "B",
          "ja": "ええ。行く前に、桜の開花情報を見るといいですよ。",
          "vi": "Vâng. Trước khi đi, chị xem tin hoa đã nở tới đâu nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "season"
        ],
