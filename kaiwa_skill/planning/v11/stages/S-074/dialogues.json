    {
      "situation_uid": "e2473b04-3620-5815-869f-c19302244bf9",
      "event_id": "E04",
      "context_vi": "Bạn đến lễ hội khu phố và thấy hai hàng cạnh cổng. Bạn hỏi tình nguyện viên hàng nào là hàng chờ vào lễ hội.",
