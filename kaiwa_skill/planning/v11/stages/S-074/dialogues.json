    {
      "situation_uid": "311aa4bd-de93-5b45-8d5a-b81475edd970",
      "event_id": "E04",
      "context_vi": "Bạn muốn thử một hoạt động làm quạt giấy nhưng lượt hiện tại đã hết chỗ. Bạn hỏi còn lượt sau không và xin chỗ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người muốn thử",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Tình nguyện viên",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "311aa4bd-de93-5b45-8d5a-b81475edd970-u01",
          "speaker_id": "B",
          "ja": "すみません。この回はもういっぱいです。",
          "vi": "Tiếc quá. Suất này đủ người rồi ạ."
        },
        {
          "id": "311aa4bd-de93-5b45-8d5a-b81475edd970-u02",
          "speaker_id": "A",
          "ja": "次の回はありますか。",
          "vi": "Có suất sau không ạ?"
        },
        {
          "id": "311aa4bd-de93-5b45-8d5a-b81475edd970-u03",
          "speaker_id": "B",
          "ja": "午後二時の回なら、まだ空きがあります。",
          "vi": "Suất hai giờ chiều vẫn còn chỗ."
        },
        {
          "id": "311aa4bd-de93-5b45-8d5a-b81475edd970-u04",
          "speaker_id": "A",
          "ja": "じゃ、二時の回を一人お願いします。",
          "vi": "Vậy cho tôi một chỗ suất hai giờ ạ."
        },
        {
          "id": "311aa4bd-de93-5b45-8d5a-b81475edd970-u05",
          "speaker_id": "B",
          "ja": "はい。お名前をお願いします。",
          "vi": "Được. Chị cho tôi xin tên."
        }
      ],
