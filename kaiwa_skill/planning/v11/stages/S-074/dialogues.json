  "dialogues": [
    {
      "situation_uid": "6c009722-9f11-5e13-ac90-13392e681278",
      "event_id": "E01",
      "context_vi": "Bạn gặp hàng xóm ở cửa chung cư buổi sáng. Bạn nhận xét hôm nay lạnh hơn hôm qua và nghe người kia đáp lại.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6c009722-9f11-5e13-ac90-13392e681278-u01",
          "speaker_id": "A",
          "ja": "今日はきのうより寒いですね。",
          "vi": "Hôm nay lạnh hơn hôm qua nhỉ."
        },
        {
          "id": "6c009722-9f11-5e13-ac90-13392e681278-u02",
          "speaker_id": "B",
          "ja": "ええ、風も冷たいですね。",
          "vi": "Vâng, gió cũng lạnh nhỉ."
        },
        {
          "id": "6c009722-9f11-5e13-ac90-13392e681278-u03",
          "speaker_id": "A",
          "ja": "今日は厚い上着にしました。",
          "vi": "Hôm nay tôi chọn áo khoác dày."
        },
        {
          "id": "6c009722-9f11-5e13-ac90-13392e681278-u04",
          "speaker_id": "B",
          "ja": "私もです。",
          "vi": "Tôi cũng vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "weather"
        ],
        "specialty_item_ids": [
          "sj-so-16-b11-1"
        ],
        "turn_origins": {
