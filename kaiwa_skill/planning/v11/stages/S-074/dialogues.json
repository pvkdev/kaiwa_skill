    },
    {
      "situation_uid": "9c352040-b42f-5267-8ae8-45115974ce52",
      "event_id": "E01",
      "context_vi": "Hai bạn định đi công viên ngày mai. Bạn hỏi dự báo có mưa không để biết nên hẹn vào giờ nào.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hỏi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn xem dự báo",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9c352040-b42f-5267-8ae8-45115974ce52-u01",
          "speaker_id": "A",
          "ja": "明日、雨が降りそう？",
          "vi": "Mai trời có mưa không cậu?"
        },
        {
          "id": "9c352040-b42f-5267-8ae8-45115974ce52-u02",
          "speaker_id": "B",
          "ja": "予報では、午後に降るみたい。",
          "vi": "Dự báo nói hình như chiều mưa."
        },
        {
          "id": "9c352040-b42f-5267-8ae8-45115974ce52-u03",
          "speaker_id": "A",
          "ja": "じゃ、午前中に公園へ行こうか。",
          "vi": "Vậy sáng mình đi công viên nhé?"
        },
        {
          "id": "9c352040-b42f-5267-8ae8-45115974ce52-u04",
          "speaker_id": "B",
          "ja": "うん。朝から雨なら、また連絡しよう。",
          "vi": "Ừ. Nếu mưa ngay từ sáng thì mình báo nhau nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "weather"
        ],
        "specialty_item_ids": [],
