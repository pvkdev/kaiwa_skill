        }
      }
    },
    {
      "situation_uid": "fec54e52-a9e6-5690-97ca-e17e7049f554",
      "event_id": "E01",
      "context_vi": "Bạn nói không muốn đi công viên giữa trưa vì trời nóng. Người bạn tưởng bạn muốn hủy, nên bạn đính chính chỉ muốn đổi giờ đi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đổi giờ",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fec54e52-a9e6-5690-97ca-e17e7049f554-u01",
          "speaker_id": "B",
          "ja": "じゃ、今日は公園に行かないの？",
          "vi": "Vậy hôm nay mình không đi công viên à?"
        },
        {
          "id": "fec54e52-a9e6-5690-97ca-e17e7049f554-u02",
          "speaker_id": "A",
          "ja": "行くよ。時間だけ変えたい。",
          "vi": "Có đi chứ. Tớ chỉ muốn đổi giờ."
        },
        {
          "id": "fec54e52-a9e6-5690-97ca-e17e7049f554-u03",
          "speaker_id": "A",
          "ja": "お昼は暑いから、もう少し遅くしない？",
          "vi": "Giữa trưa nóng quá, mình đi muộn hơn một chút nhé?"
        },
        {
          "id": "fec54e52-a9e6-5690-97ca-e17e7049f554-u04",
          "speaker_id": "B",
          "ja": "うん、遅いほうがよさそうだね。",
          "vi": "Ừ, đi muộn hơn có vẻ được."
        }
      ],
      "admin": {
        "source_refs": [
          "weather"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fec54e52-a9e6-5690-97ca-e17e7049f554-u01": {
