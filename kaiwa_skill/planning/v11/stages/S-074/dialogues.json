    {
      "situation_uid": "efb5fd3c-dd9b-56f2-9f36-a418c3870e43",
      "event_id": "E04",
      "context_vi": "Bạn thấy một bàn hướng dẫn gấp giấy ở lễ hội. Bạn hỏi có thể thử một lần không và phải làm gì để vào bàn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người muốn thử",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Tình nguyện viên",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "efb5fd3c-dd9b-56f2-9f36-a418c3870e43-u01",
          "speaker_id": "A",
          "ja": "この折り紙、私もやってみてもいいですか。",
          "vi": "Tôi cũng thử gấp giấy được không ạ?"
        },
        {
          "id": "efb5fd3c-dd9b-56f2-9f36-a418c3870e43-u02",
          "speaker_id": "B",
          "ja": "はい。ちょうど一席空きました。",
          "vi": "Được. Vừa trống một chỗ."
        },
        {
          "id": "efb5fd3c-dd9b-56f2-9f36-a418c3870e43-u03",
          "speaker_id": "A",
          "ja": "ここで待てばいいですか。",
          "vi": "Tôi đợi ở đây ạ?"
        },
        {
          "id": "efb5fd3c-dd9b-56f2-9f36-a418c3870e43-u04",
          "speaker_id": "B",
          "ja": "今座れますよ。紙を一枚お取りください。",
          "vi": "Chị ngồi được ngay. Chị lấy một tờ giấy nhé."
        }
      ],
