    {
      "situation_uid": "5b309bed-d155-5c95-8ac8-be413062ef63",
      "event_id": "E04",
      "context_vi": "Bạn đã gặp lại bạn mình tại bàn thông tin dưới đồng hồ lớn. Bạn kể nhanh phần biểu diễn trống vừa xem khi hai người còn đi riêng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn vừa gặp lại",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5b309bed-d155-5c95-8ac8-be413062ef63-u01",
          "speaker_id": "A",
          "ja": "会えてよかった。ここならすぐわかった？",
          "vi": "May mà gặp lại. Chỗ này tìm dễ không cậu?"
        },
        {
          "id": "5b309bed-d155-5c95-8ac8-be413062ef63-u02",
          "speaker_id": "B",
          "ja": "うん、時計がよく見えたよ。何か見た？",
          "vi": "Ừ, nhìn rõ cái đồng hồ lắm. Cậu vừa xem được gì không?"
        },
        {
          "id": "5b309bed-d155-5c95-8ac8-be413062ef63-u03",
          "speaker_id": "A",
          "ja": "太鼓の演奏を見たよ。音が大きくてびっくりした。",
          "vi": "Tớ xem đánh trống. Tiếng to làm tớ bất ngờ."
        },
        {
          "id": "5b309bed-d155-5c95-8ac8-be413062ef63-u04",
          "speaker_id": "B",
          "ja": "へえ。私も今度見たいな。",
          "vi": "Ồ. Lần sau tớ cũng muốn xem."
        }
      ],
