    {
      "situation_uid": "645b15aa-c1ce-5b42-9d6a-abec6f82d6ab",
      "event_id": "E02",
      "context_vi": "Tháng Ba, bạn sẽ tới một buổi ngắm hoa ngoài trời ở Tokyo và muốn hỏi người quen nên mặc gì nếu đến chiều thì lạnh hơn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người sắp đi chơi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "645b15aa-c1ce-5b42-9d6a-abec6f82d6ab-u01",
          "speaker_id": "A",
          "ja": "お花見に行くんですが、何を着たらいいですか。",
          "vi": "Tôi sắp đi ngắm hoa, nên mặc gì ạ?"
        },
        {
          "id": "645b15aa-c1ce-5b42-9d6a-abec6f82d6ab-u02",
          "speaker_id": "B",
          "ja": "夕方は寒い日もあります。薄い上着があるといいですよ。",
          "vi": "Có hôm chiều tối lạnh đấy. Chị mang một cái áo khoác mỏng thì tiện."
        },
