    {
      "situation_uid": "804bd20e-8f86-5773-8348-7ce1fb28c851",
      "event_id": "E02",
      "context_vi": "Bạn gặp lại người quen từng nghe bạn định ăn trưa ngoài trời Chủ nhật. Bạn kể hôm đó trời mưa và nhóm đã đổi kế hoạch.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "804bd20e-8f86-5773-8348-7ce1fb28c851-u01",
          "speaker_id": "B",
          "ja": "日曜、外でお昼を食べましたか。",
          "vi": "Chủ nhật mọi người có ăn trưa ngoài trời không ạ?"
        },
        {
          "id": "804bd20e-8f86-5773-8348-7ce1fb28c851-u02",
          "speaker_id": "A",
          "ja": "お昼前に雨が降って、予定を変えました。",
          "vi": "Trước giờ trưa thì trời mưa nên chúng tôi đổi kế hoạch."
        },
        {
          "id": "804bd20e-8f86-5773-8348-7ce1fb28c851-u03",
          "speaker_id": "A",
          "ja": "近くのカフェで一緒に食べました。",
          "vi": "Chúng tôi cùng ăn ở quán cà phê gần đó."
        },
        {
          "id": "804bd20e-8f86-5773-8348-7ce1fb28c851-u04",
          "speaker_id": "B",
          "ja": "みんなで食べられてよかったですね。",
          "vi": "May là mọi người vẫn ăn cùng nhau được nhỉ."
        }
      ],
