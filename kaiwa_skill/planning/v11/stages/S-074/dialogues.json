    {
      "situation_uid": "3beb736a-9fb6-50f9-b39f-586af3274690",
      "event_id": "E01",
      "context_vi": "Hai bạn vẫn muốn đi công viên, nhưng vừa thống nhất tránh giờ giữa trưa nóng. Bạn chọn giờ mới cùng người kia.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đổi giờ",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3beb736a-9fb6-50f9-b39f-586af3274690-u01",
          "speaker_id": "A",
          "ja": "午後四時ごろなら少し日陰が増えるよ。どう？",
          "vi": "Tầm bốn giờ chiều sẽ có thêm chút bóng râm. Cậu thấy sao?"
        },
        {
          "id": "3beb736a-9fb6-50f9-b39f-586af3274690-u02",
          "speaker_id": "B",
          "ja": "いいね。四時なら行ける。",
          "vi": "Được đấy. Bốn giờ tớ đi được."
        },
        {
          "id": "3beb736a-9fb6-50f9-b39f-586af3274690-u03",
          "speaker_id": "A",
          "ja": "じゃ、四時に公園の入口だね。",
          "vi": "Vậy bốn giờ ở cổng công viên nhé."
        },
        {
          "id": "3beb736a-9fb6-50f9-b39f-586af3274690-u04",
          "speaker_id": "B",
          "ja": "うん、そこで会おう。",
          "vi": "Ừ. Gặp ở đó nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "weather"
        ],
        "specialty_item_ids": [
          "sj-so-16-b11-1"
        ],
        "turn_origins": {
