    {
      "situation_uid": "f4cad844-349b-5c50-a79e-24b9ae6fb085",
      "event_id": "E01",
      "context_vi": "Bạn và bạn mình đang đi dạo dưới trời nóng. Bạn muốn nói vì nắng nên cần nghỉ một lát trong bóng râm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi dạo",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f4cad844-349b-5c50-a79e-24b9ae6fb085-u01",
          "speaker_id": "A",
          "ja": "日差しが強いね。少し休みたいな。",
          "vi": "Nắng gắt nhỉ. Tớ muốn nghỉ một lát."
        },
        {
          "id": "f4cad844-349b-5c50-a79e-24b9ae6fb085-u02",
          "speaker_id": "B",
          "ja": "あの木の下にベンチがあるよ。",
          "vi": "Dưới cây kia có ghế kìa."
        },
        {
          "id": "f4cad844-349b-5c50-a79e-24b9ae6fb085-u03",
          "speaker_id": "A",
          "ja": "じゃ、あそこで座って、水を飲もう。",
          "vi": "Vậy mình ra đó ngồi uống nước nhé."
        },
        {
          "id": "f4cad844-349b-5c50-a79e-24b9ae6fb085-u04",
          "speaker_id": "B",
          "ja": "うん、日陰に行こう。",
          "vi": "Ừ, mình ra chỗ râm đi."
        }
      ],
      "admin": {
        "source_refs": [
          "weather"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f4cad844-349b-5c50-a79e-24b9ae6fb085-u01": {
