    {
      "situation_uid": "08f82fc4-eb90-5f2e-8037-311487b6fb93",
      "event_id": "E03",
      "context_vi": "Tiếp báo cáo bảng giá còn chờ: bạn hỏi leader nên ưu tiên hoàn thiện bảng giá hay làm thư gửi khách sáng mai. Leader chưa quyết và hẹn sáng trả lời.",
