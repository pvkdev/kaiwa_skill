    {
      "situation_uid": "cdd619bb-13c1-5d01-bc95-b8c2406c7d2b",
      "event_id": "E03",
      "context_vi": "Cuối ngày ở Aoba hư cấu, bạn đã hoàn thành danh sách nhưng bảng giá vẫn chờ một mức giá từ đối tác. Bạn báo leader hai trạng thái riêng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cdd619bb-13c1-5d01-bc95-b8c2406c7d2b-u01",
          "speaker_id": "a",
          "ja": "リストは終わりました。値段の表は、一つの値段を待っています。",
          "vi": "Danh sách đã xong. Bảng giá còn chờ một mức giá."
        },
        {
          "id": "cdd619bb-13c1-5d01-bc95-b8c2406c7d2b-u02",
          "speaker_id": "b",
          "ja": "わかりました。明日の朝、もう一度見ましょう。",
          "vi": "Tôi rõ rồi. Sáng mai mình xem lại."
        },
        {
          "id": "cdd619bb-13c1-5d01-bc95-b8c2406c7d2b-u03",
          "speaker_id": "a",
          "ja": "はい。朝に確認します。",
          "vi": "Vâng. Sáng mai tôi sẽ kiểm tra."
        }
      ],
      "admin": {
        "source_refs": [
          "report"
        ],
