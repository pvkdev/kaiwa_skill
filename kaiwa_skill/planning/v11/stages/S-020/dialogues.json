  "dialogues": [
    {
      "situation_uid": "36a1d27b-7311-54eb-b938-137c3e2c88b5",
      "event_id": "E01",
      "context_vi": "Sáng ở công ty Aoba hư cấu, leader nam giao ba việc: kiểm danh sách lúc 9 giờ, nhận hàng lúc 11 giờ, họp lúc 14 giờ. Bạn nhắc lại thứ tự.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "36a1d27b-7311-54eb-b938-137c3e2c88b5-u01",
          "speaker_id": "b",
          "ja": "九時にリストを見て、十一時に荷物を受け取ってください。二時から会議です。",
          "vi": "9 giờ xem danh sách, 11 giờ nhận hàng. 2 giờ chiều họp."
        },
        {
          "id": "36a1d27b-7311-54eb-b938-137c3e2c88b5-u02",
          "speaker_id": "a",
          "ja": "九時にリスト、十一時に荷物、二時に会議ですね。",
          "vi": "9 giờ danh sách, 11 giờ nhận hàng, 2 giờ họp nhỉ."
        },
        {
          "id": "36a1d27b-7311-54eb-b938-137c3e2c88b5-u03",
          "speaker_id": "b",
          "ja": "はい。その順番でお願いします。",
          "vi": "Đúng. Chị làm theo thứ tự đó nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions"
        ],
        "specialty_item_ids": [
          "sj-so-05-b07-82"
        ],
        "turn_origins": {
          "36a1d27b-7311-54eb-b938-137c3e2c88b5-u01": {
            "kind": "original_extension"
          },
