          }
        }
      }
    },
    {
      "situation_uid": "f4777eef-34de-5560-b5bc-7a83d10351aa",
      "event_id": "E02",
      "context_vi": "Ở Aoba hư cấu, bạn cần phòng chung để chuẩn bị tài liệu, nhưng đồng nghiệp nam đang dùng. Bạn hỏi lúc nào anh ấy xong.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f4777eef-34de-5560-b5bc-7a83d10351aa-u01",
          "speaker_id": "a",
          "ja": "この部屋は何時まで使いますか。",
          "vi": "Anh dùng phòng này đến mấy giờ ạ?"
        },
        {
          "id": "f4777eef-34de-5560-b5bc-7a83d10351aa-u02",
          "speaker_id": "b",
          "ja": "一時までです。",
          "vi": "Đến 1 giờ."
        },
        {
          "id": "f4777eef-34de-5560-b5bc-7a83d10351aa-u03",
          "speaker_id": "a",
          "ja": "わかりました。一時に来ます。",
          "vi": "Tôi rõ rồi. 1 giờ tôi quay lại."
        }
      ],
      "admin": {
        "source_refs": [
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f4777eef-34de-5560-b5bc-7a83d10351aa-u01": {
            "kind": "original_extension"
          },
          "f4777eef-34de-5560-b5bc-7a83d10351aa-u02": {
            "kind": "original_extension"
          },
          "f4777eef-34de-5560-b5bc-7a83d10351aa-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "171ba825-4e58-566d-b3a3-f568d4a0279e",
      "event_id": "E02",
      "context_vi": "Tiếp kế hoạch dùng phòng chung lúc 13 giờ: đồng nghiệp báo cuộc họp của anh kéo dài, phòng chỉ trống từ 13:30. Bạn đổi giờ chuẩn bị.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "171ba825-4e58-566d-b3a3-f568d4a0279e-u01",
          "speaker_id": "b",
          "ja": "すみません。会議が延びて、一時半まで使います。",
          "vi": "Xin lỗi. Cuộc họp kéo dài, tôi dùng đến 1 giờ rưỡi."
        },
        {
          "id": "171ba825-4e58-566d-b3a3-f568d4a0279e-u02",
          "speaker_id": "a",
          "ja": "わかりました。一時半から準備します。",
          "vi": "Tôi hiểu. Tôi chuẩn bị từ 1 giờ rưỡi."
        },
        {
          "id": "171ba825-4e58-566d-b3a3-f568d4a0279e-u03",
          "speaker_id": "b",
          "ja": "助かります。",
          "vi": "Cảm ơn chị nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "report"
        ],
        "specialty_item_ids": [],
