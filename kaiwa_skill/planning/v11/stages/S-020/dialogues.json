            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "913bce8f-4fac-5f81-9781-b5bc4734c261",
      "event_id": "E01",
      "context_vi": "Tiếp lịch ba việc: bạn nhầm 11 giờ là giờ họp, trong khi leader đã nói nhận hàng lúc 11 và họp lúc 14. Bạn hỏi lại trước khi ghi lịch.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "913bce8f-4fac-5f81-9781-b5bc4734c261-u01",
          "speaker_id": "a",
          "ja": "念のため、十一時は会議ですか。",
          "vi": "Để chắc lại, 11 giờ là họp ạ?"
        },
        {
          "id": "913bce8f-4fac-5f81-9781-b5bc4734c261-u02",
          "speaker_id": "b",
          "ja": "いいえ、十一時は荷物です。会議は午後二時からです。",
          "vi": "Không, 11 giờ nhận hàng. Họp từ 2 giờ chiều."
        },
        {
          "id": "913bce8f-4fac-5f81-9781-b5bc4734c261-u03",
          "speaker_id": "a",
          "ja": "荷物が十一時、会議が二時ですね。",
          "vi": "Nhận hàng 11 giờ, họp 2 giờ nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions",
          "double"
        ],
        "specialty_item_ids": [
          "sj-so-05-b07-110"
        ],
        "turn_origins": {
