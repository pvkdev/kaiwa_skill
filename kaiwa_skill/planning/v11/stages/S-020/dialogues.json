            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "ab005c6f-f21a-582d-b81f-fa8ce97fe925",
      "event_id": "E01",
      "context_vi": "Một buổi khác ở Aoba, danh sách và bảng giá đều được yêu cầu trước 12 giờ. Bạn hỏi leader việc nào cần làm trước vì không kịp làm đồng thời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ab005c6f-f21a-582d-b81f-fa8ce97fe925-u01",
          "speaker_id": "a",
          "ja": "リストと値段の表は、どちらも十二時までです。どちらを先にしますか。",
          "vi": "Danh sách và bảng giá đều hạn 12 giờ. Tôi làm cái nào trước ạ?"
        },
        {
          "id": "ab005c6f-f21a-582d-b81f-fa8ce97fe925-u02",
          "speaker_id": "b",
          "ja": "まずリストをお願いします。",
          "vi": "Trước hết chị làm danh sách nhé."
        },
        {
          "id": "ab005c6f-f21a-582d-b81f-fa8ce97fe925-u03",
          "speaker_id": "a",
          "ja": "わかりました。値段の表はそのあとですね。",
          "vi": "Tôi rõ rồi. Bảng giá làm sau nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ab005c6f-f21a-582d-b81f-fa8ce97fe925-u01": {
            "kind": "original_extension"
          },
          "ab005c6f-f21a-582d-b81f-fa8ce97fe925-u02": {
            "kind": "original_extension"
          },
          "ab005c6f-f21a-582d-b81f-fa8ce97fe925-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "66942223-7714-5ccf-a130-a9c82f6ca25d",
      "event_id": "E01",
      "context_vi": "Tiếp khi leader ưu tiên danh sách ở Aoba. Bạn hỏi có thể giao bảng giá sau 12 giờ không; leader chốt mốc 15 giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "66942223-7714-5ccf-a130-a9c82f6ca25d-u01",
          "speaker_id": "a",
          "ja": "リストを先にします。値段の表は、三時まででいいですか。",
          "vi": "Tôi làm danh sách trước. Bảng giá xong trước 3 giờ được không ạ?"
        },
        {
          "id": "66942223-7714-5ccf-a130-a9c82f6ca25d-u02",
          "speaker_id": "b",
          "ja": "はい、午後三時までで大丈夫です。",
          "vi": "Được, trước 3 giờ chiều là được."
        },
        {
          "id": "66942223-7714-5ccf-a130-a9c82f6ca25d-u03",
          "speaker_id": "a",
          "ja": "リストが十二時、表が三時ですね。",
          "vi": "Danh sách 12 giờ, bảng giá 3 giờ nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions",
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "66942223-7714-5ccf-a130-a9c82f6ca25d-u01": {
