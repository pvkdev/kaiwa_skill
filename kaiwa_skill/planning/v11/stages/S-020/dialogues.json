    {
      "situation_uid": "ce4be486-c77e-59ac-bb02-0657242fdc2e",
      "event_id": "E02",
      "context_vi": "Hai người chuẩn bị một tập tài liệu Aoba hư cấu. Bạn nhận phần nhập số liệu trước, đồng nghiệp nam nhận phần in sau khi bạn chuyển tệp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ce4be486-c77e-59ac-bb02-0657242fdc2e-u01",
          "speaker_id": "a",
          "ja": "私が先に数字を入れます。そのあと、印刷をお願いします。",
          "vi": "Tôi sẽ nhập số trước. Sau đó nhờ anh in."
        },
        {
          "id": "ce4be486-c77e-59ac-bb02-0657242fdc2e-u02",
          "speaker_id": "b",
          "ja": "わかりました。ファイルができたら教えてください。",
          "vi": "Tôi rõ rồi. Xong tệp thì báo tôi nhé."
        },
        {
          "id": "ce4be486-c77e-59ac-bb02-0657242fdc2e-u03",
          "speaker_id": "a",
          "ja": "はい、できたら送ります。",
          "vi": "Vâng, xong tôi sẽ gửi."
        }
      ],
      "admin": {
        "source_refs": [
          "instructions",
          "confirm"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ce4be486-c77e-59ac-bb02-0657242fdc2e-u01": {
            "kind": "original_extension"
          },
