            "kind": "original_extension"
          },
          "ce4be486-c77e-59ac-bb02-0657242fdc2e-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "aa369ee5-2593-5ed4-a619-0c54b95a40b8",
      "event_id": "E02",
      "context_vi": "Tiếp khi bạn nhận phần nhập số và đồng nghiệp chờ in: bảng số liệu đầu vào chưa tới. Bạn báo việc in đang bị chặn, không nói rằng tài liệu đã xong.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "aa369ee5-2593-5ed4-a619-0c54b95a40b8-u01",
          "speaker_id": "a",
          "ja": "数字の表がまだ来ていません。ファイルが作れないので、印刷もまだです。",
          "vi": "Bảng số chưa tới. Tôi chưa tạo được tệp nên cũng chưa in được."
        },
        {
          "id": "aa369ee5-2593-5ed4-a619-0c54b95a40b8-u02",
          "speaker_id": "b",
          "ja": "わかりました。表が来たら教えてください。",
          "vi": "Tôi rõ rồi. Khi bảng tới thì báo tôi."
        },
        {
          "id": "aa369ee5-2593-5ed4-a619-0c54b95a40b8-u03",
          "speaker_id": "a",
          "ja": "はい、すぐ連絡します。",
          "vi": "Vâng, tôi sẽ báo ngay."
        }
      ],
      "admin": {
        "source_refs": [
          "report"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "aa369ee5-2593-5ed4-a619-0c54b95a40b8-u01": {
