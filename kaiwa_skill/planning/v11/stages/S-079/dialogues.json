    {
      "situation_uid": "132ad461-95b8-57c1-8dd0-a6fc41df38b6",
      "event_id": "E02",
      "context_vi": "Bạn tìm được phòng 203 sau khi đi nhầm phòng 302. Buổi học đã bắt đầu, bạn xin lỗi giáo viên vì vào muộn và hỏi nên ngồi ở đâu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Giáo viên",
          "gender": "male"
