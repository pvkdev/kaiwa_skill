    {
      "situation_uid": "054da203-8a7f-524f-9fec-948e969bd657",
      "event_id": "E03",
      "context_vi": "Bạn đã hiểu bài luyện mua đồ theo cặp sẽ đổi vai. Bạn chưa biết mở lời khi đóng khách và hỏi giáo viên có thể làm nhân viên trước không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Giáo viên",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "054da203-8a7f-524f-9fec-948e969bd657-u01",
          "speaker_id": "A",
          "ja": "お客さんの最初の言葉が出てきません。",
          "vi": "Em chưa nói được câu đầu tiên của vai khách."
        },
        {
          "id": "054da203-8a7f-524f-9fec-948e969bd657-u02",
          "speaker_id": "A",
          "ja": "先に店員をやるのはどうですか。",
          "vi": "Em đóng nhân viên trước được không ạ?"
        },
        {
          "id": "054da203-8a7f-524f-9fec-948e969bd657-u03",
          "speaker_id": "B",
          "ja": "いいですよ。まず「いらっしゃいませ」と言ってください。",
          "vi": "Được. Đầu tiên em nói “Xin chào quý khách”."
        },
        {
          "id": "054da203-8a7f-524f-9fec-948e969bd657-u04",
          "speaker_id": "A",
          "ja": "いらっしゃいませ。",
          "vi": "Xin chào quý khách."
        },
        {
          "id": "054da203-8a7f-524f-9fec-948e969bd657-u05",
          "speaker_id": "B",
          "ja": "はい。次は相手の言葉を聞きましょう。",
          "vi": "Được rồi. Bây giờ em nghe người đóng khách nói nhé."
        }
      ],
