    {
      "situation_uid": "69b70966-4f4f-5d5e-b271-0e39cf84708c",
      "event_id": "E04",
      "context_vi": "Bạn vừa báo nghỉ một buổi tối thứ Ba vì ca làm. Công việc sắp đổi hẳn sang ca tối, nên bạn hỏi nhân viên có lớp buổi sáng hợp trình độ không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "69b70966-4f4f-5d5e-b271-0e39cf84708c-u01",
          "speaker_id": "A",
          "ja": "これから夜は仕事です。午前のクラスはどうですか。",
          "vi": "Sắp tới tối nào tôi cũng phải làm. Có lớp học buổi sáng không ạ?"
        },
        {
