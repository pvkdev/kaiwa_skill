  "dialogues": [
    {
      "situation_uid": "81ef0a82-9b3f-57f9-9585-4c19ee21caec",
      "event_id": "E01",
      "context_vi": "Bạn mới bắt đầu tiếng Nhật và muốn luyện hỏi đáp trong sinh hoạt. Bạn hỏi nhân viên trường có lớp cho người mới không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "81ef0a82-9b3f-57f9-9585-4c19ee21caec-u01",
          "speaker_id": "A",
          "ja": "日本語は初めてです。初心者のクラスはありますか。",
          "vi": "Tôi mới bắt đầu tiếng Nhật. Có lớp cho người mới không ạ?"
        },
        {
          "id": "81ef0a82-9b3f-57f9-9585-4c19ee21caec-u02",
          "speaker_id": "B",
          "ja": "はい。「初級一」というクラスがあります。",
          "vi": "Có lớp tên là “Sơ cấp 1” ạ."
        },
        {
          "id": "81ef0a82-9b3f-57f9-9585-4c19ee21caec-u03",
          "speaker_id": "A",
          "ja": "生活で使う日本語を練習したいです。",
          "vi": "Tôi muốn luyện tiếng Nhật dùng hằng ngày ạ."
        },
        {
          "id": "81ef0a82-9b3f-57f9-9585-4c19ee21caec-u04",
          "speaker_id": "B",
          "ja": "そのクラスは生活の会話も練習します。火曜日の夜です。",
          "vi": "Lớp đó cũng luyện hội thoại đời sống. Lớp vào tối thứ Ba."
        }
      ],
      "admin": {
        "source_refs": [
          "class",
          "shinjuku"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "81ef0a82-9b3f-57f9-9585-4c19ee21caec-u01": {
