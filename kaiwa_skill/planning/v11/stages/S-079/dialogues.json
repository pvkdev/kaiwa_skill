    {
      "situation_uid": "9b930ecf-af91-52ea-9763-12bc2c8b38dd",
      "event_id": "E04",
      "context_vi": "Bạn học tiếng Nhật tối thứ Ba nhưng tuần này có ca làm nên sẽ vắng. Bạn báo nhân viên lớp và hỏi buổi thứ Ba tuần sau học ở đâu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9b930ecf-af91-52ea-9763-12bc2c8b38dd-u01",
          "speaker_id": "A",
          "ja": "仕事で、今週の火曜日の授業を休みます。",
          "vi": "Tuần này tôi có việc nên xin nghỉ lớp thứ Ba ạ."
        },
        {
          "id": "9b930ecf-af91-52ea-9763-12bc2c8b38dd-u02",
          "speaker_id": "B",
          "ja": "わかりました。先生にも伝えます。",
          "vi": "Vâng, tôi sẽ báo giáo viên."
        },
        {
          "id": "9b930ecf-af91-52ea-9763-12bc2c8b38dd-u03",
          "speaker_id": "A",
          "ja": "来週の授業は、いつもの部屋ですか。",
          "vi": "Tuần sau vẫn học ở phòng cũ ạ?"
        },
        {
          "id": "9b930ecf-af91-52ea-9763-12bc2c8b38dd-u04",
          "speaker_id": "B",
          "ja": "はい。今のところ、本館の二〇三号室です。",
          "vi": "Vâng. Hiện lịch là phòng 203 ở tòa chính ạ."
        }
      ],
      "admin": {
