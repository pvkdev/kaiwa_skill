          }
        }
      }
    },
    {
      "situation_uid": "fca67705-2edc-5f0f-a192-0f84316c87ae",
      "event_id": "E01",
      "context_vi": "Bạn biết trường có lớp “Sơ cấp 1” nhưng chưa hình dung sẽ học gì. Bạn xin nhân viên một ví dụ cụ thể để xem có hợp mục tiêu không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fca67705-2edc-5f0f-a192-0f84316c87ae-u01",
          "speaker_id": "A",
          "ja": "「初級一」では、どんな練習をしますか。例えば何をしますか。",
          "vi": "Ở lớp “Sơ cấp 1” luyện những gì ạ? Anh cho tôi một ví dụ được không?"
        },
        {
          "id": "fca67705-2edc-5f0f-a192-0f84316c87ae-u02",
          "speaker_id": "B",
          "ja": "例えば、道を聞きます。それから、「最初の角ですか」と確かめます。",
          "vi": "Ví dụ mình hỏi đường, rồi xác nhận lại “Có phải ở góc đường đầu tiên không ạ?”."
        },
        {
          "id": "fca67705-2edc-5f0f-a192-0f84316c87ae-u03",
          "speaker_id": "A",
          "ja": "なるほど。外でも使えそうで、勉強になりますね。",
          "vi": "Ra vậy. Có vẻ dùng được cả ngoài đời, tôi học được nhiều đấy ạ."
        },
        {
          "id": "fca67705-2edc-5f0f-a192-0f84316c87ae-u04",
          "speaker_id": "B",
          "ja": "よかったら、授業を見に来てください。",
          "vi": "Nếu chị muốn thì đến xem một buổi học nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "class"
        ],
        "specialty_item_ids": [
          "sj-so-18-b06-166",
          "sj-so-18-b07-142"
        ],
        "turn_origins": {
          "fca67705-2edc-5f0f-a192-0f84316c87ae-u01": {
            "kind": "original_extension"
