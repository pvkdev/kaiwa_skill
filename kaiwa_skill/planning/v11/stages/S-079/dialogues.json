    {
      "situation_uid": "b9d84127-2e29-584e-a7df-5f7e4e310b44",
      "event_id": "E02",
      "context_vi": "Bạn vừa tự giới thiệu trước lớp. Giáo viên hướng dẫn bước luyện với người ngồi cạnh, nhưng bạn chưa nghe kịp bước đầu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Giáo viên",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b9d84127-2e29-584e-a7df-5f7e4e310b44-u01",
          "speaker_id": "B",
          "ja": "じゃ、隣の人と練習を始めてください。",
          "vi": "Bây giờ các em bắt đầu luyện với người ngồi cạnh nhé."
        },
        {
          "id": "b9d84127-2e29-584e-a7df-5f7e4e310b44-u02",
          "speaker_id": "A",
          "ja": "すみません。最初に何をするか、もう一度お願いします。",
          "vi": "Em xin lỗi. Thầy nhắc lại giúp em đầu tiên làm gì được không ạ?"
        },
        {
          "id": "b9d84127-2e29-584e-a7df-5f7e4e310b44-u03",
          "speaker_id": "B",
          "ja": "最初に、隣の人の名前を聞いてください。",
          "vi": "Đầu tiên, em hỏi tên người ngồi cạnh."
        },
        {
          "id": "b9d84127-2e29-584e-a7df-5f7e4e310b44-u04",
          "speaker_id": "A",
          "ja": "名前を聞くんですね。わかりました。",
          "vi": "Em hỏi tên bạn ấy trước, đúng không ạ? Em hiểu rồi."
        },
        {
