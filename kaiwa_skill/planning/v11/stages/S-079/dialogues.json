    {
      "situation_uid": "cf8f300a-af8f-5ecc-9157-9f6ef0e53b2f",
      "event_id": "E04",
      "context_vi": "Khi báo vắng, bạn nghe buổi kế sẽ ở phòng 203 tòa chính. Trường vừa thông báo đổi phòng và bạn muốn kiểm đúng tòa và tầng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cf8f300a-af8f-5ecc-9157-9f6ef0e53b2f-u01",
          "speaker_id": "B",
          "ja": "来週は部屋が変わります。本館は工事です。",
          "vi": "Tuần sau đổi phòng. Tòa chính đang sửa ạ."
        },
        {
          "id": "cf8f300a-af8f-5ecc-9157-9f6ef0e53b2f-u02",
          "speaker_id": "A",
          "ja": "では、どの建物の何階ですか。",
          "vi": "Vậy học ở tòa nào, tầng mấy ạ?"
        },
        {
          "id": "cf8f300a-af8f-5ecc-9157-9f6ef0e53b2f-u03",
          "speaker_id": "B",
          "ja": "Ｂ棟の三階です。階段を上がってすぐです。",
          "vi": "Tầng ba tòa B. Lên cầu thang là tới ngay ạ."
        },
        {
          "id": "cf8f300a-af8f-5ecc-9157-9f6ef0e53b2f-u04",
          "speaker_id": "A",
          "ja": "なるほど。Ｂ棟の三階ですね。",
          "vi": "Ra vậy. Tầng ba tòa B ạ."
        },
        {
          "id": "cf8f300a-af8f-5ecc-9157-9f6ef0e53b2f-u05",
          "speaker_id": "B",
          "ja": "はい。時間はいつもと同じです。",
          "vi": "Vâng. Giờ vẫn như thường ạ."
        }
      ],
      "admin": {
