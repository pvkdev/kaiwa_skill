            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "fc44f195-473e-5cb0-ac9f-bee8a4f996b1",
      "event_id": "E01",
      "context_vi": "Bạn đang hỏi về lớp Sơ cấp 1 tối thứ Ba. Nhân viên nói lớp này đã đủ người. Bạn muốn hỏi xem có lớp cùng cấp vào tối khác không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fc44f195-473e-5cb0-ac9f-bee8a4f996b1-u01",
          "speaker_id": "B",
          "ja": "火曜の夜は満員です。",
          "vi": "Lớp tối thứ Ba đã đủ chỗ ạ."
        },
        {
          "id": "fc44f195-473e-5cb0-ac9f-bee8a4f996b1-u02",
          "speaker_id": "A",
          "ja": "では、木曜の夜のクラスはどうですか。",
          "vi": "Vậy lớp tối thứ Năm thì sao ạ?"
        },
        {
          "id": "fc44f195-473e-5cb0-ac9f-bee8a4f996b1-u03",
          "speaker_id": "B",
          "ja": "木曜にも同じレベルのクラスがあります。まだ空いていますよ。",
          "vi": "Tối thứ Năm cũng có lớp cùng cấp. Lớp đó vẫn còn chỗ."
        },
        {
          "id": "fc44f195-473e-5cb0-ac9f-bee8a4f996b1-u04",
          "speaker_id": "A",
          "ja": "よかったです。申し込み方を教えてください。",
          "vi": "May quá. Anh chỉ tôi cách đăng ký với ạ."
        },
        {
          "id": "fc44f195-473e-5cb0-ac9f-bee8a4f996b1-u05",
          "speaker_id": "B",
          "ja": "こちらの窓口でお申し込みいただけます。",
          "vi": "Chị có thể đăng ký ngay tại quầy này ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "class",
          "shinjuku"
        ],
        "specialty_item_ids": [
          "sj-so-18-b11-67"
        ],
