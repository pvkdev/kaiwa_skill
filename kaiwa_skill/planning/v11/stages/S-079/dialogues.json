          },
          "fca67705-2edc-5f0f-a192-0f84316c87ae-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "c3791972-3274-5a6a-bc48-659587f5a1ed",
      "event_id": "E02",
      "context_vi": "Hôm nay là buổi đầu của bạn ở lớp tiếng Nhật. Giáo viên mời bạn nói vài câu trước lớp về tên và một điều bạn muốn tập.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Giáo viên",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c3791972-3274-5a6a-bc48-659587f5a1ed-u01",
          "speaker_id": "B",
          "ja": "ランさん、短い自己紹介をお願いします。",
          "vi": "Lan, em giới thiệu ngắn với cả lớp nhé."
        },
        {
          "id": "c3791972-3274-5a6a-bc48-659587f5a1ed-u02",
          "speaker_id": "A",
          "ja": "はじめまして。ベトナムから来たランです。",
          "vi": "Em chào mọi người. Em là Lan, đến từ Việt Nam."
        },
        {
          "id": "c3791972-3274-5a6a-bc48-659587f5a1ed-u03",
          "speaker_id": "A",
          "ja": "日本語で道を聞けるようになりたいです。よろしくお願いします。",
          "vi": "Em muốn tập hỏi đường bằng tiếng Nhật. Mong mọi người giúp đỡ ạ."
        },
        {
          "id": "c3791972-3274-5a6a-bc48-659587f5a1ed-u04",
          "speaker_id": "B",
          "ja": "いいですね。このクラスでも練習しましょう。",
          "vi": "Hay đấy. Mình sẽ luyện trong lớp này nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
