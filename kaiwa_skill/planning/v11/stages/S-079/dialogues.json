      ],
      "turns": [
        {
          "id": "132ad461-95b8-57c1-8dd0-a6fc41df38b6-u01",
          "speaker_id": "A",
          "ja": "遅れてすみません。教室を間違えました。",
          "vi": "Em xin lỗi đến muộn. Em đi nhầm phòng học ạ."
        },
        {
          "id": "132ad461-95b8-57c1-8dd0-a6fc41df38b6-u02",
          "speaker_id": "B",
          "ja": "大丈夫です。入ってください。",
