        {
          "id": "132ad461-95b8-57c1-8dd0-a6fc41df38b6-u04",
          "speaker_id": "B",
          "ja": "一番後ろの空いている席にどうぞ。",
          "vi": "Em ngồi chỗ trống ở hàng cuối nhé."
        }
      ],
