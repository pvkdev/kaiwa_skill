    {
      "situation_uid": "9ecd3605-d093-585f-8fb6-ae36e972efb7",
      "event_id": "E03",
      "context_vi": "Trong lớp, giáo viên đọc quá nhanh một câu hỏi đường mẫu. Bạn nhờ thầy nói chậm lại rồi thử nhắc theo.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Giáo viên",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9ecd3605-d093-585f-8fb6-ae36e972efb7-u01",
          "speaker_id": "B",
          "ja": "駅までどう行けばいいですか。こう聞いてください。",
          "vi": "Em hỏi thế này nhé. “Tôi đi đến ga bằng đường nào ạ?”"
        },
        {
          "id": "9ecd3605-d093-585f-8fb6-ae36e972efb7-u02",
          "speaker_id": "A",
          "ja": "すみません。もう少しゆっくり言ってください。",
          "vi": "Thầy ơi, thầy nói chậm hơn một chút giúp em với ạ."
        },
        {
          "id": "9ecd3605-d093-585f-8fb6-ae36e972efb7-u03",
          "speaker_id": "B",
          "ja": "はい。「駅まで」、それから「どう行けばいいですか」。",
          "vi": "Được. “Đến ga”, rồi “tôi đi bằng đường nào ạ?”."
        },
        {
          "id": "9ecd3605-d093-585f-8fb6-ae36e972efb7-u04",
          "speaker_id": "A",
          "ja": "駅まで、どう行けばいいですか。",
          "vi": "Tôi đi đến ga bằng đường nào ạ?"
        },
        {
          "id": "9ecd3605-d093-585f-8fb6-ae36e972efb7-u05",
          "speaker_id": "B",
          "ja": "はい、それでいいです。",
          "vi": "Đúng rồi em."
        }
      ],
