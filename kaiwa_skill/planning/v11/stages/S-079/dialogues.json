    {
      "situation_uid": "3e62fb3b-8dd0-5e08-9035-1bcb17d2284f",
      "event_id": "E03",
      "context_vi": "Bạn vừa nghe rõ câu hỏi đường mẫu sau khi giáo viên nói chậm. Thầy giao luyện câu đó theo cặp. Bạn nhắc lại thứ tự để chắc mình hiểu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Giáo viên",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3e62fb3b-8dd0-5e08-9035-1bcb17d2284f-u01",
          "speaker_id": "B",
          "ja": "二人で一回練習してから、役を変えてください。",
          "vi": "Hai em luyện một lần rồi đổi vai nhé."
        },
        {
          "id": "3e62fb3b-8dd0-5e08-9035-1bcb17d2284f-u02",
          "speaker_id": "A",
          "ja": "最初に私が道を聞きます。終わったら役を変えますね。",
          "vi": "Đầu tiên em hỏi đường. Xong rồi đổi vai ạ."
        },
        {
          "id": "3e62fb3b-8dd0-5e08-9035-1bcb17d2284f-u03",
          "speaker_id": "A",
          "ja": "役を変えたら、もう一度練習しますか。",
          "vi": "Đổi vai xong mình luyện lại một lần nữa ạ?"
        },
        {
          "id": "3e62fb3b-8dd0-5e08-9035-1bcb17d2284f-u04",
          "speaker_id": "B",
          "ja": "はい、今度は相手が道を聞きます。",
          "vi": "Đúng. Lượt sau người kia hỏi đường."
        }
      ],
