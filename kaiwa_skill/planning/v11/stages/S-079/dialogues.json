          }
        }
      }
    },
    {
      "situation_uid": "043bfded-1237-5f4f-ac50-f70d844b96bf",
      "event_id": "E02",
      "context_vi": "Trong ngày đầu, bạn đã đi nhầm lên phòng 302. Nhìn bảng chỉ dẫn mà vẫn không rõ, bạn hỏi một giáo viên ở hành lang phòng lớp mới ở đâu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Giáo viên",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "043bfded-1237-5f4f-ac50-f70d844b96bf-u01",
          "speaker_id": "A",
          "ja": "日本語の初めてのクラスは、どの部屋ですか。",
          "vi": "Lớp tiếng Nhật cho người mới học ở phòng nào ạ?"
        },
        {
          "id": "043bfded-1237-5f4f-ac50-f70d844b96bf-u02",
          "speaker_id": "B",
          "ja": "二階の二〇三号室です。",
          "vi": "Phòng 203 trên tầng hai."
        },
        {
          "id": "043bfded-1237-5f4f-ac50-f70d844b96bf-u03",
          "speaker_id": "A",
          "ja": "階段を下りたら、どっちですか。",
          "vi": "Xuống cầu thang rồi đi bên nào ạ?"
        },
        {
          "id": "043bfded-1237-5f4f-ac50-f70d844b96bf-u04",
          "speaker_id": "B",
          "ja": "右です。ドアに番号があります。",
          "vi": "Bên phải. Có số trên cửa đấy em."
        }
      ],
      "admin": {
        "source_refs": [
          "class",
          "check"
        ],
