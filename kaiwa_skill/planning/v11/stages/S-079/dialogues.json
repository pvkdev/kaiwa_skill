    {
      "situation_uid": "66f3979d-46b3-5109-b787-31804dd2fe60",
      "event_id": "E03",
      "context_vi": "Giáo viên nói “交代” khi cả lớp tập đóng vai khách và nhân viên. Bạn chưa hiểu từ đó nên hỏi một câu ngắn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Giáo viên",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "66f3979d-46b3-5109-b787-31804dd2fe60-u01",
          "speaker_id": "B",
          "ja": "一回練習したら、交代してください。",
          "vi": "Luyện một lượt xong, các em “交代” nhé."
        },
        {
          "id": "66f3979d-46b3-5109-b787-31804dd2fe60-u02",
          "speaker_id": "A",
          "ja": "すみません。「交代」はどういう意味ですか。",
          "vi": "Thầy ơi, “交代” nghĩa là gì ạ?"
        },
        {
          "id": "66f3979d-46b3-5109-b787-31804dd2fe60-u03",
          "speaker_id": "B",
          "ja": "役を変えることです。お客さんは、次に店員になります。",
          "vi": "Nghĩa là đổi vai. Người đóng khách chuyển sang làm nhân viên."
        },
        {
          "id": "66f3979d-46b3-5109-b787-31804dd2fe60-u04",
          "speaker_id": "A",
          "ja": "ああ、お客さんから店員になるんですね。",
          "vi": "À, từ vai khách chuyển sang vai nhân viên ạ."
        }
      ],
      "admin": {
