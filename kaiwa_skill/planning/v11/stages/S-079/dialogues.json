    {
      "situation_uid": "32556da6-1c8f-5b4b-9ae5-c67038ffcfd7",
      "event_id": "E01",
      "context_vi": "Bạn chỉ học được vào buổi sáng. Bạn muốn hỏi một trường tiếng Nhật có thể đến học thử buổi nào và mấy giờ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Học viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "32556da6-1c8f-5b4b-9ae5-c67038ffcfd7-u01",
          "speaker_id": "A",
          "ja": "午前中なら来られます。体験できる日はありますか。",
          "vi": "Buổi sáng thì tôi đến được. Có hôm nào tôi học thử được không ạ?"
        },
        {
          "id": "32556da6-1c8f-5b4b-9ae5-c67038ffcfd7-u02",
          "speaker_id": "B",
          "ja": "金曜の午前十時に体験できます。",
          "vi": "Chị có thể học thử lúc mười giờ sáng thứ Sáu."
        },
        {
          "id": "32556da6-1c8f-5b4b-9ae5-c67038ffcfd7-u03",
          "speaker_id": "A",
          "ja": "十時に着けばいいですか。",
          "vi": "Tôi đến đúng mười giờ được không ạ?"
        },
        {
          "id": "32556da6-1c8f-5b4b-9ae5-c67038ffcfd7-u04",
          "speaker_id": "B",
          "ja": "十分前に受付に来てください。",
          "vi": "Chị đến quầy tiếp đón trước mười phút nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "class",
          "shinjuku"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "32556da6-1c8f-5b4b-9ae5-c67038ffcfd7-u01": {
