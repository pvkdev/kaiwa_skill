    {
      "situation_uid": "f005c206-2c02-56b8-909c-98207600b2d9",
      "event_id": "E04",
      "context_vi": "Cảnh sát đề nghị bạn tới đồn gần ga vào ngày mai để trao đổi kỹ hơn. Bạn hỏi đến lúc nào và gặp ai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát đến hiện trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f005c206-2c02-56b8-909c-98207600b2d9-u01",
          "speaker_id": "b",
          "ja": "詳しいお話は、あおい警察署で伺います。",
          "vi": "Chúng tôi sẽ trao đổi kỹ hơn ở đồn cảnh sát Aoi ạ."
        },
        {
          "id": "f005c206-2c02-56b8-909c-98207600b2d9-u02",
          "speaker_id": "a",
          "ja": "いつ、誰に話せばいいですか。",
          "vi": "Tôi nên đến lúc nào, gặp ai ạ?"
        },
        {
          "id": "f005c206-2c02-56b8-909c-98207600b2d9-u03",
          "speaker_id": "b",
          "ja": "明日の午前十時に、あおい警察署の受付で鈴木を呼んでください。",
          "vi": "Sáng mai lúc 10 giờ, chị đến quầy đồn cảnh sát Aoi và nhờ gọi anh Suzuki giúp tôi."
        }
      ],
      "admin": {
