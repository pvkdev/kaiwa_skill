    {
      "situation_uid": "f0f0fa5a-3970-52f1-99e2-a27a93d806a2",
      "event_id": "E05",
      "context_vi": "Hôm sau tại quầy cảnh sát hư cấu, bạn nhắc lại vụ việc cửa nam và mốc thời gian mình nhớ được.",
