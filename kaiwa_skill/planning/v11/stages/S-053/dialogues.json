    {
      "situation_uid": "211640c0-caf4-54eb-bad9-547c532b3133",
      "event_id": "E03",
      "context_vi": "Bạn vẫn ở trong tiệm bánh cửa nam ga Aoi. Người tiếp nhận 110 bảo bạn đợi ở bên trong. Bạn nhắc lại để chắc mình hiểu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "211640c0-caf4-54eb-bad9-547c532b3133-u01",
          "speaker_id": "a",
          "ja": "外に出ないで、パン屋の中で待つんですね。",
          "vi": "Vậy tôi cứ đợi bên trong tiệm bánh và không ra ngoài, đúng không ạ?"
        },
        {
          "id": "211640c0-caf4-54eb-bad9-547c532b3133-u02",
          "speaker_id": "b",
          "ja": "はい。その場所を離れるときは、知らせてください。",
          "vi": "Đúng ạ. Nếu phải rời chỗ đó thì báo cho tôi."
        }
      ],
