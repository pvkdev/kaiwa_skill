    {
      "situation_uid": "981efaef-f2bb-5e26-99b6-69b88c4a0b32",
      "event_id": "E05",
      "context_vi": "Trước khi rời quầy, bạn hỏi tên người phụ trách và cách họ sẽ liên hệ an toàn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "981efaef-f2bb-5e26-99b6-69b88c4a0b32-u01",
          "speaker_id": "a",
          "ja": "今後は誰から、どの方法で連絡がありますか。",
          "vi": "Sau này ai sẽ liên hệ với tôi, bằng cách nào ạ?"
        },
