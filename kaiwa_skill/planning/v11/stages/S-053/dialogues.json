    },
    {
      "situation_uid": "d927e4c1-a772-54bf-8cd0-a807df0176e9",
      "event_id": "E03",
      "context_vi": "Tiệm bánh không còn là chỗ thích hợp để đợi. Bạn đã vào cửa hàng Sakura bên cạnh với nhân viên cửa hàng và báo 110 địa điểm mới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d927e4c1-a772-54bf-8cd0-a807df0176e9-u01",
          "speaker_id": "a",
          "ja": "もうパン屋にはいられません。今は隣の店の中です。",
          "vi": "Tôi không thể ở trong tiệm bánh nữa. Bây giờ tôi ở trong cửa hàng bên cạnh ạ."
        },
        {
          "id": "d927e4c1-a772-54bf-8cd0-a807df0176e9-u02",
          "speaker_id": "b",
          "ja": "店の名前を教えてください。",
          "vi": "Cho tôi biết tên cửa hàng ạ."
        },
        {
          "id": "d927e4c1-a772-54bf-8cd0-a807df0176e9-u03",
          "speaker_id": "a",
          "ja": "さくら商店です。",
          "vi": "Là cửa hàng Sakura."
        },
        {
          "id": "d927e4c1-a772-54bf-8cd0-a807df0176e9-u04",
          "speaker_id": "b",
          "ja": "さくら商店の中ですね。向かっている警察官に伝えます。",
          "vi": "Bên trong cửa hàng Sakura ạ. Tôi sẽ báo cho cảnh sát đang đến."
        }
      ],
