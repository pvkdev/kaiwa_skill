    {
      "situation_uid": "c349b76e-2d28-59c7-a40c-4b618ca6d9b2",
      "event_id": "E05",
      "context_vi": "Bạn đã sửa mốc thời gian. Bạn chưa nhớ rõ màu áo khoác người mình nhìn thấy, nên hỏi nếu sau này nhớ thì báo cách nào.",
      "speakers": [
        {
          "id": "a",
