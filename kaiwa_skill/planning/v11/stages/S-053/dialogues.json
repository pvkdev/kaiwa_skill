          }
        }
      }
    },
    {
      "situation_uid": "07de899c-4461-53d7-8c1a-1a925d789f4e",
      "event_id": "E01",
      "context_vi": "Sau khi người giúp đã gọi 110, họ phải rời đi. Bạn xin họ chỉ người ở cửa hàng có thể ở cạnh mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "07de899c-4461-53d7-8c1a-1a925d789f4e-u01",
          "speaker_id": "b",
          "ja": "百十番には電話しました。すみません、もう行かないといけなくて。",
          "vi": "Tôi đã gọi 110 rồi. Xin lỗi, giờ tôi phải đi ạ."
        },
        {
          "id": "07de899c-4461-53d7-8c1a-1a925d789f4e-u02",
          "speaker_id": "a",
          "ja": "誰か、ここで一緒に待ってくれませんか。",
          "vi": "Có ai đứng đây cùng tôi đợi được không ạ?"
        },
        {
          "id": "07de899c-4461-53d7-8c1a-1a925d789f4e-u03",
          "speaker_id": "b",
          "ja": "あの店の人に一緒に声をかけましょう。",
          "vi": "Ta cùng nhờ người ở cửa hàng kia nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "07de899c-4461-53d7-8c1a-1a925d789f4e-u01": {
            "kind": "original_extension"
          },
          "07de899c-4461-53d7-8c1a-1a925d789f4e-u02": {
            "kind": "original_extension"
          },
          "07de899c-4461-53d7-8c1a-1a925d789f4e-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0e7ee3d0-d326-53fd-a98d-58ec17553e20",
      "event_id": "E02",
      "context_vi": "Bạn gọi 110 khi đang bị đe dọa ở cửa nam ga Aoi hư cấu. Người tiếp nhận hỏi chuyện gì xảy ra.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0e7ee3d0-d326-53fd-a98d-58ec17553e20-u01",
          "speaker_id": "b",
          "ja": "百十番です。何がありましたか。",
          "vi": "Tổng đài 110. Có việc gì ạ?"
        },
        {
          "id": "0e7ee3d0-d326-53fd-a98d-58ec17553e20-u02",
          "speaker_id": "a",
          "ja": "あおい駅の南口、さくら通りです。人に道をふさがれて、脅されました。",
          "vi": "Tôi ở phố Sakura, cửa nam ga Aoi. Có người chặn đường rồi đe dọa tôi ạ."
        },
        {
          "id": "0e7ee3d0-d326-53fd-a98d-58ec17553e20-u03",
          "speaker_id": "b",
          "ja": "何時ごろのことですか。",
          "vi": "Việc đó xảy ra khoảng mấy giờ ạ?"
        },
        {
          "id": "0e7ee3d0-d326-53fd-a98d-58ec17553e20-u04",
          "speaker_id": "a",
          "ja": "午後二時半ごろです。相手はまだ近くにいます。",
          "vi": "Khoảng 2 giờ 30 chiều. Người đó vẫn ở gần đây ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa",
          "dispatch"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0e7ee3d0-d326-53fd-a98d-58ec17553e20-u01": {
