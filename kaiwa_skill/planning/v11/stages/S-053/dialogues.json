          }
        }
      }
    },
    {
      "situation_uid": "3c47c776-f2d0-5520-a99d-9150243e6917",
      "event_id": "E02",
      "context_vi": "Người tiếp nhận 110 hỏi bạn có tận mắt thấy vũ khí không. Bạn chỉ nói phần đã quan sát.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3c47c776-f2d0-5520-a99d-9150243e6917-u01",
          "speaker_id": "b",
          "ja": "相手が武器を持っているのを見ましたか。",
          "vi": "Bạn có nhìn thấy người đó cầm vũ khí không?"
        },
        {
          "id": "3c47c776-f2d0-5520-a99d-9150243e6917-u02",
          "speaker_id": "a",
          "ja": "武器は見ていません。相手の手は、よく見えませんでした。",
          "vi": "Tôi không thấy vũ khí. Tôi không nhìn rõ tay người đó ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3c47c776-f2d0-5520-a99d-9150243e6917-u01": {
            "kind": "original_extension"
          },
          "3c47c776-f2d0-5520-a99d-9150243e6917-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "fe72d84c-9870-5353-ae99-d11a6071b4f6",
      "event_id": "E02",
      "context_vi": "Bạn vừa báo đang ở phố Sakura bên cửa nam ga Aoi. Khi nhìn biển đường, bạn thấy tên đúng là phố Aoba và báo sửa ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fe72d84c-9870-5353-ae99-d11a6071b4f6-u01",
          "speaker_id": "a",
          "ja": "すみません、さくら通りではなく、あおば通りです。あおい駅の南口です。",
          "vi": "Xin lỗi, tên đường đúng là phố Aoba. Tôi ở cửa nam ga Aoi ạ."
        },
        {
          "id": "fe72d84c-9870-5353-ae99-d11a6071b4f6-u02",
          "speaker_id": "b",
          "ja": "あおい駅の南口、あおば通りですね。訂正します。",
          "vi": "Cửa nam ga Aoi, phố Aoba phải không ạ? Tôi sẽ sửa lại."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa",
          "dispatch"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fe72d84c-9870-5353-ae99-d11a6071b4f6-u01": {
            "kind": "original_extension"
          },
          "fe72d84c-9870-5353-ae99-d11a6071b4f6-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "787565f7-fec5-5774-be80-47629403fd25",
      "event_id": "E02",
      "context_vi": "Trong cuộc gọi 110 về vụ đe dọa ở cửa nam ga Aoi, bạn không thể nói dài và cần hỗ trợ ngôn ngữ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "787565f7-fec5-5774-be80-47629403fd25-u01",
          "speaker_id": "a",
          "ja": "あおい駅の南口です。人に脅されています。日本語が少しだけ分かります。ベトナム語で話せますか。",
          "vi": "Tôi ở cửa nam ga Aoi. Có người đang đe dọa tôi. Tôi chỉ hiểu một chút tiếng Nhật. Tôi có thể nói bằng tiếng Việt không ạ?"
        },
        {
          "id": "787565f7-fec5-5774-be80-47629403fd25-u02",
          "speaker_id": "b",
          "ja": "ベトナム語で話せるか確認します。今、いる場所は安全ですか。",
          "vi": "Tôi sẽ kiểm tra xem có hỗ trợ tiếng Việt được không. Chỗ chị đang đứng có an toàn không ạ?"
        },
        {
          "id": "787565f7-fec5-5774-be80-47629403fd25-u03",
          "speaker_id": "a",
          "ja": "はい。今は店の中です。",
          "vi": "Vâng. Giờ tôi đang ở trong cửa hàng ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa",
          "police_languages"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "787565f7-fec5-5774-be80-47629403fd25-u01": {
            "kind": "original_extension"
          },
          "787565f7-fec5-5774-be80-47629403fd25-u02": {
            "kind": "original_extension"
          },
          "787565f7-fec5-5774-be80-47629403fd25-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "9026189b-3f26-5ce9-878c-cd8b43c2e701",
      "event_id": "E03",
      "context_vi": "Bạn đã vào một tiệm bánh ở cửa nam ga Aoi để tránh người đe dọa. Bạn báo trước mình đang ở trong tiệm và hỏi đợi cảnh sát ở đâu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9026189b-3f26-5ce9-878c-cd8b43c2e701-u01",
          "speaker_id": "a",
          "ja": "南口のパン屋の中です。警察の方が来るまで、ここで待てばいいですか。",
          "vi": "Tôi đang ở trong tiệm bánh ở cửa nam. Tôi đợi cảnh sát đến ở đây được không ạ?"
        },
        {
          "id": "9026189b-3f26-5ce9-878c-cd8b43c2e701-u02",
          "speaker_id": "b",
          "ja": "はい、中で待っていてください。南口のパン屋の看板を目印に伝えます。",
          "vi": "Vâng, chị cứ đợi bên trong. Tôi sẽ báo lấy biển hiệu tiệm bánh ở cửa nam làm mốc."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa",
          "dispatch"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9026189b-3f26-5ce9-878c-cd8b43c2e701-u01": {
