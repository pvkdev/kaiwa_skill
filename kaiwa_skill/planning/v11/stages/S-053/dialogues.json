            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3c47c776-f2d0-5520-a99d-9150243e6917",
      "event_id": "E02",
      "context_vi": "Người tiếp nhận 110 hỏi bạn có tận mắt thấy vũ khí không. Bạn chỉ nói phần đã quan sát.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3c47c776-f2d0-5520-a99d-9150243e6917-u01",
          "speaker_id": "b",
          "ja": "相手が武器を持っているのを見ましたか。",
          "vi": "Bạn có nhìn thấy người đó cầm vũ khí không?"
        },
        {
          "id": "3c47c776-f2d0-5520-a99d-9150243e6917-u02",
          "speaker_id": "a",
          "ja": "見ていません。手はよく見えませんでした。",
          "vi": "Tôi không nhìn thấy. Tôi cũng không thấy rõ tay người đó."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3c47c776-f2d0-5520-a99d-9150243e6917-u01": {
            "kind": "original_extension"
          },
          "3c47c776-f2d0-5520-a99d-9150243e6917-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "fe72d84c-9870-5353-ae99-d11a6071b4f6",
      "event_id": "E02",
      "context_vi": "Trong cuộc gọi 110, bạn nhìn lại biển ga và thấy mình vừa nói nhầm tên ga Aoi thành tên khác. Bạn sửa ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fe72d84c-9870-5353-ae99-d11a6071b4f6-u01",
          "speaker_id": "a",
          "ja": "先ほど「あおい駅」と言いましたが、駅の名前は「あおば駅」です。南口のパン屋の前です。",
          "vi": "Lúc nãy tôi nói ga Aoi, nhưng tên đúng là ga Aoba. Tôi ở trước tiệm bánh cửa nam."
        },
        {
          "id": "fe72d84c-9870-5353-ae99-d11a6071b4f6-u02",
          "speaker_id": "b",
          "ja": "あおば駅の南口ですね。情報を直します。",
          "vi": "Cửa nam ga Aoba. Tôi sẽ sửa thông tin."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fe72d84c-9870-5353-ae99-d11a6071b4f6-u01": {
            "kind": "original_extension"
          },
          "fe72d84c-9870-5353-ae99-d11a6071b4f6-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "787565f7-fec5-5774-be80-47629403fd25",
      "event_id": "E02",
      "context_vi": "Trong cuộc gọi 110 về vụ đe dọa ở cửa nam ga Aoi, bạn không thể nói dài và cần hỗ trợ ngôn ngữ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "787565f7-fec5-5774-be80-47629403fd25-u01",
          "speaker_id": "a",
          "ja": "長く話せません。ベトナム語を話せる人はいますか。あおい駅の南口で脅されています。",
          "vi": "Tôi không nói dài được. Có người hỗ trợ tiếng Việt không ạ? Tôi đang bị đe dọa ở cửa nam ga Aoi."
        },
        {
          "id": "787565f7-fec5-5774-be80-47629403fd25-u02",
          "speaker_id": "b",
          "ja": "まず場所を確認しました。安全な位置を教えてください。",
          "vi": "Trước tiên tôi đã ghi vị trí. Hãy cho biết chỗ bạn đang đứng có an toàn không."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "787565f7-fec5-5774-be80-47629403fd25-u01": {
            "kind": "original_extension"
          },
          "787565f7-fec5-5774-be80-47629403fd25-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "9026189b-3f26-5ce9-878c-cd8b43c2e701",
      "event_id": "E03",
      "context_vi": "Bạn đã vào chỗ an toàn gần cửa nam ga Aoi. Bạn hỏi người tiếp nhận 110 nơi có thể gặp cảnh sát đến hỗ trợ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9026189b-3f26-5ce9-878c-cd8b43c2e701-u01",
          "speaker_id": "a",
          "ja": "警察の人とは、どこで会えばいいですか。",
          "vi": "Tôi nên gặp cảnh sát ở đâu ạ?"
        },
        {
          "id": "9026189b-3f26-5ce9-878c-cd8b43c2e701-u02",
          "speaker_id": "b",
          "ja": "安全な場所にいてください。南口のパン屋の看板を目印に伝えます。",
          "vi": "Bạn hãy ở chỗ an toàn. Tôi sẽ báo biển tiệm bánh cửa nam làm mốc."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9026189b-3f26-5ce9-878c-cd8b43c2e701-u01": {
            "kind": "original_extension"
          },
          "9026189b-3f26-5ce9-878c-cd8b43c2e701-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d927e4c1-a772-54bf-8cd0-a807df0176e9",
      "event_id": "E03",
      "context_vi": "Sau khi được hẹn dùng biển tiệm bánh làm mốc, bạn không thể đứng ở đó và vào cửa hàng Sakura trước ga.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d927e4c1-a772-54bf-8cd0-a807df0176e9-u01",
          "speaker_id": "a",
          "ja": "パン屋の前にはもう立てません。今は駅前の店の中にいます。",
          "vi": "Tôi không thể đứng trước tiệm bánh nữa. Giờ tôi ở trong cửa hàng trước ga."
        },
        {
          "id": "d927e4c1-a772-54bf-8cd0-a807df0176e9-u02",
          "speaker_id": "b",
          "ja": "店の名前を教えてください。",
          "vi": "Cho tôi biết tên cửa hàng ạ."
        },
        {
          "id": "d927e4c1-a772-54bf-8cd0-a807df0176e9-u03",
          "speaker_id": "a",
          "ja": "さくら商店です。",
          "vi": "Là cửa hàng Sakura."
        },
        {
          "id": "d927e4c1-a772-54bf-8cd0-a807df0176e9-u04",
          "speaker_id": "b",
          "ja": "さくら商店ですね。到着する人に伝えます。",
          "vi": "Cửa hàng Sakura. Tôi sẽ báo cho người đến."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d927e4c1-a772-54bf-8cd0-a807df0176e9-u01": {
