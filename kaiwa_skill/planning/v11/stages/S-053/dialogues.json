    {
      "situation_uid": "3acff39d-f544-5764-b905-837da94a2d99",
      "event_id": "E04",
      "context_vi": "Cảnh sát đến cửa hàng gần cửa nam ga Aoi. Bạn kể ngắn trình tự bị chặn đường rồi vào cửa hàng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát đến hiện trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3acff39d-f544-5764-b905-837da94a2d99-u01",
          "speaker_id": "a",
          "ja": "午後二時半ごろ、南口で一人に道をふさがれました。怖かったので、近くの店に入りました。",
          "vi": "Khoảng 2 giờ 30 chiều, một người chặn đường tôi ở cửa nam. Tôi sợ nên vào cửa hàng gần đó ạ."
        },
        {
          "id": "3acff39d-f544-5764-b905-837da94a2d99-u02",
          "speaker_id": "b",
          "ja": "分かりました。店に入る前に見たことを、もう少し聞かせてください。",
          "vi": "Tôi hiểu. Chị kể thêm những điều đã thấy trước khi vào cửa hàng nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
