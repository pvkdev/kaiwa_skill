    {
      "situation_uid": "689b6ece-f218-5944-bf2a-1c9f8213a2ec",
      "event_id": "E03",
      "context_vi": "Từ chỗ an toàn, bạn thấy thêm một người tới gần nhưng không biết họ có liên quan. Bạn báo đúng điều quan sát.",
      "speakers": [
