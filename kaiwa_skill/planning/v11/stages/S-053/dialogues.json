            "kind": "original_extension"
          },
          "3bf6d5f7-befb-5c06-838b-d599b447a1b0-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "f993e0f8-84ad-5a92-ad72-1b5f935d79fc",
      "event_id": "E01",
      "context_vi": "Người ở gần đã đồng ý gọi 110 và hỏi vị trí để báo đúng. Bạn chỉ biển tiệm bánh ở cửa nam ga Aoi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f993e0f8-84ad-5a92-ad72-1b5f935d79fc-u01",
          "speaker_id": "b",
          "ja": "今、どこにいますか。",
          "vi": "Bây giờ bạn ở đâu ạ?"
        },
        {
          "id": "f993e0f8-84ad-5a92-ad72-1b5f935d79fc-u02",
          "speaker_id": "a",
          "ja": "あおい駅の南口、パン屋の看板の前です。",
          "vi": "Trước biển hiệu tiệm bánh ở cửa nam ga Aoi."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f993e0f8-84ad-5a92-ad72-1b5f935d79fc-u01": {
            "kind": "original_extension"
          },
          "f993e0f8-84ad-5a92-ad72-1b5f935d79fc-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3b8e5538-973b-5dca-9a49-fd942e0df6b4",
      "event_id": "E01",
      "context_vi": "Người giúp nói nhanh trong lúc bạn đang hoảng. Bạn xin họ hỏi từng câu ngắn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3b8e5538-973b-5dca-9a49-fd942e0df6b4-u01",
          "speaker_id": "a",
          "ja": "すみません。聞こえませんでした。短く一つずつ言ってください。",
          "vi": "Xin lỗi, tôi không nghe rõ. Anh nói từng câu ngắn giúp tôi."
        },
        {
          "id": "3b8e5538-973b-5dca-9a49-fd942e0df6b4-u02",
          "speaker_id": "b",
          "ja": "分かりました。まず、今いる場所はどこですか。",
          "vi": "Được. Trước tiên bạn đang ở đâu?"
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3b8e5538-973b-5dca-9a49-fd942e0df6b4-u01": {
            "kind": "original_extension"
          },
          "3b8e5538-973b-5dca-9a49-fd942e0df6b4-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "07de899c-4461-53d7-8c1a-1a925d789f4e",
      "event_id": "E01",
      "context_vi": "Sau khi người giúp đã gọi 110, họ phải rời đi. Bạn xin họ chỉ người ở cửa hàng có thể ở cạnh mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "07de899c-4461-53d7-8c1a-1a925d789f4e-u01",
          "speaker_id": "b",
          "ja": "110には電話しましたが、私はもう行かなければなりません。",
          "vi": "Tôi đã gọi 110, nhưng giờ tôi phải rời đi."
        },
        {
          "id": "07de899c-4461-53d7-8c1a-1a925d789f4e-u02",
          "speaker_id": "a",
          "ja": "ほかに一緒に待ってくれる人はいますか。",
          "vi": "Có ai khác có thể đứng cùng tôi đợi không?"
        },
        {
          "id": "07de899c-4461-53d7-8c1a-1a925d789f4e-u03",
          "speaker_id": "b",
          "ja": "あの店の人に一緒に声をかけましょう。",
          "vi": "Ta cùng nhờ người ở cửa hàng kia nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "07de899c-4461-53d7-8c1a-1a925d789f4e-u01": {
