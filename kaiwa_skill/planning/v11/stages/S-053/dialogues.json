    {
      "situation_uid": "d1f0f53c-8472-51ee-96e1-fc6bcc11cda0",
      "event_id": "E05",
      "context_vi": "Khi nghĩ lại, bạn nhớ thời điểm bị chặn đường khoảng 2 giờ 30 chiều, giống mốc mình đã nói trong cuộc gọi khẩn cấp. Bạn chủ động sửa mốc vừa kể ở quầy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d1f0f53c-8472-51ee-96e1-fc6bcc11cda0-u01",
          "speaker_id": "a",
          "ja": "さっき三時ごろと言いましたが、道をふさがれたのは午後二時半ごろです。訂正してもいいですか。",
          "vi": "Lúc nãy tôi nói khoảng 3 giờ, nhưng tôi bị chặn đường khoảng 2 giờ 30 chiều. Tôi sửa lại được không ạ?"
        },
        {
          "id": "d1f0f53c-8472-51ee-96e1-fc6bcc11cda0-u02",
          "speaker_id": "b",
          "ja": "二時半ごろですね。訂正します。",
          "vi": "Khoảng 2 giờ 30. Tôi sẽ sửa."
