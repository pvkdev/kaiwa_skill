  "dialogues": [
    {
      "situation_uid": "3bf6d5f7-befb-5c06-838b-d599b447a1b0",
      "event_id": "E01",
      "context_vi": "Ở ngoài cửa nam ga Aoi hư cấu, có người đang đe dọa bạn. Bạn nhờ người đứng gần gọi 110 từ chỗ an toàn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3bf6d5f7-befb-5c06-838b-d599b447a1b0-u01",
          "speaker_id": "a",
          "ja": "あそこで人に脅されています。安全な所から110に電話してください。",
          "vi": "Có người đang đe dọa tôi ở kia. Nhờ anh gọi 110 từ chỗ an toàn."
        },
        {
          "id": "3bf6d5f7-befb-5c06-838b-d599b447a1b0-u02",
          "speaker_id": "b",
          "ja": "分かりました。今、電話します。",
          "vi": "Tôi hiểu. Tôi gọi ngay."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
