    {
      "situation_uid": "211640c0-caf4-54eb-bad9-547c532b3133",
      "event_id": "E03",
      "context_vi": "Người tiếp nhận 110 đã dặn bạn ở chỗ an toàn trong cửa hàng. Bạn nhắc lại để chắc mình hiểu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "211640c0-caf4-54eb-bad9-547c532b3133-u01",
          "speaker_id": "a",
          "ja": "店の中の安全な所で待つのですね。",
          "vi": "Vậy tôi chờ ở chỗ an toàn trong cửa hàng, đúng không ạ?"
        },
        {
          "id": "211640c0-caf4-54eb-bad9-547c532b3133-u02",
          "speaker_id": "b",
          "ja": "はい。近づかず、今の場所を知らせてください。",
          "vi": "Đúng. Đừng đến gần người đó, và báo vị trí hiện tại cho tôi."
        }
      ],
      "admin": {
