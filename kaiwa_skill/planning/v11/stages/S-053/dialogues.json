    {
      "situation_uid": "ce0c42be-43a1-586a-80a4-febe840b92b3",
      "event_id": "E04",
      "context_vi": "Bạn đã hẹn ngày mai đến đồn Aoi. Bạn hỏi số để liên hệ lại và cho cảnh sát biết cách gọi để người khác không nghe được lời nhắn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát đến hiện trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ce0c42be-43a1-586a-80a4-febe840b92b3-u01",
          "speaker_id": "a",
          "ja": "後で聞きたいことがあったら、どの番号に電話すればいいですか。",
          "vi": "Sau này nếu có điều cần hỏi, tôi nên gọi số nào ạ?"
        },
        {
          "id": "ce0c42be-43a1-586a-80a4-febe840b92b3-u02",
          "speaker_id": "b",
          "ja": "この紙にある警察署の代表番号に電話してください。こちらからお電話するときは、どの番号がいいですか。",
          "vi": "Chị gọi số của đồn in trên tờ này nhé. Còn nếu chúng tôi gọi, chị muốn nhận ở số nào ạ?"
        },
        {
          "id": "ce0c42be-43a1-586a-80a4-febe840b92b3-u03",
          "speaker_id": "a",
          "ja": "この番号なら出られます。出なかったら、留守電には何も入れないでください。",
          "vi": "Tôi nghe được ở số này ạ. Nếu tôi không nhấc máy, xin đừng để lại tin nhắn thoại."
        },
        {
          "id": "ce0c42be-43a1-586a-80a4-febe840b92b3-u04",
          "speaker_id": "b",
          "ja": "分かりました。この番号にかけます。留守電には残しません。",
          "vi": "Tôi hiểu. Tôi sẽ gọi vào số này và không để lại lời nhắn thoại."
        }
      ],
      "admin": {
