    {
      "situation_uid": "c28aba9b-aa4d-53bb-b630-b15ff508eaa2",
      "event_id": "E04",
      "context_vi": "Một người khác kể đã thấy hai người. Bạn chỉ thấy một; cảnh sát cần phân biệt lời bạn tận mắt thấy với lời nghe kể.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát đến hiện trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c28aba9b-aa4d-53bb-b630-b15ff508eaa2-u01",
          "speaker_id": "a",
          "ja": "私は一人だけ見ました。二人いたという話は、ほかの人から聞きました。",
          "vi": "Tôi chỉ nhìn thấy một người. Chuyện có hai người là tôi nghe người khác kể."
        },
        {
          "id": "c28aba9b-aa4d-53bb-b630-b15ff508eaa2-u02",
          "speaker_id": "b",
          "ja": "見たことと聞いたことを分けて記録します。",
          "vi": "Tôi sẽ ghi riêng điều bạn thấy và điều bạn nghe kể."
        }
      ],
