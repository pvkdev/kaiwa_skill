    {
      "situation_uid": "f0f0fa5a-3970-52f1-99e2-a27a93d806a2",
      "event_id": "E05",
      "context_vi": "Sáng hôm sau, bạn tới đồn cảnh sát Aoi theo lịch 10 giờ và gặp Suzuki. Khi được hỏi sự việc bắt đầu lúc nào rồi bạn làm gì, lúc đầu bạn nhớ nhầm giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f0f0fa5a-3970-52f1-99e2-a27a93d806a2-u01",
          "speaker_id": "a",
          "ja": "昨日の午後三時ごろ、あおい駅の南口で道をふさがれたと思います。それで、近くの店に入りました。",
          "vi": "Tôi nhớ hình như khoảng 3 giờ chiều hôm qua có người chặn đường tôi ở cửa nam ga Aoi. Sau đó tôi vào cửa hàng gần đó ạ."
        },
        {
          "id": "f0f0fa5a-3970-52f1-99e2-a27a93d806a2-u02",
          "speaker_id": "b",
          "ja": "南口で道をふさがれてから、お店に入ったんですね。",
          "vi": "Chị bị chặn đường ở cửa nam rồi vào cửa hàng, đúng không ạ?"
        }
      ],
      "admin": {
