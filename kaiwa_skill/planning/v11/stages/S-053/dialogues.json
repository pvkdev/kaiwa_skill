    {
      "situation_uid": "c349b76e-2d28-59c7-a40c-4b618ca6d9b2",
      "event_id": "E05",
      "context_vi": "Sau khi sửa mốc giờ, bạn còn một chi tiết chưa chắc. Bạn hỏi cách bổ sung khi kiểm được.",
