    {
      "situation_uid": "ce0c42be-43a1-586a-80a4-febe840b92b3",
      "event_id": "E04",
      "context_vi": "Cảnh sát đã hẹn bạn kể tiếp. Bạn lo an toàn nếu cần liên lạc sau và hỏi số quầy cùng cách cảnh sát gọi bạn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát đến hiện trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ce0c42be-43a1-586a-80a4-febe840b92b3-u01",
          "speaker_id": "a",
          "ja": "後で安全に連絡するには、どこに電話すればいいですか。",
          "vi": "Sau này muốn liên hệ lại an toàn, tôi nên gọi ở đâu ạ?"
        },
        {
          "id": "ce0c42be-43a1-586a-80a4-febe840b92b3-u02",
          "speaker_id": "b",
          "ja": "この案内にある交番の代表番号へ電話してください。こちらからの連絡は、出られる番号を確認します。",
          "vi": "Bạn gọi số tổng đài của chốt cảnh sát trên tờ hướng dẫn này. Nếu chúng tôi gọi cho bạn, tôi sẽ xác nhận số bạn có thể nghe an toàn."
        },
        {
          "id": "ce0c42be-43a1-586a-80a4-febe840b92b3-u03",
          "speaker_id": "a",
          "ja": "この番号なら出られます。",
          "vi": "Tôi có thể nghe máy ở số này."
        }
      ],
