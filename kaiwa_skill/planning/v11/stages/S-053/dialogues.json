  "dialogues": [
    {
      "situation_uid": "3bf6d5f7-befb-5c06-838b-d599b447a1b0",
      "event_id": "E01",
      "context_vi": "Một người vừa đe dọa bạn gần cửa nam ga Aoi. Bạn lùi về chỗ có người và nhờ người đứng cạnh gọi cảnh sát.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3bf6d5f7-befb-5c06-838b-d599b447a1b0-u01",
          "speaker_id": "a",
          "ja": "すみません、あの人に脅されました。まだ近くにいます。百十番に電話してください。",
          "vi": "Xin giúp với ạ, người kia vừa đe dọa tôi. Họ vẫn ở gần đây. Anh gọi 110 giúp tôi."
        },
        {
          "id": "3bf6d5f7-befb-5c06-838b-d599b447a1b0-u02",
          "speaker_id": "b",
          "ja": "分かりました。今、電話します。",
          "vi": "Tôi hiểu. Tôi gọi ngay."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3bf6d5f7-befb-5c06-838b-d599b447a1b0-u01": {
            "kind": "original_extension"
          },
          "3bf6d5f7-befb-5c06-838b-d599b447a1b0-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "f993e0f8-84ad-5a92-ad72-1b5f935d79fc",
      "event_id": "E01",
      "context_vi": "Người ở gần đã đồng ý gọi 110 và hỏi vị trí để báo đúng. Bạn chỉ biển tiệm bánh ở cửa nam ga Aoi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f993e0f8-84ad-5a92-ad72-1b5f935d79fc-u01",
          "speaker_id": "b",
          "ja": "今、どこにいますか。",
          "vi": "Bây giờ bạn ở đâu ạ?"
        },
        {
          "id": "f993e0f8-84ad-5a92-ad72-1b5f935d79fc-u02",
          "speaker_id": "a",
          "ja": "あおい駅の南口、パン屋の看板の前です。",
          "vi": "Trước biển hiệu tiệm bánh ở cửa nam ga Aoi."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f993e0f8-84ad-5a92-ad72-1b5f935d79fc-u01": {
            "kind": "original_extension"
          },
          "f993e0f8-84ad-5a92-ad72-1b5f935d79fc-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3b8e5538-973b-5dca-9a49-fd942e0df6b4",
      "event_id": "E01",
      "context_vi": "Người giúp nói nhanh trong lúc bạn đang hoảng. Bạn xin họ hỏi từng câu ngắn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3b8e5538-973b-5dca-9a49-fd942e0df6b4-u01",
          "speaker_id": "a",
          "ja": "すみません、分かりません。短く、一つずつ聞いてください。",
          "vi": "Xin lỗi, tôi chưa hiểu. Anh hỏi ngắn, từng câu một giúp tôi."
        },
        {
          "id": "3b8e5538-973b-5dca-9a49-fd942e0df6b4-u02",
          "speaker_id": "b",
          "ja": "分かりました。まず、今いる場所はどこですか。",
          "vi": "Được. Trước tiên bạn đang ở đâu?"
        },
        {
          "id": "3b8e5538-973b-5dca-9a49-fd942e0df6b4-u03",
          "speaker_id": "a",
          "ja": "あおい駅の南口です。パン屋の看板の前です。",
          "vi": "Cửa nam ga Aoi ạ. Trước biển hiệu tiệm bánh."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3b8e5538-973b-5dca-9a49-fd942e0df6b4-u01": {
