    {
      "situation_uid": "3acff39d-f544-5764-b905-837da94a2d99",
      "event_id": "E04",
      "context_vi": "Cảnh sát đến cửa hàng gần cửa nam ga Aoi. Bạn kể ngắn trình tự bị chặn đường rồi vào cửa hàng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát đến hiện trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3acff39d-f544-5764-b905-837da94a2d99-u01",
          "speaker_id": "a",
          "ja": "南口で一人に道をふさがれました。二時ごろ、店に入りました。",
          "vi": "Ở cửa nam, một người chặn đường tôi. Khoảng 2 giờ, tôi vào cửa hàng."
        },
        {
          "id": "3acff39d-f544-5764-b905-837da94a2d99-u02",
          "speaker_id": "b",
          "ja": "分かりました。その前に見たことも聞きます。",
          "vi": "Tôi hiểu. Tôi sẽ hỏi thêm những gì bạn thấy trước đó."
        }
      ],
