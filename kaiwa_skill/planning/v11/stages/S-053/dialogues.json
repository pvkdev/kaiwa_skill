    {
      "situation_uid": "f005c206-2c02-56b8-909c-98207600b2d9",
      "event_id": "E04",
      "context_vi": "Sau khi nghe chuyện tại hiện trường, cảnh sát đề nghị bạn kể thêm ở quầy tiếp nhận hư cấu. Bạn hỏi thời điểm và người gặp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát đến hiện trường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f005c206-2c02-56b8-909c-98207600b2d9-u01",
          "speaker_id": "b",
          "ja": "詳しい話は、交番の受付で続きを聞きます。",
          "vi": "Phần kể chi tiết sẽ được tiếp nhận ở quầy chốt cảnh sát."
        },
        {
          "id": "f005c206-2c02-56b8-909c-98207600b2d9-u02",
          "speaker_id": "a",
          "ja": "いつ、誰に話せばいいですか。",
          "vi": "Tôi nên đến lúc nào, gặp ai ạ?"
        },
        {
          "id": "f005c206-2c02-56b8-909c-98207600b2d9-u03",
          "speaker_id": "b",
          "ja": "明日の十時に、受付の鈴木にこの件を伝えてください。",
          "vi": "Ngày mai lúc 10 giờ, bạn báo việc này với Suzuki ở quầy tiếp nhận."
        }
      ],
