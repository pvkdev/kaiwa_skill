        {
          "id": "b",
          "role_vi": "cảnh sát tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c349b76e-2d28-59c7-a40c-4b618ca6d9b2-u01",
          "speaker_id": "a",
          "ja": "上着の色はまだよく思い出せません。後で思い出したら、どう伝えればいいですか。",
          "vi": "Tôi chưa nhớ rõ màu áo khoác. Khi nào nhớ ra, tôi báo bằng cách nào ạ?"
        },
        {
          "id": "c349b76e-2d28-59c7-a40c-4b618ca6d9b2-u02",
          "speaker_id": "b",
          "ja": "この警察署に電話して、この受付番号を伝えてください。",
          "vi": "Chị gọi đồn này và đọc mã tiếp nhận này nhé."
        }
      ],
