    {
      "situation_uid": "689b6ece-f218-5944-bf2a-1c9f8213a2ec",
      "event_id": "E03",
      "context_vi": "Bạn vẫn đợi cảnh sát trong tiệm bánh. Qua cửa kính, bạn thấy thêm một người đến gần người đã đe dọa mình, nhưng không biết họ có liên quan không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "689b6ece-f218-5944-bf2a-1c9f8213a2ec-u01",
          "speaker_id": "a",
          "ja": "もう一人、近くに来ました。関係があるかは分かりません。私は店の中にいます。",
          "vi": "Có thêm một người đến gần. Tôi không biết họ có liên quan không. Tôi vẫn ở trong tiệm ạ."
        },
        {
          "id": "689b6ece-f218-5944-bf2a-1c9f8213a2ec-u02",
          "speaker_id": "b",
          "ja": "分かりました。そのまま中で待っていてください。",
          "vi": "Tôi hiểu rồi. Chị cứ đợi bên trong ạ."
        }
      ],
