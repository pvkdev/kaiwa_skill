  "dialogues": [
    {
      "situation_uid": "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97",
      "event_id": "E01",
      "context_vi": "Bạn đến trung tâm hỗ trợ cư dân nước ngoài Midori hư cấu vì không hiểu lời ở phòng khám gần nhà. Bạn muốn hỏi trước nơi có thể được giải thích.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97-u01",
          "speaker_id": "a",
          "ja": "家の近くの病院で、説明が分かりませんでした。どこに相談できますか。",
          "vi": "Tôi không hiểu lời giải thích ở phòng khám gần nhà. Tôi có thể hỏi ở đâu ạ?"
        },
        {
          "id": "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97-u02",
          "speaker_id": "b",
          "ja": "どの市にお住まいですか。",
          "vi": "Bạn sống ở thành phố nào ạ?"
        },
        {
          "id": "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97-u03",
          "speaker_id": "a",
          "ja": "みどり市です。",
          "vi": "Tôi sống ở thành phố Midori."
        },
        {
          "id": "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97-u04",
          "speaker_id": "b",
          "ja": "では、まずこの相談センターでお話を聞きます。",
          "vi": "Vậy trước tiên trung tâm này sẽ nghe bạn trình bày."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97-u01": {
