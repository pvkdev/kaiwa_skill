          }
        }
      }
    },
    {
      "situation_uid": "9d766471-12bb-5ba6-9ce2-7bf05aa83281",
      "event_id": "E03",
      "context_vi": "Thứ Ba tuần sau có thể quá muộn vì thông báo hư cấu phải hỏi trong tuần này. Bạn nói rõ mức gấp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9d766471-12bb-5ba6-9ce2-7bf05aa83281-u01",
          "speaker_id": "a",
          "ja": "来週では遅いかもしれません。通知に今週の期限があります。",
          "vi": "Tuần sau có thể muộn. Trên thông báo ghi hạn trong tuần này."
        },
