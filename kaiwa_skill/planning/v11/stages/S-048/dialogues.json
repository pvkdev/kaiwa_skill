    {
      "situation_uid": "117e9bd9-483b-524d-b6a6-50a81c277a87",
      "event_id": "E03",
      "context_vi": "Trước khi lịch thứ Ba được chốt, bạn muốn hỏi liệu có thể đổi sang thứ Năm mà vẫn có hỗ trợ tiếng Việt không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "117e9bd9-483b-524d-b6a6-50a81c277a87-u01",
          "speaker_id": "a",
          "ja": "火曜日が候補と聞きました。木曜日にできますか。ベトナム語の担当者もいますか。",
          "vi": "Tôi được báo thứ Ba là ngày dự kiến. Có thể đổi sang thứ Năm không ạ? Hôm đó có người hỗ trợ tiếng Việt chứ?"
        },
        {
          "id": "117e9bd9-483b-524d-b6a6-50a81c277a87-u02",
          "speaker_id": "b",
          "ja": "木曜日の十時なら、ベトナム語の担当者がいます。予約しますか。",
          "vi": "Thứ Năm lúc 10 giờ có người hỗ trợ tiếng Việt. Bạn muốn đặt lịch chứ?"
        },
        {
          "id": "117e9bd9-483b-524d-b6a6-50a81c277a87-u03",
          "speaker_id": "a",
          "ja": "はい、木曜日の十時にお願いします。",
          "vi": "Vâng, cho tôi đặt thứ Năm lúc 10 giờ."
        }
      ],
