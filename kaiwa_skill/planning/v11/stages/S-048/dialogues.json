          },
          "d9d1594e-650f-50ad-bdc1-e49fc723c877-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "fe5b06cc-ea2c-5334-ad5f-228516c932f5",
      "event_id": "E02",
      "context_vi": "Bạn đã tới quầy tầng một được giới thiệu nhưng họ không nhận trường hợp của mình. Bạn quay lại trung tâm hỏi đường khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tư vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fe5b06cc-ea2c-5334-ad5f-228516c932f5-u01",
          "speaker_id": "a",
          "ja": "一階に行きましたが、この件は受けられないと言われました。次はどこに聞けますか。",
          "vi": "Tôi đã đến quầy tầng một, nhưng họ không nhận việc này. Tôi nên hỏi tiếp ở đâu ạ?"
        },
        {
          "id": "fe5b06cc-ea2c-5334-ad5f-228516c932f5-u02",
          "speaker_id": "b",
          "ja": "市役所の案内係へ一緒に電話して、担当を確認しましょう。",
          "vi": "Ta cùng gọi bộ phận hướng dẫn của tòa thị chính để hỏi đúng người phụ trách."
        },
        {
          "id": "fe5b06cc-ea2c-5334-ad5f-228516c932f5-u03",
          "speaker_id": "a",
          "ja": "はい、一緒に確認したいです。",
          "vi": "Vâng, tôi muốn cùng xác nhận."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fe5b06cc-ea2c-5334-ad5f-228516c932f5-u01": {
            "kind": "original_extension"
          },
          "fe5b06cc-ea2c-5334-ad5f-228516c932f5-u02": {
            "kind": "original_extension"
          },
          "fe5b06cc-ea2c-5334-ad5f-228516c932f5-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "56453ef2-4c19-55e5-8de6-81103ff3f5dd",
      "event_id": "E02",
      "context_vi": "Thông báo hư cấu có hạn thứ Năm; bạn còn chuyện địa chỉ nhà. Bạn hỏi việc nào cần xử lý trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tư vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "56453ef2-4c19-55e5-8de6-81103ff3f5dd-u01",
          "speaker_id": "a",
          "ja": "通知と住所のことがあります。どちらを先に聞けばいいですか。",
          "vi": "Tôi có việc về thông báo và địa chỉ nhà. Tôi nên hỏi việc nào trước ạ?"
        },
        {
          "id": "56453ef2-4c19-55e5-8de6-81103ff3f5dd-u02",
          "speaker_id": "b",
          "ja": "通知には木曜日までとあります。まず通知について聞き、住所はその後にしましょう。",
          "vi": "Trên thông báo ghi hạn thứ Năm. Ta hỏi việc này trước, rồi tới chuyện địa chỉ."
        },
        {
          "id": "56453ef2-4c19-55e5-8de6-81103ff3f5dd-u03",
          "speaker_id": "a",
          "ja": "では、先に通知のことを聞きます。",
          "vi": "Vậy tôi sẽ hỏi về thông báo trước."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "56453ef2-4c19-55e5-8de6-81103ff3f5dd-u01": {
            "kind": "original_extension"
          },
          "56453ef2-4c19-55e5-8de6-81103ff3f5dd-u02": {
            "kind": "original_extension"
          },
          "56453ef2-4c19-55e5-8de6-81103ff3f5dd-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "11c6770e-eb3d-56e7-90d6-daee9b472efa",
      "event_id": "E03",
      "context_vi": "Bạn muốn tư vấn bằng tiếng Việt tại trung tâm Midori. Nhân viên đang kiểm lịch của người hỗ trợ cho thứ Ba tuần sau.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "11c6770e-eb3d-56e7-90d6-daee9b472efa-u01",
          "speaker_id": "a",
          "ja": "ベトナム語で相談できる日に予約したいです。",
          "vi": "Tôi muốn đặt lịch vào ngày có người hỗ trợ tiếng Việt."
        },
        {
          "id": "11c6770e-eb3d-56e7-90d6-daee9b472efa-u02",
          "speaker_id": "b",
          "ja": "来週の火曜日、十時が候補です。担当者を確認して、今日の四時までにお返事します。",
          "vi": "10 giờ thứ Ba tuần sau là một lịch có thể. Tôi sẽ hỏi người phụ trách rồi trả lời trước 4 giờ hôm nay."
        },
        {
          "id": "11c6770e-eb3d-56e7-90d6-daee9b472efa-u03",
          "speaker_id": "a",
          "ja": "まだ確定ではないですね。四時までの連絡を待ちます。",
          "vi": "Vậy lịch chưa được xác nhận. Tôi sẽ chờ tin trước 4 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "11c6770e-eb3d-56e7-90d6-daee9b472efa-u01": {
