    {
      "situation_uid": "d1691601-dee4-5d63-a982-1eb628c1822a",
      "event_id": "E03",
      "context_vi": "Trung tâm chưa xác nhận được người hỗ trợ tiếng Việt vào thứ Ba. Bạn hỏi họ sẽ báo kết quả cho mình bằng cách nào và khi nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d1691601-dee4-5d63-a982-1eb628c1822a-u01",
          "speaker_id": "a",
          "ja": "まだ予約が決まらないなら、どうやって、いつ連絡をもらえますか。",
          "vi": "Nếu lịch hẹn chưa chốt, tôi sẽ nhận tin bằng cách nào, lúc nào ạ?"
        },
        {
          "id": "d1691601-dee4-5d63-a982-1eb628c1822a-u02",
          "speaker_id": "b",
          "ja": "今日の四時までに電話します。番号を確認してもいいですか。",
          "vi": "Tôi sẽ gọi trước 4 giờ hôm nay. Cho tôi kiểm lại số nhé."
        },
        {
          "id": "d1691601-dee4-5d63-a982-1eb628c1822a-u03",
          "speaker_id": "a",
          "ja": "〇九〇の一二三四の五六七八です。",
          "vi": "Số của tôi là 090-1234-5678."
        },
        {
          "id": "d1691601-dee4-5d63-a982-1eb628c1822a-u04",
          "speaker_id": "b",
          "ja": "〇九〇の一二三四の五六七八ですね。",
          "vi": "090-1234-5678, đúng không ạ?"
        }
      ],
