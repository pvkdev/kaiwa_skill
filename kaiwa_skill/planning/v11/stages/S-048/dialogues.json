        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "12e9ece6-5475-5f60-affe-a38edcd472a1-u01",
          "speaker_id": "a",
          "ja": "市役所に行きましたが、通知の差出人が読めませんでした。もう一度教えてください。",
          "vi": "Tôi đã đến tòa thị chính nhưng không đọc được tên nơi gửi trên thông báo. Anh nói lại giúp tôi được không ạ?"
        },
        {
          "id": "12e9ece6-5475-5f60-affe-a38edcd472a1-u02",
          "speaker_id": "b",
          "ja": "差出人は「みどり市役所の住民窓口」です。",
          "vi": "Nơi gửi ghi “Quầy cư dân của Tòa thị chính Midori”."
        },
        {
          "id": "12e9ece6-5475-5f60-affe-a38edcd472a1-u03",
          "speaker_id": "a",
          "ja": "住民窓口ですね。もう一度その名を伝えます。",
          "vi": "Quầy cư dân ạ. Tôi sẽ nói lại đúng tên ấy."
        }
