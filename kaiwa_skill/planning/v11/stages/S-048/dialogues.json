    {
      "situation_uid": "d1691601-dee4-5d63-a982-1eb628c1822a",
      "event_id": "E03",
      "context_vi": "Trung tâm chưa xác nhận được người hỗ trợ tiếng Việt vào thứ Ba. Bạn hỏi họ sẽ báo kết quả cho mình bằng cách nào và khi nào.",
      "speakers": [
