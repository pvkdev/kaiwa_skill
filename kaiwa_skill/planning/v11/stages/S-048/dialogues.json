    {
      "situation_uid": "12e9ece6-5475-5f60-affe-a38edcd472a1",
      "event_id": "E04",
      "context_vi": "Tại quầy tư vấn tòa thị chính, nhân viên hỏi thông báo do bộ phận nào gửi. Bạn không đọc được tên bộ phận nên gọi trung tâm để hỏi lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "12e9ece6-5475-5f60-affe-a38edcd472a1-u01",
          "speaker_id": "a",
          "ja": "市役所で、どの窓口から来た通知か聞かれました。名前が読めません。教えてもらえますか。",
          "vi": "Ở tòa thị chính họ hỏi thông báo do quầy nào gửi. Tôi không đọc được tên quầy. Anh chỉ giúp tôi được không ạ?"
        },
        {
          "id": "12e9ece6-5475-5f60-affe-a38edcd472a1-u02",
          "speaker_id": "b",
          "ja": "差出人は「みどり市役所の住民窓口」です。",
          "vi": "Nơi gửi là quầy cư trú của Tòa thị chính Midori ạ."
        },
        {
          "id": "12e9ece6-5475-5f60-affe-a38edcd472a1-u03",
          "speaker_id": "a",
          "ja": "住民窓口ですね。相談窓口の人に伝えます。",
          "vi": "Quầy cư trú ạ. Tôi sẽ báo lại với người ở quầy tư vấn."
        }
      ],
