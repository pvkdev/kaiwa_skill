    {
      "situation_uid": "117e9bd9-483b-524d-b6a6-50a81c277a87",
      "event_id": "E03",
      "context_vi": "Trung tâm đã gọi lại chốt lịch thứ Ba lúc 10 giờ. Bạn bận giờ đó nên gọi xin đổi sang thứ Năm và muốn chắc hôm đó vẫn có hỗ trợ tiếng Việt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "117e9bd9-483b-524d-b6a6-50a81c277a87-u01",
          "speaker_id": "a",
          "ja": "火曜日の十時に予約したリンです。木曜日に変えられますか。その日もベトナム語で相談できますか。",
          "vi": "Tôi là Linh, có lịch thứ Ba lúc 10 giờ. Tôi đổi sang thứ Năm được không ạ? Hôm đó tôi vẫn có thể trao đổi bằng tiếng Việt chứ?"
        },
        {
          "id": "117e9bd9-483b-524d-b6a6-50a81c277a87-u02",
          "speaker_id": "b",
          "ja": "木曜日の朝十時なら、ベトナム語の担当者がいます。その時間にしますか。",
          "vi": "10 giờ sáng thứ Năm có người hỗ trợ tiếng Việt. Chị muốn đổi sang giờ đó không ạ?"
        },
        {
          "id": "117e9bd9-483b-524d-b6a6-50a81c277a87-u03",
          "speaker_id": "a",
          "ja": "はい、木曜日の十時にお願いします。",
          "vi": "Vâng, cho tôi đặt thứ Năm lúc 10 giờ."
        }
      ],
