    },
    {
      "situation_uid": "79ca37e9-2920-5635-81d3-24f826e1bc3c",
      "event_id": "E01",
      "context_vi": "Nhân viên trung tâm Midori hỏi thời điểm và nơi bạn gặp khó khăn tại phòng khám để tìm đúng cách hỗ trợ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "79ca37e9-2920-5635-81d3-24f826e1bc3c-u01",
          "speaker_id": "b",
          "ja": "いつ、どこで困りましたか。",
          "vi": "Bạn gặp khó khăn khi nào và ở đâu ạ?"
        },
        {
          "id": "79ca37e9-2920-5635-81d3-24f826e1bc3c-u02",
          "speaker_id": "a",
          "ja": "昨日、駅の近くの病院で、説明がよく分かりませんでした。",
          "vi": "Hôm qua ở bệnh viện gần ga, tôi nghe giải thích mà chưa hiểu lắm."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "79ca37e9-2920-5635-81d3-24f826e1bc3c-u01": {
            "kind": "original_extension"
          },
          "79ca37e9-2920-5635-81d3-24f826e1bc3c-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "13a89393-4261-5eb9-8d72-ea5ed81dad21",
      "event_id": "E01",
      "context_vi": "Ở trung tâm, bạn đưa tờ giấy đã nhận tại bệnh viện gần ga. Bạn không biết tên giấy, nên kể nhân viên bệnh viện đã nhờ mình làm gì.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "13a89393-4261-5eb9-8d72-ea5ed81dad21-u01",
          "speaker_id": "a",
          "ja": "名前は分かりません。病院の受付でこの紙をもらいました。名前と、体のどこが悪いかを書くように言われました。",
          "vi": "Tôi không biết tên giấy này. Quầy tiếp nhận của bệnh viện đưa cho tôi rồi bảo ghi tên và chỗ nào trong người thấy không khỏe."
        },
        {
          "id": "13a89393-4261-5eb9-8d72-ea5ed81dad21-u02",
          "speaker_id": "b",
          "ja": "これは問診票です。診察の前に、体のことを書く紙です。分からないところを一緒に見ましょう。",
          "vi": "Đây là phiếu hỏi bệnh. Người bệnh ghi tình trạng sức khỏe trước khi khám. Chị chưa hiểu chỗ nào, ta xem cùng nhau nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal",
          "medical_form"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "13a89393-4261-5eb9-8d72-ea5ed81dad21-u01": {
            "kind": "original_extension"
          },
          "13a89393-4261-5eb9-8d72-ea5ed81dad21-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "01656c83-70f7-5e39-aa06-ea78583531f1",
      "event_id": "E01",
      "context_vi": "Nhân viên trung tâm Midori đang nói nhanh. Bạn xin tiếng Việt hoặc tiếng Nhật dễ hiểu cho việc hỏi phòng khám.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "01656c83-70f7-5e39-aa06-ea78583531f1-u01",
          "speaker_id": "a",
          "ja": "ベトナム語で話せますか。日本語なら、簡単な言葉でゆっくりお願いします。",
          "vi": "Tôi có thể trao đổi bằng tiếng Việt không ạ? Nếu nói bằng tiếng Nhật, xin anh dùng từ dễ và nói chậm giúp tôi."
        },
        {
          "id": "01656c83-70f7-5e39-aa06-ea78583531f1-u02",
          "speaker_id": "b",
          "ja": "今日はベトナム語の担当者はいません。やさしい日本語で、ゆっくりお話しします。",
          "vi": "Hôm nay không có người hỗ trợ tiếng Việt. Tôi sẽ nói chậm bằng tiếng Nhật dễ hiểu."
        },
        {
          "id": "01656c83-70f7-5e39-aa06-ea78583531f1-u03",
          "speaker_id": "a",
          "ja": "それでお願いします。",
          "vi": "Vâng, vậy nhờ anh nói chậm giúp tôi ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal",
          "language_help"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "01656c83-70f7-5e39-aa06-ea78583531f1-u01": {
            "kind": "original_extension"
          },
          "01656c83-70f7-5e39-aa06-ea78583531f1-u02": {
            "kind": "original_extension"
          },
          "01656c83-70f7-5e39-aa06-ea78583531f1-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "cff585a6-7c36-513a-b547-c363a28b5112",
      "event_id": "E02",
      "context_vi": "Bạn mang một thông báo đến trung tâm Midori nhưng không đọc được tên cơ quan gửi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tư vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cff585a6-7c36-513a-b547-c363a28b5112-u01",
          "speaker_id": "a",
          "ja": "このお知らせは、どこから来たのか分かりません。見てもらえますか。",
          "vi": "Tôi không biết cơ quan nào gửi thông báo này. Anh xem giúp tôi được không ạ?"
        },
        {
          "id": "cff585a6-7c36-513a-b547-c363a28b5112-u02",
          "speaker_id": "b",
          "ja": "ここに「みどり市役所」と書いてあります。",
          "vi": "Ở đây ghi “Tòa thị chính Midori”."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "cff585a6-7c36-513a-b547-c363a28b5112-u01": {
            "kind": "original_extension"
          },
          "cff585a6-7c36-513a-b547-c363a28b5112-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d9d1594e-650f-50ad-bdc1-e49fc723c877",
      "event_id": "E02",
      "context_vi": "Nhân viên xác định thư gửi từ tòa thị chính Midori. Anh chỉ nơi hỏi đầu tiên để tìm ra bộ phận phụ trách. Bạn nhắc lại đúng tên và tầng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tư vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d9d1594e-650f-50ad-bdc1-e49fc723c877-u01",
          "speaker_id": "b",
          "ja": "このお知らせのことは、市役所の一階の総合案内で聞いてみてください。",
          "vi": "Chị thử hỏi về thông báo này ở bàn hướng dẫn chung tầng một của tòa thị chính nhé."
        },
        {
          "id": "d9d1594e-650f-50ad-bdc1-e49fc723c877-u02",
          "speaker_id": "a",
          "ja": "市役所の一階の総合案内ですね。",
          "vi": "Bàn hướng dẫn chung ở tầng một của tòa thị chính, đúng không ạ?"
        },
        {
          "id": "d9d1594e-650f-50ad-bdc1-e49fc723c877-u03",
          "speaker_id": "b",
          "ja": "はい、そうです。",
          "vi": "Đúng vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d9d1594e-650f-50ad-bdc1-e49fc723c877-u01": {
