  "dialogues": [
    {
      "situation_uid": "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97",
      "event_id": "E01",
      "context_vi": "Bạn tới trung tâm hỗ trợ cư dân nước ngoài Midori vì không hiểu lời giải thích ở bệnh viện gần ga. Bạn muốn hỏi trung tâm có thể giúp mình tìm nơi hỏi rõ hơn không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97-u01",
          "speaker_id": "a",
          "ja": "病院で説明を聞きましたが、よく分かりませんでした。どこに相談すればいいか、教えてください。",
          "vi": "Ở bệnh viện tôi có nghe giải thích nhưng chưa hiểu. Anh chỉ giúp tôi có thể hỏi ở đâu được không ạ?"
        },
        {
          "id": "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97-u02",
          "speaker_id": "b",
          "ja": "どの市にお住まいですか。",
          "vi": "Bạn sống ở thành phố nào ạ?"
        },
        {
          "id": "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97-u03",
          "speaker_id": "a",
          "ja": "みどり市です。",
          "vi": "Tôi sống ở thành phố Midori."
        },
        {
          "id": "b69b420d-ca4f-5aa0-9dde-d44e9b3c6a97-u04",
          "speaker_id": "b",
          "ja": "それでは、まずここでお話を聞かせてください。",
          "vi": "Vậy trước tiên chị kể cho tôi nghe ở đây nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
