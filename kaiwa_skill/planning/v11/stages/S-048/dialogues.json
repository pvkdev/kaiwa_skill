    {
      "situation_uid": "9d766471-12bb-5ba6-9ce2-7bf05aa83281",
      "event_id": "E03",
      "context_vi": "Trung tâm chưa xác nhận được giờ thứ Ba tuần sau, mà thông báo yêu cầu bạn trả lời trong tuần này. Bạn nói rõ hạn và xin một buổi tư vấn sớm hơn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9d766471-12bb-5ba6-9ce2-7bf05aa83281-u01",
          "speaker_id": "a",
          "ja": "この通知は今週中に返事が必要です。もっと早く相談できますか。",
          "vi": "Thông báo này cần trả lời trong tuần. Tôi có thể được tư vấn sớm hơn không ạ?"
        },
        {
          "id": "9d766471-12bb-5ba6-9ce2-7bf05aa83281-u02",
          "speaker_id": "b",
          "ja": "今日の午後二時なら、やさしい日本語で相談できます。いかがですか。",
          "vi": "Hôm nay lúc 2 giờ chiều có thể tư vấn bằng tiếng Nhật dễ hiểu. Chị thấy giờ đó được không ạ?"
        },
        {
          "id": "9d766471-12bb-5ba6-9ce2-7bf05aa83281-u03",
          "speaker_id": "a",
          "ja": "はい、今日の二時にお願いします。",
          "vi": "Được, cho tôi hẹn 2 giờ hôm nay."
        }
      ],
