    {
      "situation_uid": "12e9ece6-5475-5f60-affe-a38edcd472a1",
      "event_id": "E04",
      "context_vi": "Bạn đã tới quầy tòa thị chính, nhưng không đọc được tên nơi gửi trên thông báo. Bạn gọi lại trung tâm Midori để hỏi.",
      "speakers": [
