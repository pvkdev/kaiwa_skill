    {
      "situation_uid": "cfa4f17c-8fa0-5cf4-b085-389afee011b4",
      "event_id": "E04",
      "context_vi": "Nhân viên vừa gợi ý hỏi quầy tư vấn của tòa thị chính Midori. Bạn tóm tắt bước đầu để chắc mình hiểu đúng.",
