          }
        }
      }
    },
    {
      "situation_uid": "79ca37e9-2920-5635-81d3-24f826e1bc3c",
      "event_id": "E01",
      "context_vi": "Nhân viên trung tâm Midori hỏi thời điểm và nơi bạn gặp khó khăn tại phòng khám để tìm đúng cách hỗ trợ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "79ca37e9-2920-5635-81d3-24f826e1bc3c-u01",
          "speaker_id": "b",
          "ja": "いつ、どこで困りましたか。",
          "vi": "Bạn gặp khó khăn khi nào và ở đâu ạ?"
        },
        {
          "id": "79ca37e9-2920-5635-81d3-24f826e1bc3c-u02",
          "speaker_id": "a",
          "ja": "昨日、駅の近くの病院で、言葉が分かりませんでした。",
          "vi": "Hôm qua, ở bệnh viện gần ga, tôi không hiểu người ta nói."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "79ca37e9-2920-5635-81d3-24f826e1bc3c-u01": {
            "kind": "original_extension"
          },
          "79ca37e9-2920-5635-81d3-24f826e1bc3c-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "13a89393-4261-5eb9-8d72-ea5ed81dad21",
      "event_id": "E01",
      "context_vi": "Bạn không biết từ chuyên môn trên tờ giấy phòng khám đưa. Bạn kể lại bằng việc đã xảy ra với mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "13a89393-4261-5eb9-8d72-ea5ed81dad21-u01",
          "speaker_id": "a",
          "ja": "難しい言葉は分かりません。受付で紙を渡されて、名前と体のことを書いてくださいと言われました。",
          "vi": "Tôi không biết từ chuyên môn. Quầy đưa tôi một tờ giấy và bảo ghi tên cùng tình trạng sức khỏe."
        },
        {
          "id": "13a89393-4261-5eb9-8d72-ea5ed81dad21-u02",
          "speaker_id": "b",
          "ja": "それは診察前に書く質問の紙です。分からない所を一緒に確認しましょう。",
          "vi": "Đó là tờ hỏi thông tin trước khi khám. Ta cùng xem phần bạn chưa hiểu nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "13a89393-4261-5eb9-8d72-ea5ed81dad21-u01": {
            "kind": "original_extension"
          },
          "13a89393-4261-5eb9-8d72-ea5ed81dad21-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "01656c83-70f7-5e39-aa06-ea78583531f1",
      "event_id": "E01",
      "context_vi": "Nhân viên trung tâm Midori đang nói nhanh. Bạn xin tiếng Việt hoặc tiếng Nhật dễ hiểu cho việc hỏi phòng khám.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên trung tâm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "01656c83-70f7-5e39-aa06-ea78583531f1-u01",
          "speaker_id": "a",
          "ja": "ベトナム語で相談できますか。難しければ、やさしい日本語でお願いします。",
          "vi": "Tôi có thể trao đổi bằng tiếng Việt không ạ? Nếu không được, xin nói tiếng Nhật dễ hiểu."
        },
        {
          "id": "01656c83-70f7-5e39-aa06-ea78583531f1-u02",
          "speaker_id": "b",
          "ja": "今日はベトナム語の担当者はいません。やさしい日本語で、ゆっくりお話しします。",
          "vi": "Hôm nay không có người hỗ trợ tiếng Việt. Tôi sẽ nói chậm bằng tiếng Nhật dễ hiểu."
        },
        {
          "id": "01656c83-70f7-5e39-aa06-ea78583531f1-u03",
          "speaker_id": "a",
          "ja": "それでお願いします。",
          "vi": "Vậy nhờ anh giúp tôi theo cách đó."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "01656c83-70f7-5e39-aa06-ea78583531f1-u01": {
            "kind": "original_extension"
          },
