          }
        }
      }
    },
    {
      "situation_uid": "cff585a6-7c36-513a-b547-c363a28b5112",
      "event_id": "E02",
      "context_vi": "Bạn mang một thông báo đến trung tâm Midori nhưng không đọc được tên cơ quan gửi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tư vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cff585a6-7c36-513a-b547-c363a28b5112-u01",
          "speaker_id": "a",
          "ja": "この通知を持って来ました。どこから来たものか分かりません。",
          "vi": "Tôi mang thông báo này tới. Tôi không biết cơ quan nào gửi."
        },
        {
          "id": "cff585a6-7c36-513a-b547-c363a28b5112-u02",
          "speaker_id": "b",
          "ja": "ここに「みどり市役所」と書いてあります。",
          "vi": "Ở đây ghi “Tòa thị chính Midori”."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "cff585a6-7c36-513a-b547-c363a28b5112-u01": {
            "kind": "original_extension"
          },
          "cff585a6-7c36-513a-b547-c363a28b5112-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d9d1594e-650f-50ad-bdc1-e49fc723c877",
      "event_id": "E02",
      "context_vi": "Nhân viên vừa xác định thông báo của tòa thị chính Midori và chỉ quầy phụ trách ở tầng một; bạn nhắc lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tư vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d9d1594e-650f-50ad-bdc1-e49fc723c877-u01",
          "speaker_id": "b",
          "ja": "みどり市役所からの通知です。相談窓口は一階です。",
          "vi": "Thông báo này từ tòa thị chính Midori. Quầy tư vấn ở tầng một."
        },
        {
          "id": "d9d1594e-650f-50ad-bdc1-e49fc723c877-u02",
          "speaker_id": "a",
          "ja": "市役所の一階の相談窓口ですね。",
          "vi": "Quầy tư vấn tầng một của tòa thị chính, đúng không ạ?"
        },
        {
          "id": "d9d1594e-650f-50ad-bdc1-e49fc723c877-u03",
          "speaker_id": "b",
          "ja": "はい、そうです。",
          "vi": "Đúng vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d9d1594e-650f-50ad-bdc1-e49fc723c877-u01": {
            "kind": "original_extension"
          },
