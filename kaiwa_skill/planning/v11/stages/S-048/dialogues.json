        }
      }
    },
    {
      "situation_uid": "fe5b06cc-ea2c-5334-ad5f-228516c932f5",
      "event_id": "E02",
      "context_vi": "Bạn đã tới bàn hướng dẫn tầng một của tòa thị chính. Họ bảo cần hỏi bộ phận ghi trên thông báo, nhưng bạn chưa rõ bộ phận đó ở đâu nên quay lại trung tâm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tư vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fe5b06cc-ea2c-5334-ad5f-228516c932f5-u01",
          "speaker_id": "a",
          "ja": "一階の総合案内に行きました。通知に書いてある窓口に行くように言われましたが、どこか分かりません。",
          "vi": "Tôi đã đến bàn hướng dẫn tầng một. Họ bảo đến quầy ghi trên thông báo, nhưng tôi không biết quầy đó ở đâu ạ."
        },
        {
          "id": "fe5b06cc-ea2c-5334-ad5f-228516c932f5-u02",
          "speaker_id": "b",
          "ja": "では、この通知を見ながら、市役所に電話して担当の窓口を聞きましょう。",
          "vi": "Vậy ta xem thông báo này rồi gọi tòa thị chính hỏi quầy phụ trách nhé."
        },
        {
          "id": "fe5b06cc-ea2c-5334-ad5f-228516c932f5-u03",
          "speaker_id": "a",
          "ja": "はい、一緒に電話してもらえますか。",
          "vi": "Vâng, anh gọi cùng tôi được không ạ?"
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "portal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fe5b06cc-ea2c-5334-ad5f-228516c932f5-u01": {
            "kind": "original_extension"
