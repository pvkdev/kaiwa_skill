    {
      "situation_uid": "0f4e1dbe-6bfd-5516-835f-c425f8d953fd",
      "event_id": "E02",
      "context_vi": "Trong lần hẹn đầu, bạn đùa quán lạnh như đang ở Bắc Cực. Người đối diện không chắc bạn đang nói gì nên bạn giải thích ngắn rồi tiếp tục nói chuyện.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0f4e1dbe-6bfd-5516-835f-c425f8d953fd-u01",
          "speaker_id": "A",
          "ja": "ここ、北極みたいですね。",
          "vi": "Ở đây cứ như Bắc Cực ấy nhỉ."
        },
        {
          "id": "0f4e1dbe-6bfd-5516-835f-c425f8d953fd-u02",
          "speaker_id": "B",
          "ja": "え、北極って？",
          "vi": "Ơ, Bắc Cực là sao ạ?"
        },
        {
          "id": "0f4e1dbe-6bfd-5516-835f-c425f8d953fd-u03",
          "speaker_id": "A",
          "ja": "あ、冗談です。冷房が強くて、寒いなと思って。",
          "vi": "À, tôi đùa thôi. Máy lạnh mạnh quá nên tôi thấy rét."
        },
        {
          "id": "0f4e1dbe-6bfd-5516-835f-c425f8d953fd-u04",
          "speaker_id": "B",
          "ja": "ああ、そういうことですか。席を変えましょうか。",
          "vi": "À, ra là vậy. Mình đổi chỗ nhé?"
        },
        {
          "id": "0f4e1dbe-6bfd-5516-835f-c425f8d953fd-u05",
          "speaker_id": "A",
          "ja": "そうしましょう。",
          "vi": "Vâng, mình đổi nhé."
        }
      ],
      "admin": {
