    {
      "situation_uid": "d63dd6eb-f6d9-5f1d-888d-fc4897875907",
      "event_id": "E02",
      "context_vi": "Hai bạn vừa gặp riêng lần đầu ở quán cà phê. Bạn muốn biết người kia thích uống gì và muốn ngồi đâu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d63dd6eb-f6d9-5f1d-888d-fc4897875907-u01",
          "speaker_id": "A",
          "ja": "何を飲みますか。",
          "vi": "Anh uống gì ạ?"
        },
        {
          "id": "d63dd6eb-f6d9-5f1d-888d-fc4897875907-u02",
          "speaker_id": "B",
          "ja": "紅茶にします。午後はコーヒーを飲まないんです。",
          "vi": "Tôi chọn trà đen. Buổi chiều tôi không uống cà phê."
        },
        {
          "id": "d63dd6eb-f6d9-5f1d-888d-fc4897875907-u03",
          "speaker_id": "A",
          "ja": "そうなんですね。窓のそばと奥、どっちがいいですか。",
          "vi": "Ra vậy. Anh thích ngồi cạnh cửa sổ hay phía trong quán ạ?"
        },
        {
          "id": "d63dd6eb-f6d9-5f1d-888d-fc4897875907-u04",
          "speaker_id": "B",
          "ja": "奥がいいです。静かそうなので。",
          "vi": "Phía trong đi. Có vẻ yên tĩnh hơn."
        },
        {
          "id": "d63dd6eb-f6d9-5f1d-888d-fc4897875907-u05",
          "speaker_id": "A",
          "ja": "じゃ、奥に座りましょう。",
          "vi": "Vậy mình ngồi phía trong nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "invite"
        ],
