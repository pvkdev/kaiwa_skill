          }
        }
      }
    },
    {
      "situation_uid": "aba65570-3bbf-5e23-8e8e-e1cd1b6880e1",
      "event_id": "E01",
      "context_vi": "Bạn vừa rủ một người mới quen gặp riêng. Người đó nói không muốn gặp riêng và bạn muốn đáp lời rõ ràng, lịch sự.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người rủ Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "aba65570-3bbf-5e23-8e8e-e1cd1b6880e1-u01",
          "speaker_id": "B",
          "ja": "誘ってくれてありがとう。でも、二人で会うのはちょっと。",
          "vi": "Cảm ơn chị đã rủ. Nhưng tôi không muốn gặp riêng hai người."
        },
        {
          "id": "aba65570-3bbf-5e23-8e8e-e1cd1b6880e1-u02",
          "speaker_id": "A",
          "ja": "わかりました。言ってくれてありがとうございます。",
          "vi": "Tôi hiểu rồi. Cảm ơn anh đã nói rõ."
        },
        {
          "id": "aba65570-3bbf-5e23-8e8e-e1cd1b6880e1-u03",
          "speaker_id": "B",
          "ja": "じゃ、また教室で。",
          "vi": "Vậy hẹn gặp lại ở lớp nhé."
        },
        {
          "id": "aba65570-3bbf-5e23-8e8e-e1cd1b6880e1-u04",
          "speaker_id": "A",
          "ja": "はい、また教室で。",
          "vi": "Vâng, gặp anh ở lớp nhé."
        }
      ],
      "admin": {
        "source_refs": [
