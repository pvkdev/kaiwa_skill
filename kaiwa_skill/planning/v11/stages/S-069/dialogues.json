    {
      "situation_uid": "d5249712-8baa-5995-af41-601a066c9ad6",
      "event_id": "E02",
      "context_vi": "Hai bạn đã thống nhất chỉ ngồi cà phê vì người kia phải đi lúc bốn giờ. Bây giờ còn năm phút nữa tới bốn giờ và bạn muốn chủ động khép buổi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người về sớm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d5249712-8baa-5995-af41-601a066c9ad6-u01",
          "speaker_id": "A",
          "ja": "あと五分で四時ですね。そろそろ出ましょうか。",
          "vi": "Còn năm phút nữa là bốn giờ. Mình ra thôi nhé?"
        },
        {
          "id": "d5249712-8baa-5995-af41-601a066c9ad6-u02",
          "speaker_id": "B",
          "ja": "そうですね。今出れば間に合います。",
          "vi": "Vâng. Ra bây giờ thì tôi kịp giờ."
        },
        {
          "id": "d5249712-8baa-5995-af41-601a066c9ad6-u03",
          "speaker_id": "A",
          "ja": "今日は話せて楽しかったです。",
          "vi": "Hôm nay nói chuyện với anh vui lắm."
        },
        {
          "id": "d5249712-8baa-5995-af41-601a066c9ad6-u04",
          "speaker_id": "B",
          "ja": "私も楽しかったです。ありがとうございます。",
          "vi": "Tôi cũng thấy vui. Cảm ơn chị."
        }
      ],
