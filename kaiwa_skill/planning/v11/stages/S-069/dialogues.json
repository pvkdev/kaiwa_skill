    {
      "situation_uid": "87402f18-00a3-5857-9904-862773b60192",
      "event_id": "E03",
      "context_vi": "Bạn hỏi trước khi chụp chung. Người kia không muốn chụp, nên bạn đồng ý, cất điện thoại rồi bắt chuyện về bức tranh trên tường.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "87402f18-00a3-5857-9904-862773b60192-u01",
          "speaker_id": "B",
          "ja": "すみません。写真はちょっと苦手で。",
          "vi": "Xin lỗi chị, tôi không thích chụp ảnh lắm."
        },
        {
          "id": "87402f18-00a3-5857-9904-862773b60192-u02",
          "speaker_id": "A",
          "ja": "わかりました。じゃあ、撮りませんね。",
          "vi": "Tôi hiểu rồi. Vậy mình không chụp nhé."
        },
        {
          "id": "87402f18-00a3-5857-9904-862773b60192-u03",
          "speaker_id": "A",
          "ja": "あの壁の絵、色がきれいですね。",
          "vi": "Bức tranh trên tường màu đẹp nhỉ."
        },
        {
          "id": "87402f18-00a3-5857-9904-862773b60192-u04",
          "speaker_id": "B",
          "ja": "ええ。海の絵ですね。",
          "vi": "Vâng. Tranh vẽ biển nhỉ."
        }
      ],
