    {
      "situation_uid": "88d67a83-7034-572f-af20-1df85069ddb2",
      "event_id": "E02",
      "context_vi": "Hai bạn định uống cà phê rồi ghé một cửa hàng. Người hẹn nói phải rời quán trước bốn giờ chiều, nên bạn đề nghị giữ buổi gặp ngắn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người về sớm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "88d67a83-7034-572f-af20-1df85069ddb2-u01",
          "speaker_id": "B",
          "ja": "すみません。四時にはここを出ないといけません。",
          "vi": "Xin lỗi chị. Bốn giờ tôi phải rời quán."
        },
        {
          "id": "88d67a83-7034-572f-af20-1df85069ddb2-u02",
          "speaker_id": "A",
          "ja": "じゃ、お店を見に行くのはまた今度でいいですよ。",
          "vi": "Vậy hôm khác ghé cửa hàng cũng được ạ."
        },
        {
          "id": "88d67a83-7034-572f-af20-1df85069ddb2-u03",
          "speaker_id": "B",
          "ja": "ありがとうございます。今日はここで話すだけなら大丈夫です。",
          "vi": "Cảm ơn chị. Hôm nay mình ngồi đây nói chuyện thôi thì được."
        },
        {
          "id": "88d67a83-7034-572f-af20-1df85069ddb2-u04",
          "speaker_id": "A",
          "ja": "わかりました。四時前に声をかけますね。",
          "vi": "Tôi hiểu. Tôi sẽ nhắc anh trước bốn giờ nhé."
        }
      ],
      "admin": {
