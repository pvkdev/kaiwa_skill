    {
      "situation_uid": "17882641-2f4d-5dee-85aa-b569bad87e7b",
      "event_id": "E01",
      "context_vi": "Bạn và người mới quen đã thống nhất đi cà phê cùng nhóm. Yamada và Kim đều có thể đi chiều Chủ nhật. Bạn đề nghị giờ và điểm gặp để mọi người tìm được nhau.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người rủ Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "17882641-2f4d-5dee-85aa-b569bad87e7b-u01",
          "speaker_id": "A",
          "ja": "二人とも日曜の午後なら行けます。二時はどうですか。",
          "vi": "Cả hai đều đi được chiều Chủ nhật. Hai giờ chiều thì sao ạ?"
        },
        {
          "id": "17882641-2f4d-5dee-85aa-b569bad87e7b-u02",
          "speaker_id": "B",
          "ja": "大丈夫です。駅の東口で会いませんか。",
          "vi": "Tôi đi được. Mình gặp ở cửa Đông nhà ga nhé?"
        },
        {
          "id": "17882641-2f4d-5dee-85aa-b569bad87e7b-u03",
          "speaker_id": "A",
          "ja": "日曜の二時、東口ですね。二人にも知らせます。",
          "vi": "Chủ nhật lúc hai giờ chiều, cửa Đông ạ. Tôi sẽ báo cả hai."
        },
        {
          "id": "17882641-2f4d-5dee-85aa-b569bad87e7b-u04",
          "speaker_id": "B",
          "ja": "お願いします。",
          "vi": "Nhờ chị nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "place"
        ],
        "specialty_item_ids": [
          "sj-so-15-b12-11"
        ],
        "turn_origins": {
