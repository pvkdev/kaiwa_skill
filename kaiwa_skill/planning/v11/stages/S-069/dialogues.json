          }
        }
      }
    },
    {
      "situation_uid": "4412428e-1127-5434-9d35-b67492ae6d86",
      "event_id": "E01",
      "context_vi": "Người mới quen muốn cùng bạn ghé quán cà phê trước ga. Bạn hỏi người đó ngày nào thuận tiện.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người rủ Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4412428e-1127-5434-9d35-b67492ae6d86-u01",
          "speaker_id": "A",
          "ja": "今週末は、土曜と日曜、どちらがいいですか。",
          "vi": "Cuối tuần này anh tiện ngày nào ạ?"
        },
        {
          "id": "4412428e-1127-5434-9d35-b67492ae6d86-u02",
          "speaker_id": "B",
          "ja": "土曜は仕事です。日曜の午後なら空いています。",
          "vi": "Thứ Bảy tôi đi làm. Chiều Chủ nhật thì tôi rảnh."
        },
        {
          "id": "4412428e-1127-5434-9d35-b67492ae6d86-u03",
          "speaker_id": "A",
          "ja": "じゃ、日曜の二時はどうですか。",
          "vi": "Vậy Chủ nhật lúc hai giờ chiều được không ạ?"
        },
        {
          "id": "4412428e-1127-5434-9d35-b67492ae6d86-u04",
          "speaker_id": "B",
          "ja": "はい、その時間なら大丈夫です。",
          "vi": "Vâng, giờ đó tôi đi được."
        }
      ],
      "admin": {
        "source_refs": [
          "invite"
        ],
        "specialty_item_ids": [
          "sj-so-15-b12-11"
        ],
        "turn_origins": {
