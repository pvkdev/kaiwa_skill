    {
      "situation_uid": "00972c2d-61e4-5e40-82c1-f61726a7f716",
      "event_id": "E02",
      "context_vi": "Hai bạn đang trò chuyện trong lần gặp đầu. Bạn kể mình thích làm bánh rồi hỏi người kia thường làm gì vào ngày nghỉ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "00972c2d-61e4-5e40-82c1-f61726a7f716-u01",
          "speaker_id": "A",
          "ja": "休みの日は、よくお菓子を作ります。",
          "vi": "Ngày nghỉ tôi hay làm bánh ngọt."
        },
        {
          "id": "00972c2d-61e4-5e40-82c1-f61726a7f716-u02",
          "speaker_id": "B",
          "ja": "いいですね。何を作るんですか。",
          "vi": "Hay đấy. Chị hay làm món gì?"
        },
        {
          "id": "00972c2d-61e4-5e40-82c1-f61726a7f716-u03",
          "speaker_id": "A",
          "ja": "クッキーが多いです。休みの日は何をしますか。",
          "vi": "Tôi hay nướng bánh quy. Còn anh, ngày nghỉ anh hay làm gì?"
        },
        {
          "id": "00972c2d-61e4-5e40-82c1-f61726a7f716-u04",
          "speaker_id": "B",
          "ja": "私は写真を撮りに行きます。",
          "vi": "Tôi hay đi chụp ảnh."
        },
        {
          "id": "00972c2d-61e4-5e40-82c1-f61726a7f716-u05",
          "speaker_id": "A",
          "ja": "へえ。どんな写真を撮るんですか。",
          "vi": "Ồ. Anh hay chụp ảnh gì?"
        }
      ],
      "admin": {
