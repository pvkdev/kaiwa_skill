      ],
      "turns": [
        {
          "id": "67781a7a-79ea-5d7b-a389-5b9457509b9d-u01",
          "speaker_id": "B",
          "ja": "来週の仕事の予定がまだわからないんです。",
          "vi": "Tôi vẫn chưa biết lịch làm tuần sau."
        },
        {
          "id": "67781a7a-79ea-5d7b-a389-5b9457509b9d-u02",
          "speaker_id": "A",
          "ja": "返事はあとでいいですよ。",
          "vi": "Anh trả lời sau cũng được ạ."
        },
        {
          "id": "67781a7a-79ea-5d7b-a389-5b9457509b9d-u03",
          "speaker_id": "B",
          "ja": "ありがとうございます。予定が出たら私から連絡します。",
          "vi": "Cảm ơn chị. Có lịch rồi tôi sẽ nhắn chị."
        },
        {
          "id": "67781a7a-79ea-5d7b-a389-5b9457509b9d-u04",
          "speaker_id": "A",
          "ja": "はい。じゃ、わかったときにお願いします。",
          "vi": "Vâng. Khi nào anh biết thì báo tôi nhé."
        }
