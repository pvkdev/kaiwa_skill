    {
      "situation_uid": "cc94fc33-736f-5e66-ab01-53ad3a3d7718",
      "event_id": "E01",
      "context_vi": "Bạn muốn hẹn gặp riêng một người ở lớp vẽ nhưng người đó muốn đi cùng các bạn trong lớp trước. Bạn chấp nhận hình thức gặp nhóm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người rủ Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cc94fc33-736f-5e66-ab01-53ad3a3d7718-u01",
          "speaker_id": "B",
          "ja": "最初は、クラスのみんなと一緒なら行きたいです。",
          "vi": "Lần đầu, nếu đi cùng các bạn trong lớp thì tôi muốn đi."
        },
        {
          "id": "cc94fc33-736f-5e66-ab01-53ad3a3d7718-u02",
          "speaker_id": "A",
          "ja": "わかりました。じゃ、みんなで行きましょう。",
          "vi": "Tôi hiểu rồi. Vậy mình đi cả nhóm nhé."
        },
        {
          "id": "cc94fc33-736f-5e66-ab01-53ad3a3d7718-u03",
          "speaker_id": "B",
          "ja": "山田さんとキムさんにも聞いてみますか。",
          "vi": "Mình thử hỏi chị Yamada và anh Kim nữa nhé?"
        },
        {
          "id": "cc94fc33-736f-5e66-ab01-53ad3a3d7718-u04",
          "speaker_id": "A",
          "ja": "いいですね。二人にも聞いてみます。",
          "vi": "Hay đấy. Tôi sẽ hỏi cả hai."
        }
      ],
      "admin": {
        "source_refs": [
          "refuse",
          "invite"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
