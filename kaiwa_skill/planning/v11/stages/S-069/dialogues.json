  "dialogues": [
    {
      "situation_uid": "e11fd60f-fd9a-54ea-bcbf-35628fa7a4e9",
      "event_id": "E01",
      "context_vi": "Bạn muốn tìm hiểu một người vừa quen ở lớp vẽ. Sau giờ học, bạn rủ họ đi cà phê ở quán trước ga nếu tiện.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người rủ Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e11fd60f-fd9a-54ea-bcbf-35628fa7a4e9-u01",
          "speaker_id": "A",
          "ja": "よかったら、駅前でお茶しませんか。",
          "vi": "Nếu anh tiện, mình ra trước ga uống gì nhé?"
        },
        {
          "id": "e11fd60f-fd9a-54ea-bcbf-35628fa7a4e9-u02",
          "speaker_id": "B",
          "ja": "いいですね。どのお店ですか。",
          "vi": "Hay đấy. Quán nào vậy?"
        },
        {
          "id": "e11fd60f-fd9a-54ea-bcbf-35628fa7a4e9-u03",
          "speaker_id": "A",
          "ja": "本屋の隣のカフェです。",
          "vi": "Quán cà phê cạnh hiệu sách ấy ạ."
        },
        {
          "id": "e11fd60f-fd9a-54ea-bcbf-35628fa7a4e9-u04",
          "speaker_id": "B",
          "ja": "あそこならわかります。行きましょう。",
          "vi": "Chỗ đó thì tôi biết. Mình đi nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "invite"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e11fd60f-fd9a-54ea-bcbf-35628fa7a4e9-u01": {
