        {
          "id": "a6d00b0b-021c-540e-a650-ecd04ea899ab-u02",
          "speaker_id": "B",
          "ja": "はい。私もまた会いたいです。",
          "vi": "Vâng. Tôi cũng muốn gặp lại chị."
        },
        {
          "id": "a6d00b0b-021c-540e-a650-ecd04ea899ab-u03",
          "speaker_id": "A",
          "ja": "うれしいです。次は何をするか、一緒に考えましょう。",
          "vi": "Tôi vui lắm. Mình cùng nghĩ lần sau làm gì nhé."
        },
        {
          "id": "a6d00b0b-021c-540e-a650-ecd04ea899ab-u04",
          "speaker_id": "B",
          "ja": "そうしましょう。",
          "vi": "Vâng, mình cùng nghĩ."
        }
      ],
