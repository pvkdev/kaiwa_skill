    {
      "situation_uid": "64beac3a-cea0-5b3b-aac8-b4576c266f52",
      "event_id": "E03",
      "context_vi": "Trong lần gặp đầu, người đối diện hỏi về gia đình. Bạn chưa muốn nói sâu về chuyện riêng và muốn trả lời rõ mà vẫn nhẹ nhàng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "64beac3a-cea0-5b3b-aac8-b4576c266f52-u01",
          "speaker_id": "B",
          "ja": "ご家族は今どこに住んでいますか。",
          "vi": "Gia đình chị hiện sống ở đâu ạ?"
        },
        {
          "id": "64beac3a-cea0-5b3b-aac8-b4576c266f52-u02",
          "speaker_id": "A",
          "ja": "すみません。家族のことは、今日はあまり話したくないです。",
          "vi": "Xin lỗi anh, hôm nay tôi chưa muốn kể nhiều về chuyện gia đình."
        },
        {
          "id": "64beac3a-cea0-5b3b-aac8-b4576c266f52-u03",
          "speaker_id": "B",
          "ja": "わかりました。聞いてすみません。",
          "vi": "Tôi hiểu rồi. Xin lỗi vì đã hỏi chị."
        },
        {
          "id": "64beac3a-cea0-5b3b-aac8-b4576c266f52-u04",
          "speaker_id": "A",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn anh."
        }
      ],
