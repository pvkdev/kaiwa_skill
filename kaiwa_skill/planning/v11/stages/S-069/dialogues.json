    {
      "situation_uid": "5cda4075-2f1b-554b-9b90-a28491890dc5",
      "event_id": "E03",
      "context_vi": "Trong lần gặp đầu, bạn thấy một chỗ đẹp ngoài quán. Bạn muốn hỏi người kia trước khi lấy điện thoại chụp ảnh chung.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5cda4075-2f1b-554b-9b90-a28491890dc5-u01",
          "speaker_id": "A",
          "ja": "よかったら、ここで一緒に写真を撮ってもいいですか。",
          "vi": "Nếu anh thích, mình chụp chung một tấm ở đây được không ạ?"
        },
        {
          "id": "5cda4075-2f1b-554b-9b90-a28491890dc5-u02",
          "speaker_id": "B",
          "ja": "いいですよ。でも、ネットには載せないでくださいね。",
          "vi": "Được chị ạ. Chị đừng đăng lên mạng nhé."
        },
        {
          "id": "5cda4075-2f1b-554b-9b90-a28491890dc5-u03",
          "speaker_id": "A",
          "ja": "はい。載せません。",
          "vi": "Vâng. Tôi sẽ không đăng."
        },
        {
          "id": "5cda4075-2f1b-554b-9b90-a28491890dc5-u04",
          "speaker_id": "B",
          "ja": "じゃ、ここに立ちましょう。",
          "vi": "Vậy mình đứng ở đây nhé."
        }
      ],
