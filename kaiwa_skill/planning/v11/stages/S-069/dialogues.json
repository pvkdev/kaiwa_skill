      "event_id": "E04",
      "context_vi": "Lần gặp đầu đã kết thúc và bạn muốn biết người kia có muốn gặp lại không. Bạn mở lời nhẹ để họ có thể tự chọn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người đi cùng",
