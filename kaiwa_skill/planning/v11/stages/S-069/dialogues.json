    {
      "situation_uid": "805b198e-f7cc-5c99-baa0-b43b94da207d",
      "event_id": "E03",
      "context_vi": "Bạn vừa nói chưa muốn kể thêm về gia đình. Người kia hiểu và chuyển sang chuyện quán cà phê. Bạn trả lời về đồ uống mình thích.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "805b198e-f7cc-5c99-baa0-b43b94da207d-u01",
          "speaker_id": "B",
          "ja": "話さなくても大丈夫ですよ。",
          "vi": "Chị cứ thoải mái, chuyện đó mình để lại nhé."
        },
        {
          "id": "805b198e-f7cc-5c99-baa0-b43b94da207d-u02",
          "speaker_id": "B",
          "ja": "そういえば、ここの紅茶はどうですか。",
          "vi": "À, trà ở đây thế nào ạ?"
        },
        {
          "id": "805b198e-f7cc-5c99-baa0-b43b94da207d-u03",
          "speaker_id": "A",
          "ja": "香りがいいです。紅茶、好きなんです。",
          "vi": "Thơm lắm. Tôi thích uống trà đen."
        },
        {
          "id": "805b198e-f7cc-5c99-baa0-b43b94da207d-u04",
          "speaker_id": "A",
          "ja": "そちらのコーヒーはどうですか。",
          "vi": "Còn cà phê của anh thế nào?"
        },
        {
          "id": "805b198e-f7cc-5c99-baa0-b43b94da207d-u05",
          "speaker_id": "B",
          "ja": "少し苦いですけど、おいしいです。",
          "vi": "Hơi đắng nhưng ngon chị ạ."
        }
      ],
