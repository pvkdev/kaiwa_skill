    {
      "situation_uid": "9d33f193-a281-5798-84e5-b7f655bfe9eb",
      "event_id": "E03",
      "context_vi": "Người kia nghĩ bạn đã hứa sẽ đi ăn tối sau buổi cà phê. Bạn chỉ đồng ý uống cà phê và muốn nói rõ hôm nay mình sẽ về sau khi uống xong.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9d33f193-a281-5798-84e5-b7f655bfe9eb-u01",
          "speaker_id": "B",
          "ja": "じゃ、このあと夕飯も一緒に食べるんですよね。",
          "vi": "Vậy lát nữa mình cũng ăn tối cùng nhau, đúng không?"
        },
        {
          "id": "9d33f193-a281-5798-84e5-b7f655bfe9eb-u02",
          "speaker_id": "A",
          "ja": "約束したのは、お茶だけです。",
          "vi": "Tôi chỉ đồng ý uống nước ở quán này thôi ạ."
        },
        {
          "id": "9d33f193-a281-5798-84e5-b7f655bfe9eb-u03",
          "speaker_id": "A",
          "ja": "今日はお茶のあと、帰りますね。",
          "vi": "Hôm nay uống xong tôi sẽ về nhé."
        },
        {
          "id": "9d33f193-a281-5798-84e5-b7f655bfe9eb-u04",
          "speaker_id": "B",
          "ja": "わかりました。じゃ、ここまでにしましょう。",
          "vi": "Tôi hiểu rồi. Vậy hôm nay mình dừng ở đây nhé."
        }
      ],
