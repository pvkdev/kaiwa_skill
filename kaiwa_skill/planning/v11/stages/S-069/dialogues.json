      "event_id": "E04",
      "context_vi": "Bạn muốn hẹn gặp lần nữa nhưng người kia chưa biết lịch làm tuần sau. Bạn muốn cho họ thời gian mà vẫn rõ ai sẽ chủ động liên hệ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người hẹn Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chưa rõ lịch",
          "gender": "male"
