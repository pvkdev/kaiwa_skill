    {
      "situation_uid": "b3fd487d-03c3-5b9d-a885-e9068a9b2f26",
      "event_id": "E02",
      "context_vi": "Bạn đọc địa chỉ Sakura-machi 3-12 cho nhân viên. Nhân viên nghe nhầm phần cuối thành 21, nên bạn đọc lại từng chữ số.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận đặt",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b3fd487d-03c3-5b9d-a885-e9068a9b2f26-u01",
          "speaker_id": "b",
          "ja": "桜町三の二十一ですね。",
          "vi": "Sakura-machi 3-21 phải không ạ?"
        },
        {
          "id": "b3fd487d-03c3-5b9d-a885-e9068a9b2f26-u02",
          "speaker_id": "a",
          "ja": "いいえ、三の十二です。最後は一、二です。",
          "vi": "Không ạ, 3-12. Hai số cuối là một rồi hai ạ."
        },
        {
          "id": "b3fd487d-03c3-5b9d-a885-e9068a9b2f26-u03",
          "speaker_id": "b",
          "ja": "三の十二ですね。直しました。",
          "vi": "3-12. Tôi đã sửa."
        }
      ],
