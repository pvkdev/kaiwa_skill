    {
      "situation_uid": "b569fab8-bab0-541e-8e30-2e28eaf2b2c6",
      "event_id": "E03",
      "context_vi": "Trước buổi vệ sinh cửa sổ dự kiến lúc 9 giờ thứ Năm, Linh gọi báo không thể có mặt đúng giờ và xin đổi lịch.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b569fab8-bab0-541e-8e30-2e28eaf2b2c6-u01",
          "speaker_id": "a",
          "ja": "九時には家にいられません。時間を変えられますか。",
          "vi": "Lúc 9 giờ tôi không có nhà. Có thể đổi giờ không ạ?"
        },
        {
          "id": "b569fab8-bab0-541e-8e30-2e28eaf2b2c6-u02",
          "speaker_id": "b",
          "ja": "木曜日なら十一時が候補です。作業員に確認して、十時までにお電話します。",
          "vi": "Thứ Năm có thể đổi sang 11 giờ. Tôi sẽ hỏi người thực hiện và gọi lại trước 10 giờ."
        },
        {
          "id": "b569fab8-bab0-541e-8e30-2e28eaf2b2c6-u03",
          "speaker_id": "a",
          "ja": "分かりました。今はまだ確定ではないですね。",
          "vi": "Tôi hiểu. Giờ ấy vẫn chưa được xác nhận, đúng không ạ?"
        },
        {
          "id": "b569fab8-bab0-541e-8e30-2e28eaf2b2c6-u04",
          "speaker_id": "b",
          "ja": "はい、確認中です。",
          "vi": "Vâng, vẫn đang chờ xác nhận."
        }
      ],
      "admin": {
