          }
        }
      }
    },
    {
      "situation_uid": "7538018e-94f7-57da-9c2f-e4c47e479f46",
      "event_id": "E01",
      "context_vi": "Bạn muốn đặt buổi chiều. Khi biết buổi chiều đã kín, bạn hỏi lịch sáng để xem có thu xếp được không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận cuộc gọi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7538018e-94f7-57da-9c2f-e4c47e479f46-u01",
          "speaker_id": "b",
          "ja": "午後は空いていません。",
          "vi": "Buổi chiều đã kín lịch rồi ạ."
        },
        {
          "id": "7538018e-94f7-57da-9c2f-e4c47e479f46-u02",
          "speaker_id": "a",
          "ja": "では、午前は何時から空いていますか。",
          "vi": "Vậy buổi sáng còn trống từ mấy giờ ạ?"
        },
        {
          "id": "7538018e-94f7-57da-9c2f-e4c47e479f46-u03",
          "speaker_id": "b",
          "ja": "木曜日の九時からです。",
          "vi": "Thứ Năm từ 9 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7538018e-94f7-57da-9c2f-e4c47e479f46-u01": {
            "kind": "original_extension"
