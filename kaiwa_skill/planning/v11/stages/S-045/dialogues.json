    {
      "situation_uid": "085be92a-427a-5a9c-ad8c-24a71949df6b",
      "event_id": "E02",
      "context_vi": "Nhân viên vừa sửa địa chỉ từ Sakura-machi 3-21 thành 3-12. Trước khi cúp máy, bạn kiểm lại lịch lau cửa sổ cùng tên và số liên hệ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận đặt",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "085be92a-427a-5a9c-ad8c-24a71949df6b-u01",
          "speaker_id": "a",
          "ja": "窓の掃除は木曜日の午前九時、住所は桜町三の十二ですね。",
          "vi": "Lau cửa sổ lúc 9 giờ sáng thứ Năm, ở Sakura-machi 3-12, đúng không ạ?"
        },
        {
          "id": "085be92a-427a-5a9c-ad8c-24a71949df6b-u02",
          "speaker_id": "b",
          "ja": "はい、そうです。",
          "vi": "Vâng, đúng vậy."
        },
        {
          "id": "085be92a-427a-5a9c-ad8c-24a71949df6b-u03",
          "speaker_id": "a",
          "ja": "名前はリン、電話番号は〇九〇の一二三四の五六七八です。",
          "vi": "Tên tôi là Linh, số điện thoại 090-1234-5678."
        },
        {
          "id": "085be92a-427a-5a9c-ad8c-24a71949df6b-u04",
          "speaker_id": "b",
          "ja": "はい、その内容でお取りしました。",
          "vi": "Vâng, tôi đã đặt lịch theo thông tin đó ạ."
        }
      ],
