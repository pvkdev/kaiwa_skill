    {
      "situation_uid": "b1032ff7-f1b4-5a39-93a7-1548478d88fd",
      "event_id": "E02",
      "context_vi": "Bạn gọi Sakura Clean để đặt lịch lau cửa sổ. Nhân viên xin tên và số điện thoại liên hệ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận đặt",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b1032ff7-f1b4-5a39-93a7-1548478d88fd-u01",
          "speaker_id": "a",
          "ja": "名前はリンです。電話番号は〇九〇の一二三四の五六七八です。",
          "vi": "Tôi tên Linh. Số điện thoại là 090-1234-5678."
        },
        {
          "id": "b1032ff7-f1b4-5a39-93a7-1548478d88fd-u02",
          "speaker_id": "b",
          "ja": "リン様、〇九〇の一二三四の五六七八ですね。",
          "vi": "Chị Linh, số 090-1234-5678 phải không ạ?"
        }
      ],
