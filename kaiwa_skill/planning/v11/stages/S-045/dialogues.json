  "dialogues": [
    {
      "situation_uid": "8f450ce0-7313-59cb-b25a-bb02b5f61eb2",
      "event_id": "E01",
      "context_vi": "Bạn gọi một dịch vụ vệ sinh hư cấu và hỏi họ có vệ sinh cửa sổ không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận cuộc gọi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8f450ce0-7313-59cb-b25a-bb02b5f61eb2-u01",
          "speaker_id": "a",
          "ja": "窓の掃除をお願いできますか。",
          "vi": "Bên mình có nhận vệ sinh cửa sổ không ạ?"
        },
        {
          "id": "8f450ce0-7313-59cb-b25a-bb02b5f61eb2-u02",
          "speaker_id": "b",
          "ja": "はい、承っています。",
          "vi": "Có, bên tôi có nhận."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
