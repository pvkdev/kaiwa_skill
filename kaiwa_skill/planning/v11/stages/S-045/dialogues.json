    {
      "situation_uid": "b569fab8-bab0-541e-8e30-2e28eaf2b2c6",
      "event_id": "E03",
      "context_vi": "Hôm nay là thứ Tư. Bạn gọi báo sáng mai sẽ vắng nhà lúc 9 giờ và xin đổi lịch lau cửa sổ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đặt lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b569fab8-bab0-541e-8e30-2e28eaf2b2c6-u01",
          "speaker_id": "a",
          "ja": "九時には家にいられません。時間を変えられますか。",
          "vi": "Lúc 9 giờ tôi không có nhà. Có thể đổi giờ không ạ?"
        },
        {
          "id": "b569fab8-bab0-541e-8e30-2e28eaf2b2c6-u02",
          "speaker_id": "b",
          "ja": "明日の十一時なら空いているかもしれません。作業員に確認して、今日の午前十時までにお電話します。",
          "vi": "Mai lúc 11 giờ có thể còn trống. Tôi sẽ hỏi thợ rồi gọi lại cho chị chậm nhất 10 giờ sáng nay."
        },
        {
          "id": "b569fab8-bab0-541e-8e30-2e28eaf2b2c6-u03",
          "speaker_id": "a",
