    {
      "situation_uid": "0d139038-b867-5db9-be7d-20ad95b325b1",
      "event_id": "E01",
      "context_vi": "Bạn hỏi còn lịch cho việc vệ sinh cửa sổ trong tuần này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận cuộc gọi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0d139038-b867-5db9-be7d-20ad95b325b1-u01",
          "speaker_id": "a",
          "ja": "今週、空いている日はありますか。",
          "vi": "Tuần này còn ngày nào trống không ạ?"
        },
        {
          "id": "0d139038-b867-5db9-be7d-20ad95b325b1-u02",
          "speaker_id": "b",
          "ja": "木曜日の午前なら空いています。",
          "vi": "Sáng thứ Năm còn trống."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0d139038-b867-5db9-be7d-20ad95b325b1-u01": {
            "kind": "original_extension"
          },
          "0d139038-b867-5db9-be7d-20ad95b325b1-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7538018e-94f7-57da-9c2f-e4c47e479f46",
      "event_id": "E01",
      "context_vi": "Bạn chỉ rảnh buổi chiều, nhưng nơi cung cấp dịch vụ báo hết lịch chiều.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận cuộc gọi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7538018e-94f7-57da-9c2f-e4c47e479f46-u01",
          "speaker_id": "b",
          "ja": "午後は空いていません。",
          "vi": "Buổi chiều đã kín lịch rồi ạ."
        },
        {
          "id": "7538018e-94f7-57da-9c2f-e4c47e479f46-u02",
          "speaker_id": "a",
          "ja": "では、午前は何時から空いていますか。",
          "vi": "Vậy buổi sáng còn trống từ mấy giờ?"
        },
        {
          "id": "7538018e-94f7-57da-9c2f-e4c47e479f46-u03",
          "speaker_id": "b",
          "ja": "木曜日の九時からです。",
          "vi": "Thứ Năm từ 9 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7538018e-94f7-57da-9c2f-e4c47e479f46-u01": {
