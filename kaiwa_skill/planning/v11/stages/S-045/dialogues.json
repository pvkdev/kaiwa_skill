            "kind": "original_extension"
          },
          "2880a84e-608d-5458-8749-f844f81977ba-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "8ec3ef1a-c930-5133-9c34-b907a40f8bbb",
      "event_id": "E01",
      "context_vi": "Sau khi hỏi lịch sáng thứ Năm, bạn quyết định đặt vệ sinh cửa sổ lúc 9 giờ.",
