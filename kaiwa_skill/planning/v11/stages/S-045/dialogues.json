    {
      "situation_uid": "b1af99b7-6b46-5cd1-a986-38042797793c",
      "event_id": "E02",
      "context_vi": "Nhân viên đặt lịch hỏi địa chỉ nhà. Bạn đọc địa chỉ và nói nhà ở gần lối ra phía tây của ga.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận đặt",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b1af99b7-6b46-5cd1-a986-38042797793c-u01",
          "speaker_id": "a",
          "ja": "住所は桜町三の十二です。駅の西口の近くです。",
          "vi": "Địa chỉ là Sakura-machi 3-12, gần lối ra phía tây của ga."
        },
        {
          "id": "b1af99b7-6b46-5cd1-a986-38042797793c-u02",
          "speaker_id": "b",
          "ja": "桜町三の十二ですね。",
          "vi": "Sakura-machi 3-12 ạ."
        }
      ],
      "admin": {
