          },
          "7538018e-94f7-57da-9c2f-e4c47e479f46-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "2880a84e-608d-5458-8749-f844f81977ba",
      "event_id": "E01",
      "context_vi": "Nhân viên báo giá 8.000 yên cho lượt lau cửa sổ. Giá cao hơn bạn dự tính nên bạn chưa muốn đặt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận cuộc gọi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2880a84e-608d-5458-8749-f844f81977ba-u01",
          "speaker_id": "b",
          "ja": "窓の掃除は八千円です。",
          "vi": "Vệ sinh cửa sổ giá 8.000 yên ạ."
        },
        {
          "id": "2880a84e-608d-5458-8749-f844f81977ba-u02",
          "speaker_id": "a",
          "ja": "ちょっと高いので、今回はやめておきます。",
          "vi": "Giá hơi cao nên lần này tôi xin phép chưa đặt ạ."
        },
        {
          "id": "2880a84e-608d-5458-8749-f844f81977ba-u03",
          "speaker_id": "b",
          "ja": "分かりました。またご相談ください。",
          "vi": "Vâng ạ. Khi nào cần, chị cứ liên hệ lại."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
