    {
      "situation_uid": "8ccfa24e-9ba6-57c4-a7f5-68d372d2b026",
      "event_id": "E02",
      "context_vi": "Khi Linh đọc địa chỉ Sakura-machi 3-12, nhân viên chi nhánh hiện tại báo không phục vụ khu ấy. Linh hỏi một chi nhánh khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận đặt",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8ccfa24e-9ba6-57c4-a7f5-68d372d2b026-u01",
          "speaker_id": "b",
          "ja": "その住所は当店の担当エリア外です。",
          "vi": "Địa chỉ ấy ngoài khu phục vụ của chi nhánh chúng tôi."
        },
        {
          "id": "8ccfa24e-9ba6-57c4-a7f5-68d372d2b026-u02",
          "speaker_id": "a",
          "ja": "別の支店に聞けますか。",
          "vi": "Tôi có thể hỏi chi nhánh khác không?"
        },
        {
          "id": "8ccfa24e-9ba6-57c4-a7f5-68d372d2b026-u03",
          "speaker_id": "b",
          "ja": "はい。東店へこのままおつなぎします。",
          "vi": "Được. Tôi sẽ nối máy sang chi nhánh phía đông ngay."
        }
      ],
