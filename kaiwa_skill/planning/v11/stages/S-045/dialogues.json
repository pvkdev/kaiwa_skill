          }
        }
      }
    },
    {
      "situation_uid": "2880a84e-608d-5458-8749-f844f81977ba",
      "event_id": "E01",
      "context_vi": "Nhân viên báo giá giả định 8.000 yên cho cửa sổ. Bạn chưa muốn đặt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận cuộc gọi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2880a84e-608d-5458-8749-f844f81977ba-u01",
          "speaker_id": "b",
          "ja": "窓の掃除は八千円です。",
          "vi": "Vệ sinh cửa sổ giá 8.000 yên ạ."
        },
        {
          "id": "2880a84e-608d-5458-8749-f844f81977ba-u02",
          "speaker_id": "a",
          "ja": "予算より高いので、今日は予約しません。",
          "vi": "Giá cao hơn dự tính nên hôm nay tôi chưa đặt."
        },
        {
          "id": "2880a84e-608d-5458-8749-f844f81977ba-u03",
          "speaker_id": "b",
          "ja": "分かりました。またご相談ください。",
          "vi": "Tôi hiểu. Khi nào cần, bạn cứ liên hệ lại."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
