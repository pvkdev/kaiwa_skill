    {
      "situation_uid": "b1032ff7-f1b4-5a39-93a7-1548478d88fd",
      "event_id": "E02",
      "context_vi": "Bạn đặt lịch ở dịch vụ Sakura Clean hư cấu và đọc tên, số liên hệ.",
