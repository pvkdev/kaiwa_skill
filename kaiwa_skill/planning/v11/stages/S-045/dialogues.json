    {
      "situation_uid": "8ec3ef1a-c930-5133-9c34-b907a40f8bbb",
      "event_id": "E01",
      "context_vi": "Bạn thu xếp được lịch sáng thứ Năm và chọn đặt lau cửa sổ lúc 9 giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận cuộc gọi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8ec3ef1a-c930-5133-9c34-b907a40f8bbb-u01",
          "speaker_id": "a",
          "ja": "木曜日の九時に、窓の掃除をお願いします。",
          "vi": "Tôi muốn đặt vệ sinh cửa sổ lúc 9 giờ sáng thứ Năm."
        },
        {
          "id": "8ec3ef1a-c930-5133-9c34-b907a40f8bbb-u02",
          "speaker_id": "b",
          "ja": "はい、木曜日の午前九時に窓の掃除ですね。お名前をお願いします。",
          "vi": "Vâng, lau cửa sổ lúc 9 giờ sáng thứ Năm ạ. Cho tôi xin tên của chị."
        }
      ],
      "admin": {
