    {
      "situation_uid": "2affb837-d5f0-5ecb-8d3d-667f131e2666",
      "event_id": "E02",
      "context_vi": "Giờ nghỉ, bạn hỏi người ngồi cạnh về sở thích. Anh ấy đáp ngắn rồi nhìn đồng hồ, có vẻ muốn nghỉ yên.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thành viên cùng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2affb837-d5f0-5ecb-8d3d-667f131e2666-u01",
          "speaker_id": "a",
          "ja": "休みの日は、何をしますか。",
          "vi": "Ngày nghỉ anh thường làm gì?"
        },
        {
          "id": "2affb837-d5f0-5ecb-8d3d-667f131e2666-u02",
          "speaker_id": "b",
          "ja": "家にいます。すみません、少し休みたいです。",
          "vi": "Tôi ở nhà. Xin lỗi, tôi muốn nghỉ một chút."
        },
        {
          "id": "2affb837-d5f0-5ecb-8d3d-667f131e2666-u03",
          "speaker_id": "a",
          "ja": "わかりました。ゆっくり休んでください。",
          "vi": "Tôi hiểu. Anh cứ nghỉ nhé."
        }
      ],
