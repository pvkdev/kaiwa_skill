    {
      "situation_uid": "a148c54d-2296-5bc0-ac8f-12c6e5f829da",
      "event_id": "E03",
      "context_vi": "Bạn giới thiệu Tanaka với Mai nhưng lỡ nói Tanaka là đồng nghiệp. Tanaka nhẹ nhàng sửa vì hai người chỉ cùng học trong nhóm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "Tanaka",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a148c54d-2296-5bc0-ac8f-12c6e5f829da-u01",
          "speaker_id": "a",
          "ja": "マイさん、こちらは同僚の田中さんです。",
          "vi": "Mai, đây là đồng nghiệp của mình, anh Tanaka."
        },
        {
          "id": "a148c54d-2296-5bc0-ac8f-12c6e5f829da-u02",
          "speaker_id": "b",
          "ja": "あ、私たちは同じクラスですよ。",
          "vi": "À, chúng ta học cùng lớp thôi mà."
        },
        {
          "id": "a148c54d-2296-5bc0-ac8f-12c6e5f829da-u03",
          "speaker_id": "a",
          "ja": "あっ、そうでした。すみません。",
          "vi": "À đúng rồi. Xin lỗi anh."
        },
        {
          "id": "a148c54d-2296-5bc0-ac8f-12c6e5f829da-u04",
          "speaker_id": "b",
          "ja": "大丈夫です。",
          "vi": "Không sao đâu."
        }
      ],
