    {
      "situation_uid": "31e9fc80-0f8b-5080-b1f6-4e1a5085732d",
      "event_id": "E03",
      "context_vi": "Sau khi bạn đã giới thiệu Tanaka và Mai, Mai đang đứng cạnh bạn. Bạn mở lời để hai người tự chào nhau; chỉ bạn và Mai nói trong cảnh này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "Mai, người mới được giới thiệu",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "31e9fc80-0f8b-5080-b1f6-4e1a5085732d-u01",
          "speaker_id": "a",
          "ja": "マイさん、田中さんと話してみてください。",
          "vi": "Mai, cậu thử nói chuyện với anh Tanaka nhé."
        },
        {
          "id": "31e9fc80-0f8b-5080-b1f6-4e1a5085732d-u02",
          "speaker_id": "b",
          "ja": "はい。田中さん、はじめまして。マイです。",
          "vi": "Ừ. Anh Tanaka, rất vui được gặp anh. Em là Mai."
        },
        {
          "id": "31e9fc80-0f8b-5080-b1f6-4e1a5085732d-u03",
          "speaker_id": "a",
          "ja": "私は少し向こうにいますね。",
          "vi": "Mình đứng bên kia một chút nhé."
        },
        {
          "id": "31e9fc80-0f8b-5080-b1f6-4e1a5085732d-u04",
          "speaker_id": "b",
          "ja": "うん、ありがとう。",
          "vi": "Ừ, cảm ơn cậu."
        }
      ],
