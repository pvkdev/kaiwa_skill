          "id": "76817d75-ccce-5ca7-bccf-72f814b6c1f1-u01",
          "speaker_id": "a",
          "ja": "では、また後で。",
          "vi": "Vậy lát nữa gặp lại nhé."
        },
        {
          "id": "76817d75-ccce-5ca7-bccf-72f814b6c1f1-u02",
          "speaker_id": "b",
          "ja": "はい、また後で。",
          "vi": "Ừ, lát nữa gặp."
        },
        {
          "id": "76817d75-ccce-5ca7-bccf-72f814b6c1f1-u03",
          "speaker_id": "a",
          "ja": "失礼します。",
          "vi": "Tôi xin phép."
