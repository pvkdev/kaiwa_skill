    {
      "situation_uid": "d0946306-5a1f-5fbc-a6e7-4486a8b8fe6e",
      "event_id": "E02",
      "context_vi": "Giờ nghỉ, bạn làm quen với một thành viên nhóm và muốn hỏi anh ấy thường làm gì cuối tuần.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thành viên cùng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d0946306-5a1f-5fbc-a6e7-4486a8b8fe6e-u01",
          "speaker_id": "a",
          "ja": "週末は、何をしますか。",
          "vi": "Cuối tuần anh thường làm gì?"
        },
        {
          "id": "d0946306-5a1f-5fbc-a6e7-4486a8b8fe6e-u02",
          "speaker_id": "b",
          "ja": "よく本を読みます。",
          "vi": "Tôi hay đọc sách."
        },
        {
          "id": "d0946306-5a1f-5fbc-a6e7-4486a8b8fe6e-u03",
          "speaker_id": "a",
          "ja": "どんな本ですか。",
          "vi": "Sách gì vậy?"
        },
        {
          "id": "d0946306-5a1f-5fbc-a6e7-4486a8b8fe6e-u04",
          "speaker_id": "b",
          "ja": "旅行の本です。",
          "vi": "Sách về du lịch."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d0946306-5a1f-5fbc-a6e7-4486a8b8fe6e-u01": {
