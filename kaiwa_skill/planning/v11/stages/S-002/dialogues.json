    {
      "situation_uid": "008316fd-955d-5bf7-994f-60cee300e5cf",
      "event_id": "E02",
      "context_vi": "Người mới gặp hỏi công việc của bạn. Bạn muốn đáp chung chung, không nói tên công ty hay nơi làm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người mới gặp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "008316fd-955d-5bf7-994f-60cee300e5cf-u01",
          "speaker_id": "b",
          "ja": "お仕事は何ですか。",
          "vi": "Chị làm công việc gì?"
        },
        {
          "id": "008316fd-955d-5bf7-994f-60cee300e5cf-u02",
          "speaker_id": "a",
          "ja": "店で働いています。",
          "vi": "Tôi làm ở một cửa hàng."
        },
        {
          "id": "008316fd-955d-5bf7-994f-60cee300e5cf-u03",
          "speaker_id": "b",
          "ja": "そうなんですね。お休みはいつですか。",
          "vi": "À vậy à. Chị nghỉ ngày nào?"
        },
        {
          "id": "008316fd-955d-5bf7-994f-60cee300e5cf-u04",
          "speaker_id": "a",
          "ja": "日曜日です。",
          "vi": "Chủ nhật."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "008316fd-955d-5bf7-994f-60cee300e5cf-u01": {
