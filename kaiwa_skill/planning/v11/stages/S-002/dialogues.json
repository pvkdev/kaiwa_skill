          }
        }
      }
    },
    {
      "situation_uid": "3be9781c-63cf-5732-bbac-8c6b9de7ea12",
      "event_id": "E01",
      "context_vi": "Tiếp cuộc nói về tên ở nhóm học: người kia đã xin nghe lại vì chưa chắc cách gọi. Bạn nói chậm rồi kiểm anh ấy nghe đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thành viên cùng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3be9781c-63cf-5732-bbac-8c6b9de7ea12-u01",
          "speaker_id": "a",
          "ja": "リンです。リ、ン。",
          "vi": "Linh ạ. Ri, n."
        },
        {
          "id": "3be9781c-63cf-5732-bbac-8c6b9de7ea12-u02",
          "speaker_id": "b",
          "ja": "リンさんですね。",
          "vi": "Chị Linh, đúng không?"
        },
        {
          "id": "3be9781c-63cf-5732-bbac-8c6b9de7ea12-u03",
          "speaker_id": "a",
          "ja": "はい、そうです。リンと呼んでください。",
          "vi": "Vâng, đúng rồi. Cứ gọi tôi là Linh nhé."
        },
        {
          "id": "3be9781c-63cf-5732-bbac-8c6b9de7ea12-u04",
          "speaker_id": "b",
          "ja": "わかりました、リンさん。",
          "vi": "Được rồi, chị Linh."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3be9781c-63cf-5732-bbac-8c6b9de7ea12-u01": {
