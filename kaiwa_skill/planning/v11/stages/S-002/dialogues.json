    {
      "situation_uid": "2200dc39-a64b-541f-83dc-bf80f71fbcb3",
      "event_id": "E03",
      "context_vi": "Trước lúc bạn dẫn bạn mình đến gặp một thành viên mới, bạn hỏi xem bạn mình có muốn được giới thiệu không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn của người học",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2200dc39-a64b-541f-83dc-bf80f71fbcb3-u01",
          "speaker_id": "a",
          "ja": "田中さん、あの人に紹介してもいいですか。",
          "vi": "Anh Tanaka, tôi giới thiệu anh với người kia được không?"
        },
        {
          "id": "2200dc39-a64b-541f-83dc-bf80f71fbcb3-u02",
          "speaker_id": "b",
          "ja": "はい、お願いします。",
          "vi": "Được, nhờ chị."
        },
        {
          "id": "2200dc39-a64b-541f-83dc-bf80f71fbcb3-u03",
          "speaker_id": "a",
          "ja": "わかりました。一緒に行きましょう。",
          "vi": "Được rồi. Mình cùng qua nhé."
        }
      ],
      "admin": {
