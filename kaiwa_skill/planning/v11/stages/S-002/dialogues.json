          }
        }
      }
    },
    {
      "situation_uid": "67a59ed7-ef99-59a9-8cd8-d36c5e8e5bb2",
      "event_id": "E01",
      "context_vi": "Trong buổi họp nhóm đầu tiên, người bên cạnh hỏi vì sao bạn tham gia. Bạn muốn nói một mục tiêu học đơn giản.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thành viên cùng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "67a59ed7-ef99-59a9-8cd8-d36c5e8e5bb2-u01",
          "speaker_id": "b",
          "ja": "どうしてこのグループに来ましたか。",
          "vi": "Sao chị đến nhóm này?"
        },
        {
          "id": "67a59ed7-ef99-59a9-8cd8-d36c5e8e5bb2-u02",
          "speaker_id": "a",
          "ja": "日本語で話したいからです。",
          "vi": "Vì tôi muốn nói chuyện bằng tiếng Nhật."
        },
        {
          "id": "67a59ed7-ef99-59a9-8cd8-d36c5e8e5bb2-u03",
          "speaker_id": "b",
          "ja": "そうですか。何を勉強したいですか。",
          "vi": "Ra vậy. Chị muốn học gì?"
        },
        {
          "id": "67a59ed7-ef99-59a9-8cd8-d36c5e8e5bb2-u04",
          "speaker_id": "a",
          "ja": "まず、あいさつを練習したいです。",
          "vi": "Trước tiên tôi muốn tập chào hỏi."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "67a59ed7-ef99-59a9-8cd8-d36c5e8e5bb2-u01": {
            "kind": "original_extension"
          },
          "67a59ed7-ef99-59a9-8cd8-d36c5e8e5bb2-u02": {
