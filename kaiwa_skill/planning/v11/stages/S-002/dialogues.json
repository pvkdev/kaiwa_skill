          }
        }
      }
    },
    {
      "situation_uid": "0ee30be4-aa7e-5192-9bd2-3c2a9366f797",
      "event_id": "E02",
      "context_vi": "Người kia vừa nói thích nấu ăn. Bạn muốn hỏi lại món anh ấy thích nấu để cuộc nói tiếp tự nhiên.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thành viên cùng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0ee30be4-aa7e-5192-9bd2-3c2a9366f797-u01",
          "speaker_id": "a",
          "ja": "料理が好きなんですね。何を作りますか。",
          "vi": "Anh thích nấu ăn nhỉ. Anh hay nấu món gì?"
        },
        {
          "id": "0ee30be4-aa7e-5192-9bd2-3c2a9366f797-u02",
          "speaker_id": "b",
          "ja": "カレーをよく作ります。",
          "vi": "Tôi hay nấu cà ri."
        },
        {
          "id": "0ee30be4-aa7e-5192-9bd2-3c2a9366f797-u03",
          "speaker_id": "a",
          "ja": "いいですね。辛いですか。",
          "vi": "Hay quá. Có cay không?"
        },
        {
          "id": "0ee30be4-aa7e-5192-9bd2-3c2a9366f797-u04",
          "speaker_id": "b",
          "ja": "少しだけ辛いです。",
          "vi": "Chỉ hơi cay thôi."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
