    {
      "situation_uid": "0824c2fd-7580-50ee-8921-2eb398f621a0",
      "event_id": "E03",
      "context_vi": "Bạn đưa người bạn Tanaka đến gặp Mai. Bạn muốn nêu đúng tên và quan hệ với Tanaka để Mai biết người đang đứng cạnh mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người được giới thiệu",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0824c2fd-7580-50ee-8921-2eb398f621a0-u01",
          "speaker_id": "a",
          "ja": "マイさん、こちらは友達の田中さんです。",
          "vi": "Mai, đây là bạn mình, anh Tanaka."
        },
        {
          "id": "0824c2fd-7580-50ee-8921-2eb398f621a0-u02",
          "speaker_id": "b",
          "ja": "はじめまして。田中です。",
          "vi": "Rất vui được gặp bạn. Tôi là Tanaka."
        },
        {
          "id": "0824c2fd-7580-50ee-8921-2eb398f621a0-u03",
          "speaker_id": "a",
          "ja": "田中さん、こちらはマイさんです。",
          "vi": "Anh Tanaka, đây là Mai."
        },
        {
          "id": "0824c2fd-7580-50ee-8921-2eb398f621a0-u04",
          "speaker_id": "b",
          "ja": "マイさん、よろしくお願いします。",
          "vi": "Mai, rất vui được làm quen."
        }
      ],
      "admin": {
