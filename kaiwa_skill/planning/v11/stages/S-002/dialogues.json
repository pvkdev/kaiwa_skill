            "kind": "original_extension"
          },
          "813b05b2-ab40-5718-9997-c17c49efdcdc-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "6220b7de-60ac-531f-bb85-b36ab2c74474",
      "event_id": "E01",
      "context_vi": "Ở nhóm học, bạn vừa nói tên Linh. Người kia nghe thành Minh và gọi thử tên đó.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thành viên cùng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6220b7de-60ac-531f-bb85-b36ab2c74474-u01",
          "speaker_id": "b",
          "ja": "ミンさんですか。",
          "vi": "Chị Minh ạ?"
        },
        {
          "id": "6220b7de-60ac-531f-bb85-b36ab2c74474-u02",
          "speaker_id": "a",
          "ja": "あ、名前はリンです。リ、ン、です。",
          "vi": "À, tên tôi là Linh. Ri, n ạ."
        },
        {
          "id": "6220b7de-60ac-531f-bb85-b36ab2c74474-u03",
          "speaker_id": "b",
          "ja": "すみません、もう一度いいですか。",
          "vi": "Xin lỗi, chị nói lại một lần nữa được không?"
        },
        {
          "id": "6220b7de-60ac-531f-bb85-b36ab2c74474-u04",
          "speaker_id": "a",
          "ja": "はい。リンです。",
          "vi": "Vâng. Linh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "6220b7de-60ac-531f-bb85-b36ab2c74474-u01": {
