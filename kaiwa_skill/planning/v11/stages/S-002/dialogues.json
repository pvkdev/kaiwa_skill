    {
      "situation_uid": "76817d75-ccce-5ca7-bccf-72f814b6c1f1",
      "event_id": "E02",
      "context_vi": "Ngay sau khi người cùng nhóm nói anh ấy muốn nghỉ yên, bạn khép cuộc nói ngắn và trở lại chỗ mình.",
      "speakers": [
