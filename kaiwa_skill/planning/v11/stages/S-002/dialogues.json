          "67a59ed7-ef99-59a9-8cd8-d36c5e8e5bb2-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "813b05b2-ab40-5718-9997-c17c49efdcdc",
      "event_id": "E01",
      "context_vi": "Một người mới gặp hỏi bạn quê ở đâu. Bạn chỉ muốn trả lời tên thành phố và không nói thêm chuyện riêng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người mới gặp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "813b05b2-ab40-5718-9997-c17c49efdcdc-u01",
          "speaker_id": "b",
          "ja": "ご出身はどちらですか。",
          "vi": "Chị quê ở đâu?"
        },
        {
          "id": "813b05b2-ab40-5718-9997-c17c49efdcdc-u02",
          "speaker_id": "a",
          "ja": "ベトナムのダナンです。",
          "vi": "Tôi ở Đà Nẵng, Việt Nam."
        },
        {
          "id": "813b05b2-ab40-5718-9997-c17c49efdcdc-u03",
          "speaker_id": "b",
          "ja": "ダナンですか。",
          "vi": "Đà Nẵng à?"
        },
        {
          "id": "813b05b2-ab40-5718-9997-c17c49efdcdc-u04",
          "speaker_id": "a",
          "ja": "はい。田中さんは？",
          "vi": "Vâng. Còn anh Tanaka?"
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "813b05b2-ab40-5718-9997-c17c49efdcdc-u01": {
            "kind": "original_extension"
          },
