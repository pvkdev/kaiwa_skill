  "dialogues": [
    {
      "situation_uid": "495634b9-0e26-5670-847f-64e3bb82b1cf",
      "event_id": "E01",
      "context_vi": "Buổi đầu ở nhóm học, bạn muốn cho người ngồi cạnh biết tên mình và cách gọi dễ nhất.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thành viên cùng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "495634b9-0e26-5670-847f-64e3bb82b1cf-u01",
          "speaker_id": "a",
          "ja": "はじめまして。リンです。リンと呼んでください。",
          "vi": "Rất vui được gặp anh. Tôi là Linh. Cứ gọi tôi là Linh nhé."
        },
        {
          "id": "495634b9-0e26-5670-847f-64e3bb82b1cf-u02",
          "speaker_id": "b",
          "ja": "リンさんですね。私は田中です。",
          "vi": "Chị Linh nhỉ. Tôi là Tanaka."
        },
        {
          "id": "495634b9-0e26-5670-847f-64e3bb82b1cf-u03",
          "speaker_id": "a",
          "ja": "田中さん、よろしくお願いします。",
          "vi": "Anh Tanaka, rất vui được làm quen."
        },
        {
          "id": "495634b9-0e26-5670-847f-64e3bb82b1cf-u04",
          "speaker_id": "b",
          "ja": "こちらこそ、よろしくお願いします。",
          "vi": "Tôi cũng vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "intro",
          "bjt"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "495634b9-0e26-5670-847f-64e3bb82b1cf-u01": {
