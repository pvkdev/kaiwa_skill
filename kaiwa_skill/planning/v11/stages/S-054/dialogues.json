    {
      "situation_uid": "f2361526-9b1f-5b66-8def-b174c7e173b7",
      "event_id": "E04",
      "context_vi": "Nhân viên cứu trợ hỏi về bệnh nền và thuốc người bệnh dùng. Bạn không biết vì không quen người ấy.",
