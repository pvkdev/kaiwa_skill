            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "5e6299f1-b340-5afb-9707-d5c8b0fc92aa",
      "event_id": "E01",
      "context_vi": "Người tiếp nhận 119 hỏi chính xác tên tòa và tầng nơi người vừa ngã; bạn bổ sung thông tin đã nhìn trên biển.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5e6299f1-b340-5afb-9707-d5c8b0fc92aa-u01",
          "speaker_id": "b",
          "ja": "建物の名前と階を教えてください。",
          "vi": "Cho tôi biết tên tòa nhà và tầng ạ?"
        },
        {
          "id": "5e6299f1-b340-5afb-9707-d5c8b0fc92aa-u02",
          "speaker_id": "a",
          "ja": "あおいビルの三階です。入口に青い看板があります。",
          "vi": "Tòa Aoi, tầng ba. Ở cửa vào có biển màu xanh."
        },
        {
          "id": "5e6299f1-b340-5afb-9707-d5c8b0fc92aa-u03",
          "speaker_id": "b",
          "ja": "あおいビル三階、青い看板ですね。",
          "vi": "Tòa Aoi tầng ba, có biển xanh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5e6299f1-b340-5afb-9707-d5c8b0fc92aa-u01": {
            "kind": "original_extension"
          },
