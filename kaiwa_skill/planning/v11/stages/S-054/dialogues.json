    {
      "situation_uid": "41a0736e-4019-5cc3-b16d-7119e51fbafb",
      "event_id": "E03",
      "context_vi": "Người đầu tiên đã nhận ra cửa bắc đón đội nhưng nay không đi được. Bạn nhờ người khác ra biển xanh cửa bắc, còn mình ở với người bệnh trên tầng ba.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần thứ hai",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "41a0736e-4019-5cc3-b16d-7119e51fbafb-u01",
          "speaker_id": "a",
          "ja": "先ほどの人は入口に行けません。北側の青い看板で救急の人を待ってもらえますか。",
          "vi": "Người lúc nãy không ra đón được. Anh ra đợi đội cấp cứu ở biển xanh cửa phía bắc giúp tôi được không?"
        },
        {
          "id": "41a0736e-4019-5cc3-b16d-7119e51fbafb-u02",
          "speaker_id": "b",
          "ja": "はい。北側で待ちます。",
          "vi": "Được. Tôi sẽ đợi ở cửa phía bắc."
        }
      ],
      "admin": {
