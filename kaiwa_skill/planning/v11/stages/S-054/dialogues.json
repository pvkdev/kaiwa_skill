            "kind": "original_extension"
          },
          "470afe3e-88aa-56c1-a58b-8720513c652e-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "5b6f133d-7397-5d7d-b513-1297eeb9ce24",
      "event_id": "E02",
      "context_vi": "Trong khi gọi 119, người bệnh lúc đầu có đáp nhưng nay không đáp khi bạn gọi. Bạn báo thay đổi ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5b6f133d-7397-5d7d-b513-1297eeb9ce24-u01",
          "speaker_id": "a",
          "ja": "さっきは返事をしました。でも今は、呼んでも返事がありません。",
          "vi": "Lúc nãy người ấy còn trả lời. Giờ gọi thì không đáp nữa ạ."
        },
        {
          "id": "5b6f133d-7397-5d7d-b513-1297eeb9ce24-u02",
          "speaker_id": "b",
          "ja": "分かりました。今の状態を救急隊に伝えます。次の質問をします。",
          "vi": "Tôi hiểu. Tôi sẽ báo tình trạng hiện tại cho đội cấp cứu. Tôi hỏi chị tiếp nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5b6f133d-7397-5d7d-b513-1297eeb9ce24-u01": {
            "kind": "original_extension"
          },
          "5b6f133d-7397-5d7d-b513-1297eeb9ce24-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "e99b29fd-5bd1-56f1-b2e1-14a1ea5b55da",
      "event_id": "E03",
      "context_vi": "Bạn đang ở cùng người bệnh tại tầng ba tòa Aoi. Bạn nhờ người ở gần ra cửa bắc, chỗ biển xanh, đón đội cấp cứu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e99b29fd-5bd1-56f1-b2e1-14a1ea5b55da-u01",
          "speaker_id": "a",
          "ja": "救急隊が来ます。このビルの北側の入口に青い看板があります。そこで迎えてもらえますか。",
          "vi": "Đội cấp cứu sắp tới. Anh đón họ ở biển xanh tại lối vào phía bắc tòa này giúp tôi được không ạ?"
        },
        {
          "id": "e99b29fd-5bd1-56f1-b2e1-14a1ea5b55da-u02",
          "speaker_id": "b",
          "ja": "はい、北側の青い看板のところで待ちます。",
          "vi": "Được, tôi sẽ đợi ở chỗ biển xanh phía bắc."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
