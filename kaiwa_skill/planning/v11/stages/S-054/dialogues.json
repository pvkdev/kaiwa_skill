            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "f61b4933-7919-52d4-b10b-adc15e6f73a2",
      "event_id": "E02",
      "context_vi": "Bạn đang ở cạnh người vừa ngã. Người tiếp nhận 119 hỏi người ấy có đáp khi được gọi không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f61b4933-7919-52d4-b10b-adc15e6f73a2-u01",
          "speaker_id": "b",
          "ja": "呼びかけると、返事がありますか。",
          "vi": "Khi gọi, người ấy có đáp không ạ?"
        },
        {
          "id": "f61b4933-7919-52d4-b10b-adc15e6f73a2-u02",
          "speaker_id": "a",
          "ja": "はい、目を開けて返事をしました。",
          "vi": "Có, người ấy mở mắt và trả lời."
        },
        {
          "id": "f61b4933-7919-52d4-b10b-adc15e6f73a2-u03",
          "speaker_id": "b",
          "ja": "分かりました。今の様子を続けて教えてください。",
          "vi": "Tôi hiểu. Bạn tiếp tục cho biết tình trạng lúc này."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f61b4933-7919-52d4-b10b-adc15e6f73a2-u01": {
            "kind": "original_extension"
