      "turns": [
        {
          "id": "dd23d18e-d628-57ca-bdd7-2a51bf25f873-u01",
          "speaker_id": "a",
          "ja": "二分ほど前に倒れるのを見ました。最初は返事があり、今はありません。",
          "vi": "Tôi thấy người ấy ngã khoảng hai phút trước. Ban đầu còn đáp, giờ thì không."
        },
        {
          "id": "dd23d18e-d628-57ca-bdd7-2a51bf25f873-u02",
          "speaker_id": "b",
          "ja": "分かりました。今の状態を確認します。",
          "vi": "Tôi hiểu. Tôi sẽ kiểm tra tình trạng hiện tại."
        }
