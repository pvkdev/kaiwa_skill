          },
          "5e6299f1-b340-5afb-9707-d5c8b0fc92aa-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "2fee86de-47f6-5162-af9f-ee71f6315a1d",
      "event_id": "E01",
      "context_vi": "Bạn không nhớ số nhà của tòa Aoi. Từ cửa sổ tầng ba, bạn nhìn thấy cửa bắc ga Aoi và biển xanh ở lối vào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2fee86de-47f6-5162-af9f-ee71f6315a1d-u01",
          "speaker_id": "b",
          "ja": "住所の番地は分かりますか。",
          "vi": "Bạn biết số nhà không ạ?"
        },
        {
          "id": "2fee86de-47f6-5162-af9f-ee71f6315a1d-u02",
          "speaker_id": "a",
          "ja": "番地は分かりません。あおい駅の北口の前で、入口に青い看板があります。この目印で分かりますか。",
          "vi": "Tôi không biết số nhà. Tòa ở trước cửa bắc ga Aoi, lối vào có biển xanh. Dùng mốc đó tìm được không ạ?"
        },
        {
          "id": "2fee86de-47f6-5162-af9f-ee71f6315a1d-u03",
          "speaker_id": "b",
          "ja": "その目印を伝えます。",
          "vi": "Tôi sẽ chuyển các mốc ấy."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "2fee86de-47f6-5162-af9f-ee71f6315a1d-u01": {
            "kind": "original_extension"
          },
          "2fee86de-47f6-5162-af9f-ee71f6315a1d-u02": {
            "kind": "original_extension"
          },
          "2fee86de-47f6-5162-af9f-ee71f6315a1d-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "b9acddf9-3db1-5331-b571-9539ec1ba177",
      "event_id": "E01",
      "context_vi": "Bạn đã nói ngắn rằng có người ngã ở tòa Aoi, nhưng chưa theo kịp câu hỏi tiếp của tổng đài 119. Bạn nói mình dùng tiếng Việt và xin nói chậm để có thể trả lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b9acddf9-3db1-5331-b571-9539ec1ba177-u01",
          "speaker_id": "a",
          "ja": "人が倒れました。ベトナム語で話せますか。日本語なら、ゆっくりお願いします。",
          "vi": "Có người vừa ngã. Tôi nói tiếng Việt được không ạ? Nếu nói tiếng Nhật, xin nói chậm giúp tôi."
        },
        {
          "id": "b9acddf9-3db1-5331-b571-9539ec1ba177-u02",
          "speaker_id": "b",
          "ja": "ゆっくり聞きます。今、どこにいますか。",
          "vi": "Tôi sẽ hỏi chậm. Chị đang ở đâu ạ?"
        },
        {
          "id": "b9acddf9-3db1-5331-b571-9539ec1ba177-u03",
          "speaker_id": "a",
          "ja": "あおい駅の北口、あおいビルの三階です。",
          "vi": "Tầng ba tòa Aoi, trước cửa bắc ga Aoi ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b9acddf9-3db1-5331-b571-9539ec1ba177-u01": {
