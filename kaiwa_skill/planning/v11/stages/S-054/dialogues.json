    {
      "situation_uid": "be94633e-b754-5e6f-a792-68fc41b99b83",
      "event_id": "E03",
      "context_vi": "Bạn chốt với người ở gần rằng mình ở lại cạnh người bệnh trên tầng ba, còn họ ra cửa bắc đón đội.",
