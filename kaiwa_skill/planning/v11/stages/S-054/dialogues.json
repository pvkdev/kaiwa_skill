          },
          "f61b4933-7919-52d4-b10b-adc15e6f73a2-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "fd6f4714-0c16-544b-96be-9c20b608c97a",
      "event_id": "E02",
      "context_vi": "Người tiếp nhận 119 hỏi khi nào người ấy ngã; bạn chỉ kể những gì tận mắt chứng kiến.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fd6f4714-0c16-544b-96be-9c20b608c97a-u01",
          "speaker_id": "b",
          "ja": "いつ倒れましたか。",
          "vi": "Người ấy ngã lúc nào ạ?"
        },
        {
          "id": "fd6f4714-0c16-544b-96be-9c20b608c97a-u02",
          "speaker_id": "a",
          "ja": "今、二分ほど前です。私は倒れるところを見ました。",
          "vi": "Vừa rồi, khoảng hai phút trước. Tôi đã nhìn thấy lúc người ấy ngã."
        },
        {
          "id": "fd6f4714-0c16-544b-96be-9c20b608c97a-u03",
          "speaker_id": "b",
          "ja": "二分ほど前ですね。",
          "vi": "Khoảng hai phút trước ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fd6f4714-0c16-544b-96be-9c20b608c97a-u01": {
