          "5e6299f1-b340-5afb-9707-d5c8b0fc92aa-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "2fee86de-47f6-5162-af9f-ee71f6315a1d",
      "event_id": "E01",
      "context_vi": "Bạn không nhớ số nhà của tòa Aoi. Từ cửa sổ tầng ba, bạn nhìn thấy cửa bắc ga Aoi và biển xanh ở lối vào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2fee86de-47f6-5162-af9f-ee71f6315a1d-u01",
          "speaker_id": "b",
          "ja": "住所の番地は分かりますか。",
          "vi": "Bạn biết số nhà không ạ?"
        },
        {
          "id": "2fee86de-47f6-5162-af9f-ee71f6315a1d-u02",
          "speaker_id": "a",
          "ja": "分かりません。あおい駅の北口の前です。入口に青い看板があります。",
          "vi": "Tôi không biết số nhà. Tòa ở trước cửa bắc ga Aoi, lối vào có biển xanh."
        },
        {
          "id": "2fee86de-47f6-5162-af9f-ee71f6315a1d-u03",
          "speaker_id": "b",
          "ja": "その目印を伝えます。",
          "vi": "Tôi sẽ chuyển các mốc ấy."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "2fee86de-47f6-5162-af9f-ee71f6315a1d-u01": {
            "kind": "original_extension"
          },
          "2fee86de-47f6-5162-af9f-ee71f6315a1d-u02": {
            "kind": "original_extension"
          },
          "2fee86de-47f6-5162-af9f-ee71f6315a1d-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "b9acddf9-3db1-5331-b571-9539ec1ba177",
      "event_id": "E01",
      "context_vi": "Trong cuộc gọi 119, bạn nghe không rõ câu hỏi đầu. Bạn nêu ngắn việc khẩn cấp và xin người tiếp nhận nói chậm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b9acddf9-3db1-5331-b571-9539ec1ba177-u01",
          "speaker_id": "a",
          "ja": "すみません、もう一度ゆっくりお願いします。ベトナム語を話します。人が倒れました。",
          "vi": "Xin nói lại chậm giúp tôi. Tôi nói tiếng Việt. Có người vừa ngã."
        },
        {
          "id": "b9acddf9-3db1-5331-b571-9539ec1ba177-u02",
          "speaker_id": "b",
          "ja": "分かりました。まず場所を教えてください。",
          "vi": "Tôi hiểu. Trước hết cho biết nơi xảy ra việc."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
