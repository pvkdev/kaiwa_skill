    {
      "situation_uid": "dd23d18e-d628-57ca-bdd7-2a51bf25f873",
      "event_id": "E04",
      "context_vi": "Đội cấp cứu đã tới tầng ba tòa Aoi. Bạn kể lại điều mình trực tiếp nhìn thấy theo thứ tự.",
