  "dialogues": [
    {
      "situation_uid": "1d71af66-716e-53e8-87ba-9b4b85a377d4",
      "event_id": "E01",
      "context_vi": "Ở tầng ba tòa Aoi hư cấu gần cửa bắc ga Aoi, một người vừa ngã. Bạn gọi 119 ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1d71af66-716e-53e8-87ba-9b4b85a377d4-u01",
          "speaker_id": "b",
          "ja": "119です。火事ですか、救急ですか。",
          "vi": "119 đây. Có cháy hay cần cấp cứu ạ?"
        },
        {
          "id": "1d71af66-716e-53e8-87ba-9b4b85a377d4-u02",
          "speaker_id": "a",
          "ja": "救急です。人が倒れました。あおい駅北口のあおいビル三階です。",
          "vi": "Cần cấp cứu. Có người vừa ngã. Ở tầng ba tòa Aoi, cửa bắc ga Aoi."
        },
        {
          "id": "1d71af66-716e-53e8-87ba-9b4b85a377d4-u03",
          "speaker_id": "b",
          "ja": "あおいビル三階ですね。",
          "vi": "Tầng ba tòa Aoi, đúng không ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1d71af66-716e-53e8-87ba-9b4b85a377d4-u01": {
            "kind": "original_extension"
