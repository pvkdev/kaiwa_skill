            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "470afe3e-88aa-56c1-a58b-8720513c652e",
      "event_id": "E02",
      "context_vi": "Một người khác bảo người bệnh đã ngã lâu hơn, nhưng bạn chỉ thấy họ ngã khoảng hai phút trước. Bạn nói rõ nguồn tin.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "470afe3e-88aa-56c1-a58b-8720513c652e-u01",
          "speaker_id": "b",
          "ja": "ほかの方は十分前だと言っていますか。",
          "vi": "Có người khác nói khoảng mười phút trước phải không ạ?"
        },
        {
          "id": "470afe3e-88aa-56c1-a58b-8720513c652e-u02",
          "speaker_id": "a",
          "ja": "はい。でも私が見たのは二分ほど前です。前のことは分かりません。",
          "vi": "Vâng, người kia nói vậy. Còn tôi tận mắt thấy họ ngã khoảng hai phút trước. Trước đó tôi không biết ạ."
        },
        {
          "id": "470afe3e-88aa-56c1-a58b-8720513c652e-u03",
          "speaker_id": "b",
          "ja": "見た時間を記録します。",
          "vi": "Tôi sẽ ghi mốc bạn tận mắt thấy."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "470afe3e-88aa-56c1-a58b-8720513c652e-u01": {
            "kind": "original_extension"
          },
