          }
        }
      }
    },
    {
      "situation_uid": "5b6f133d-7397-5d7d-b513-1297eeb9ce24",
      "event_id": "E02",
      "context_vi": "Trong khi gọi 119, người bệnh lúc đầu có đáp nhưng nay không đáp khi bạn gọi. Bạn báo thay đổi ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5b6f133d-7397-5d7d-b513-1297eeb9ce24-u01",
          "speaker_id": "a",
          "ja": "今、変わりました。さっきは返事がありましたが、今は返事がありません。",
          "vi": "Tình trạng vừa thay đổi. Lúc nãy người ấy còn trả lời, giờ gọi thì không đáp."
        },
        {
          "id": "5b6f133d-7397-5d7d-b513-1297eeb9ce24-u02",
          "speaker_id": "b",
          "ja": "分かりました。今の状態を隊員に伝えます。続けて質問します。",
          "vi": "Tôi hiểu. Tôi sẽ báo tình trạng mới cho đội đến và hỏi tiếp."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5b6f133d-7397-5d7d-b513-1297eeb9ce24-u01": {
            "kind": "original_extension"
          },
          "5b6f133d-7397-5d7d-b513-1297eeb9ce24-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "e99b29fd-5bd1-56f1-b2e1-14a1ea5b55da",
      "event_id": "E03",
      "context_vi": "Bạn đang ở cùng người bệnh tại tầng ba tòa Aoi. Bạn nhờ người ở gần ra cửa bắc, chỗ biển xanh, đón đội cấp cứu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người ở gần",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e99b29fd-5bd1-56f1-b2e1-14a1ea5b55da-u01",
          "speaker_id": "a",
          "ja": "救急の人が来ます。北口側の青い看板で待ってもらえますか。",
          "vi": "Đội cấp cứu sắp tới. Anh ra chờ ở biển xanh phía cửa bắc giúp tôi được không?"
        },
        {
          "id": "e99b29fd-5bd1-56f1-b2e1-14a1ea5b55da-u02",
          "speaker_id": "b",
          "ja": "はい。私は入口に行きます。",
          "vi": "Được. Tôi sẽ ra lối vào."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e99b29fd-5bd1-56f1-b2e1-14a1ea5b55da-u01": {
            "kind": "original_extension"
          },
          "e99b29fd-5bd1-56f1-b2e1-14a1ea5b55da-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "bc42e9dc-520b-50d5-8b35-ba1dcbd613b6",
      "event_id": "E03",
      "context_vi": "Lối vào phía cửa bắc tòa Aoi bị chặn. Bạn gọi lại 119 báo xe có thể tới cửa phía đông.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận 119",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bc42e9dc-520b-50d5-8b35-ba1dcbd613b6-u01",
          "speaker_id": "a",
          "ja": "北側の入口が閉まっています。東側の入口から入れます。",
          "vi": "Cửa phía bắc bị đóng. Có thể vào bằng cửa phía đông."
        },
        {
          "id": "bc42e9dc-520b-50d5-8b35-ba1dcbd613b6-u02",
          "speaker_id": "b",
          "ja": "東側の入口ですね。到着する隊員に伝えます。",
          "vi": "Cửa phía đông. Tôi sẽ báo đội đến."
        }
      ],
      "admin": {
