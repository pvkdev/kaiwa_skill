    {
      "situation_uid": "b7187ba4-7ab5-5830-8810-537e87599515",
      "event_id": "E03",
      "context_vi": "Vài ngày sau khi nhận kính ở Hikari, bạn đeo thấy cấn sau tai và gọi hẹn kiểm lại gọng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b7187ba4-7ab5-5830-8810-537e87599515-u01",
          "speaker_id": "a",
          "ja": "先日買ったメガネが、耳の後ろに当たります。見てもらえますか。",
          "vi": "Kính tôi mua mấy hôm trước cấn sau tai. Cửa hàng xem giúp được không ạ?"
        },
        {
          "id": "b7187ba4-7ab5-5830-8810-537e87599515-u02",
          "speaker_id": "b",
          "ja": "状態を見ます。メガネを持って来られますか。",
          "vi": "Tôi cần xem tình trạng. Anh mang kính tới được không?"
        },
        {
          "id": "b7187ba4-7ab5-5830-8810-537e87599515-u03",
          "speaker_id": "a",
          "ja": "はい。今日の午後に行きます。",
          "vi": "Được ạ, chiều nay tôi đến."
        },
        {
          "id": "b7187ba4-7ab5-5830-8810-537e87599515-u04",
          "speaker_id": "b",
          "ja": "承知しました。受付でお声がけください。",
          "vi": "Vâng. Anh hỏi ở quầy tiếp nhận nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "zoff_fit"
        ],
        "specialty_item_ids": [],
