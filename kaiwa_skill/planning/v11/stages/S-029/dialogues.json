          }
        }
      }
    },
    {
      "situation_uid": "9c5c4551-2267-52be-a3ce-5ea4b43e1f9d",
      "event_id": "E01",
      "context_vi": "Sau khi gọng mảnh không dùng được với tròng đã chọn, nhân viên Hikari đưa gọng xanh sẫm khác và xác nhận tương thích. Bạn thử lại rồi quyết định.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9c5c4551-2267-52be-a3ce-5ea4b43e1f9d-u01",
          "speaker_id": "b",
          "ja": "こちらの紺のフレームなら、選んだレンズを入れられます。",
          "vi": "Gọng xanh navy này lắp được tròng anh chọn ạ."
        },
        {
          "id": "9c5c4551-2267-52be-a3ce-5ea4b43e1f9d-u02",
          "speaker_id": "a",
          "ja": "かけてみます。今度はこめかみも痛くありません。",
          "vi": "Để tôi thử. Lần này thái dương cũng không bị cấn."
        },
        {
          "id": "9c5c4551-2267-52be-a3ce-5ea4b43e1f9d-u03",
          "speaker_id": "b",
          "ja": "このフレームでよろしいですか。",
          "vi": "Anh chọn gọng này nhé?"
        },
        {
          "id": "9c5c4551-2267-52be-a3ce-5ea4b43e1f9d-u04",
          "speaker_id": "a",
          "ja": "はい、これにします。",
          "vi": "Vâng, tôi lấy gọng này."
        }
      ],
      "admin": {
        "source_refs": [
          "shop_book"
        ],
        "specialty_item_ids": [],
