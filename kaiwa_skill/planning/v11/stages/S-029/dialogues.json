    {
      "situation_uid": "eff453f7-42f9-5b87-9bc1-7c7d409f60ef",
      "event_id": "E03",
      "context_vi": "Sau 15 phút bạn quay lại quầy Hikari nhận gọng đã chỉnh. Bạn thử cúi xuống lại để xác nhận kính vừa hơn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "eff453f7-42f9-5b87-9bc1-7c7d409f60ef-u01",
          "speaker_id": "b",
          "ja": "調整が終わりました。かけてみてください。",
          "vi": "Tôi chỉnh xong rồi. Anh đeo thử nhé."
        },
        {
          "id": "eff453f7-42f9-5b87-9bc1-7c7d409f60ef-u02",
          "speaker_id": "a",
          "ja": "下を向いても、前よりずれません。",
          "vi": "Cúi xuống kính không trượt như trước nữa."
        },
        {
          "id": "eff453f7-42f9-5b87-9bc1-7c7d409f60ef-u03",
          "speaker_id": "b",
          "ja": "こめかみは痛くないですか。",
          "vi": "Thái dương có bị cấn không ạ?"
        },
        {
          "id": "eff453f7-42f9-5b87-9bc1-7c7d409f60ef-u04",
          "speaker_id": "a",
          "ja": "はい、大丈夫です。これでお願いします。",
          "vi": "Không ạ, như vậy được rồi."
        }
      ],
      "admin": {
