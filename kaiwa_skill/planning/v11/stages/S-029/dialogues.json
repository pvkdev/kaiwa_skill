      "turns": [
        {
          "id": "702c8e0f-de64-5e3f-829b-1a866d217033-u01",
          "speaker_id": "a",
          "ja": "線がゆがんで見えます。ここで原因が分かりますか。",
          "vi": "Tôi nhìn đường thẳng thấy méo. Ở đây biết nguyên nhân được không ạ?"
        },
        {
          "id": "702c8e0f-de64-5e3f-829b-1a866d217033-u02",
          "speaker_id": "b",
          "ja": "申し訳ありません。原因は店では分かりません。早めに眼科を受診してください。",
          "vi": "Xin lỗi, cửa hàng không xác định được nguyên nhân. Anh nên đi khám mắt sớm."
        },
        {
          "id": "702c8e0f-de64-5e3f-829b-1a866d217033-u03",
          "speaker_id": "a",
          "ja": "分かりました。近くの眼科を教えていただけますか。",
          "vi": "Tôi hiểu. Chị chỉ giúp tôi phòng khám mắt gần đây được không ạ?"
        },
        {
          "id": "702c8e0f-de64-5e3f-829b-1a866d217033-u04",
          "speaker_id": "b",
          "ja": "近くの眼科を調べますね。",
          "vi": "Tôi sẽ tìm phòng khám mắt gần đây cho anh nhé."
        }
      ],
