    {
      "situation_uid": "9f8be3b2-46e3-587a-a7bf-f9e3ab434928",
      "event_id": "E04",
      "context_vi": "Sau khi đính chính tại Hikari rằng chỉ có gọng bị lệch, bạn chốt yêu cầu kiểm gọng và hỏi bước tiếp. Chưa quyết định thay tròng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9f8be3b2-46e3-587a-a7bf-f9e3ab434928-u01",
          "speaker_id": "a",
          "ja": "レンズではなく、フレームだけ確認してください。",
          "vi": "Xin kiểm gọng thôi, không phải tròng ạ."
        },
        {
          "id": "9f8be3b2-46e3-587a-a7bf-f9e3ab434928-u02",
          "speaker_id": "b",
          "ja": "はい。まず曲がり具合を見ます。調整できるか、その後お伝えします。",
          "vi": "Vâng. Tôi xem độ lệch trước rồi báo có chỉnh được không."
        },
        {
          "id": "9f8be3b2-46e3-587a-a7bf-f9e3ab434928-u03",
          "speaker_id": "a",
          "ja": "分かりました。ここで待ちます。",
          "vi": "Tôi hiểu rồi. Tôi đợi ở đây."
        }
      ],
