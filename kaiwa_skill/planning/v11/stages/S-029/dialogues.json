    {
      "situation_uid": "cfcc5d4d-8f0f-5db9-9d8b-bfef4e7ead68",
      "event_id": "E02",
      "context_vi": "Ở Hikari, tròng bạn chọn phải đặt thêm; nhân viên chưa xác nhận ngày giao. Bạn hỏi ngày dự kiến nhận của riêng đơn này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đo kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "cfcc5d4d-8f0f-5db9-9d8b-bfef4e7ead68-u01",
          "speaker_id": "b",
          "ja": "このレンズは取り寄せになります。",
          "vi": "Tròng này phải đặt thêm ạ."
        },
        {
          "id": "cfcc5d4d-8f0f-5db9-9d8b-bfef4e7ead68-u02",
          "speaker_id": "a",
          "ja": "いつごろ受け取れそうですか。",
          "vi": "Khoảng khi nào tôi nhận được ạ?"
        },
        {
          "id": "cfcc5d4d-8f0f-5db9-9d8b-bfef4e7ead68-u03",
          "speaker_id": "b",
          "ja": "発注先に確認してからお知らせします。",
          "vi": "Tôi sẽ kiểm với bên cung ứng rồi báo anh."
        },
        {
          "id": "cfcc5d4d-8f0f-5db9-9d8b-bfef4e7ead68-u04",
          "speaker_id": "a",
          "ja": "分かりました。連絡を待ちます。",
          "vi": "Tôi hiểu rồi. Tôi chờ tin."
        }
      ],
