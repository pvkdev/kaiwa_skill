  "dialogues": [
    {
      "situation_uid": "657ef750-0c1d-53f3-8dee-5f4c0f789f84",
      "event_id": "E01",
      "context_vi": "Tại cửa hàng kính Hikari hư cấu, bạn cần kính để đọc chữ ở khoảng cách gần khi làm việc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "657ef750-0c1d-53f3-8dee-5f4c0f789f84-u01",
          "speaker_id": "a",
          "ja": "仕事で近くの字を見るメガネがほしいです。",
          "vi": "Tôi muốn kính để nhìn chữ gần khi làm việc ạ."
        },
        {
          "id": "657ef750-0c1d-53f3-8dee-5f4c0f789f84-u02",
          "speaker_id": "b",
          "ja": "今、お使いのメガネはありますか。",
          "vi": "Anh có kính đang dùng không ạ?"
        },
        {
          "id": "657ef750-0c1d-53f3-8dee-5f4c0f789f84-u03",
          "speaker_id": "a",
          "ja": "はい、持ってきました。",
          "vi": "Có, tôi mang theo rồi."
        },
        {
          "id": "657ef750-0c1d-53f3-8dee-5f4c0f789f84-u04",
          "speaker_id": "b",
          "ja": "ありがとうございます。使い方を聞いてからご案内します。",
          "vi": "Cảm ơn anh. Tôi hỏi thêm cách anh dùng rồi tư vấn nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "shop_book",
          "jins_measure"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "657ef750-0c1d-53f3-8dee-5f4c0f789f84-u01": {
