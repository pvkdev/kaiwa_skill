    {
      "situation_uid": "91bc2618-4376-5190-8a55-0fc92350224f",
      "event_id": "E03",
      "context_vi": "Bạn nhận kính mới ở Hikari, thử nhìn chữ trên bàn và thấy vẫn chưa rõ. Bạn báo đúng khoảng cách cần dùng, chưa ra khỏi quầy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "91bc2618-4376-5190-8a55-0fc92350224f-u01",
          "speaker_id": "a",
          "ja": "このメガネで、机の字がまだ見にくいです。",
          "vi": "Đeo kính này tôi vẫn khó nhìn chữ trên bàn ạ."
        },
        {
          "id": "91bc2618-4376-5190-8a55-0fc92350224f-u02",
          "speaker_id": "b",
          "ja": "どのくらい離して見ていますか。",
          "vi": "Anh nhìn cách khoảng bao xa ạ?"
        },
        {
          "id": "91bc2618-4376-5190-8a55-0fc92350224f-u03",
          "speaker_id": "a",
          "ja": "このくらいです。ここで一緒に確認できますか。",
          "vi": "Khoảng thế này. Mình kiểm cùng ở đây được không?"
        },
        {
          "id": "91bc2618-4376-5190-8a55-0fc92350224f-u04",
          "speaker_id": "b",
          "ja": "はい、確認しましょう。",
          "vi": "Được, mình kiểm nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "jins_measure",
          "zoff_fit"
        ],
