        }
      }
    },
    {
      "situation_uid": "93ada036-71fc-5470-9627-55ce6bbb9f41",
      "event_id": "E01",
      "context_vi": "Ở Hikari, bạn cầm hai gọng kính, một bằng kim loại và một bằng nhựa; muốn biết khác nhau ở điểm dễ thấy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "93ada036-71fc-5470-9627-55ce6bbb9f41-u01",
          "speaker_id": "a",
          "ja": "この二つのフレームは、何が違いますか。",
          "vi": "Hai gọng này khác nhau ở điểm nào ạ?"
        },
        {
          "id": "93ada036-71fc-5470-9627-55ce6bbb9f41-u02",
          "speaker_id": "b",
          "ja": "こちらは金属、こちらは樹脂です。重さも比べてみてください。",
          "vi": "Gọng này bằng kim loại, gọng kia bằng nhựa. Anh thử so trọng lượng nhé."
        },
        {
          "id": "93ada036-71fc-5470-9627-55ce6bbb9f41-u03",
          "speaker_id": "a",
          "ja": "樹脂のほうが軽く感じます。",
          "vi": "Tôi thấy gọng nhựa nhẹ hơn."
        }
      ],
      "admin": {
        "source_refs": [
          "shop_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "93ada036-71fc-5470-9627-55ce6bbb9f41-u01": {
            "kind": "original_extension"
          },
