    {
      "situation_uid": "e010404d-0998-5ec8-ab55-4d777b32f74e",
      "event_id": "E02",
      "context_vi": "Sau khi biết 6.000 yên chỉ là giá gọng tại Hikari, bạn hỏi tổng cả tròng trước khi đặt. Tròng được báo 3.000 yên trong ví dụ hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đo kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e010404d-0998-5ec8-ab55-4d777b32f74e-u01",
          "speaker_id": "a",
          "ja": "レンズも入れて、合計はいくらですか。",
          "vi": "Tính cả tròng thì tổng bao nhiêu ạ?"
        },
        {
          "id": "e010404d-0998-5ec8-ab55-4d777b32f74e-u02",
          "speaker_id": "b",
          "ja": "フレーム六千円、レンズ三千円で、合計九千円です。",
          "vi": "Gọng 6.000 yên, tròng 3.000 yên, tổng 9.000 yên ạ."
        },
        {
          "id": "e010404d-0998-5ec8-ab55-4d777b32f74e-u03",
          "speaker_id": "a",
          "ja": "九千円ですね。作る前に確認できてよかったです。",
          "vi": "9.000 yên nhỉ. May là tôi đã kiểm trước khi đặt."
        }
      ],
      "admin": {
        "source_refs": [
          "shop_book"
        ],
