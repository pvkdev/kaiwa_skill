    {
      "situation_uid": "9f891a54-8d9c-52e4-83a8-14e43f6d6f03",
      "event_id": "E04",
      "context_vi": "Tại Hikari, bạn hỏi ranh giới giữa chỉnh gọng và khám mắt vì gần đây một bên mắt đột nhiên nhìn khác. Nhân viên không chẩn đoán.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9f891a54-8d9c-52e4-83a8-14e43f6d6f03-u01",
          "speaker_id": "a",
          "ja": "片方の目だけ急に見えにくくなりました。メガネの調整でいいですか。",
          "vi": "Một bên mắt tôi đột nhiên nhìn kém. Chỉ chỉnh kính là đủ không ạ?"
        },
        {
          "id": "9f891a54-8d9c-52e4-83a8-14e43f6d6f03-u02",
          "speaker_id": "b",
          "ja": "その症状は、できるだけ早く眼科を受診してください。ここでは診断できません。",
          "vi": "Với tình trạng đó, anh nên đi khám mắt càng sớm càng tốt. Ở đây chúng tôi không chẩn đoán được."
        },
        {
          "id": "9f891a54-8d9c-52e4-83a8-14e43f6d6f03-u03",
          "speaker_id": "a",
          "ja": "分かりました。早めに眼科に行きます。",
          "vi": "Tôi hiểu. Tôi sẽ đi khám mắt sớm."
        }
      ],
      "admin": {
        "source_refs": [
          "eye_society",
          "jins_measure"
        ],
