    {
      "situation_uid": "0bf737a5-02b3-5304-a36b-ffcfa25de4a8",
      "event_id": "E02",
      "context_vi": "Tại Hikari, bạn muốn biết cửa hàng sẽ làm gì trước khi đặt kính, và liệu cần đưa kính cũ ra kiểm không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đo kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0bf737a5-02b3-5304-a36b-ffcfa25de4a8-u01",
          "speaker_id": "a",
          "ja": "メガネを作る前に、何を確認しますか。",
          "vi": "Trước khi làm kính, cửa hàng kiểm những gì ạ?"
        },
        {
          "id": "0bf737a5-02b3-5304-a36b-ffcfa25de4a8-u02",
          "speaker_id": "b",
          "ja": "使い方を聞いて、度数を確認します。今のメガネも見せていただけますか。",
          "vi": "Tôi hỏi cách dùng và kiểm độ kính. Anh cho tôi xem kính hiện tại được không?"
        },
        {
          "id": "0bf737a5-02b3-5304-a36b-ffcfa25de4a8-u03",
          "speaker_id": "a",
          "ja": "はい。これです。",
          "vi": "Có ạ, đây ạ."
        },
        {
          "id": "0bf737a5-02b3-5304-a36b-ffcfa25de4a8-u04",
          "speaker_id": "b",
          "ja": "ありがとうございます。まずこちらを確認します。",
          "vi": "Cảm ơn anh. Tôi xem chiếc này trước nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "jins_measure"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0bf737a5-02b3-5304-a36b-ffcfa25de4a8-u01": {
