            "kind": "original_extension"
          },
          "d457eaef-f7e3-5d32-aa8a-3c5d53fcc27e-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "18cef061-4759-590c-875c-c2fe5eac1c36",
      "event_id": "E01",
      "context_vi": "Ở Hikari, nhân viên đã kiểm chiếc gọng mảnh bạn thích và nói gọng này không nhận được loại tròng bạn vừa chọn tại cửa hàng này. Bạn hỏi lựa chọn khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "18cef061-4759-590c-875c-c2fe5eac1c36-u01",
          "speaker_id": "b",
          "ja": "このフレームには、今選んだレンズを入れられません。",
          "vi": "Gọng này không lắp được loại tròng anh vừa chọn ạ."
        },
        {
          "id": "18cef061-4759-590c-875c-c2fe5eac1c36-u02",
          "speaker_id": "a",
          "ja": "そうですか。同じような色で、使えるフレームはありますか。",
          "vi": "Vậy à. Có gọng màu gần giống mà dùng được không ạ?"
        },
        {
          "id": "18cef061-4759-590c-875c-c2fe5eac1c36-u03",
          "speaker_id": "b",
          "ja": "こちらを確認してみます。",
          "vi": "Để tôi kiểm mẫu này nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "shop_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "18cef061-4759-590c-875c-c2fe5eac1c36-u01": {
