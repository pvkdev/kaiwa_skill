    {
      "situation_uid": "b16df3e3-42f2-519c-952a-f86620d3b134",
      "event_id": "E03",
      "context_vi": "Khi thử kính mới tại Hikari, bạn cúi đầu thì gọng trượt xuống mũi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b16df3e3-42f2-519c-952a-f86620d3b134-u01",
          "speaker_id": "a",
          "ja": "下を向くと、メガネがずれます。",
          "vi": "Tôi cúi xuống là kính trượt ạ."
        },
        {
          "id": "b16df3e3-42f2-519c-952a-f86620d3b134-u02",
          "speaker_id": "b",
          "ja": "掛かり具合を見ます。少し下を向いてください。",
          "vi": "Tôi xem độ vừa. Anh cúi nhẹ xuống nhé."
        },
        {
          "id": "b16df3e3-42f2-519c-952a-f86620d3b134-u03",
          "speaker_id": "a",
          "ja": "はい。このくらいですか。",
          "vi": "Vâng, như thế này à?"
        },
        {
          "id": "b16df3e3-42f2-519c-952a-f86620d3b134-u04",
          "speaker_id": "b",
          "ja": "はい、ありがとうございます。",
          "vi": "Đúng rồi, cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "zoff_fit"
        ],
