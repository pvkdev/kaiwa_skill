          }
        }
      }
    },
    {
      "situation_uid": "d18e8dbc-efd4-5587-8b7c-ffe72bdc8bc5",
      "event_id": "E02",
      "context_vi": "Tại Hikari, sau khi thử độ kính gợi ý ở quầy, bạn thấy nhìn gần chưa thoải mái. Bạn đề nghị kiểm lại trước khi đặt, không tự kết luận độ đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đo kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d18e8dbc-efd4-5587-8b7c-ffe72bdc8bc5-u01",
          "speaker_id": "a",
          "ja": "近くの字がまだ見にくいです。もう一度確認できますか。",
          "vi": "Chữ gần vẫn khó nhìn ạ. Mình kiểm lại được không?"
        },
        {
          "id": "d18e8dbc-efd4-5587-8b7c-ffe72bdc8bc5-u02",
          "speaker_id": "b",
          "ja": "はい。どの距離で使うか、もう一度教えてください。",
          "vi": "Được ạ. Anh cho tôi biết lại khoảng cách thường dùng nhé."
        },
        {
          "id": "d18e8dbc-efd4-5587-8b7c-ffe72bdc8bc5-u03",
          "speaker_id": "a",
          "ja": "机の上の本を読むときです。",
          "vi": "Khi tôi đọc sách trên bàn ạ."
        },
        {
          "id": "d18e8dbc-efd4-5587-8b7c-ffe72bdc8bc5-u04",
          "speaker_id": "b",
          "ja": "分かりました。その距離で確認します。",
          "vi": "Tôi hiểu rồi. Mình kiểm ở khoảng cách đó nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "jins_measure"
        ],
