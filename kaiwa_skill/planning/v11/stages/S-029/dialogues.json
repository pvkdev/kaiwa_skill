    {
      "situation_uid": "095482cd-d9cf-5cd7-b21e-2dd97b2b04b5",
      "event_id": "E04",
      "context_vi": "Bạn từng mua kính ở Hikari và muốn biết cửa hàng có thể cho xem lại thông số đơn cũ để tham khảo khi chọn kính mới không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "095482cd-d9cf-5cd7-b21e-2dd97b2b04b5-u01",
          "speaker_id": "a",
          "ja": "前に買ったメガネの度数を、ここで確認できますか。",
          "vi": "Tôi có thể xem lại độ của kính mua trước ở đây không ạ?"
        },
        {
          "id": "095482cd-d9cf-5cd7-b21e-2dd97b2b04b5-u02",
          "speaker_id": "b",
          "ja": "購入の記録を確認します。前のレシートはありますか。",
          "vi": "Tôi sẽ kiểm hồ sơ mua hàng. Anh còn hóa đơn trước không ạ?"
        },
        {
          "id": "095482cd-d9cf-5cd7-b21e-2dd97b2b04b5-u03",
          "speaker_id": "a",
          "ja": "はい、持っています。",
          "vi": "Có ạ, tôi mang theo."
        },
        {
          "id": "095482cd-d9cf-5cd7-b21e-2dd97b2b04b5-u04",
          "speaker_id": "b",
          "ja": "では、まず記録を見ます。",
          "vi": "Vậy tôi xem hồ sơ trước nhé."
        }
      ],
