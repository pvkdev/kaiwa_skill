    {
      "situation_uid": "5c649219-975f-564e-ae9f-a428d9641554",
      "event_id": "E04",
      "context_vi": "Bạn đưa kính tới Hikari vì gọng lệch, nhưng nhân viên hiểu bạn muốn đổi tròng. Bạn đính chính trước khi quầy xử lý.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "5c649219-975f-564e-ae9f-a428d9641554-u01",
          "speaker_id": "b",
          "ja": "レンズを交換したいのですね。",
          "vi": "Anh muốn thay tròng phải không ạ?"
        },
        {
          "id": "5c649219-975f-564e-ae9f-a428d9641554-u02",
          "speaker_id": "a",
          "ja": "いいえ、レンズはそのままです。フレームが曲がっています。",
          "vi": "Không ạ, tròng giữ nguyên. Gọng bị lệch."
        },
        {
          "id": "5c649219-975f-564e-ae9f-a428d9641554-u03",
          "speaker_id": "b",
          "ja": "失礼しました。フレームを見ます。",
          "vi": "Xin lỗi anh. Tôi sẽ xem gọng."
        }
      ],
      "admin": {
        "source_refs": [
          "zoff_fit"
        ],
