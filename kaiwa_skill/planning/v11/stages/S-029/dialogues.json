            "kind": "original_extension"
          },
          "93ada036-71fc-5470-9627-55ce6bbb9f41-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d457eaef-f7e3-5d32-aa8a-3c5d53fcc27e",
      "event_id": "E01",
      "context_vi": "Bạn thử một gọng tại Hikari, thấy phần càng chạm thái dương bên phải.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d457eaef-f7e3-5d32-aa8a-3c5d53fcc27e-u01",
          "speaker_id": "b",
          "ja": "かけ心地はいかがですか。",
          "vi": "Anh đeo thấy thế nào ạ?"
        },
        {
          "id": "d457eaef-f7e3-5d32-aa8a-3c5d53fcc27e-u02",
          "speaker_id": "a",
          "ja": "右のこめかみに当たります。",
          "vi": "Nó cấn ở thái dương bên phải ạ."
        },
        {
          "id": "d457eaef-f7e3-5d32-aa8a-3c5d53fcc27e-u03",
          "speaker_id": "b",
          "ja": "では、別の幅のフレームも試しましょう。",
          "vi": "Vậy mình thử gọng có bề ngang khác nhé."
        },
        {
          "id": "d457eaef-f7e3-5d32-aa8a-3c5d53fcc27e-u04",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ chị."
        }
      ],
      "admin": {
        "source_refs": [
          "shop_book"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
        "turn_origins": {
          "d457eaef-f7e3-5d32-aa8a-3c5d53fcc27e-u01": {
            "kind": "original_extension"
          },
          "d457eaef-f7e3-5d32-aa8a-3c5d53fcc27e-u02": {
            "kind": "original_extension"
          },
