    {
      "situation_uid": "f6d852fd-abfa-509d-92a7-f4c2e45ac6ff",
      "event_id": "E03",
      "context_vi": "Ở Hikari hư cấu, nhân viên có thể chỉnh gọng nhưng cần 15 phút; bạn hỏi khi nào quay lại. Mốc thời gian chỉ thuộc cửa hàng trong cảnh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "f6d852fd-abfa-509d-92a7-f4c2e45ac6ff-u01",
          "speaker_id": "b",
          "ja": "フレームを調整できますが、十五分ほどかかります。",
          "vi": "Tôi chỉnh gọng được, nhưng mất khoảng 15 phút ạ."
        },
        {
          "id": "f6d852fd-abfa-509d-92a7-f4c2e45ac6ff-u02",
          "speaker_id": "a",
          "ja": "いつ戻ればいいですか。",
          "vi": "Khi nào tôi quay lại ạ?"
        },
        {
          "id": "f6d852fd-abfa-509d-92a7-f4c2e45ac6ff-u03",
          "speaker_id": "b",
          "ja": "三時十五分に、このカウンターへどうぞ。",
          "vi": "3 giờ 15 anh quay lại quầy này nhé."
        },
        {
          "id": "f6d852fd-abfa-509d-92a7-f4c2e45ac6ff-u04",
          "speaker_id": "a",
          "ja": "分かりました。三時十五分に来ます。",
          "vi": "Tôi hiểu rồi. 3 giờ 15 tôi quay lại."
        }
      ],
      "admin": {
        "source_refs": [
          "zoff_fit"
        ],
