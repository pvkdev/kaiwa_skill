    {
      "situation_uid": "9148cbe9-13f1-5255-a98e-894f65ada459",
      "event_id": "E02",
      "context_vi": "Ở Hikari hư cấu, nhân viên vừa nói gọng 6.000 yên. Bạn tưởng đó là giá của cả kính; các giá chỉ là ví dụ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên đo kính",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9148cbe9-13f1-5255-a98e-894f65ada459-u01",
          "speaker_id": "a",
          "ja": "全部で六千円ですか。",
          "vi": "Tổng cộng 6.000 yên ạ?"
        },
        {
          "id": "9148cbe9-13f1-5255-a98e-894f65ada459-u02",
          "speaker_id": "b",
          "ja": "いえ、六千円はフレームだけです。レンズは別です。",
          "vi": "Không ạ, 6.000 yên chỉ là gọng. Tròng tính riêng."
        },
        {
          "id": "9148cbe9-13f1-5255-a98e-894f65ada459-u03",
          "speaker_id": "a",
          "ja": "では、合計を知りたいです。",
          "vi": "Vậy tôi muốn biết tổng ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "shop_book"
        ],
        "specialty_item_ids": [],
