    {
      "situation_uid": "de7796a9-dbcd-5fb1-9f64-1a4cf52935a3",
      "event_id": "E01",
      "context_vi": "Ở Sora hư cấu, lối nối tầng hai giữa hai tòa đang đóng hôm nay. Bạn hỏi đường vòng từ tòa Đông sang Tây.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy thông tin",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "de7796a9-dbcd-5fb1-9f64-1a4cf52935a3-u01",
          "speaker_id": "a",
          "ja": "二階の連絡通路が閉まっています。西館へはどう行きますか。",
          "vi": "Lối nối tầng hai đang đóng. Tôi sang tòa Tây thế nào ạ?"
        },
        {
          "id": "de7796a9-dbcd-5fb1-9f64-1a4cf52935a3-u02",
          "speaker_id": "b",
          "ja": "一階へ下りて、中庭を通ってください。",
          "vi": "Anh xuống tầng một rồi đi qua sân giữa ạ."
        },
        {
          "id": "de7796a9-dbcd-5fb1-9f64-1a4cf52935a3-u03",
          "speaker_id": "a",
          "ja": "中庭から西館へ入れますか。",
          "vi": "Từ sân giữa vào tòa Tây được chứ ạ?"
        },
        {
          "id": "de7796a9-dbcd-5fb1-9f64-1a4cf52935a3-u04",
          "speaker_id": "b",
          "ja": "はい、向かいの入口から入れます。",
          "vi": "Được ạ, anh vào cửa đối diện."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
        "specialty_item_ids": [],
