          }
        }
      }
    },
    {
      "situation_uid": "68ecbee6-e4d7-5e27-9a13-2d89020aad44",
      "event_id": "E01",
      "context_vi": "Sau cuộc trao đổi trước, bạn đã nói cần Hana gần hiệu sách ở tòa Tây, không phải chi nhánh tòa Đông. Nhân viên vừa kiểm sơ đồ Sora.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy thông tin",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "68ecbee6-e4d7-5e27-9a13-2d89020aad44-u01",
          "speaker_id": "b",
          "ja": "本屋の近くのハナは西館三階です。",
          "vi": "Hana gần hiệu sách nằm ở tầng ba tòa Tây ạ."
        },
        {
          "id": "68ecbee6-e4d7-5e27-9a13-2d89020aad44-u02",
          "speaker_id": "a",
          "ja": "西館の三階、本屋の近くですね。",
          "vi": "Tầng ba tòa Tây, gần hiệu sách nhỉ."
        },
        {
          "id": "68ecbee6-e4d7-5e27-9a13-2d89020aad44-u03",
          "speaker_id": "b",
          "ja": "はい、その店です。",
          "vi": "Đúng cửa hàng đó ạ."
        },
        {
          "id": "68ecbee6-e4d7-5e27-9a13-2d89020aad44-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。そちらへ行きます。",
          "vi": "Cảm ơn chị. Tôi sẽ đến đó."
        }
      ],
      "admin": {
