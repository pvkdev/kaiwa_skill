    {
      "situation_uid": "57d63c74-5132-544f-81a7-5f1d07b7dd8e",
      "event_id": "E02",
      "context_vi": "Sau cuộc trao đổi trước, bạn đã đến trước đồng hồ xanh tòa Đông tầng một nhưng chưa thấy bạn; gọi để xác định khoảng cách.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "bạn đi cùng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "57d63c74-5132-544f-81a7-5f1d07b7dd8e-u01",
          "speaker_id": "a",
          "ja": "青い時計の前に着いたよ。まだ見えないね。",
          "vi": "Tớ đã tới trước đồng hồ xanh rồi, vẫn chưa thấy cậu."
        },
        {
          "id": "57d63c74-5132-544f-81a7-5f1d07b7dd8e-u02",
          "speaker_id": "b",
          "ja": "今、東館のエスカレーターを下りたところ。",
          "vi": "Tớ vừa xuống thang cuốn tòa Đông."
        },
        {
          "id": "57d63c74-5132-544f-81a7-5f1d07b7dd8e-u03",
          "speaker_id": "a",
          "ja": "時計から見て、右のエスカレーター？",
          "vi": "Thang cuốn bên phải khi nhìn từ đồng hồ à?"
        },
        {
          "id": "57d63c74-5132-544f-81a7-5f1d07b7dd8e-u04",
          "speaker_id": "b",
          "ja": "そう。もうすぐ着くよ。",
          "vi": "Đúng rồi. Tớ sắp tới."
        }
      ],
      "admin": {
