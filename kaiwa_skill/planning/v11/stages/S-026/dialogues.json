    {
      "situation_uid": "818998d2-8f70-5c20-b5cb-d3fa4313c69f",
      "event_id": "E03",
      "context_vi": "Bạn đi cùng người lớn tuổi trong Sora hư cấu và hỏi nhân viên chỗ ngồi nghỉ gần quầy này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "818998d2-8f70-5c20-b5cb-d3fa4313c69f-u01",
          "speaker_id": "a",
          "ja": "一緒の人が少し疲れました。近くに座る所はありますか。",
          "vi": "Người đi cùng tôi hơi mệt. Gần đây có chỗ ngồi không ạ?"
        },
        {
          "id": "818998d2-8f70-5c20-b5cb-d3fa4313c69f-u02",
          "speaker_id": "b",
          "ja": "この通路の奥に椅子があります。",
          "vi": "Cuối hành lang này có ghế ạ."
        },
        {
          "id": "818998d2-8f70-5c20-b5cb-d3fa4313c69f-u03",
          "speaker_id": "a",
          "ja": "遠くないですか。",
          "vi": "Có xa không ạ?"
        },
        {
          "id": "818998d2-8f70-5c20-b5cb-d3fa4313c69f-u04",
          "speaker_id": "b",
          "ja": "この階です。すぐ先ですよ。",
          "vi": "Cùng tầng này, ngay phía trước thôi ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
