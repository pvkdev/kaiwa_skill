    {
      "situation_uid": "e9baef10-8d81-5c13-8bda-ad99c357c73e",
      "event_id": "E03",
      "context_vi": "Ở Sora hư cấu, bạn mua món ở cửa hàng Hana và đã hẹn lấy sau khi đi khu khác. Bạn hỏi quầy hỗ trợ chỗ nhận đã được ghi trên phiếu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e9baef10-8d81-5c13-8bda-ad99c357c73e-u01",
          "speaker_id": "a",
          "ja": "ハナで買った物を後で受け取ります。受け取り場所はどこですか。",
          "vi": "Tôi sẽ nhận món đã mua ở Hana sau. Nơi nhận ở đâu ạ?"
        },
        {
          "id": "e9baef10-8d81-5c13-8bda-ad99c357c73e-u02",
          "speaker_id": "b",
          "ja": "お店からの控えはありますか。場所を確認します。",
          "vi": "Anh có phiếu cửa hàng đưa không ạ? Tôi xem địa điểm nhé."
        },
        {
          "id": "e9baef10-8d81-5c13-8bda-ad99c357c73e-u03",
          "speaker_id": "a",
          "ja": "はい、これです。",
          "vi": "Có ạ, đây ạ."
        },
        {
          "id": "e9baef10-8d81-5c13-8bda-ad99c357c73e-u04",
          "speaker_id": "b",
          "ja": "西館一階のハナのカウンターとあります。",
          "vi": "Phiếu ghi quầy Hana tầng một tòa Tây ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
