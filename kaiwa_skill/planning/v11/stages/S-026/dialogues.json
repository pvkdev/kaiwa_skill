  "dialogues": [
    {
      "situation_uid": "64e4b4af-80a3-5510-aa37-9bd31cd592ed",
      "event_id": "E01",
      "context_vi": "Tại trung tâm thương mại Sora hư cấu có tòa Đông và tòa Tây, bạn muốn đến cửa hàng Hana.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy thông tin",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "64e4b4af-80a3-5510-aa37-9bd31cd592ed-u01",
          "speaker_id": "a",
          "ja": "すみません、ハナという店はどの建物ですか。",
          "vi": "Xin lỗi, cửa hàng Hana ở tòa nào ạ?"
        },
        {
          "id": "64e4b4af-80a3-5510-aa37-9bd31cd592ed-u02",
          "speaker_id": "b",
          "ja": "東館と西館、両方にあります。何をお探しですか。",
          "vi": "Cả tòa Đông và tòa Tây đều có ạ. Anh tìm mặt hàng gì?"
        },
        {
          "id": "64e4b4af-80a3-5510-aa37-9bd31cd592ed-u03",
          "speaker_id": "a",
          "ja": "文房具を買いたいです。",
          "vi": "Tôi muốn mua đồ văn phòng phẩm."
        },
        {
          "id": "64e4b4af-80a3-5510-aa37-9bd31cd592ed-u04",
          "speaker_id": "b",
          "ja": "それなら東館の店です。",
          "vi": "Vậy anh cần cửa hàng ở tòa Đông ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "64e4b4af-80a3-5510-aa37-9bd31cd592ed-u01": {
