    {
      "situation_uid": "fc45ce00-9ee1-5af2-8012-0fc8fdac4d44",
      "event_id": "E02",
      "context_vi": "Bạn và người đi cùng đang nói điện thoại trong Sora. Cả tòa Đông và Tây đều có biển 'cổng chính', gây nhầm điểm gặp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "bạn đi cùng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "fc45ce00-9ee1-5af2-8012-0fc8fdac4d44-u01",
          "speaker_id": "a",
          "ja": "正面入口にいるよ。どこ？",
          "vi": "Tớ ở cổng chính rồi. Cậu đâu?"
        },
        {
          "id": "fc45ce00-9ee1-5af2-8012-0fc8fdac4d44-u02",
          "speaker_id": "b",
          "ja": "私も正面入口。でも、見えないね。",
          "vi": "Tớ cũng ở cổng chính, nhưng không thấy cậu."
        },
        {
          "id": "fc45ce00-9ee1-5af2-8012-0fc8fdac4d44-u03",
          "speaker_id": "a",
          "ja": "東館？西館？",
          "vi": "Cậu ở tòa Đông hay Tây?"
        },
        {
          "id": "fc45ce00-9ee1-5af2-8012-0fc8fdac4d44-u04",
          "speaker_id": "b",
          "ja": "あ、西館だ。",
          "vi": "À, tớ ở tòa Tây."
        }
      ],
      "admin": {
