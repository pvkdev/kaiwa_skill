    {
      "situation_uid": "67126b97-f14d-5564-ab09-b77d8c291e1e",
      "event_id": "E04",
      "context_vi": "Bạn không nhớ đã để túi mua hàng ở đâu trong Sora. Nơi cuối cùng bạn cầm túi là ghế cạnh hiệu sách tòa Tây.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "quầy thông tin",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "67126b97-f14d-5564-ab09-b77d8c291e1e-u01",
          "speaker_id": "a",
          "ja": "買った物の袋が見つかりません。最後に西館の本屋の隣で座りました。",
          "vi": "Tôi không thấy túi đồ mới mua. Lần cuối tôi ngồi cạnh hiệu sách tòa Tây."
        },
        {
          "id": "67126b97-f14d-5564-ab09-b77d8c291e1e-u02",
          "speaker_id": "b",
          "ja": "何色の袋ですか。",
          "vi": "Túi màu gì ạ?"
        },
        {
          "id": "67126b97-f14d-5564-ab09-b77d8c291e1e-u03",
          "speaker_id": "a",
          "ja": "青い袋です。中に白いシャツがあります。",
          "vi": "Túi xanh, bên trong có áo trắng ạ."
        },
        {
          "id": "67126b97-f14d-5564-ab09-b77d8c291e1e-u04",
          "speaker_id": "b",
          "ja": "確認先を調べます。少々お待ちください。",
          "vi": "Tôi sẽ tìm nơi cần hỏi. Anh đợi chút nhé."
        }
      ],
      "admin": {
