    {
      "situation_uid": "94f95c4c-f97d-5fa1-a5ba-c1e7f1107d36",
      "event_id": "E04",
      "context_vi": "Tại quầy thông tin Sora, nhân viên đang hỏi bộ phận gần hiệu sách về túi xanh của bạn, chưa có kết quả. Bạn cần biết khi nào hỏi lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "quầy thông tin",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "94f95c4c-f97d-5fa1-a5ba-c1e7f1107d36-u01",
          "speaker_id": "b",
          "ja": "今、売り場に確認しています。",
          "vi": "Hiện chúng tôi đang hỏi khu bán hàng ạ."
        },
        {
          "id": "94f95c4c-f97d-5fa1-a5ba-c1e7f1107d36-u02",
          "speaker_id": "a",
          "ja": "いつ、どこで返事を聞けますか。",
          "vi": "Khi nào và ở đâu tôi có thể hỏi kết quả ạ?"
        },
        {
          "id": "94f95c4c-f97d-5fa1-a5ba-c1e7f1107d36-u03",
          "speaker_id": "b",
          "ja": "十分ほど後に、このカウンターへお戻りください。",
          "vi": "Khoảng 10 phút nữa anh quay lại quầy này nhé."
        },
        {
          "id": "94f95c4c-f97d-5fa1-a5ba-c1e7f1107d36-u04",
          "speaker_id": "a",
          "ja": "わかりました。ここに戻ります。",
          "vi": "Tôi hiểu rồi. Tôi sẽ quay lại đây."
        }
      ],
