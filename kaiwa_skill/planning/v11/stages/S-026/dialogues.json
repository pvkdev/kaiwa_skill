    {
      "situation_uid": "4cee03dd-7bf7-5504-82a0-36b00b255a43",
      "event_id": "E02",
      "context_vi": "Bạn đi cùng một người bạn trong Sora hư cấu. Hai người tách ra mua đồ và cần chọn điểm gặp dễ nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "bạn đi cùng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4cee03dd-7bf7-5504-82a0-36b00b255a43-u01",
          "speaker_id": "a",
          "ja": "買い物が終わったら、どこで会う？",
          "vi": "Mua xong mình gặp nhau ở đâu?"
        },
        {
          "id": "4cee03dd-7bf7-5504-82a0-36b00b255a43-u02",
          "speaker_id": "b",
          "ja": "一階の青い時計の前はどう？",
          "vi": "Trước đồng hồ màu xanh ở tầng một nhé?"
        },
        {
          "id": "4cee03dd-7bf7-5504-82a0-36b00b255a43-u03",
          "speaker_id": "a",
          "ja": "いいね。東館の青い時計だよね。",
          "vi": "Được. Đồng hồ xanh ở tòa Đông nhé."
        },
        {
          "id": "4cee03dd-7bf7-5504-82a0-36b00b255a43-u04",
          "speaker_id": "b",
          "ja": "うん、そこにしよう。",
          "vi": "Ừ, gặp ở đó."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
        "specialty_item_ids": [],
