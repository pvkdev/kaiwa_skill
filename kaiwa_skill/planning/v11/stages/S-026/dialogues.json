    {
      "situation_uid": "8b428cfb-930c-5334-9cff-69908138f89d",
      "event_id": "E02",
      "context_vi": "Sau cuộc trao đổi trước, hai người đứng ở hai cổng chính khác tòa trong Sora. Bạn chọn lại một điểm duy nhất: đồng hồ xanh tòa Đông tầng một.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "bạn đi cùng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8b428cfb-930c-5334-9cff-69908138f89d-u01",
          "speaker_id": "a",
          "ja": "じゃあ、東館一階の青い時計で会おう。",
          "vi": "Vậy gặp ở đồng hồ xanh tầng một tòa Đông nhé."
        },
        {
          "id": "8b428cfb-930c-5334-9cff-69908138f89d-u02",
          "speaker_id": "b",
          "ja": "東館の青い時計ね。今から行く。",
          "vi": "Đồng hồ xanh tòa Đông nhé. Tớ đến ngay."
        },
        {
          "id": "8b428cfb-930c-5334-9cff-69908138f89d-u03",
          "speaker_id": "a",
          "ja": "うん、時計の前で待ってる。",
          "vi": "Ừ, tớ đợi trước đồng hồ."
        }
      ],
      "admin": {
        "source_refs": [
