    {
      "situation_uid": "6abe0659-2946-58dd-ad27-63a5a8959f25",
      "event_id": "E02",
      "context_vi": "Bạn gọi bạn đi cùng trong Sora. Bạn ấy đang ở tầng khác và hai người cần một mốc dễ nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "bạn đi cùng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "6abe0659-2946-58dd-ad27-63a5a8959f25-u01",
          "speaker_id": "b",
          "ja": "今、三階にいるよ。",
          "vi": "Giờ tớ ở tầng ba."
        },
        {
          "id": "6abe0659-2946-58dd-ad27-63a5a8959f25-u02",
          "speaker_id": "a",
          "ja": "近くに何が見える？",
          "vi": "Cậu thấy gì ở gần?"
        },
        {
          "id": "6abe0659-2946-58dd-ad27-63a5a8959f25-u03",
          "speaker_id": "b",
          "ja": "本屋が見える。西館だよ。",
          "vi": "Tớ thấy hiệu sách. Tớ ở tòa Tây."
        },
        {
          "id": "6abe0659-2946-58dd-ad27-63a5a8959f25-u04",
          "speaker_id": "a",
          "ja": "わかった。西館の本屋に行くね。",
          "vi": "Tớ hiểu rồi. Tớ đến hiệu sách tòa Tây."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
