    {
      "situation_uid": "5511d2b1-94d8-5e15-b9bd-c1be278ed89e",
      "event_id": "E03",
      "context_vi": "Sau cuộc trao đổi trước, phiếu của Hana ghi nhận hàng ở quầy Hana tầng một tòa Tây. Bạn cần xác nhận giờ đóng ghi trên chính phiếu của giao dịch hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "5511d2b1-94d8-5e15-b9bd-c1be278ed89e-u01",
          "speaker_id": "a",
          "ja": "西館一階のハナですね。何時までに行けばいいですか。",
          "vi": "Quầy Hana tầng một tòa Tây nhỉ. Tôi cần tới trước mấy giờ ạ?"
        },
        {
          "id": "5511d2b1-94d8-5e15-b9bd-c1be278ed89e-u02",
          "speaker_id": "b",
          "ja": "この控えには六時までと書いてあります。",
          "vi": "Trên phiếu này ghi đến 6 giờ ạ."
        },
        {
          "id": "5511d2b1-94d8-5e15-b9bd-c1be278ed89e-u03",
          "speaker_id": "a",
          "ja": "では、六時前にそのカウンターへ行きます。",
          "vi": "Vậy tôi sẽ đến quầy đó trước 6 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
