    {
      "situation_uid": "0f760101-9a93-5c5a-975e-036a42869a79",
      "event_id": "E03",
      "context_vi": "Bạn mang túi lớn và hỏi quầy hỗ trợ Sora có nơi gửi đồ hay xe đẩy không; nhân viên kiểm dịch vụ cụ thể của trung tâm này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0f760101-9a93-5c5a-975e-036a42869a79-u01",
          "speaker_id": "a",
          "ja": "大きい荷物を預ける場所はありますか。",
          "vi": "Có chỗ gửi túi lớn không ạ?"
        },
        {
          "id": "0f760101-9a93-5c5a-975e-036a42869a79-u02",
          "speaker_id": "b",
          "ja": "この館にはロッカーがあります。大きいサイズが空いているか見ます。",
          "vi": "Tòa này có tủ gửi đồ ạ. Để tôi xem ô lớn còn trống không."
        },
        {
          "id": "0f760101-9a93-5c5a-975e-036a42869a79-u03",
          "speaker_id": "a",
          "ja": "お願いします。空いていなければ、台車も聞きたいです。",
          "vi": "Nhờ chị kiểm tra. Nếu không còn, tôi muốn hỏi về xe đẩy nữa."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
