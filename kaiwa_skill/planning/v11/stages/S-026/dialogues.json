    {
      "situation_uid": "3f397e12-c9ae-58da-b953-fbe4882ca30c",
      "event_id": "E03",
      "context_vi": "Ở Sora hư cấu, tủ gửi đồ cỡ lớn của tòa này đã đầy. Bạn hỏi lựa chọn gần quầy, chưa mặc định tòa khác còn chỗ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hỗ trợ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "3f397e12-c9ae-58da-b953-fbe4882ca30c-u01",
          "speaker_id": "b",
          "ja": "大きいロッカーは今、空いていません。",
          "vi": "Hiện tủ lớn không còn ô trống ạ."
        },
        {
          "id": "3f397e12-c9ae-58da-b953-fbe4882ca30c-u02",
          "speaker_id": "a",
          "ja": "近くにほかの場所はありますか。",
          "vi": "Gần đây còn chỗ nào khác không ạ?"
        },
        {
          "id": "3f397e12-c9ae-58da-b953-fbe4882ca30c-u03",
          "speaker_id": "b",
          "ja": "西館の空き状況を確認します。少々お待ちください。",
          "vi": "Tôi sẽ kiểm tra tòa Tây còn chỗ không. Anh chờ chút nhé."
        },
        {
          "id": "3f397e12-c9ae-58da-b953-fbe4882ca30c-u04",
          "speaker_id": "a",
          "ja": "はい、ここで待ちます。",
          "vi": "Vâng, tôi đợi đây."
        }
      ],
      "admin": {
