    {
      "situation_uid": "d679747c-c5bf-50cd-ac6c-c7e0bce4f16c",
      "event_id": "E04",
      "context_vi": "Bạn mua ở hai cửa hàng khác nhau trong Sora hư cấu. Một món cần hỏi hỗ trợ; bạn muốn biết hóa đơn nào cho đúng cửa hàng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "quầy thông tin",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d679747c-c5bf-50cd-ac6c-c7e0bce4f16c-u01",
          "speaker_id": "a",
          "ja": "二つの店で買いました。この服の相談には、どのレシートを見せますか。",
          "vi": "Tôi mua ở hai cửa hàng. Hỏi về chiếc áo này thì đưa hóa đơn nào ạ?"
        },
        {
          "id": "d679747c-c5bf-50cd-ac6c-c7e0bce4f16c-u02",
          "speaker_id": "b",
          "ja": "その服を買った店のレシートを見せてください。店名は分かりますか。",
          "vi": "Anh đưa hóa đơn của cửa hàng bán áo đó nhé. Anh biết tên cửa hàng không?"
        },
        {
          "id": "d679747c-c5bf-50cd-ac6c-c7e0bce4f16c-u03",
          "speaker_id": "a",
          "ja": "はい、アオイです。こちらのレシートですね。",
          "vi": "Có ạ, Aoi. Vậy hóa đơn này nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
