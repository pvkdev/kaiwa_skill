          "id": "3d024de1-d46b-5e5d-bb39-a16e4ced1ada-u03",
          "speaker_id": "a",
          "ja": "では、ここで待ってもいいですか。",
          "vi": "Vậy tôi đợi ở đây được không ạ?"
        },
        {
          "id": "3d024de1-d46b-5e5d-bb39-a16e4ced1ada-u04",
          "speaker_id": "b",
          "ja": "はい、どうぞ。",
          "vi": "Vâng, anh cứ đợi ạ."
        }
