    },
    {
      "situation_uid": "7825a0d8-9a56-511e-b136-f2752f44c51c",
      "event_id": "E01",
      "context_vi": "Bạn đang ở quầy thông tin tầng một tòa Đông của Sora; cần lên cửa hàng sách ở tầng ba.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy thông tin",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "7825a0d8-9a56-511e-b136-f2752f44c51c-u01",
          "speaker_id": "a",
          "ja": "ここから三階の本屋へは、どう行きますか。",
          "vi": "Từ đây lên hiệu sách tầng ba đi thế nào ạ?"
        },
        {
          "id": "7825a0d8-9a56-511e-b136-f2752f44c51c-u02",
          "speaker_id": "b",
          "ja": "右のエスカレーターで三階へ上がってください。",
          "vi": "Anh đi thang cuốn bên phải lên tầng ba ạ."
        },
        {
          "id": "7825a0d8-9a56-511e-b136-f2752f44c51c-u03",
          "speaker_id": "a",
          "ja": "上がってから、どちらですか。",
          "vi": "Lên rồi thì đi hướng nào ạ?"
        },
        {
          "id": "7825a0d8-9a56-511e-b136-f2752f44c51c-u04",
          "speaker_id": "b",
          "ja": "左へ進むと、本屋があります。",
          "vi": "Rẽ trái là thấy hiệu sách ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7825a0d8-9a56-511e-b136-f2752f44c51c-u01": {
            "kind": "original_extension"
