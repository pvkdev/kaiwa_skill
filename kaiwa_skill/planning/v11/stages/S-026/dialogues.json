          }
        }
      }
    },
    {
      "situation_uid": "b92205be-c12b-539f-bb31-5a4adbec2a3a",
      "event_id": "E01",
      "context_vi": "Ở Sora, bạn hỏi cửa hàng Hana nhưng nhân viên chỉ chi nhánh tòa Đông; bạn cần chi nhánh tòa Tây gần hiệu sách.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy thông tin",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b92205be-c12b-539f-bb31-5a4adbec2a3a-u01",
          "speaker_id": "b",
          "ja": "ハナは東館の二階です。",
          "vi": "Hana ở tầng hai tòa Đông ạ."
        },
        {
          "id": "b92205be-c12b-539f-bb31-5a4adbec2a3a-u02",
          "speaker_id": "a",
          "ja": "すみません、本屋の近くのハナです。西館にもありますか。",
          "vi": "Xin lỗi, tôi tìm Hana gần hiệu sách. Tòa Tây cũng có phải không ạ?"
        },
        {
          "id": "b92205be-c12b-539f-bb31-5a4adbec2a3a-u03",
          "speaker_id": "b",
          "ja": "はい、西館にもあります。確認しますね。",
          "vi": "Có ạ, tòa Tây cũng có. Để tôi kiểm tra nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "directions"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b92205be-c12b-539f-bb31-5a4adbec2a3a-u01": {
