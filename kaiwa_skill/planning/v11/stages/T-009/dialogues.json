    {
      "situation_uid": "398ceedd-98f5-58ec-91fb-04b71a4fde54",
      "event_id": "E04",
      "context_vi": "Sau khi hai vợ chồng đề nghị chia hai cuối tuần, bố của bạn tưởng Haru không muốn thăm nhà bạn. Bạn giải thích do lịch, không đổ lỗi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bố",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "398ceedd-98f5-58ec-91fb-04b71a4fde54-u01",
          "speaker_id": "b",
          "ja": "今週来ないのは、ハルさんが会いたくないからなのか。",
          "vi": "Tuần này không đến là vì Haru không muốn gặp bố mẹ à?"
        },
        {
          "id": "398ceedd-98f5-58ec-91fb-04b71a4fde54-u02",
          "speaker_id": "a",
          "ja": "そうではないよ。二人とも仕事が遅くて疲れているし、同じ日に両方の家へ行くのは難しいんだ。",
          "vi": "Không phải vậy đâu bố. Hai đứa về muộn vì việc làm nên đều mệt, và một ngày không đi thong thả cả hai nhà được."
        },
        {
          "id": "398ceedd-98f5-58ec-91fb-04b71a4fde54-u03",
          "speaker_id": "b",
          "ja": "じゃあ、いつならゆっくり来られる？",
          "vi": "Vậy khi nào hai đứa đến được thong thả?"
        },
        {
          "id": "398ceedd-98f5-58ec-91fb-04b71a4fde54-u04",
          "speaker_id": "a",
          "ja": "今、ハルと予定を見てる。決めてから、日をはっきり伝えるね。",
          "vi": "Con đang xem lịch với Haru. Chốt xong con báo ngày rõ cho bố."
        }
      ],
