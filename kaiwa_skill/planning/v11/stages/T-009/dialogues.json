          }
        }
      }
    },
    {
      "situation_uid": "6cdeaf47-fbd5-52d5-970b-e175fb240aee",
      "event_id": "E02",
      "context_vi": "Haru nói việc nhà đang chia không đều. Bạn hỏi ví dụ cụ thể để hiểu, không phủ nhận cảm giác của anh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6cdeaf47-fbd5-52d5-970b-e175fb240aee-u01",
          "speaker_id": "b",
          "ja": "最近、片づけは僕のほうが多い気がする。",
          "vi": "Gần đây anh thấy mình dọn dẹp nhiều hơn."
        },
        {
          "id": "6cdeaf47-fbd5-52d5-970b-e175fb240aee-u02",
          "speaker_id": "a",
          "ja": "そう感じてたんだね。どの作業が特に増えた？",
          "vi": "Anh thấy vậy à. Việc nào tăng rõ nhất?"
        },
        {
          "id": "6cdeaf47-fbd5-52d5-970b-e175fb240aee-u03",
          "speaker_id": "b",
          "ja": "夕飯のあと、食器と台所を続けて片づけること。",
          "vi": "Sau bữa tối, anh vừa rửa bát vừa dọn bếp."
        },
        {
          "id": "6cdeaf47-fbd5-52d5-970b-e175fb240aee-u04",
          "speaker_id": "a",
          "ja": "確かにそこは任せきりだった。教えてくれてありがとう。",
          "vi": "Đúng là phần đó em để anh làm hết. Cảm ơn anh đã nói."
        }
      ],
      "admin": {
