          }
        }
      }
    },
    {
      "situation_uid": "9c2fb54f-5656-5f6e-993a-108bd1841273",
      "event_id": "E02",
      "context_vi": "Tối Chủ nhật, bạn nói rõ phần việc nhà mình làm được trong tuần bận, hỏi Haru phần anh nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9c2fb54f-5656-5f6e-993a-108bd1841273-u01",
          "speaker_id": "a",
          "ja": "今週は帰りが遅いから、朝の洗濯はできるけど、夕飯は毎日は作れない。",
          "vi": "Tuần này em về muộn. Buổi sáng em giặt đồ được, nhưng không nấu tối mỗi ngày được."
        },
        {
          "id": "9c2fb54f-5656-5f6e-993a-108bd1841273-u02",
          "speaker_id": "b",
          "ja": "分かった。僕は月曜と水曜の夕飯を作れるよ。",
          "vi": "Anh hiểu. Anh nấu tối thứ Hai và thứ Tư được."
        },
        {
          "id": "9c2fb54f-5656-5f6e-993a-108bd1841273-u03",
          "speaker_id": "a",
          "ja": "助かる。残りの日は簡単なものにするか、一緒に決めよう。",
          "vi": "Thế giúp em lắm. Những ngày còn lại mình cùng chọn món đơn giản nhé."
        },
        {
          "id": "9c2fb54f-5656-5f6e-993a-108bd1841273-u04",
          "speaker_id": "b",
          "ja": "うん。日曜に材料を見ておこう。",
          "vi": "Ừ. Chủ nhật xem sẵn nguyên liệu."
        }
      ],
      "admin": {
        "source_refs": [
          "family"
        ],
