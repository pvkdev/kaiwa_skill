    {
      "situation_uid": "22ae14f4-a0fe-52c8-b83e-58e0d14c1811",
      "event_id": "E02",
      "context_vi": "Sau khi Haru nói mình phải dọn bát và bếp mỗi tối, bạn đề nghị thử cách chia mới trong một tuần.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "22ae14f4-a0fe-52c8-b83e-58e0d14c1811-u01",
          "speaker_id": "a",
          "ja": "来週だけ、夕飯を作らない日は私が食器を洗うのはどう？",
          "vi": "Tuần tới thử thế này nhé: hôm nào em không nấu tối thì em rửa bát, được không?"
        },
        {
          "id": "22ae14f4-a0fe-52c8-b83e-58e0d14c1811-u02",
          "speaker_id": "b",
          "ja": "いいと思う。台所の片づけは、作った人が最後に確認しようか。",
          "vi": "Anh thấy được. Còn bếp, người nấu kiểm lại cuối cùng nhé?"
        },
        {
          "id": "22ae14f4-a0fe-52c8-b83e-58e0d14c1811-u03",
          "speaker_id": "a",
          "ja": "うん。一週間やってみて、日曜に続けられるか話そう。",
          "vi": "Ừ. Mình thử một tuần rồi Chủ nhật bàn xem có duy trì được không."
        },
        {
          "id": "22ae14f4-a0fe-52c8-b83e-58e0d14c1811-u04",
          "speaker_id": "b",
          "ja": "そうしよう。",
          "vi": "Cứ vậy nhé."
        }
      ],
