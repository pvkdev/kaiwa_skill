    {
      "situation_uid": "c5ecc5a2-b4a3-5515-975a-b86cb463823d",
      "event_id": "E04",
      "context_vi": "Sau tuần bạn thường về muộn, bạn và Haru bàn lịch thăm hai bên gia đình. Hai nhà muốn gặp vào cùng Chủ nhật.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c5ecc5a2-b4a3-5515-975a-b86cb463823d-u01",
          "speaker_id": "a",
          "ja": "私の両親もハルのご家族も、今度の日曜に来てほしいと言ってるね。でも一日で両方をゆっくり回るのは難しそう。",
          "vi": "Bố mẹ em và nhà anh đều muốn mình đến Chủ nhật này. Nhưng một ngày khó mà thăm cả hai nơi thong thả."
        },
        {
          "id": "c5ecc5a2-b4a3-5515-975a-b86cb463823d-u02",
          "speaker_id": "b",
          "ja": "そうだね。今週は二人とも疲れてるし、無理に詰め込まないほうがいい。",
          "vi": "Đúng. Tuần này cả hai đều mệt, đừng cố nhồi lịch."
        },
        {
          "id": "c5ecc5a2-b4a3-5515-975a-b86cb463823d-u03",
          "speaker_id": "a",
          "ja": "どちらかを今週、もう一方を来週にする案はどう？まず二人で決めてから連絡したい。",
          "vi": "Hay tuần này thăm một bên, tuần sau thăm bên còn lại? Mình quyết với nhau rồi hãy báo."
        },
        {
          "id": "c5ecc5a2-b4a3-5515-975a-b86cb463823d-u04",
          "speaker_id": "b",
          "ja": "いいよ。それぞれの都合も聞いてから決めよう。",
          "vi": "Được. Ta hỏi lịch hai nhà rồi quyết."
        }
      ],
