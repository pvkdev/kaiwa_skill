        }
      }
    },
    {
      "situation_uid": "83f199b5-44f8-5995-9386-e5539568f9b8",
      "event_id": "E01",
      "context_vi": "Sau khi nhận lời bạn đi buổi sáng, bạn phát hiện hẹn mua đồ với Haru cũng bị dời lên sáng. Bạn nêu việc ưu tiên và chọn lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "83f199b5-44f8-5995-9386-e5539568f9b8-u01",
          "speaker_id": "a",
          "ja": "ごめん、買い物が午前に変わったのを忘れて、友達にも午前に行けると言っちゃった。",
          "vi": "Xin lỗi, em quên lịch mua đồ chuyển sang sáng và lại nói với bạn là sáng em đi được."
        },
        {
          "id": "83f199b5-44f8-5995-9386-e5539568f9b8-u02",
          "speaker_id": "b",
          "ja": "二つ重なったね。買い物は今日必要なものだけにする？",
          "vi": "Hai lịch trùng rồi. Hay mình chỉ mua món cần ngay hôm nay?"
        },
        {
          "id": "83f199b5-44f8-5995-9386-e5539568f9b8-u03",
          "speaker_id": "a",
          "ja": "うん。必要なものを朝一緒に買って、友達には少し遅れて行けるか聞く。",
          "vi": "Ừ. Sáng mình mua món cần trước, rồi em hỏi bạn xem đến muộn chút được không."
        },
        {
          "id": "83f199b5-44f8-5995-9386-e5539568f9b8-u04",
          "speaker_id": "b",
          "ja": "それなら僕も予定を立てやすい。",
          "vi": "Vậy anh cũng dễ sắp lịch."
        }
      ],
      "admin": {
        "source_refs": [
          "family"
        ],
        "specialty_item_ids": [],
