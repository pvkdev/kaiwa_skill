    {
      "situation_uid": "467d3103-1263-5fc7-b698-e648daa5d252",
      "event_id": "E03",
      "context_vi": "Sau lần báo muộn thiếu cập nhật, hai người chốt cách liên lạc trong tuần bận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "467d3103-1263-5fc7-b698-e648daa5d252-u01",
          "speaker_id": "a",
          "ja": "今週は予定が読みにくいから、帰る時間が分かったら送るね。三十分以上変わりそうなら、もう一度知らせる。",
          "vi": "Tuần này lịch khó đoán, nên biết giờ về em sẽ nhắn. Nếu có thể lệch hơn nửa tiếng, em báo lại."
        },
        {
          "id": "467d3103-1263-5fc7-b698-e648daa5d252-u02",
          "speaker_id": "b",
          "ja": "うん。帰りが遅いときは、僕もまずメッセージを確認するよ。",
          "vi": "Ừ. Khi em về muộn, anh cũng sẽ xem tin nhắn trước."
        },
        {
          "id": "467d3103-1263-5fc7-b698-e648daa5d252-u03",
          "speaker_id": "a",
          "ja": "ありがとう。急ぎの用事があるときは、メッセージの最初に「急ぎ」と書いて。",
          "vi": "Cảm ơn anh. Nếu có việc gấp, anh ghi “gấp” đầu tin nhắn nhé."
        },
        {
          "id": "467d3103-1263-5fc7-b698-e648daa5d252-u04",
          "speaker_id": "b",
          "ja": "分かった。そのやり方で今週試そう。",
          "vi": "Được. Tuần này thử như vậy."
        }
      ],
      "admin": {
