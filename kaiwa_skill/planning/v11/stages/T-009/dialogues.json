    {
      "situation_uid": "96eb5ef3-8648-51f1-994f-2341be8ebce9",
      "event_id": "E03",
      "context_vi": "Sau chuyện liên lạc khi về muộn, bạn xin một tối ở một mình để nghỉ, không muốn Haru hiểu thành mình tránh anh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "96eb5ef3-8648-51f1-994f-2341be8ebce9-u01",
          "speaker_id": "a",
          "ja": "今日は帰ったら少し一人で静かに過ごしたい。ハルと話したくないわけじゃないよ。",
          "vi": "Tối nay về em muốn yên tĩnh một mình một chút. Không phải em không muốn nói chuyện với anh."
        },
        {
          "id": "96eb5ef3-8648-51f1-994f-2341be8ebce9-u02",
          "speaker_id": "b",
          "ja": "何か僕がしたのかと思った。疲れてるんだね。",
          "vi": "Anh tưởng mình làm gì khiến em khó chịu. Em mệt nhỉ."
        },
        {
          "id": "96eb5ef3-8648-51f1-994f-2341be8ebce9-u03",
          "speaker_id": "a",
          "ja": "うん。明日の朝ならゆっくり話せる。今夜は先に休んでもいい？",
          "vi": "Ừ. Sáng mai mình nói thong thả. Tối nay em nghỉ trước nhé?"
        },
        {
          "id": "96eb5ef3-8648-51f1-994f-2341be8ebce9-u04",
          "speaker_id": "b",
          "ja": "もちろん。明日の朝にしよう。",
          "vi": "Được chứ. Sáng mai nhé."
        }
      ],
      "admin": {
