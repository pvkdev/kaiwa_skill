        }
      }
    },
    {
      "situation_uid": "67bdb48b-0bb0-59f7-b366-b638bdb14c4f",
      "event_id": "E01",
      "context_vi": "Hai người đã quyết sáng mua đồ cần trước, bạn đi gặp bạn sau. Bạn báo lại người bạn liên quan và nói với Haru kết quả.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "67bdb48b-0bb0-59f7-b366-b638bdb14c4f-u01",
          "speaker_id": "a",
          "ja": "友達に、買い物のあと十一時ごろ合流できるか聞いたよ。大丈夫だって。",
          "vi": "Em hỏi bạn xem sau khi mua đồ, khoảng mười một giờ em tới được không. Bạn bảo được."
        },
        {
          "id": "67bdb48b-0bb0-59f7-b366-b638bdb14c4f-u02",
          "speaker_id": "b",
          "ja": "よかった。じゃあ、朝九時に一緒に店へ行こう。",
          "vi": "Tốt rồi. Vậy chín giờ sáng mình cùng ra cửa hàng."
        },
        {
          "id": "67bdb48b-0bb0-59f7-b366-b638bdb14c4f-u03",
          "speaker_id": "a",
          "ja": "うん。必要なものだけ買って、終わったら私は友達のところへ行くね。",
          "vi": "Ừ. Mua đồ cần thôi, xong em sẽ qua chỗ bạn."
        },
        {
          "id": "67bdb48b-0bb0-59f7-b366-b638bdb14c4f-u04",
          "speaker_id": "b",
          "ja": "分かった。僕は荷物を持って帰るよ。",
          "vi": "Được. Anh sẽ mang đồ về nhà."
        }
      ],
      "admin": {
        "source_refs": [
          "family"
        ],
        "specialty_item_ids": [],
