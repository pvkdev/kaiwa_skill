      "start_line": 4,
      "end_line": 82,
      "use_vi": "Đọc nhịp nói thân mật trong gia đình và cách hỏi lại từ lời người thân; dựng mới các cuộc trao đổi lịch, việc nhà và liên lạc."
    }
  },
  "dialogues": [
    {
      "situation_uid": "bc3f269a-d498-5a1f-b2df-709fe03112dd",
      "event_id": "E01",
      "context_vi": "Tối thứ Năm, bạn hỏi chồng Haru về lịch cuối tuần trước khi nhận lời bạn bè.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bc3f269a-d498-5a1f-b2df-709fe03112dd-u01",
          "speaker_id": "a",
          "ja": "土曜日、友達に誘われたんだけど、何か一緒にする予定あったっけ？",
          "vi": "Thứ Bảy bạn rủ em đi, nhưng hai đứa mình đã có kế hoạch gì chưa nhỉ?"
        },
        {
          "id": "bc3f269a-d498-5a1f-b2df-709fe03112dd-u02",
          "speaker_id": "b",
          "ja": "午後は食料品を買いに行こうって話してたよ。午前なら空いてる。",
          "vi": "Chiều mình đã nói sẽ đi mua đồ ăn. Buổi sáng thì rảnh."
        },
        {
          "id": "bc3f269a-d498-5a1f-b2df-709fe03112dd-u03",
          "speaker_id": "a",
          "ja": "そうだったね。友達には午前だけ行けるか聞いてみる。",
          "vi": "À đúng rồi. Để em hỏi bạn xem đi buổi sáng được không."
        },
        {
          "id": "bc3f269a-d498-5a1f-b2df-709fe03112dd-u04",
          "speaker_id": "b",
          "ja": "うん。午後の買い物は一緒に行こう。",
          "vi": "Ừ. Chiều mình cùng đi mua đồ nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "family"
        ],
        "specialty_item_ids": [],
