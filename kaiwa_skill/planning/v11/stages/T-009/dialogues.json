    {
      "situation_uid": "b7d266c0-d7c7-58be-b013-e371432c6859",
      "event_id": "E02",
      "context_vi": "Khi xem lại chi phí ăn uống, hai người thấy một khoản chưa rõ trên sổ ghi chép. Bạn hẹn kiểm trước khi quyết.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b7d266c0-d7c7-58be-b013-e371432c6859-u01",
          "speaker_id": "b",
          "ja": "この金額、何に使ったか覚えてる？",
          "vi": "Khoản này em có nhớ đã chi gì không?"
        },
        {
          "id": "b7d266c0-d7c7-58be-b013-e371432c6859-u02",
          "speaker_id": "a",
          "ja": "今は思い出せない。レシートを確認してから、外食費に入れるか決めよう。",
          "vi": "Giờ em chưa nhớ. Mình xem hóa đơn rồi mới quyết có tính vào tiền ăn ngoài không nhé."
        },
        {
          "id": "b7d266c0-d7c7-58be-b013-e371432c6859-u03",
          "speaker_id": "b",
          "ja": "そうだね。明日、僕も記録を見てみる。",
          "vi": "Ừ. Mai anh cũng kiểm sổ của mình."
        },
        {
          "id": "b7d266c0-d7c7-58be-b013-e371432c6859-u04",
          "speaker_id": "a",
          "ja": "ありがとう。分かるまではこの数字を使って結論を出さないでおこう。",
          "vi": "Cảm ơn anh. Trước khi rõ, mình đừng dùng khoản này để kết luận."
        }
      ],
      "admin": {
