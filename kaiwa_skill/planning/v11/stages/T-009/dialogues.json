    {
      "situation_uid": "f557bc5c-3c05-529c-adb5-ec82f4c48eb7",
      "event_id": "E03",
      "context_vi": "Bạn đã báo dự kiến về lúc chín giờ nhưng lại bị trễ thêm. Bạn gọi Haru cập nhật trước khi quá mốc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f557bc5c-3c05-529c-adb5-ec82f4c48eb7-u01",
          "speaker_id": "a",
          "ja": "さっき九時ごろ帰ると言ったけど、あと一時間ほどかかりそう。今、連絡できたから先に伝えるね。",
          "vi": "Nãy em bảo khoảng chín giờ về, nhưng chắc thêm một tiếng nữa. Giờ gọi được nên em báo trước."
        },
        {
          "id": "f557bc5c-3c05-529c-adb5-ec82f4c48eb7-u02",
          "speaker_id": "b",
          "ja": "連絡ありがとう。十時ごろを目安にしておくね。",
          "vi": "Cảm ơn em đã báo. Anh sẽ tính khoảng mười giờ."
        },
        {
          "id": "f557bc5c-3c05-529c-adb5-ec82f4c48eb7-u03",
          "speaker_id": "a",
          "ja": "うん。もしまた変わったら、分かった時点で送る。",
          "vi": "Ừ. Nếu lại đổi, biết là em nhắn ngay."
        },
        {
          "id": "f557bc5c-3c05-529c-adb5-ec82f4c48eb7-u04",
          "speaker_id": "b",
          "ja": "分かった。帰りは無理しないでね。",
          "vi": "Anh hiểu. Em về đừng vội quá nhé."
        }
      ],
      "admin": {
