    {
      "situation_uid": "84bc60c2-d495-593c-b7dd-9f97873641c3",
      "event_id": "E03",
      "context_vi": "Sau khi bạn báo sẽ về khoảng chín giờ, Haru nói anh lo vì lần trước không nhận được tin cập nhật. Bạn nghe và sửa cách báo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "84bc60c2-d495-593c-b7dd-9f97873641c3-u01",
          "speaker_id": "b",
          "ja": "この前は九時って聞いてたのに、十時を過ぎても連絡がなくて心配したよ。",
          "vi": "Lần trước em bảo chín giờ, vậy mà quá mười giờ không có tin, anh lo lắm."
        },
        {
          "id": "84bc60c2-d495-593c-b7dd-9f97873641c3-u02",
          "speaker_id": "a",
          "ja": "そうだったね。待たせた上に連絡もしなくてごめん。",
          "vi": "Đúng rồi. Em vừa để anh chờ vừa không báo, xin lỗi anh."
        },
        {
          "id": "84bc60c2-d495-593c-b7dd-9f97873641c3-u03",
          "speaker_id": "b",
          "ja": "遅くなるなら、短いメッセージだけでもほしい。",
          "vi": "Nếu muộn hơn, nhắn một câu ngắn cho anh là được."
        },
        {
          "id": "84bc60c2-d495-593c-b7dd-9f97873641c3-u04",
          "speaker_id": "a",
          "ja": "分かった。予定より三十分以上遅れそうなら、一言送るね。",
          "vi": "Em hiểu. Nếu có vẻ trễ hơn dự kiến trên nửa tiếng, em sẽ nhắn ngay."
        },
        {
          "id": "84bc60c2-d495-593c-b7dd-9f97873641c3-u05",
          "speaker_id": "b",
          "ja": "それなら安心できる。",
          "vi": "Vậy anh yên tâm hơn."
        }
      ],
      "admin": {
