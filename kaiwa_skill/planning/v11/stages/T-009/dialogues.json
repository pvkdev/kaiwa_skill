          }
        }
      }
    },
    {
      "situation_uid": "493ba82d-2605-57a2-8f03-71d720604bab",
      "event_id": "E01",
      "context_vi": "Bạn đã nói với bạn bè rằng Haru cũng sẽ dự bữa trưa, dù chưa hỏi anh. Bạn nhận lỗi và hỏi ý anh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "493ba82d-2605-57a2-8f03-71d720604bab-u01",
          "speaker_id": "a",
          "ja": "ごめん。友達に「ハルも来る」と言ったけど、まだ聞いてなかったね。勝手に決めてしまった。",
          "vi": "Xin lỗi anh. Em nói với bạn “Haru cũng đến” mà chưa hỏi anh. Em tự quyết mất rồi."
        },
        {
          "id": "493ba82d-2605-57a2-8f03-71d720604bab-u02",
          "speaker_id": "b",
          "ja": "予定を聞いてからにしてほしかったな。今回はまだ行けるか分からない。",
          "vi": "Anh muốn em hỏi lịch anh trước. Lần này anh vẫn chưa biết có đi được không."
        },
        {
          "id": "493ba82d-2605-57a2-8f03-71d720604bab-u03",
          "speaker_id": "a",
          "ja": "そうだよね。友達には未定だと訂正する。ハルは行きたい気持ちはある？",
          "vi": "Đúng rồi. Em sẽ đính chính với bạn là chưa chắc. Còn anh có muốn đi không?"
        },
        {
          "id": "493ba82d-2605-57a2-8f03-71d720604bab-u04",
          "speaker_id": "b",
          "ja": "時間が合えば行きたい。明日、仕事が決まってから答えるよ。",
          "vi": "Nếu hợp giờ thì anh muốn đi. Mai chốt ca rồi anh trả lời."
        }
      ],
      "admin": {
