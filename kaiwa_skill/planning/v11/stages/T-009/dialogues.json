    {
      "situation_uid": "99736105-09c6-5379-8cbb-dec0f13f08aa",
      "event_id": "E04",
      "context_vi": "Bố bạn vẫn muốn nói chuyện trong tháng bận. Bạn đề nghị gọi video trước, rồi bàn ngày thăm khi hai người chốt được.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bố",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "99736105-09c6-5379-8cbb-dec0f13f08aa-u01",
          "speaker_id": "a",
          "ja": "今月は週末の予定がまだ決まらないから、先に日曜の夜に少しビデオ通話しない？",
          "vi": "Tháng này lịch cuối tuần chưa chốt. Hay tối Chủ nhật mình gọi video một chút trước nhé bố?"
        },
        {
          "id": "99736105-09c6-5379-8cbb-dec0f13f08aa-u02",
          "speaker_id": "b",
          "ja": "顔を見て話せるならうれしいよ。何時ごろ？",
          "vi": "Được thấy mặt hai đứa nói chuyện thì bố vui. Mấy giờ?"
        },
        {
          "id": "99736105-09c6-5379-8cbb-dec0f13f08aa-u03",
          "speaker_id": "a",
          "ja": "八時ごろはどう？ハルにも確認して、今日中に返事する。",
          "vi": "Khoảng tám giờ được không? Con hỏi Haru rồi trong hôm nay báo bố."
        },
        {
          "id": "99736105-09c6-5379-8cbb-dec0f13f08aa-u04",
          "speaker_id": "b",
          "ja": "分かった。無理なら別の時間でもいいからね。",
          "vi": "Được. Nếu không tiện thì giờ khác cũng được."
        }
      ],
