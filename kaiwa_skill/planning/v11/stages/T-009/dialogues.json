    {
      "situation_uid": "7522c31a-b064-5d7f-a36e-95decb6a463b",
      "event_id": "E01",
      "context_vi": "Bạn muốn chốt lịch thứ Bảy nhưng Haru chưa biết ca làm. Hai người hẹn mốc xác nhận, chưa coi im lặng là đồng ý.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7522c31a-b064-5d7f-a36e-95decb6a463b-u01",
          "speaker_id": "a",
          "ja": "土曜の午後、買い物に行けそう？",
          "vi": "Chiều thứ Bảy mình đi mua đồ được không anh?"
        },
        {
          "id": "7522c31a-b064-5d7f-a36e-95decb6a463b-u02",
          "speaker_id": "b",
          "ja": "仕事の時間がまだ決まってないんだ。明日の昼には分かると思う。",
          "vi": "Ca làm của anh chưa chốt. Chắc trưa mai sẽ biết."
        },
        {
          "id": "7522c31a-b064-5d7f-a36e-95decb6a463b-u03",
          "speaker_id": "a",
          "ja": "じゃあ、明日の一時までに教えてくれる？それから友達にも返事する。",
          "vi": "Vậy trước một giờ chiều mai anh báo em nhé? Rồi em mới trả lời bạn."
        },
        {
          "id": "7522c31a-b064-5d7f-a36e-95decb6a463b-u04",
          "speaker_id": "b",
          "ja": "うん。分かったらすぐ連絡するよ。",
          "vi": "Ừ. Biết là anh báo ngay."
        }
      ],
      "admin": {
        "source_refs": [
          "family"
        ],
        "specialty_item_ids": [],
