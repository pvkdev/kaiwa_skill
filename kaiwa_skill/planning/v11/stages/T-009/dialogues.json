    {
      "situation_uid": "4608a20f-9d0b-5ef7-9023-e4f103b69f84",
      "event_id": "E04",
      "context_vi": "Sau khi bàn với Haru, bạn gọi báo bố phương án chung: Chủ nhật này thăm nhà Haru và gọi bố lúc tám giờ tối; Chủ nhật sau thăm bố mẹ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bố",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4608a20f-9d0b-5ef7-9023-e4f103b69f84-u01",
          "speaker_id": "a",
          "ja": "ハルと相談したよ。今週の日曜は昼にハルの家族に会って、夜八時にお父さんたちとビデオ通話する。来週の日曜の午後なら、家に伺えるけどどう？",
          "vi": "Con đã bàn với Haru. Chủ nhật này trưa tụi con thăm nhà anh ấy, tối tám giờ gọi video cho bố mẹ. Chiều Chủ nhật tuần sau tụi con đến nhà, bố thấy sao?"
        },
        {
          "id": "4608a20f-9d0b-5ef7-9023-e4f103b69f84-u02",
          "speaker_id": "b",
          "ja": "来週の午後なら、こちらも大丈夫だよ。",
          "vi": "Chiều tuần sau bố mẹ cũng được."
        },
        {
          "id": "4608a20f-9d0b-5ef7-9023-e4f103b69f84-u03",
          "speaker_id": "a",
          "ja": "よかった。今週はビデオ通話、来週は訪問でお願いね。時間はまた前日に確認する。",
          "vi": "Vậy tốt quá. Tuần này mình gọi video, tuần sau con đến nhé. Giờ đến cụ thể con xác nhận lại hôm trước."
        },
        {
          "id": "4608a20f-9d0b-5ef7-9023-e4f103b69f84-u04",
          "speaker_id": "b",
          "ja": "分かった。二人とも無理せずに来てね。",
          "vi": "Được. Hai đứa đừng vội quá nhé."
        }
      ],
