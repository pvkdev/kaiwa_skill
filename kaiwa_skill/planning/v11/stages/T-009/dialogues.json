    {
      "situation_uid": "135d4794-ee64-58a9-ae53-e4789ad36aa9",
      "event_id": "E03",
      "context_vi": "Bạn đi làm xa trong ngày và biết sẽ về muộn. Bạn báo Haru giờ dự kiến về, nói rõ đó là dự kiến.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "135d4794-ee64-58a9-ae53-e4789ad36aa9-u01",
          "speaker_id": "a",
          "ja": "今日は仕事が長引いて、帰るのは九時ごろになりそう。遅くなってごめんね。",
          "vi": "Hôm nay công việc kéo dài, chắc khoảng chín giờ em mới về. Xin lỗi vì muộn nhé."
        },
        {
          "id": "135d4794-ee64-58a9-ae53-e4789ad36aa9-u02",
          "speaker_id": "b",
          "ja": "分かった。夕飯は先に食べておこうか。",
          "vi": "Anh hiểu. Anh ăn tối trước nhé?"
        },
        {
          "id": "135d4794-ee64-58a9-ae53-e4789ad36aa9-u03",
          "speaker_id": "a",
          "ja": "うん、先に食べて。時間が変わったらまた連絡する。",
          "vi": "Ừ, anh ăn trước đi. Nếu giờ đổi em sẽ báo lại."
        },
        {
          "id": "135d4794-ee64-58a9-ae53-e4789ad36aa9-u04",
          "speaker_id": "b",
          "ja": "気をつけて帰ってね。",
          "vi": "Em về cẩn thận nhé."
        }
      ],
      "admin": {
