    {
      "situation_uid": "b280baab-997c-5549-8bc6-72b6120f0505",
      "event_id": "E02",
      "context_vi": "Hai người xem lại chi phí sinh hoạt tháng này thấy tăng. Bạn hỏi Haru nên ưu tiên khoản nào, không tự kết luận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đời",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b280baab-997c-5549-8bc6-72b6120f0505-u01",
          "speaker_id": "a",
          "ja": "今月は食費と交通費が少し増えたね。どちらから見直したい？",
          "vi": "Tháng này tiền ăn và đi lại đều tăng chút. Anh muốn xem lại khoản nào trước?"
        },
        {
          "id": "b280baab-997c-5549-8bc6-72b6120f0505-u02",
          "speaker_id": "b",
          "ja": "まず食費かな。外で食べた日が多かったから。",
          "vi": "Chắc tiền ăn trước. Mình ăn ngoài nhiều ngày quá."
        },
        {
          "id": "b280baab-997c-5549-8bc6-72b6120f0505-u03",
          "speaker_id": "a",
          "ja": "そうだね。無理に全部減らすより、どの日に外食したか一緒に見よう。",
          "vi": "Đúng. Thay vì cố cắt hết, mình cùng xem những hôm nào đã ăn ngoài nhé."
        },
        {
          "id": "b280baab-997c-5549-8bc6-72b6120f0505-u04",
          "speaker_id": "b",
          "ja": "うん。予定と合わせて考えたい。",
          "vi": "Ừ. Anh muốn đối chiếu với lịch hôm đó nữa."
        }
      ],
      "admin": {
