  "dialogues": [
    {
      "situation_uid": "76d385f5-ea8a-5523-a290-2f3a7ef50081",
      "event_id": "E01",
      "context_vi": "Ngày đầu tại công ty Aoba hư cấu, bạn là nhân viên nữ tên Linh, bắt đầu hôm nay ở phòng kinh doanh. Bạn tới quầy và nói tên.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên lễ tân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "76d385f5-ea8a-5523-a290-2f3a7ef50081-u01",
          "speaker_id": "a",
          "ja": "おはようございます。今日から営業部で働くリンです。",
          "vi": "Chào buổi sáng. Tôi là Linh, bắt đầu làm ở phòng kinh doanh từ hôm nay."
        },
        {
          "id": "76d385f5-ea8a-5523-a290-2f3a7ef50081-u02",
          "speaker_id": "b",
          "ja": "おはようございます。リンさんですね。担当の方を呼びます。",
          "vi": "Chào buổi sáng. Chị Linh nhỉ. Tôi sẽ gọi người phụ trách."
        },
        {
          "id": "76d385f5-ea8a-5523-a290-2f3a7ef50081-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "intro",
          "reception"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "76d385f5-ea8a-5523-a290-2f3a7ef50081-u01": {
