      ],
      "turns": [
        {
          "id": "e1d9369f-f76f-5a16-bb32-80515e83dc1e-u01",
          "speaker_id": "a",
          "ja": "私の席はどこですか。今日は何を使いますか。",
          "vi": "Chỗ ngồi của tôi ở đâu ạ? Hôm nay cần dùng gì?"
        },
        {
          "id": "e1d9369f-f76f-5a16-bb32-80515e83dc1e-u02",
          "speaker_id": "b",
          "ja": "窓のそばの席です。今日はこのノートを使います。",
          "vi": "Bàn cạnh cửa sổ. Hôm nay dùng quyển sổ này."
        },
        {
          "id": "e1d9369f-f76f-5a16-bb32-80515e83dc1e-u03",
          "speaker_id": "a",
          "ja": "窓のそばですね。ありがとうございます。",
          "vi": "Cạnh cửa sổ nhỉ. Cảm ơn anh."
        }
      ],
