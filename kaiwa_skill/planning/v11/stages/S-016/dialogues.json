          }
        }
      }
    },
    {
      "situation_uid": "0b828fa5-0b09-503a-87a1-aaf7c3d1d531",
      "event_id": "E02",
      "context_vi": "Giờ gần trưa ở Aoba, đồng nghiệp nam rủ Linh ăn cùng lúc 12 giờ. Linh nhận lời và hỏi giờ để gặp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0b828fa5-0b09-503a-87a1-aaf7c3d1d531-u01",
          "speaker_id": "b",
          "ja": "今日、一緒に昼ごはんを食べませんか。",
          "vi": "Hôm nay chị ăn trưa cùng tôi nhé?"
        },
        {
          "id": "0b828fa5-0b09-503a-87a1-aaf7c3d1d531-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。何時に行きますか。",
          "vi": "Cảm ơn anh. Mấy giờ mình đi ạ?"
        },
        {
          "id": "0b828fa5-0b09-503a-87a1-aaf7c3d1d531-u03",
          "speaker_id": "b",
          "ja": "十二時に入口で会いましょう。",
          "vi": "12 giờ gặp ở cửa ra vào nhé."
        },
        {
          "id": "0b828fa5-0b09-503a-87a1-aaf7c3d1d531-u04",
          "speaker_id": "a",
          "ja": "はい、十二時ですね。",
          "vi": "Vâng, 12 giờ nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0b828fa5-0b09-503a-87a1-aaf7c3d1d531-u01": {
