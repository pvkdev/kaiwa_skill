        }
      }
    },
    {
      "situation_uid": "57b28fe4-f9ab-5b17-9083-ff15353db962",
      "event_id": "E02",
      "context_vi": "Một đồng nghiệp nam ở Aoba nghe tên Linh thành Lan khi cô giới thiệu. Linh nói rõ cách phát âm để anh ấy ghi đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "57b28fe4-f9ab-5b17-9083-ff15353db962-u01",
          "speaker_id": "b",
          "ja": "ランさん、でいいですか。",
          "vi": "Tên chị đọc là Ran đúng không?"
        },
        {
          "id": "57b28fe4-f9ab-5b17-9083-ff15353db962-u02",
          "speaker_id": "a",
          "ja": "いいえ、リンです。名前はベトナム語で「Linh」と書きます。",
          "vi": "Không, tiếng Nhật đọc là Rin. Tên tôi viết bằng tiếng Việt là “Linh”."
        },
        {
          "id": "57b28fe4-f9ab-5b17-9083-ff15353db962-u03",
          "speaker_id": "b",
          "ja": "わかりました。リンさんですね。",
          "vi": "Tôi hiểu. Chị Rin nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "57b28fe4-f9ab-5b17-9083-ff15353db962-u01": {
