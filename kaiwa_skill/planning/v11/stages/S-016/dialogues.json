            "kind": "original_extension"
          },
          "6bcfacf9-9645-51ef-bf32-2d07bc39587d-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "9865436f-41ea-5b99-b18f-e862840a2038",
      "event_id": "E02",
      "context_vi": "Tại phòng họp công ty Aoba hư cấu, Linh ra mắt đội kinh doanh. Trước đây cô từng làm một năm ở cửa hàng; cô nói gọn vai và kinh nghiệm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9865436f-41ea-5b99-b18f-e862840a2038-u01",
          "speaker_id": "b",
          "ja": "では、リンさん、お願いします。",
          "vi": "Vậy, mời chị Linh giới thiệu."
        },
        {
          "id": "9865436f-41ea-5b99-b18f-e862840a2038-u02",
          "speaker_id": "a",
          "ja": "今日から営業部で働くリンです。前は店で一年働きました。よろしくお願いします。",
          "vi": "Tôi là Linh, từ hôm nay làm ở phòng kinh doanh. Trước đây tôi làm ở cửa hàng một năm. Mong mọi người giúp đỡ."
        },
        {
          "id": "9865436f-41ea-5b99-b18f-e862840a2038-u03",
          "speaker_id": "b",
          "ja": "こちらこそ、よろしくお願いします。",
          "vi": "Chúng tôi cũng mong được làm việc cùng chị."
        }
      ],
      "admin": {
        "source_refs": [
          "intro",
          "join"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9865436f-41ea-5b99-b18f-e862840a2038-u01": {
            "kind": "original_extension"
          },
          "9865436f-41ea-5b99-b18f-e862840a2038-u02": {
            "kind": "original_extension"
          },
          "9865436f-41ea-5b99-b18f-e862840a2038-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "01966839-b751-5aee-9455-11ff33c84ddb",
      "event_id": "E02",
      "context_vi": "Sau buổi ra mắt ở Aoba, Linh gặp người hướng dẫn trực tiếp là Mori nhưng không chắc nên gọi thế nào. Cô hỏi và được trả lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "01966839-b751-5aee-9455-11ff33c84ddb-u01",
          "speaker_id": "a",
          "ja": "これから、何とお呼びすればいいですか。",
          "vi": "Từ giờ tôi nên gọi anh thế nào ạ?"
        },
        {
          "id": "01966839-b751-5aee-9455-11ff33c84ddb-u02",
          "speaker_id": "b",
          "ja": "森でいいですよ。リンさん、よろしくお願いします。",
          "vi": "Cứ gọi tôi là Mori. Chị Linh, rất mong được làm việc cùng chị."
        },
        {
          "id": "01966839-b751-5aee-9455-11ff33c84ddb-u03",
          "speaker_id": "a",
          "ja": "森さん、よろしくお願いします。",
          "vi": "Anh Mori, mong anh giúp đỡ."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "01966839-b751-5aee-9455-11ff33c84ddb-u01": {
