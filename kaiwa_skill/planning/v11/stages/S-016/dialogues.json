    {
      "situation_uid": "d0dd50cd-3bca-5210-91ad-04cd41913155",
      "event_id": "E02",
      "context_vi": "Tiếp lời hẹn ăn trưa lúc 12 giờ: Mori vừa báo Linh có buổi hướng dẫn trùng giờ. Linh nói với đúng đồng nghiệp đã mời và hẹn dịp khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d0dd50cd-3bca-5210-91ad-04cd41913155-u01",
          "speaker_id": "a",
          "ja": "すみません。十二時に説明があります。今日は一緒に昼ごはんに行けません。",
          "vi": "Xin lỗi. 12 giờ tôi có buổi hướng dẫn. Hôm nay tôi không đi ăn cùng được."
        },
        {
          "id": "d0dd50cd-3bca-5210-91ad-04cd41913155-u02",
          "speaker_id": "b",
          "ja": "そうですか。また今度行きましょう。",
          "vi": "Vậy à. Để hôm khác mình đi."
        },
        {
          "id": "d0dd50cd-3bca-5210-91ad-04cd41913155-u03",
          "speaker_id": "a",
