      ],
      "turns": [
        {
          "id": "ed91cba5-ed6b-5643-b2ba-eeeba9d9c3c3-u01",
          "speaker_id": "b",
          "ja": "十時に安全の説明、十一時に仕事の説明があります。",
          "vi": "10 giờ có hướng dẫn an toàn, 11 giờ có hướng dẫn công việc."
        },
        {
          "id": "ed91cba5-ed6b-5643-b2ba-eeeba9d9c3c3-u02",
          "speaker_id": "a",
          "ja": "先に安全、そのあと仕事の説明ですね。",
          "vi": "Trước là an toàn, sau đó là hướng dẫn công việc nhỉ."
        },
        {
          "id": "ed91cba5-ed6b-5643-b2ba-eeeba9d9c3c3-u03",
          "speaker_id": "b",
          "ja": "はい、その順番です。",
          "vi": "Đúng, theo thứ tự đó."
        }
      ],
