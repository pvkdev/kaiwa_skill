    {
      "situation_uid": "ed91cba5-ed6b-5643-b2ba-eeeba9d9c3c3",
      "event_id": "E03",
      "context_vi": "Mori giải thích lịch hư cấu cho Linh: đầu tiên hướng dẫn an toàn lúc 10 giờ, sau đó hướng dẫn công việc lúc 11 giờ. Linh hỏi lại thứ tự.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
