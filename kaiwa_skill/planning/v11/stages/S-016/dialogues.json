            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "c97fcf7b-552f-53c3-8d71-b75464d0efd7",
      "event_id": "E01",
      "context_vi": "Tiếp ngay sau khi Linh báo tên ở quầy Aoba. Người hướng dẫn nam Mori chưa đến, nên Linh hỏi nhân viên lễ tân nên đợi ở đâu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên lễ tân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c97fcf7b-552f-53c3-8d71-b75464d0efd7-u01",
          "speaker_id": "b",
          "ja": "森さんはまだ来ていません。",
          "vi": "Anh Mori chưa tới."
        },
        {
          "id": "c97fcf7b-552f-53c3-8d71-b75464d0efd7-u02",
          "speaker_id": "a",
          "ja": "どちらで待てばいいですか。",
          "vi": "Tôi nên đợi ở đâu ạ?"
        },
        {
          "id": "c97fcf7b-552f-53c3-8d71-b75464d0efd7-u03",
          "speaker_id": "b",
          "ja": "こちらのいすでお待ちください。",
          "vi": "Chị vui lòng đợi ở ghế bên này."
        },
        {
          "id": "c97fcf7b-552f-53c3-8d71-b75464d0efd7-u04",
          "speaker_id": "a",
          "ja": "わかりました。",
          "vi": "Tôi hiểu rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "reception"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c97fcf7b-552f-53c3-8d71-b75464d0efd7-u01": {
            "kind": "original_extension"
          },
          "c97fcf7b-552f-53c3-8d71-b75464d0efd7-u02": {
