      "event_id": "E03",
      "context_vi": "Tại bàn làm việc Aoba hư cấu, Linh hỏi Mori vị trí ngồi và vật cần dùng hôm nay. Mori chỉ bàn cạnh cửa sổ và sổ ghi chép.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn Mori",
          "gender": "male"
