          "38419a51-d520-5b91-a5b6-e6a702563bde-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "6bcfacf9-9645-51ef-bf32-2d07bc39587d",
      "event_id": "E01",
      "context_vi": "Tiếp sau nhánh Linh đang đợi tại quầy: Mori nam, người hướng dẫn, vừa tới và nói lịch đầu tiên là gặp đội ở phòng họp lúc 9 giờ. Linh xác nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6bcfacf9-9645-51ef-bf32-2d07bc39587d-u01",
          "speaker_id": "b",
          "ja": "リンさん、お待たせしました。九時に会議室でチームに会います。",
          "vi": "Chị Linh, xin lỗi đã để chị chờ. Lúc 9 giờ mình gặp cả đội ở phòng họp."
        },
        {
          "id": "6bcfacf9-9645-51ef-bf32-2d07bc39587d-u02",
          "speaker_id": "a",
          "ja": "九時に会議室ですね。森さんと一緒に行きますか。",
          "vi": "9 giờ ở phòng họp nhỉ. Tôi đi cùng anh Mori phải không ạ?"
        },
        {
          "id": "6bcfacf9-9645-51ef-bf32-2d07bc39587d-u03",
          "speaker_id": "b",
          "ja": "はい。一緒に行きましょう。",
          "vi": "Đúng. Mình cùng đi."
        }
      ],
      "admin": {
        "source_refs": [
          "join",
          "reception"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "6bcfacf9-9645-51ef-bf32-2d07bc39587d-u01": {
            "kind": "original_extension"
          },
