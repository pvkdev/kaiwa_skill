          },
          "c97fcf7b-552f-53c3-8d71-b75464d0efd7-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "38419a51-d520-5b91-a5b6-e6a702563bde",
      "event_id": "E01",
      "context_vi": "Một nhánh khác ngay sau khi Linh báo tên ngày đầu: tòa nhà có công ty Aoba và Aoba Service hư cấu. Lễ tân tra nhầm lịch Aoba Service nên không thấy tên Linh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên lễ tân",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "38419a51-d520-5b91-a5b6-e6a702563bde-u01",
          "speaker_id": "b",
          "ja": "あれ、リンさんのお名前がありません。青葉サービスの予定を見ています。",
          "vi": "Ồ, không có tên chị Linh. Tôi đang xem lịch của Aoba Service."
        },
        {
          "id": "38419a51-d520-5b91-a5b6-e6a702563bde-u02",
          "speaker_id": "a",
          "ja": "私は青葉の営業部です。サービスのほうではありません。",
          "vi": "Tôi ở phòng kinh doanh Công ty Aoba, không phải bên Service."
        },
        {
          "id": "38419a51-d520-5b91-a5b6-e6a702563bde-u03",
          "speaker_id": "b",
          "ja": "失礼しました。青葉の予定を見ますね。",
          "vi": "Tôi xin lỗi. Để tôi xem lịch Công ty Aoba."
        }
      ],
      "admin": {
        "source_refs": [
          "reception"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "38419a51-d520-5b91-a5b6-e6a702563bde-u01": {
            "kind": "original_extension"
          },
