    {
      "situation_uid": "d50ca2ad-63ca-51bc-8b22-0ddd4bd39455",
      "event_id": "E03",
      "context_vi": "Đồng nghiệp đã trở lại và xác nhận đơn đặt trước có thể nhận lúc 3 giờ. Bạn báo khách bằng lời đơn giản.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d50ca2ad-63ca-51bc-8b22-0ddd4bd39455-u01",
          "speaker_id": "a",
          "ja": "確認できました。ご予約の商品は午後三時にお渡しできます。",
          "vi": "Tôi đã kiểm tra xong. Món anh đặt có thể nhận lúc 3 giờ chiều."
        },
        {
          "id": "d50ca2ad-63ca-51bc-8b22-0ddd4bd39455-u02",
          "speaker_id": "b",
          "ja": "三時ですね。分かりました。",
          "vi": "3 giờ chiều. Tôi hiểu rồi."
        }
      ],
      "admin": {
