    {
      "situation_uid": "f7e7002c-f7ba-53a4-bc91-0a86923abdbd",
      "event_id": "E03",
      "context_vi": "Khách hỏi giờ nhận hàng đặt trước, nhưng bạn mới vào quầy và không biết lịch. Bạn xin phép hỏi đồng nghiệp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f7e7002c-f7ba-53a4-bc91-0a86923abdbd-u01",
          "speaker_id": "b",
          "ja": "予約した商品は何時に受け取れますか。",
          "vi": "Món tôi đặt trước có thể nhận lúc mấy giờ?"
        },
        {
          "id": "f7e7002c-f7ba-53a4-bc91-0a86923abdbd-u02",
          "speaker_id": "a",
          "ja": "すみません。時間を確認します。同僚に聞いてもよろしいですか。",
          "vi": "Xin lỗi, tôi cần kiểm tra giờ. Tôi hỏi đồng nghiệp rồi trả lời anh được không ạ?"
        },
        {
          "id": "f7e7002c-f7ba-53a4-bc91-0a86923abdbd-u03",
          "speaker_id": "b",
          "ja": "はい、お願いします。",
          "vi": "Được, nhờ bạn."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
