    {
      "situation_uid": "5eb0e579-9e65-58f0-80fa-7fd8448e1c87",
      "event_id": "E02",
      "context_vi": "Người phụ trách đã làm máy hoạt động lại sau lỗi. Khách vừa chạm thẻ; bạn xác nhận giao dịch 500 yên đã thành công.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5eb0e579-9e65-58f0-80fa-7fd8448e1c87-u01",
          "speaker_id": "a",
          "ja": "お待たせしました。五百円のお支払いが完了しました。こちらがレシートです。",
          "vi": "Xin lỗi đã để anh chờ. Giao dịch 500 yên đã thành công. Đây là hóa đơn của anh."
        },
        {
          "id": "5eb0e579-9e65-58f0-80fa-7fd8448e1c87-u02",
          "speaker_id": "b",
          "ja": "はい、ありがとうございます。",
          "vi": "Vâng, cảm ơn."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
