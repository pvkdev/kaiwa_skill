    {
      "situation_uid": "bf2f688b-4c98-5c92-ae68-6d679e1f8fd3",
      "event_id": "E02",
      "context_vi": "Tại quầy, hai món có tổng 500 yên. Bạn nói tổng và phương thức thanh toán mà cửa hàng đang nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bf2f688b-4c98-5c92-ae68-6d679e1f8fd3-u01",
          "speaker_id": "a",
          "ja": "合計五百円です。現金かカードでお支払いいただけます。",
          "vi": "Tổng cộng 500 yên. Quầy nhận tiền mặt hoặc thẻ ạ."
        },
        {
          "id": "bf2f688b-4c98-5c92-ae68-6d679e1f8fd3-u02",
          "speaker_id": "b",
          "ja": "カードでお願いします。",
          "vi": "Tôi trả bằng thẻ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "bf2f688b-4c98-5c92-ae68-6d679e1f8fd3-u01": {
            "kind": "original_extension"
          },
          "bf2f688b-4c98-5c92-ae68-6d679e1f8fd3-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "a3d83910-1617-506b-acd1-9ea0c52bb055",
      "event_id": "E02",
      "context_vi": "Khách chọn trả 500 yên bằng thẻ, nhưng máy hiện lỗi không nhận giao dịch. Bạn xin khách chờ và gọi người phụ trách.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a3d83910-1617-506b-acd1-9ea0c52bb055-u01",
          "speaker_id": "a",
          "ja": "すみません。機械が今、カードを読み取れません。担当者を呼びますので、少しお待ちください。",
          "vi": "Xin lỗi, lúc này máy không đọc được thẻ. Tôi sẽ gọi người phụ trách, xin anh chờ một chút."
        },
        {
          "id": "a3d83910-1617-506b-acd1-9ea0c52bb055-u02",
          "speaker_id": "b",
          "ja": "分かりました。ここで待ちます。",
          "vi": "Được. Tôi chờ ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a3d83910-1617-506b-acd1-9ea0c52bb055-u01": {
