      "path": "kaiwa_skill/knowledge/すぐに使える 接客日本語会話大特訓［英語版］決まり文句700/chapters/05-ch4-konbini.md",
      "start_line": 8,
      "end_line": 35,
      "use_vi": "Lời nhân viên quầy hỏi túi, tổng tiền, nhận tiền và đưa hóa đơn."
    }
  },
  "dialogues": [
    {
      "situation_uid": "b672ace7-615c-57fe-9cbe-8dd637728b84",
      "event_id": "E01",
      "context_vi": "Bạn đang trực quầy đồ uống. Khách chỉ vào ảnh sản phẩm; bạn hỏi đúng món, cỡ và số lượng trước khi nhập đơn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b672ace7-615c-57fe-9cbe-8dd637728b84-u01",
          "speaker_id": "a",
          "ja": "こちらのコーヒーですか。大きさと数を教えてください。",
          "vi": "Anh muốn cà phê trong hình này phải không ạ? Cho tôi biết cỡ và số ly."
        },
        {
          "id": "b672ace7-615c-57fe-9cbe-8dd637728b84-u02",
          "speaker_id": "b",
          "ja": "はい。大きいサイズを二つください。",
          "vi": "Đúng. Cho tôi hai ly cỡ lớn."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b672ace7-615c-57fe-9cbe-8dd637728b84-u01": {
            "kind": "original_extension"
          },
          "b672ace7-615c-57fe-9cbe-8dd637728b84-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "76c6ca40-6573-5084-ade6-5ee089fe2ac3",
      "event_id": "E01",
      "context_vi": "Khách vừa gọi hai ly cà phê cỡ lớn. Bạn nghe nhầm thành cỡ vừa; khách sửa và bạn xác nhận lại trước khi nhập.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "76c6ca40-6573-5084-ade6-5ee089fe2ac3-u01",
          "speaker_id": "a",
          "ja": "普通のサイズを二つですね。",
          "vi": "Hai ly cỡ vừa phải không ạ?"
        },
        {
          "id": "76c6ca40-6573-5084-ade6-5ee089fe2ac3-u02",
          "speaker_id": "b",
          "ja": "いいえ、大きいサイズを二つです。",
          "vi": "Không, hai ly cỡ lớn."
        },
        {
          "id": "76c6ca40-6573-5084-ade6-5ee089fe2ac3-u03",
          "speaker_id": "a",
          "ja": "失礼しました。大きいサイズを二つですね。",
          "vi": "Xin lỗi tôi nghe nhầm. Hai ly cỡ lớn ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
