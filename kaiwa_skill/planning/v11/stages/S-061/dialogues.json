    {
      "situation_uid": "1983b040-e90a-55e6-8027-0303ff26cbf5",
      "event_id": "E03",
      "context_vi": "Đồng nghiệp phụ trách đơn đặt trước chưa có ở quầy. Bạn báo tình hình và hỏi khách có thể chờ ở ghế cạnh quầy không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1983b040-e90a-55e6-8027-0303ff26cbf5-u01",
          "speaker_id": "a",
          "ja": "担当の者が今、席を外しています。こちらの椅子で少しお待ちいただけますか。",
          "vi": "Người phụ trách hiện không có ở quầy. Anh có thể ngồi chờ một chút ở ghế này không ạ?"
        },
        {
          "id": "1983b040-e90a-55e6-8027-0303ff26cbf5-u02",
          "speaker_id": "b",
          "ja": "はい、ここで待ちます。",
          "vi": "Được, tôi chờ ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
