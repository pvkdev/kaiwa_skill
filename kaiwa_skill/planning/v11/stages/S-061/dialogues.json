        }
      }
    },
    {
      "situation_uid": "bf2f688b-4c98-5c92-ae68-6d679e1f8fd3",
      "event_id": "E02",
      "context_vi": "Tại quầy, hai món có tổng 500 yên. Bạn nói tổng và phương thức thanh toán mà cửa hàng đang nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bf2f688b-4c98-5c92-ae68-6d679e1f8fd3-u01",
          "speaker_id": "a",
          "ja": "合計五百円です。現金かカードでお支払いいただけます。",
          "vi": "Tổng cộng 500 yên. Quầy nhận tiền mặt hoặc thẻ ạ."
        },
        {
          "id": "bf2f688b-4c98-5c92-ae68-6d679e1f8fd3-u02",
          "speaker_id": "b",
          "ja": "カードでお願いします。",
          "vi": "Tôi trả bằng thẻ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "bf2f688b-4c98-5c92-ae68-6d679e1f8fd3-u01": {
            "kind": "original_extension"
          },
          "bf2f688b-4c98-5c92-ae68-6d679e1f8fd3-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "a3d83910-1617-506b-acd1-9ea0c52bb055",
      "event_id": "E02",
      "context_vi": "Khách chọn trả 500 yên bằng thẻ. Máy hiện lỗi và bạn đã kiểm rằng giao dịch chưa hoàn tất. Bạn báo khách và xin chờ người phụ trách.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a3d83910-1617-506b-acd1-9ea0c52bb055-u01",
          "speaker_id": "a",
          "ja": "すみません。機械にエラーが出て、お支払いがまだできていません。担当者を呼びますので、少々お待ちください。",
          "vi": "Xin lỗi anh, máy báo lỗi nên giao dịch chưa hoàn tất. Để tôi gọi người phụ trách, anh chờ một chút ạ."
        },
        {
          "id": "a3d83910-1617-506b-acd1-9ea0c52bb055-u02",
          "speaker_id": "b",
          "ja": "分かりました。ここで待ちます。",
          "vi": "Được. Tôi chờ ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a3d83910-1617-506b-acd1-9ea0c52bb055-u01": {
            "kind": "original_extension"
          },
          "a3d83910-1617-506b-acd1-9ea0c52bb055-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "002073cd-9237-501d-9be3-00188d10e0f0",
      "event_id": "E02",
      "context_vi": "Khách mua hai món nhỏ, bạn hỏi họ có cần túi không rồi xác nhận lựa chọn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "002073cd-9237-501d-9be3-00188d10e0f0-u01",
          "speaker_id": "a",
          "ja": "袋はご利用ですか。",
          "vi": "Anh có cần túi không ạ?"
        },
        {
          "id": "002073cd-9237-501d-9be3-00188d10e0f0-u02",
          "speaker_id": "b",
          "ja": "いいえ、このままで大丈夫です。",
          "vi": "Không, để vậy được rồi."
        },
        {
          "id": "002073cd-9237-501d-9be3-00188d10e0f0-u03",
          "speaker_id": "a",
          "ja": "かしこまりました。このままお渡しします。",
          "vi": "Vâng, tôi gửi anh luôn, không cần túi ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
