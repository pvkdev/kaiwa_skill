          },
          "a3d83910-1617-506b-acd1-9ea0c52bb055-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "002073cd-9237-501d-9be3-00188d10e0f0",
      "event_id": "E02",
      "context_vi": "Khách mua hai món nhỏ, bạn hỏi họ có cần túi không rồi xác nhận lựa chọn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "002073cd-9237-501d-9be3-00188d10e0f0-u01",
          "speaker_id": "a",
          "ja": "袋はご利用ですか。",
          "vi": "Anh có cần túi không ạ?"
        },
        {
          "id": "002073cd-9237-501d-9be3-00188d10e0f0-u02",
          "speaker_id": "b",
          "ja": "いいえ、このままで大丈夫です。",
          "vi": "Không, để vậy được rồi."
        },
        {
          "id": "002073cd-9237-501d-9be3-00188d10e0f0-u03",
          "speaker_id": "a",
          "ja": "かしこまりました。このままお渡しします。",
          "vi": "Vâng. Tôi sẽ đưa nguyên như vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
