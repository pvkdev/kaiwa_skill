        }
      }
    },
    {
      "situation_uid": "c84860fa-b3ee-5fcc-8cbc-42137c7d61c4",
      "event_id": "E01",
      "context_vi": "Khách đã hỏi hai ly cà phê cỡ lớn. Món hiện có, bạn chỉ khu nhận sau khi thanh toán.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c84860fa-b3ee-5fcc-8cbc-42137c7d61c4-u01",
          "speaker_id": "a",
          "ja": "大きいコーヒーはございます。お支払いのあと、右の受け取り口へどうぞ。",
          "vi": "Cà phê cỡ lớn hiện có. Sau khi thanh toán, mời anh đến quầy nhận bên phải."
        },
        {
          "id": "c84860fa-b3ee-5fcc-8cbc-42137c7d61c4-u02",
          "speaker_id": "b",
          "ja": "右の受け取り口ですね。",
          "vi": "Quầy nhận bên phải, đúng không ạ?"
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c84860fa-b3ee-5fcc-8cbc-42137c7d61c4-u01": {
            "kind": "original_extension"
          },
          "c84860fa-b3ee-5fcc-8cbc-42137c7d61c4-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7e8d072c-7f18-5e26-b8ad-f5aeaf8a2dd5",
      "event_id": "E01",
      "context_vi": "Khách vừa gọi hai ly cà phê cỡ lớn nhưng quầy đã hết cỡ lớn. Bạn hỏi khách có muốn cỡ vừa không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học: nhân viên quầy",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "khách hàng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7e8d072c-7f18-5e26-b8ad-f5aeaf8a2dd5-u01",
          "speaker_id": "a",
          "ja": "すみません。大きいサイズは今ありません。普通のサイズならありますが、いかがですか。",
          "vi": "Xin lỗi, hiện quầy hết cỡ lớn. Cỡ vừa vẫn còn, anh có muốn đổi không ạ?"
        },
        {
          "id": "7e8d072c-7f18-5e26-b8ad-f5aeaf8a2dd5-u02",
          "speaker_id": "b",
          "ja": "では、普通のサイズを二つください。",
          "vi": "Vậy cho tôi hai ly cỡ vừa."
        },
        {
          "id": "7e8d072c-7f18-5e26-b8ad-f5aeaf8a2dd5-u03",
          "speaker_id": "a",
          "ja": "普通のサイズを二つですね。",
          "vi": "Hai ly cỡ vừa ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
