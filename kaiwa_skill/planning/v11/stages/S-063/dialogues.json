    {
      "situation_uid": "df77a954-1ae4-5077-9681-cb1f217520f0",
      "event_id": "E03",
      "context_vi": "Sau khi hai đồng nghiệp hiểu khác nhau về người gửi lịch, bạn đã hỏi người chủ trì. Anh ấy vừa xem lại ghi chú và cho bạn biết ai làm gì.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chủ trì",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "df77a954-1ae4-5077-9681-cb1f217520f0-u01",
          "speaker_id": "B",
          "ja": "ランさんが送ってください。その前に、森さんに見てもらってください。",
          "vi": "Chị Lan gửi giúp tôi nhé. Trước khi gửi, chị nhờ anh Mori xem qua."
        },
        {
          "id": "df77a954-1ae4-5077-9681-cb1f217520f0-u02",
          "speaker_id": "A",
          "ja": "わかりました。いつまでですか。",
          "vi": "Tôi hiểu rồi. Hạn gửi là khi nào ạ?"
        },
        {
          "id": "df77a954-1ae4-5077-9681-cb1f217520f0-u03",
          "speaker_id": "B",
          "ja": "金曜日までにお願いします。",
          "vi": "Chị gửi chậm nhất vào thứ Sáu nhé."
        },
        {
          "id": "df77a954-1ae4-5077-9681-cb1f217520f0-u04",
          "speaker_id": "A",
          "ja": "金曜日までですね。森さんに見てもらってから、私が送ります。",
          "vi": "Chậm nhất thứ Sáu ạ. Tôi sẽ nhờ anh Mori xem trước rồi tôi gửi."
        }
      ],
