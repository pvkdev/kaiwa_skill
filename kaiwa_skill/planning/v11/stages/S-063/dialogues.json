    {
      "situation_uid": "7c1dd762-b55d-543e-aa81-603ac86730a4",
      "event_id": "E02",
      "context_vi": "Trong buổi họp chuẩn bị đón khách, bạn muốn thêm sơ đồ đường từ cổng đến phòng họp vào tờ hướng dẫn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chủ trì",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7c1dd762-b55d-543e-aa81-603ac86730a4-u01",
          "speaker_id": "A",
          "ja": "すみません。ちょっといいですか。",
          "vi": "Cho tôi nói một chút được không ạ?"
        },
        {
          "id": "7c1dd762-b55d-543e-aa81-603ac86730a4-u02",
          "speaker_id": "B",
          "ja": "はい、どうぞ。",
          "vi": "Vâng, chị nói đi."
        },
        {
          "id": "7c1dd762-b55d-543e-aa81-603ac86730a4-u03",
          "speaker_id": "A",
          "ja": "案内に地図を入れませんか。",
          "vi": "Mình thêm sơ đồ vào tờ hướng dẫn được không ạ?"
        },
        {
          "id": "7c1dd762-b55d-543e-aa81-603ac86730a4-u04",
          "speaker_id": "B",
          "ja": "どこの地図ですか。",
          "vi": "Sơ đồ chỗ nào vậy?"
        },
        {
          "id": "7c1dd762-b55d-543e-aa81-603ac86730a4-u05",
          "speaker_id": "A",
          "ja": "入口から会議室までです。初めて来る方にわかりやすいです。",
          "vi": "Từ cổng đến phòng họp ạ. Khách lần đầu đến sẽ dễ tìm đường hơn."
        },
        {
          "id": "7c1dd762-b55d-543e-aa81-603ac86730a4-u06",
          "speaker_id": "B",
          "ja": "なるほど。ありがとうございます。",
          "vi": "Tôi hiểu ý chị rồi. Cảm ơn chị."
        }
      ],
      "admin": {
        "source_refs": [
          "permission"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7c1dd762-b55d-543e-aa81-603ac86730a4-u01": {
