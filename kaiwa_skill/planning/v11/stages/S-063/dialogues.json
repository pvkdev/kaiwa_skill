          }
        }
      }
    },
    {
      "situation_uid": "20ab75be-a22d-5916-81b4-7f0794ecd5de",
      "event_id": "E01",
      "context_vi": "Bạn vừa được giải thích PDF là một loại tệp giữ nguyên bố cục trang. Bạn muốn nhắc lại lời dặn và kiểm xem có cần gửi cả bản Word không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chủ trì",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "20ab75be-a22d-5916-81b4-7f0794ecd5de-u01",
          "speaker_id": "A",
          "ja": "ＰＤＦだと、スマホでも同じ形で見られるんですね。",
          "vi": "Vậy với PDF thì xem trên điện thoại vẫn giữ nguyên bố cục ạ?"
        },
        {
          "id": "20ab75be-a22d-5916-81b4-7f0794ecd5de-u02",
          "speaker_id": "B",
          "ja": "はい、そうです。",
          "vi": "Vâng, đúng rồi."
        },
        {
          "id": "20ab75be-a22d-5916-81b4-7f0794ecd5de-u03",
          "speaker_id": "A",
          "ja": "じゃあ、ワードのファイルも送りますか。",
          "vi": "Vậy tôi có cần gửi cả tệp Word không ạ?"
        },
        {
          "id": "20ab75be-a22d-5916-81b4-7f0794ecd5de-u04",
          "speaker_id": "B",
          "ja": "ＰＤＦだけで大丈夫です。",
          "vi": "Chỉ cần gửi PDF thôi."
        },
        {
          "id": "20ab75be-a22d-5916-81b4-7f0794ecd5de-u05",
          "speaker_id": "A",
          "ja": "わかりました。この資料をＰＤＦで送ります。",
          "vi": "Tôi hiểu rồi. Tôi sẽ gửi tài liệu này dưới dạng PDF."
        }
      ],
      "admin": {
        "source_refs": [
