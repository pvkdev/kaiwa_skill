    {
      "situation_uid": "7172bdb2-6d93-5842-a818-14a1ffe9faa5",
      "event_id": "E02",
      "context_vi": "Bạn vừa đề nghị thêm sơ đồ từ cổng đến phòng họp vào tờ hướng dẫn đón khách. Người chủ trì đồng ý và hai người xác nhận phần việc của bạn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chủ trì",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7172bdb2-6d93-5842-a818-14a1ffe9faa5-u01",
          "speaker_id": "B",
          "ja": "では、地図を入れましょう。お願いできますか。",
          "vi": "Vậy mình thêm sơ đồ nhé. Chị làm giúp được không?"
        },
        {
          "id": "7172bdb2-6d93-5842-a818-14a1ffe9faa5-u02",
          "speaker_id": "A",
          "ja": "はい。最後のページでいいですか。",
          "vi": "Được ạ. Để ở trang cuối được không ạ?"
        },
        {
          "id": "7172bdb2-6d93-5842-a818-14a1ffe9faa5-u03",
          "speaker_id": "B",
          "ja": "ええ、最後のページに入れてください。",
          "vi": "Được. Chị để ở trang cuối nhé."
        },
        {
          "id": "7172bdb2-6d93-5842-a818-14a1ffe9faa5-u04",
          "speaker_id": "A",
          "ja": "では、最後のページに入れて、今日中に送ります。",
          "vi": "Vậy tôi sẽ thêm vào trang cuối rồi gửi trong hôm nay ạ."
        },
        {
          "id": "7172bdb2-6d93-5842-a818-14a1ffe9faa5-u05",
          "speaker_id": "B",
          "ja": "お願いします。",
          "vi": "Nhờ chị nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7172bdb2-6d93-5842-a818-14a1ffe9faa5-u01": {
