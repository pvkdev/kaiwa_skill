      }
    },
    {
      "situation_uid": "a9bd2198-9198-5c9f-9b23-0f17640a1929",
      "event_id": "E01",
      "context_vi": "Trong cuộc họp về việc đón khách, bạn nghe hạn gửi góp ý thành thứ Năm. Chủ trì sắp chuyển sang mục khác nên bạn hỏi ngay.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chủ trì",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a9bd2198-9198-5c9f-9b23-0f17640a1929-u01",
          "speaker_id": "B",
          "ja": "では、次の話に移ります。",
          "vi": "Bây giờ mình sang mục tiếp theo nhé."
        },
        {
          "id": "a9bd2198-9198-5c9f-9b23-0f17640a1929-u02",
          "speaker_id": "A",
          "ja": "すみません。意見を送るのは、木曜日までですか。",
          "vi": "Cho tôi hỏi chút. Hạn gửi góp ý là thứ Năm ạ?"
        },
        {
          "id": "a9bd2198-9198-5c9f-9b23-0f17640a1929-u03",
          "speaker_id": "B",
          "ja": "木曜日じゃなくて、火曜日までです。",
          "vi": "Hạn là thứ Ba, chị ạ."
        },
        {
          "id": "a9bd2198-9198-5c9f-9b23-0f17640a1929-u04",
          "speaker_id": "A",
          "ja": "火曜日ですね。わかりました。",
          "vi": "Thứ Ba ạ. Tôi hiểu rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "mishear",
          "repeat"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a9bd2198-9198-5c9f-9b23-0f17640a1929-u01": {
