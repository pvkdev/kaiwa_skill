          }
        }
      }
    },
    {
      "situation_uid": "9ce734aa-8acc-568b-93d1-fe0a281ac8a2",
      "event_id": "E01",
      "context_vi": "Trong cuộc họp, người chủ trì bảo gửi tài liệu bằng PDF. Bạn chưa biết chữ PDF trong lời dặn có nghĩa gì.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chủ trì",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9ce734aa-8acc-568b-93d1-fe0a281ac8a2-u01",
          "speaker_id": "B",
          "ja": "この資料はＰＤＦで送ってください。",
          "vi": "Chị gửi tài liệu này dưới dạng PDF nhé."
        },
        {
          "id": "9ce734aa-8acc-568b-93d1-fe0a281ac8a2-u02",
          "speaker_id": "A",
          "ja": "すみません。ＰＤＦって何ですか。",
          "vi": "Cho tôi hỏi, PDF là gì ạ?"
        },
        {
          "id": "9ce734aa-8acc-568b-93d1-fe0a281ac8a2-u03",
          "speaker_id": "B",
          "ja": "ファイルの種類です。スマホで見ても、ページの形が変わりません。",
          "vi": "Đó là một loại tệp. Xem trên điện thoại thì bố cục trang vẫn giữ nguyên."
        },
        {
          "id": "9ce734aa-8acc-568b-93d1-fe0a281ac8a2-u04",
          "speaker_id": "A",
          "ja": "ああ、ファイルの種類なんですね。",
          "vi": "À, đó là một loại tệp ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "permission"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9ce734aa-8acc-568b-93d1-fe0a281ac8a2-u01": {
