    {
      "situation_uid": "c4c15f8a-301c-58b9-87d3-5da04b90bcd3",
      "event_id": "E02",
      "context_vi": "Bạn vừa đề nghị thêm sơ đồ vào tờ hướng dẫn đón khách. Người chủ trì cần hỏi xem sơ đồ có vừa trang cuối không trước khi quyết định.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chủ trì",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c4c15f8a-301c-58b9-87d3-5da04b90bcd3-u01",
          "speaker_id": "B",
          "ja": "地図が入るか、資料を作った人に聞きます。",
          "vi": "Tôi sẽ hỏi người làm tài liệu xem có chỗ để thêm sơ đồ không."
        },
        {
          "id": "c4c15f8a-301c-58b9-87d3-5da04b90bcd3-u02",
          "speaker_id": "A",
          "ja": "お返事は何時ごろですか。",
          "vi": "Khoảng mấy giờ tôi sẽ có câu trả lời ạ?"
        },
        {
          "id": "c4c15f8a-301c-58b9-87d3-5da04b90bcd3-u03",
          "speaker_id": "B",
          "ja": "今日の午後三時までに私から連絡します。",
          "vi": "Tôi sẽ báo lại cho chị muộn nhất lúc 3 giờ chiều nay."
        },
        {
          "id": "c4c15f8a-301c-58b9-87d3-5da04b90bcd3-u04",
          "speaker_id": "B",
          "ja": "返事があるまで、資料はそのままでいいですよ。",
          "vi": "Trong lúc chờ câu trả lời, chị cứ để tài liệu như hiện tại nhé."
        },
        {
          "id": "c4c15f8a-301c-58b9-87d3-5da04b90bcd3-u05",
          "speaker_id": "A",
          "ja": "わかりました。連絡を待ちます。",
          "vi": "Vâng, tôi đợi anh báo lại."
        }
      ],
      "admin": {
        "source_refs": [],
        "specialty_item_ids": [
          "sj-so-14-b06-8"
