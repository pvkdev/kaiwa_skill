    {
      "situation_uid": "43624fc4-0a5b-5347-bfc0-3c70edb56eb2",
      "event_id": "E02",
      "context_vi": "Bạn vừa đề nghị thêm sơ đồ vào tờ hướng dẫn đón khách. Người chủ trì nói lần này chỉ có thể sửa thông tin đã có trong tài liệu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chủ trì",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "43624fc4-0a5b-5347-bfc0-3c70edb56eb2-u01",
          "speaker_id": "B",
          "ja": "今回は地図を入れる時間がありません。",
          "vi": "Lần này không còn thời gian thêm sơ đồ."
        },
        {
          "id": "43624fc4-0a5b-5347-bfc0-3c70edb56eb2-u02",
          "speaker_id": "A",
          "ja": "じゃあ、今の案内はどうしますか。",
          "vi": "Vậy mình xử lý tờ hướng dẫn hiện tại thế nào ạ?"
        },
        {
          "id": "43624fc4-0a5b-5347-bfc0-3c70edb56eb2-u03",
          "speaker_id": "B",
          "ja": "そのまま使いましょう。集合時間だけ直してください。",
          "vi": "Mình dùng bản hiện tại nhé. Chị chỉ cần sửa giờ tập trung."
        },
        {
          "id": "43624fc4-0a5b-5347-bfc0-3c70edb56eb2-u04",
          "speaker_id": "A",
          "ja": "わかりました。集合時間だけ直します。",
          "vi": "Vâng, tôi chỉ sửa giờ tập trung ạ."
        }
      ],
      "admin": {
