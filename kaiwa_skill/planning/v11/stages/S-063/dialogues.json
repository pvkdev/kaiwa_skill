  "dialogues": [
    {
      "situation_uid": "b7b96042-04a2-5bdd-ba7b-f8aa310a7ffe",
      "event_id": "E01",
      "context_vi": "Bạn vào cuộc họp ngắn về việc đón khách tuần sau. Có hai tập giấy trên bàn và bạn muốn biết hôm nay nhóm xem tập nào.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chủ trì",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b7b96042-04a2-5bdd-ba7b-f8aa310a7ffe-u01",
          "speaker_id": "A",
          "ja": "今日は何について話しますか。",
          "vi": "Hôm nay mình bàn chuyện gì ạ?"
        },
        {
          "id": "b7b96042-04a2-5bdd-ba7b-f8aa310a7ffe-u02",
          "speaker_id": "B",
          "ja": "来週のお客様の案内です。青い資料を見てください。",
          "vi": "Bàn về việc đón khách tuần sau. Chị xem tập tài liệu màu xanh nhé."
        },
        {
          "id": "b7b96042-04a2-5bdd-ba7b-f8aa310a7ffe-u03",
          "speaker_id": "A",
          "ja": "何ページですか。",
          "vi": "Trang mấy ạ?"
        },
        {
          "id": "b7b96042-04a2-5bdd-ba7b-f8aa310a7ffe-u04",
          "speaker_id": "B",
          "ja": "二ページです。ご意見は火曜日までに送ってください。",
          "vi": "Trang hai. Chị gửi góp ý chậm nhất vào thứ Ba nhé."
        },
        {
          "id": "b7b96042-04a2-5bdd-ba7b-f8aa310a7ffe-u05",
          "speaker_id": "A",
          "ja": "はい、二ページですね。",
          "vi": "Vâng, trang hai ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
        "specialty_item_ids": [],
