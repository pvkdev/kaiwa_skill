    {
      "situation_uid": "6a1f5033-7ef9-50f2-954e-8aa93ca587e7",
      "event_id": "E03",
      "context_vi": "Sau một cuộc họp, bạn được giao kiểm xem phòng còn trống không. Bạn hỏi đồng nghiệp cùng việc cần báo kết quả cho những ai.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6a1f5033-7ef9-50f2-954e-8aa93ca587e7-u01",
          "speaker_id": "A",
          "ja": "部屋が空いているか調べます。結果は誰に伝えますか。",
          "vi": "Tôi sẽ kiểm xem phòng có trống không. Tôi báo kết quả cho ai ạ?"
        },
        {
          "id": "6a1f5033-7ef9-50f2-954e-8aa93ca587e7-u02",
          "speaker_id": "B",
          "ja": "田中さんと私にお願いします。",
          "vi": "Chị báo cho chị Tanaka và tôi nhé."
        },
        {
          "id": "6a1f5033-7ef9-50f2-954e-8aa93ca587e7-u03",
          "speaker_id": "A",
          "ja": "営業の人にも知らせますか。",
          "vi": "Tôi có cần báo cả bên kinh doanh không?"
        },
        {
          "id": "6a1f5033-7ef9-50f2-954e-8aa93ca587e7-u04",
          "speaker_id": "B",
          "ja": "今は二人だけで大丈夫です。",
          "vi": "Trước mắt báo cho hai người là được."
        },
        {
          "id": "6a1f5033-7ef9-50f2-954e-8aa93ca587e7-u05",
          "speaker_id": "A",
          "ja": "では、わかったら田中さんと森さんに連絡します。",
          "vi": "Vâng, biết kết quả rồi tôi báo cho chị Tanaka và anh Mori."
        }
      ],
