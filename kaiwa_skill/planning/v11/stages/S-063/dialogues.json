    {
      "situation_uid": "5138b0a3-3379-5d10-a078-943c85cc8606",
      "event_id": "E03",
      "context_vi": "Bạn nghĩ mình sẽ gửi lịch sau khi Mori xem. Mori thấy tên mình cạnh dòng nói về việc gửi và cả hai hiểu khác nhau. Bạn hỏi lại người chủ trì vừa đứng dậy sau cuộc họp.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người chủ trì",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5138b0a3-3379-5d10-a078-943c85cc8606-u01",
          "speaker_id": "A",
          "ja": "すみません。予定表を送るのは、私ですか。森さんですか。",
          "vi": "Cho tôi hỏi, người gửi lịch là tôi hay anh Mori ạ?"
        },
        {
          "id": "5138b0a3-3379-5d10-a078-943c85cc8606-u02",
          "speaker_id": "B",
          "ja": "森さんは何と言っていましたか。",
          "vi": "Anh Mori nói sao vậy?"
        },
        {
          "id": "5138b0a3-3379-5d10-a078-943c85cc8606-u03",
          "speaker_id": "A",
          "ja": "メモに森さんの名前があったので、森さんは自分が送ると思ったそうです。",
          "vi": "Anh Mori thấy tên mình trong ghi chú nên nghĩ anh ấy là người gửi ạ."
        },
        {
          "id": "5138b0a3-3379-5d10-a078-943c85cc8606-u04",
          "speaker_id": "B",
          "ja": "では、私のメモを見ますね。",
          "vi": "Vậy để tôi xem lại ghi chú của mình nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "mishear"
