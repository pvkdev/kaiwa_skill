    {
      "situation_uid": "e08fbf65-9e80-5292-9418-b9646c848d66",
      "event_id": "E03",
      "context_vi": "Cuộc họp vừa xong. Bạn hiểu mình sẽ gửi lịch đón khách và muốn nói lại cách hiểu đó với đồng nghiệp cùng phụ trách.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nhân viên Lan",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Đồng nghiệp Mori",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e08fbf65-9e80-5292-9418-b9646c848d66-u01",
          "speaker_id": "A",
          "ja": "会議のあと、私が予定表を送るんですよね。",
          "vi": "Sau họp tôi là người gửi lịch đón khách, đúng không anh?"
        },
        {
          "id": "e08fbf65-9e80-5292-9418-b9646c848d66-u02",
          "speaker_id": "B",
          "ja": "私は、先に予定表を見るように言われました。",
          "vi": "Tôi được dặn xem lịch trước."
        },
        {
          "id": "e08fbf65-9e80-5292-9418-b9646c848d66-u03",
          "speaker_id": "A",
          "ja": "じゃあ、森さんが見てから、私が送るんですね。",
          "vi": "Vậy anh Mori xem xong thì tôi gửi nhỉ."
        },
        {
          "id": "e08fbf65-9e80-5292-9418-b9646c848d66-u04",
          "speaker_id": "B",
          "ja": "誰が送るかは、私もよく聞こえませんでした。",
          "vi": "Ai gửi thì tôi cũng nghe không rõ."
        }
      ],
      "admin": {
