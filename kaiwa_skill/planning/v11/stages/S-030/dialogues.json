    {
      "situation_uid": "fbe2620b-384b-5487-8346-e72af89530c1",
      "event_id": "E03",
      "context_vi": "Bạn mang đôi giày tới Nami vì đế một chiếc bong khi đang đi, và chỉ rõ chiếc bên phải.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa giày",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "fbe2620b-384b-5487-8346-e72af89530c1-u01",
          "speaker_id": "a",
          "ja": "歩いていたら、右の靴の底がはがれました。",
          "vi": "Đang đi thì đế chiếc giày bên phải bị bong ạ."
        },
        {
          "id": "fbe2620b-384b-5487-8346-e72af89530c1-u02",
          "speaker_id": "b",
          "ja": "どの部分ですか。",
          "vi": "Phần nào vậy ạ?"
        },
        {
          "id": "fbe2620b-384b-5487-8346-e72af89530c1-u03",
          "speaker_id": "a",
          "ja": "かかとの後ろです。ここです。",
          "vi": "Phía sau gót ạ, chỗ này."
        },
        {
          "id": "fbe2620b-384b-5487-8346-e72af89530c1-u04",
          "speaker_id": "b",
          "ja": "見せてください。状態を確認します。",
          "vi": "Cho tôi xem. Tôi sẽ kiểm tình trạng."
        }
      ],
      "admin": {
