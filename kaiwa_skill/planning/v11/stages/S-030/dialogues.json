    {
      "situation_uid": "eed8b318-4569-59c8-ac5a-e3ba33778001",
      "event_id": "E04",
      "context_vi": "Tiệm Nami vừa xem lại tay áo phải còn dài và đề nghị sửa thêm. Bạn hỏi ngày nhận mới trước khi để áo lại; lịch hẹn là của đơn hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "eed8b318-4569-59c8-ac5a-e3ba33778001-u01",
          "speaker_id": "b",
          "ja": "右の袖をもう一度直します。",
          "vi": "Chúng tôi sẽ sửa lại tay phải ạ."
        },
        {
          "id": "eed8b318-4569-59c8-ac5a-e3ba33778001-u02",
          "speaker_id": "a",
          "ja": "いつ受け取れますか。",
          "vi": "Khi nào tôi nhận được?"
        },
        {
          "id": "eed8b318-4569-59c8-ac5a-e3ba33778001-u03",
          "speaker_id": "b",
          "ja": "木曜日の夕方を予定しています。",
          "vi": "Dự kiến chiều thứ Năm ạ."
        },
        {
          "id": "eed8b318-4569-59c8-ac5a-e3ba33778001-u04",
          "speaker_id": "a",
          "ja": "では、木曜日に来ます。左の袖はそのままでお願いします。",
          "vi": "Vậy thứ Năm tôi đến. Tay trái giữ nguyên giúp tôi nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "alter"
        ],
