          }
        }
      }
    },
    {
      "situation_uid": "5e2925de-f99f-55bc-875e-13169f13881d",
      "event_id": "E02",
      "context_vi": "Bạn muốn sửa cả tay và eo áo tại Nami chậm nhất thứ Sáu, nhưng tiệm chỉ kịp sửa tay. Bạn chọn phần cần gấp; lịch là riêng tiệm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "5e2925de-f99f-55bc-875e-13169f13881d-u01",
          "speaker_id": "b",
          "ja": "金曜日までなら、袖だけできます。ウエストは間に合いません。",
          "vi": "Nếu cần xong chậm nhất thứ Sáu, tôi chỉ kịp sửa tay áo. Phần eo không kịp ạ."
        },
        {
          "id": "5e2925de-f99f-55bc-875e-13169f13881d-u02",
          "speaker_id": "a",
          "ja": "では、袖だけ先にお願いします。",
          "vi": "Vậy nhờ sửa tay áo trước ạ."
        },
        {
          "id": "5e2925de-f99f-55bc-875e-13169f13881d-u03",
          "speaker_id": "b",
          "ja": "ウエストはそのままですね。",
          "vi": "Phần eo giữ nguyên nhé?"
        },
        {
          "id": "5e2925de-f99f-55bc-875e-13169f13881d-u04",
          "speaker_id": "a",
          "ja": "はい、今回はそのままで。",
          "vi": "Vâng, lần này giữ nguyên."
        }
      ],
      "admin": {
        "source_refs": [
          "alter"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
        "turn_origins": {
          "5e2925de-f99f-55bc-875e-13169f13881d-u01": {
