    {
      "situation_uid": "8dae265d-9ec6-5cd8-8c1d-a3c5c5fe2e5d",
      "event_id": "E02",
      "context_vi": "Tại Nami, bạn chỉ muốn bó phần eo áo nhưng thợ hiểu là bó cả thân và tay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8dae265d-9ec6-5cd8-8c1d-a3c5c5fe2e5d-u01",
          "speaker_id": "b",
          "ja": "袖も身ごろも細くしますね。",
          "vi": "Tôi bó cả tay và thân áo nhé."
        },
        {
          "id": "8dae265d-9ec6-5cd8-8c1d-a3c5c5fe2e5d-u02",
          "speaker_id": "a",
          "ja": "いいえ、ウエストだけです。袖は変えないでください。",
          "vi": "Không ạ, chỉ phần eo thôi. Đừng sửa tay áo."
        },
        {
          "id": "8dae265d-9ec6-5cd8-8c1d-a3c5c5fe2e5d-u03",
          "speaker_id": "b",
          "ja": "失礼しました。ウエストだけですね。",
          "vi": "Xin lỗi anh. Chỉ phần eo nhé."
        }
      ],
      "admin": {
