            "kind": "original_extension"
          },
          "435e46c3-b811-5c2a-86ef-381e2997a06c-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3e97491f-7ed5-50de-9927-b663e603390c",
      "event_id": "E02",
      "context_vi": "Tại Nami, bạn muốn rút ngắn tay áo nhưng giữ đường viền cũ nếu có thể. Thợ cần xem áo trước khi hứa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "3e97491f-7ed5-50de-9927-b663e603390c-u01",
          "speaker_id": "a",
          "ja": "この袖を短くして、今の形を残せますか。",
          "vi": "Rút ngắn tay áo mà giữ kiểu viền hiện tại được không ạ?"
        },
        {
          "id": "3e97491f-7ed5-50de-9927-b663e603390c-u02",
          "speaker_id": "b",
          "ja": "縫い目を見てから、できるかお答えします。",
          "vi": "Tôi xem đường may rồi mới trả lời được ạ."
        },
        {
          "id": "3e97491f-7ed5-50de-9927-b663e603390c-u03",
          "speaker_id": "a",
          "ja": "分かりました。ここを見てください。",
          "vi": "Tôi hiểu. Anh xem chỗ này nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "alter"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3e97491f-7ed5-50de-9927-b663e603390c-u01": {
            "kind": "original_extension"
