    {
      "situation_uid": "02d63be6-f407-5425-b094-2fad113dfd6b",
      "event_id": "E03",
      "context_vi": "Ở Nami, thợ xem đôi giày bị bong đế. Bạn hỏi có thể dán lại hay cần thay phần đế; thợ chưa quyết trước khi kiểm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa giày",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "02d63be6-f407-5425-b094-2fad113dfd6b-u01",
          "speaker_id": "a",
          "ja": "この底は直せますか。それとも、交換が必要ですか。",
          "vi": "Đế này sửa được không, hay phải thay ạ?"
        },
        {
          "id": "02d63be6-f407-5425-b094-2fad113dfd6b-u02",
          "speaker_id": "b",
          "ja": "はがれた所をもう少し見ます。あとで方法をお伝えします。",
          "vi": "Tôi xem kỹ chỗ bong rồi mới báo cách làm được ạ."
        },
        {
          "id": "02d63be6-f407-5425-b094-2fad113dfd6b-u03",
          "speaker_id": "a",
          "ja": "分かりました。費用も先に教えてください。",
          "vi": "Tôi hiểu. Anh báo chi phí trước giúp tôi nhé."
        }
      ],
      "admin": {
