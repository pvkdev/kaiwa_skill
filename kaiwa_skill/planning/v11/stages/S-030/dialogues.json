    {
      "situation_uid": "796a7dff-7276-559d-a09e-7cc49efbe179",
      "event_id": "E02",
      "context_vi": "Sau khi đính chính với thợ Nami rằng chỉ bó phần eo, bạn chốt vị trí sửa và ngày nhận thứ Tư của đơn hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "796a7dff-7276-559d-a09e-7cc49efbe179-u01",
          "speaker_id": "a",
          "ja": "ここからここまで、ウエストだけお願いします。",
          "vi": "Chỉ bó phần eo, từ chỗ này đến chỗ này ạ."
        },
        {
          "id": "796a7dff-7276-559d-a09e-7cc49efbe179-u02",
          "speaker_id": "b",
          "ja": "分かりました。袖は変えません。水曜日にお渡しします。",
          "vi": "Tôi hiểu. Tay áo giữ nguyên. Thứ Tư anh nhận nhé."
        },
        {
          "id": "796a7dff-7276-559d-a09e-7cc49efbe179-u03",
          "speaker_id": "a",
          "ja": "水曜日ですね。受け取りに来ます。",
          "vi": "Thứ Tư nhỉ. Tôi sẽ tới nhận."
        }
      ],
      "admin": {
