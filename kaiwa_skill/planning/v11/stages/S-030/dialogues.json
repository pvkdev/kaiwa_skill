    {
      "situation_uid": "435e46c3-b811-5c2a-86ef-381e2997a06c",
      "event_id": "E02",
      "context_vi": "Ở khu sửa quần áo Nami, bạn mặc thử áo sơ mi và chỉ phần tay phải quá dài.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "435e46c3-b811-5c2a-86ef-381e2997a06c-u01",
          "speaker_id": "a",
          "ja": "右の袖が少し長いです。ここまで短くできますか。",
          "vi": "Tay áo bên phải hơi dài. Rút tới đây được không ạ?"
        },
        {
          "id": "435e46c3-b811-5c2a-86ef-381e2997a06c-u02",
          "speaker_id": "b",
          "ja": "着たまま長さを見ます。左も同じ長さにしますか。",
          "vi": "Anh mặc để tôi xem độ dài. Tay trái cũng sửa bằng độ dài đó chứ?"
        },
        {
          "id": "435e46c3-b811-5c2a-86ef-381e2997a06c-u03",
          "speaker_id": "a",
          "ja": "はい、両方同じ長さでお願いします。",
          "vi": "Vâng, hai tay bằng nhau giúp tôi."
        }
      ],
      "admin": {
        "source_refs": [
          "alter"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
        "turn_origins": {
          "435e46c3-b811-5c2a-86ef-381e2997a06c-u01": {
            "kind": "original_extension"
          },
