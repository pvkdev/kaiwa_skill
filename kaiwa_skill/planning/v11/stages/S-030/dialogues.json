    {
      "situation_uid": "c6eb9050-92d9-5d1b-b8e2-425bb9cdf9ea",
      "event_id": "E04",
      "context_vi": "Tại Nami, áo sơ mi đã sửa nhưng ống tay phải vẫn dài hơn bên trái. Bạn chỉ đúng bên cần xem lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm",
