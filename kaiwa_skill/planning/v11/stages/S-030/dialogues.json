    {
      "situation_uid": "0b3dc3b0-c56c-5f86-af0e-81fdc2aa99c6",
      "event_id": "E04",
      "context_vi": "Chiều thứ Năm bạn gọi Nami hỏi chiếc áo sơ mi để sửa lại tay phải đã xong chưa, theo hẹn trước. Tay trái không sửa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0b3dc3b0-c56c-5f86-af0e-81fdc2aa99c6-u01",
          "speaker_id": "a",
          "ja": "右の袖を直してもらったシャツは、もう受け取れますか。",
          "vi": "Áo sơ mi sửa lại tay phải đã nhận được chưa ạ?"
        },
        {
          "id": "0b3dc3b0-c56c-5f86-af0e-81fdc2aa99c6-u02",
          "speaker_id": "b",
          "ja": "お名前をお願いします。",
          "vi": "Anh cho tôi xin tên ạ."
        },
        {
          "id": "0b3dc3b0-c56c-5f86-af0e-81fdc2aa99c6-u03",
          "speaker_id": "a",
          "ja": "グエン・アンです。木曜日の夕方の予定です。",
          "vi": "Tôi là Nguyễn An. Hẹn chiều thứ Năm ạ."
        },
        {
          "id": "0b3dc3b0-c56c-5f86-af0e-81fdc2aa99c6-u04",
          "speaker_id": "b",
          "ja": "確認しますので、少々お待ちください。",
          "vi": "Tôi kiểm tra, anh đợi chút nhé."
        }
      ],
      "admin": {
        "source_refs": [
