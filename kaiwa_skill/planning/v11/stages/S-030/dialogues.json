    {
      "situation_uid": "53e55cc5-c6dc-5b83-bb52-5558be501e4b",
      "event_id": "E03",
      "context_vi": "Ở Nami hư cấu, thợ báo sửa giày phải để qua đêm. Bạn cần đi ngày mai và hỏi có lấy sớm hơn được không; không có lời hứa khi chưa kiểm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa giày",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "53e55cc5-c6dc-5b83-bb52-5558be501e4b-u01",
          "speaker_id": "b",
          "ja": "この修理は明日までお預かりします。",
          "vi": "Sửa kiểu này phải để giày đến ngày mai ạ."
        },
        {
          "id": "53e55cc5-c6dc-5b83-bb52-5558be501e4b-u02",
          "speaker_id": "a",
          "ja": "明日の朝、早く受け取れますか。",
          "vi": "Sáng mai tôi nhận sớm được không ạ?"
        },
        {
          "id": "53e55cc5-c6dc-5b83-bb52-5558be501e4b-u03",
          "speaker_id": "b",
          "ja": "今はお約束できません。仕上がる時間を確認します。",
          "vi": "Giờ tôi chưa hứa được. Để tôi kiểm giờ hoàn thành."
        },
        {
          "id": "53e55cc5-c6dc-5b83-bb52-5558be501e4b-u04",
          "speaker_id": "a",
          "ja": "では、確認をお願いします。",
          "vi": "Vậy nhờ anh kiểm tra giúp."
        }
      ],
      "admin": {
