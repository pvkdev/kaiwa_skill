          "speaker_id": "a",
          "ja": "左の袖のしみがまだ少し見えます。ここです。",
          "vi": "Vết ở tay trái vẫn còn hơi thấy, chỗ này ạ."
        },
        {
          "id": "78ac26fa-ee87-5b0c-9d18-2d9a66e19b39-u02",
          "speaker_id": "b",
          "ja": "一緒に確認します。受付のときの記録も見ます。",
          "vi": "Mình cùng xem nhé. Tôi sẽ xem cả ghi nhận lúc nhận áo."
        },
        {
          "id": "78ac26fa-ee87-5b0c-9d18-2d9a66e19b39-u03",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Nhờ chị kiểm tra."
        }
