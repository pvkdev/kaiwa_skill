    {
      "situation_uid": "78ac26fa-ee87-5b0c-9d18-2d9a66e19b39",
      "event_id": "E04",
      "context_vi": "Bạn nhận áo khoác đã giặt tại Nami và thấy vết cà phê ở tay trái vẫn còn hơi rõ. Bạn hỏi nhân viên trước khi mang về.",
