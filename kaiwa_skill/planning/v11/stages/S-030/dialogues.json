          }
        }
      }
    },
    {
      "situation_uid": "9d48aaf3-bdf8-5150-b174-fa58f66fc83e",
      "event_id": "E01",
      "context_vi": "Ở Nami, nhân viên cần kiểm thêm nhãn áo đặc biệt trước khi nhận giặt. Bạn muốn biết khi nào hỏi lại; mốc 14:00 là hẹn riêng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm giặt",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9d48aaf3-bdf8-5150-b174-fa58f66fc83e-u01",
          "speaker_id": "b",
          "ja": "この表示を担当者と確認します。今はまだお預かりできません。",
          "vi": "Tôi cần hỏi người phụ trách về nhãn này. Giờ chưa nhận áo được ạ."
        },
        {
          "id": "9d48aaf3-bdf8-5150-b174-fa58f66fc83e-u02",
          "speaker_id": "a",
          "ja": "いつ返事を聞けますか。",
          "vi": "Khi nào tôi hỏi kết quả được ạ?"
        },
        {
          "id": "9d48aaf3-bdf8-5150-b174-fa58f66fc83e-u03",
          "speaker_id": "b",
          "ja": "今日の二時ごろ、この店にお電話ください。",
          "vi": "Khoảng 2 giờ hôm nay anh gọi lại tiệm nhé."
        },
        {
          "id": "9d48aaf3-bdf8-5150-b174-fa58f66fc83e-u04",
          "speaker_id": "a",
          "ja": "分かりました。二時に電話します。",
          "vi": "Tôi hiểu rồi. 2 giờ tôi gọi."
        }
      ],
      "admin": {
        "source_refs": [
          "fabric",
          "whitefaq"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9d48aaf3-bdf8-5150-b174-fa58f66fc83e-u01": {
