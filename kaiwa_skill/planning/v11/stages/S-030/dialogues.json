    {
      "situation_uid": "9e4f688f-476e-5fbe-a57c-e4d2e79c6687",
      "event_id": "E01",
      "context_vi": "Bạn cần dùng áo khoác vào thứ Bảy, hỏi Nami ngày nhận trước khi giao. Ngày hẹn chỉ là thỏa thuận của tiệm hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm giặt",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9e4f688f-476e-5fbe-a57c-e4d2e79c6687-u01",
          "speaker_id": "a",
          "ja": "土曜日に着たいです。いつ受け取れますか。",
          "vi": "Tôi cần mặc vào thứ Bảy. Khi nào nhận được ạ?"
        },
        {
          "id": "9e4f688f-476e-5fbe-a57c-e4d2e79c6687-u02",
          "speaker_id": "b",
          "ja": "この品物なら金曜日の夕方を予定しています。",
          "vi": "Với chiếc này, dự kiến chiều thứ Sáu ạ."
        },
        {
          "id": "9e4f688f-476e-5fbe-a57c-e4d2e79c6687-u03",
          "speaker_id": "a",
          "ja": "金曜日の夕方ですね。間に合いそうです。",
          "vi": "Chiều thứ Sáu nhỉ. Có vẻ kịp."
        },
        {
          "id": "9e4f688f-476e-5fbe-a57c-e4d2e79c6687-u04",
          "speaker_id": "b",
          "ja": "変更があればご連絡します。",
          "vi": "Nếu có thay đổi, chúng tôi sẽ báo anh."
        }
      ],
      "admin": {
        "source_refs": [
          "whitefaq"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9e4f688f-476e-5fbe-a57c-e4d2e79c6687-u01": {
            "kind": "original_extension"
