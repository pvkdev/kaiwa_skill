    {
      "situation_uid": "76547a09-4b1b-53fd-beb2-92e95baba3c3",
      "event_id": "E03",
      "context_vi": "Hôm sau bạn mang lại đúng đôi giày từng được Nami báo thay phần gót phải 8.000 yên rồi mang về. Vì muốn giữ đôi giày quen, bạn đổi ý và chấp nhận kiểm lại giá trước khi giao.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa giày",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "76547a09-4b1b-53fd-beb2-92e95baba3c3-u01",
          "speaker_id": "a",
          "ja": "昨日の靴です。考え直して、修理をお願いしたいです。",
          "vi": "Đôi giày hôm qua đây. Tôi nghĩ lại và muốn sửa ạ."
        },
        {
          "id": "76547a09-4b1b-53fd-beb2-92e95baba3c3-u02",
          "speaker_id": "b",
          "ja": "ありがとうございます。底をもう一度見て、金額を確認します。",
          "vi": "Cảm ơn anh. Tôi kiểm lại đế và giá nhé."
        },
        {
          "id": "76547a09-4b1b-53fd-beb2-92e95baba3c3-u03",
          "speaker_id": "a",
          "ja": "はい。交換するのは、右のかかとの部分ですね。",
          "vi": "Vâng. Phần thay là gót bên phải nhỉ?"
        },
        {
          "id": "76547a09-4b1b-53fd-beb2-92e95baba3c3-u04",
          "speaker_id": "b",
          "ja": "はい、右のかかとです。確認後に受付します。",
          "vi": "Đúng, gót bên phải. Kiểm xong tôi sẽ nhận sửa ạ."
        }
      ],
