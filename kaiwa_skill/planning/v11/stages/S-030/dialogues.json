    },
    {
      "situation_uid": "0569d5c7-2853-5381-b041-44be00e60acc",
      "event_id": "E01",
      "context_vi": "Ở Nami, bạn mang áo len có nhãn chất liệu và muốn biết tiệm có thể nhận xử lý không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm giặt",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0569d5c7-2853-5381-b041-44be00e60acc-u01",
          "speaker_id": "a",
          "ja": "このセーターをクリーニングできますか。",
          "vi": "Tiệm giặt chiếc áo len này được không ạ?"
        },
        {
          "id": "0569d5c7-2853-5381-b041-44be00e60acc-u02",
          "speaker_id": "b",
          "ja": "まず内側の表示を見せていただけますか。",
          "vi": "Trước hết, anh cho tôi xem nhãn bên trong được không ạ?"
        },
        {
          "id": "0569d5c7-2853-5381-b041-44be00e60acc-u03",
          "speaker_id": "a",
          "ja": "はい、こちらです。",
          "vi": "Vâng, đây ạ."
        },
        {
          "id": "0569d5c7-2853-5381-b041-44be00e60acc-u04",
          "speaker_id": "b",
          "ja": "ありがとうございます。確認してからお答えします。",
          "vi": "Cảm ơn anh. Tôi kiểm nhãn rồi trả lời nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "fabric",
          "whitefaq"
        ],
        "specialty_item_ids": [],
