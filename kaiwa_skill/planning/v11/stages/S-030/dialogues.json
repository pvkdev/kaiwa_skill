    {
      "situation_uid": "327b8a40-99e9-592d-9cad-5811bce58066",
      "event_id": "E03",
      "context_vi": "Ở Nami hư cấu, thợ báo thay phần gót giày bên phải tốn 8.000 yên, gần bằng giá mua đôi khác 9.000 yên mà bạn đã thấy. Bạn quyết định hôm nay chưa sửa; số tiền chỉ là ví dụ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa giày",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "327b8a40-99e9-592d-9cad-5811bce58066-u01",
          "speaker_id": "b",
          "ja": "右のかかとの交換は八千円です。",
          "vi": "Thay phần gót bên phải là 8.000 yên ạ."
        },
        {
          "id": "327b8a40-99e9-592d-9cad-5811bce58066-u02",
          "speaker_id": "a",
          "ja": "新しい靴が九千円でした。今日は修理せず、持ち帰ります。",
          "vi": "Đôi mới tôi thấy là 9.000 yên. Hôm nay tôi chưa sửa, xin mang về."
        },
        {
          "id": "327b8a40-99e9-592d-9cad-5811bce58066-u03",
          "speaker_id": "b",
          "ja": "分かりました。靴をお返しします。",
          "vi": "Tôi hiểu. Tôi trả giày anh nhé."
        },
        {
          "id": "327b8a40-99e9-592d-9cad-5811bce58066-u04",
          "speaker_id": "a",
          "ja": "少し考えます。",
          "vi": "Để tôi suy nghĩ thêm ạ."
        }
      ],
      "admin": {
