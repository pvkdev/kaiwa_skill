    {
      "situation_uid": "e3edaa11-31ce-5b55-8d3e-753d6b1da10c",
      "event_id": "E04",
      "context_vi": "Sau cuộc gọi hỏi áo chiều thứ Năm, bạn đến quầy Nami. Nhân viên mang áo sơ mi đã sửa tay phải ra; bạn thử tại chỗ và thấy hai tay áo bằng nhau trước khi nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e3edaa11-31ce-5b55-8d3e-753d6b1da10c-u01",
          "speaker_id": "b",
          "ja": "お待たせしました。シャツはできています。こちらで試せます。",
          "vi": "Xin lỗi đã để anh đợi. Áo xong rồi, anh thử tại đây được ạ."
        },
        {
          "id": "e3edaa11-31ce-5b55-8d3e-753d6b1da10c-u02",
          "speaker_id": "a",
          "ja": "着てみます。右と左が同じ長さになりました。",
          "vi": "Để tôi mặc thử. Tay phải và trái giờ dài bằng nhau rồi."
        },
        {
          "id": "e3edaa11-31ce-5b55-8d3e-753d6b1da10c-u03",
          "speaker_id": "b",
          "ja": "ほかに気になる所はありますか。",
          "vi": "Anh còn chỗ nào muốn xem nữa không ạ?"
        },
        {
          "id": "e3edaa11-31ce-5b55-8d3e-753d6b1da10c-u04",
          "speaker_id": "a",
          "ja": "ありません。これで受け取ります。",
          "vi": "Không ạ. Tôi nhận áo nhé."
        }
      ],
