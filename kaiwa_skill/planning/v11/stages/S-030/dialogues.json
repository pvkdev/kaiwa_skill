      "turns": [
        {
          "id": "c6eb9050-92d9-5d1b-b8e2-425bb9cdf9ea-u01",
          "speaker_id": "a",
          "ja": "直した右の袖が、左よりまだ長いです。",
          "vi": "Tay phải đã sửa vẫn dài hơn tay trái ạ."
        },
        {
          "id": "c6eb9050-92d9-5d1b-b8e2-425bb9cdf9ea-u02",
          "speaker_id": "b",
          "ja": "着たところを見せていただけますか。",
          "vi": "Anh mặc lên cho tôi xem được không ạ?"
        },
        {
          "id": "c6eb9050-92d9-5d1b-b8e2-425bb9cdf9ea-u03",
          "speaker_id": "a",
          "ja": "はい。右はこちらです。",
          "vi": "Vâng. Tay phải đây ạ."
        },
        {
          "id": "c6eb9050-92d9-5d1b-b8e2-425bb9cdf9ea-u04",
          "speaker_id": "b",
          "ja": "確認して、担当者に伝えます。",
          "vi": "Tôi kiểm rồi báo thợ phụ trách."
        }
      ],
