  "dialogues": [
    {
      "situation_uid": "2547752f-e021-5ecc-b2e2-1a0e138a270d",
      "event_id": "E01",
      "context_vi": "Tại tiệm giặt, sửa đồ và giày Nami hư cấu, bạn giao áo khoác có vết cà phê ở tay trái. Bạn chưa tự tẩy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm giặt",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2547752f-e021-5ecc-b2e2-1a0e138a270d-u01",
          "speaker_id": "a",
          "ja": "左の袖にコーヒーのしみがあります。まだ自分では洗っていません。",
          "vi": "Tay trái áo có vết cà phê. Tôi chưa tự giặt ạ."
        },
        {
          "id": "2547752f-e021-5ecc-b2e2-1a0e138a270d-u02",
          "speaker_id": "b",
          "ja": "いつ付いたしみですか。",
          "vi": "Vết này dính từ khi nào ạ?"
        },
        {
          "id": "2547752f-e021-5ecc-b2e2-1a0e138a270d-u03",
          "speaker_id": "a",
          "ja": "昨日の朝です。ここを見てください。",
          "vi": "Sáng hôm qua. Chị xem chỗ này ạ."
        },
        {
          "id": "2547752f-e021-5ecc-b2e2-1a0e138a270d-u04",
          "speaker_id": "b",
          "ja": "分かりました。状態を確認します。",
          "vi": "Tôi hiểu rồi. Tôi sẽ xem tình trạng áo."
        }
      ],
      "admin": {
        "source_refs": [
          "fabric",
          "whitefaq"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
