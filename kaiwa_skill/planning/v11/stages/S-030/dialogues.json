    {
      "situation_uid": "2240acad-2295-5cf2-b678-2939450a6d6d",
      "event_id": "E01",
      "context_vi": "Tại Nami, nhân viên đã xem vết bẩn trên áo khoác và nói chưa thể hứa sạch hoàn toàn. Bạn quyết định vẫn giao, sau khi hiểu giới hạn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên tiệm giặt",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2240acad-2295-5cf2-b678-2939450a6d6d-u01",
          "speaker_id": "b",
          "ja": "このしみは、全部落ちるとはお約束できません。",
          "vi": "Vết này chúng tôi không thể hứa sẽ sạch hết ạ."
        },
        {
          "id": "2240acad-2295-5cf2-b678-2939450a6d6d-u02",
          "speaker_id": "a",
          "ja": "分かりました。それでもお願いしたいです。",
          "vi": "Tôi hiểu. Dù vậy nhờ tiệm xử lý giúp."
        },
        {
          "id": "2240acad-2295-5cf2-b678-2939450a6d6d-u03",
          "speaker_id": "b",
          "ja": "では、しみの場所をもう一度確認します。",
          "vi": "Vậy tôi kiểm lại vị trí vết bẩn nhé."
        },
        {
          "id": "2240acad-2295-5cf2-b678-2939450a6d6d-u04",
          "speaker_id": "a",
          "ja": "左の袖です。",
          "vi": "Ở tay áo bên trái ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "whitefaq"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "2240acad-2295-5cf2-b678-2939450a6d6d-u01": {
