    {
      "situation_uid": "d072cb54-bc16-52c1-a874-92aadd40e4c4",
      "event_id": "E02",
      "context_vi": "Người bạn đã vô tình lấy nhầm quyển sách của bạn, nay mang trả đúng sách và xin lỗi. Bạn kiểm tra rồi nhận lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người vừa xin lỗi",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d072cb54-bc16-52c1-a874-92aadd40e4c4-u01",
          "speaker_id": "b",
          "ja": "間違えて持って帰ってしまいました。ごめんなさい。これです。",
          "vi": "Tôi mang nhầm về. Xin lỗi nhé. Đây này."
        },
        {
          "id": "d072cb54-bc16-52c1-a874-92aadd40e4c4-u02",
          "speaker_id": "a",
          "ja": "はい、私の本です。返してくれてありがとう。",
          "vi": "Ừ, đúng sách của tôi. Cảm ơn bạn đã trả."
        },
        {
          "id": "d072cb54-bc16-52c1-a874-92aadd40e4c4-u03",
          "speaker_id": "b",
          "ja": "次から名前を確認します。",
          "vi": "Lần sau tôi sẽ xem tên trước."
        },
        {
          "id": "d072cb54-bc16-52c1-a874-92aadd40e4c4-u04",
          "speaker_id": "a",
          "ja": "もう大丈夫です。",
          "vi": "Giờ ổn rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "apology"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d072cb54-bc16-52c1-a874-92aadd40e4c4-u01": {
