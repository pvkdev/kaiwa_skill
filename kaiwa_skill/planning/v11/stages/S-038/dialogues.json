    {
      "situation_uid": "ef188559-9e49-528d-9d5d-cdfa86239d17",
      "event_id": "E03",
      "context_vi": "Ở hành lang nhà chung hư cấu, thùng hàng của hàng xóm chắn cửa phòng bạn, khiến bạn không ra được. Bạn nêu rõ bất tiện và đề nghị dời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "hàng xóm",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "ef188559-9e49-528d-9d5d-cdfa86239d17-u01",
          "speaker_id": "a",
          "ja": "すみません。この箱がドアの前にあって、出られません。少し動かしてもらえますか。",
          "vi": "Xin lỗi, thùng này ở trước cửa nên tôi không ra được. Chị dời giúp một chút nhé?"
        },
        {
          "id": "ef188559-9e49-528d-9d5d-cdfa86239d17-u02",
          "speaker_id": "b",
          "ja": "あ、失礼しました。すぐ動かします。",
          "vi": "À, xin lỗi. Tôi dời ngay."
        },
        {
          "id": "ef188559-9e49-528d-9d5d-cdfa86239d17-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。ドアが開くところまでお願いします。",
          "vi": "Cảm ơn. Xin dời sao cho mở được cửa nhé."
        },
        {
          "id": "ef188559-9e49-528d-9d5d-cdfa86239d17-u04",
          "speaker_id": "b",
          "ja": "はい。これで開きますか。",
          "vi": "Vâng, thế này mở được chưa?"
        },
        {
          "id": "ef188559-9e49-528d-9d5d-cdfa86239d17-u05",
          "speaker_id": "a",
          "ja": "はい、開きます。ありがとうございます。",
          "vi": "Được rồi. Cảm ơn chị."
        }
      ],
      "admin": {
