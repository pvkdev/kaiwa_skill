            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "9878ea28-973e-5393-9ada-8c90620dba1b",
      "event_id": "E01",
      "context_vi": "Sau khi hàng xóm nhờ nhặt hết giấy gói còn trên lối đi, bạn đã dọn xong và báo để họ kiểm lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người bị ảnh hưởng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9878ea28-973e-5393-9ada-8c90620dba1b-u01",
          "speaker_id": "a",
          "ja": "床の紙を全部拾いました。ここを見ていただけますか。",
          "vi": "Tôi đã nhặt hết giấy trên sàn. Chị xem giúp chỗ này được không?"
        },
        {
          "id": "9878ea28-973e-5393-9ada-8c90620dba1b-u02",
          "speaker_id": "b",
          "ja": "はい。もう紙はありません。通れます。",
          "vi": "Ừ, không còn giấy nữa. Tôi qua được rồi."
        },
        {
          "id": "9878ea28-973e-5393-9ada-8c90620dba1b-u03",
          "speaker_id": "a",
          "ja": "ご迷惑をおかけしました。",
          "vi": "Xin lỗi đã làm phiền chị."
        },
        {
          "id": "9878ea28-973e-5393-9ada-8c90620dba1b-u04",
          "speaker_id": "b",
          "ja": "片づけてくれてありがとうございます。",
          "vi": "Cảm ơn anh đã dọn."
        }
      ],
      "admin": {
        "source_refs": [
          "apology"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9878ea28-973e-5393-9ada-8c90620dba1b-u01": {
