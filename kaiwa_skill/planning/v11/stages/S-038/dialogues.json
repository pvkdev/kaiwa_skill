            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "8022454a-927a-56ef-9d20-34382d2a6d21",
      "event_id": "E01",
      "context_vi": "Bạn để thùng đồ chặn lối đi trong nhà chung hư cấu. Người hàng xóm cần đi qua; bạn xin lỗi và chuyển ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người bị ảnh hưởng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8022454a-927a-56ef-9d20-34382d2a6d21-u01",
          "speaker_id": "b",
          "ja": "すみません。この箱があって通れません。",
          "vi": "Xin lỗi, cái thùng này chắn lối nên tôi không qua được."
        },
        {
          "id": "8022454a-927a-56ef-9d20-34382d2a6d21-u02",
          "speaker_id": "a",
          "ja": "申し訳ありません。今、横に移します。",
          "vi": "Tôi xin lỗi. Tôi chuyển nó sang bên ngay."
        },
        {
          "id": "8022454a-927a-56ef-9d20-34382d2a6d21-u03",
          "speaker_id": "b",
          "ja": "ありがとうございます。そこなら通れます。",
          "vi": "Cảm ơn. Để đó thì tôi qua được."
        },
        {
          "id": "8022454a-927a-56ef-9d20-34382d2a6d21-u04",
          "speaker_id": "a",
          "ja": "ご迷惑をおかけしました。次から気をつけます。",
          "vi": "Xin lỗi đã gây bất tiện. Lần sau tôi sẽ chú ý."
        }
      ],
      "admin": {
        "source_refs": [
          "apology",
          "complaint"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8022454a-927a-56ef-9d20-34382d2a6d21-u01": {
