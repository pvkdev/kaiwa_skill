        }
      }
    },
    {
      "situation_uid": "c62c0155-a6b5-59e9-bc82-2a23df751a23",
      "event_id": "E02",
      "context_vi": "Người bạn xin lỗi vì lỡ buổi hẹn hôm nay. Bạn muốn nghe giờ mới có thể gặp trước khi nhận lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người vừa xin lỗi",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c62c0155-a6b5-59e9-bc82-2a23df751a23-u01",
          "speaker_id": "b",
          "ja": "今日の約束に行けなくなりました。ごめんなさい。",
          "vi": "Hôm nay tôi không đến chỗ hẹn được. Xin lỗi nhé."
        },
        {
          "id": "c62c0155-a6b5-59e9-bc82-2a23df751a23-u02",
          "speaker_id": "a",
          "ja": "分かりました。いつなら会えますか。",
          "vi": "Tôi hiểu. Khi nào bạn gặp được?"
        },
        {
          "id": "c62c0155-a6b5-59e9-bc82-2a23df751a23-u03",
          "speaker_id": "b",
          "ja": "明日の三時なら空いています。",
          "vi": "Ngày mai 3 giờ tôi rảnh."
        },
        {
          "id": "c62c0155-a6b5-59e9-bc82-2a23df751a23-u04",
          "speaker_id": "a",
          "ja": "明日の予定を見てから返事します。",
          "vi": "Để tôi xem lịch ngày mai rồi trả lời."
        }
      ],
      "admin": {
        "source_refs": [
          "apology"
        ],
        "specialty_item_ids": [],
