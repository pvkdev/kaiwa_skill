  "dialogues": [
    {
      "situation_uid": "d741dc7d-88a2-523b-a6fe-67918bd651d4",
      "event_id": "E01",
      "context_vi": "Bạn hẹn gặp bạn ở ga lúc 14 giờ nhưng sẽ đến 14 giờ 10. Bạn gọi báo ngay, xin lỗi và nói giờ tới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người bị ảnh hưởng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d741dc7d-88a2-523b-a6fe-67918bd651d4-u01",
          "speaker_id": "a",
          "ja": "遅れてすみません。二時十分に着きます。",
          "vi": "Xin lỗi tôi đến muộn. Tôi sẽ tới lúc 2 giờ 10."
        },
        {
          "id": "d741dc7d-88a2-523b-a6fe-67918bd651d4-u02",
          "speaker_id": "b",
          "ja": "分かりました。駅の入口で待っています。",
          "vi": "Được, tôi chờ ở cửa ga."
        },
        {
          "id": "d741dc7d-88a2-523b-a6fe-67918bd651d4-u03",
          "speaker_id": "a",
          "ja": "待たせてしまって申し訳ありません。着いたら連絡します。",
          "vi": "Xin lỗi đã để bạn chờ. Đến nơi tôi sẽ báo."
        },
        {
          "id": "d741dc7d-88a2-523b-a6fe-67918bd651d4-u04",
          "speaker_id": "b",
          "ja": "はい、気をつけて来てください。",
          "vi": "Ừ, đi cẩn thận nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "apology"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d741dc7d-88a2-523b-a6fe-67918bd651d4-u01": {
