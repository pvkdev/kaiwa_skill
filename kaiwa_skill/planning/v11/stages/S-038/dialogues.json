          }
        }
      }
    },
    {
      "situation_uid": "8fc6b206-5cca-5a7e-aebb-f2de80ded877",
      "event_id": "E01",
      "context_vi": "Ở hành lang nhà chung hư cấu, bạn đã dời thùng chắn lối nhưng còn giấy gói rơi trên sàn. Hàng xóm cần bạn dọn thêm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người bị ảnh hưởng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8fc6b206-5cca-5a7e-aebb-f2de80ded877-u01",
          "speaker_id": "b",
          "ja": "箱は動きましたが、紙がまだ床にあります。",
          "vi": "Thùng đã dời rồi nhưng vẫn còn giấy trên sàn."
        },
        {
          "id": "8fc6b206-5cca-5a7e-aebb-f2de80ded877-u02",
          "speaker_id": "a",
          "ja": "すみません。どこまで片づければいいですか。",
          "vi": "Xin lỗi. Tôi cần dọn đến phần nào?"
        },
        {
          "id": "8fc6b206-5cca-5a7e-aebb-f2de80ded877-u03",
          "speaker_id": "b",
          "ja": "この紙を全部拾ってください。",
          "vi": "Xin nhặt hết những tờ giấy này."
        },
        {
          "id": "8fc6b206-5cca-5a7e-aebb-f2de80ded877-u04",
          "speaker_id": "a",
          "ja": "分かりました。拾ってからお知らせします。",
          "vi": "Tôi hiểu. Nhặt xong tôi sẽ báo."
        }
      ],
      "admin": {
        "source_refs": [
          "apology",
          "complaint"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8fc6b206-5cca-5a7e-aebb-f2de80ded877-u01": {
            "kind": "original_extension"
