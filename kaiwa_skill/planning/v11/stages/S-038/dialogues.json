    {
      "situation_uid": "0b8a5238-ae2a-5b21-b877-aa9800ee0258",
      "event_id": "E04",
      "context_vi": "Hôm qua bạn đã báo một đèn hành lang chớp tắt ở nhà chung hư cấu. Hôm nay bạn nhắc người phụ trách vì đèn vẫn vậy; bạn không tự sửa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người liên quan",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0b8a5238-ae2a-5b21-b877-aa9800ee0258-u01",
          "speaker_id": "a",
          "ja": "昨日お伝えした廊下のライトですが、まだ点滅しています。",
          "vi": "Đèn hành lang tôi đã báo hôm qua vẫn đang nhấp nháy ạ."
        },
        {
          "id": "0b8a5238-ae2a-5b21-b877-aa9800ee0258-u02",
          "speaker_id": "b",
          "ja": "ご連絡ありがとうございます。確認がまだでした。",
          "vi": "Cảm ơn anh đã báo. Chúng tôi vẫn chưa kiểm tra ạ."
        },
        {
          "id": "0b8a5238-ae2a-5b21-b877-aa9800ee0258-u03",
          "speaker_id": "a",
          "ja": "いつごろ確認できそうですか。",
          "vi": "Khoảng khi nào chị kiểm tra được?"
        },
        {
          "id": "0b8a5238-ae2a-5b21-b877-aa9800ee0258-u04",
          "speaker_id": "b",
          "ja": "担当者に聞いて、予定をお知らせします。",
          "vi": "Tôi hỏi người phụ trách rồi báo lịch ạ."
        }
      ],
