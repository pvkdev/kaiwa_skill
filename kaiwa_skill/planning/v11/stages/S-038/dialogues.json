    {
      "situation_uid": "3765d7b0-9400-535d-8d2e-8ba1c03b5442",
      "event_id": "E02",
      "context_vi": "Người bạn xin lỗi vì mang nhầm sách của bạn nhưng chưa trả; bạn cần dùng sách cho buổi học sáng mai. Bạn nói rõ việc còn vướng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người vừa xin lỗi",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "3765d7b0-9400-535d-8d2e-8ba1c03b5442-u01",
          "speaker_id": "b",
          "ja": "本を間違えて持って帰りました。ごめんなさい。",
          "vi": "Tôi mang nhầm sách của bạn về. Xin lỗi."
        },
        {
          "id": "3765d7b0-9400-535d-8d2e-8ba1c03b5442-u02",
          "speaker_id": "a",
          "ja": "分かりました。でも明日の朝、その本が必要です。",
          "vi": "Tôi hiểu. Nhưng sáng mai tôi cần quyển đó."
        },
        {
          "id": "3765d7b0-9400-535d-8d2e-8ba1c03b5442-u03",
          "speaker_id": "b",
          "ja": "まだ家にあります。どう返せばいいですか。",
          "vi": "Sách vẫn ở nhà tôi. Tôi trả thế nào đây?"
        },
        {
          "id": "3765d7b0-9400-535d-8d2e-8ba1c03b5442-u04",
          "speaker_id": "a",
          "ja": "今夜、駅で受け取れますか。",
          "vi": "Tối nay tôi nhận ở ga được không?"
        }
      ],
      "admin": {
