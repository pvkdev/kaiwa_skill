      "context_vi": "Người phụ trách nhà chung hư cấu cần hỏi bộ phận bảo trì về đèn hành lang. Bạn hỏi khi nào nên tự gọi lại để biết kết quả; chưa coi việc đã sửa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người liên quan",
