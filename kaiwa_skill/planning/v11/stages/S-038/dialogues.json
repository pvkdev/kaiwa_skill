    {
      "situation_uid": "a6091f72-cbd8-5da8-855c-3a8fefa8752a",
      "event_id": "E01",
      "context_vi": "Hôm sau bạn gặp lại hàng xóm ở nhà chung. Hôm qua bạn đã dọn hết giấy gói rơi ở lối đi và muốn hỏi còn vướng gì không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người bị ảnh hưởng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "a6091f72-cbd8-5da8-855c-3a8fefa8752a-u01",
          "speaker_id": "a",
          "ja": "昨日の通路は、その後大丈夫でしたか。",
          "vi": "Lối đi hôm qua sau đó ổn chứ ạ?"
        },
        {
          "id": "a6091f72-cbd8-5da8-855c-3a8fefa8752a-u02",
          "speaker_id": "b",
          "ja": "はい。もう通りやすいです。",
          "vi": "Ổn rồi. Giờ đi qua dễ rồi."
        },
        {
          "id": "a6091f72-cbd8-5da8-855c-3a8fefa8752a-u03",
          "speaker_id": "a",
          "ja": "よかったです。今後は箱をそこに置きません。",
          "vi": "Vậy tốt. Từ nay tôi sẽ không để thùng ở đó nữa."
        },
        {
          "id": "a6091f72-cbd8-5da8-855c-3a8fefa8752a-u04",
          "speaker_id": "b",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "apology"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "a6091f72-cbd8-5da8-855c-3a8fefa8752a-u01": {
