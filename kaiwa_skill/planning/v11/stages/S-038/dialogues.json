    {
      "situation_uid": "01ef11a1-1da0-53d8-b8d3-db6a6d520d10",
      "event_id": "E02",
      "context_vi": "Người bạn xin lỗi vì báo muộn về việc đổi giờ gặp. Bạn chấp nhận nhưng cần lần sau được báo sớm để sắp xếp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người vừa xin lỗi",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "01ef11a1-1da0-53d8-b8d3-db6a6d520d10-u01",
          "speaker_id": "b",
          "ja": "時間を変える連絡が遅くなって、ごめんなさい。",
          "vi": "Xin lỗi vì báo đổi giờ trễ."
        },
        {
          "id": "01ef11a1-1da0-53d8-b8d3-db6a6d520d10-u02",
          "speaker_id": "a",
          "ja": "今回は大丈夫です。次は早めに教えてもらえますか。",
          "vi": "Lần này không sao. Lần sau bạn báo sớm hơn được không?"
        },
        {
          "id": "01ef11a1-1da0-53d8-b8d3-db6a6d520d10-u03",
          "speaker_id": "b",
          "ja": "はい。分かった時点で連絡します。",
          "vi": "Được, biết lúc nào tôi sẽ báo ngay lúc đó."
        },
        {
          "id": "01ef11a1-1da0-53d8-b8d3-db6a6d520d10-u04",
          "speaker_id": "a",
          "ja": "ありがとう。それなら予定を変えやすいです。",
          "vi": "Cảm ơn. Vậy tôi dễ đổi lịch hơn."
        }
      ],
      "admin": {
        "source_refs": [
          "apology"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "01ef11a1-1da0-53d8-b8d3-db6a6d520d10-u01": {
