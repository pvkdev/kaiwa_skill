    {
      "situation_uid": "acdfb306-7dab-5c0e-8d2e-bab8839a653a",
      "event_id": "E02",
      "context_vi": "Sau khi bạn nói cần sách vào sáng mai, người bạn đồng ý mang sách ra ga tối nay. Hai người chốt giờ và điểm nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người vừa xin lỗi",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "acdfb306-7dab-5c0e-8d2e-bab8839a653a-u01",
          "speaker_id": "b",
          "ja": "今夜七時に駅の南口へ持って行きます。",
          "vi": "Tối nay 7 giờ tôi mang sách đến cửa nam ga."
        },
        {
          "id": "acdfb306-7dab-5c0e-8d2e-bab8839a653a-u02",
          "speaker_id": "a",
          "ja": "七時、南口ですね。着いたら連絡してください。",
          "vi": "7 giờ, cửa nam nhé. Đến nơi bạn báo tôi."
        },
        {
          "id": "acdfb306-7dab-5c0e-8d2e-bab8839a653a-u03",
          "speaker_id": "b",
          "ja": "はい。そこで直接返します。",
          "vi": "Được. Tôi sẽ trả tận tay ở đó."
        },
        {
          "id": "acdfb306-7dab-5c0e-8d2e-bab8839a653a-u04",
          "speaker_id": "a",
          "ja": "ありがとう。受け取ってから確認します。",
          "vi": "Cảm ơn. Tôi sẽ kiểm tra khi nhận."
        }
      ],
      "admin": {
