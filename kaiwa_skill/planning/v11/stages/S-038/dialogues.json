        {
          "id": "ef33ede4-8b9c-5f31-ba12-653d5f64e426-u04",
          "speaker_id": "a",
          "ja": "お願いします。今ある一つはここに置いてください。",
          "vi": "Nhờ chị. Xin để phần hiện có ở đây."
        }
