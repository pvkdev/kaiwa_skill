    {
      "situation_uid": "b464414d-75a2-595f-9fab-76e3874a1ad6",
      "event_id": "E02",
      "context_vi": "Bạn vừa gợi ý cách ngắt hơi khi tự giới thiệu. Hai người còn một ngày nữa trước buổi phỏng vấn, và bạn đề nghị luyện nói chung một lúc.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn sắp phỏng vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b464414d-75a2-595f-9fab-76e3874a1ad6-u01",
          "speaker_id": "A",
          "ja": "このあと十分だけ、一緒に練習しない？",
          "vi": "Lát nữa mình luyện cùng mười phút nhé?"
        },
        {
          "id": "b464414d-75a2-595f-9fab-76e3874a1ad6-u02",
          "speaker_id": "B",
          "ja": "今日は用事があるんだ。明日の朝ならできるよ。",
          "vi": "Hôm nay tớ có việc. Sáng mai thì luyện được."
        },
        {
          "id": "b464414d-75a2-595f-9fab-76e3874a1ad6-u03",
          "speaker_id": "A",
          "ja": "じゃ、明日の朝九時はどう？ 教室でいい？",
