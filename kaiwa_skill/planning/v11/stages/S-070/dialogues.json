    {
      "situation_uid": "cf45da0d-28a5-5cd5-a639-7a85e527fb91",
      "event_id": "E02",
      "context_vi": "Bạn từng hỏi bạn học lo gì trước buổi phỏng vấn. Giờ buổi phỏng vấn vừa xong. Bạn muốn hỏi thăm và cho bạn ấy tự chọn có kể không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hỏi thăm",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn vừa phỏng vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cf45da0d-28a5-5cd5-a639-7a85e527fb91-u01",
          "speaker_id": "A",
          "ja": "面接、お疲れさま。少し落ち着いた？",
          "vi": "Xong phỏng vấn rồi. Cậu thấy đỡ căng thẳng hơn chưa?"
        },
        {
          "id": "cf45da0d-28a5-5cd5-a639-7a85e527fb91-u02",
          "speaker_id": "B",
          "ja": "うん、話し終わったら少し楽になった。",
          "vi": "Ừ, nói xong tớ thấy nhẹ người hơn một chút."
        },
        {
          "id": "cf45da0d-28a5-5cd5-a639-7a85e527fb91-u03",
          "speaker_id": "A",
          "ja": "どうだったか、話したかったら聞くよ。",
          "vi": "Nếu cậu muốn kể buổi phỏng vấn thế nào, tớ nghe nhé."
        },
        {
          "id": "cf45da0d-28a5-5cd5-a639-7a85e527fb91-u04",
          "speaker_id": "B",
          "ja": "うん。最初の自己紹介は言えたよ。",
          "vi": "Ừ. Phần tự giới thiệu đầu tiên tớ nói được rồi."
        }
      ],
