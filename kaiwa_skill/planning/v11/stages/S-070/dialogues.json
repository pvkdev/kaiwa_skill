    {
      "situation_uid": "fd15026c-9f1b-586a-b783-5a6c86ac9e4f",
      "event_id": "E04",
      "context_vi": "Bạn của bạn hơi ngại gặp nhân viên ở quầy thư viện và nhờ bạn đi cùng. Bạn hỏi ngày giờ và chỗ gặp để có thể giúp vừa đủ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi cùng",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn muốn được đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fd15026c-9f1b-586a-b783-5a6c86ac9e4f-u01",
          "speaker_id": "B",
          "ja": "図書館の窓口に行くんだけど、一緒に来てくれない？",
          "vi": "Tớ phải ra quầy thư viện. Cậu đi cùng tớ được không?"
        },
        {
          "id": "fd15026c-9f1b-586a-b783-5a6c86ac9e4f-u02",
          "speaker_id": "A",
          "ja": "うん。いつ行くの？",
          "vi": "Được. Cậu định đi khi nào?"
        },
        {
          "id": "fd15026c-9f1b-586a-b783-5a6c86ac9e4f-u03",
          "speaker_id": "B",
          "ja": "水曜の午後三時がいいな。",
          "vi": "Ba giờ chiều thứ Tư thì tốt."
        },
        {
          "id": "fd15026c-9f1b-586a-b783-5a6c86ac9e4f-u04",
          "speaker_id": "A",
          "ja": "じゃ、三時に図書館の入口で会おう。",
          "vi": "Vậy ba giờ chiều thứ Tư mình gặp ở cửa thư viện."
        },
        {
          "id": "fd15026c-9f1b-586a-b783-5a6c86ac9e4f-u05",
          "speaker_id": "B",
          "ja": "ありがとう。そこに行くね。",
          "vi": "Cảm ơn cậu. Tớ sẽ ra đó."
        }
      ],
