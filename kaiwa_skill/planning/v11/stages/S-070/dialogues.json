      "context_vi": "Bạn đã hẹn đi cùng tới quầy thư viện lúc ba giờ chiều thứ Tư. Bạn vừa phát sinh lớp bù trùng giờ và muốn báo sớm cùng một cách khác.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đã hẹn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn muốn được đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f4ad33ea-8f93-536c-afbc-dd7c3e6d3652-u01",
          "speaker_id": "A",
          "ja": "ごめん。水曜の午後三時に授業が入って、一緒に行けなくなった。",
          "vi": "Xin lỗi. Tớ có lớp lúc ba giờ chiều thứ Tư nên không đi cùng cậu được nữa."
        },
        {
          "id": "f4ad33ea-8f93-536c-afbc-dd7c3e6d3652-u02",
          "speaker_id": "B",
          "ja": "そっか。一人だとちょっと心配だな。",
          "vi": "Vậy à. Đi một mình tớ hơi lo."
        },
        {
          "id": "f4ad33ea-8f93-536c-afbc-dd7c3e6d3652-u03",
          "speaker_id": "A",
          "ja": "メイさんに聞いてみたら？ よくあの図書館に行くよ。",
          "vi": "Cậu hỏi Mei thử xem? Cậu ấy hay tới thư viện đó."
        },
        {
          "id": "f4ad33ea-8f93-536c-afbc-dd7c3e6d3652-u04",
          "speaker_id": "B",
          "ja": "うん、メイさんに聞いてみる。",
          "vi": "Ừ, tớ thử hỏi Mei."
