    {
      "situation_uid": "77e92c16-cdf2-5d46-ac8b-a4acd4f7f556",
      "event_id": "E03",
      "context_vi": "Bạn của bạn đã được nhận vào lớp tiếng Nhật và vừa học buổi đầu tiên. Khi gặp lại, bạn muốn hỏi ngày đầu ra sao.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hỏi thăm",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn mới đi học",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "77e92c16-cdf2-5d46-ac8b-a4acd4f7f556-u01",
          "speaker_id": "A",
          "ja": "今日が最初の授業だったよね。どうだった？",
          "vi": "Hôm nay là buổi đầu của cậu nhỉ. Thế nào rồi?"
        },
        {
          "id": "77e92c16-cdf2-5d46-ac8b-a4acd4f7f556-u02",
          "speaker_id": "B",
          "ja": "部屋もみんなの名前も覚えなきゃいけなくて、疲れたよ。",
          "vi": "Tớ phải nhớ cả phòng học lẫn tên mọi người nên hơi mệt."
        },
        {
          "id": "77e92c16-cdf2-5d46-ac8b-a4acd4f7f556-u03",
          "speaker_id": "A",
          "ja": "最初は覚えることが多くて、大変だね。",
          "vi": "Lúc đầu nhiều thứ phải nhớ, vất vả nhỉ."
        },
        {
          "id": "77e92c16-cdf2-5d46-ac8b-a4acd4f7f556-u04",
          "speaker_id": "B",
          "ja": "うん。でも、同じクラスの人が教室まで案内してくれたよ。",
          "vi": "Ừ. Nhưng có một bạn cùng lớp dẫn tớ đến phòng học."
        }
      ],
