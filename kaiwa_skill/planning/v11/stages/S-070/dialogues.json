          }
        }
      }
    },
    {
      "situation_uid": "8b1731e9-9a10-5ef6-a9ff-6bad6997dbb8",
      "event_id": "E02",
      "context_vi": "Bạn học sắp đi phỏng vấn và nói đang lo. Bạn muốn hỏi cụ thể phần nào khó để người đó có thể nói ra điều mình đang nghĩ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn sắp phỏng vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8b1731e9-9a10-5ef6-a9ff-6bad6997dbb8-u01",
          "speaker_id": "B",
          "ja": "明日の面接、今から心配だよ。",
          "vi": "Tớ lo ngay từ bây giờ về buổi phỏng vấn ngày mai."
        },
        {
          "id": "8b1731e9-9a10-5ef6-a9ff-6bad6997dbb8-u02",
          "speaker_id": "A",
          "ja": "面接の何が一番心配？",
          "vi": "Cậu lo nhất phần nào của buổi phỏng vấn?"
        },
        {
          "id": "8b1731e9-9a10-5ef6-a9ff-6bad6997dbb8-u03",
          "speaker_id": "B",
          "ja": "最初の自己紹介。言葉が出なかったらどうしよう。",
          "vi": "Phần giới thiệu đầu tiên. Lỡ tớ không nói được thì sao."
        },
        {
          "id": "8b1731e9-9a10-5ef6-a9ff-6bad6997dbb8-u04",
          "speaker_id": "A",
          "ja": "最初の自己紹介が気になるんだね。",
          "vi": "Cậu đang lo nhất chuyện tự giới thiệu lúc đầu nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "empathy"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8b1731e9-9a10-5ef6-a9ff-6bad6997dbb8-u01": {
