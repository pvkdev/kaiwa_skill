    {
      "situation_uid": "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31",
      "event_id": "E01",
      "context_vi": "Bạn thấy bạn cùng lớp im lặng và vừa ngỏ ý lắng nghe. Bạn ấy muốn kể chuyện trong giờ học. Bạn lắng nghe và hỏi bạn ấy muốn được nghe hay muốn cùng tìm cách.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn lắng nghe",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31-u01",
          "speaker_id": "B",
          "ja": "さっき授業でうまく話せなかったんだ。",
          "vi": "Lúc nãy trong lớp tớ nói không được trôi chảy."
        },
        {
          "id": "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31-u02",
          "speaker_id": "A",
          "ja": "それは大変だったね。",
          "vi": "Vậy thì khó thật nhỉ."
        },
        {
          "id": "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31-u03",
          "speaker_id": "A",
          "ja": "聞くだけがいい？ それとも、どうするか一緒に考える？",
          "vi": "Cậu muốn tớ nghe thôi, hay muốn mình cùng nghĩ cách?"
        },
        {
          "id": "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31-u04",
          "speaker_id": "B",
          "ja": "今は聞いてくれるだけでいいよ。",
          "vi": "Giờ cậu nghe tớ kể thôi là được."
        },
        {
          "id": "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31-u05",
          "speaker_id": "A",
          "ja": "うん、聞くよ。",
          "vi": "Ừ, tớ nghe đây."
        }
      ],
      "admin": {
        "source_refs": [
          "empathy"
        ],
        "specialty_item_ids": [
          "sj-so-16-b07-37"
        ],
        "turn_origins": {
          "cc3066d8-f7b8-55c1-af6d-0e19f0ef2d31-u01": {
