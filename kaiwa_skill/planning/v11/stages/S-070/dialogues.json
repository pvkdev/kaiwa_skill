    {
      "situation_uid": "390ce8e0-8aee-5799-a9de-354360229878",
      "event_id": "E03",
      "context_vi": "Bạn của bạn vừa nhận tin và nghĩ mình đã được nhận vào lớp tiếng Nhật. Bạn chia vui, hỏi dự định tiếp theo và chừa chỗ để bạn ấy xác nhận thông báo.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn chia vui",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đăng ký lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "390ce8e0-8aee-5799-a9de-354360229878-u01",
          "speaker_id": "B",
          "ja": "連絡が来たよ。日本語のクラス、受かったみたい。",
          "vi": "Có tin rồi. Hình như tớ đỗ lớp tiếng Nhật rồi."
        },
        {
          "id": "390ce8e0-8aee-5799-a9de-354360229878-u02",
          "speaker_id": "A",
          "ja": "わあ、おめでとう！",
          "vi": "Ôi, chúc mừng cậu!"
        },
        {
          "id": "390ce8e0-8aee-5799-a9de-354360229878-u03",
          "speaker_id": "A",
          "ja": "次は何をするの？",
          "vi": "Tiếp theo cậu định làm gì?"
        },
        {
          "id": "390ce8e0-8aee-5799-a9de-354360229878-u04",
          "speaker_id": "B",
          "ja": "まず、授業がいつ始まるか見るよ。",
          "vi": "Đầu tiên tớ xem lớp bắt đầu khi nào."
        }
      ],
      "admin": {
