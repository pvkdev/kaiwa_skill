    {
      "situation_uid": "d4c0e198-ab35-5bbe-9cac-a296254199c1",
      "event_id": "E03",
      "context_vi": "Bạn vừa chúc mừng người bạn vì nghĩ họ đã đỗ lớp tiếng Nhật. Bạn ấy đọc kỹ và nhận ra thông báo chưa phải kết quả cuối. Bạn sửa lại lời chúc sớm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn lắng nghe",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đăng ký lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d4c0e198-ab35-5bbe-9cac-a296254199c1-u01",
          "speaker_id": "B",
          "ja": "よく読んだら、申し込みを受け付けたって書いてあるだけだった。",
          "vi": "Đọc kỹ mới thấy họ chỉ báo đã nhận đơn thôi."
        },
        {
          "id": "d4c0e198-ab35-5bbe-9cac-a296254199c1-u02",
          "speaker_id": "A",
          "ja": "そっか。おめでとうって言うのは早かったね。",
          "vi": "Ra vậy. Tớ chúc mừng hơi sớm nhỉ."
        },
        {
          "id": "d4c0e198-ab35-5bbe-9cac-a296254199c1-u03",
          "speaker_id": "B",
          "ja": "言い方が悪かったね。ごめん。",
          "vi": "Tớ nói chưa rõ. Xin lỗi cậu."
        },
        {
          "id": "d4c0e198-ab35-5bbe-9cac-a296254199c1-u04",
          "speaker_id": "A",
          "ja": "気にしないで。結果が出たら教えてね。",
          "vi": "Cậu đừng bận tâm. Có kết quả thì kể tớ nhé."
        }
      ],
