  "dialogues": [
    {
      "situation_uid": "e82756d8-e154-5241-b6e7-6f86b10b113f",
      "event_id": "E01",
      "context_vi": "Trong giờ nghỉ, bạn thấy bạn cùng lớp bình thường hay trò chuyện hôm nay lại ngồi im. Bạn hỏi thăm và để bạn ấy tự chọn có muốn kể không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hỏi thăm",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e82756d8-e154-5241-b6e7-6f86b10b113f-u01",
          "speaker_id": "A",
          "ja": "今日は静かだね。大丈夫？",
          "vi": "Hôm nay cậu ít nói nhỉ. Cậu ổn không?"
        },
        {
          "id": "e82756d8-e154-5241-b6e7-6f86b10b113f-u02",
          "speaker_id": "B",
          "ja": "うん。ちょっと疲れてて。",
          "vi": "Ừ. Tớ hơi mệt thôi."
        },
        {
          "id": "e82756d8-e154-5241-b6e7-6f86b10b113f-u03",
          "speaker_id": "A",
          "ja": "そっか。話したくなったら、聞くよ。",
          "vi": "Vậy à. Khi nào cậu muốn kể thì tớ nghe nhé."
        },
        {
          "id": "e82756d8-e154-5241-b6e7-6f86b10b113f-u04",
          "speaker_id": "B",
          "ja": "ありがとう。",
          "vi": "Cảm ơn cậu."
        }
      ],
      "admin": {
        "source_refs": [
          "empathy"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e82756d8-e154-5241-b6e7-6f86b10b113f-u01": {
            "kind": "original_extension"
