      "turns": [
        {
          "id": "2a80f09e-df1e-5251-8eb4-075a4764bfb2-u01",
          "speaker_id": "A",
          "ja": "心配だったこと、話してくれてありがとう。",
          "vi": "Cảm ơn cậu đã nói cho tớ biết cậu đang lo."
        },
        {
          "id": "2a80f09e-df1e-5251-8eb4-075a4764bfb2-u02",
          "speaker_id": "B",
          "ja": "うん。話したら少しすっきりした。",
          "vi": "Ừ. Nói ra tớ thấy nhẹ lòng hơn một chút."
        },
        {
          "id": "2a80f09e-df1e-5251-8eb4-075a4764bfb2-u03",
          "speaker_id": "A",
          "ja": "よかった。細かいことは話さなくていいよ。",
          "vi": "Tốt quá. Cậu không cần kể cụ thể hơn đâu."
        },
        {
          "id": "2a80f09e-df1e-5251-8eb4-075a4764bfb2-u04",
          "speaker_id": "A",
          "ja": "水曜の午後三時に入口でね。",
          "vi": "Ba giờ chiều thứ Tư ở cửa thư viện nhé."
        },
        {
          "id": "2a80f09e-df1e-5251-8eb4-075a4764bfb2-u05",
          "speaker_id": "B",
          "ja": "うん、また水曜に。",
          "vi": "Ừ, thứ Tư gặp lại."
