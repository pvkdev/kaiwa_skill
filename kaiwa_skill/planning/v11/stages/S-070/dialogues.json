    {
      "situation_uid": "42d25d3c-be5d-58b2-ad46-da319a77c4b8",
      "event_id": "E03",
      "context_vi": "Bạn của bạn đã có thông báo chính thức được nhận vào lớp và rủ bạn đi ăn mừng tối nay. Bạn không đi được và đề xuất cách mừng khác.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn chia vui",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đã đỗ lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "42d25d3c-be5d-58b2-ad46-da319a77c4b8-u01",
          "speaker_id": "B",
          "ja": "合格の連絡が来たよ。今夜、何か食べに行かない？ お祝いしようよ。",
          "vi": "Có tin đỗ rồi. Tối nay mình đi ăn gì đó mừng nhé?"
        },
        {
          "id": "42d25d3c-be5d-58b2-ad46-da319a77c4b8-u02",
          "speaker_id": "A",
          "ja": "おめでとう！ 今夜は無理だけど、明日ケーキを食べない？",
          "vi": "Chúc mừng cậu! Tối nay tớ không đi được, nhưng mai mình đi ăn bánh nhé?"
        },
        {
          "id": "42d25d3c-be5d-58b2-ad46-da319a77c4b8-u03",
          "speaker_id": "B",
          "ja": "いいね。明日の午後なら空いてるよ。",
          "vi": "Hay đấy. Chiều mai tớ rảnh."
        },
        {
          "id": "42d25d3c-be5d-58b2-ad46-da319a77c4b8-u04",
          "speaker_id": "A",
          "ja": "じゃ、授業が終わったら行こう。",
          "vi": "Vậy tan học mình đi."
        }
      ],
