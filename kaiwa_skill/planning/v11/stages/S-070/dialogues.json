          }
        }
      }
    },
    {
      "situation_uid": "de4c955a-1ee4-5d1d-8b51-8668058fc37e",
      "event_id": "E01",
      "context_vi": "Bạn cùng lớp nói hơi mệt và muốn ngồi một mình một lúc. Bạn tôn trọng và hỏi xem có cần bạn lấy thứ gì không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hỏi thăm",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn muốn nghỉ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "de4c955a-1ee4-5d1d-8b51-8668058fc37e-u01",
          "speaker_id": "B",
          "ja": "ごめん。今は一人で休みたい。",
          "vi": "Xin lỗi. Giờ tớ muốn nghỉ một mình."
        },
        {
          "id": "de4c955a-1ee4-5d1d-8b51-8668058fc37e-u02",
          "speaker_id": "A",
          "ja": "うん。一人でゆっくりしてね。",
          "vi": "Ừ. Cậu cứ nghỉ cho thoải mái nhé."
        },
        {
          "id": "de4c955a-1ee4-5d1d-8b51-8668058fc37e-u03",
          "speaker_id": "A",
          "ja": "何か持ってこようか。",
          "vi": "Cậu có cần tớ lấy gì không?"
        },
        {
          "id": "de4c955a-1ee4-5d1d-8b51-8668058fc37e-u04",
          "speaker_id": "B",
          "ja": "じゃ、水をお願いしてもいい？",
          "vi": "Vậy lấy giúp tớ chút nước được không?"
        },
        {
          "id": "de4c955a-1ee4-5d1d-8b51-8668058fc37e-u05",
          "speaker_id": "A",
          "ja": "いいよ。水を持ってくるね。じゃ、またあとで。",
          "vi": "Được. Tớ mang nước lại nhé. Lát gặp lại cậu."
        }
      ],
      "admin": {
        "source_refs": [
          "empathy"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "de4c955a-1ee4-5d1d-8b51-8668058fc37e-u01": {
