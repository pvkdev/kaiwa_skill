    {
      "situation_uid": "5922597c-1945-5354-aec7-a1896ee6d2b3",
      "event_id": "E01",
      "context_vi": "Bạn đang lắng nghe chuyện bạn cùng lớp nói không trôi chảy. Bạn nghe từ 当てられた lần đầu và muốn hỏi nghĩa mà không ngắt mạch kể quá lâu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn lắng nghe",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5922597c-1945-5354-aec7-a1896ee6d2b3-u01",
          "speaker_id": "B",
          "ja": "急に当てられて、何も言えなかった。",
          "vi": "Tớ bất ngờ bị gọi trả lời, chẳng nói được gì."
        },
        {
          "id": "5922597c-1945-5354-aec7-a1896ee6d2b3-u02",
          "speaker_id": "A",
          "ja": "ごめん。「当てられた」って、どういう意味？",
          "vi": "Cho tớ hỏi chút. “当てられた” nghĩa là gì?"
        },
        {
          "id": "5922597c-1945-5354-aec7-a1896ee6d2b3-u03",
          "speaker_id": "B",
          "ja": "先生に名前を呼ばれて、答えることになったんだ。",
          "vi": "Cô gọi tên tớ để trả lời ấy."
        },
        {
          "id": "5922597c-1945-5354-aec7-a1896ee6d2b3-u04",
          "speaker_id": "B",
          "ja": "説明しなくてごめんね。",
          "vi": "Xin lỗi, tớ kể mà chưa nói rõ."
        },
        {
          "id": "5922597c-1945-5354-aec7-a1896ee6d2b3-u05",
          "speaker_id": "A",
          "ja": "気にしないで。今わかったよ。続き、聞かせて。",
          "vi": "Cậu đừng bận tâm. Giờ tớ hiểu rồi. Kể tiếp cho tớ nghe nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "reassure"
        ],
        "specialty_item_ids": [
          "sj-so-16-b07-124"
        ],
        "turn_origins": {
          "5922597c-1945-5354-aec7-a1896ee6d2b3-u01": {
            "kind": "original_extension"
          },
          "5922597c-1945-5354-aec7-a1896ee6d2b3-u02": {
