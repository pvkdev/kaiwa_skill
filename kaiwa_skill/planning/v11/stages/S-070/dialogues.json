        }
      }
    },
    {
      "situation_uid": "68aefb6a-0cb4-525b-ae85-7427cf7770ba",
      "event_id": "E02",
      "context_vi": "Bạn vừa nghe bạn học tập giới thiệu trước phỏng vấn. Người đó lo sẽ nói quá nhanh. Bạn muốn động viên bằng một điều thực sự nghe được.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn sắp phỏng vấn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "68aefb6a-0cb4-525b-ae85-7427cf7770ba-u01",
          "speaker_id": "B",
          "ja": "本番で早口になったら、どうしよう。",
          "vi": "Lúc phỏng vấn mà tớ nói nhanh quá thì sao nhỉ."
        },
        {
          "id": "68aefb6a-0cb4-525b-ae85-7427cf7770ba-u02",
          "speaker_id": "A",
          "ja": "今の最初の一文は、はっきり聞こえたよ。",
          "vi": "Câu đầu cậu vừa nói, tớ nghe rõ lắm."
        },
        {
          "id": "68aefb6a-0cb4-525b-ae85-7427cf7770ba-u03",
          "speaker_id": "B",
          "ja": "そう？ 最初は大丈夫だった？",
          "vi": "Thật à? Phần đầu ổn hả?"
        },
        {
          "id": "68aefb6a-0cb4-525b-ae85-7427cf7770ba-u04",
          "speaker_id": "A",
          "ja": "うん。名前を言ったあと、一度息をつくといいね。",
          "vi": "Ừ. Nói tên xong, cậu ngừng lại lấy hơi một chút nhé."
        },
        {
          "id": "68aefb6a-0cb4-525b-ae85-7427cf7770ba-u05",
          "speaker_id": "B",
          "ja": "わかった。次はそうしてみる。",
          "vi": "Ừ, lần sau tớ thử làm vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "empathy"
        ],
        "specialty_item_ids": [
          "sj-so-16-b11-1"
        ],
        "turn_origins": {
          "68aefb6a-0cb4-525b-ae85-7427cf7770ba-u01": {
            "kind": "original_extension"
