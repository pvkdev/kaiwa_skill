    {
      "situation_uid": "95fb1914-13c7-5108-a674-3c6358adfe5f",
      "event_id": "E03",
      "context_vi": "Sau khi xem một căn giả định có tiền thuê 70.000 yên mỗi tháng, bạn muốn biết còn khoản nào trả thêm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "95fb1914-13c7-5108-a674-3c6358adfe5f-u01",
          "speaker_id": "a",
          "ja": "家賃のほかに、毎月払うお金はありますか。",
          "vi": "Ngoài tiền thuê, có khoản nào phải trả hằng tháng không ạ?"
        },
        {
          "id": "95fb1914-13c7-5108-a674-3c6358adfe5f-u02",
          "speaker_id": "b",
          "ja": "この部屋は管理費が毎月五千円です。",
          "vi": "Căn này có phí quản lý 5.000 yên mỗi tháng."
        },
        {
          "id": "95fb1914-13c7-5108-a674-3c6358adfe5f-u03",
          "speaker_id": "a",
          "ja": "では、毎月七万五千円ですね。",
          "vi": "Vậy mỗi tháng là 75.000 yên nhỉ."
        },
        {
          "id": "95fb1914-13c7-5108-a674-3c6358adfe5f-u04",
          "speaker_id": "b",
          "ja": "はい、家賃と管理費で七万五千円です。",
          "vi": "Vâng, tiền thuê và phí quản lý là 75.000 yên."
        }
      ],
      "admin": {
