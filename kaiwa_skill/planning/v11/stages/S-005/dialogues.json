          },
          "6933bfcc-26fe-59bd-a232-1a5cf824d04e-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "a186d05c-37d6-5cd4-a23e-c8ac29dbccd6",
      "event_id": "E02",
      "context_vi": "Bạn gọi cho môi giới về căn phòng đã thấy trong tin đăng. Bạn chưa biết căn còn nhận lịch xem hay không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a186d05c-37d6-5cd4-a23e-c8ac29dbccd6-u01",
          "speaker_id": "a",
          "ja": "先ほど広告で見た部屋は、まだ見られますか。",
          "vi": "Căn phòng tôi vừa xem trên tin đăng còn xem được không ạ?"
        },
        {
          "id": "a186d05c-37d6-5cd4-a23e-c8ac29dbccd6-u02",
          "speaker_id": "b",
          "ja": "部屋の番号を教えてください。",
          "vi": "Chị cho tôi mã phòng nhé."
        },
        {
          "id": "a186d05c-37d6-5cd4-a23e-c8ac29dbccd6-u03",
          "speaker_id": "a",
          "ja": "二〇一号室です。",
          "vi": "Phòng 201 ạ."
        },
        {
          "id": "a186d05c-37d6-5cd4-a23e-c8ac29dbccd6-u04",
          "speaker_id": "b",
          "ja": "確認します。はい、まだ見られます。",
          "vi": "Để tôi kiểm. Vâng, phòng đó vẫn xem được."
        }
      ],
      "admin": {
        "source_refs": [
          "housing"
        ],
        "specialty_item_ids": [
          "sj-so-01-b11-41"
        ],
        "turn_origins": {
