    {
      "situation_uid": "88e4092e-4749-5fa5-984b-db8f7f4d3d1d",
      "event_id": "E03",
      "context_vi": "Bạn xem một căn có tiền thuê 70.000 yên và phí quản lý 5.000 yên. Bạn tưởng phí quản lý chỉ trả một lần nên hỏi lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "88e4092e-4749-5fa5-984b-db8f7f4d3d1d-u01",
          "speaker_id": "a",
          "ja": "管理費の五千円は、最初だけですか。",
          "vi": "Phí quản lý 5.000 yên chỉ trả lúc đầu thôi ạ?"
        },
        {
          "id": "88e4092e-4749-5fa5-984b-db8f7f4d3d1d-u02",
          "speaker_id": "b",
          "ja": "いいえ、この部屋では毎月です。",
          "vi": "Không, với căn này thì trả hằng tháng ạ."
        },
        {
          "id": "88e4092e-4749-5fa5-984b-db8f7f4d3d1d-u03",
          "speaker_id": "a",
          "ja": "あ、毎月ですか。",
          "vi": "À, hằng tháng ạ?"
        }
      ],
      "admin": {
        "source_refs": [
