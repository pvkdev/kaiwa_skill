    {
      "situation_uid": "5698b2d3-ff11-572d-bffb-7e0727d7e15e",
      "event_id": "E02",
      "context_vi": "Sau sáu giờ tối, bạn chưa nhận được cuộc gọi cập nhật như môi giới đã hẹn về giờ xem căn 201. Bạn gọi lại để hỏi tình hình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5698b2d3-ff11-572d-bffb-7e0727d7e15e-u01",
          "speaker_id": "a",
          "ja": "リンです。六時までに連絡をいただく予定でした。見学の時間は決まりましたか。",
          "vi": "Tôi là Linh. Anh hẹn báo trước sáu giờ. Giờ xem phòng đã chốt chưa ạ?"
        },
        {
          "id": "5698b2d3-ff11-572d-bffb-7e0727d7e15e-u02",
          "speaker_id": "b",
          "ja": "連絡が遅くなり、すみません。まだ決まっていません。",
          "vi": "Xin lỗi vì báo muộn. Giờ vẫn chưa chốt ạ."
        },
        {
          "id": "5698b2d3-ff11-572d-bffb-7e0727d7e15e-u03",
          "speaker_id": "a",
          "ja": "では、いつまた聞けばいいですか。",
          "vi": "Vậy khi nào tôi nên hỏi lại ạ?"
        },
        {
          "id": "5698b2d3-ff11-572d-bffb-7e0727d7e15e-u04",
          "speaker_id": "b",
          "ja": "明日の昼に、もう一度ご連絡します。",
          "vi": "Trưa mai tôi sẽ liên lạc lại ạ."
        },
        {
          "id": "5698b2d3-ff11-572d-bffb-7e0727d7e15e-u05",
          "speaker_id": "a",
          "ja": "わかりました。明日の昼ですね。",
          "vi": "Tôi hiểu rồi. Trưa mai nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "housing",
          "repeat"
