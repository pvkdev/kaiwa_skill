    {
      "situation_uid": "fd2e2940-b78f-50c5-9dcb-bef0ea543ef7",
      "event_id": "E03",
      "context_vi": "Tiếp lời giải thích rằng phí quản lý 5.000 yên của căn này tính hằng tháng. Bạn muốn môi giới tách rõ tiền trả mỗi tháng và một khoản đặt cọc lúc đầu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fd2e2940-b78f-50c5-9dcb-bef0ea543ef7-u01",
          "speaker_id": "a",
          "ja": "毎月のお金と、最初のお金を分けて教えてください。",
          "vi": "Anh tách giúp tôi khoản trả hằng tháng và khoản trả lúc đầu nhé."
        },
        {
          "id": "fd2e2940-b78f-50c5-9dcb-bef0ea543ef7-u02",
          "speaker_id": "b",
          "ja": "毎月は家賃七万円と管理費五千円です。",
          "vi": "Hằng tháng là 70.000 yên tiền thuê và 5.000 yên phí quản lý."
        },
        {
          "id": "fd2e2940-b78f-50c5-9dcb-bef0ea543ef7-u03",
          "speaker_id": "a",
          "ja": "最初に払うお金は？",
          "vi": "Còn khoản trả lúc đầu ạ?"
        },
        {
          "id": "fd2e2940-b78f-50c5-9dcb-bef0ea543ef7-u04",
          "speaker_id": "b",
          "ja": "この部屋の敷金は七万円です。ほかの費用も確認します。",
          "vi": "Tiền đặt cọc của căn này là 70.000 yên. Tôi sẽ kiểm thêm các khoản khác."
        },
        {
          "id": "fd2e2940-b78f-50c5-9dcb-bef0ea543ef7-u05",
          "speaker_id": "a",
          "ja": "毎月七万五千円、敷金は最初ですね。",
          "vi": "Mỗi tháng 75.000 yên, còn đặt cọc trả lúc đầu nhỉ."
        }
      ],
