    {
      "situation_uid": "1ad577f6-ed86-504d-85b2-cb40d80002a4",
      "event_id": "E02",
      "context_vi": "Bạn đã đến văn phòng môi giới để xem căn 201, nhưng lúc này căn đó không thể xem. Bạn muốn hỏi có căn khác xem được ngay không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1ad577f6-ed86-504d-85b2-cb40d80002a4-u01",
          "speaker_id": "b",
          "ja": "すみません。二〇一号室は今、見られません。",
          "vi": "Xin lỗi chị. Giờ không xem được phòng 201."
        },
        {
          "id": "1ad577f6-ed86-504d-85b2-cb40d80002a4-u02",
          "speaker_id": "a",
          "ja": "ほかに、今見られる部屋はありますか。",
          "vi": "Có phòng khác xem được ngay bây giờ không ạ?"
        },
        {
          "id": "1ad577f6-ed86-504d-85b2-cb40d80002a4-u03",
          "speaker_id": "b",
          "ja": "二〇三号室なら、今見られます。",
          "vi": "Phòng 203 thì xem được ngay ạ."
        },
        {
          "id": "1ad577f6-ed86-504d-85b2-cb40d80002a4-u04",
          "speaker_id": "a",
          "ja": "では、二〇三号室を見たいです。",
          "vi": "Vậy tôi muốn xem phòng 203 ạ."
        }
      ],
      "admin": {
