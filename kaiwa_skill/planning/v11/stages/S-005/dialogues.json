    {
      "situation_uid": "0a33c77f-9a7b-540f-89ed-9e07ce789090",
      "event_id": "E02",
      "context_vi": "Môi giới đã xác nhận căn 201 có thể xem. Bạn muốn chốt một cuộc gặp giả định vào thứ Ba lúc ba giờ chiều tại cửa bắc ga Aoba.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0a33c77f-9a7b-540f-89ed-9e07ce789090-u01",
          "speaker_id": "a",
          "ja": "火曜日の午後三時に見られますか。",
          "vi": "Chiều thứ Ba lúc ba giờ tôi đến xem được không ạ?"
        },
        {
          "id": "0a33c77f-9a7b-540f-89ed-9e07ce789090-u02",
          "speaker_id": "b",
          "ja": "はい。青葉駅の北口で会いましょう。",
          "vi": "Vâng. Mình gặp ở cửa bắc ga Aoba nhé."
        },
        {
          "id": "0a33c77f-9a7b-540f-89ed-9e07ce789090-u03",
          "speaker_id": "a",
          "ja": "火曜日の三時、北口ですね。",
          "vi": "Thứ Ba ba giờ, cửa bắc nhỉ."
        },
        {
          "id": "0a33c77f-9a7b-540f-89ed-9e07ce789090-u04",
          "speaker_id": "b",
          "ja": "はい、お待ちしています。",
          "vi": "Vâng, tôi đợi chị."
        }
      ],
      "admin": {
        "source_refs": [
          "housing"
        ],
        "specialty_item_ids": [],
