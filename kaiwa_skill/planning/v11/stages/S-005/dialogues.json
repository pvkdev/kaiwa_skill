            "kind": "original_extension"
          },
          "12973094-d6e4-52cc-9279-1c12793753d4-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "02816a04-fab4-50e8-9ef5-b8a1a687eaff",
      "event_id": "E01",
      "context_vi": "Nhân viên hỏi bạn sẽ ở một mình hay cùng người khác. Bạn dự định sống một mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "02816a04-fab4-50e8-9ef5-b8a1a687eaff-u01",
          "speaker_id": "b",
          "ja": "何人で住みますか。",
          "vi": "Chị sẽ ở mấy người ạ?"
        },
        {
          "id": "02816a04-fab4-50e8-9ef5-b8a1a687eaff-u02",
          "speaker_id": "a",
          "ja": "一人で住みます。",
          "vi": "Tôi ở một mình ạ."
        },
        {
          "id": "02816a04-fab4-50e8-9ef5-b8a1a687eaff-u03",
          "speaker_id": "b",
          "ja": "わかりました。一人用の部屋を探します。",
          "vi": "Tôi hiểu. Để tôi tìm phòng cho một người."
        }
      ],
      "admin": {
        "source_refs": [
          "housing"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "02816a04-fab4-50e8-9ef5-b8a1a687eaff-u01": {
            "kind": "original_extension"
          },
