            "kind": "original_extension"
          },
          "02816a04-fab4-50e8-9ef5-b8a1a687eaff-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "06e9eb1c-74bc-54b9-8630-5581c7fb892b",
      "event_id": "E01",
      "context_vi": "Bạn đi tàu hằng ngày trên tuyến đi qua ga Aoba. Ở văn phòng môi giới, bạn muốn biết có phòng gần ga đó không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "06e9eb1c-74bc-54b9-8630-5581c7fb892b-u01",
          "speaker_id": "a",
          "ja": "毎日、青葉駅を使います。駅の近くに部屋はありますか。",
          "vi": "Ngày nào tôi cũng đi tàu ở ga Aoba. Có phòng gần ga không ạ?"
        },
        {
          "id": "06e9eb1c-74bc-54b9-8630-5581c7fb892b-u02",
          "speaker_id": "b",
          "ja": "一つあります。駅から歩いて十分です。",
          "vi": "Có một phòng. Đi bộ từ ga mất mười phút."
        },
        {
          "id": "06e9eb1c-74bc-54b9-8630-5581c7fb892b-u03",
          "speaker_id": "a",
          "ja": "その部屋を見たいです。",
          "vi": "Tôi muốn xem phòng đó ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "housing"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "06e9eb1c-74bc-54b9-8630-5581c7fb892b-u01": {
            "kind": "original_extension"
          },
          "06e9eb1c-74bc-54b9-8630-5581c7fb892b-u02": {
            "kind": "original_extension"
          },
          "06e9eb1c-74bc-54b9-8630-5581c7fb892b-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "1ccf940a-fa72-5202-8968-073eea0cbd0b",
      "event_id": "E01",
      "context_vi": "Ở văn phòng môi giới, bạn tìm phòng gần ga Aoba dưới 70.000 yên tiền thuê mỗi tháng nhưng không có. Bạn có nuôi mèo, nên muốn hỏi phòng xa ga hơn mà vẫn có thể xem.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1ccf940a-fa72-5202-8968-073eea0cbd0b-u01",
          "speaker_id": "b",
          "ja": "駅の近くで七万円以下の部屋はありません。",
          "vi": "Gần ga không có phòng nào tiền thuê dưới 70.000 yên ạ."
        },
        {
          "id": "1ccf940a-fa72-5202-8968-073eea0cbd0b-u02",
          "speaker_id": "a",
          "ja": "少し遠い部屋はありますか。",
          "vi": "Có phòng nào xa ga hơn một chút không ạ?"
        },
        {
          "id": "1ccf940a-fa72-5202-8968-073eea0cbd0b-u03",
          "speaker_id": "b",
          "ja": "一つあります。でも、その部屋はペットはだめです。",
          "vi": "Có một phòng. Nhưng phòng đó không nhận người nuôi thú cưng."
        },
        {
          "id": "1ccf940a-fa72-5202-8968-073eea0cbd0b-u04",
          "speaker_id": "a",
          "ja": "そうですか。私は猫を飼っています。",
          "vi": "Vậy à. Tôi có nuôi mèo."
        }
      ],
      "admin": {
        "source_refs": [
          "housing"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1ccf940a-fa72-5202-8968-073eea0cbd0b-u01": {
            "kind": "original_extension"
          },
