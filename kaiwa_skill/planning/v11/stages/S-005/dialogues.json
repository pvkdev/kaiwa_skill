    {
      "situation_uid": "f8ec13bc-c59b-590b-a45d-19a4f5e97db9",
      "event_id": "E03",
      "context_vi": "Sau khi xem căn phòng, bạn chưa quyết định. Bạn muốn suy nghĩ đến thứ Sáu rồi liên lạc lại; bạn hiểu căn chưa được giữ chỗ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f8ec13bc-c59b-590b-a45d-19a4f5e97db9-u01",
          "speaker_id": "a",
          "ja": "金曜日まで考えてもいいですか。",
          "vi": "Cho tôi suy nghĩ đến thứ Sáu được không ạ?"
        },
        {
          "id": "f8ec13bc-c59b-590b-a45d-19a4f5e97db9-u02",
          "speaker_id": "b",
          "ja": "はい。金曜日にご連絡ください。その時、空きも確認します。",
          "vi": "Được ạ. Thứ Sáu chị liên lạc lại nhé. Lúc đó tôi cũng sẽ kiểm tra xem căn còn trống không."
        },
        {
          "id": "f8ec13bc-c59b-590b-a45d-19a4f5e97db9-u03",
          "speaker_id": "a",
          "ja": "わかりました。金曜日に電話します。",
          "vi": "Tôi hiểu rồi. Thứ Sáu tôi sẽ gọi."
        }
      ],
