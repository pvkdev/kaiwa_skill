          },
          "1ccf940a-fa72-5202-8968-073eea0cbd0b-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "6933bfcc-26fe-59bd-a232-1a5cf824d04e",
      "event_id": "E01",
      "context_vi": "Tiếp trao đổi ở văn phòng môi giới: phòng xa ga hơn vừa được giới thiệu không nhận người nuôi thú cưng, trong khi bạn có mèo. Bạn từ chối xem và hỏi hướng tìm tiếp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6933bfcc-26fe-59bd-a232-1a5cf824d04e-u01",
          "speaker_id": "a",
          "ja": "猫を飼っているので、その部屋は見ません。",
          "vi": "Tôi có mèo nên sẽ không xem phòng đó ạ."
        },
        {
          "id": "6933bfcc-26fe-59bd-a232-1a5cf824d04e-u02",
          "speaker_id": "b",
          "ja": "わかりました。ほかの部屋を探します。",
          "vi": "Tôi hiểu. Tôi sẽ tìm phòng khác."
        },
        {
          "id": "6933bfcc-26fe-59bd-a232-1a5cf824d04e-u03",
          "speaker_id": "a",
          "ja": "ペットと住める部屋があれば、教えてください。",
          "vi": "Nếu có phòng cho nuôi thú cưng, anh báo giúp tôi nhé."
        },
        {
          "id": "6933bfcc-26fe-59bd-a232-1a5cf824d04e-u04",
          "speaker_id": "b",
          "ja": "はい、確認してからご連絡します。",
          "vi": "Vâng, tôi kiểm rồi sẽ liên lạc với chị."
        }
      ],
      "admin": {
        "source_refs": [
          "housing"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "6933bfcc-26fe-59bd-a232-1a5cf824d04e-u01": {
            "kind": "original_extension"
