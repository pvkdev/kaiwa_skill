  "dialogues": [
    {
      "situation_uid": "12973094-d6e4-52cc-9279-1c12793753d4",
      "event_id": "E01",
      "context_vi": "Tại văn phòng môi giới, bạn muốn ở gần ga Aoba. Bạn có thể trả tối đa 70.000 yên mỗi tháng tiền thuê và hỏi xem có phòng phù hợp không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "12973094-d6e4-52cc-9279-1c12793753d4-u01",
          "speaker_id": "a",
          "ja": "青葉駅の近くで部屋を探しています。家賃は七万円までです。",
          "vi": "Tôi đang tìm phòng gần ga Aoba. Tiền thuê tối đa 70.000 yên một tháng ạ."
        },
        {
          "id": "12973094-d6e4-52cc-9279-1c12793753d4-u02",
          "speaker_id": "b",
          "ja": "わかりました。駅から近い部屋を見ますね。",
          "vi": "Tôi hiểu rồi. Để tôi tìm phòng gần ga nhé."
        },
        {
          "id": "12973094-d6e4-52cc-9279-1c12793753d4-u03",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ anh."
        }
      ],
      "admin": {
        "source_refs": [
          "housing"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "12973094-d6e4-52cc-9279-1c12793753d4-u01": {
            "kind": "original_extension"
          },
