    {
      "situation_uid": "d1f6e669-f664-5a8f-87a8-5bf99324f631",
      "event_id": "E02",
      "context_vi": "Bạn muốn xem căn 201 nhưng chủ nhà chưa xác nhận giờ. Môi giới nói sẽ hỏi; bạn cần biết khi nào nên chờ tin.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d1f6e669-f664-5a8f-87a8-5bf99324f631-u01",
          "speaker_id": "b",
          "ja": "まだ時間が決まっていません。大家さんに聞きます。",
          "vi": "Giờ vẫn chưa chốt. Tôi sẽ hỏi chủ nhà."
        },
        {
          "id": "d1f6e669-f664-5a8f-87a8-5bf99324f631-u02",
          "speaker_id": "a",
          "ja": "いつごろわかりますか。",
          "vi": "Khoảng khi nào tôi biết được ạ?"
        },
        {
          "id": "d1f6e669-f664-5a8f-87a8-5bf99324f631-u03",
          "speaker_id": "b",
          "ja": "今日の六時までに、一度ご連絡します。",
          "vi": "Trước sáu giờ hôm nay, tôi sẽ liên lạc một lần để báo tình hình."
        },
        {
          "id": "d1f6e669-f664-5a8f-87a8-5bf99324f631-u04",
          "speaker_id": "a",
          "ja": "わかりました。連絡を待ちます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ chờ tin."
        }
      ],
      "admin": {
