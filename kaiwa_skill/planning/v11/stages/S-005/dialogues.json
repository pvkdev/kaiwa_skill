    {
      "situation_uid": "8c8ff405-11c1-5775-8324-6aa838d9917f",
      "event_id": "E03",
      "context_vi": "Sau khi xem một căn phòng, bạn thích phòng sáng nhưng thấy nó hơi xa ga. Bạn muốn nói cả hai ý trước khi quyết định.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên môi giới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8c8ff405-11c1-5775-8324-6aa838d9917f-u01",
          "speaker_id": "a",
          "ja": "部屋は明るくて、いいですね。でも、駅から少し遠いです。",
          "vi": "Phòng sáng, tôi thích. Nhưng hơi xa ga."
        },
        {
          "id": "8c8ff405-11c1-5775-8324-6aa838d9917f-u02",
          "speaker_id": "b",
          "ja": "そうですね。もう少し近い部屋も探しますか。",
          "vi": "Vâng. Tôi tìm thêm phòng gần ga hơn nhé?"
        },
        {
          "id": "8c8ff405-11c1-5775-8324-6aa838d9917f-u03",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ anh."
        }
      ],
      "admin": {
