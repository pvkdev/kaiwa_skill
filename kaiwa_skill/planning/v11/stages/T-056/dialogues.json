        }
      }
    },
    {
      "situation_uid": "9072a648-d5eb-594a-a756-cad9ce172f7d",
      "event_id": "E01",
      "context_vi": "クラスの目的を聞き直す。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9072a648-d5eb-594a-a756-cad9ce172f7d-u01",
          "speaker_id": "a",
          "ja": "作品を自由に描くクラスだと思っていました。毎回、決まった絵を描くのですか。",
          "vi": "Tôi tưởng lớp cho bé vẽ tự do. Mỗi buổi các bé đều vẽ cùng một mẫu ạ。"
        },
        {
          "id": "9072a648-d5eb-594a-a756-cad9ce172f7d-u02",
          "speaker_id": "b",
          "ja": "前半は同じテーマを試し、後半は自分の絵にできます。",
          "vi": "Nửa đầu các bé thử cùng một chủ đề, nửa sau có thể vẽ tranh riêng。"
        },
        {
          "id": "9072a648-d5eb-594a-a756-cad9ce172f7d-u03",
          "speaker_id": "a",
          "ja": "それならユイにも説明できます。体験では後半も参加しますか。",
          "vi": "Vậy tôi có thể giải thích cho Yui. Buổi học thử bé có tham gia cả nửa sau không ạ。"
        },
        {
          "id": "9072a648-d5eb-594a-a756-cad9ce172f7d-u04",
          "speaker_id": "b",
          "ja": "はい。全部で一時間です。",
          "vi": "Có ạ. Cả buổi một tiếng。"
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
        ],
        "specialty_item_ids": [],
