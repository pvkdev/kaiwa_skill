    {
      "situation_uid": "7f7415d4-0392-5427-a6ad-c76f90b0b28d",
      "event_id": "E01",
      "context_vi": "子が今週の体験をためらう。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "7f7415d4-0392-5427-a6ad-c76f90b0b28d-u01",
          "speaker_id": "a",
          "ja": "ユイが今週は体験したくないと言っています。予約をいったん取り消し、来月また相談できますか。",
          "vi": "Yui nói tuần này chưa muốn học thử. Tôi hủy lịch trước, tháng sau hỏi lại được không ạ。"
        },
        {
          "id": "7f7415d4-0392-5427-a6ad-c76f90b0b28d-u02",
          "speaker_id": "b",
          "ja": "承知しました。土曜日の予約を取り消します。来月の空きはその時点でご確認ください。",
          "vi": "Vâng. Tôi hủy lịch thứ Bảy. Chỗ trống tháng sau chị kiểm lại lúc đó nhé。"
        },
        {
          "id": "7f7415d4-0392-5427-a6ad-c76f90b0b28d-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。本人がやりたくなったら連絡します。",
          "vi": "Cảm ơn cô. Khi bé muốn thử, tôi liên lạc lại。"
        },
        {
          "id": "7f7415d4-0392-5427-a6ad-c76f90b0b28d-u04",
          "speaker_id": "b",
          "ja": "はい。無理せずお待ちしています。",
          "vi": "Vâng. Khi nào thuận tiện chị cứ gọi。"
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
        ],
