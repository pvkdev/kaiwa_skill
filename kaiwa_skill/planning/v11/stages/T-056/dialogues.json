    {
      "situation_uid": "187a4eb7-179c-5087-bf3b-642870f95b77",
      "event_id": "E03",
      "context_vi": "体験後、参加を決める。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "187a4eb7-179c-5087-bf3b-642870f95b77-u01",
          "speaker_id": "a",
          "ja": "ユイが続けたいと言っています。水曜日のクラスに申し込みます。最初の授業はいつですか。",
          "vi": "Yui nói muốn học tiếp. Tôi đăng ký lớp thứ Tư. Buổi đầu khi nào ạ。"
        },
        {
          "id": "187a4eb7-179c-5087-bf3b-642870f95b77-u02",
          "speaker_id": "b",
          "ja": "来週水曜日の四時です。入会書類を今日お渡しします。",
          "vi": "Thứ Tư tuần sau lúc 4 giờ. Hôm nay tôi đưa giấy gia nhập。"
        },
        {
          "id": "187a4eb7-179c-5087-bf3b-642870f95b77-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。連絡先は私と夫の両方を書きます。欠席はどこへ連絡しますか。",
          "vi": "Cảm ơn cô. Tôi sẽ ghi cả liên lạc của tôi và chồng. Nếu bé vắng thì báo ở đâu ạ。"
        },
        {
          "id": "187a4eb7-179c-5087-bf3b-642870f95b77-u04",
          "speaker_id": "b",
          "ja": "この教室の電話に、授業前までにご連絡ください。",
          "vi": "Chị gọi số của lớp trước giờ học nhé。"
        }
      ],
