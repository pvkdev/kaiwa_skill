    {
      "situation_uid": "7e9f1044-7571-5ab3-b3ad-8cfa47be6efd",
      "event_id": "E03",
      "context_vi": "体験後、参加を見送る。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "7e9f1044-7571-5ab3-b3ad-8cfa47be6efd-u01",
          "speaker_id": "a",
          "ja": "ユイと話して、今は続けないことにしました。体験の時間をありがとうございました。",
          "vi": "Tôi đã nói với Yui và quyết định giờ chưa học tiếp. Cảm ơn cô đã dành thời gian cho buổi thử。"
        },
        {
          "id": "7e9f1044-7571-5ab3-b3ad-8cfa47be6efd-u02",
          "speaker_id": "b",
          "ja": "承知しました。楽しめた部分もありましたので、また気が向いたらどうぞ。",
          "vi": "Vâng. Bé cũng có phần thích, khi nào muốn thử lại cứ liên lạc。"
        },
        {
          "id": "7e9f1044-7571-5ab3-b3ad-8cfa47be6efd-u03",
          "speaker_id": "a",
          "ja": "今日は申込書を出さずに帰ります。",
          "vi": "Hôm nay tôi chưa nộp đơn đăng ký。"
        },
        {
          "id": "7e9f1044-7571-5ab3-b3ad-8cfa47be6efd-u04",
          "speaker_id": "b",
          "ja": "はい。体験分の手続きはこれで終わりです。",
          "vi": "Vâng. Thủ tục buổi học thử đã xong。"
        }
      ],
      "admin": {
