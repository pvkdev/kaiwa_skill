    {
      "situation_uid": "fa94b8dd-d7fa-5cfd-8ba4-cbaec7142180",
      "event_id": "E03",
      "context_vi": "もう一度体験したい。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "fa94b8dd-d7fa-5cfd-8ba4-cbaec7142180-u01",
          "speaker_id": "a",
          "ja": "ユイがもう一回体験したいと言いました。空いている日はありますか。",
          "vi": "Yui nói muốn học thử thêm lần nữa. Có ngày nào trống ạ?"
        },
        {
          "id": "fa94b8dd-d7fa-5cfd-8ba4-cbaec7142180-u02",
          "speaker_id": "b",
          "ja": "来週土曜日の十一時に三十分の回があります。",
          "vi": "Thứ Bảy tuần sau lúc 11 giờ có buổi ba mươi phút。"
        },
        {
          "id": "fa94b8dd-d7fa-5cfd-8ba4-cbaec7142180-u03",
          "speaker_id": "a",
          "ja": "そこに申し込みます。終わってから継続するか決めてもいいですか。",
          "vi": "Tôi đăng ký buổi đó. Sau buổi học mới quyết tiếp tục được không ạ。"
        },
        {
          "id": "fa94b8dd-d7fa-5cfd-8ba4-cbaec7142180-u04",
          "speaker_id": "b",
          "ja": "はい。体験後にご相談ください。",
          "vi": "Được ạ. Sau buổi thử ta trao đổi。"
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
        ],
