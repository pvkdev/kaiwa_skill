          },
          "1f6f720d-35e4-5e2b-a4ca-a45a69ea41fd-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "021317cb-8915-5134-af2c-f736c86e5ba4",
      "event_id": "E01",
      "context_vi": "体験を予約する。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "021317cb-8915-5134-af2c-f736c86e5ba4-u01",
          "speaker_id": "a",
          "ja": "ユイの体験を土曜日の十時にお願いします。保護者も教室に入れますか。",
          "vi": "Xin đăng ký Yui học thử thứ Bảy lúc 10 giờ. Phụ huynh có vào lớp cùng được không ạ。"
        },
        {
          "id": "021317cb-8915-5134-af2c-f736c86e5ba4-u02",
          "speaker_id": "b",
          "ja": "最初の十分は一緒に入れます。その後は隣の待合室でお待ちください。",
          "vi": "Mười phút đầu chị vào cùng được. Sau đó xin đợi ở phòng bên cạnh。"
        },
        {
          "id": "021317cb-8915-5134-af2c-f736c86e5ba4-u03",
          "speaker_id": "a",
          "ja": "分かりました。ユイにもその予定を伝えておきます。",
          "vi": "Vâng. Tôi sẽ nói trước lịch này với Yui。"
        },
        {
          "id": "021317cb-8915-5134-af2c-f736c86e5ba4-u04",
          "speaker_id": "b",
          "ja": "当日、受付でお名前をお知らせください。",
          "vi": "Hôm đó chị báo tên tại quầy nhé。"
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
