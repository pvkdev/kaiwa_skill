    {
      "situation_uid": "b4a84666-7a58-5def-8c93-5f69b2da1fbe",
      "event_id": "E02",
      "context_vi": "退会の締切を確認する。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b4a84666-7a58-5def-8c93-5f69b2da1fbe-u01",
          "speaker_id": "a",
          "ja": "「前月十日まで」とあります。例えば十月末でやめるなら、いつ連絡しますか。",
          "vi": "Giấy ghi trước ngày 10 tháng trước. Ví dụ muốn nghỉ hẳn cuối tháng Mười thì báo lúc nào ạ。"
        },
        {
          "id": "b4a84666-7a58-5def-8c93-5f69b2da1fbe-u02",
          "speaker_id": "b",
          "ja": "九月十日までに退会の連絡をお願いします。十月末までは通えます。",
          "vi": "Chị báo nghỉ hẳn trước ngày 10 tháng Chín. Bé vẫn học đến hết tháng Mười。"
        },
        {
          "id": "b4a84666-7a58-5def-8c93-5f69b2da1fbe-u03",
          "speaker_id": "a",
          "ja": "分かりました。休会と退会は別の申請ですね。",
          "vi": "Tôi hiểu. Nghỉ tạm và nghỉ hẳn là hai đơn khác nhau ạ。"
        },
        {
          "id": "b4a84666-7a58-5def-8c93-5f69b2da1fbe-u04",
          "speaker_id": "b",
          "ja": "はい。用紙も別ですので、必要ならお渡しします。",
          "vi": "Vâng. Mẫu giấy cũng khác, cần tôi đưa chị。"
        }
      ],
