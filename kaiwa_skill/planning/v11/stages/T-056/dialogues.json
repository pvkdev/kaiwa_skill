          }
        }
      }
    },
    {
      "situation_uid": "676ccb9c-1d89-5120-bc70-3af7090bcf09",
      "event_id": "E02",
      "context_vi": "一時的に休む場合を聞く。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "676ccb9c-1d89-5120-bc70-3af7090bcf09-u01",
          "speaker_id": "a",
          "ja": "夏に一か月帰省するかもしれません。その月を休む場合、月謝はどうなりますか。",
          "vi": "Mùa hè có thể chúng tôi về quê một tháng. Nếu nghỉ tháng đó thì học phí thế nào ạ。"
        },
        {
          "id": "676ccb9c-1d89-5120-bc70-3af7090bcf09-u02",
          "speaker_id": "b",
          "ja": "この教室では前月の十日までに休会を申請すれば、その月の月謝はかかりません。",
          "vi": "Ở lớp này, nếu xin nghỉ tạm trước ngày 10 tháng trước thì tháng nghỉ không thu học phí。"
        },
        {
          "id": "676ccb9c-1d89-5120-bc70-3af7090bcf09-u03",
          "speaker_id": "a",
          "ja": "八月に休むなら七月十日までですね。申請はメールでできますか。",
          "vi": "Nếu nghỉ tháng Tám thì xin trước ngày 10 tháng Bảy ạ. Tôi gửi email được không ạ。"
        },
        {
          "id": "676ccb9c-1d89-5120-bc70-3af7090bcf09-u04",
          "speaker_id": "b",
          "ja": "はい。教室のアドレスにお送りください。",
          "vi": "Được ạ. Chị gửi đến email lớp。"
        }
      ],
      "admin": {
