    {
      "situation_uid": "c36a8c90-c34f-5581-b8c3-3a0b562795a4",
      "event_id": "E02",
      "context_vi": "家族の予定と水曜が重なる。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c36a8c90-c34f-5581-b8c3-3a0b562795a4-u01",
          "speaker_id": "a",
          "ja": "水曜日は迎えに行けなくなりました。土曜のクラスへ変えられますか。",
          "vi": "Thứ Tư tôi không thể đưa đón bé nữa. Có đổi sang lớp thứ Bảy được không ạ。"
        },
        {
          "id": "c36a8c90-c34f-5581-b8c3-3a0b562795a4-u02",
          "speaker_id": "b",
          "ja": "土曜は来月から一人分空きます。今月は水曜のままですか。",
          "vi": "Lớp thứ Bảy từ tháng sau có một chỗ. Tháng này bé tiếp tục thứ Tư chứ ạ。"
        },
        {
          "id": "c36a8c90-c34f-5581-b8c3-3a0b562795a4-u03",
          "speaker_id": "a",
          "ja": "今月は夫が送れるか確認します。来月の土曜枠をいつまで保留できますか。",
          "vi": "Tháng này tôi hỏi chồng có đưa được không. Chỗ thứ Bảy tháng sau giữ tạm đến khi nào ạ。"
        },
        {
          "id": "c36a8c90-c34f-5581-b8c3-3a0b562795a4-u04",
          "speaker_id": "b",
          "ja": "今週金曜日まで保留します。決まりましたら電話してください。",
          "vi": "Tôi giữ đến thứ Sáu tuần này. Khi quyết xong chị gọi nhé。"
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
        ],
        "specialty_item_ids": [],
