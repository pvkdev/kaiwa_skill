    {
      "situation_uid": "8e7e7e88-5ede-5b54-95d4-52e562fe413a",
      "event_id": "E03",
      "context_vi": "体験の後、先生に様子を聞く。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8e7e7e88-5ede-5b54-95d4-52e562fe413a-u01",
          "speaker_id": "a",
          "ja": "今日の体験で、ユイはどの部分に参加していましたか。",
          "vi": "Hôm học thử, Yui tham gia phần nào ạ。"
        },
        {
          "id": "8e7e7e88-5ede-5b54-95d4-52e562fe413a-u02",
          "speaker_id": "b",
          "ja": "前半の色を混ぜる作業は楽しそうでした。後半は少し疲れて、見ていました。",
          "vi": "Nửa đầu bé thích trộn màu. Nửa sau hơi mệt và ngồi xem ạ。"
        },
        {
          "id": "8e7e7e88-5ede-5b54-95d4-52e562fe413a-u03",
          "speaker_id": "a",
          "ja": "そうでしたか。本人にも楽しかったところを聞いてみます。",
          "vi": "Vậy ạ. Tôi sẽ hỏi bé thích phần nào。"
        },
        {
          "id": "8e7e7e88-5ede-5b54-95d4-52e562fe413a-u04",
          "speaker_id": "b",
          "ja": "次回を決める前に、ご本人の気持ちも聞いてください。",
          "vi": "Trước khi quyết buổi sau, chị hỏi ý bé nhé。"
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
        ],
