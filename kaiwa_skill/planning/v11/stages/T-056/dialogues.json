    {
      "situation_uid": "ef2f1844-156a-5fa8-a61e-e253367715e9",
      "event_id": "E02",
      "context_vi": "教室の料金表を聞く。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "ef2f1844-156a-5fa8-a61e-e253367715e9-u01",
          "speaker_id": "a",
          "ja": "月謝のほかに、入会金や材料費はいくらかかりますか。",
          "vi": "Ngoài học phí tháng, phí gia nhập và vật liệu là bao nhiêu ạ。"
        },
        {
          "id": "ef2f1844-156a-5fa8-a61e-e253367715e9-u02",
          "speaker_id": "b",
          "ja": "この教室では月謝が六千円、入会金が三千円です。材料費は月謝に含まれます。",
          "vi": "Ở lớp này, học phí tháng là 6.000 yên, phí gia nhập 3.000 yên. Vật liệu đã gồm trong học phí。"
        },
        {
          "id": "ef2f1844-156a-5fa8-a61e-e253367715e9-u03",
          "speaker_id": "a",
          "ja": "初月に払う合計は九千円ですか。体験料は別でしょうか。",
          "vi": "Vậy tháng đầu tổng 9.000 yên ạ? Phí học thử có tính riêng không ạ。"
        },
        {
          "id": "ef2f1844-156a-5fa8-a61e-e253367715e9-u04",
          "speaker_id": "b",
          "ja": "体験料は千円で、入会前にお支払いいただきます。",
          "vi": "Học thử 1.000 yên, đóng trước khi gia nhập ạ。"
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ef2f1844-156a-5fa8-a61e-e253367715e9-u01": {
