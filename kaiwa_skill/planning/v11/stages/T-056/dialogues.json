            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "1f6f720d-35e4-5e2b-a4ca-a45a69ea41fd",
      "event_id": "E01",
      "context_vi": "水曜日の体験枠が満員。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "1f6f720d-35e4-5e2b-a4ca-a45a69ea41fd-u01",
          "speaker_id": "a",
          "ja": "水曜日の体験を希望します。まだ空きはありますか。",
          "vi": "Tôi muốn đăng ký học thử thứ Tư. Còn chỗ không ạ。"
        },
        {
          "id": "1f6f720d-35e4-5e2b-a4ca-a45a69ea41fd-u02",
          "speaker_id": "b",
          "ja": "今週は満員です。土曜日の午前なら一人分あります。",
          "vi": "Tuần này hết chỗ. Sáng thứ Bảy còn một chỗ。"
        },
        {
          "id": "1f6f720d-35e4-5e2b-a4ca-a45a69ea41fd-u03",
          "speaker_id": "a",
          "ja": "土曜日なら行けます。時間と持ち物を教えてください。",
          "vi": "Thứ Bảy được ạ. Xin cho tôi biết giờ và đồ cần mang。"
        },
        {
          "id": "1f6f720d-35e4-5e2b-a4ca-a45a69ea41fd-u04",
          "speaker_id": "b",
          "ja": "十時からです。画材はこちらで用意します。",
          "vi": "Bắt đầu 10 giờ. Dụng cụ vẽ bên tôi chuẩn bị。"
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1f6f720d-35e4-5e2b-a4ca-a45a69ea41fd-u01": {
            "kind": "original_extension"
          },
