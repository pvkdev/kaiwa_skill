  "dialogues": [
    {
      "situation_uid": "e26414b7-a635-5a07-b57c-b01290aac859",
      "event_id": "E01",
      "context_vi": "七歳のユイの絵画教室を探す。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e26414b7-a635-5a07-b57c-b01290aac859-u01",
          "speaker_id": "a",
          "ja": "七歳の娘が絵を描くのが好きです。初めてでも参加できるクラスはありますか。",
          "vi": "Con gái tôi bảy tuổi thích vẽ. Có lớp cho bé mới bắt đầu không ạ。"
        },
        {
          "id": "e26414b7-a635-5a07-b57c-b01290aac859-u02",
          "speaker_id": "b",
          "ja": "水曜日のクラスは六歳から九歳です。ユイさんは何を描くのが好きですか。",
          "vi": "Lớp thứ Tư dành cho bé sáu đến chín tuổi. Yui thích vẽ gì ạ。"
        },
        {
          "id": "e26414b7-a635-5a07-b57c-b01290aac859-u03",
          "speaker_id": "a",
          "ja": "動物です。技術より、まず楽しんで試したいです。",
          "vi": "Bé thích vẽ động vật. Trước tiên tôi muốn bé thử cho vui hơn là học kỹ thuật。"
        },
        {
          "id": "e26414b7-a635-5a07-b57c-b01290aac859-u04",
          "speaker_id": "b",
          "ja": "それなら水曜日の体験が合いそうです。見学もできます。",
          "vi": "Vậy buổi học thử thứ Tư có vẻ hợp. Chị cũng có thể đến xem。"
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e26414b7-a635-5a07-b57c-b01290aac859-u01": {
