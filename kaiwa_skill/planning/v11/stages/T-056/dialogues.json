    {
      "situation_uid": "dc841c87-ff58-5dec-bc52-f16384bf8d25",
      "event_id": "E02",
      "context_vi": "土曜にも通えないと分かった。",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học, mẹ của Yui",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hoặc giáo viên lớp vẽ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "dc841c87-ff58-5dec-bc52-f16384bf8d25-u01",
          "speaker_id": "a",
          "ja": "土曜も家族の予定と重なりました。枠を保留していただきましたが、今回は見送ります。",
          "vi": "Thứ Bảy cũng trùng lịch gia đình. Cảm ơn đã giữ chỗ, lần này chúng tôi xin thôi。"
        },
        {
          "id": "dc841c87-ff58-5dec-bc52-f16384bf8d25-u02",
          "speaker_id": "b",
          "ja": "承知しました。土曜の保留を外します。",
          "vi": "Vâng. Tôi bỏ giữ chỗ thứ Bảy。"
        },
        {
          "id": "dc841c87-ff58-5dec-bc52-f16384bf8d25-u03",
          "speaker_id": "a",
          "ja": "ご対応ありがとうございました。別の時間が必要になればまた相談します。",
          "vi": "Cảm ơn cô đã giúp. Khi cần giờ khác tôi sẽ hỏi lại。"
        },
        {
          "id": "dc841c87-ff58-5dec-bc52-f16384bf8d25-u04",
          "speaker_id": "b",
          "ja": "はい。空きはそのときにお尋ねください。",
          "vi": "Vâng. Khi đó chị hỏi chỗ trống nhé。"
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
