    {
      "situation_uid": "35293faa-936e-5a83-acef-719dbbd852eb",
      "event_id": "E03",
      "context_vi": "Ở Mizu hư cấu, đồng nghiệp báo một bảng số chưa khớp. Bạn nghi mình đã chép nhầm nhưng chưa kiểm được nguồn; bạn nói rõ phần chưa chắc và hẹn xác minh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người bị ảnh hưởng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "35293faa-936e-5a83-acef-719dbbd852eb-u01",
          "speaker_id": "b",
          "ja": "この表の数が、元の資料と違うようです。",
          "vi": "Số trong bảng này có vẻ khác tài liệu gốc."
        },
        {
          "id": "35293faa-936e-5a83-acef-719dbbd852eb-u02",
          "speaker_id": "a",
          "ja": "すみません。私が写し間違えたかもしれませんが、まだ確かではありません。",
          "vi": "Xin lỗi. Có thể tôi đã chép nhầm, nhưng tôi chưa chắc."
        },
        {
          "id": "35293faa-936e-5a83-acef-719dbbd852eb-u03",
          "speaker_id": "b",
          "ja": "元の資料を確認できますか。",
          "vi": "Anh kiểm tra tài liệu gốc được không?"
        },
        {
          "id": "35293faa-936e-5a83-acef-719dbbd852eb-u04",
          "speaker_id": "a",
          "ja": "はい。元の資料と比べて、今日の三時までに結果をお伝えします。",
          "vi": "Được. Tôi sẽ đối chiếu và báo kết quả trước 3 giờ hôm nay."
        },
        {
          "id": "35293faa-936e-5a83-acef-719dbbd852eb-u05",
          "speaker_id": "b",
          "ja": "お願いします。確認までこの数字は使いません。",
          "vi": "Nhờ anh. Trước khi kiểm xong tôi sẽ không dùng con số này."
        }
