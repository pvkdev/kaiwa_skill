  "dialogues": [
    {
      "situation_uid": "174fb9a0-ff92-58cd-93d2-c4bc93988069",
      "event_id": "E01",
      "context_vi": "Tại công ty Mizu hư cấu, trước giờ làm bạn biết sẽ đến trễ khoảng 10 phút. Bạn gọi ngay cho trưởng ca Aoki, báo giờ đến và xin lỗi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "174fb9a0-ff92-58cd-93d2-c4bc93988069-u01",
          "speaker_id": "a",
          "ja": "申し訳ありません。電車が遅れていて、十分ほど遅れます。九時十分に着く予定です。",
          "vi": "Xin lỗi chị. Tàu đang trễ nên tôi sẽ đến muộn khoảng 10 phút, dự kiến 9 giờ 10 tới."
        },
        {
          "id": "174fb9a0-ff92-58cd-93d2-c4bc93988069-u02",
          "speaker_id": "b",
          "ja": "分かりました。着いたら声をかけてください。",
          "vi": "Tôi hiểu. Đến nơi thì báo tôi nhé."
        },
        {
          "id": "174fb9a0-ff92-58cd-93d2-c4bc93988069-u03",
          "speaker_id": "a",
          "ja": "はい。着いたらすぐお伝えします。",
          "vi": "Vâng, đến nơi tôi sẽ báo ngay."
        },
        {
          "id": "174fb9a0-ff92-58cd-93d2-c4bc93988069-u04",
          "speaker_id": "b",
          "ja": "気をつけて来てください。",
          "vi": "Đi cẩn thận nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "work_apology",
          "simple_apology"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "174fb9a0-ff92-58cd-93d2-c4bc93988069-u01": {
