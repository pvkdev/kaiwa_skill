    {
      "situation_uid": "83e0b31e-bc01-5eff-8893-68901a65ec8e",
      "event_id": "E03",
      "context_vi": "Sau khi bạn nhầm giờ khiến đồng nghiệp Mizu chỉ còn ít thời gian và không thể họp hôm nay, bạn đề nghị 10 giờ sáng mai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người bị ảnh hưởng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "83e0b31e-bc01-5eff-8893-68901a65ec8e-u01",
          "speaker_id": "a",
          "ja": "今日はすみません。明日の十時なら、もう一度お時間をいただけますか。",
          "vi": "Hôm nay tôi xin lỗi. Sáng mai 10 giờ, chị dành thời gian gặp lại tôi được không?"
        },
        {
          "id": "83e0b31e-bc01-5eff-8893-68901a65ec8e-u02",
          "speaker_id": "b",
          "ja": "明日の十時なら大丈夫です。",
          "vi": "Sáng mai 10 giờ tôi rảnh."
        },
        {
          "id": "83e0b31e-bc01-5eff-8893-68901a65ec8e-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。資料を先に確認して持って行きます。",
          "vi": "Cảm ơn chị. Tôi sẽ kiểm tài liệu trước rồi mang theo."
        },
        {
          "id": "83e0b31e-bc01-5eff-8893-68901a65ec8e-u04",
          "speaker_id": "b",
          "ja": "では、十時に会議室で。",
          "vi": "Vậy 10 giờ ở phòng họp nhé."
        }
      ],
