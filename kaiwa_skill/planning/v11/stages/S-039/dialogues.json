        }
      }
    },
    {
      "situation_uid": "b77115fd-93bf-570e-9643-b4b9e1dca327",
      "event_id": "E01",
      "context_vi": "Ở Mizu, trưởng nhóm Tanaka tưởng bạn đến muộn mà chưa báo ai. Thực ra trước giờ bạn đã gọi cho trưởng ca Aoki; bạn nói chính xác người đã nhận tin.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b77115fd-93bf-570e-9643-b4b9e1dca327-u01",
          "speaker_id": "b",
          "ja": "遅れる連絡がなかったと聞きました。",
          "vi": "Tôi nghe nói không ai nhận được báo trễ."
        },
        {
          "id": "b77115fd-93bf-570e-9643-b4b9e1dca327-u02",
          "speaker_id": "a",
          "ja": "説明が足りず、すみません。始業前に青木さんへ電話しました。田中さんには直接伝えていません。",
          "vi": "Tôi xin lỗi vì chưa giải thích đủ. Trước giờ làm tôi gọi cho chị Aoki, chưa báo trực tiếp chị Tanaka."
        },
        {
          "id": "b77115fd-93bf-570e-9643-b4b9e1dca327-u03",
          "speaker_id": "b",
          "ja": "そうでしたか。青木さんにも確認します。",
          "vi": "Ra vậy. Tôi sẽ xác nhận với chị Aoki."
        },
        {
          "id": "b77115fd-93bf-570e-9643-b4b9e1dca327-u04",
          "speaker_id": "a",
          "ja": "はい。次から伝える相手も確認します。",
          "vi": "Vâng. Lần sau tôi sẽ hỏi rõ cần báo cho ai."
        }
      ],
      "admin": {
        "source_refs": [
          "work_apology"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b77115fd-93bf-570e-9643-b4b9e1dca327-u01": {
