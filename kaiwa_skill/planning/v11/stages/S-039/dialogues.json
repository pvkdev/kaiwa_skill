    {
      "situation_uid": "979e6fe8-87ed-51a8-986d-53193a7ebc45",
      "event_id": "E02",
      "context_vi": "Ở Mizu hư cấu, bạn lỡ gửi cho đồng nghiệp nội bộ một bản dự thảo chưa được duyệt, rồi nhận ra ngay. Bạn báo bản nào bị gửi nhầm và nhờ họ chưa dùng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "979e6fe8-87ed-51a8-986d-53193a7ebc45-u01",
          "speaker_id": "a",
          "ja": "すみません。さっき送ったのは、まだ確認前の資料です。使わないでください。",
          "vi": "Xin lỗi, bản tôi vừa gửi là tài liệu chưa được kiểm. Xin chị chưa dùng bản đó."
        },
        {
          "id": "979e6fe8-87ed-51a8-986d-53193a7ebc45-u02",
          "speaker_id": "b",
          "ja": "分かりました。まだ開いていません。どうしますか。",
          "vi": "Tôi hiểu. Tôi chưa mở. Giờ làm sao?"
        },
        {
          "id": "979e6fe8-87ed-51a8-986d-53193a7ebc45-u03",
          "speaker_id": "a",
          "ja": "担当者に正しい扱いを確認してから連絡します。",
          "vi": "Tôi sẽ hỏi người phụ trách cách xử lý đúng rồi báo lại."
        },
        {
          "id": "979e6fe8-87ed-51a8-986d-53193a7ebc45-u04",
          "speaker_id": "b",
          "ja": "はい。連絡を待ちます。",
          "vi": "Ừ, tôi chờ tin."
        }
      ],
      "admin": {
        "source_refs": [
          "work_apology",
          "work_remedy"
        ],
