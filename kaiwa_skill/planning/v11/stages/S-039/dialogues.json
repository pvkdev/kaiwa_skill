          }
        }
      }
    },
    {
      "situation_uid": "800f0f46-3e7b-52b0-b8ef-a5060ecfc4fd",
      "event_id": "E01",
      "context_vi": "Bạn đã báo trưởng ca Aoki trước giờ làm và nay đến công ty Mizu lúc 9 giờ 10. Bạn gặp chị ấy, xin lỗi và hỏi việc cần làm trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "800f0f46-3e7b-52b0-b8ef-a5060ecfc4fd-u01",
          "speaker_id": "a",
          "ja": "遅くなって申し訳ありません。今着きました。まず何をすればいいですか。",
          "vi": "Xin lỗi vì đến muộn. Tôi vừa tới. Trước tiên tôi cần làm gì ạ?"
        },
        {
          "id": "800f0f46-3e7b-52b0-b8ef-a5060ecfc4fd-u02",
          "speaker_id": "b",
          "ja": "受付の準備を先にお願いします。",
          "vi": "Làm phần chuẩn bị quầy tiếp đón trước nhé."
        },
        {
          "id": "800f0f46-3e7b-52b0-b8ef-a5060ecfc4fd-u03",
          "speaker_id": "a",
          "ja": "分かりました。終わったら次の仕事を確認します。",
          "vi": "Tôi hiểu. Làm xong tôi sẽ hỏi việc tiếp theo."
        },
        {
          "id": "800f0f46-3e7b-52b0-b8ef-a5060ecfc4fd-u04",
          "speaker_id": "b",
          "ja": "はい、お願いします。",
          "vi": "Ừ, nhờ anh."
        }
      ],
      "admin": {
        "source_refs": [
          "work_apology"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
