        }
      }
    },
    {
      "situation_uid": "c96e9e20-577f-56f7-bbe1-c0d17dacd529",
      "event_id": "E02",
      "context_vi": "Sau khi đặt nhầm hộp giấy in vào kệ bút ở Mizu, bạn đã chuyển sang kệ giấy bên phải và nhờ đồng nghiệp kiểm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c96e9e20-577f-56f7-bbe1-c0d17dacd529-u01",
          "speaker_id": "a",
          "ja": "紙の箱を右の棚へ移しました。場所はここで合っていますか。",
          "vi": "Tôi đã chuyển hộp giấy sang kệ bên phải. Để đây đúng chưa?"
        },
        {
          "id": "c96e9e20-577f-56f7-bbe1-c0d17dacd529-u02",
          "speaker_id": "b",
          "ja": "はい、紙はそこです。",
          "vi": "Đúng, giấy để chỗ đó."
        },
        {
          "id": "c96e9e20-577f-56f7-bbe1-c0d17dacd529-u03",
          "speaker_id": "a",
          "ja": "確認してくれてありがとうございます。次から気をつけます。",
          "vi": "Cảm ơn chị đã kiểm tra. Lần sau tôi sẽ chú ý."
        },
        {
          "id": "c96e9e20-577f-56f7-bbe1-c0d17dacd529-u04",
          "speaker_id": "b",
          "ja": "お願いします。",
          "vi": "Ừ, nhờ anh."
        }
      ],
      "admin": {
        "source_refs": [
          "work_apology"
        ],
        "specialty_item_ids": [],
