    {
      "situation_uid": "fd888c91-d831-5099-8867-6da82260750b",
      "event_id": "E03",
      "context_vi": "Sáng hôm sau 10 giờ, bạn gặp lại đồng nghiệp Mizu đúng hẹn sau lần nhầm giờ. Bạn đã kiểm và mang tài liệu cần dùng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người bị ảnh hưởng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "fd888c91-d831-5099-8867-6da82260750b-u01",
          "speaker_id": "a",
          "ja": "おはようございます。十時の約束で来ました。資料も確認して持ってきました。",
          "vi": "Chào buổi sáng. Tôi đến đúng hẹn 10 giờ. Tôi đã kiểm và mang tài liệu rồi."
        },
        {
          "id": "fd888c91-d831-5099-8867-6da82260750b-u02",
          "speaker_id": "b",
          "ja": "ありがとうございます。では、始めましょう。",
          "vi": "Cảm ơn anh. Vậy mình bắt đầu nhé."
        },
        {
          "id": "fd888c91-d831-5099-8867-6da82260750b-u03",
          "speaker_id": "a",
          "ja": "昨日はご迷惑をおかけしました。今日は準備できています。",
          "vi": "Hôm qua tôi đã làm phiền chị, xin lỗi. Hôm nay tôi chuẩn bị xong rồi."
        },
        {
          "id": "fd888c91-d831-5099-8867-6da82260750b-u04",
          "speaker_id": "b",
          "ja": "分かりました。資料を見せてください。",
          "vi": "Được. Cho tôi xem tài liệu nhé."
        }
      ],
