    {
      "situation_uid": "2efc2a0a-2cb8-5258-b7c3-dfd2a70eac9e",
      "event_id": "E02",
      "context_vi": "Sau khi báo đồng nghiệp chưa dùng bản dự thảo gửi nhầm ở Mizu, bạn hỏi người phụ trách cách xử lý. Hiện chưa có câu trả lời, nên bạn nhờ đồng nghiệp tiếp tục chờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2efc2a0a-2cb8-5258-b7c3-dfd2a70eac9e-u01",
          "speaker_id": "a",
          "ja": "担当者に確認中です。まだ取り消し方が決まっていません。",
          "vi": "Tôi đang hỏi người phụ trách. Cách thu hồi vẫn chưa được quyết định."
        },
        {
          "id": "2efc2a0a-2cb8-5258-b7c3-dfd2a70eac9e-u02",
          "speaker_id": "b",
          "ja": "分かりました。この資料には触れずに待ちます。",
          "vi": "Tôi hiểu. Tôi sẽ không dùng tài liệu này và chờ."
        },
        {
          "id": "2efc2a0a-2cb8-5258-b7c3-dfd2a70eac9e-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。返事が来たらすぐお伝えします。",
