          }
        }
      }
    },
    {
      "situation_uid": "7c2fa408-a526-5853-a59c-732ef840b16c",
      "event_id": "E01",
      "context_vi": "Trong cuộc họp nhỏ tại Mizu, bạn phát hiện quên tài liệu trên bàn làm việc. Bạn xin lỗi trưởng nhóm và hỏi có thể lấy ngay không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "leader",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "7c2fa408-a526-5853-a59c-732ef840b16c-u01",
          "speaker_id": "a",
          "ja": "申し訳ありません。資料を自分の机に置いてきました。",
          "vi": "Xin lỗi, tôi để tài liệu ở bàn làm việc mất rồi."
        },
        {
          "id": "7c2fa408-a526-5853-a59c-732ef840b16c-u02",
          "speaker_id": "b",
          "ja": "今、必要です。取りに行けますか。",
          "vi": "Giờ cần tài liệu đó. Anh đi lấy được không?"
        },
        {
          "id": "7c2fa408-a526-5853-a59c-732ef840b16c-u03",
          "speaker_id": "a",
          "ja": "はい。すぐ取って戻ります。少しお待ちください。",
          "vi": "Vâng. Tôi đi lấy rồi quay lại ngay. Xin đợi một chút."
        },
        {
          "id": "7c2fa408-a526-5853-a59c-732ef840b16c-u04",
          "speaker_id": "b",
          "ja": "お願いします。戻ったら知らせてください。",
          "vi": "Nhờ anh. Quay lại thì báo tôi nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "work_apology"
        ],
        "specialty_item_ids": [],
