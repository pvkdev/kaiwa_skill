    {
      "situation_uid": "869dff52-16e8-50df-8148-2c0a9e758503",
      "event_id": "E02",
      "context_vi": "Ở kho đồ văn phòng Mizu hư cấu, bạn nhận ra đã đặt hộp giấy in ở kệ bút thay vì kệ giấy. Bạn báo đồng nghiệp trước khi chuyển.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "đồng nghiệp",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "869dff52-16e8-50df-8148-2c0a9e758503-u01",
          "speaker_id": "a",
          "ja": "すみません。紙の箱をペンの棚に置いてしまいました。",
          "vi": "Xin lỗi, tôi đã đặt hộp giấy in lên kệ bút."
        },
        {
          "id": "869dff52-16e8-50df-8148-2c0a9e758503-u02",
          "speaker_id": "b",
          "ja": "分かりました。紙の棚は右側です。",
          "vi": "Tôi hiểu. Kệ giấy ở bên phải."
        },
        {
          "id": "869dff52-16e8-50df-8148-2c0a9e758503-u03",
          "speaker_id": "a",
          "ja": "今、移します。終わったら見てもらえますか。",
          "vi": "Tôi chuyển ngay. Xong chị xem giúp tôi được không?"
        },
        {
          "id": "869dff52-16e8-50df-8148-2c0a9e758503-u04",
          "speaker_id": "b",
          "ja": "はい、確認します。",
          "vi": "Được, tôi sẽ kiểm tra."
        }
      ],
      "admin": {
        "source_refs": [
          "work_apology"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
