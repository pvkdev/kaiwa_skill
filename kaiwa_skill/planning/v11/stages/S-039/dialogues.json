    {
      "situation_uid": "bd600fcf-614f-54bd-b6eb-5fb8cacca77b",
      "event_id": "E03",
      "context_vi": "Ở Mizu hư cấu, bạn đọc nhầm giờ hẹn 14 giờ thành 14 giờ 30, khiến người kia chờ. Bạn gặp họ lúc 14 giờ 20 và xin lỗi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "nhân viên",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người bị ảnh hưởng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "bd600fcf-614f-54bd-b6eb-5fb8cacca77b-u01",
          "speaker_id": "a",
          "ja": "時間を間違えて、待たせてしまいました。申し訳ありません。",
          "vi": "Tôi xem nhầm giờ, để chị phải chờ. Tôi xin lỗi."
        },
        {
          "id": "bd600fcf-614f-54bd-b6eb-5fb8cacca77b-u02",
          "speaker_id": "b",
          "ja": "二時から待っています。今日はあと十分しかありません。",
          "vi": "Tôi đợi từ 2 giờ. Hôm nay tôi chỉ còn 10 phút."
        },
        {
          "id": "bd600fcf-614f-54bd-b6eb-5fb8cacca77b-u03",
          "speaker_id": "a",
          "ja": "分かりました。今すぐ必要な話だけできますか。",
          "vi": "Tôi hiểu. Giờ mình chỉ nói phần cần gấp được không?"
        },
        {
          "id": "bd600fcf-614f-54bd-b6eb-5fb8cacca77b-u04",
          "speaker_id": "b",
          "ja": "今日は難しいです。別の日にしましょう。",
          "vi": "Hôm nay khó rồi. Để hôm khác nhé."
        }
      ],
      "admin": {
