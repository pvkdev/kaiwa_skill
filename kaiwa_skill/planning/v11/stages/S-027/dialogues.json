    {
      "situation_uid": "db4658f2-8dd9-5a9b-bb82-afb94c017e16",
      "event_id": "E03",
      "context_vi": "Sau cuộc trao đổi trước tại nhà, hộp kệ 85 cm chưa qua cửa 80 cm. Bạn đề nghị nhận hai gói nhỏ còn lại trước, còn kệ lớn chờ cửa hàng quyết định.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người giao hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "db4658f2-8dd9-5a9b-bb82-afb94c017e16-u01",
          "speaker_id": "a",
          "ja": "小さい二箱だけ先に受け取れますか。大きい箱は店に相談したいです。",
          "vi": "Tôi nhận trước hai hộp nhỏ được không? Hộp lớn tôi muốn hỏi cửa hàng ạ."
        },
        {
          "id": "db4658f2-8dd9-5a9b-bb82-afb94c017e16-u02",
          "speaker_id": "b",
          "ja": "小さい二箱はお渡しできます。大きい箱は店に連絡します。",
          "vi": "Tôi giao được hai hộp nhỏ. Hộp lớn tôi sẽ báo cửa hàng."
        },
        {
          "id": "db4658f2-8dd9-5a9b-bb82-afb94c017e16-u03",
          "speaker_id": "a",
          "ja": "お願いします。大きい箱はまだ受け取っていません。",
          "vi": "Nhờ anh nhé. Tôi chưa nhận hộp lớn đâu ạ."
        }
      ],
      "admin": {
