    {
      "situation_uid": "de0c1830-f2ea-5201-b0fe-7ca54026be83",
      "event_id": "E03",
      "context_vi": "Tại nhà bạn, kiện kệ do Haru giao rộng 85 cm nhưng cửa phòng chỉ rộng 80 cm. Hai bên đo lại, chưa cố đưa hàng vào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người giao hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "de0c1830-f2ea-5201-b0fe-7ca54026be83-u01",
          "speaker_id": "b",
          "ja": "この箱は入口を通りませんね。",
          "vi": "Hộp này không lọt qua cửa rồi ạ."
        },
        {
          "id": "de0c1830-f2ea-5201-b0fe-7ca54026be83-u02",
          "speaker_id": "a",
          "ja": "ドアは八十センチです。箱は何センチですか。",
          "vi": "Cửa rộng 80 cm. Hộp rộng bao nhiêu ạ?"
        },
        {
          "id": "de0c1830-f2ea-5201-b0fe-7ca54026be83-u03",
          "speaker_id": "b",
          "ja": "箱は八十五センチです。ここで一度止めます。",
          "vi": "Hộp rộng 85 cm. Mình tạm dừng ở đây nhé."
        },
        {
          "id": "de0c1830-f2ea-5201-b0fe-7ca54026be83-u04",
          "speaker_id": "a",
          "ja": "はい、無理に入れないでください。",
          "vi": "Vâng, đừng cố đưa vào ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "delivery_book"
        ],
        "specialty_item_ids": [],
