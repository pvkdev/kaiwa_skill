          "0e8dfc39-1845-53fe-9e9b-93ac6092e1c0-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d770285a-c8d3-5269-b445-a4c3289be0b7",
      "event_id": "E01",
      "context_vi": "Tại Haru hư cấu, không có tấm gỗ rộng đúng 80 cm như bạn muốn. Bạn hỏi về loại lớn hơn có thể hỏi dịch vụ cắt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên home center",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d770285a-c8d3-5269-b445-a4c3289be0b7-u01",
          "speaker_id": "a",
          "ja": "幅八十センチの板はありませんか。",
          "vi": "Có tấm ván rộng 80 cm không ạ?"
        },
        {
          "id": "d770285a-c8d3-5269-b445-a4c3289be0b7-u02",
          "speaker_id": "b",
          "ja": "今はありません。こちらは九十センチです。",
          "vi": "Hiện không có ạ. Tấm này rộng 90 cm."
        },
        {
          "id": "d770285a-c8d3-5269-b445-a4c3289be0b7-u03",
          "speaker_id": "a",
          "ja": "この板は店で切れるか、確認できますか。",
          "vi": "Chị kiểm tra giúp xem cửa hàng có cắt tấm này được không ạ?"
        },
        {
          "id": "d770285a-c8d3-5269-b445-a4c3289be0b7-u04",
          "speaker_id": "b",
          "ja": "はい、サービスカウンターに聞きます。",
          "vi": "Vâng, tôi sẽ hỏi quầy dịch vụ."
        }
      ],
      "admin": {
        "source_refs": [
          "shelf",
          "cainz_cut",
          "komeri_cut"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
