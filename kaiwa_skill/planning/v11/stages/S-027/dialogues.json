    {
      "situation_uid": "0701330b-5b03-5ba8-ae0b-da58bf5106b8",
      "event_id": "E04",
      "context_vi": "Tại Haru, bạn muốn hỏi điều kiện đổi chiếc kệ tự đo nhầm. Nhân viên nói chỉ quyết định sau khi xem món và hóa đơn; chính sách của Haru chỉ tồn tại trong cảnh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0701330b-5b03-5ba8-ae0b-da58bf5106b8-u01",
          "speaker_id": "a",
          "ja": "サイズを間違えました。交換できるか聞きたいです。",
          "vi": "Tôi nhầm cỡ. Tôi muốn hỏi có đổi được không ạ?"
