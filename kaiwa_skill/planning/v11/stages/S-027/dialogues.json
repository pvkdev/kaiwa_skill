    {
      "situation_uid": "25a7cb9b-aefb-56bc-a1e5-99f1af974fef",
      "event_id": "E03",
      "context_vi": "Sau khi nhận hai hộp nhỏ, bạn mở một trong hai hộp nhỏ và thấy thiếu túi ốc ghi trên danh mục. Bạn gọi số bộ phận giao hàng Haru; người giao lúc nãy bắt máy và sẽ nối việc với cửa hàng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người giao hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "25a7cb9b-aefb-56bc-a1e5-99f1af974fef-u01",
          "speaker_id": "a",
          "ja": "さっきの小さい箱に、ねじの袋がありません。店にも確認したいです。",
          "vi": "Hộp nhỏ giao lúc nãy thiếu túi ốc. Tôi muốn hỏi cả cửa hàng ạ."
        },
        {
          "id": "25a7cb9b-aefb-56bc-a1e5-99f1af974fef-u02",
          "speaker_id": "b",
          "ja": "二箱のうち、どちらですか。",
          "vi": "Trong hai hộp, là hộp nào ạ?"
        },
        {
          "id": "25a7cb9b-aefb-56bc-a1e5-99f1af974fef-u03",
          "speaker_id": "a",
          "ja": "一番の箱です。中のリストには書いてあります。",
          "vi": "Hộp số một. Trong danh mục có ghi túi ốc."
        },
        {
          "id": "25a7cb9b-aefb-56bc-a1e5-99f1af974fef-u04",
          "speaker_id": "b",
          "ja": "分かりました。店の担当に伝えて、連絡先をご案内します。",
          "vi": "Tôi hiểu rồi. Tôi báo người phụ trách cửa hàng và hướng dẫn anh đầu mối liên hệ."
        }
      ],
      "admin": {
