    {
      "situation_uid": "8c122db1-0204-57b9-b567-3b5273216eed",
      "event_id": "E03",
      "context_vi": "Người giao hàng của Haru hư cấu gọi trước khi đến. Bạn muốn xác nhận cửa nhà mình và khung giờ đã hẹn trong phiếu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người giao hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8c122db1-0204-57b9-b567-3b5273216eed-u01",
          "speaker_id": "b",
          "ja": "ハルの配達です。今日の午後に伺います。",
          "vi": "Tôi giao hàng của Haru. Chiều nay tôi tới ạ."
        },
        {
          "id": "8c122db1-0204-57b9-b567-3b5273216eed-u02",
          "speaker_id": "a",
          "ja": "入口は建物の北側です。二時から四時の間ですね。",
          "vi": "Cửa vào ở phía bắc tòa nhà. Khoảng 2 đến 4 giờ chiều nhỉ?"
        },
        {
          "id": "8c122db1-0204-57b9-b567-3b5273216eed-u03",
          "speaker_id": "b",
          "ja": "はい、その時間です。北側の入口へ行きます。",
          "vi": "Đúng, trong khung giờ đó. Tôi sẽ đến cửa phía bắc."
        }
      ],
      "admin": {
        "source_refs": [
          "delivery_book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8c122db1-0204-57b9-b567-3b5273216eed-u01": {
