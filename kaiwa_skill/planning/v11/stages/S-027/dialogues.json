            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "b1c619f8-59b7-5cc3-8965-cd4c683ff7bf",
      "event_id": "E01",
      "context_vi": "Sau cuộc trao đổi trước ở Haru, bạn và nhân viên đang cầm tấm ván rộng 90 cm thay cho tấm 80 cm chưa có. Nhân viên đã ghi mã món để hỏi quầy cắt, chưa hứa sẽ cắt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên home center",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b1c619f8-59b7-5cc3-8965-cd4c683ff7bf-u01",
          "speaker_id": "b",
          "ja": "この板の番号はH12です。何枚必要ですか。",
          "vi": "Mã tấm ván này là H12. Anh cần mấy tấm?"
        },
        {
          "id": "b1c619f8-59b7-5cc3-8965-cd4c683ff7bf-u02",
          "speaker_id": "a",
          "ja": "H12を二枚です。切れるか聞いてから買います。",
          "vi": "Tôi cần hai tấm H12. Tôi sẽ hỏi có cắt được không rồi mới mua."
        },
        {
          "id": "b1c619f8-59b7-5cc3-8965-cd4c683ff7bf-u03",
          "speaker_id": "b",
          "ja": "分かりました。二枚ですね。",
          "vi": "Tôi hiểu rồi, hai tấm nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "shelf",
          "cainz_cut"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b1c619f8-59b7-5cc3-8965-cd4c683ff7bf-u01": {
