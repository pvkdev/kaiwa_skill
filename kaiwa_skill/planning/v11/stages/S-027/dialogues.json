    {
      "situation_uid": "00987a75-2258-501c-99e0-11b6cbc7b75c",
      "event_id": "E03",
      "context_vi": "Sau cuộc trao đổi trước, người giao hàng đưa hai hộp nhỏ; hộp kệ lớn vẫn chưa nhận. Bạn kiểm số món trên phiếu giao hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người giao hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "00987a75-2258-501c-99e0-11b6cbc7b75c-u01",
          "speaker_id": "b",
          "ja": "小さい箱を二つお渡しします。",
          "vi": "Tôi giao hai hộp nhỏ ạ."
        },
        {
          "id": "00987a75-2258-501c-99e0-11b6cbc7b75c-u02",
          "speaker_id": "a",
          "ja": "一つ、二つ。二箱受け取りました。大きい箱は未受け取りですね。",
          "vi": "Một, hai. Tôi đã nhận hai hộp. Hộp lớn vẫn chưa nhận nhỉ."
        },
        {
          "id": "00987a75-2258-501c-99e0-11b6cbc7b75c-u03",
          "speaker_id": "b",
          "ja": "はい。店にもそのように伝えます。",
          "vi": "Đúng ạ. Tôi sẽ báo cửa hàng như vậy."
        }
      ],
      "admin": {
