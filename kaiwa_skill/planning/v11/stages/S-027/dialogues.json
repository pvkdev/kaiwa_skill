    {
      "situation_uid": "9561da0d-47ad-5551-a2b7-00a177d04cf0",
      "event_id": "E02",
      "context_vi": "Quầy Haru hư cấu đang tính phí giao chiếc kệ cho địa chỉ bạn vừa cung cấp. Bạn muốn biết tổng trước khi quyết định; chưa đặt giao.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên dịch vụ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9561da0d-47ad-5551-a2b7-00a177d04cf0-u01",
          "speaker_id": "a",
          "ja": "配達料を入れた合計を先に知りたいです。",
          "vi": "Tôi muốn biết tổng cả phí giao trước ạ."
        },
        {
          "id": "9561da0d-47ad-5551-a2b7-00a177d04cf0-u02",
          "speaker_id": "b",
          "ja": "計算しますので、少々お待ちください。",
          "vi": "Tôi sẽ tính, anh chờ chút nhé."
        },
        {
          "id": "9561da0d-47ad-5551-a2b7-00a177d04cf0-u03",
          "speaker_id": "a",
          "ja": "はい。金額を聞いてから決めます。",
          "vi": "Vâng. Tôi nghe tổng tiền rồi quyết định."
        }
      ],
      "admin": {
