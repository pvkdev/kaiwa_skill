  "dialogues": [
    {
      "situation_uid": "9c6c2045-99ea-53ff-833d-f0b0c22c504e",
      "event_id": "E01",
      "context_vi": "Tại home center Haru hư cấu, bạn muốn đặt kệ vào chỗ rộng khoảng 80 cm trong nhà.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên home center",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9c6c2045-99ea-53ff-833d-f0b0c22c504e-u01",
          "speaker_id": "a",
          "ja": "幅八十センチぐらいの場所に置く棚を探しています。",
          "vi": "Tôi tìm kệ để đặt vào chỗ rộng khoảng 80 cm ạ."
        },
        {
          "id": "9c6c2045-99ea-53ff-833d-f0b0c22c504e-u02",
          "speaker_id": "b",
          "ja": "高さはどれくらいですか。",
          "vi": "Chỗ đó cao khoảng bao nhiêu ạ?"
        },
        {
          "id": "9c6c2045-99ea-53ff-833d-f0b0c22c504e-u03",
          "speaker_id": "a",
          "ja": "一メートルぐらいです。",
          "vi": "Khoảng một mét ạ."
        },
        {
          "id": "9c6c2045-99ea-53ff-833d-f0b0c22c504e-u04",
          "speaker_id": "b",
          "ja": "では、この棚のサイズを一緒に見ましょう。",
          "vi": "Vậy mình cùng xem kích thước kệ này nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9c6c2045-99ea-53ff-833d-f0b0c22c504e-u01": {
