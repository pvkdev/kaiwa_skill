          }
        }
      }
    },
    {
      "situation_uid": "dfd56088-1e93-5185-8c8c-58edeaab29f3",
      "event_id": "E02",
      "context_vi": "Tại quầy dịch vụ Haru hư cấu, bạn mang mã tấm ván H12 và hỏi có thể cắt từ 90 cm xuống 80 cm không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên dịch vụ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "dfd56088-1e93-5185-8c8c-58edeaab29f3-u01",
          "speaker_id": "a",
          "ja": "H12の板を八十センチに切ってもらえますか。",
          "vi": "Cửa hàng cắt tấm H12 còn 80 cm giúp tôi được không ạ?"
        },
        {
          "id": "dfd56088-1e93-5185-8c8c-58edeaab29f3-u02",
          "speaker_id": "b",
          "ja": "この板が対象か確認します。今日こちらで買う物ですか。",
          "vi": "Tôi kiểm tra xem tấm này có thuộc diện nhận cắt không. Anh mua ở đây hôm nay phải không?"
        },
        {
          "id": "dfd56088-1e93-5185-8c8c-58edeaab29f3-u03",
          "speaker_id": "a",
          "ja": "はい、今日ここで買います。",
          "vi": "Vâng, tôi mua ở đây hôm nay."
        },
        {
          "id": "dfd56088-1e93-5185-8c8c-58edeaab29f3-u04",
          "speaker_id": "b",
          "ja": "では、寸法も確認します。",
          "vi": "Vậy tôi sẽ kiểm luôn số đo ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "cainz_cut",
          "komeri_cut"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "dfd56088-1e93-5185-8c8c-58edeaab29f3-u01": {
