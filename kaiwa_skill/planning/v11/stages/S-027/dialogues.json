          }
        }
      }
    },
    {
      "situation_uid": "15c89bcf-a597-5fb0-beec-56da489c196f",
      "event_id": "E01",
      "context_vi": "Tại Haru, bạn định đặt một chiếc kệ trong phòng tắm ẩm. Bạn hỏi về chất liệu của hai mẫu, không xin đảm bảo độ bền.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên home center",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "15c89bcf-a597-5fb0-beec-56da489c196f-u01",
          "speaker_id": "a",
          "ja": "浴室の近くに置きます。水に強いのはどちらですか。",
          "vi": "Tôi đặt gần phòng tắm. Loại nào chịu nước tốt hơn ạ?"
        },
        {
          "id": "15c89bcf-a597-5fb0-beec-56da489c196f-u02",
          "speaker_id": "b",
          "ja": "こちらは樹脂製です。もう一つは木製です。",
          "vi": "Mẫu này bằng nhựa, mẫu kia bằng gỗ ạ."
        },
        {
          "id": "15c89bcf-a597-5fb0-beec-56da489c196f-u03",
          "speaker_id": "a",
          "ja": "樹脂のほうを見せてください。",
          "vi": "Cho tôi xem mẫu bằng nhựa ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "15c89bcf-a597-5fb0-beec-56da489c196f-u01": {
            "kind": "original_extension"
          },
          "15c89bcf-a597-5fb0-beec-56da489c196f-u02": {
            "kind": "original_extension"
          },
          "15c89bcf-a597-5fb0-beec-56da489c196f-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0e8dfc39-1845-53fe-9e9b-93ac6092e1c0",
      "event_id": "E01",
      "context_vi": "Ở Haru, bạn mới lắp đồ đơn giản và so hai loại tua vít về độ dễ cầm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên home center",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0e8dfc39-1845-53fe-9e9b-93ac6092e1c0-u01",
          "speaker_id": "a",
          "ja": "この二つなら、持ちやすいのはどちらですか。",
          "vi": "Trong hai cái này, cái nào dễ cầm hơn ạ?"
        },
        {
          "id": "0e8dfc39-1845-53fe-9e9b-93ac6092e1c0-u02",
          "speaker_id": "b",
          "ja": "こちらは柄が太いです。実際に持ってみてください。",
          "vi": "Cái này tay cầm to hơn. Anh thử cầm xem ạ."
        },
        {
          "id": "0e8dfc39-1845-53fe-9e9b-93ac6092e1c0-u03",
          "speaker_id": "a",
          "ja": "こちらのほうが持ちやすいです。",
          "vi": "Tôi thấy cái này dễ cầm hơn."
        }
      ],
      "admin": {
        "source_refs": [
          "shelf"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0e8dfc39-1845-53fe-9e9b-93ac6092e1c0-u01": {
