        }
      }
    },
    {
      "situation_uid": "42514d75-7e9c-5167-b6ff-b4c7d45674e9",
      "event_id": "E02",
      "context_vi": "Tại quầy cắt Haru hư cấu, nhân viên báo máy của quầy này chỉ nhận cắt thẳng tối thiểu 80 cm; bạn từng xin 75 cm và điều chỉnh yêu cầu. Đây là điều kiện riêng trong cảnh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên dịch vụ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "42514d75-7e9c-5167-b6ff-b4c7d45674e9-u01",
          "speaker_id": "b",
          "ja": "この板はまっすぐ八十センチまでなら切れます。七十五センチはできません。",
          "vi": "Tấm này chỉ cắt thẳng đến tối thiểu 80 cm; 75 cm thì quầy không làm được ạ."
        },
        {
          "id": "42514d75-7e9c-5167-b6ff-b4c7d45674e9-u02",
          "speaker_id": "a",
          "ja": "分かりました。では、八十センチでお願いします。",
          "vi": "Tôi hiểu rồi. Vậy nhờ cắt còn 80 cm ạ."
        },
        {
          "id": "42514d75-7e9c-5167-b6ff-b4c7d45674e9-u03",
          "speaker_id": "b",
          "ja": "八十センチですね。もう一度寸法を見ます。",
          "vi": "80 cm nhé. Tôi kiểm lại số đo."
        }
      ],
      "admin": {
        "source_refs": [
          "cainz_cut"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
        "turn_origins": {
