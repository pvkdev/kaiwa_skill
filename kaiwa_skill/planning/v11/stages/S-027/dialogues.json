    {
      "situation_uid": "bee5f699-eb93-5e82-b80f-2cb2b548d40f",
      "event_id": "E04",
      "context_vi": "Ở Haru, bạn cần tấm vật liệu thay cho tấm gỗ đặt nơi ẩm. Nhân viên gợi ý xem nhãn vật liệu cụ thể, không bảo đảm tuổi thọ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "bee5f699-eb93-5e82-b80f-2cb2b548d40f-u01",
          "speaker_id": "a",
          "ja": "湿った場所に置く板は、ほかにありますか。",
          "vi": "Có tấm nào khác để ở nơi ẩm không ạ?"
        },
        {
          "id": "bee5f699-eb93-5e82-b80f-2cb2b548d40f-u02",
          "speaker_id": "b",
          "ja": "樹脂製の板があります。サイズはこちらに書いてあります。",
          "vi": "Có tấm bằng nhựa ạ. Kích thước ghi ở đây."
        },
        {
          "id": "bee5f699-eb93-5e82-b80f-2cb2b548d40f-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。幅を見ます。",
          "vi": "Cảm ơn chị. Tôi xem chiều rộng."
        }
      ],
      "admin": {
