    {
      "situation_uid": "87307ad1-ac94-5947-bd04-636c8c68b436",
      "event_id": "E04",
      "context_vi": "Bạn trở lại Haru: kệ mua trước đó không vừa chỗ đặt vì chính bạn đo nhầm. Bạn nói rõ nguyên nhân và hỏi lựa chọn, chưa giả định được đổi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "87307ad1-ac94-5947-bd04-636c8c68b436-u01",
          "speaker_id": "a",
          "ja": "私が幅を測り間違えました。この棚は家に入りません。",
          "vi": "Tôi đo nhầm chiều rộng. Chiếc kệ này không vừa nhà ạ."
        },
        {
          "id": "87307ad1-ac94-5947-bd04-636c8c68b436-u02",
          "speaker_id": "b",
          "ja": "そうでしたか。今の幅は分かりますか。",
          "vi": "Vậy à. Anh biết chiều rộng thực tế chưa?"
        },
        {
          "id": "87307ad1-ac94-5947-bd04-636c8c68b436-u03",
          "speaker_id": "a",
          "ja": "はい、七十五センチです。別の物を見たいです。",
          "vi": "Có ạ, 75 cm. Tôi muốn xem loại khác."
        },
        {
          "id": "87307ad1-ac94-5947-bd04-636c8c68b436-u04",
          "speaker_id": "b",
          "ja": "では、七十五センチより小さい棚を見ましょう。",
          "vi": "Vậy mình xem kệ nhỏ hơn 75 cm nhé."
        }
      ],
      "admin": {
