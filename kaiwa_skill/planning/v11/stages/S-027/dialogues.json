    {
      "situation_uid": "8b5036ae-5024-5408-9394-45d0367ff385",
      "event_id": "E02",
      "context_vi": "Ở Haru hư cấu, quầy báo tổng kệ và giao là 12.000 yên, vượt ngân sách 10.000 yên của bạn. Bạn hỏi về mẫu nhỏ tự mang; số tiền là ví dụ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên dịch vụ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8b5036ae-5024-5408-9394-45d0367ff385-u01",
          "speaker_id": "b",
          "ja": "棚と配達で合計一万二千円です。",
          "vi": "Kệ và phí giao tổng cộng 12.000 yên ạ."
        },
        {
          "id": "8b5036ae-5024-5408-9394-45d0367ff385-u02",
          "speaker_id": "a",
          "ja": "予算は一万円です。配達はやめて、小さい棚を持って帰れますか。",
          "vi": "Tôi dự tính 10.000 yên. Tôi thôi giao, có thể tự mang mẫu kệ nhỏ về không ạ?"
        },
        {
          "id": "8b5036ae-5024-5408-9394-45d0367ff385-u03",
          "speaker_id": "b",
          "ja": "小さい棚はこちらです。サイズを見てください。",
          "vi": "Kệ nhỏ ở đây ạ. Anh xem kích thước nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "delivery_book"
        ],
