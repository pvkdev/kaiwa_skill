    {
      "situation_uid": "b30322b9-9cd0-5c56-b1b0-4ccea563857c",
      "event_id": "E02",
      "context_vi": "Ở quầy dịch vụ Haru, bạn mua kệ lớn và hỏi liệu cửa hàng này có giao vào cuối tuần không. Chưa có lịch được xác nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên dịch vụ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b30322b9-9cd0-5c56-b1b0-4ccea563857c-u01",
          "speaker_id": "a",
          "ja": "この大きい棚を週末に配達できますか。",
          "vi": "Cửa hàng giao chiếc kệ lớn này vào cuối tuần được không ạ?"
        },
        {
          "id": "b30322b9-9cd0-5c56-b1b0-4ccea563857c-u02",
          "speaker_id": "b",
          "ja": "お届け先を聞いてから、空きを確認します。",
          "vi": "Tôi cần địa chỉ giao rồi mới kiểm lịch trống ạ."
        },
        {
          "id": "b30322b9-9cd0-5c56-b1b0-4ccea563857c-u03",
          "speaker_id": "a",
          "ja": "分かりました。住所を伝えます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ cho chị địa chỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "delivery_book"
        ],
