    {
      "situation_uid": "360c88ac-d84d-519c-a9df-f25c91a81371",
      "event_id": "E04",
      "context_vi": "Bạn gọi Hina hư cấu khi đã quá 19 giờ đặt bàn. Nhân viên nói không thể giữ bàn cũ nữa; bạn hỏi còn giờ nào khác, chưa coi chỗ mới đã đặt.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận đặt",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "360c88ac-d84d-519c-a9df-f25c91a81371-u01",
          "speaker_id": "a",
          "ja": "七時の予約に間に合いませんでした。今から行ける席はありますか。",
          "vi": "Tôi không kịp giờ đặt 7 giờ. Bây giờ còn bàn nào tôi đến được không ạ?"
        },
        {
          "id": "360c88ac-d84d-519c-a9df-f25c91a81371-u02",
          "speaker_id": "b",
          "ja": "七時の席はもうご用意できません。七時半なら確認できます。",
          "vi": "Bàn 7 giờ không còn giữ được. Tôi có thể kiểm tra bàn 7 giờ 30 ạ."
        },
        {
          "id": "360c88ac-d84d-519c-a9df-f25c91a81371-u03",
          "speaker_id": "a",
          "ja": "七時半の空きを確認していただけますか。",
          "vi": "Chị kiểm tra chỗ 7 giờ 30 giúp tôi được không?"
        },
        {
          "id": "360c88ac-d84d-519c-a9df-f25c91a81371-u04",
          "speaker_id": "b",
          "ja": "はい。確認してお答えします。",
          "vi": "Vâng, tôi kiểm rồi trả lời ạ."
        }
      ],
