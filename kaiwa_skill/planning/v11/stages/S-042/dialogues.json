        }
      }
    },
    {
      "situation_uid": "4213877c-1496-5bd9-8ff1-29331cce23cc",
      "event_id": "E02",
      "context_vi": "Bạn gọi cô Mori để hỏi về giờ buổi học. Trước khi trình bày, bạn hỏi cô có tiện nói chuyện lúc này không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thầy cô",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4213877c-1496-5bd9-8ff1-29331cce23cc-u01",
          "speaker_id": "a",
          "ja": "森先生、グエンです。今、お話ししてもよろしいですか。",
          "vi": "Cô Mori ạ, em là Nguyễn. Bây giờ em nói chuyện được không ạ?"
        },
        {
          "id": "4213877c-1496-5bd9-8ff1-29331cce23cc-u02",
          "speaker_id": "b",
          "ja": "はい、今は大丈夫ですよ。",
          "vi": "Ừ, giờ cô nghe được."
        },
        {
          "id": "4213877c-1496-5bd9-8ff1-29331cce23cc-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。明日の授業は九時からでしょうか。",
          "vi": "Em cảm ơn. Buổi học ngày mai bắt đầu lúc 9 giờ phải không ạ?"
        },
        {
          "id": "4213877c-1496-5bd9-8ff1-29331cce23cc-u04",
          "speaker_id": "b",
          "ja": "はい、九時からです。",
          "vi": "Đúng, 9 giờ bắt đầu."
        }
      ],
      "admin": {
