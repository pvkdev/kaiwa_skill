    {
      "situation_uid": "6d891f27-42d0-57da-8389-d40cab09a6af",
      "event_id": "E02",
      "context_vi": "Bạn gọi cô giáo Mori lúc 20 giờ để hỏi ngắn về buổi học ngày mai. Bạn tự giới thiệu và xin lỗi vì gọi hơi muộn, chờ cô cho biết có tiện nghe không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thầy cô",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "6d891f27-42d0-57da-8389-d40cab09a6af-u01",
          "speaker_id": "a",
          "ja": "もしもし、森先生ですか。グエンです。夜にお電話してすみません。今、少しよろしいですか。",
          "vi": "A lô, cô Mori phải không ạ? Em là Nguyễn. Xin lỗi vì gọi buổi tối. Giờ cô có tiện nghe một chút không ạ?"
        },
        {
          "id": "6d891f27-42d0-57da-8389-d40cab09a6af-u02",
          "speaker_id": "b",
          "ja": "はい、森です。今なら少し大丈夫ですよ。",
          "vi": "Ừ, cô Mori đây. Giờ cô nói được một chút."
        },
        {
          "id": "6d891f27-42d0-57da-8389-d40cab09a6af-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。明日の授業のことで一つ確認したいです。",
          "vi": "Em cảm ơn. Em muốn hỏi một điều về buổi học ngày mai."
        },
        {
          "id": "6d891f27-42d0-57da-8389-d40cab09a6af-u04",
          "speaker_id": "b",
          "ja": "はい、何でしょう。",
          "vi": "Ừ, em hỏi đi."
        }
      ],
      "admin": {
        "source_refs": [
          "phone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "6d891f27-42d0-57da-8389-d40cab09a6af-u01": {
