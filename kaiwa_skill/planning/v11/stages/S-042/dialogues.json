          "id": "0d5c7734-b693-58d9-93e4-cd97c2098c0a-u02",
          "speaker_id": "b",
          "ja": "確認します。少々お待ちください。",
          "vi": "Tôi kiểm tra ạ. Xin chờ chút."
        },
        {
          "id": "0d5c7734-b693-58d9-93e4-cd97c2098c0a-u03",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ chị."
        },
