    {
      "situation_uid": "36e353e1-a5a8-5abd-9fb5-fc782e291790",
      "event_id": "E04",
      "context_vi": "Bạn có bàn Hina hư cấu lúc 19 giờ nhưng thấy mình sẽ tới sau giờ đó. Bạn hỏi nhân viên liệu cần đổi giờ đặt, chưa tự ý cho rằng chỗ sẽ giữ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận đặt",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "36e353e1-a5a8-5abd-9fb5-fc782e291790-u01",
          "speaker_id": "a",
          "ja": "七時の予約ですが、到着が少し遅れそうです。時間を変更したほうがいいですか。",
          "vi": "Tôi đặt 7 giờ nhưng có thể đến muộn một chút. Tôi nên đổi giờ không ạ?"
        },
        {
          "id": "36e353e1-a5a8-5abd-9fb5-fc782e291790-u02",
          "speaker_id": "b",
          "ja": "お名前と到着予定を教えてください。空き状況を確認します。",
          "vi": "Cho tôi xin tên và giờ dự kiến tới. Tôi kiểm tra chỗ trống ạ."
        },
        {
          "id": "36e353e1-a5a8-5abd-9fb5-fc782e291790-u03",
          "speaker_id": "a",
          "ja": "グエンです。七時二十分ごろです。",
          "vi": "Tôi là Nguyễn. Khoảng 7 giờ 20 ạ."
        },
        {
          "id": "36e353e1-a5a8-5abd-9fb5-fc782e291790-u04",
          "speaker_id": "b",
          "ja": "分かりました。確認してからご案内します。",
          "vi": "Tôi hiểu. Tôi kiểm tra rồi báo anh."
        }
      ],
      "admin": {
