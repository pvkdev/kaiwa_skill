    {
      "situation_uid": "db2d4f57-4df4-50d0-9e97-389a300ad268",
      "event_id": "E01",
      "context_vi": "Đúng 19 giờ, bạn gọi lại cho Mai như đã hẹn khi Mai đang trên đường. Bây giờ hai người xác nhận buổi gặp ngày mai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "bạn",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "db2d4f57-4df4-50d0-9e97-389a300ad268-u01",
          "speaker_id": "a",
          "ja": "もしもし、マイさん。七時になったから、かけ直したよ。今、話せる？",
          "vi": "A lô Mai. Đến 7 giờ nên tôi gọi lại. Giờ nói chuyện được chứ?"
        },
        {
          "id": "db2d4f57-4df4-50d0-9e97-389a300ad268-u02",
          "speaker_id": "b",
          "ja": "うん、家に着いたよ。大丈夫。",
          "vi": "Ừ, tôi về nhà rồi. Nói được."
        },
        {
          "id": "db2d4f57-4df4-50d0-9e97-389a300ad268-u03",
          "speaker_id": "a",
          "ja": "明日は十一時に駅の南口でいい？",
          "vi": "Ngày mai 11 giờ ở cửa nam ga nhé?"
        },
        {
          "id": "db2d4f57-4df4-50d0-9e97-389a300ad268-u04",
          "speaker_id": "b",
          "ja": "うん、そこで会おう。",
          "vi": "Ừ, gặp ở đó nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "phone"
        ],
