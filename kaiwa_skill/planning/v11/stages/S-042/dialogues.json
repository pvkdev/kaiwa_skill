          "8f3963b7-e9fe-52f7-988a-8d6d7c25ddc3-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "893d5f97-1be5-5f14-a412-7e8c68aeccc4",
      "event_id": "E01",
      "context_vi": "Bạn gọi số của bạn Mika nhưng nghe giọng người khác và tưởng là Mika. Người bắt máy là Aya, cũng là bạn của bạn; bạn xác nhận lại tên trước khi nói việc riêng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "bạn",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "893d5f97-1be5-5f14-a412-7e8c68aeccc4-u01",
          "speaker_id": "a",
          "ja": "もしもし、ミカさん？",
          "vi": "A lô, Mika à?"
        },
        {
          "id": "893d5f97-1be5-5f14-a412-7e8c68aeccc4-u02",
          "speaker_id": "b",
          "ja": "違うよ、アヤだよ。",
          "vi": "Không, Aya đây."
        },
        {
          "id": "893d5f97-1be5-5f14-a412-7e8c68aeccc4-u03",
          "speaker_id": "a",
          "ja": "あ、ごめん。アヤさんだったね。ミカさんにかけたつもりだった。",
          "vi": "À, xin lỗi. Hóa ra là Aya. Tôi tưởng mình gọi cho Mika."
        },
        {
          "id": "893d5f97-1be5-5f14-a412-7e8c68aeccc4-u04",
          "speaker_id": "b",
          "ja": "大丈夫。番号を確認してみて。",
          "vi": "Không sao. Bạn kiểm lại số nhé."
        },
        {
          "id": "893d5f97-1be5-5f14-a412-7e8c68aeccc4-u05",
          "speaker_id": "a",
          "ja": "ありがとう。確認してかけ直すね。",
          "vi": "Cảm ơn. Tôi sẽ kiểm rồi gọi lại."
        }
      ],
      "admin": {
        "source_refs": [
          "phone"
        ],
        "specialty_item_ids": [],
