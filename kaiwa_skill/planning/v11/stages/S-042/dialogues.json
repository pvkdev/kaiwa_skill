    {
      "situation_uid": "25236cd0-dc56-54de-849e-388e5df292e2",
      "event_id": "E01",
      "context_vi": "Bạn gọi Mai, nhưng Mai đang trên đường và chưa thể nói. Hai người hẹn bạn gọi lại lúc 19 giờ; việc hẹn ngày mai chưa bàn xong.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "bạn",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "25236cd0-dc56-54de-849e-388e5df292e2-u01",
          "speaker_id": "b",
          "ja": "ごめん、今は外を歩いていて話せない。",
          "vi": "Xin lỗi, giờ tôi đang đi ngoài đường, chưa nói chuyện được."
        },
        {
          "id": "25236cd0-dc56-54de-849e-388e5df292e2-u02",
          "speaker_id": "a",
          "ja": "分かった。何時なら電話できる？",
          "vi": "Tôi hiểu. Mấy giờ tôi gọi được?"
        },
        {
          "id": "25236cd0-dc56-54de-849e-388e5df292e2-u03",
          "speaker_id": "b",
          "ja": "七時なら家にいるよ。",
          "vi": "7 giờ tôi ở nhà."
        },
        {
          "id": "25236cd0-dc56-54de-849e-388e5df292e2-u04",
          "speaker_id": "a",
          "ja": "じゃ、七時にかけ直すね。",
          "vi": "Vậy 7 giờ tôi gọi lại nhé."
        },
        {
          "id": "25236cd0-dc56-54de-849e-388e5df292e2-u05",
          "speaker_id": "b",
          "ja": "うん、お願い。",
          "vi": "Ừ, nhờ bạn."
        }
      ],
      "admin": {
        "source_refs": [
          "phone"
        ],
        "specialty_item_ids": [],
