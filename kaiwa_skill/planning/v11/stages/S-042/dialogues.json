    {
      "situation_uid": "55e8169f-8e50-5be6-961e-334b742a2dda",
      "event_id": "E04",
      "context_vi": "Bạn đến Hina hư cấu trước 19 giờ 30, giờ mới đã xác nhận qua điện thoại sau khi trễ hẹn 19 giờ. Bạn nhắc tên và giờ mới tại cửa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận đặt",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "55e8169f-8e50-5be6-961e-334b742a2dda-u01",
          "speaker_id": "a",
          "ja": "電話で時間の変更をお願いしたグエンです。七時半に二人で予約しています。",
          "vi": "Tôi là Nguyễn, đã gọi đổi giờ. Tôi đặt 7 giờ 30 cho hai người ạ."
        },
        {
          "id": "55e8169f-8e50-5be6-961e-334b742a2dda-u02",
          "speaker_id": "b",
          "ja": "はい、グエン様、七時半に二名様ですね。",
          "vi": "Vâng, anh Nguyễn, 7 giờ 30 hai người ạ."
        },
        {
          "id": "55e8169f-8e50-5be6-961e-334b742a2dda-u03",
          "speaker_id": "a",
          "ja": "はい。遅くなってすみません。",
          "vi": "Vâng. Xin lỗi vì đã đến muộn."
        },
        {
          "id": "55e8169f-8e50-5be6-961e-334b742a2dda-u04",
          "speaker_id": "b",
          "ja": "ご連絡ありがとうございます。お席へご案内します。",
          "vi": "Cảm ơn anh đã gọi báo. Tôi dẫn anh đến bàn ạ."
        }
      ],
