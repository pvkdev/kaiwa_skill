  "dialogues": [
    {
      "situation_uid": "4b6ac780-0a32-5510-bb4d-06d963a91aee",
      "event_id": "E01",
      "context_vi": "Bạn gọi cho bạn Mai vào buổi chiều để hỏi một việc ngắn. Bạn xác nhận đúng Mai và hỏi có tiện nói lúc này không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "bạn",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4b6ac780-0a32-5510-bb4d-06d963a91aee-u01",
          "speaker_id": "a",
          "ja": "もしもし、マイさん？　今、少し話せる？",
          "vi": "A lô, Mai à? Giờ nói chuyện một chút được không?"
        },
        {
          "id": "4b6ac780-0a32-5510-bb4d-06d963a91aee-u02",
          "speaker_id": "b",
          "ja": "うん、私だよ。今なら大丈夫。",
          "vi": "Ừ, tôi đây. Giờ nói được."
        },
        {
          "id": "4b6ac780-0a32-5510-bb4d-06d963a91aee-u03",
          "speaker_id": "a",
          "ja": "ありがとう。明日の約束のことで電話したんだ。",
          "vi": "Cảm ơn. Tôi gọi về buổi hẹn ngày mai."
        },
        {
          "id": "4b6ac780-0a32-5510-bb4d-06d963a91aee-u04",
          "speaker_id": "b",
          "ja": "うん、どうしたの？",
          "vi": "Ừ, có chuyện gì?"
        }
      ],
      "admin": {
        "source_refs": [
          "phone"
        ],
        "specialty_item_ids": [],
