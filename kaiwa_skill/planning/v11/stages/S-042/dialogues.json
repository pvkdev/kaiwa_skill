      ],
      "turns": [
        {
          "id": "0d5c7734-b693-58d9-93e4-cd97c2098c0a-u01",
          "speaker_id": "a",
          "ja": "金曜日の夜七時に、二人の席はありますか。",
          "vi": "Tối thứ Sáu lúc 7 giờ còn bàn cho hai người không ạ?"
