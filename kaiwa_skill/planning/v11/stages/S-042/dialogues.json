    {
      "situation_uid": "a3aee465-3a23-587a-abd8-6278cc21a472",
      "event_id": "E02",
      "context_vi": "Bạn gọi nhà cô Mori. Mẹ cô bắt máy và nói cô chưa về; bạn nhờ chuyển lời rằng mình sẽ tự gọi lại lúc 18 giờ, không nhờ cô gọi bạn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người nhà của thầy cô",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "a3aee465-3a23-587a-abd8-6278cc21a472-u01",
          "speaker_id": "a",
          "ja": "もしもし、森先生はいらっしゃいますか。グエンと申します。",
          "vi": "A lô, cho em hỏi cô Mori có nhà không ạ? Em là Nguyễn."
        },
        {
          "id": "a3aee465-3a23-587a-abd8-6278cc21a472-u02",
          "speaker_id": "b",
          "ja": "森はまだ帰っていません。",
          "vi": "Mori vẫn chưa về."
        },
        {
          "id": "a3aee465-3a23-587a-abd8-6278cc21a472-u03",
          "speaker_id": "a",
