    {
      "situation_uid": "26b8b059-0eee-5ead-a2db-41a8afcd69ab",
      "event_id": "E04",
      "context_vi": "Sau khi bàn 19 giờ ở Hina hư cấu không còn giữ được, nhân viên kiểm và xác nhận còn bàn 19 giờ 30 cho hai người. Bạn chốt tên Nguyễn và giờ mới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên nhận đặt",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "26b8b059-0eee-5ead-a2db-41a8afcd69ab-u01",
          "speaker_id": "b",
          "ja": "七時半に二名様の席が空いています。変更しますか。",
          "vi": "7 giờ 30 còn bàn hai người. Anh muốn đổi sang giờ đó không?"
        },
        {
          "id": "26b8b059-0eee-5ead-a2db-41a8afcd69ab-u02",
          "speaker_id": "a",
          "ja": "はい。七時半、二人、グエンの名前でお願いします。",
          "vi": "Vâng. Cho tôi 7 giờ 30, hai người, tên Nguyễn."
        },
        {
          "id": "26b8b059-0eee-5ead-a2db-41a8afcd69ab-u03",
          "speaker_id": "b",
          "ja": "七時半、二名様、グエン様で予約を変更しました。",
          "vi": "Tôi đã đổi đặt chỗ sang 7 giờ 30, hai người, tên anh Nguyễn."
        },
        {
          "id": "26b8b059-0eee-5ead-a2db-41a8afcd69ab-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。七時半に伺います。",
          "vi": "Cảm ơn chị. Tôi sẽ đến lúc 7 giờ 30."
        }
      ],
