        {
          "id": "7d1317bd-6817-5038-b4f1-43ef6bec9c31-u04",
          "speaker_id": "a",
          "ja": "グエンです。金曜日の七時半、二人です。",
          "vi": "Tôi là Nguyễn. Thứ Sáu 7 giờ 30, hai người ạ."
        },
        {
          "id": "7d1317bd-6817-5038-b4f1-43ef6bec9c31-u05",
          "speaker_id": "b",
          "ja": "承りました。",
          "vi": "Tôi đã ghi ạ."
