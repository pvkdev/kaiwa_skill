          }
        }
      }
    },
    {
      "situation_uid": "8f3963b7-e9fe-52f7-988a-8d6d7c25ddc3",
      "event_id": "E01",
      "context_vi": "Bạn gọi cho Mai để xác nhận buổi gặp ngày mai tại cửa ga lúc 11 giờ. Cả hai nói lại giờ và địa điểm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "bạn",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8f3963b7-e9fe-52f7-988a-8d6d7c25ddc3-u01",
          "speaker_id": "a",
          "ja": "明日は十一時に駅の南口で会うんだよね。",
          "vi": "Ngày mai mình gặp lúc 11 giờ ở cửa nam ga nhỉ?"
        },
        {
          "id": "8f3963b7-e9fe-52f7-988a-8d6d7c25ddc3-u02",
          "speaker_id": "b",
          "ja": "うん、南口で十一時。",
          "vi": "Ừ, 11 giờ ở cửa nam."
        },
        {
          "id": "8f3963b7-e9fe-52f7-988a-8d6d7c25ddc3-u03",
          "speaker_id": "a",
          "ja": "分かった。着いたら電話するね。",
          "vi": "Được. Đến nơi tôi sẽ gọi nhé."
        },
        {
          "id": "8f3963b7-e9fe-52f7-988a-8d6d7c25ddc3-u04",
          "speaker_id": "b",
          "ja": "うん、待ってるよ。",
          "vi": "Ừ, tôi sẽ đợi."
        }
      ],
      "admin": {
        "source_refs": [
          "phone"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8f3963b7-e9fe-52f7-988a-8d6d7c25ddc3-u01": {
            "kind": "original_extension"
          },
