          }
        }
      }
    },
    {
      "situation_uid": "87c4d9d1-f22e-5507-bb3a-0769c41c1748",
      "event_id": "E03",
      "context_vi": "Bạn mới mang bản sao của một giấy tờ liên quan đến hồ sơ. Nhân viên hẹn quay lại, nên bạn hỏi lần tới cần mang gì.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "87c4d9d1-f22e-5507-bb3a-0769c41c1748-u01",
          "speaker_id": "a",
          "ja": "次に来る時、何を持って来ればいいですか。",
          "vi": "Lần sau tôi cần mang những gì ạ?"
        },
        {
          "id": "87c4d9d1-f22e-5507-bb3a-0769c41c1748-u02",
          "speaker_id": "b",
          "ja": "本人確認書類と、この書類の原本をお持ちください。明日の午前九時に三番窓口へ来てください。",
          "vi": "Chị mang giấy tờ tùy thân và bản gốc của giấy này nhé. Sáng mai lúc 9 giờ, chị đến quầy số 3 ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "87c4d9d1-f22e-5507-bb3a-0769c41c1748-u01": {
