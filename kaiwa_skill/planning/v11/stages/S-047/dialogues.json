          }
        }
      }
    },
    {
      "situation_uid": "87c4d9d1-f22e-5507-bb3a-0769c41c1748",
      "event_id": "E03",
      "context_vi": "Bạn cần quay lại quầy hành chính hư cấu lần nữa. Bạn hỏi cần mang gì và tới quầy nào, lúc mấy giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "87c4d9d1-f22e-5507-bb3a-0769c41c1748-u01",
          "speaker_id": "a",
          "ja": "次に来る時、何を持って来ればいいですか。",
          "vi": "Lần sau tôi cần mang những gì ạ?"
        },
        {
          "id": "87c4d9d1-f22e-5507-bb3a-0769c41c1748-u02",
          "speaker_id": "b",
          "ja": "明日の九時に三番窓口へ、本人確認ができるものと書類の原本を持って来てください。",
          "vi": "Ngày mai lúc 9 giờ, bạn mang giấy tờ tùy thân và bản gốc giấy này tới quầy số 3 nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "87c4d9d1-f22e-5507-bb3a-0769c41c1748-u01": {
            "kind": "original_extension"
          },
          "87c4d9d1-f22e-5507-bb3a-0769c41c1748-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "355f0c9a-7938-5314-a926-895f96e0de32",
      "event_id": "E03",
      "context_vi": "Nhân viên vừa dặn mang bản gốc. Bạn hỏi từ 原本 nghĩa là gì để tránh mang nhầm bản sao.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "355f0c9a-7938-5314-a926-895f96e0de32-u01",
          "speaker_id": "a",
          "ja": "すみません、「原本」はどういう意味ですか。",
          "vi": "Xin lỗi, “genpon” nghĩa là gì ạ?"
        },
        {
          "id": "355f0c9a-7938-5314-a926-895f96e0de32-u02",
          "speaker_id": "b",
          "ja": "コピーではなく、元の書類です。",
          "vi": "Là bản gốc, không phải bản sao ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "355f0c9a-7938-5314-a926-895f96e0de32-u01": {
