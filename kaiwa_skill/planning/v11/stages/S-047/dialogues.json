        }
      }
    },
    {
      "situation_uid": "6f5a0d48-d5e2-582a-8b18-9c60e429cabc",
      "event_id": "E03",
      "context_vi": "Bạn thiếu bản gốc được yêu cầu cho lần đến tiếp. Bạn hỏi có thể quay lại ngày khác không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6f5a0d48-d5e2-582a-8b18-9c60e429cabc-u01",
          "speaker_id": "a",
          "ja": "今日は原本がありません。来週の月曜日に来てもいいですか。",
          "vi": "Hôm nay tôi không có bản gốc. Thứ Hai tuần sau tôi quay lại được không ạ?"
        },
        {
          "id": "6f5a0d48-d5e2-582a-8b18-9c60e429cabc-u02",
          "speaker_id": "b",
          "ja": "はい。月曜日は九時から、三番窓口で伺います。",
          "vi": "Được. Thứ Hai quầy số 3 tiếp nhận từ 9 giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
