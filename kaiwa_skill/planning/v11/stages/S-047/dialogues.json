          }
        }
      }
    },
    {
      "situation_uid": "c20dfd84-4178-5f0b-884d-264d1a79e912",
      "event_id": "E01",
      "context_vi": "Bạn đến lại quầy cư dân ở tầng hai nhưng hôm nay đã hết giờ tiếp nhận. Bạn hỏi giờ quay lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c20dfd84-4178-5f0b-884d-264d1a79e912-u01",
          "speaker_id": "b",
          "ja": "今日はもう受付が終わりました。",
          "vi": "Hôm nay quầy đã ngừng tiếp nhận rồi ạ."
        },
        {
          "id": "c20dfd84-4178-5f0b-884d-264d1a79e912-u02",
          "speaker_id": "a",
          "ja": "何時に来ればいいですか。",
          "vi": "Tôi nên quay lại lúc mấy giờ ạ?"
        },
        {
          "id": "c20dfd84-4178-5f0b-884d-264d1a79e912-u03",
          "speaker_id": "b",
          "ja": "明日は九時からです。",
          "vi": "Ngày mai từ 9 giờ ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c20dfd84-4178-5f0b-884d-264d1a79e912-u01": {
