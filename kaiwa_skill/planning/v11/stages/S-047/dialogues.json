    {
      "situation_uid": "22fb5f1d-4dc5-5941-b24f-bded5096f969",
      "event_id": "E03",
      "context_vi": "Trước khi rời quầy, bạn nhắc lại giờ và số quầy nhân viên vừa nói cho lần tới.",
      "speakers": [
        {
          "id": "a",
