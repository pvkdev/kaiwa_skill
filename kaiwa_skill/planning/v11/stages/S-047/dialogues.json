      "start_line": 381,
      "end_line": 412,
      "use_vi": "Cách hỏi quầy, xin giải thích từ chỉ giấy tờ và hỏi hỗ trợ ngôn ngữ."
    }
  },
  "dialogues": [
    {
      "situation_uid": "14e3f1c1-e0a3-5121-9626-8274542531a0",
      "event_id": "E01",
      "context_vi": "Bạn lần đầu tới tòa thị chính Midori hư cấu. Bạn muốn hỏi chuyện địa chỉ cư trú nhưng chưa biết quầy nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "14e3f1c1-e0a3-5121-9626-8274542531a0-u01",
          "speaker_id": "a",
          "ja": "住所のことで聞きたいです。どちらの窓口ですか。",
          "vi": "Tôi muốn hỏi về địa chỉ cư trú. Tôi nên đến quầy nào ạ?"
        },
        {
          "id": "14e3f1c1-e0a3-5121-9626-8274542531a0-u02",
          "speaker_id": "b",
          "ja": "二階の住民窓口です。",
          "vi": "Quầy cư dân ở tầng hai ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "14e3f1c1-e0a3-5121-9626-8274542531a0-u01": {
            "kind": "original_extension"
          },
          "14e3f1c1-e0a3-5121-9626-8274542531a0-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "5d433196-c08d-5a38-beae-7699ad4cd89f",
      "event_id": "E01",
      "context_vi": "Nhân viên sảnh vừa chỉ quầy cư dân ở tầng hai. Bạn hỏi lối cầu thang để tìm đúng quầy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5d433196-c08d-5a38-beae-7699ad4cd89f-u01",
          "speaker_id": "a",
          "ja": "二階の住民窓口は、どこから行きますか。",
          "vi": "Tôi đi lên quầy cư dân ở tầng hai bằng lối nào ạ?"
        },
        {
          "id": "5d433196-c08d-5a38-beae-7699ad4cd89f-u02",
          "speaker_id": "b",
          "ja": "右の階段からどうぞ。",
          "vi": "Mời đi cầu thang bên phải."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5d433196-c08d-5a38-beae-7699ad4cd89f-u01": {
            "kind": "original_extension"
          },
          "5d433196-c08d-5a38-beae-7699ad4cd89f-u02": {
