            "kind": "original_extension"
          },
          "c20dfd84-4178-5f0b-884d-264d1a79e912-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7cc19fb7-1cf0-5531-9f1a-29df9db0a6bc",
      "event_id": "E01",
      "context_vi": "Nhân viên sảnh vừa chỉ quầy ở tầng hai, nhưng bạn chưa nghe kịp tên quầy. Bạn xin nghe lại chậm hơn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7cc19fb7-1cf0-5531-9f1a-29df9db0a6bc-u01",
          "speaker_id": "a",
          "ja": "すみません。窓口の名前を、もう一度ゆっくりお願いします。",
          "vi": "Xin lỗi, anh nói chậm lại tên quầy giúp tôi được không ạ?"
        },
        {
          "id": "7cc19fb7-1cf0-5531-9f1a-29df9db0a6bc-u02",
          "speaker_id": "b",
          "ja": "じゅうみん、まどぐち、です。住所の相談をする窓口です。",
          "vi": "Quầy cư trú ạ. Đó là quầy để hỏi về địa chỉ cư trú."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7cc19fb7-1cf0-5531-9f1a-29df9db0a6bc-u01": {
            "kind": "original_extension"
          },
          "7cc19fb7-1cf0-5531-9f1a-29df9db0a6bc-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "c909322d-9cf2-503c-8137-7666698a348d",
      "event_id": "E02",
      "context_vi": "Bạn mang tờ giấy mẫu từ công ty đến quầy hành chính hư cấu để xin giấy xác nhận địa chỉ. Nhân viên cần xem quầy nào phụ trách.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c909322d-9cf2-503c-8137-7666698a348d-u01",
          "speaker_id": "a",
          "ja": "会社に出す住所の証明が必要です。こちらで取れますか。",
          "vi": "Tôi cần giấy xác nhận địa chỉ để nộp cho công ty. Tôi xin giấy đó ở quầy này được không ạ?"
        },
        {
          "id": "c909322d-9cf2-503c-8137-7666698a348d-u02",
          "speaker_id": "b",
          "ja": "見本を拝見して、担当窓口を確認します。",
          "vi": "Tôi xin xem giấy mẫu rồi xác định quầy phụ trách."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c909322d-9cf2-503c-8137-7666698a348d-u01": {
            "kind": "original_extension"
          },
          "c909322d-9cf2-503c-8137-7666698a348d-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "1d2e9f74-a6cc-5511-a09b-0d29d38c5987",
      "event_id": "E02",
      "context_vi": "Nhân viên đã xem giấy mẫu và xác nhận quầy này xử lý. Bạn hỏi cần xuất trình giấy tờ gì.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1d2e9f74-a6cc-5511-a09b-0d29d38c5987-u01",
          "speaker_id": "b",
          "ja": "この証明は、こちらで扱います。",
          "vi": "Giấy này do quầy chúng tôi xử lý ạ."
        },
        {
          "id": "1d2e9f74-a6cc-5511-a09b-0d29d38c5987-u02",
          "speaker_id": "a",
          "ja": "何を見せればいいですか。",
          "vi": "Tôi cần đưa giấy tờ gì ạ?"
        },
        {
          "id": "1d2e9f74-a6cc-5511-a09b-0d29d38c5987-u03",
          "speaker_id": "b",
          "ja": "本人確認書類を見せてください。",
          "vi": "Chị cho tôi xem giấy tờ tùy thân nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "resident_cert"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1d2e9f74-a6cc-5511-a09b-0d29d38c5987-u01": {
            "kind": "original_extension"
