          }
        }
      }
    },
    {
      "situation_uid": "d86e0ea2-1b19-51a9-b1d8-bde4cbde1ba3",
      "event_id": "E02",
      "context_vi": "Mẫu hướng dẫn của công ty không ghi tên giấy, chỉ nói cần giấy xác nhận địa chỉ hiện tại. Bạn nêu lại mục đích để nhân viên gợi ý.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d86e0ea2-1b19-51a9-b1d8-bde4cbde1ba3-u01",
          "speaker_id": "a",
          "ja": "書類の名前は分かりません。会社に、今の住所が分かる書類を出すように言われました。",
          "vi": "Tôi không biết tên giấy ạ. Công ty bảo tôi nộp giấy tờ có ghi địa chỉ hiện tại."
        },
        {
          "id": "d86e0ea2-1b19-51a9-b1d8-bde4cbde1ba3-u02",
          "speaker_id": "b",
          "ja": "住民票の写しのことでしょうか。会社に必要な内容も確認してください。",
          "vi": "Có thể là bản sao phiếu cư trú ạ. Chị hỏi lại công ty xem họ cần giấy ghi những mục nào nhé."
        },
        {
          "id": "d86e0ea2-1b19-51a9-b1d8-bde4cbde1ba3-u03",
          "speaker_id": "a",
          "ja": "分かりました。住民票の写しでいいか、会社に聞きます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ hỏi công ty xem bản sao phiếu cư trú có được không ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "resident_cert"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d86e0ea2-1b19-51a9-b1d8-bde4cbde1ba3-u01": {
