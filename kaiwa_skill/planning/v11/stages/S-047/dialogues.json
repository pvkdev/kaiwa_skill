    {
      "situation_uid": "6f5a0d48-d5e2-582a-8b18-9c60e429cabc",
      "event_id": "E03",
      "context_vi": "Nhân viên hẹn bạn mang bản gốc vào sáng mai, nhưng bạn chưa lấy được giấy trước ngày đó. Bạn xin quay lại thứ Hai tuần sau.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
