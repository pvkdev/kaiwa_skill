          }
        }
      }
    },
    {
      "situation_uid": "af98b46a-1f1e-55a3-ac32-74f9cf2dab6e",
      "event_id": "E02",
      "context_vi": "Nhân viên sau khi xem giấy mẫu nói quầy này không phụ trách. Bạn xin số quầy đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "af98b46a-1f1e-55a3-ac32-74f9cf2dab6e-u01",
          "speaker_id": "b",
          "ja": "こちらでは扱っていません。",
          "vi": "Quầy này không phụ trách việc ấy ạ."
        },
        {
          "id": "af98b46a-1f1e-55a3-ac32-74f9cf2dab6e-u02",
          "speaker_id": "a",
          "ja": "どの窓口に行けばいいですか。",
          "vi": "Vậy tôi nên đến quầy nào ạ?"
        },
        {
          "id": "af98b46a-1f1e-55a3-ac32-74f9cf2dab6e-u03",
          "speaker_id": "b",
          "ja": "三番窓口です。",
          "vi": "Quầy số 3 ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
