          }
        }
      }
    },
    {
      "situation_uid": "d86e0ea2-1b19-51a9-b1d8-bde4cbde1ba3",
      "event_id": "E02",
      "context_vi": "Bạn không biết chính xác tên giấy xác nhận địa chỉ công ty muốn. Bạn giải thích mục đích để nhân viên gợi ý tên.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d86e0ea2-1b19-51a9-b1d8-bde4cbde1ba3-u01",
          "speaker_id": "a",
          "ja": "書類の名前が分かりません。会社に住所を伝えるための証明です。",
          "vi": "Tôi không biết tên giấy tờ. Tôi cần giấy xác nhận địa chỉ để nộp cho công ty."
        },
        {
          "id": "d86e0ea2-1b19-51a9-b1d8-bde4cbde1ba3-u02",
          "speaker_id": "b",
          "ja": "住民票の写しのことでしょうか。会社に必要な内容も確認してください。",
          "vi": "Có phải bạn cần bản sao phiếu cư trú không ạ? Bạn hỏi công ty xem họ cần ghi những nội dung gì nhé."
        },
        {
          "id": "d86e0ea2-1b19-51a9-b1d8-bde4cbde1ba3-u03",
          "speaker_id": "a",
          "ja": "その名前を会社に確認します。",
          "vi": "Tôi sẽ hỏi công ty về tên giấy đó."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d86e0ea2-1b19-51a9-b1d8-bde4cbde1ba3-u01": {
