  "dialogues": [
    {
      "situation_uid": "14e3f1c1-e0a3-5121-9626-8274542531a0",
      "event_id": "E01",
      "context_vi": "Bạn lần đầu tới tòa thị chính Midori hư cấu. Bạn muốn hỏi chuyện địa chỉ cư trú nhưng chưa biết quầy nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "14e3f1c1-e0a3-5121-9626-8274542531a0-u01",
          "speaker_id": "a",
          "ja": "住所のことで相談したいです。どの窓口に行けばいいですか。",
          "vi": "Tôi muốn hỏi về địa chỉ cư trú. Tôi nên đến quầy nào ạ?"
        },
        {
          "id": "14e3f1c1-e0a3-5121-9626-8274542531a0-u02",
          "speaker_id": "b",
          "ja": "二階の住民窓口です。",
          "vi": "Quầy cư trú ở tầng hai ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "14e3f1c1-e0a3-5121-9626-8274542531a0-u01": {
            "kind": "original_extension"
          },
          "14e3f1c1-e0a3-5121-9626-8274542531a0-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "5d433196-c08d-5a38-beae-7699ad4cd89f",
      "event_id": "E01",
      "context_vi": "Nhân viên sảnh vừa chỉ quầy cư trú ở tầng hai. Bạn hỏi lối lên tầng hai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5d433196-c08d-5a38-beae-7699ad4cd89f-u01",
          "speaker_id": "a",
          "ja": "二階へはどうやって行けばいいですか。",
          "vi": "Tôi lên tầng hai bằng lối nào ạ?"
        },
        {
          "id": "5d433196-c08d-5a38-beae-7699ad4cd89f-u02",
          "speaker_id": "b",
          "ja": "右の階段を上がってください。",
          "vi": "Mời chị lên cầu thang bên phải ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5d433196-c08d-5a38-beae-7699ad4cd89f-u01": {
            "kind": "original_extension"
          },
          "5d433196-c08d-5a38-beae-7699ad4cd89f-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "c20dfd84-4178-5f0b-884d-264d1a79e912",
      "event_id": "E01",
      "context_vi": "Ở sảnh tòa thị chính, nhân viên cho biết quầy cư trú trên tầng hai đã hết giờ tiếp nhận. Bạn hỏi khi nào quay lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c20dfd84-4178-5f0b-884d-264d1a79e912-u01",
          "speaker_id": "b",
          "ja": "今日はもう受付が終わりました。",
          "vi": "Hôm nay quầy đã ngừng tiếp nhận rồi ạ."
        },
        {
          "id": "c20dfd84-4178-5f0b-884d-264d1a79e912-u02",
          "speaker_id": "a",
          "ja": "明日は何時に来ればいいですか。",
          "vi": "Ngày mai tôi nên quay lại lúc mấy giờ ạ?"
        },
        {
          "id": "c20dfd84-4178-5f0b-884d-264d1a79e912-u03",
          "speaker_id": "b",
          "ja": "明日は九時からです。",
          "vi": "Ngày mai từ 9 giờ ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c20dfd84-4178-5f0b-884d-264d1a79e912-u01": {
            "kind": "original_extension"
          },
