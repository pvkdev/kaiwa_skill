          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách diễn tập",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a6788eab-fee9-5502-94b7-9c80a223594b-u01",
          "speaker_id": "a",
          "ja": "金曜日の避難訓練はどこから始まりますか。何時に行けばいいですか。",
          "vi": "Buổi diễn tập sơ tán thứ Sáu bắt đầu ở đâu? Tôi cần có mặt lúc mấy giờ ạ?"
        },
        {
          "id": "a6788eab-fee9-5502-94b7-9c80a223594b-u02",
          "speaker_id": "b",
          "ja": "九時に一階の入口へ来てください。そこから始めます。",
          "vi": "Bạn có mặt ở lối vào tầng một lúc 9 giờ. Ta bắt đầu từ đó."
        }
      ],
