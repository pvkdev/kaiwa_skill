        {
          "id": "b",
          "role_vi": "người phụ trách diễn tập",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5322eeaf-07a2-590e-bf72-34c08c39092d-u01",
          "speaker_id": "a",
          "ja": "集合場所は東の広場でしたか。",
          "vi": "Điểm tập trung là sân phía đông phải không ạ?"
        },
        {
          "id": "5322eeaf-07a2-590e-bf72-34c08c39092d-u02",
          "speaker_id": "b",
          "ja": "訓練はここから始めますが、外に出たら北の広場に集まってください。",
          "vi": "Diễn tập bắt đầu ở đây. Khi ra ngoài, chị tập trung ở sân phía bắc nhé."
        },
        {
          "id": "5322eeaf-07a2-590e-bf72-34c08c39092d-u03",
          "speaker_id": "a",
          "ja": "北の広場ですね。",
          "vi": "Sân phía bắc ạ."
        }
      ],
