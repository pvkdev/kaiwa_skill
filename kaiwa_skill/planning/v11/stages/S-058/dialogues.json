    {
      "situation_uid": "cb5a6d79-2369-51d1-a5fb-36bd509913e0",
      "event_id": "E04",
      "context_vi": "Bạn mới vào công ty, lần đầu tham gia diễn tập. Bạn xin người phụ trách nói lại phần việc mình phải làm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách diễn tập",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cb5a6d79-2369-51d1-a5fb-36bd509913e0-u01",
          "speaker_id": "a",
          "ja": "入社したばかりで、避難訓練は初めてです。何をすればいいか、もう一度教えてください。",
          "vi": "Tôi mới vào công ty và đây là lần đầu tham gia diễn tập. Anh nhắc lại tôi cần làm gì được không ạ?"
        },
        {
          "id": "cb5a6d79-2369-51d1-a5fb-36bd509913e0-u02",
          "speaker_id": "b",
          "ja": "合図が聞こえたら、作業を止めてください。係の人について、集合場所へ行きます。",
          "vi": "Khi nghe hiệu lệnh, chị dừng việc. Sau đó đi theo người hướng dẫn tới điểm tập trung nhé."
        }
      ],
