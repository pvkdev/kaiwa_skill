          }
        }
      }
    },
    {
      "situation_uid": "b6855ba9-75aa-5b42-9349-042a54613409",
      "event_id": "E02",
      "context_vi": "Bạn đã đi theo cầu thang phía tây tới sân phía bắc. Bạn báo có mặt tại điểm tập trung.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách điểm tập trung",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b6855ba9-75aa-5b42-9349-042a54613409-u01",
          "speaker_id": "a",
          "ja": "西側の階段から出ました。今、北の広場にいます。リンです。",
          "vi": "Tôi đã ra bằng cầu thang phía tây. Giờ tôi ở sân phía bắc. Tôi là Linh."
        },
        {
          "id": "b6855ba9-75aa-5b42-9349-042a54613409-u02",
          "speaker_id": "b",
          "ja": "リンさんですね。ここで人数に入れました。",
          "vi": "Chị Linh. Tôi đã ghi bạn có mặt ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
