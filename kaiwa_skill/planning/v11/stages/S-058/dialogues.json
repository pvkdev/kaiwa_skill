            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "730d514f-b5a4-5cbb-a7a3-0aa276f8a296",
      "event_id": "E02",
      "context_vi": "Lối ra thường dùng ở kho đã bị chặn do khói. Bạn hỏi người hướng dẫn một lối khác đang an toàn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn sơ tán",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "730d514f-b5a4-5cbb-a7a3-0aa276f8a296-u01",
          "speaker_id": "a",
          "ja": "いつもの出口は煙で通れません。どこから出ますか。",
          "vi": "Lối ra thường dùng có khói nên không đi qua được. Tôi ra bằng lối nào ạ?"
        },
        {
          "id": "730d514f-b5a4-5cbb-a7a3-0aa276f8a296-u02",
          "speaker_id": "b",
          "ja": "今は西側の階段を使ってください。煙がなければ、そこから外へ出られます。",
          "vi": "Hiện bạn dùng cầu thang phía tây. Nếu lối đó không có khói, bạn có thể ra ngoài."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
