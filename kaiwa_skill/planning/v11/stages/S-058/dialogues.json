        {
          "id": "b",
          "role_vi": "người phụ trách diễn tập",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9520aa2d-7db6-559c-9f70-619d29dccdba-u01",
          "speaker_id": "a",
          "ja": "一緒に参加する人は、歩くときに手伝いが必要です。誰に相談すればいいですか。",
          "vi": "Người tập cùng tôi cần được hỗ trợ khi đi lại. Tôi nên trao đổi với ai ạ?"
        },
        {
          "id": "9520aa2d-7db6-559c-9f70-619d29dccdba-u02",
          "speaker_id": "b",
          "ja": "今日は誘導係の田中さんが一緒に行きます。入口で紹介します。",
          "vi": "Hôm nay anh Tanaka phụ trách hướng dẫn sẽ đi cùng. Tôi sẽ giới thiệu ở cửa vào."
        }
      ],
