        }
      }
    },
    {
      "situation_uid": "ca0cb73c-12fa-5684-a48a-5d65be23584d",
      "event_id": "E01",
      "context_vi": "Chuông báo cháy vừa reo trong nơi làm việc. Bạn đang xếp hàng và hỏi có cần dừng việc để rời khu vực không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách an toàn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ca0cb73c-12fa-5684-a48a-5d65be23584d-u01",
          "speaker_id": "a",
          "ja": "今の作業を止めて、避難しますか。",
          "vi": "Tôi có dừng việc đang làm để sơ tán ngay không ạ?"
        },
        {
          "id": "ca0cb73c-12fa-5684-a48a-5d65be23584d-u02",
          "speaker_id": "b",
          "ja": "はい。作業を止めて、放送と誘導に従って出てください。",
          "vi": "Có. Bạn dừng việc, rồi ra ngoài theo thông báo và hướng dẫn tại chỗ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
        ],
        "specialty_item_ids": [],
