    {
      "situation_uid": "7cf3b069-7759-58ff-92ce-88f589835582",
      "event_id": "E03",
      "context_vi": "Trong lúc chờ tin tại sân, bạn thấy Yamada vừa tới. Bạn báo ngay để cập nhật danh sách.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách điểm tập trung",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7cf3b069-7759-58ff-92ce-88f589835582-u01",
          "speaker_id": "a",
          "ja": "山田さんが今、広場に来ました。あちらにいます。",
          "vi": "Anh Yamada vừa đến sân. Anh ấy ở phía kia."
        },
        {
          "id": "7cf3b069-7759-58ff-92ce-88f589835582-u02",
          "speaker_id": "b",
          "ja": "分かりました。本人を確認して、名簿を直します。",
          "vi": "Tôi hiểu. Tôi sẽ xác nhận anh ấy rồi cập nhật danh sách."
        }
      ],
      "admin": {
