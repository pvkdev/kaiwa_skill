  "dialogues": [
    {
      "situation_uid": "40d4bb60-29ff-5cf4-9daf-fe91bc431783",
      "event_id": "E01",
      "context_vi": "Bạn thấy khói gần cửa xanh ở phía bắc kho. Bạn lùi khỏi khu có khói và báo người phụ trách an toàn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách an toàn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "40d4bb60-29ff-5cf4-9daf-fe91bc431783-u01",
          "speaker_id": "a",
          "ja": "煙が出ています。倉庫の北側、青いドアの近くです。",
          "vi": "Có khói ạ. Ở phía bắc kho, gần cửa màu xanh."
        },
        {
          "id": "40d4bb60-29ff-5cf4-9daf-fe91bc431783-u02",
          "speaker_id": "b",
          "ja": "分かりました。119に連絡し、館内にも知らせます。安全な場所へ移動してください。",
          "vi": "Tôi hiểu. Tôi sẽ báo 119 và thông báo trong tòa. Bạn di chuyển tới nơi an toàn."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "40d4bb60-29ff-5cf4-9daf-fe91bc431783-u01": {
            "kind": "original_extension"
          },
          "40d4bb60-29ff-5cf4-9daf-fe91bc431783-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3bcde796-cc85-5b76-838f-e2a403cc2d99",
      "event_id": "E01",
      "context_vi": "Bạn đã ra khỏi khu kho nhưng chưa thấy đồng nghiệp Yamada rời phòng đóng gói. Bạn báo vị trí cuối biết, không quay lại tìm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách an toàn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3bcde796-cc85-5b76-838f-e2a403cc2d99-u01",
          "speaker_id": "a",
          "ja": "山田さんがまだ見当たりません。最後に見たのは、倉庫の隣の包装室です。",
          "vi": "Tôi chưa thấy anh Yamada. Lần cuối tôi thấy anh ấy trong phòng đóng gói cạnh kho ạ."
        },
        {
          "id": "3bcde796-cc85-5b76-838f-e2a403cc2d99-u02",
          "speaker_id": "b",
          "ja": "分かりました。消防の人にその場所を伝えます。戻らないでください。",
          "vi": "Tôi hiểu. Tôi sẽ báo vị trí đó cho đội cứu hỏa. Bạn đừng quay lại."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3bcde796-cc85-5b76-838f-e2a403cc2d99-u01": {
            "kind": "original_extension"
          },
          "3bcde796-cc85-5b76-838f-e2a403cc2d99-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "8600bc9f-fd9e-5746-a086-dd196f03cbef",
      "event_id": "E01",
      "context_vi": "Bạn đã báo khói ở phía bắc kho, nhưng người phụ trách nhắc lại thành phía nam. Bạn sửa bằng mốc cửa xanh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách an toàn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8600bc9f-fd9e-5746-a086-dd196f03cbef-u01",
          "speaker_id": "b",
          "ja": "倉庫の南側ですね。",
          "vi": "Ở phía nam kho, đúng không ạ?"
        },
        {
          "id": "8600bc9f-fd9e-5746-a086-dd196f03cbef-u02",
          "speaker_id": "a",
          "ja": "いいえ、北側です。青いドアの近くです。",
          "vi": "Không, phía bắc, gần cửa màu xanh."
        },
        {
          "id": "8600bc9f-fd9e-5746-a086-dd196f03cbef-u03",
          "speaker_id": "b",
          "ja": "北側の青いドアですね。直して伝えます。",
          "vi": "Phía bắc, gần cửa xanh. Tôi sẽ sửa thông tin."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
        ],
