          "3bcde796-cc85-5b76-838f-e2a403cc2d99-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "8600bc9f-fd9e-5746-a086-dd196f03cbef",
      "event_id": "E01",
      "context_vi": "Bạn đã báo khói ở phía bắc kho, nhưng người phụ trách nhắc lại thành phía nam. Bạn sửa bằng mốc cửa xanh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách an toàn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8600bc9f-fd9e-5746-a086-dd196f03cbef-u01",
          "speaker_id": "b",
          "ja": "倉庫の南側ですね。",
          "vi": "Ở phía nam kho, đúng không ạ?"
        },
        {
          "id": "8600bc9f-fd9e-5746-a086-dd196f03cbef-u02",
          "speaker_id": "a",
          "ja": "いいえ、北側です。青いドアの近くです。",
          "vi": "Không, phía bắc, gần cửa màu xanh."
        },
        {
          "id": "8600bc9f-fd9e-5746-a086-dd196f03cbef-u03",
          "speaker_id": "b",
          "ja": "北側の青いドアですね。直して伝えます。",
          "vi": "Phía bắc, gần cửa xanh. Tôi sẽ sửa thông tin."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
