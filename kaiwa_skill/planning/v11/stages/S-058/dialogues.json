    {
      "situation_uid": "fad949c5-6cb9-5f43-ac67-dd0beab0b41e",
      "event_id": "E04",
      "context_vi": "Sau buổi diễn tập, bạn nói mình không hiểu ký hiệu lối ra thứ hai và hỏi lần sau nên xem ở đâu trước.",
