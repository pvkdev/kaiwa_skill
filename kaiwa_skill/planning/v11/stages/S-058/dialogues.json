    {
      "situation_uid": "147f6f39-7201-520c-8066-4864a38925ec",
      "event_id": "E03",
      "context_vi": "Người phụ trách đang kiểm tra Yamada. Bạn hỏi mình nên chờ ở đâu, không tự quay vào trong.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách điểm tập trung",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "147f6f39-7201-520c-8066-4864a38925ec-u01",
          "speaker_id": "a",
          "ja": "山田さんが来たか、確認しているところですね。私はどこにいればいいですか。",
          "vi": "Anh đang kiểm xem anh Yamada đã đến chưa, đúng không ạ? Tôi nên chờ ở đâu?"
        },
        {
          "id": "147f6f39-7201-520c-8066-4864a38925ec-u02",
          "speaker_id": "b",
          "ja": "この広場で待ってください。分かり次第、こちらで知らせます。",
          "vi": "Bạn chờ ở sân này. Khi có tin, chúng tôi sẽ báo ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
        ],
        "specialty_item_ids": [],
