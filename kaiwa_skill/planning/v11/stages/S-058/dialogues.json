          "730d514f-b5a4-5cbb-a7a3-0aa276f8a296-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "664f6b60-85ac-5ba6-8d2a-85eb5a7c4b56",
      "event_id": "E02",
      "context_vi": "Bạn vừa được chỉ cầu thang phía tây. Bạn nhắc lại lối đi và hỏi điểm tập trung để không đi nhầm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn sơ tán",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "664f6b60-85ac-5ba6-8d2a-85eb5a7c4b56-u01",
          "speaker_id": "a",
          "ja": "西側の階段ですね。外に出たら、どこに集まりますか。",
          "vi": "Cầu thang phía tây. Sau khi ra ngoài tôi tập trung ở đâu ạ?"
        },
        {
          "id": "664f6b60-85ac-5ba6-8d2a-85eb5a7c4b56-u02",
          "speaker_id": "b",
          "ja": "北の広場です。階段の先の案内に従ってください。",
          "vi": "Ở sân phía bắc. Bạn theo chỉ dẫn ở cuối cầu thang nhé."
        },
        {
          "id": "664f6b60-85ac-5ba6-8d2a-85eb5a7c4b56-u03",
          "speaker_id": "a",
          "ja": "西側の階段で外に出て、北の広場に集まるんですね。",
          "vi": "Ra ngoài bằng cầu thang phía tây rồi tập trung ở sân phía bắc, đúng không ạ?"
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
