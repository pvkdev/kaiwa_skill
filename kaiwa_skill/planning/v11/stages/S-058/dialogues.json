    {
      "situation_uid": "a6788eab-fee9-5502-94b7-9c80a223594b",
      "event_id": "E04",
      "context_vi": "Công ty tổ chức diễn tập sơ tán vào thứ Sáu. Bạn hỏi nơi bắt đầu và giờ cần có mặt.",
