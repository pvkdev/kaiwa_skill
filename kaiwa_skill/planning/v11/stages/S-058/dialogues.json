    {
      "situation_uid": "9520aa2d-7db6-559c-9f70-619d29dccdba",
      "event_id": "E04",
      "context_vi": "Một người cùng nhóm cần hỗ trợ khi diễn tập. Bạn hỏi người phụ trách nên phối hợp với ai trước khi bắt đầu.",
