        }
      }
    },
    {
      "situation_uid": "8c5a3ebb-3127-54df-ab23-37991eedc0f3",
      "event_id": "E02",
      "context_vi": "Trên đường tới điểm tập trung, bạn không còn thấy đồng nghiệp đi cùng. Bạn báo cho người phụ trách vị trí cuối thấy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách an toàn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8c5a3ebb-3127-54df-ab23-37991eedc0f3-u01",
          "speaker_id": "a",
          "ja": "一緒にいたリーさんが見えません。西側の階段の前で最後に見ました。",
          "vi": "Tôi không thấy chị Ly đi cùng. Lần cuối tôi thấy chị ấy trước cầu thang phía tây."
        },
        {
          "id": "8c5a3ebb-3127-54df-ab23-37991eedc0f3-u02",
          "speaker_id": "b",
          "ja": "分かりました。確認します。あなたは安全な場所へ進んでください。",
          "vi": "Tôi hiểu. Tôi sẽ kiểm tra. Bạn tiếp tục đến nơi an toàn."
        }
      ],
      "admin": {
