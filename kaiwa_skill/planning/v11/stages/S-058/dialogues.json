          }
        }
      }
    },
    {
      "situation_uid": "f947646f-c9fb-50a2-a0be-ee0e223aef73",
      "event_id": "E03",
      "context_vi": "Tại điểm tập trung, bạn nhận thấy đồng nghiệp Yamada chưa được ghi có mặt. Bạn báo riêng, không đoán họ đang ở đâu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách điểm tập trung",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f947646f-c9fb-50a2-a0be-ee0e223aef73-u01",
          "speaker_id": "a",
          "ja": "山田さんがまだここにいません。今どこにいるかは分かりません。",
          "vi": "Anh Yamada chưa có mặt ở đây. Tôi không biết hiện anh ấy ở đâu."
        },
        {
          "id": "f947646f-c9fb-50a2-a0be-ee0e223aef73-u02",
          "speaker_id": "b",
          "ja": "分かりました。未確認として記録して確認します。",
          "vi": "Tôi hiểu. Tôi sẽ ghi là chưa xác nhận được và kiểm tra."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
