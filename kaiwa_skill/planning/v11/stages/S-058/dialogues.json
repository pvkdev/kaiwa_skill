    {
      "situation_uid": "5322eeaf-07a2-590e-bf72-34c08c39092d",
      "event_id": "E04",
      "context_vi": "Bạn tới lối vào tầng một lúc 9 giờ để bắt đầu diễn tập. Trước khi đi, bạn kiểm lại sân mà mọi người sẽ tập trung sau khi ra ngoài.",
