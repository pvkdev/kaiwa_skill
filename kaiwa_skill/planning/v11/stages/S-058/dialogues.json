        }
      }
    },
    {
      "situation_uid": "ca0cb73c-12fa-5684-a48a-5d65be23584d",
      "event_id": "E01",
      "context_vi": "Chuông báo cháy reo khi bạn đang đóng gói hàng. Bạn xác nhận với người phụ trách có dừng việc và sơ tán ngay không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách an toàn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ca0cb73c-12fa-5684-a48a-5d65be23584d-u01",
          "speaker_id": "a",
          "ja": "作業はここで止めて、すぐ避難すればいいですか。",
          "vi": "Tôi dừng ngay việc đang làm rồi sơ tán luôn, đúng không ạ?"
        },
        {
          "id": "ca0cb73c-12fa-5684-a48a-5d65be23584d-u02",
          "speaker_id": "b",
          "ja": "はい、すぐに止めて避難してください。誘導係についていってください。",
          "vi": "Đúng ạ. Chị dừng việc và sơ tán ngay, đi theo người hướng dẫn."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fdma_return"
        ],
