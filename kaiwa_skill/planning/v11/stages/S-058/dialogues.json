    {
      "situation_uid": "d0854893-389c-50d4-803e-a54fea49c68d",
      "event_id": "E03",
      "context_vi": "Bạn đã ra ngoài an toàn, còn túi cá nhân trong tòa nhà. Bạn hỏi khi nào có thể lấy sau thông báo an toàn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách an toàn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d0854893-389c-50d4-803e-a54fea49c68d-u01",
          "speaker_id": "a",
          "ja": "荷物が中にあります。いつ取りに戻ってもいいですか。",
          "vi": "Túi tôi vẫn ở trong. Khi nào tôi mới được vào lấy ạ?"
        },
        {
          "id": "d0854893-389c-50d4-803e-a54fea49c68d-u02",
          "speaker_id": "b",
          "ja": "まだ戻らないでください。入れる時は責任者から案内します。",
          "vi": "Hiện đừng quay lại. Khi được vào, người phụ trách sẽ hướng dẫn."
        }
      ],
