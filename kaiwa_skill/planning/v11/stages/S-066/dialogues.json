    {
      "situation_uid": "4a848e18-edfb-52bd-9de3-bf6b4747befa",
      "event_id": "E03",
      "context_vi": "Bạn của bạn chưa chơi bowling bao giờ. Bạn kể lần đầu mình chơi quả bóng đi chệch ra sao và lúc nào mới thấy vui.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe kể",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4a848e18-edfb-52bd-9de3-bf6b4747befa-u01",
          "speaker_id": "A",
          "ja": "初めてボウリングをしたとき、ボールがすぐ横の溝に落ちたよ。",
          "vi": "Lần đầu chơi bowling, bóng của tớ lăn ngay xuống rãnh bên cạnh."
        },
        {
          "id": "4a848e18-edfb-52bd-9de3-bf6b4747befa-u02",
          "speaker_id": "B",
          "ja": "難しかったんだね。",
          "vi": "Khó thật nhỉ."
        },
        {
          "id": "4a848e18-edfb-52bd-9de3-bf6b4747befa-u03",
          "speaker_id": "A",
          "ja": "うん。でも、次はピンが三本倒れた。うれしかったよ。",
          "vi": "Ừ. Nhưng lần ném sau tớ làm đổ được ba ky. Vui lắm."
        },
        {
          "id": "4a848e18-edfb-52bd-9de3-bf6b4747befa-u04",
          "speaker_id": "B",
          "ja": "三本も倒れたら、うれしいね。",
          "vi": "Làm đổ được cả ba ky thì vui nhỉ."
        }
      ],
