    {
      "situation_uid": "a03ab169-2633-5925-95eb-32cffb21fbb1",
      "event_id": "E02",
      "context_vi": "Bạn mình đã nhận lời thử bóng bàn cùng bạn. Bạn nhắc lại mình sẽ chỉ cách cầm vợt, rồi hai người bàn tập thế nào và chọn ngày.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn chưa chơi bóng bàn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a03ab169-2633-5925-95eb-32cffb21fbb1-u01",
          "speaker_id": "A",
          "ja": "今度は一緒に卓球だね。最初に持ち方を教えるよ。",
          "vi": "Lần tới mình chơi bóng bàn cùng nhau nhé. Đầu tiên tớ chỉ cậu cách cầm vợt."
        },
        {
          "id": "a03ab169-2633-5925-95eb-32cffb21fbb1-u02",
          "speaker_id": "B",
          "ja": "うん。最初は軽く打つだけでもいい？",
          "vi": "Ừ. Lúc đầu tớ chỉ đánh nhẹ thôi được không?"
        },
        {
          "id": "a03ab169-2633-5925-95eb-32cffb21fbb1-u03",
          "speaker_id": "A",
          "ja": "もちろん。土曜日にしようか。",
          "vi": "Được chứ. Mình chọn thứ Bảy nhé?"
        },
        {
          "id": "a03ab169-2633-5925-95eb-32cffb21fbb1-u04",
          "speaker_id": "B",
          "ja": "うん、土曜日なら行ける。",
          "vi": "Ừ, thứ Bảy thì tớ đi được."
        }
      ],
      "admin": {
