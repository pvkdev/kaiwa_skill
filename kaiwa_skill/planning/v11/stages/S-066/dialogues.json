    {
      "situation_uid": "ebc84f8b-d005-5952-b174-a353b2096ec8",
      "event_id": "E02",
      "context_vi": "Bạn vừa nói mình thích phim kinh dị. Bạn của bạn sợ thể loại ấy nên bạn hỏi người đó thích xem phim gì khác.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hỏi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn chọn thể loại",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ebc84f8b-d005-5952-b174-a353b2096ec8-u01",
          "speaker_id": "B",
          "ja": "怖い映画はちょっと苦手。",
          "vi": "Tớ không hợp mấy phim đáng sợ lắm."
        },
        {
          "id": "ebc84f8b-d005-5952-b174-a353b2096ec8-u02",
          "speaker_id": "A",
          "ja": "そっか。じゃ、どんな映画が好き？",
          "vi": "Vậy à. Thế cậu thích phim thể loại nào?"
        },
        {
          "id": "ebc84f8b-d005-5952-b174-a353b2096ec8-u03",
          "speaker_id": "B",
          "ja": "よくコメディーを見るよ。",
          "vi": "Tớ hay xem phim hài."
        },
        {
          "id": "ebc84f8b-d005-5952-b174-a353b2096ec8-u04",
          "speaker_id": "A",
          "ja": "コメディーなら、私もよく見るよ。",
          "vi": "Phim hài thì tớ cũng hay xem."
        }
      ],
      "admin": {
        "source_refs": [
          "movie"
        ],
