          }
        }
      }
    },
    {
      "situation_uid": "03d6a524-faad-5402-9a89-2110f129fa68",
      "event_id": "E01",
      "context_vi": "Bạn mới quen nói cuối tuần hay xem phim. Bạn muốn chia sẻ thể loại mình thích và tìm điểm chung.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "03d6a524-faad-5402-9a89-2110f129fa68-u01",
          "speaker_id": "A",
          "ja": "私はアニメ映画が好きです。",
          "vi": "Tôi thích phim hoạt hình."
        },
        {
          "id": "03d6a524-faad-5402-9a89-2110f129fa68-u02",
          "speaker_id": "B",
          "ja": "そうなんですか。どんなアニメですか。",
          "vi": "Vậy ạ? Chị thích kiểu hoạt hình nào?"
        },
        {
          "id": "03d6a524-faad-5402-9a89-2110f129fa68-u03",
          "speaker_id": "A",
          "ja": "動物が出てくる映画をよく見ます。",
          "vi": "Tôi hay xem phim có các nhân vật là động vật."
        },
        {
          "id": "03d6a524-faad-5402-9a89-2110f129fa68-u04",
          "speaker_id": "B",
          "ja": "私もそういう映画が好きです。",
          "vi": "Tôi cũng thích phim kiểu đó."
        }
      ],
      "admin": {
        "source_refs": [
          "movie"
        ],
        "specialty_item_ids": [],
