    {
      "situation_uid": "3247cfe4-9243-5938-8b55-c0c0ea2947e0",
      "event_id": "E02",
      "context_vi": "Bạn kể về bóng bàn. Người bạn tò mò nhưng chưa chơi lần nào, nên bạn rủ cùng thử cho vui.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn chưa chơi bóng bàn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3247cfe4-9243-5938-8b55-c0c0ea2947e0-u01",
          "speaker_id": "B",
          "ja": "卓球、楽しそう。でも、やったことがないんだ。",
          "vi": "Bóng bàn nghe vui đấy. Nhưng tớ chưa chơi bao giờ."
        },
        {
          "id": "3247cfe4-9243-5938-8b55-c0c0ea2947e0-u02",
          "speaker_id": "A",
          "ja": "一緒に少しやってみるのはどう？",
          "vi": "Mình thử đánh một chút cùng nhau nhé?"
        },
        {
          "id": "3247cfe4-9243-5938-8b55-c0c0ea2947e0-u03",
          "speaker_id": "B",
          "ja": "初めてでも大丈夫？",
          "vi": "Mới chơi lần đầu có được không?"
        },
        {
          "id": "3247cfe4-9243-5938-8b55-c0c0ea2947e0-u04",
          "speaker_id": "A",
          "ja": "うん。ラケットの持ち方から教えるよ。",
          "vi": "Được. Tớ sẽ chỉ từ cách cầm vợt."
        },
        {
          "id": "3247cfe4-9243-5938-8b55-c0c0ea2947e0-u05",
          "speaker_id": "B",
          "ja": "じゃ、やってみたい。",
          "vi": "Vậy tớ muốn thử."
        }
      ],
      "admin": {
