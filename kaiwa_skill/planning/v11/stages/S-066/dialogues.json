    {
      "situation_uid": "df2109c4-899c-56fb-9e84-6c05e78ec0d3",
      "event_id": "E02",
      "context_vi": "Hai bạn đều biết một bộ phim mới về mèo đi lạc. Bạn hỏi bạn mình đã xem chưa và tìm hiểu cảm nhận mà không hỏi trước kết phim.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hỏi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đã xem phim",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "df2109c4-899c-56fb-9e84-6c05e78ec0d3-u01",
          "speaker_id": "A",
          "ja": "あの猫の映画、もう見たの？",
          "vi": "Cậu xem bộ phim về chú mèo đó chưa?"
        },
        {
          "id": "df2109c4-899c-56fb-9e84-6c05e78ec0d3-u02",
          "speaker_id": "B",
          "ja": "うん、きのう見たよ。",
          "vi": "Rồi, tớ xem hôm qua."
        },
        {
          "id": "df2109c4-899c-56fb-9e84-6c05e78ec0d3-u03",
          "speaker_id": "A",
          "ja": "どうだった？ 最後は言わないでね。",
          "vi": "Phim thế nào? Đừng kể đoạn kết nhé."
        },
        {
          "id": "df2109c4-899c-56fb-9e84-6c05e78ec0d3-u04",
          "speaker_id": "B",
          "ja": "うん。静かな映画で、音楽がよかったよ。",
          "vi": "Ừ. Phim nhẹ nhàng, nhạc hay lắm."
        }
      ],
      "admin": {
        "source_refs": [
          "movie"
        ],
        "specialty_item_ids": [
          "sj-so-15-b11-5"
        ],
        "turn_origins": {
          "df2109c4-899c-56fb-9e84-6c05e78ec0d3-u01": {
