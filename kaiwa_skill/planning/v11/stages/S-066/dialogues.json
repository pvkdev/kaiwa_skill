    {
      "situation_uid": "71123913-5a01-550d-b6bb-af65b7844f80",
      "event_id": "E03",
      "context_vi": "Bạn xem bản điện ảnh Bến tàu mùa hè, còn bạn mình đã đọc truyện tranh cùng tên. Hai bạn xác nhận sẽ nói về bản điện ảnh và làm rõ chi tiết ở đoạn mở đầu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đọc truyện",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "71123913-5a01-550d-b6bb-af65b7844f80-u01",
          "speaker_id": "A",
          "ja": "じゃ、今は映画の『夏の港』の話をしよう。",
          "vi": "Vậy giờ mình nói về bản điện ảnh Bến tàu mùa hè nhé."
        },
        {
          "id": "71123913-5a01-550d-b6bb-af65b7844f80-u02",
          "speaker_id": "B",
          "ja": "うん。映画はどこから始まるの？",
          "vi": "Ừ. Bản phim mở đầu ở đâu vậy?"
        },
        {
          "id": "71123913-5a01-550d-b6bb-af65b7844f80-u03",
          "speaker_id": "A",
          "ja": "港からだよ。女の子が船を待っているの。",
          "vi": "Ở bến tàu. Có một cô bé đang chờ tàu."
        },
        {
          "id": "71123913-5a01-550d-b6bb-af65b7844f80-u04",
          "speaker_id": "B",
          "ja": "へえ。漫画とは始まり方が違うんだね。",
          "vi": "Ồ. Cách mở đầu khác bản truyện tranh nhỉ."
        }
      ],
      "admin": {
