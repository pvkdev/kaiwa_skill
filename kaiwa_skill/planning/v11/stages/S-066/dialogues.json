    {
      "situation_uid": "00048c8b-aa18-5b12-be29-8cbaabad83af",
      "event_id": "E04",
      "context_vi": "Bạn và bạn mình đã hẹn thử cầu lông hai mươi phút trước khi xem các thành viên tập. Khi vừa tới nhà thi đấu, bạn nhắc lại kế hoạch trước khi vào.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "00048c8b-aa18-5b12-be29-8cbaabad83af-u01",
          "speaker_id": "A",
          "ja": "最初に二十分だけ打つって話だったよね。",
          "vi": "Mình đã hẹn đánh thử hai mươi phút trước khi xem mọi người tập, đúng không?"
        },
        {
          "id": "00048c8b-aa18-5b12-be29-8cbaabad83af-u02",
          "speaker_id": "B",
          "ja": "うん。そのあとで練習を見るんだよね。",
          "vi": "Ừ. Rồi mình xem mọi người tập nhỉ?"
        },
        {
          "id": "00048c8b-aa18-5b12-be29-8cbaabad83af-u03",
          "speaker_id": "A",
          "ja": "そう。じゃ、あそこの空いてるコートに行こう。",
          "vi": "Đúng rồi. Vậy mình ra sân trống đằng kia nhé."
        },
        {
          "id": "00048c8b-aa18-5b12-be29-8cbaabad83af-u04",
          "speaker_id": "B",
          "ja": "うん、行こう。",
          "vi": "Ừ, đi thôi."
        }
      ],
