    {
      "situation_uid": "d5667fb9-3676-5b7f-9af1-f8586ebeeb65",
      "event_id": "E04",
      "context_vi": "Bạn muốn mượn cuốn sách nấu ăn mà bạn mình vẫn đang đọc. Hai người bàn lúc nào có thể nhắc lại chuyện mượn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người muốn mượn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đang đọc sách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d5667fb9-3676-5b7f-9af1-f8586ebeeb65-u01",
          "speaker_id": "A",
          "ja": "その料理の本、今度貸してくれない？",
          "vi": "Hôm nào cho tớ mượn cuốn sách nấu ăn đó được không?"
        },
        {
          "id": "d5667fb9-3676-5b7f-9af1-f8586ebeeb65-u02",
          "speaker_id": "B",
          "ja": "いいよ。読み終わってからね。",
          "vi": "Được. Để tớ đọc xong đã nhé."
        },
        {
          "id": "d5667fb9-3676-5b7f-9af1-f8586ebeeb65-u03",
          "speaker_id": "A",
          "ja": "わかった。日曜にまた聞いていい？",
          "vi": "Ừ. Chủ nhật tớ hỏi lại được không?"
        },
        {
          "id": "d5667fb9-3676-5b7f-9af1-f8586ebeeb65-u04",
          "speaker_id": "B",
          "ja": "うん。まだ読んでたら、そのとき言うね。",
          "vi": "Ừ. Nếu lúc đó tớ chưa đọc xong, tớ sẽ nói."
        }
      ],
