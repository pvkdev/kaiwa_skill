    {
      "situation_uid": "d7d7f3eb-7b60-5754-93b0-38e9ce48dd5c",
      "event_id": "E03",
      "context_vi": "Hai bạn nhắc đến tác phẩm có tựa Bến tàu mùa hè. Bạn nhớ mở đầu ở bến tàu, còn người kia nói mở đầu ở trường, nên bạn hỏi lại tựa và phiên bản.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đọc truyện",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d7d7f3eb-7b60-5754-93b0-38e9ce48dd5c-u01",
          "speaker_id": "B",
          "ja": "最初の学校の場面、よかったね。",
          "vi": "Đoạn mở đầu ở trường hay nhỉ."
        },
        {
          "id": "d7d7f3eb-7b60-5754-93b0-38e9ce48dd5c-u02",
          "speaker_id": "A",
          "ja": "『夏の港』のことだよね。映画のほう？",
          "vi": "Cậu đang nói Bến tàu mùa hè đúng không? Bản điện ảnh à?"
        },
        {
          "id": "d7d7f3eb-7b60-5754-93b0-38e9ce48dd5c-u03",
          "speaker_id": "B",
          "ja": "『夏の港』の漫画を読んだんだ。",
          "vi": "Tớ đọc truyện tranh Bến tàu mùa hè."
        },
        {
          "id": "d7d7f3eb-7b60-5754-93b0-38e9ce48dd5c-u04",
          "speaker_id": "A",
          "ja": "あ、私は映画を見たよ。",
          "vi": "À, tớ xem bản điện ảnh."
        }
      ],
      "admin": {
        "source_refs": [
          "movie",
          "book"
        ],
        "specialty_item_ids": [
          "sj-so-15-b11-5"
        ],
