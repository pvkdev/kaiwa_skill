  "dialogues": [
    {
      "situation_uid": "01c2add6-2bcd-5b5c-8431-ed73107c7ec8",
      "event_id": "E01",
      "context_vi": "Bạn vừa quen một người ở lớp buổi tối. Khi họ hỏi cuối tuần làm gì, bạn kể về môn bóng chuyền mình hay chơi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "01c2add6-2bcd-5b5c-8431-ed73107c7ec8-u01",
          "speaker_id": "B",
          "ja": "休みの日は何をしますか。",
          "vi": "Ngày nghỉ chị hay làm gì ạ?"
        },
        {
          "id": "01c2add6-2bcd-5b5c-8431-ed73107c7ec8-u02",
          "speaker_id": "A",
          "ja": "友達とバレーボールをします。",
          "vi": "Tôi hay chơi bóng chuyền với bạn."
        },
        {
          "id": "01c2add6-2bcd-5b5c-8431-ed73107c7ec8-u03",
          "speaker_id": "B",
          "ja": "よくやるんですか。",
          "vi": "Chị chơi thường xuyên không?"
        },
        {
          "id": "01c2add6-2bcd-5b5c-8431-ed73107c7ec8-u04",
          "speaker_id": "A",
          "ja": "週に一回ぐらいです。土曜日にやります。",
          "vi": "Khoảng một lần một tuần. Tôi chơi vào thứ Bảy."
        }
      ],
      "admin": {
        "source_refs": [
          "hobby"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "01c2add6-2bcd-5b5c-8431-ed73107c7ec8-u01": {
