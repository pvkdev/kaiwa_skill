    {
      "situation_uid": "39c752e4-b55c-5f6c-90b9-00884046aca3",
      "event_id": "E01",
      "context_vi": "Một người mới quen thấy bạn cầm sách lúc nghỉ giữa giờ. Bạn nói tên cuốn đang đọc và kể ngắn về nội dung.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "39c752e4-b55c-5f6c-90b9-00884046aca3-u01",
          "speaker_id": "B",
          "ja": "何を読んでいるんですか。",
          "vi": "Chị đang đọc gì ạ?"
        },
        {
          "id": "39c752e4-b55c-5f6c-90b9-00884046aca3-u02",
          "speaker_id": "A",
          "ja": "『海のとなり』という小説です。",
          "vi": "Tiểu thuyết tên Bên bờ biển ạ."
        },
        {
          "id": "39c752e4-b55c-5f6c-90b9-00884046aca3-u03",
          "speaker_id": "B",
          "ja": "どんな話ですか。",
          "vi": "Truyện kể về gì vậy?"
        },
        {
          "id": "39c752e4-b55c-5f6c-90b9-00884046aca3-u04",
          "speaker_id": "A",
          "ja": "海の近くに住む女の子の話です。短いので読みやすいです。",
          "vi": "Truyện kể về một cô gái sống gần biển. Cuốn này ngắn nên dễ đọc."
        }
      ],
      "admin": {
        "source_refs": [
          "book"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "39c752e4-b55c-5f6c-90b9-00884046aca3-u01": {
