    {
      "situation_uid": "7e973378-49e4-59c2-ab18-243ae98f1d9e",
      "event_id": "E03",
      "context_vi": "Hai bạn vừa xem xong một bộ phim. Bạn muốn biết người kia thích nhất đoạn nào trước khi nói cảm nhận của mình.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng xem",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7e973378-49e4-59c2-ab18-243ae98f1d9e-u01",
          "speaker_id": "A",
          "ja": "どの場面が一番好きだった？",
          "vi": "Cậu thích đoạn nào nhất?"
        },
        {
          "id": "7e973378-49e4-59c2-ab18-243ae98f1d9e-u02",
          "speaker_id": "B",
          "ja": "二人が駅でまた会うところ。",
          "vi": "Đoạn hai người gặp lại nhau ở ga."
        },
        {
          "id": "7e973378-49e4-59c2-ab18-243ae98f1d9e-u03",
          "speaker_id": "A",
          "ja": "あそこ、いいよね。音楽も好きだった。",
          "vi": "Đoạn đó hay nhỉ. Tớ cũng thích đoạn nhạc ở đó."
        },
        {
          "id": "7e973378-49e4-59c2-ab18-243ae98f1d9e-u04",
          "speaker_id": "B",
          "ja": "うん、静かでよかったね。",
          "vi": "Ừ, nhạc nhẹ nhàng, hay thật."
        }
      ],
