    {
      "situation_uid": "239fc15b-b884-559b-bcf4-2c75cb3f5015",
      "event_id": "E03",
      "context_vi": "Ra khỏi rạp, bạn vẫn chưa hiểu vì sao cô gái vai chính cầm chìa khóa rời nhà. Bạn hỏi người xem cùng đã hiểu đoạn đó thế nào.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng xem",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "239fc15b-b884-559b-bcf4-2c75cb3f5015-u01",
          "speaker_id": "A",
          "ja": "鍵を持って家を出るところ、よくわからなかった。どうして出たの？",
          "vi": "Tớ chưa hiểu đoạn cô ấy cầm chìa khóa rồi ra khỏi nhà. Sao cô ấy lại đi vậy?"
        },
        {
          "id": "239fc15b-b884-559b-bcf4-2c75cb3f5015-u02",
          "speaker_id": "B",
          "ja": "その前に、お兄さんから電話があったよね。迎えに行ったんだと思う。",
          "vi": "Trước đoạn đó anh trai cô ấy gọi mà. Chắc cô ấy đi đón anh ấy."
        },
        {
          "id": "239fc15b-b884-559b-bcf4-2c75cb3f5015-u03",
          "speaker_id": "A",
          "ja": "あ、電話のあとだったね。じゃあ、迎えに行ったのかもね。",
          "vi": "À, đoạn đó là sau cuộc gọi nhỉ. Vậy có khi cô ấy đi đón anh thật."
        },
        {
          "id": "239fc15b-b884-559b-bcf4-2c75cb3f5015-u04",
          "speaker_id": "B",
          "ja": "うん、そう思う。",
          "vi": "Ừ, tớ nghĩ vậy."
        }
      ],
