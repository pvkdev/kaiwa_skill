            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "5270e45f-dbe1-5bc6-90d1-e1e7649f9037",
      "event_id": "E01",
      "context_vi": "Bạn vừa kể mình chơi bóng bàn mỗi tuần. Người mới quen tưởng bạn là vận động viên chuyên nghiệp, nên bạn giải thích mình chỉ chơi cho vui.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5270e45f-dbe1-5bc6-90d1-e1e7649f9037-u01",
          "speaker_id": "B",
          "ja": "毎週ですか。卓球の選手なんですか。",
          "vi": "Tuần nào cũng chơi à? Chị là vận động viên bóng bàn ạ?"
        },
        {
          "id": "5270e45f-dbe1-5bc6-90d1-e1e7649f9037-u02",
          "speaker_id": "A",
          "ja": "いえ、趣味でやっているだけです。",
          "vi": "Dạ không, tôi chỉ chơi cho vui thôi."
        },
        {
          "id": "5270e45f-dbe1-5bc6-90d1-e1e7649f9037-u03",
          "speaker_id": "B",
          "ja": "あ、そうなんですね。どこでやるんですか。",
          "vi": "À, ra vậy. Chị chơi ở đâu?"
        },
        {
          "id": "5270e45f-dbe1-5bc6-90d1-e1e7649f9037-u04",
          "speaker_id": "A",
          "ja": "近くの体育館で友達とやります。",
          "vi": "Tôi chơi với bạn ở nhà thi đấu gần đây."
        }
      ],
      "admin": {
        "source_refs": [
          "hobby"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5270e45f-dbe1-5bc6-90d1-e1e7649f9037-u01": {
            "kind": "original_extension"
