    {
      "situation_uid": "9a7c008a-55a5-5177-b72b-f270ca4079f8",
      "event_id": "E04",
      "context_vi": "Bạn của bạn đã đọc xong một cuốn tiểu thuyết về mèo. Bạn muốn hỏi mượn vài ngày và thỏa thuận hôm trả.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người muốn mượn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn có sách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9a7c008a-55a5-5177-b72b-f270ca4079f8-u01",
          "speaker_id": "A",
          "ja": "その猫の小説、借りてもいい？",
          "vi": "Tớ mượn cuốn tiểu thuyết về mèo đó được không?"
        },
        {
          "id": "9a7c008a-55a5-5177-b72b-f270ca4079f8-u02",
          "speaker_id": "B",
          "ja": "いいよ。いつ返せそう？",
          "vi": "Được. Khi nào cậu trả được?"
        },
        {
          "id": "9a7c008a-55a5-5177-b72b-f270ca4079f8-u03",
          "speaker_id": "A",
          "ja": "月曜に返すね。",
          "vi": "Thứ Hai tớ trả nhé."
        },
        {
          "id": "9a7c008a-55a5-5177-b72b-f270ca4079f8-u04",
          "speaker_id": "B",
          "ja": "うん、月曜で大丈夫。",
          "vi": "Ừ, thứ Hai được."
        }
      ],
