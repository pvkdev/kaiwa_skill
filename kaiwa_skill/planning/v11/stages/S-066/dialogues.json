    {
      "situation_uid": "3499b96b-3979-59f2-9565-b101d0a5495a",
      "event_id": "E04",
      "context_vi": "Bạn muốn thử chơi cầu lông và hỏi người bạn hay chơi xem gần đây có chỗ nào phù hợp cho người mới.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn hay chơi cầu lông",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3499b96b-3979-59f2-9565-b101d0a5495a-u01",
          "speaker_id": "A",
          "ja": "この近くでバドミントンができるところ、知ってる？",
          "vi": "Cậu biết gần đây có chỗ nào chơi cầu lông không?"
        },
        {
          "id": "3499b96b-3979-59f2-9565-b101d0a5495a-u02",
          "speaker_id": "B",
          "ja": "公園の隣に体育館があるよ。練習はそこでやってる。",
          "vi": "Cạnh công viên có nhà thi đấu. Bọn tớ tập ở đó."
        },
        {
          "id": "3499b96b-3979-59f2-9565-b101d0a5495a-u03",
          "speaker_id": "A",
          "ja": "見に行くとき、ラケットはいる？",
          "vi": "Lúc đến xem có cần vợt không?"
        },
        {
          "id": "3499b96b-3979-59f2-9565-b101d0a5495a-u04",
          "speaker_id": "B",
          "ja": "見るだけならいらないよ。やりたかったら、私のを貸すよ。",
          "vi": "Chỉ xem thì không cần. Muốn đánh thử thì tớ cho mượn vợt."
        }
      ],
      "admin": {
        "source_refs": [
          "try"
        ],
