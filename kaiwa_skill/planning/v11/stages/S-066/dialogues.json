    {
      "situation_uid": "56eaf54f-1335-5f81-8fad-c641cf47209a",
      "event_id": "E04",
      "context_vi": "Bạn hỏi mượn một cuốn truyện tranh nhưng bạn mình đã hứa cho em mượn. Bạn muốn tìm chỗ mua cuốn đó.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người tìm sách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn có sách",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "56eaf54f-1335-5f81-8fad-c641cf47209a-u01",
          "speaker_id": "B",
          "ja": "ごめん、この漫画は妹に貸す約束なんだ。",
          "vi": "Xin lỗi, tớ hứa cho em gái mượn cuốn truyện này rồi."
        },
        {
          "id": "56eaf54f-1335-5f81-8fad-c641cf47209a-u02",
          "speaker_id": "A",
          "ja": "そっか。どこで買ったの？",
          "vi": "Ra vậy. Cậu mua ở đâu thế?"
        },
        {
          "id": "56eaf54f-1335-5f81-8fad-c641cf47209a-u03",
          "speaker_id": "B",
          "ja": "駅前の本屋だよ。漫画は二階にあるよ。",
          "vi": "Hiệu sách trước ga ấy. Truyện tranh ở tầng hai."
        },
        {
          "id": "56eaf54f-1335-5f81-8fad-c641cf47209a-u04",
          "speaker_id": "A",
          "ja": "ありがとう。今度見に行ってみる。",
          "vi": "Cảm ơn nhé. Hôm nào tớ qua xem."
        }
      ],
