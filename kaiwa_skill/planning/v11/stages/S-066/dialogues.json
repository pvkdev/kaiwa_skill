          }
        }
      }
    },
    {
      "situation_uid": "77dcb90c-7936-5c9d-8587-bf2905588988",
      "event_id": "E01",
      "context_vi": "Bạn đã nói rõ mình chơi bóng bàn với bạn ở nhà thi đấu gần nhà. Người mới quen muốn biết vì sao bạn thích môn đó.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "77dcb90c-7936-5c9d-8587-bf2905588988-u01",
          "speaker_id": "B",
          "ja": "卓球はどんなところが好きですか。",
          "vi": "Chị thích điều gì ở bóng bàn ạ?"
        },
        {
          "id": "77dcb90c-7936-5c9d-8587-bf2905588988-u02",
          "speaker_id": "A",
          "ja": "ラリーが長く続くと楽しいです。",
          "vi": "Đánh qua đánh lại được lâu thì vui lắm."
        },
        {
          "id": "77dcb90c-7936-5c9d-8587-bf2905588988-u03",
          "speaker_id": "B",
          "ja": "私はすぐにミスしてしまいます。",
          "vi": "Tôi hay đánh hỏng ngay."
        },
        {
          "id": "77dcb90c-7936-5c9d-8587-bf2905588988-u04",
          "speaker_id": "A",
          "ja": "ゆっくり打つと、ラリーが続きますよ。",
          "vi": "Đánh chậm thì hai bên qua lại được lâu hơn đấy."
        }
      ],
      "admin": {
        "source_refs": [
          "hobby"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "77dcb90c-7936-5c9d-8587-bf2905588988-u01": {
