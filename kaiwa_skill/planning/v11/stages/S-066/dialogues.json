    {
      "situation_uid": "0e27a29f-4ec2-5ebb-96c4-7f85a9805c16",
      "event_id": "E02",
      "context_vi": "Bạn biết bạn mình thích bóng đá. Bạn muốn hỏi xem người đó thích tự chơi hay thích xem trận hơn.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hỏi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn mê bóng đá",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0e27a29f-4ec2-5ebb-96c4-7f85a9805c16-u01",
          "speaker_id": "A",
          "ja": "サッカーはやるほうが好き？ 見るほうが好き？",
          "vi": "Cậu thích đá bóng hơn hay thích xem hơn?"
        },
        {
          "id": "0e27a29f-4ec2-5ebb-96c4-7f85a9805c16-u02",
          "speaker_id": "B",
          "ja": "見るほうが好き。自分ではあまりやらないよ。",
          "vi": "Tớ thích xem hơn. Tớ ít khi tự chơi."
        },
        {
          "id": "0e27a29f-4ec2-5ebb-96c4-7f85a9805c16-u03",
          "speaker_id": "A",
          "ja": "スタジアムにも見に行くの？",
          "vi": "Cậu có ra sân xem không?"
        },
        {
          "id": "0e27a29f-4ec2-5ebb-96c4-7f85a9805c16-u04",
          "speaker_id": "B",
          "ja": "たまにね。いつもは家族と家で見るよ。",
          "vi": "Thỉnh thoảng. Bình thường tớ xem ở nhà với gia đình."
        }
      ],
      "admin": {
        "source_refs": [
          "hobby"
        ],
        "specialty_item_ids": [],
