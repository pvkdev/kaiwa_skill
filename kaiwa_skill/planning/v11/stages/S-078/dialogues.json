            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "cc1c0645-bd15-5974-9fd8-452f496796fa",
      "event_id": "E01",
      "context_vi": "Bạn muốn tắm ở bồn ngoài trời của một nhà tắm công cộng. Nhân viên báo bồn đó đang đóng, nên bạn hỏi còn khu nào dùng được.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cc1c0645-bd15-5974-9fd8-452f496796fa-u01",
          "speaker_id": "B",
          "ja": "今日は外のお風呂がお休みです。",
          "vi": "Hôm nay bồn tắm ngoài trời tạm đóng ạ."
        },
        {
          "id": "cc1c0645-bd15-5974-9fd8-452f496796fa-u02",
          "speaker_id": "A",
          "ja": "ほかに入れるお風呂はありますか。",
          "vi": "Có bồn nào khác dùng được không ạ?"
        },
        {
          "id": "cc1c0645-bd15-5974-9fd8-452f496796fa-u03",
          "speaker_id": "B",
          "ja": "中のお風呂はお使いいただけます。",
          "vi": "Chị vẫn dùng được bồn trong nhà ạ."
        },
        {
          "id": "cc1c0645-bd15-5974-9fd8-452f496796fa-u04",
          "speaker_id": "A",
          "ja": "では、中のお風呂に入ります。",
          "vi": "Vậy tôi dùng bồn trong nhà ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "facility",
          "bath"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "cc1c0645-bd15-5974-9fd8-452f496796fa-u01": {
