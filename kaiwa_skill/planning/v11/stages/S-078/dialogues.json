    {
      "situation_uid": "0d75a642-3fa9-5f0b-91df-9a21c7448245",
      "event_id": "E02",
      "context_vi": "Bạn nhìn bảng giờ trước cửa một nhà tắm và nghĩ chín giờ rưỡi tối là lúc đóng. Bạn hỏi nhân viên vì bảng còn ghi mốc mười giờ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0d75a642-3fa9-5f0b-91df-9a21c7448245-u01",
          "speaker_id": "A",
          "ja": "夜九時半に閉まるんですか。",
          "vi": "Chín giờ rưỡi tối là đóng ạ?"
        },
        {
          "id": "0d75a642-3fa9-5f0b-91df-9a21c7448245-u02",
          "speaker_id": "B",
          "ja": "九時半は最後に入れる時間です。",
          "vi": "Chín giờ rưỡi là giờ cuối được vào ạ."
        },
        {
          "id": "0d75a642-3fa9-5f0b-91df-9a21c7448245-u03",
          "speaker_id": "A",
          "ja": "お風呂は何時に終わりますか。",
          "vi": "Còn khu tắm đóng lúc mấy giờ ạ?"
        },
        {
          "id": "0d75a642-3fa9-5f0b-91df-9a21c7448245-u04",
          "speaker_id": "B",
          "ja": "夜十時に閉まります。",
          "vi": "Đóng lúc mười giờ tối."
        }
      ],
      "admin": {
        "source_refs": [
          "facility"
