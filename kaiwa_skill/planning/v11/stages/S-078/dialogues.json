    {
      "situation_uid": "77bc04e7-2ee8-5d90-b3f4-6cb346c12311",
      "event_id": "E04",
      "context_vi": "Bạn dùng xong một bộ khăn thuê ở nhà tắm. Bạn hỏi nhân viên quầy trả khăn ở đâu và có phải phân khăn lớn với khăn nhỏ không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "77bc04e7-2ee8-5d90-b3f4-6cb346c12311-u01",
          "speaker_id": "A",
          "ja": "借りたタオルはどこに返しますか。",
          "vi": "Tôi trả khăn thuê ở đâu ạ?"
        },
        {
          "id": "77bc04e7-2ee8-5d90-b3f4-6cb346c12311-u02",
          "speaker_id": "B",
          "ja": "出口の横のかごに入れてください。",
          "vi": "Chị bỏ vào giỏ cạnh lối ra nhé."
        },
        {
          "id": "77bc04e7-2ee8-5d90-b3f4-6cb346c12311-u03",
          "speaker_id": "A",
          "ja": "大きいのと小さいのは一緒でいいですか。",
          "vi": "Khăn lớn và khăn nhỏ để chung được không ạ?"
        },
        {
          "id": "77bc04e7-2ee8-5d90-b3f4-6cb346c12311-u04",
          "speaker_id": "B",
          "ja": "はい。一緒に入れて大丈夫です。",
          "vi": "Vâng, chị để chung được."
        }
      ],
