    {
      "situation_uid": "c6e3c280-de17-5631-afcb-8cf60b3585d2",
      "event_id": "E02",
      "context_vi": "Bạn định vào phòng thay đồ và hỏi có thể dùng điện thoại ở trong đó không. Nhân viên nói không được, nên bạn hỏi cất máy ở đâu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c6e3c280-de17-5631-afcb-8cf60b3585d2-u01",
          "speaker_id": "A",
          "ja": "着替えるところで、スマホを使ってもいいですか。",
          "vi": "Tôi dùng điện thoại ở chỗ thay đồ được không ạ?"
        },
        {
          "id": "c6e3c280-de17-5631-afcb-8cf60b3585d2-u02",
          "speaker_id": "B",
          "ja": "脱衣所と浴室では、スマホは使わないでください。",
          "vi": "Chị vui lòng không dùng điện thoại trong phòng thay đồ và khu tắm."
        },
        {
          "id": "c6e3c280-de17-5631-afcb-8cf60b3585d2-u03",
          "speaker_id": "A",
          "ja": "じゃ、どこにしまえばいいですか。",
          "vi": "Vậy tôi cất ở đâu ạ?"
        },
        {
          "id": "c6e3c280-de17-5631-afcb-8cf60b3585d2-u04",
          "speaker_id": "B",
          "ja": "脱衣所のロッカーに入れて、鍵をかけてください。",
          "vi": "Chị để vào tủ trong phòng thay đồ rồi khóa lại nhé."
        },
        {
          "id": "c6e3c280-de17-5631-afcb-8cf60b3585d2-u05",
          "speaker_id": "A",
          "ja": "わかりました。先にしまいます。",
          "vi": "Tôi hiểu rồi. Tôi cất trước ạ."
        }
      ],
      "admin": {
