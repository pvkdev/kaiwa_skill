    {
      "situation_uid": "6af900cb-bc52-53f9-a35a-7ba5810ee4e6",
      "event_id": "E04",
      "context_vi": "Bạn được gọi trở lại quầy sau khi ngồi chờ tìm túi. Bạn đưa phiếu ghi ngăn số 18 và nhắc lại đặc điểm túi để nhân viên đối chiếu.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6af900cb-bc52-53f9-a35a-7ba5810ee4e6-u01",
          "speaker_id": "A",
          "ja": "お呼びいただいた者です。札は十八番です。",
          "vi": "Tôi là người anh vừa gọi. Phiếu của tôi số 18 ạ."
        },
        {
          "id": "6af900cb-bc52-53f9-a35a-7ba5810ee4e6-u02",
          "speaker_id": "B",
          "ja": "ありがとうございます。色をもう一度教えてください。",
          "vi": "Cảm ơn chị. Chị nói lại giúp tôi màu của túi nhé."
        },
        {
          "id": "6af900cb-bc52-53f9-a35a-7ba5810ee4e6-u03",
          "speaker_id": "A",
          "ja": "紺色です。持ち手は白です。",
          "vi": "Túi xanh đậm. Quai màu trắng ạ."
        },
        {
          "id": "6af900cb-bc52-53f9-a35a-7ba5810ee4e6-u04",
          "speaker_id": "B",
          "ja": "十八番に、そういうかばんが一つありました。お見せしますね。",
          "vi": "Ở ngăn 18 có một chiếc túi như vậy. Tôi đưa chị xem nhé."
        }
      ],
