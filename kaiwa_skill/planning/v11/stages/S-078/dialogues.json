    {
      "situation_uid": "866e1345-a12d-5eb8-8dfa-d25722f1d9d7",
      "event_id": "E02",
      "context_vi": "Bạn đang ở quầy Koganeyu vào một ngày thường và muốn vào phòng sauna riêng cạnh khu tắm. Bạn hỏi vé tắm đã bao gồm sauna chưa và có thể mua thêm không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách nữ",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "866e1345-a12d-5eb8-8dfa-d25722f1d9d7-u01",
          "speaker_id": "A",
          "ja": "この入浴券で、奥のサウナも使えますか。",
          "vi": "Vé tắm này có dùng được cả sauna phía trong không ạ?"
        },
        {
          "id": "866e1345-a12d-5eb8-8dfa-d25722f1d9d7-u02",
          "speaker_id": "B",
          "ja": "サウナは別料金です。",
          "vi": "Sauna tính phí riêng chị ạ."
        },
        {
          "id": "866e1345-a12d-5eb8-8dfa-d25722f1d9d7-u03",
          "speaker_id": "A",
          "ja": "じゃ、今からサウナもお願いできますか。",
          "vi": "Vậy bây giờ tôi mua thêm lượt sauna được không ạ?"
        },
        {
          "id": "866e1345-a12d-5eb8-8dfa-d25722f1d9d7-u04",
          "speaker_id": "B",
          "ja": "はい。今は空いていますので、こちらで追加できます。",
          "vi": "Được ạ. Hiện còn chỗ, chị mua thêm ngay tại quầy này được."
        }
      ],
      "admin": {
        "source_refs": [
          "facility",
          "kogane"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "866e1345-a12d-5eb8-8dfa-d25722f1d9d7-u01": {
