    {
      "situation_uid": "76839752-309e-558e-8578-21bc7906af0c",
      "event_id": "E02",
      "context_vi": "Nhân viên vừa giải thích hai mốc khác nhau ở bảng giờ. Bạn muốn nhắc đúng giờ cuối được vào và giờ phải rời nhà tắm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "76839752-309e-558e-8578-21bc7906af0c-u01",
          "speaker_id": "A",
          "ja": "九時半までに入って、十時に閉まるんですね。",
          "vi": "Vào chậm nhất lúc chín giờ rưỡi, đóng lúc mười giờ tối ạ?"
        },
        {
          "id": "76839752-309e-558e-8578-21bc7906af0c-u02",
          "speaker_id": "B",
          "ja": "はい。十時までに外に出てください。",
          "vi": "Vâng. Chị ra ngoài chậm nhất lúc mười giờ nhé."
        },
        {
          "id": "76839752-309e-558e-8578-21bc7906af0c-u03",
          "speaker_id": "A",
          "ja": "わかりました。十時までに出ます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ ra chậm nhất lúc mười giờ."
        }
      ],
      "admin": {
        "source_refs": [
