    {
      "situation_uid": "16aa2d55-bcf5-565c-8022-168abcc77be0",
      "event_id": "E03",
      "context_vi": "Bạn vừa dùng xong vòi tắm. Một khách khác đang đợi tới lượt và hỏi bạn có thể dọn chậu để họ dùng chỗ đó không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Khách chờ vòi",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "16aa2d55-bcf5-565c-8022-168abcc77be0-u01",
          "speaker_id": "B",
          "ja": "こちら、もう使ってもいいですか。",
          "vi": "Tôi dùng chỗ này được chưa ạ?"
        },
        {
          "id": "16aa2d55-bcf5-565c-8022-168abcc77be0-u02",
          "speaker_id": "A",
          "ja": "はい、終わりました。洗面器を片付けますね。",
          "vi": "Được ạ, tôi dùng xong rồi. Tôi cất cái chậu nhé."
        },
        {
          "id": "16aa2d55-bcf5-565c-8022-168abcc77be0-u03",
          "speaker_id": "B",
          "ja": "ありがとうございます。あの棚に戻すみたいです。",
          "vi": "Cảm ơn chị. Có vẻ chậu để lại trên kệ kia ạ."
        },
        {
          "id": "16aa2d55-bcf5-565c-8022-168abcc77be0-u04",
          "speaker_id": "A",
          "ja": "じゃ、棚に戻します。どうぞ。",
          "vi": "Vậy tôi để lại lên kệ. Chị dùng đi ạ."
        }
      ],
      "admin": {
