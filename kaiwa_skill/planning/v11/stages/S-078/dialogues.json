    {
      "situation_uid": "aaf7b733-d10e-5387-9b42-9dd14b858683",
      "event_id": "E03",
      "context_vi": "Trong khu tắm nữ, bạn tưởng có thể dùng xà phòng cạnh bồn ngâm. Nhân viên nêu quy tắc và bạn hỏi lại cần sang vị trí nào để tắm rửa.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên trực khu tắm",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "aaf7b733-d10e-5387-9b42-9dd14b858683-u01",
          "speaker_id": "B",
          "ja": "すみません。湯船のそばでは石けんを使わないでください。",
          "vi": "Xin nhắc chị, cạnh bồn ngâm mình không dùng xà phòng ạ."
        },
        {
          "id": "aaf7b733-d10e-5387-9b42-9dd14b858683-u02",
          "speaker_id": "A",
          "ja": "すみません。どこで体を洗いますか。",
          "vi": "Tôi xin lỗi. Tôi tắm rửa ở đâu ạ?"
        },
        {
          "id": "aaf7b733-d10e-5387-9b42-9dd14b858683-u03",
          "speaker_id": "B",
          "ja": "シャワーのある洗い場でお願いします。",
          "vi": "Chị dùng khu tắm có vòi sen nhé."
        },
        {
          "id": "aaf7b733-d10e-5387-9b42-9dd14b858683-u04",
          "speaker_id": "A",
          "ja": "わかりました。洗い場に移りますね。",
          "vi": "Tôi hiểu rồi. Tôi chuyển sang chỗ vòi sen ạ."
        }
      ],
      "admin": {
