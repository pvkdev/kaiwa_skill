    {
      "situation_uid": "f45d78f9-e9ec-5c38-8cda-8118fa8380b4",
      "event_id": "E04",
      "context_vi": "Bạn tới quầy lấy chiếc túi xanh đậm quai trắng đã gửi. Nhân viên cần đối chiếu các ngăn giữ đồ. Bạn hỏi có thể ngồi đợi ở đâu và làm thế nào biết lúc quay lại.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f45d78f9-e9ec-5c38-8cda-8118fa8380b4-u01",
          "speaker_id": "B",
          "ja": "かばんをお探しします。少しお時間をいただけますか。",
          "vi": "Tôi sẽ tìm túi cho chị. Chị chờ chúng tôi một chút được không ạ?"
        },
        {
          "id": "f45d78f9-e9ec-5c38-8cda-8118fa8380b4-u02",
          "speaker_id": "A",
          "ja": "はい。どこで待てばいいですか。",
          "vi": "Được ạ. Tôi nên chờ ở đâu ạ?"
        },
        {
          "id": "f45d78f9-e9ec-5c38-8cda-8118fa8380b4-u03",
          "speaker_id": "B",
          "ja": "入口の椅子でお待ちください。確認したらお呼びします。",
          "vi": "Chị đợi ở hàng ghế gần lối vào nhé. Kiểm xong tôi sẽ gọi."
        },
        {
          "id": "f45d78f9-e9ec-5c38-8cda-8118fa8380b4-u04",
          "speaker_id": "A",
          "ja": "わかりました。札を持って、そこで待ちます。",
          "vi": "Vâng. Tôi giữ phiếu rồi ra đó đợi."
        }
      ],
      "admin": {
