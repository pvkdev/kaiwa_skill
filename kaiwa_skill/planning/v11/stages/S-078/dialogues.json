    {
      "situation_uid": "2113fba1-b5d6-56a1-9be2-dd8f94902ff4",
      "event_id": "E03",
      "context_vi": "Bạn đã chuyển sang chỗ vòi để rửa người theo lời nhân viên. Bạn cảm ơn vì được chỉ và hỏi để khăn ở đâu khi sang bồn ngâm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên trực khu tắm",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2113fba1-b5d6-56a1-9be2-dd8f94902ff4-u01",
          "speaker_id": "A",
          "ja": "さっきは教えてくださって、ありがとうございます。",
          "vi": "Cảm ơn chị vừa chỉ cho tôi."
        },
        {
          "id": "2113fba1-b5d6-56a1-9be2-dd8f94902ff4-u02",
          "speaker_id": "A",
          "ja": "湯船に入るとき、タオルはどこに置きますか。",
          "vi": "Khi vào bồn ngâm, tôi để khăn ở đâu ạ?"
        },
        {
          "id": "2113fba1-b5d6-56a1-9be2-dd8f94902ff4-u03",
          "speaker_id": "B",
          "ja": "湯船には入れないでください。そこの棚に置けますよ。",
          "vi": "Chị đừng để khăn vào bồn. Có thể để trên kệ kia."
        },
        {
          "id": "2113fba1-b5d6-56a1-9be2-dd8f94902ff4-u04",
          "speaker_id": "A",
          "ja": "わかりました。棚に置いてから入ります。",
          "vi": "Tôi hiểu rồi. Tôi để khăn lên kệ rồi mới xuống bồn."
        }
      ],
      "admin": {
        "source_refs": [
