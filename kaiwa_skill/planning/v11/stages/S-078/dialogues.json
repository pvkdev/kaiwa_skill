    {
      "situation_uid": "49b8adab-ff18-5fe1-b2a4-c199119034fd",
      "event_id": "E03",
      "context_vi": "Bạn đã thuê khăn nhưng không thấy bộ khăn trong ngăn lấy đồ của phòng thay đồ. Bạn báo nhân viên nữ trực khu và đưa phiếu thuê.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên trực khu tắm",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "49b8adab-ff18-5fe1-b2a4-c199119034fd-u01",
          "speaker_id": "A",
          "ja": "タオルを借りましたが、棚にありませんでした。",
          "vi": "Tôi đã thuê khăn nhưng không thấy khăn trên kệ ạ."
        },
        {
          "id": "49b8adab-ff18-5fe1-b2a4-c199119034fd-u02",
          "speaker_id": "B",
          "ja": "貸し出し券はお持ちですか。",
          "vi": "Chị có phiếu thuê không ạ?"
        },
        {
          "id": "49b8adab-ff18-5fe1-b2a4-c199119034fd-u03",
          "speaker_id": "A",
          "ja": "はい、これです。",
          "vi": "Có ạ, phiếu đây."
        },
        {
          "id": "49b8adab-ff18-5fe1-b2a4-c199119034fd-u04",
          "speaker_id": "B",
          "ja": "確認できました。こちらのセットをお使いください。",
          "vi": "Tôi đã kiểm được rồi. Chị dùng bộ này nhé."
        },
        {
          "id": "49b8adab-ff18-5fe1-b2a4-c199119034fd-u05",
          "speaker_id": "A",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn chị."
        }
      ],
      "admin": {
