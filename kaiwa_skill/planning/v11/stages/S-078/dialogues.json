          }
        }
      }
    },
    {
      "situation_uid": "6d43d825-e04c-5617-a53d-b7f3b613ae75",
      "event_id": "E02",
      "context_vi": "Bạn tới một sento và mang theo túi vải nhỏ. Bạn hỏi nơi cất túi cùng quần áo và làm gì với chìa khóa tủ khi đi tắm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6d43d825-e04c-5617-a53d-b7f3b613ae75-u01",
          "speaker_id": "A",
          "ja": "かばんと服はどこに置きますか。",
          "vi": "Tôi để túi với quần áo ở đâu ạ?"
        },
        {
          "id": "6d43d825-e04c-5617-a53d-b7f3b613ae75-u02",
          "speaker_id": "B",
          "ja": "脱衣所の空いているロッカーをお使いください。",
          "vi": "Chị dùng tủ còn trống trong phòng thay đồ nhé."
        },
        {
          "id": "6d43d825-e04c-5617-a53d-b7f3b613ae75-u03",
          "speaker_id": "A",
          "ja": "鍵はお風呂に持っていきますか。",
          "vi": "Tôi mang chìa vào khu tắm ạ?"
        },
        {
          "id": "6d43d825-e04c-5617-a53d-b7f3b613ae75-u04",
          "speaker_id": "B",
          "ja": "はい。このひもを手首につけてください。",
          "vi": "Vâng. Chị đeo dây này vào cổ tay nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "bath"
        ],
        "specialty_item_ids": [],
