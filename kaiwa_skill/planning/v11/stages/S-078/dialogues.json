    },
    {
      "situation_uid": "ff977ad2-b1fc-50e6-9f79-f78d7fa0ae54",
      "event_id": "E01",
      "context_vi": "Bạn định tắm ở Koganeyu, Tokyo và không mang khăn. Bạn hỏi giá vé tắm người lớn và có thể thuê khăn ở đây không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ff977ad2-b1fc-50e6-9f79-f78d7fa0ae54-u01",
          "speaker_id": "A",
          "ja": "大人一人、入浴はいくらですか。",
          "vi": "Một vé tắm người lớn bao nhiêu ạ?"
        },
        {
          "id": "ff977ad2-b1fc-50e6-9f79-f78d7fa0ae54-u02",
          "speaker_id": "B",
          "ja": "六百円です。",
          "vi": "Sáu trăm yên ạ."
        },
        {
          "id": "ff977ad2-b1fc-50e6-9f79-f78d7fa0ae54-u03",
          "speaker_id": "A",
          "ja": "タオルを持っていません。借りられますか。",
          "vi": "Tôi không mang khăn. Ở đây có cho thuê không ạ?"
        },
        {
          "id": "ff977ad2-b1fc-50e6-9f79-f78d7fa0ae54-u04",
          "speaker_id": "B",
          "ja": "はい。タオルセットは追加で二百円です。",
          "vi": "Có ạ. Bộ khăn thuê thêm hai trăm yên."
        },
        {
          "id": "ff977ad2-b1fc-50e6-9f79-f78d7fa0ae54-u05",
          "speaker_id": "A",
          "ja": "じゃ、タオルもお願いします。合わせて八百円ですね。",
          "vi": "Vậy cho tôi thuê cả khăn ạ. Tổng là tám trăm yên đúng không?"
        }
      ],
      "admin": {
        "source_refs": [
          "bath",
          "price",
          "kogane"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
