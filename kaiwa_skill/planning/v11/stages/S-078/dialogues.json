    {
      "situation_uid": "4c98371a-4f0c-5266-affc-d3258e1445b8",
      "event_id": "E03",
      "context_vi": "Trong khu tắm nữ, bạn thấy vòi trước mặt không ra nước. Bạn hỏi một khách khác có thể dùng vòi nào và đợi đúng lượt.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Khách cùng khu tắm",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4c98371a-4f0c-5266-affc-d3258e1445b8-u01",
          "speaker_id": "A",
          "ja": "すみません。このシャワー、水が出ません。どれが使えますか。",
          "vi": "Cho tôi hỏi, vòi này không ra nước. Vòi nào dùng được ạ?"
        },
        {
          "id": "4c98371a-4f0c-5266-affc-d3258e1445b8-u02",
          "speaker_id": "B",
          "ja": "鏡の横のシャワーは使えますよ。",
          "vi": "Vòi cạnh gương dùng được đấy chị."
        },
        {
          "id": "4c98371a-4f0c-5266-affc-d3258e1445b8-u03",
          "speaker_id": "A",
          "ja": "今、空いていますか。",
          "vi": "Hiện giờ chỗ đó trống không ạ?"
        },
        {
          "id": "4c98371a-4f0c-5266-affc-d3258e1445b8-u04",
          "speaker_id": "B",
          "ja": "はい。さっきの人はもう終わりました。",
          "vi": "Vâng. Người lúc nãy dùng xong rồi."
        },
        {
          "id": "4c98371a-4f0c-5266-affc-d3258e1445b8-u05",
          "speaker_id": "A",
          "ja": "ありがとうございます。そちらを使います。",
          "vi": "Cảm ơn chị. Tôi sẽ dùng vòi đó."
        }
      ],
      "admin": {
