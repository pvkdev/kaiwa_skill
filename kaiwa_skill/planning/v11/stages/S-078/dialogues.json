    {
      "situation_uid": "0f65371c-eb29-581d-8a33-64359ab862ec",
      "event_id": "E04",
      "context_vi": "Khi ra về, bạn đưa phiếu lấy chiếc túi gửi tại quầy nhưng nhân viên chưa thấy. Bạn mô tả màu và quai rồi hỏi có thể tìm theo phiếu không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0f65371c-eb29-581d-8a33-64359ab862ec-u01",
          "speaker_id": "A",
          "ja": "預けたかばんを取りに来ました。こちらの札です。",
          "vi": "Tôi đến lấy chiếc túi đã gửi. Đây là phiếu gửi ạ."
        },
        {
          "id": "0f65371c-eb29-581d-8a33-64359ab862ec-u02",
          "speaker_id": "B",
          "ja": "すぐには見当たりませんね。どんなかばんですか。",
          "vi": "Tôi chưa thấy ngay. Túi của chị trông thế nào ạ?"
        },
        {
          "id": "0f65371c-eb29-581d-8a33-64359ab862ec-u03",
          "speaker_id": "A",
          "ja": "紺色で、持ち手が白いです。この番号で探せますか。",
          "vi": "Túi xanh đậm, quai trắng. Anh tìm theo số này được không ạ?"
        },
        {
          "id": "0f65371c-eb29-581d-8a33-64359ab862ec-u04",
          "speaker_id": "B",
          "ja": "はい、札の番号でお調べします。",
          "vi": "Được ạ, tôi sẽ tra theo số trên phiếu."
        }
      ],
      "admin": {
