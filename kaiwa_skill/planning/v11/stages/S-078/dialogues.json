        }
      }
    },
    {
      "situation_uid": "5815933c-7a98-5a9f-9012-86571beaf2f1",
      "event_id": "E01",
      "context_vi": "Bạn lần đầu tới một sento. Bạn đã trả vé và muốn hỏi nhân viên lối vào đúng phòng thay đồ của khu nữ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5815933c-7a98-5a9f-9012-86571beaf2f1-u01",
          "speaker_id": "A",
          "ja": "初めてです。女湯はどちらですか。",
          "vi": "Tôi tới lần đầu. Khu tắm nữ ở phía nào ạ?"
        },
        {
          "id": "5815933c-7a98-5a9f-9012-86571beaf2f1-u02",
          "speaker_id": "B",
          "ja": "右手ののれんの奥です。",
          "vi": "Qua tấm rèm bên tay phải chị ạ."
        },
        {
          "id": "5815933c-7a98-5a9f-9012-86571beaf2f1-u03",
          "speaker_id": "A",
          "ja": "「女」と書いてあるのれんですね。",
          "vi": "Tấm rèm có ghi chữ “Nữ” đúng không ạ?"
        },
        {
          "id": "5815933c-7a98-5a9f-9012-86571beaf2f1-u04",
          "speaker_id": "B",
          "ja": "はい。その奥にロッカーがあります。",
          "vi": "Vâng. Sau rèm có tủ để đồ."
        }
      ],
      "admin": {
        "source_refs": [
          "facility",
          "bath"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5815933c-7a98-5a9f-9012-86571beaf2f1-u01": {
