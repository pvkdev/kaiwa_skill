    {
      "situation_uid": "fcdc23ee-081d-512f-a885-31243cbb4b12",
      "event_id": "E04",
      "context_vi": "Nhân viên vừa tìm được một chiếc túi xanh đậm quai trắng trong ngăn số 18. Bạn nhận ra thêm chiếc móc tròn của mình rồi cảm ơn khi nhận túi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fcdc23ee-081d-512f-a885-31243cbb4b12-u01",
          "speaker_id": "B",
          "ja": "こちらのかばんで間違いないですか。",
          "vi": "Đúng chiếc túi này của chị chứ ạ?"
        },
        {
          "id": "fcdc23ee-081d-512f-a885-31243cbb4b12-u02",
          "speaker_id": "A",
          "ja": "はい。この丸いキーホルダーがついているので、私のです。",
          "vi": "Đúng rồi. Có chiếc móc khóa tròn này nên đúng túi của tôi ạ."
        },
        {
          "id": "fcdc23ee-081d-512f-a885-31243cbb4b12-u03",
          "speaker_id": "B",
          "ja": "では、かばんをお返しします。札はこちらでお預かりします。",
          "vi": "Vậy tôi gửi lại túi cho chị. Tôi xin nhận lại phiếu nhé."
        },
        {
          "id": "fcdc23ee-081d-512f-a885-31243cbb4b12-u04",
          "speaker_id": "A",
          "ja": "見つけてくださって、ありがとうございました。",
          "vi": "Cảm ơn anh đã tìm giúp tôi."
        }
      ],
