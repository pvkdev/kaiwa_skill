        }
      }
    },
    {
      "situation_uid": "e2a71b63-b333-5634-8293-81ec0ded62f8",
      "event_id": "E01",
      "context_vi": "Bạn đã chọn dùng bồn trong nhà vì bồn ngoài trời tạm đóng. Bạn kiểm phòng thay đồ ở đâu và nhà tắm đóng lúc mấy giờ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e2a71b63-b333-5634-8293-81ec0ded62f8-u01",
          "speaker_id": "A",
          "ja": "着替える場所はどこですか。",
          "vi": "Tôi thay đồ ở đâu ạ?"
        },
        {
          "id": "e2a71b63-b333-5634-8293-81ec0ded62f8-u02",
          "speaker_id": "B",
          "ja": "女湯ののれんを入ってすぐです。",
          "vi": "Ngay sau tấm rèm khu tắm nữ chị ạ."
        },
        {
          "id": "e2a71b63-b333-5634-8293-81ec0ded62f8-u03",
          "speaker_id": "A",
          "ja": "今日は何時に閉まりますか。",
          "vi": "Hôm nay đóng lúc mấy giờ ạ?"
        },
        {
          "id": "e2a71b63-b333-5634-8293-81ec0ded62f8-u04",
          "speaker_id": "B",
          "ja": "夜十時に閉まります。",
          "vi": "Mười giờ tối ạ."
        },
        {
          "id": "e2a71b63-b333-5634-8293-81ec0ded62f8-u05",
          "speaker_id": "A",
          "ja": "のれんの奥で着替えて、十時までですね。",
          "vi": "Thay đồ sau rèm, đóng lúc mười giờ tối ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "facility",
          "bath"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e2a71b63-b333-5634-8293-81ec0ded62f8-u01": {
