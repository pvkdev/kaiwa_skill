  "dialogues": [
    {
      "situation_uid": "e4334e27-0c7e-593a-a935-8a18a9dfd56a",
      "event_id": "E01",
      "context_vi": "Bạn đến nhà tắm Koganeyu ở Tokyo vào một tối mà cơ sở mở cửa. Thấy đã muộn, bạn hỏi nhân viên hôm nay còn mở không và đóng lúc mấy giờ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Khách",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e4334e27-0c7e-593a-a935-8a18a9dfd56a-u01",
          "speaker_id": "A",
          "ja": "すみません。今日はまだやっていますか。",
          "vi": "Cho tôi hỏi, hôm nay vẫn còn mở chứ ạ?"
        },
        {
          "id": "e4334e27-0c7e-593a-a935-8a18a9dfd56a-u02",
          "speaker_id": "B",
          "ja": "はい、今も営業中です。",
          "vi": "Vâng, vẫn đang mở chị ạ."
        },
        {
          "id": "e4334e27-0c7e-593a-a935-8a18a9dfd56a-u03",
          "speaker_id": "A",
          "ja": "何時までですか。",
          "vi": "Mở tới mấy giờ ạ?"
        },
        {
          "id": "e4334e27-0c7e-593a-a935-8a18a9dfd56a-u04",
          "speaker_id": "B",
          "ja": "夜は十二時半までです。",
          "vi": "Tới mười hai giờ rưỡi đêm ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "facility",
          "kogane"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "e4334e27-0c7e-593a-a935-8a18a9dfd56a-u01": {
