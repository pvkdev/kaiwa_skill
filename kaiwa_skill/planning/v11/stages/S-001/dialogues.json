    {
      "situation_uid": "aa1446c1-db5c-5704-b4c6-aa10b3c92bf1",
      "event_id": "E03",
      "context_vi": "Bạn đang ở nhà một người quen. Chủ nhà còn tiếp khách khác; bạn muốn báo mình ra về mà không kéo dài cuộc nói.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "chủ nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "aa1446c1-db5c-5704-b4c6-aa10b3c92bf1-u01",
          "speaker_id": "a",
          "ja": "今日はありがとうございました。そろそろ帰ります。",
          "vi": "Hôm nay cảm ơn anh. Tôi xin về nhé."
        },
        {
          "id": "aa1446c1-db5c-5704-b4c6-aa10b3c92bf1-u02",
          "speaker_id": "b",
          "ja": "こちらこそ。気をつけて帰ってください。",
          "vi": "Tôi mới phải cảm ơn chị. Chị về cẩn thận nhé."
        },
        {
          "id": "aa1446c1-db5c-5704-b4c6-aa10b3c92bf1-u03",
          "speaker_id": "a",
          "ja": "はい。では、失礼します。",
          "vi": "Vâng. Vậy tôi xin phép."
        }
      ],
