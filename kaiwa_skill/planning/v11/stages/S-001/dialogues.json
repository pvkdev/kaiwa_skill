    {
      "situation_uid": "b21c1629-6cdf-58c8-b833-5a429839adbd",
      "event_id": "E03",
      "context_vi": "Ở hành lang, người khác vô ý chạm nhẹ vào túi của bạn rồi xin lỗi. Túi vẫn ổn, bạn đáp để người ấy yên tâm.",
