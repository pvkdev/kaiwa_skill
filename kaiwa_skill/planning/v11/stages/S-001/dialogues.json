    {
      "situation_uid": "4a92db6d-6297-5bfd-b6fd-9735993ff130",
      "event_id": "E02",
      "context_vi": "Bạn gặp người quen ở hành lang và muốn hỏi một việc ngắn về buổi họp nhóm. Bạn chưa biết anh ấy có rảnh không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4a92db6d-6297-5bfd-b6fd-9735993ff130-u01",
          "speaker_id": "a",
          "ja": "こんにちは。今、ちょっといいですか。",
          "vi": "Chào anh. Bây giờ tôi hỏi nhanh một chút được không?"
        },
        {
          "id": "4a92db6d-6297-5bfd-b6fd-9735993ff130-u02",
          "speaker_id": "b",
          "ja": "こんにちは。何ですか。",
          "vi": "Chào chị. Chuyện gì vậy?"
        },
        {
          "id": "4a92db6d-6297-5bfd-b6fd-9735993ff130-u03",
          "speaker_id": "a",
          "ja": "今日の集まりは、何時からですか。",
          "vi": "Buổi gặp hôm nay bắt đầu lúc mấy giờ?"
        },
        {
          "id": "4a92db6d-6297-5bfd-b6fd-9735993ff130-u04",
          "speaker_id": "b",
          "ja": "六時からです。",
          "vi": "Từ sáu giờ."
        }
      ],
      "admin": {
        "source_refs": [
          "social"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
