    {
      "situation_uid": "d5bcb97b-43ab-5490-bc99-121faf01886d",
      "event_id": "E02",
      "context_vi": "Đúng năm giờ, bạn gặp lại người quen ở hành lang như đã hẹn để hỏi địa điểm buổi họp nhóm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d5bcb97b-43ab-5490-bc99-121faf01886d-u01",
          "speaker_id": "a",
          "ja": "さっきはどうも。今、いいですか。",
          "vi": "Cảm ơn anh lúc nãy. Giờ anh tiện chứ?"
        },
        {
          "id": "d5bcb97b-43ab-5490-bc99-121faf01886d-u02",
          "speaker_id": "b",
          "ja": "はい、大丈夫です。",
          "vi": "Ừ, giờ được rồi."
        },
        {
          "id": "d5bcb97b-43ab-5490-bc99-121faf01886d-u03",
          "speaker_id": "a",
          "ja": "今日の集まりは、どこですか。",
          "vi": "Buổi gặp hôm nay ở đâu vậy anh?"
        },
        {
          "id": "d5bcb97b-43ab-5490-bc99-121faf01886d-u04",
          "speaker_id": "b",
          "ja": "二階の部屋です。",
          "vi": "Ở phòng trên tầng hai."
        },
        {
          "id": "d5bcb97b-43ab-5490-bc99-121faf01886d-u05",
          "speaker_id": "a",
          "ja": "二階ですね。ありがとう。",
          "vi": "Tầng hai nhỉ. Cảm ơn anh."
        }
      ],
