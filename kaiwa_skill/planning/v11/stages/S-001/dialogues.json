    {
      "situation_uid": "affe03fa-0e40-59f9-9307-4eaf6e07170c",
      "event_id": "E01",
      "context_vi": "Một người bạn vừa giới thiệu bạn với Nam ở buổi sinh hoạt nhóm rồi đi ra ngoài. Bạn chào Nam và để anh ấy nói về mình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người vừa được giới thiệu",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "affe03fa-0e40-59f9-9307-4eaf6e07170c-u01",
          "speaker_id": "a",
          "ja": "はじめまして。リンです。",
          "vi": "Rất vui được gặp anh. Tôi là Linh."
        },
        {
          "id": "affe03fa-0e40-59f9-9307-4eaf6e07170c-u02",
          "speaker_id": "b",
          "ja": "はじめまして。ナムです。",
          "vi": "Rất vui được gặp chị. Tôi là Nam."
        },
        {
          "id": "affe03fa-0e40-59f9-9307-4eaf6e07170c-u03",
          "speaker_id": "a",
          "ja": "ナムさんは、今日が初めてですか。",
          "vi": "Hôm nay anh Nam cũng mới đến lần đầu à?"
        },
        {
          "id": "affe03fa-0e40-59f9-9307-4eaf6e07170c-u04",
          "speaker_id": "b",
          "ja": "はい、初めてです。",
          "vi": "Vâng, lần đầu tôi đến."
        }
      ],
      "admin": {
        "source_refs": [
