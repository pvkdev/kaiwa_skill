    {
      "situation_uid": "e0c3e90a-decb-5845-9889-7e2311363d88",
      "event_id": "E02",
      "context_vi": "Sáng sớm bạn và người hàng xóm cùng bước ra khỏi khu nhà. Bạn muốn chào và nhường lối ở cửa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e0c3e90a-decb-5845-9889-7e2311363d88-u01",
          "speaker_id": "a",
          "ja": "おはようございます。お先にどうぞ。",
          "vi": "Chào buổi sáng. Anh đi trước đi ạ."
        },
        {
          "id": "e0c3e90a-decb-5845-9889-7e2311363d88-u02",
          "speaker_id": "b",
          "ja": "おはようございます。ありがとうございます。",
          "vi": "Chào chị. Cảm ơn chị."
        },
        {
          "id": "e0c3e90a-decb-5845-9889-7e2311363d88-u03",
          "speaker_id": "a",
          "ja": "今日は寒いですね。",
          "vi": "Hôm nay lạnh nhỉ."
        },
        {
          "id": "e0c3e90a-decb-5845-9889-7e2311363d88-u04",
          "speaker_id": "b",
          "ja": "そうですね。行ってきます。",
          "vi": "Đúng vậy. Tôi đi đây."
        }
      ],
      "admin": {
        "source_refs": [
          "greet",
          "manner"
        ],
        "specialty_item_ids": [],
