  "dialogues": [
    {
      "situation_uid": "14de490a-b0f6-5fb6-95fa-acccf54a0e7f",
      "event_id": "E01",
      "context_vi": "Buổi sáng đầu tiên ở lớp tiếng Nhật, bạn ngồi cạnh một học viên chưa quen và muốn mở lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "14de490a-b0f6-5fb6-95fa-acccf54a0e7f-u01",
          "speaker_id": "a",
          "ja": "おはようございます。こちら、いいですか。",
          "vi": "Chào buổi sáng. Tôi ngồi đây được không?"
        },
        {
          "id": "14de490a-b0f6-5fb6-95fa-acccf54a0e7f-u02",
          "speaker_id": "b",
          "ja": "おはようございます。はい、どうぞ。",
          "vi": "Chào buổi sáng. Được chứ, mời bạn."
        },
        {
          "id": "14de490a-b0f6-5fb6-95fa-acccf54a0e7f-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。今日からこのクラスです。",
          "vi": "Cảm ơn bạn. Hôm nay tôi mới vào lớp."
        },
        {
          "id": "14de490a-b0f6-5fb6-95fa-acccf54a0e7f-u04",
          "speaker_id": "b",
          "ja": "そうですか。よろしくお願いします。",
          "vi": "Vậy à. Rất vui được học cùng bạn."
        }
      ],
      "admin": {
