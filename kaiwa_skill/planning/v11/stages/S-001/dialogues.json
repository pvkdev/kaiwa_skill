    {
      "situation_uid": "5410f579-b1ae-5eb8-8189-7db750854c87",
      "event_id": "E03",
      "context_vi": "Ở lớp học, người ngồi cạnh vừa chỉ cho bạn chiếc ghế còn trống. Bạn muốn cảm ơn và nhận lời chỉ chỗ.",
