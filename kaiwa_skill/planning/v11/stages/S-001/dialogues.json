    {
      "situation_uid": "4b063d02-7dfd-5757-9ee6-0d54fb154e44",
      "event_id": "E02",
      "context_vi": "Buổi tối bạn gặp lại người quen ở lối vào chung cư; hai người đã chào nhau buổi sáng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4b063d02-7dfd-5757-9ee6-0d54fb154e44-u01",
          "speaker_id": "a",
          "ja": "こんばんは。また会いましたね。",
          "vi": "Chào anh. Lại gặp anh rồi."
        },
        {
          "id": "4b063d02-7dfd-5757-9ee6-0d54fb154e44-u02",
          "speaker_id": "b",
          "ja": "こんばんは。今日は早いですね。",
          "vi": "Chào chị. Hôm nay chị về sớm nhỉ."
        },
        {
          "id": "4b063d02-7dfd-5757-9ee6-0d54fb154e44-u03",
          "speaker_id": "a",
          "ja": "はい、今日は早く終わりました。",
          "vi": "Vâng, hôm nay tôi xong sớm."
        },
        {
          "id": "4b063d02-7dfd-5757-9ee6-0d54fb154e44-u04",
          "speaker_id": "b",
          "ja": "そうですか。お疲れさまです。",
          "vi": "Vậy à. Chị vất vả rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "greet",
          "social"
        ],
