          }
        }
      }
    },
    {
      "situation_uid": "f8a6180a-155c-5e8c-8780-635cc4256ccc",
      "event_id": "E01",
      "context_vi": "Ngay sau khi bạn nhận ra mình chào nhầm người ở hành lang, hai người vẫn đứng lại và bắt đầu làm quen.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "học viên mới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f8a6180a-155c-5e8c-8780-635cc4256ccc-u01",
          "speaker_id": "a",
          "ja": "私はリンです。お名前は？",
          "vi": "Tôi là Linh. Anh tên gì?"
        },
        {
          "id": "f8a6180a-155c-5e8c-8780-635cc4256ccc-u02",
          "speaker_id": "b",
          "ja": "田中です。田中さんでいいですよ。",
          "vi": "Tôi là Tanaka. Chị gọi tôi là Tanaka được rồi."
        },
        {
          "id": "f8a6180a-155c-5e8c-8780-635cc4256ccc-u03",
          "speaker_id": "a",
          "ja": "田中さんですね。リンと呼んでください。",
          "vi": "Anh Tanaka nhỉ. Cứ gọi tôi là Linh nhé."
        },
        {
          "id": "f8a6180a-155c-5e8c-8780-635cc4256ccc-u04",
          "speaker_id": "b",
          "ja": "はい、リンさん。よろしくお願いします。",
          "vi": "Vâng, chị Linh. Rất vui được làm quen."
        }
      ],
      "admin": {
        "source_refs": [
          "greet",
          "social"
        ],
        "specialty_item_ids": [],
