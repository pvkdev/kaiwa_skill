        {
          "id": "dc278830-e882-5338-acfe-d1d40dd1c84e-u02",
          "speaker_id": "a",
          "ja": "あ、すみません。どうぞ。",
          "vi": "À, xin lỗi anh. Anh đi đi ạ."
