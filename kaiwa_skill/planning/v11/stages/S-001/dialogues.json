    {
      "situation_uid": "3b471076-78a5-5a3b-bfb3-b14f6719e640",
      "event_id": "E01",
      "context_vi": "Bạn bước vào quầy thông tin buổi chiều. Người phụ trách đang nhìn lên; bạn muốn chào rồi hỏi một việc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3b471076-78a5-5a3b-bfb3-b14f6719e640-u01",
          "speaker_id": "a",
          "ja": "こんにちは。ちょっといいですか。",
          "vi": "Chào anh. Tôi hỏi một chút được không ạ?"
        },
        {
          "id": "3b471076-78a5-5a3b-bfb3-b14f6719e640-u02",
          "speaker_id": "b",
          "ja": "こんにちは。はい、どうぞ。",
          "vi": "Chào chị. Vâng, chị cứ hỏi ạ."
        },
        {
          "id": "3b471076-78a5-5a3b-bfb3-b14f6719e640-u03",
          "speaker_id": "a",
          "ja": "このクラスは、ここですか。",
          "vi": "Lớp này ở đây phải không ạ?"
        },
        {
          "id": "3b471076-78a5-5a3b-bfb3-b14f6719e640-u04",
          "speaker_id": "b",
          "ja": "はい、この部屋です。",
          "vi": "Vâng, đúng phòng này ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "greet",
          "social"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3b471076-78a5-5a3b-bfb3-b14f6719e640-u01": {
