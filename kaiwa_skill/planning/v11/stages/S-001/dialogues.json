          "3b471076-78a5-5a3b-bfb3-b14f6719e640-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "092be0ac-225a-55af-9971-20cbc63c544a",
      "event_id": "E01",
      "context_vi": "Ở hành lang lớp học, bạn tưởng người đối diện là người đã gặp hôm qua. Người ấy nói đây là lần đầu gặp bạn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "học viên mới",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "092be0ac-225a-55af-9971-20cbc63c544a-u01",
          "speaker_id": "a",
          "ja": "あ、昨日の……こんにちは。",
          "vi": "À, người hôm qua... Chào anh."
        },
        {
          "id": "092be0ac-225a-55af-9971-20cbc63c544a-u02",
          "speaker_id": "b",
          "ja": "こんにちは。たぶん、初めてですね。",
          "vi": "Chào chị. Chắc đây là lần đầu mình gặp nhau."
        },
        {
          "id": "092be0ac-225a-55af-9971-20cbc63c544a-u03",
          "speaker_id": "a",
          "ja": "あ、すみません。人違いでした。",
          "vi": "À, xin lỗi anh. Tôi nhầm người rồi."
        },
        {
          "id": "092be0ac-225a-55af-9971-20cbc63c544a-u04",
          "speaker_id": "b",
          "ja": "大丈夫ですよ。",
          "vi": "Không sao đâu."
        }
      ],
      "admin": {
        "source_refs": [
          "greet",
          "thanks"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "092be0ac-225a-55af-9971-20cbc63c544a-u01": {
