          "id": "5410f579-b1ae-5eb8-8189-7db750854c87-u01",
          "speaker_id": "b",
          "ja": "あちらの席が空いていますよ。",
          "vi": "Ghế bên kia còn trống đấy."
        },
        {
          "id": "5410f579-b1ae-5eb8-8189-7db750854c87-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。あそこですね。",
          "vi": "Cảm ơn anh. Ghế đằng kia nhỉ."
        },
        {
          "id": "5410f579-b1ae-5eb8-8189-7db750854c87-u03",
          "speaker_id": "b",
          "ja": "はい、どうぞ。",
          "vi": "Ừ, chị cứ ngồi đi."
        }
      ],
