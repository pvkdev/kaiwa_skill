    {
      "situation_uid": "1eb8a7fb-14a5-5d40-b9b2-76dcc653e2f6",
      "event_id": "E02",
      "context_vi": "Sau khi người quen cho biết giờ buổi họp, bạn còn muốn hỏi địa điểm. Anh ấy phải đi ngay, nên bạn hẹn lúc khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1eb8a7fb-14a5-5d40-b9b2-76dcc653e2f6-u01",
          "speaker_id": "b",
          "ja": "すみません、今、急いでいます。",
          "vi": "Xin lỗi chị, giờ tôi đang vội."
        },
        {
          "id": "1eb8a7fb-14a5-5d40-b9b2-76dcc653e2f6-u02",
          "speaker_id": "a",
          "ja": "わかりました。いつならいいですか。",
          "vi": "Tôi hiểu. Khi nào thì tiện cho anh?"
        },
        {
          "id": "1eb8a7fb-14a5-5d40-b9b2-76dcc653e2f6-u03",
          "speaker_id": "b",
          "ja": "五時なら大丈夫です。",
          "vi": "Năm giờ thì được."
        },
        {
          "id": "1eb8a7fb-14a5-5d40-b9b2-76dcc653e2f6-u04",
          "speaker_id": "a",
          "ja": "では、五時にここでお願いします。",
          "vi": "Vậy năm giờ mình gặp ở đây nhé."
        },
        {
          "id": "1eb8a7fb-14a5-5d40-b9b2-76dcc653e2f6-u05",
          "speaker_id": "b",
          "ja": "はい、五時に。",
          "vi": "Ừ, năm giờ."
        }
      ],
      "admin": {
