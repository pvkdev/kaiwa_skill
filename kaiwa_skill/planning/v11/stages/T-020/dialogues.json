    {
      "situation_uid": "12ea14de-b894-5662-b86b-12ba1613e858",
      "event_id": "E05",
      "context_vi": "Bạn cùng Kenta đến quầy quản lý hỏi giải thích chung về hai giờ khác nhau.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "hàng xóm hoặc ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "12ea14de-b894-5662-b86b-12ba1613e858-u01",
          "speaker_id": "a",
          "ja": "私たちに届いた点検のお知らせで、時間が一時と二時に分かれています。どちらが正しいですか。",
          "vi": "Hai tờ thông báo kiểm mà chúng tôi nhận ghi một giờ và hai giờ. Giờ nào đúng ạ?"
        },
        {
          "id": "12ea14de-b894-5662-b86b-12ba1613e858-u02",
          "speaker_id": "b",
          "ja": "確認します。古い案内が一部に残ったかもしれません。",
          "vi": "Tôi sẽ kiểm. Có thể vài nơi còn tờ cũ."
        },
        {
          "id": "12ea14de-b894-5662-b86b-12ba1613e858-u03",
          "speaker_id": "a",
          "ja": "みんなに同じ情報が伝わるよう、掲示も直していただけますか。",
          "vi": "Anh có thể sửa bảng để mọi người nhận cùng thông tin không?"
        },
        {
          "id": "12ea14de-b894-5662-b86b-12ba1613e858-u04",
          "speaker_id": "b",
          "ja": "はい。正しい時間が分かり次第、掲示を更新します。",
          "vi": "Vâng. Khi rõ giờ đúng, chúng tôi sẽ cập nhật bảng."
        }
      ],
      "admin": {
