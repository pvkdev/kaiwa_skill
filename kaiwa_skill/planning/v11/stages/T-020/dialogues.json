    {
      "situation_uid": "a6f21af5-fa57-5c52-988d-29f4790f9c31",
      "event_id": "E04",
      "context_vi": "Tiếp tiếng lúc bảy giờ mười, bạn hỏi quản lý đã chuyển thời gian quan sát cho đơn vị thi công chưa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a6f21af5-fa57-5c52-988d-29f4790f9c31-u01",
          "speaker_id": "a",
          "ja": "今朝七時十分ごろの音について、工事担当の方へ時刻を伝えていただけましたか。",
          "vi": "Về tiếng lúc khoảng bảy giờ mười sáng nay, anh đã báo giờ đó cho bên thi công chưa?"
        },
        {
          "id": "a6f21af5-fa57-5c52-988d-29f4790f9c31-u02",
          "speaker_id": "b",
          "ja": "はい、伝えました。担当は作業記録を確認中です。",
          "vi": "Rồi, tôi đã báo. Bên đó đang kiểm nhật ký làm việc."
        },
        {
          "id": "a6f21af5-fa57-5c52-988d-29f4790f9c31-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。原因が分かったら、掲示か電話で教えてください。",
          "vi": "Cảm ơn anh. Khi rõ nguyên nhân, xin báo qua bảng hoặc điện thoại."
        },
        {
          "id": "a6f21af5-fa57-5c52-988d-29f4790f9c31-u04",
          "speaker_id": "b",
          "ja": "分かりました。確認結果をお伝えします。",
          "vi": "Vâng. Tôi sẽ báo kết quả kiểm."
        }
      ],
