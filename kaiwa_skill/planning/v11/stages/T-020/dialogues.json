    {
      "situation_uid": "fe7d3900-3a5c-5f23-8bdc-8f1a80c0e11b",
      "event_id": "E02",
      "context_vi": "Sakura Heights hẹn người vào phòng kiểm thiết bị. Bạn hỏi đơn vị, việc sẽ làm và cách nhận diện.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "fe7d3900-3a5c-5f23-8bdc-8f1a80c0e11b-u01",
          "speaker_id": "a",
          "ja": "三〇二号室に来る点検の方は、どちらの会社ですか。何を確認しますか。",
          "vi": "Người đến kiểm căn 302 thuộc công ty nào? Họ kiểm gì?"
        },
        {
          "id": "fe7d3900-3a5c-5f23-8bdc-8f1a80c0e11b-u02",
          "speaker_id": "b",
          "ja": "管理室が依頼した設備会社です。換気設備を確認します。",
          "vi": "Là công ty thiết bị do phòng quản lý nhờ đến. Họ kiểm hệ thống thông gió."
        },
        {
          "id": "fe7d3900-3a5c-5f23-8bdc-8f1a80c0e11b-u03",
          "speaker_id": "a",
          "ja": "当日、担当者の名前も事前に教えていただけますか。",
          "vi": "Trước hôm đó anh cho tôi biết tên người phụ trách được không?"
        },
        {
          "id": "fe7d3900-3a5c-5f23-8bdc-8f1a80c0e11b-u04",
          "speaker_id": "b",
          "ja": "確認してご連絡します。",
          "vi": "Tôi sẽ kiểm rồi báo."
        }
      ],
      "admin": {
        "source_refs": [
          "mlit"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "fe7d3900-3a5c-5f23-8bdc-8f1a80c0e11b-u01": {
