    {
      "situation_uid": "31bfa3dd-e368-5270-97f4-e09f36f8ef4a",
      "event_id": "E03",
      "context_vi": "Cửa khu để xe đạp ở Sakura Heights không mở bằng thẻ cư dân. Bạn báo vị trí và thẻ đã thử.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "31bfa3dd-e368-5270-97f4-e09f36f8ef4a-u01",
          "speaker_id": "a",
          "ja": "駐輪場の東側の扉が、私のカードで開きません。今朝からです。",
          "vi": "Cửa phía đông khu để xe đạp không mở bằng thẻ của tôi. Từ sáng nay."
        },
        {
          "id": "31bfa3dd-e368-5270-97f4-e09f36f8ef4a-u02",
          "speaker_id": "b",
          "ja": "ほかの入口は試されましたか。",
          "vi": "Chị đã thử cửa khác chưa?"
        },
        {
          "id": "31bfa3dd-e368-5270-97f4-e09f36f8ef4a-u03",
          "speaker_id": "a",
          "ja": "西側は開きました。東側だけ確認をお願いします。",
          "vi": "Cửa tây mở được. Xin kiểm riêng cửa đông."
        },
        {
          "id": "31bfa3dd-e368-5270-97f4-e09f36f8ef4a-u04",
          "speaker_id": "b",
          "ja": "分かりました。担当に伝えます。",
          "vi": "Tôi hiểu. Tôi sẽ báo người phụ trách."
        }
      ],
