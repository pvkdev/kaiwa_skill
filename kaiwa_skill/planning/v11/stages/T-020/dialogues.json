    {
      "situation_uid": "e119c276-961c-5251-8e36-cdbd1900b19a",
      "event_id": "E05",
      "context_vi": "Bạn hỏi hàng xóm Kenta có nhận cùng thông báo về giờ kiểm thang máy hay không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e119c276-961c-5251-8e36-cdbd1900b19a-u01",
          "speaker_id": "a",
          "ja": "ケンタさんにも、来週のエレベーター点検の案内が届いた？",
          "vi": "Kenta có nhận thông báo kiểm thang máy tuần sau không?"
        },
        {
          "id": "e119c276-961c-5251-8e36-cdbd1900b19a-u02",
          "speaker_id": "b",
          "ja": "うん、ポストに入ってたよ。私は火曜日だと読んだ。",
          "vi": "Có, trong hòm thư. Tớ đọc là thứ Ba."
        },
        {
          "id": "e119c276-961c-5251-8e36-cdbd1900b19a-u03",
          "speaker_id": "a",
          "ja": "私も火曜日と読んだ。時間のところだけ、もう一度一緒に見よう。",
          "vi": "Tớ cũng đọc thứ Ba. Mình xem lại phần giờ cùng nhau nhé."
        },
        {
          "id": "e119c276-961c-5251-8e36-cdbd1900b19a-u04",
          "speaker_id": "b",
          "ja": "いいよ。",
          "vi": "Được chứ."
        }
      ],
      "admin": {
