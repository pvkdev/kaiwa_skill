    {
      "situation_uid": "080a40d7-bf7e-5078-894f-d00ba6bc2ee1",
      "event_id": "E03",
      "context_vi": "Khu để rác cũ vẫn đóng sau thời điểm thông báo. Bạn hỏi quản lý có cập nhật nào, không tự mở cửa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "080a40d7-bf7e-5078-894f-d00ba6bc2ee1-u01",
          "speaker_id": "a",
          "ja": "ごみ置き場は今日から再開と聞いていましたが、まだ閉まっています。予定が変わりましたか。",
          "vi": "Tôi nghe chỗ rác mở lại từ hôm nay, nhưng vẫn đóng. Lịch đổi rồi ạ?"
        },
        {
          "id": "080a40d7-bf7e-5078-894f-d00ba6bc2ee1-u02",
          "speaker_id": "b",
          "ja": "工事が延びました。新しい案内が遅れてすみません。",
          "vi": "Việc sửa kéo dài. Xin lỗi vì thông báo mới bị chậm."
        },
        {
          "id": "080a40d7-bf7e-5078-894f-d00ba6bc2ee1-u03",
          "speaker_id": "a",
          "ja": "今日出すごみはどこに持っていけばいいですか。",
          "vi": "Rác cần mang ra hôm nay thì tôi đưa tới đâu?"
        },
        {
          "id": "080a40d7-bf7e-5078-894f-d00ba6bc2ee1-u04",
          "speaker_id": "b",
          "ja": "仮置き場の利用を確認してご案内します。",
          "vi": "Tôi kiểm việc dùng điểm tạm rồi hướng dẫn."
        }
      ],
