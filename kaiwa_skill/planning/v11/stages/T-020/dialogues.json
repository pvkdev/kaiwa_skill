        }
      }
    },
    {
      "situation_uid": "66e1278f-a824-517b-bd1c-0da2f6317035",
      "event_id": "E01",
      "context_vi": "Tiếp thông báo chỉ một thang, bạn nhắc lại tác động và nơi xem thay đổi mới nhất.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "66e1278f-a824-517b-bd1c-0da2f6317035-u01",
          "speaker_id": "a",
          "ja": "点検の日は一台だけ動き、大きい荷物は管理室に時間と経路を相談するんですね。",
          "vi": "Ngày kiểm chỉ một thang chạy; đồ lớn thì hỏi phòng quản lý về giờ và lối đi, đúng không?"
        },
        {
          "id": "66e1278f-a824-517b-bd1c-0da2f6317035-u02",
          "speaker_id": "b",
          "ja": "はい。変更があれば一階の掲示と入居者向けの連絡でお知らせします。",
          "vi": "Vâng. Nếu có thay đổi, chúng tôi sẽ báo ở bảng tầng một và kênh thông tin cư dân."
        },
        {
          "id": "66e1278f-a824-517b-bd1c-0da2f6317035-u03",
          "speaker_id": "a",
          "ja": "分かりました。配達前にもう一度確認します。",
          "vi": "Tôi hiểu. Trước lúc giao đồ tôi sẽ kiểm lại."
        }
      ],
      "admin": {
        "source_refs": [
          "mlit"
        ],
