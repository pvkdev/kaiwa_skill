    {
      "situation_uid": "cf72192f-246a-5b08-84bb-8ba99e885fb3",
      "event_id": "E04",
      "context_vi": "Có tiếng thi công lúc bảy giờ sáng, ngoài giờ chín đến năm theo thông báo riêng của tòa. Bạn báo giờ quan sát.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "cf72192f-246a-5b08-84bb-8ba99e885fb3-u01",
          "speaker_id": "a",
          "ja": "掲示では九時開始ですが、今朝七時十分ごろに工事のような音がしました。確認していただけますか。",
          "vi": "Bảng ghi bắt đầu chín giờ, nhưng khoảng bảy giờ mười sáng nay tôi nghe tiếng như thi công. Anh kiểm giúp được không?"
        },
        {
          "id": "cf72192f-246a-5b08-84bb-8ba99e885fb3-u02",
          "speaker_id": "b",
          "ja": "時刻をお知らせいただきありがとうございます。どの辺りから聞こえましたか。",
          "vi": "Cảm ơn chị báo giờ. Tiếng từ hướng nào?"
        },
        {
          "id": "cf72192f-246a-5b08-84bb-8ba99e885fb3-u03",
          "speaker_id": "a",
          "ja": "東側の階段付近です。工事の音かは分からないので、確認をお願いします。",
          "vi": "Gần cầu thang phía đông. Tôi không chắc có phải tiếng công trình, xin kiểm giúp."
        },
        {
          "id": "cf72192f-246a-5b08-84bb-8ba99e885fb3-u04",
          "speaker_id": "b",
          "ja": "記録を照らしてご連絡します。",
          "vi": "Tôi sẽ đối chiếu biên bản rồi báo."
        }
      ],
      "admin": {
