    {
      "situation_uid": "4ba7e918-2454-594b-a383-18ccb4654a21",
      "event_id": "E05",
      "context_vi": "Bạn và Kenta thấy hai bản thông báo giờ khác nhau. Bạn đề nghị cùng hỏi quản lý, không tự coi một bản là đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "hàng xóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4ba7e918-2454-594b-a383-18ccb4654a21-u01",
          "speaker_id": "a",
          "ja": "私の紙は午後一時、ケンタさんのは午後二時だね。どちらが新しいか分からない。",
          "vi": "Giấy của tớ ghi một giờ chiều, của Kenta ghi hai giờ. Không biết cái nào mới."
        },
        {
          "id": "4ba7e918-2454-594b-a383-18ccb4654a21-u02",
          "speaker_id": "b",
          "ja": "日付は同じなのにね。管理室に確認しようか。",
          "vi": "Ngày thì giống nhau nhỉ. Mình hỏi phòng quản lý nhé?"
        },
        {
          "id": "4ba7e918-2454-594b-a383-18ccb4654a21-u03",
          "speaker_id": "a",
          "ja": "そうしよう。二枚とも持って行く。",
          "vi": "Ừ. Tớ mang cả hai tờ."
        },
        {
          "id": "4ba7e918-2454-594b-a383-18ccb4654a21-u04",
          "speaker_id": "b",
          "ja": "私も一緒に行くよ。",
          "vi": "Tớ đi cùng."
        }
      ],
      "admin": {
