      }
    },
    {
      "situation_uid": "6b5d127f-1d0e-5612-ada2-fa5cc7298225",
      "event_id": "E01",
      "context_vi": "Thông báo Sakura Heights nói lối ra phía đông đóng một ngày. Bạn hỏi chính xác ngày và lối thay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6b5d127f-1d0e-5612-ada2-fa5cc7298225-u01",
          "speaker_id": "a",
          "ja": "東側の出口が使えないのは何日ですか。",
          "vi": "Ngày nào cửa ra phía đông không dùng được?"
        },
        {
          "id": "6b5d127f-1d0e-5612-ada2-fa5cc7298225-u02",
          "speaker_id": "b",
          "ja": "この建物では、来週火曜日の九時から十七時までです。",
          "vi": "Riêng tòa này, từ chín đến mười bảy giờ thứ Ba tuần sau."
        },
        {
          "id": "6b5d127f-1d0e-5612-ada2-fa5cc7298225-u03",
          "speaker_id": "a",
          "ja": "その間は西側の出口を使えばいいですか。",
          "vi": "Trong lúc đó tôi dùng cửa phía tây được không?"
        },
        {
          "id": "6b5d127f-1d0e-5612-ada2-fa5cc7298225-u04",
          "speaker_id": "b",
          "ja": "はい。案内板も出します。",
          "vi": "Vâng. Chúng tôi cũng sẽ đặt bảng chỉ dẫn."
        }
      ],
      "admin": {
        "source_refs": [
          "mlit"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "6b5d127f-1d0e-5612-ada2-fa5cc7298225-u01": {
            "kind": "original_extension"
