    {
      "situation_uid": "5f8a9bc9-fafd-502e-93b6-83e04e712963",
      "event_id": "E03",
      "context_vi": "Quản lý nói điểm rác tạm phía bắc chỉ mở đến thứ Sáu. Bạn nhắc lại và hỏi sau đó.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5f8a9bc9-fafd-502e-93b6-83e04e712963-u01",
          "speaker_id": "b",
          "ja": "北側の仮置き場は今週金曜日までです。",
          "vi": "Điểm rác tạm phía bắc dùng đến hết thứ Sáu tuần này."
        },
        {
          "id": "5f8a9bc9-fafd-502e-93b6-83e04e712963-u02",
          "speaker_id": "a",
          "ja": "土曜日からは元の場所に戻りますか。それとも連絡を待つべきですか。",
          "vi": "Từ thứ Bảy trở lại chỗ cũ hay nên chờ thông báo?"
        },
        {
          "id": "5f8a9bc9-fafd-502e-93b6-83e04e712963-u03",
          "speaker_id": "b",
          "ja": "修理が終わるか確認して、金曜日に掲示します。",
          "vi": "Chúng tôi sẽ kiểm việc sửa xong chưa rồi dán thông báo vào thứ Sáu."
        },
        {
          "id": "5f8a9bc9-fafd-502e-93b6-83e04e712963-u04",
          "speaker_id": "a",
          "ja": "では、金曜日の掲示を見てから判断します。",
          "vi": "Vậy tôi sẽ xem thông báo thứ Sáu rồi mới quyết."
        }
      ],
