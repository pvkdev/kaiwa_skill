    },
    {
      "situation_uid": "4780fd77-58a9-58e2-9995-e8f019b32d49",
      "event_id": "E02",
      "context_vi": "Bạn không thể ở nhà lúc chín rưỡi như lịch kiểm thông gió. Bạn báo sớm với quản lý.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4780fd77-58a9-58e2-9995-e8f019b32d49-u01",
          "speaker_id": "a",
          "ja": "九時半は仕事で不在です。三〇二号室の点検時間を変更できますか。",
          "vi": "Chín rưỡi tôi đi làm. Có thể đổi giờ kiểm căn 302 không?"
        },
        {
          "id": "4780fd77-58a9-58e2-9995-e8f019b32d49-u02",
          "speaker_id": "b",
          "ja": "担当の予定を確認します。ご都合のよい時間はありますか。",
          "vi": "Tôi sẽ xem lịch người phụ trách. Chị tiện giờ nào?"
        },
        {
          "id": "4780fd77-58a9-58e2-9995-e8f019b32d49-u03",
          "speaker_id": "a",
          "ja": "同じ日の午後か、翌日の午前なら家にいます。",
          "vi": "Chiều cùng ngày hoặc sáng hôm sau tôi có ở nhà."
        },
        {
          "id": "4780fd77-58a9-58e2-9995-e8f019b32d49-u04",
          "speaker_id": "b",
          "ja": "二つの候補を伝えて確認します。",
          "vi": "Tôi sẽ hỏi theo hai lựa chọn đó."
        }
      ],
      "admin": {
        "source_refs": [
          "mlit"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "4780fd77-58a9-58e2-9995-e8f019b32d49-u01": {
