          "b6a0d2e6-79b7-54f9-86b8-9b26087ace9b-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0afc3ad8-ea13-5917-af53-526806be4b0a",
      "event_id": "E01",
      "context_vi": "Trong ngày kiểm thang, Sakura Heights chỉ còn một thang hoạt động. Bạn hỏi lối cho người giao đồ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0afc3ad8-ea13-5917-af53-526806be4b0a-u01",
          "speaker_id": "a",
          "ja": "一台しか動かない日は、大きい荷物の配達はどうしたらいいですか。",
          "vi": "Ngày chỉ một thang hoạt động, người giao đồ lớn nên làm thế nào?"
        },
        {
          "id": "0afc3ad8-ea13-5917-af53-526806be4b0a-u02",
          "speaker_id": "b",
          "ja": "この建物では、その日は搬入の時間を管理室に相談していただきます。",
          "vi": "Riêng tòa này, ngày đó cần hỏi phòng quản lý về giờ chuyển đồ."
        },
        {
          "id": "0afc3ad8-ea13-5917-af53-526806be4b0a-u03",
          "speaker_id": "a",
          "ja": "配達の時間が分かったら、事前に連絡します。",
          "vi": "Biết giờ giao rồi tôi sẽ báo trước."
        },
        {
          "id": "0afc3ad8-ea13-5917-af53-526806be4b0a-u04",
          "speaker_id": "b",
          "ja": "はい。使える経路を確認してご案内します。",
          "vi": "Vâng. Tôi sẽ kiểm lối còn dùng được rồi hướng dẫn."
        }
      ],
      "admin": {
        "source_refs": [
          "mlit"
        ],
        "specialty_item_ids": [],
