    {
      "situation_uid": "89ca37e8-4ffa-53eb-9e32-22aaa209ad37",
      "event_id": "E04",
      "context_vi": "Công trình ở Sakura Heights gây tiếng ồn vào giờ bạn làm việc tại nhà. Bạn nêu giờ quan sát và ảnh hưởng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "89ca37e8-4ffa-53eb-9e32-22aaa209ad37-u01",
          "speaker_id": "a",
          "ja": "昨日と今日、午前十時から正午ごろまで大きな音が続き、在宅の会議に影響しています。",
          "vi": "Hôm qua và hôm nay tiếng ồn lớn kéo dài từ khoảng mười giờ đến trưa, ảnh hưởng cuộc họp tôi làm tại nhà."
        },
        {
          "id": "89ca37e8-4ffa-53eb-9e32-22aaa209ad37-u02",
          "speaker_id": "b",
          "ja": "ご不便をおかけします。工事内容と予定を確認します。",
          "vi": "Xin lỗi vì bất tiện. Tôi sẽ kiểm việc thi công và lịch."
        },
        {
          "id": "89ca37e8-4ffa-53eb-9e32-22aaa209ad37-u03",
          "speaker_id": "a",
          "ja": "特に穴を開けるような音の時間を知りたいです。",
          "vi": "Tôi muốn biết nhất là giờ có tiếng như khoan lỗ."
        },
        {
          "id": "89ca37e8-4ffa-53eb-9e32-22aaa209ad37-u04",
          "speaker_id": "b",
