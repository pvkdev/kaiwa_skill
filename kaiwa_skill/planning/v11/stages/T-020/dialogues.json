    {
      "situation_uid": "2795f270-299c-5830-abf8-31ac42f9c59e",
      "event_id": "E04",
      "context_vi": "Bạn hỏi công trình dự kiến kéo dài đến ngày nào để tự xếp lịch.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2795f270-299c-5830-abf8-31ac42f9c59e-u01",
          "speaker_id": "a",
          "ja": "この工事はいつまで続く予定ですか。",
          "vi": "Công trình này dự kiến kéo dài đến khi nào?"
        },
        {
          "id": "2795f270-299c-5830-abf8-31ac42f9c59e-u02",
          "speaker_id": "b",
          "ja": "現時点の予定では来週水曜日までです。変更の可能性はあります。",
          "vi": "Theo lịch hiện tại là đến thứ Tư tuần sau. Có thể thay đổi."
        },
        {
          "id": "2795f270-299c-5830-abf8-31ac42f9c59e-u03",
          "speaker_id": "a",
          "ja": "分かりました。日ごとの作業時間は掲示で見られますか。",
          "vi": "Tôi hiểu. Có bảng giờ làm từng ngày không?"
        },
        {
          "id": "2795f270-299c-5830-abf8-31ac42f9c59e-u04",
          "speaker_id": "b",
          "ja": "はい。一階の掲示を更新します。",
          "vi": "Có. Chúng tôi sẽ cập nhật bảng ở tầng một."
        }
      ],
      "admin": {
