    {
      "situation_uid": "3c57bbc6-563e-5437-9fe6-b8d6485de08f",
      "event_id": "E03",
      "context_vi": "Tiếp việc khu rác chưa mở lại, quản lý xác nhận điểm tạm phía bắc vẫn dùng được. Bạn cảm ơn và hỏi nơi xem hạn mới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3c57bbc6-563e-5437-9fe6-b8d6485de08f-u01",
          "speaker_id": "b",
          "ja": "北側の仮置き場は、工事が終わるまで引き続き使えます。",
          "vi": "Chỗ tạm phía bắc vẫn dùng được đến khi sửa xong."
        },
        {
          "id": "3c57bbc6-563e-5437-9fe6-b8d6485de08f-u02",
          "speaker_id": "a",
          "ja": "分かりました。今日のごみは北側へ出します。再開日はどこで分かりますか。",
          "vi": "Tôi hiểu. Rác hôm nay tôi đưa phía bắc. Tôi xem ngày mở lại ở đâu?"
        },
        {
          "id": "3c57bbc6-563e-5437-9fe6-b8d6485de08f-u03",
          "speaker_id": "b",
          "ja": "一階の掲示に、決まり次第出します。",
          "vi": "Khi chốt, chúng tôi sẽ dán ở tầng một."
        },
        {
          "id": "3c57bbc6-563e-5437-9fe6-b8d6485de08f-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。掲示を確認します。",
          "vi": "Cảm ơn anh. Tôi sẽ xem bảng."
        }
      ],
