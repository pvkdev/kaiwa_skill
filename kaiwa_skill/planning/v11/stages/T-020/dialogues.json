    {
      "situation_uid": "dd3257cb-7d9d-5ed1-b7e4-6878e21c0627",
      "event_id": "E03",
      "context_vi": "Khu để rác thường của Sakura Heights đóng để sửa. Bạn hỏi quản lý chỗ tạm thời của chính tòa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "dd3257cb-7d9d-5ed1-b7e4-6878e21c0627-u01",
          "speaker_id": "a",
          "ja": "いつものごみ置き場が閉まっています。今週はどこに出せばいいですか。",
          "vi": "Chỗ để rác thường đang đóng. Tuần này tôi mang rác ra đâu?"
        },
        {
          "id": "dd3257cb-7d9d-5ed1-b7e4-6878e21c0627-u02",
          "speaker_id": "b",
          "ja": "この建物では、北側の仮置き場を使ってください。案内板があります。",
          "vi": "Riêng tòa này, xin dùng chỗ tạm phía bắc. Có bảng chỉ dẫn."
        },
        {
          "id": "dd3257cb-7d9d-5ed1-b7e4-6878e21c0627-u03",
          "speaker_id": "a",
          "ja": "分かりました。出せる時間も掲示で確認します。",
          "vi": "Tôi hiểu. Tôi sẽ xem giờ được đặt trên thông báo."
        },
        {
          "id": "dd3257cb-7d9d-5ed1-b7e4-6878e21c0627-u04",
          "speaker_id": "b",
          "ja": "はい。分かりにくければ管理室へどうぞ。",
          "vi": "Vâng. Nếu khó tìm, xin hỏi phòng quản lý."
        }
      ],
