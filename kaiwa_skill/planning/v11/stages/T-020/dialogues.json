    {
      "situation_uid": "0d2f2a20-bbe8-5bbc-ba0e-2ae483429c2d",
      "event_id": "E02",
      "context_vi": "Tiếp lời hẹn trả lời lúc bốn giờ, bạn gọi xác nhận giờ kiểm mới và tên người sẽ tới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0d2f2a20-bbe8-5bbc-ba0e-2ae483429c2d-u01",
          "speaker_id": "a",
          "ja": "三〇二号室の点検時間の件です。午後に変更できましたか。担当者のお名前も確認したいです。",
          "vi": "Về giờ kiểm căn 302: đã đổi sang chiều được chưa? Tôi cũng muốn xác nhận tên người đến."
        },
        {
          "id": "0d2f2a20-bbe8-5bbc-ba0e-2ae483429c2d-u02",
          "speaker_id": "b",
          "ja": "午後二時に変更できました。担当は佐藤です。",
          "vi": "Đã đổi sang hai giờ chiều. Người phụ trách là Sato."
        },
        {
          "id": "0d2f2a20-bbe8-5bbc-ba0e-2ae483429c2d-u03",
          "speaker_id": "a",
          "ja": "二時に私が部屋にいます。換気設備の点検ですね。",
          "vi": "Hai giờ tôi sẽ ở căn hộ. Là kiểm hệ thống thông gió nhé."
        },
        {
          "id": "0d2f2a20-bbe8-5bbc-ba0e-2ae483429c2d-u04",
          "speaker_id": "b",
          "ja": "はい。その内容で確定しています。",
          "vi": "Vâng. Đã chốt theo đó."
        }
      ],
      "admin": {
