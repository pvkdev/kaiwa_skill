    {
      "situation_uid": "6b4c692f-dd0f-55d8-ab06-6bf192b724fb",
      "event_id": "E05",
      "context_vi": "Tiếp cuộc hỏi chung ở quầy, bạn và nhân viên quản lý thống nhất ai sẽ báo lại nhóm cư dân sau khi chốt giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "hàng xóm hoặc ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6b4c692f-dd0f-55d8-ab06-6bf192b724fb-u01",
          "speaker_id": "a",
          "ja": "時間が確定したら、管理室から掲示と連絡をお願いします。私は三階の方に掲示を見るよう伝えます。",
          "vi": "Khi chốt giờ, xin phòng quản lý dán bảng và báo cư dân. Tôi sẽ nhắc người tầng ba xem bảng."
        },
        {
          "id": "6b4c692f-dd0f-55d8-ab06-6bf192b724fb-u02",
          "speaker_id": "b",
          "ja": "分かりました。こちらが正式な時刻を掲示します。個別の質問も受けます。",
          "vi": "Tôi hiểu. Bên tôi sẽ dán giờ chính thức và trả lời câu hỏi riêng."
        },
        {
          "id": "6b4c692f-dd0f-55d8-ab06-6bf192b724fb-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。私から時刻を推測して伝えないようにします。",
          "vi": "Cảm ơn anh. Tôi sẽ không tự đoán giờ rồi báo mọi người."
        }
      ],
