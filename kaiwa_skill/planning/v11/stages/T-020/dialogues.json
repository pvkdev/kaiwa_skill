  "dialogues": [
    {
      "situation_uid": "774487f7-1222-5884-979d-3817e590f688",
      "event_id": "E01",
      "context_vi": "Tòa Sakura Heights dán thông báo kiểm tra thiết bị. Bạn hỏi quản lý việc kiểm áp dụng cho căn mình hay cả tầng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "774487f7-1222-5884-979d-3817e590f688-u01",
          "speaker_id": "a",
          "ja": "掲示に設備点検とありますが、私の三〇二号室も対象ですか。それとも三階の共用部だけですか。",
          "vi": "Thông báo ghi kiểm thiết bị. Căn 302 của tôi cũng thuộc diện kiểm hay chỉ khu chung tầng ba?"
        },
        {
          "id": "774487f7-1222-5884-979d-3817e590f688-u02",
          "speaker_id": "b",
          "ja": "今回は三階の各住戸と廊下が対象です。",
          "vi": "Lần này gồm từng căn ở tầng ba và hành lang."
        },
        {
          "id": "774487f7-1222-5884-979d-3817e590f688-u03",
          "speaker_id": "a",
          "ja": "では、部屋の中にも入る予定ですね。時間を確認します。",
          "vi": "Vậy có dự định vào trong căn. Tôi sẽ xem giờ."
        },
        {
          "id": "774487f7-1222-5884-979d-3817e590f688-u04",
          "speaker_id": "b",
          "ja": "はい。個別の時間は別紙に載せています。",
          "vi": "Vâng. Giờ từng căn ghi ở tờ khác."
        }
      ],
      "admin": {
        "source_refs": [
          "b26",
          "mlit"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "774487f7-1222-5884-979d-3817e590f688-u01": {
