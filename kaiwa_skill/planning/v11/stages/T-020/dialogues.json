    {
      "situation_uid": "d169cf96-f122-57bf-b90d-d66a8b25b3a0",
      "event_id": "E02",
      "context_vi": "Bạn hỏi quản lý có giờ khác hoặc người đại diện được tòa chấp nhận, chưa trao quyền vào nhà.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d169cf96-f122-57bf-b90d-d66a8b25b3a0-u01",
          "speaker_id": "a",
          "ja": "別の時間が難しければ、代理の人が立ち会う方法は、この建物で認められていますか。",
          "vi": "Nếu khó đổi giờ, tòa này có cho người đại diện có mặt giúp không?"
        },
        {
          "id": "d169cf96-f122-57bf-b90d-d66a8b25b3a0-u02",
          "speaker_id": "b",
          "ja": "建物の手続きを確認します。代理人の条件も調べます。",
          "vi": "Tôi sẽ kiểm thủ tục tòa và điều kiện người đại diện."
        },
        {
          "id": "d169cf96-f122-57bf-b90d-d66a8b25b3a0-u03",
          "speaker_id": "a",
          "ja": "条件を聞いてから誰に頼むか決めます。勝手に入室はしないでください。",
          "vi": "Tôi sẽ nghe điều kiện rồi mới chọn người nhờ. Xin đừng tự vào phòng."
        },
        {
          "id": "d169cf96-f122-57bf-b90d-d66a8b25b3a0-u04",
          "speaker_id": "b",
