    {
      "situation_uid": "2d850964-c496-5d26-adc9-ae1db2e1daae",
      "event_id": "E02",
      "context_vi": "Quản lý phải hỏi kỹ thuật viên về giờ kiểm thay thế. Bạn xin mốc trả lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2d850964-c496-5d26-adc9-ae1db2e1daae-u01",
          "speaker_id": "b",
          "ja": "午後に変更できるか、点検担当に聞いています。",
          "vi": "Tôi đang hỏi người kiểm liệu đổi sang chiều được không."
        },
        {
          "id": "2d850964-c496-5d26-adc9-ae1db2e1daae-u02",
          "speaker_id": "a",
          "ja": "返事はいつごろ分かりますか。仕事の調整が必要です。",
          "vi": "Khoảng khi nào có trả lời? Tôi cần xếp lại việc."
        },
        {
          "id": "2d850964-c496-5d26-adc9-ae1db2e1daae-u03",
          "speaker_id": "b",
          "ja": "今日の四時までにご連絡します。",
          "vi": "Tôi sẽ báo trước bốn giờ chiều nay."
        },
        {
          "id": "2d850964-c496-5d26-adc9-ae1db2e1daae-u04",
          "speaker_id": "a",
          "ja": "分かりました。四時まで待ちます。",
          "vi": "Tôi hiểu. Tôi chờ đến bốn giờ."
        }
      ],
      "admin": {
