    {
      "situation_uid": "09452577-3d92-59da-a26e-69ef6b94ecc9",
      "event_id": "E04",
      "context_vi": "Quản lý chưa thể đổi giờ thi công theo đề nghị của bạn. Bạn hỏi cách nhận cập nhật và khung tiếng ồn dự kiến.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "09452577-3d92-59da-a26e-69ef6b94ecc9-u01",
          "speaker_id": "b",
          "ja": "作業時間をすぐに変えることは難しいです。",
          "vi": "Hiện khó đổi giờ làm ngay."
        },
        {
          "id": "09452577-3d92-59da-a26e-69ef6b94ecc9-u02",
          "speaker_id": "a",
          "ja": "分かりました。大きな音が出る作業だけでも、前日に分かるようにできますか。",
          "vi": "Tôi hiểu. Ít nhất có thể báo trước một ngày phần việc gây tiếng lớn không?"
        },
        {
          "id": "09452577-3d92-59da-a26e-69ef6b94ecc9-u03",
          "speaker_id": "b",
          "ja": "担当に確認し、可能な範囲を掲示します。",
          "vi": "Tôi sẽ hỏi bên thi công và dán thông tin trong mức có thể."
        },
        {
          "id": "09452577-3d92-59da-a26e-69ef6b94ecc9-u04",
          "speaker_id": "a",
          "ja": "掲示を見て会議の時間を調整します。",
          "vi": "Tôi sẽ xem bảng rồi xếp giờ họp."
        }
      ],
      "admin": {
