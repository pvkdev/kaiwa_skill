            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "b6a0d2e6-79b7-54f9-86b8-9b26087ace9b",
      "event_id": "E01",
      "context_vi": "Bạn đọc nhầm thông báo kiểm tra từ chín đến mười một là bắt đầu lúc mười một. Bạn nhờ nói lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ban quản lý",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b6a0d2e6-79b7-54f9-86b8-9b26087ace9b-u01",
          "speaker_id": "a",
          "ja": "点検は十一時からでしたか。仕事の予定を合わせたいんです。",
          "vi": "Buổi kiểm bắt đầu lúc mười một phải không? Tôi cần sắp lịch làm."
        },
        {
          "id": "b6a0d2e6-79b7-54f9-86b8-9b26087ace9b-u02",
          "speaker_id": "b",
          "ja": "いいえ、九時開始で、十一時終了の予定です。",
          "vi": "Không, dự kiến bắt đầu chín giờ và kết thúc mười một giờ."
        },
        {
          "id": "b6a0d2e6-79b7-54f9-86b8-9b26087ace9b-u03",
          "speaker_id": "a",
          "ja": "失礼しました。九時から十一時ですね。私の部屋の順番は分かりますか。",
          "vi": "Xin lỗi, từ chín đến mười một nhỉ. Anh biết lượt căn tôi lúc nào không?"
        },
        {
          "id": "b6a0d2e6-79b7-54f9-86b8-9b26087ace9b-u04",
          "speaker_id": "b",
          "ja": "三〇二号室は九時半ごろの予定です。",
          "vi": "Căn 302 dự kiến khoảng chín rưỡi."
        }
      ],
      "admin": {
        "source_refs": [
          "b26"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b6a0d2e6-79b7-54f9-86b8-9b26087ace9b-u01": {
