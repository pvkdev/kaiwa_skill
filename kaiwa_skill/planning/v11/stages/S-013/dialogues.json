            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "428bc415-cb9e-5e83-8cf1-23db5a56b72d",
      "event_id": "E01",
      "context_vi": "Trong cửa hàng, bạn ngồi thử xe nhưng yên cao quá. Bạn nói rõ để nhân viên chỉnh trước khi quyết định.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "428bc415-cb9e-5e83-8cf1-23db5a56b72d-u01",
          "speaker_id": "a",
          "ja": "サドルが少し高いです。低くできますか。",
          "vi": "Yên hơi cao. Hạ xuống được không ạ?"
        },
        {
          "id": "428bc415-cb9e-5e83-8cf1-23db5a56b72d-u02",
          "speaker_id": "b",
          "ja": "はい、下げます。これでどうですか。",
          "vi": "Được, tôi hạ xuống. Giờ thế nào ạ?"
        },
        {
          "id": "428bc415-cb9e-5e83-8cf1-23db5a56b72d-u03",
          "speaker_id": "a",
          "ja": "これなら足が届きます。",
          "vi": "Giờ chân tôi chạm đất được rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "shop"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "428bc415-cb9e-5e83-8cf1-23db5a56b72d-u01": {
