    {
      "situation_uid": "c941500f-ca38-59c1-8ac6-ce19c6184041",
      "event_id": "E02",
      "context_vi": "Nhân viên bãi Aoba giả định kiểm và nói xe đen của bạn đã được nhân viên chuyển từ dãy A sang dãy B vì dãy A tạm dọn. Bạn hỏi lại lý do.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c941500f-ca38-59c1-8ac6-ce19c6184041-u01",
          "speaker_id": "b",
          "ja": "Aの列を片づけるため、職員がBの列に移しました。",
          "vi": "Vì dãy A cần dọn, nhân viên đã chuyển xe sang dãy B."
        },
        {
          "id": "c941500f-ca38-59c1-8ac6-ce19c6184041-u02",
          "speaker_id": "a",
          "ja": "盗まれたのではなく、ここで移したんですね。",
          "vi": "Vậy không phải bị lấy trộm, mà bãi chuyển xe nhỉ?"
        },
        {
          "id": "c941500f-ca38-59c1-8ac6-ce19c6184041-u03",
          "speaker_id": "b",
          "ja": "はい。Bの列を一緒に見ましょう。",
          "vi": "Đúng. Mình cùng xem dãy B nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "missing",
          "w_park"
        ],
