    {
      "situation_uid": "7abb179b-dad8-557a-a4b8-c3e1076d9fcb",
      "event_id": "E04",
      "context_vi": "Sau thứ Hai đổi chỗ gửi vì dãy B sửa, bạn đến bãi Aoba giả định và kiểm với nhân viên rằng xe đang ở đúng dãy C.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7abb179b-dad8-557a-a4b8-c3e1076d9fcb-u01",
          "speaker_id": "a",
          "ja": "月曜日からCの列ですね。この黒い自転車はここでいいですか。",
          "vi": "Từ thứ Hai là dãy C nhỉ. Xe đen của tôi để đây được chứ ạ?"
        },
        {
          "id": "7abb179b-dad8-557a-a4b8-c3e1076d9fcb-u02",
          "speaker_id": "b",
          "ja": "はい、Cの列です。ここで大丈夫です。",
          "vi": "Đúng, dãy C. Để đây được."
        },
        {
          "id": "7abb179b-dad8-557a-a4b8-c3e1076d9fcb-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "w_park"
        ],
