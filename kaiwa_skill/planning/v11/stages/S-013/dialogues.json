    {
      "situation_uid": "8d35072d-47a3-59ed-8fa9-cda6728ca326",
      "event_id": "E05",
      "context_vi": "Bạn vừa thử xe sau khi tiệm sửa phanh, nhưng phanh vẫn phát tiếng lạ. Bạn quay vào tiệm và chưa tiếp tục đi xe.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8d35072d-47a3-59ed-8fa9-cda6728ca326-u01",
          "speaker_id": "a",
          "ja": "少し走ってみました。ブレーキからまだ音がします。",
          "vi": "Tôi vừa thử đi một chút. Phanh vẫn phát tiếng lạ."
        },
        {
          "id": "8d35072d-47a3-59ed-8fa9-cda6728ca326-u02",
          "speaker_id": "b",
          "ja": "もう一度見ます。自転車をこちらに置いてください。",
          "vi": "Để tôi kiểm lại. Chị để xe ở đây nhé."
        },
        {
          "id": "8d35072d-47a3-59ed-8fa9-cda6728ca326-u03",
          "speaker_id": "a",
          "ja": "はい。まだ乗らないで待ちます。",
          "vi": "Vâng. Tôi đợi, chưa đi xe tiếp."
        }
      ],
      "admin": {
