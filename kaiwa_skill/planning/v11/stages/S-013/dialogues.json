          },
          "3284ec51-42df-51c2-97a6-2e8c510148c9-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "18dc4c23-5ef0-5251-a1de-780d66059885",
      "event_id": "E02",
      "context_vi": "Trong bãi Aoba giả định, bạn đi xe đạp thường, không phải xe máy. Bạn hỏi nhân viên khu nào phù hợp trước khi để xe.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "18dc4c23-5ef0-5251-a1de-780d66059885-u01",
          "speaker_id": "a",
          "ja": "普通の自転車は、どちらに置きますか。",
          "vi": "Xe đạp thường để phía nào ạ?"
        },
        {
          "id": "18dc4c23-5ef0-5251-a1de-780d66059885-u02",
          "speaker_id": "b",
          "ja": "こちらのAの列です。",
          "vi": "Ở dãy A bên này."
        },
        {
          "id": "18dc4c23-5ef0-5251-a1de-780d66059885-u03",
          "speaker_id": "a",
          "ja": "Aの列ですね。",
          "vi": "Dãy A nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "w_park"
        ],
        "specialty_item_ids": [
          "sj-so-03-b18-13"
        ],
        "turn_origins": {
          "18dc4c23-5ef0-5251-a1de-780d66059885-u01": {
            "kind": "original_extension"
          },
          "18dc4c23-5ef0-5251-a1de-780d66059885-u02": {
            "kind": "original_extension"
          },
          "18dc4c23-5ef0-5251-a1de-780d66059885-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "23e1ab03-9c52-5214-862e-bc9dba8d175d",
      "event_id": "E02",
      "context_vi": "Bạn quay lại dãy A của bãi Aoba giả định nhưng không thấy xe ở chỗ đã để. Bạn nhờ nhân viên kiểm trước khi kết luận xe mất.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "23e1ab03-9c52-5214-862e-bc9dba8d175d-u01",
          "speaker_id": "a",
          "ja": "Aの列に置いた自転車が見つかりません。確認してもらえますか。",
          "vi": "Tôi không thấy xe đã để ở dãy A. Anh kiểm giúp được không ạ?"
        },
        {
          "id": "23e1ab03-9c52-5214-862e-bc9dba8d175d-u02",
          "speaker_id": "b",
          "ja": "はい。色と鍵の形を教えてください。",
          "vi": "Được. Chị cho biết màu xe và kiểu khóa nhé."
        },
        {
          "id": "23e1ab03-9c52-5214-862e-bc9dba8d175d-u03",
          "speaker_id": "a",
          "ja": "黒い自転車で、後ろに鍵があります。",
          "vi": "Xe màu đen, khóa ở phía sau."
        }
      ],
      "admin": {
        "source_refs": [
          "missing",
          "w_park"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "23e1ab03-9c52-5214-862e-bc9dba8d175d-u01": {
