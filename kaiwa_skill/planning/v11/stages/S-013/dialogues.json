    {
      "situation_uid": "6b3d0bb1-14d3-5adb-ad45-3436d0affc1d",
      "event_id": "E03",
      "context_vi": "Thợ kiểm lốp và nói thiếu loại ruột xe phù hợp hôm nay. Bạn hỏi có cách sửa tạm an toàn hay cần quay lại sau.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6b3d0bb1-14d3-5adb-ad45-3436d0affc1d-u01",
          "speaker_id": "b",
          "ja": "合うチューブが今日はありません。",
          "vi": "Hôm nay tiệm không có loại ruột phù hợp."
        },
        {
          "id": "6b3d0bb1-14d3-5adb-ad45-3436d0affc1d-u02",
          "speaker_id": "a",
          "ja": "今、直せますか。それとも、また来たほうがいいですか。",
          "vi": "Giờ có sửa được không, hay tôi nên quay lại ạ?"
        },
        {
          "id": "6b3d0bb1-14d3-5adb-ad45-3436d0affc1d-u03",
          "speaker_id": "b",
          "ja": "今日は直せません。明日、入るか確認します。",
          "vi": "Hôm nay chưa sửa được. Mai tôi kiểm xem hàng có về không."
        },
        {
          "id": "6b3d0bb1-14d3-5adb-ad45-3436d0affc1d-u04",
          "speaker_id": "a",
          "ja": "わかりました。自転車は押して帰ります。",
          "vi": "Tôi hiểu. Tôi sẽ dắt xe về."
        }
      ],
      "admin": {
