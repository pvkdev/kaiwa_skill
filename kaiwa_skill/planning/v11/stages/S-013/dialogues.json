    {
      "situation_uid": "5c54a2a0-cb2b-5179-be73-548557fcbf12",
      "event_id": "E04",
      "context_vi": "Bạn có chỗ gửi xe theo tháng ở bãi Aoba giả định nhưng sẽ vắng một tuần. Bạn hỏi nhân viên liệu giữ chỗ hay ngừng cần báo trước ra sao, không tự đoán hoàn phí.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5c54a2a0-cb2b-5179-be73-548557fcbf12-u01",
          "speaker_id": "a",
          "ja": "来週、一週間使いません。場所はそのままでいいですか。",
          "vi": "Tuần sau tôi không dùng một tuần. Chỗ gửi giữ nguyên được không ạ?"
        },
        {
          "id": "5c54a2a0-cb2b-5179-be73-548557fcbf12-u02",
          "speaker_id": "b",
          "ja": "この契約では、今月の場所はそのままです。",
          "vi": "Theo lượt đăng ký này, chỗ của chị giữ nguyên hết tháng này."
        },
        {
          "id": "5c54a2a0-cb2b-5179-be73-548557fcbf12-u03",
          "speaker_id": "a",
          "ja": "来月やめるときは、いつ言いますか。",
          "vi": "Nếu tháng sau tôi ngừng thì báo khi nào ạ?"
        },
        {
          "id": "5c54a2a0-cb2b-5179-be73-548557fcbf12-u04",
          "speaker_id": "b",
          "ja": "期限を確認して、ご案内します。",
          "vi": "Tôi sẽ kiểm hạn rồi hướng dẫn chị."
        }
      ],
