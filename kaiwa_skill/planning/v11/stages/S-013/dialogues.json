    {
      "situation_uid": "8a617379-bcb4-5dc0-9db8-410748d4fa62",
      "event_id": "E04",
      "context_vi": "Bạn muốn gửi xe theo tháng ở bãi Aoba giả định gần ga. Bạn hỏi dãy nào gần lối vào mình dùng buổi sáng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8a617379-bcb4-5dc0-9db8-410748d4fa62-u01",
          "speaker_id": "a",
          "ja": "月ぎめで置けますか。朝は北の入口を使います。",
          "vi": "Tôi gửi theo tháng được không ạ? Buổi sáng tôi dùng lối vào phía bắc."
        },
        {
          "id": "8a617379-bcb4-5dc0-9db8-410748d4fa62-u02",
          "speaker_id": "b",
          "ja": "月ぎめならBの列が北の入口に近いです。",
          "vi": "Nếu gửi theo tháng, dãy B gần lối bắc."
        },
        {
          "id": "8a617379-bcb4-5dc0-9db8-410748d4fa62-u03",
          "speaker_id": "a",
          "ja": "Bの列ですね。空きも見てもらえますか。",
          "vi": "Dãy B nhỉ. Anh kiểm còn chỗ giúp tôi nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "w_park"
        ],
