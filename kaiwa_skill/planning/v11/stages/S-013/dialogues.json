    {
      "situation_uid": "1e777468-c79b-5f45-9fbb-3355156e6f11",
      "event_id": "E05",
      "context_vi": "Tiệm cần một ngày để kiểm phanh chiếc xe cũ. Bạn hỏi có thể để xe lại và khi nào lấy, chưa đồng ý khoản phí chưa báo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1e777468-c79b-5f45-9fbb-3355156e6f11-u01",
          "speaker_id": "b",
          "ja": "確認に一日かかります。",
          "vi": "Cần một ngày để kiểm."
        },
        {
          "id": "1e777468-c79b-5f45-9fbb-3355156e6f11-u02",
          "speaker_id": "a",
          "ja": "ここに置いてもいいですか。明日、何時に来ればいいですか。",
          "vi": "Tôi để xe ở đây được không? Mai tôi đến lúc mấy giờ?"
        },
        {
          "id": "1e777468-c79b-5f45-9fbb-3355156e6f11-u03",
          "speaker_id": "b",
          "ja": "はい。明日の午後三時に来てください。料金もその時にお伝えします。",
          "vi": "Được. Chị đến ba giờ chiều mai. Khi đó tôi cũng báo phí."
        },
        {
          "id": "1e777468-c79b-5f45-9fbb-3355156e6f11-u04",
          "speaker_id": "a",
          "ja": "わかりました。まず、確認をお願いします。",
          "vi": "Tôi rõ rồi. Trước mắt nhờ anh kiểm xe."
        }
      ],
