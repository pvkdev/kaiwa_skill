    {
      "situation_uid": "5e8235d6-2dd4-50ef-8e00-776a48de5819",
      "event_id": "E03",
      "context_vi": "Bạn mất chìa khóa xe đạp và dắt xe đến cửa hàng nơi mua. Bạn hỏi cần gì để cửa hàng xác minh đó là xe của mình trước khi xử lý khóa.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5e8235d6-2dd4-50ef-8e00-776a48de5819-u01",
          "speaker_id": "a",
          "ja": "自転車の鍵をなくしました。私の自転車だと、どうやって確認しますか。",
          "vi": "Tôi mất chìa xe. Anh kiểm đây là xe của tôi bằng cách nào ạ?"
        },
        {
          "id": "5e8235d6-2dd4-50ef-8e00-776a48de5819-u02",
          "speaker_id": "b",
          "ja": "防犯登録の控えはありますか。",
          "vi": "Chị có giấy lưu đăng ký xe không?"
        },
        {
          "id": "5e8235d6-2dd4-50ef-8e00-776a48de5819-u03",
          "speaker_id": "a",
          "ja": "家にあります。持って来ます。",
          "vi": "Có ở nhà. Tôi sẽ mang đến."
        }
      ],
