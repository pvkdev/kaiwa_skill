    {
      "situation_uid": "ef51456a-372b-5de2-9de0-291c8cb867e0",
      "event_id": "E05",
      "context_vi": "Bạn mang xe cũ đến tiệm vì phanh vẫn kêu. Thợ tưởng bạn muốn mua xe khác; bạn nói rõ chỉ cần kiểm lại chiếc xe này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ef51456a-372b-5de2-9de0-291c8cb867e0-u01",
          "speaker_id": "b",
          "ja": "新しい自転車をお探しですか。",
          "vi": "Chị đang tìm xe mới ạ?"
        },
        {
          "id": "ef51456a-372b-5de2-9de0-291c8cb867e0-u02",
          "speaker_id": "a",
          "ja": "いいえ、この自転車のブレーキをもう一度見てください。",
          "vi": "Không, anh kiểm lại phanh của chiếc xe này giúp tôi."
        },
        {
          "id": "ef51456a-372b-5de2-9de0-291c8cb867e0-u03",
          "speaker_id": "b",
          "ja": "わかりました。こちらで見ます。",
          "vi": "Tôi hiểu. Tôi kiểm chiếc này."
        }
      ],
      "admin": {
        "source_refs": [
          "repair"
        ],
        "specialty_item_ids": [],
