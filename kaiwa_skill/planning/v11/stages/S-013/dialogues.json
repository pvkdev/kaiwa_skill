    {
      "situation_uid": "25a23798-8571-5f2a-9f67-f4a20d26718b",
      "event_id": "E03",
      "context_vi": "Lốp xe bạn xẹp giữa đường. Bạn dắt xe vào một tiệm sửa gần đó và hỏi có thể sửa trong hôm nay không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "25a23798-8571-5f2a-9f67-f4a20d26718b-u01",
          "speaker_id": "a",
          "ja": "タイヤの空気が抜けました。今日、直せますか。",
          "vi": "Lốp xe tôi xẹp. Hôm nay sửa được không ạ?"
        },
        {
          "id": "25a23798-8571-5f2a-9f67-f4a20d26718b-u02",
          "speaker_id": "b",
          "ja": "まず見ますね。少し待ってください。",
          "vi": "Để tôi xem trước. Chị chờ một chút nhé."
        },
        {
          "id": "25a23798-8571-5f2a-9f67-f4a20d26718b-u03",
          "speaker_id": "a",
          "ja": "はい。ここで待ちます。",
          "vi": "Vâng, tôi đợi ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "repair"
        ],
        "specialty_item_ids": [],
