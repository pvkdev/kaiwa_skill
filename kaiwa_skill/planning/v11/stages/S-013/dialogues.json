    {
      "situation_uid": "8db7c9a5-9ae0-5521-9f14-d261cd1d4a39",
      "event_id": "E02",
      "context_vi": "Sau khi nhân viên dẫn bạn đến dãy B và bạn tìm lại xe đen, bạn hỏi chỗ đúng để lần sau không lặp việc tìm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8db7c9a5-9ae0-5521-9f14-d261cd1d4a39-u01",
          "speaker_id": "a",
          "ja": "ありました。次から、どこに置きますか。",
          "vi": "Tôi thấy xe rồi. Lần sau để ở đâu ạ?"
        },
        {
          "id": "8db7c9a5-9ae0-5521-9f14-d261cd1d4a39-u02",
          "speaker_id": "b",
          "ja": "今日はBの列です。明日は入口で表示を見てください。",
          "vi": "Hôm nay là dãy B. Ngày mai chị xem bảng ở lối vào nhé."
        },
        {
          "id": "8db7c9a5-9ae0-5521-9f14-d261cd1d4a39-u03",
          "speaker_id": "a",
          "ja": "わかりました。ありがとうございます。",
          "vi": "Tôi rõ rồi. Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "w_park"
        ],
