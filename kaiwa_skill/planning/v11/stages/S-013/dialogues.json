            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3e7aed4e-35ff-5649-813c-b58cf99884c3",
      "event_id": "E01",
      "context_vi": "Bạn muốn dùng xe để đi làm và mang túi nhỏ. Tại cửa hàng Tokyo, bạn hỏi có thể lắp giỏ và khóa không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3e7aed4e-35ff-5649-813c-b58cf99884c3-u01",
          "speaker_id": "a",
          "ja": "かばんを入れるかごと鍵がほしいです。ありますか。",
          "vi": "Tôi muốn giỏ để túi và khóa. Có không ạ?"
        },
        {
          "id": "3e7aed4e-35ff-5649-813c-b58cf99884c3-u02",
          "speaker_id": "b",
          "ja": "はい。こちらのかごと鍵を付けられます。",
          "vi": "Có. Lắp giỏ và khóa này được."
        },
        {
          "id": "3e7aed4e-35ff-5649-813c-b58cf99884c3-u03",
          "speaker_id": "a",
          "ja": "値段も教えてください。",
          "vi": "Anh cho tôi biết cả giá nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "shop"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3e7aed4e-35ff-5649-813c-b58cf99884c3-u01": {
            "kind": "original_extension"
          },
          "3e7aed4e-35ff-5649-813c-b58cf99884c3-u02": {
            "kind": "original_extension"
          },
          "3e7aed4e-35ff-5649-813c-b58cf99884c3-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "01640fc4-ffd4-521c-9027-3ebed2cd770b",
      "event_id": "E01",
      "context_vi": "Bạn chọn được cỡ xe nhưng màu xanh đã hết. Nhân viên nói chưa chắc ngày có lại và gợi màu đen đang sẵn. Bạn cần chọn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "01640fc4-ffd4-521c-9027-3ebed2cd770b-u01",
          "speaker_id": "a",
          "ja": "青はいつ入りますか。",
          "vi": "Khi nào có lại màu xanh ạ?"
        },
        {
          "id": "01640fc4-ffd4-521c-9027-3ebed2cd770b-u02",
          "speaker_id": "b",
          "ja": "まだわかりません。黒なら今日あります。",
          "vi": "Chưa rõ ạ. Màu đen thì hôm nay có."
        },
        {
          "id": "01640fc4-ffd4-521c-9027-3ebed2cd770b-u03",
          "speaker_id": "a",
          "ja": "では、黒を見せてください。",
          "vi": "Vậy cho tôi xem xe màu đen."
        }
      ],
      "admin": {
        "source_refs": [
          "shop"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "01640fc4-ffd4-521c-9027-3ebed2cd770b-u01": {
            "kind": "original_extension"
          },
          "01640fc4-ffd4-521c-9027-3ebed2cd770b-u02": {
            "kind": "original_extension"
          },
          "01640fc4-ffd4-521c-9027-3ebed2cd770b-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "be9cabc5-9580-5d6b-885f-505a94e86ee4",
      "event_id": "E01",
      "context_vi": "Sau khi màu xanh hết và bạn chọn xem màu đen, nhân viên báo chiếc đen trong bài giá 25.000 yên, có khóa; giỏ tính riêng. Bạn xác nhận trước khi trả.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "be9cabc5-9580-5d6b-885f-505a94e86ee4-u01",
          "speaker_id": "a",
          "ja": "黒い自転車は二万五千円、鍵も入っていますね。",
          "vi": "Xe màu đen 25.000 yên, có khóa rồi nhỉ?"
        },
        {
          "id": "be9cabc5-9580-5d6b-885f-505a94e86ee4-u02",
          "speaker_id": "b",
          "ja": "はい。かごは別の値段です。",
          "vi": "Vâng. Giỏ tính riêng."
        },
        {
          "id": "be9cabc5-9580-5d6b-885f-505a94e86ee4-u03",
          "speaker_id": "a",
          "ja": "今日は自転車だけにします。防犯登録もこちらでできますか。",
          "vi": "Hôm nay tôi chỉ lấy xe. Tôi đăng ký xe ở đây được không ạ?"
        },
        {
          "id": "be9cabc5-9580-5d6b-885f-505a94e86ee4-u04",
          "speaker_id": "b",
          "ja": "はい、手続きをご案内します。",
          "vi": "Vâng, tôi sẽ hướng dẫn chị."
        }
      ],
      "admin": {
        "source_refs": [
          "shop",
          "w_reg"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "be9cabc5-9580-5d6b-885f-505a94e86ee4-u01": {
            "kind": "original_extension"
