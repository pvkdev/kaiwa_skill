      "situation_uid": "5a8a7696-c8e1-5c60-9599-9323b1c6d67b",
      "event_id": "E04",
      "context_vi": "Bãi Aoba giả định gợi hai khu gửi mới: khu gần lối bắc giá cao hơn, khu xa hơn rẻ hơn. Bạn ra vào rất sớm nên hỏi giờ mở trước khi chọn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5a8a7696-c8e1-5c60-9599-9323b1c6d67b-u01",
          "speaker_id": "a",
          "ja": "二つの場所は、朝何時から入れますか。",
          "vi": "Hai khu này mở từ mấy giờ sáng ạ?"
        },
        {
          "id": "5a8a7696-c8e1-5c60-9599-9323b1c6d67b-u02",
          "speaker_id": "b",
          "ja": "近いCは六時、安いDは七時からです。",
          "vi": "Khu C gần mở từ sáu giờ, khu D rẻ hơn mở từ bảy giờ."
        },
        {
          "id": "5a8a7696-c8e1-5c60-9599-9323b1c6d67b-u03",
          "speaker_id": "a",
          "ja": "私は六時半に来ます。Cにします。",
          "vi": "Tôi đến lúc sáu rưỡi. Tôi chọn khu C."
        }
      ],
      "admin": {
        "source_refs": [
          "w_park"
        ],
