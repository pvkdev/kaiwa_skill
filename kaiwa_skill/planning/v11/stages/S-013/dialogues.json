  "dialogues": [
    {
      "situation_uid": "1d8dac57-c73a-591d-915a-3ad56f0a301f",
      "event_id": "E01",
      "context_vi": "Ở cửa hàng xe đạp tại Tokyo, bạn đi làm bằng xe mỗi ngày khoảng ba kilômét. Bạn muốn nhân viên gợi ý xe dễ đi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1d8dac57-c73a-591d-915a-3ad56f0a301f-u01",
          "speaker_id": "a",
          "ja": "毎日、三キロぐらい自転車で行きます。乗りやすい自転車はありますか。",
          "vi": "Ngày nào tôi cũng đạp khoảng ba cây số. Có xe nào dễ đi không ạ?"
        },
        {
          "id": "1d8dac57-c73a-591d-915a-3ad56f0a301f-u02",
          "speaker_id": "b",
          "ja": "このタイプはどうですか。まず、サイズを見ましょう。",
          "vi": "Chị xem loại này nhé? Trước hết mình xem cỡ xe."
        },
        {
          "id": "1d8dac57-c73a-591d-915a-3ad56f0a301f-u03",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ anh."
        }
      ],
      "admin": {
        "source_refs": [
          "shop"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1d8dac57-c73a-591d-915a-3ad56f0a301f-u01": {
            "kind": "original_extension"
          },
          "1d8dac57-c73a-591d-915a-3ad56f0a301f-u02": {
            "kind": "original_extension"
          },
