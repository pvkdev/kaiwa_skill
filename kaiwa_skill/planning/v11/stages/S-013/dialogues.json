          },
          "be9cabc5-9580-5d6b-885f-505a94e86ee4-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3284ec51-42df-51c2-97a6-2e8c510148c9",
      "event_id": "E02",
      "context_vi": "Bạn hỏi nhân viên bãi gửi xe Aoba giả định gần ga có nhận gửi xe theo ngày không. Bạn chưa biết cách trả.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3284ec51-42df-51c2-97a6-2e8c510148c9-u01",
          "speaker_id": "a",
          "ja": "一日だけ自転車を置けますか。",
          "vi": "Tôi gửi xe một ngày được không ạ?"
        },
        {
          "id": "3284ec51-42df-51c2-97a6-2e8c510148c9-u02",
          "speaker_id": "b",
          "ja": "はい、ここでは一日利用ができます。入口で料金を確認してください。",
          "vi": "Được. Bãi này có gửi theo ngày. Chị xem phí tại lối vào nhé."
        },
        {
          "id": "3284ec51-42df-51c2-97a6-2e8c510148c9-u03",
          "speaker_id": "a",
          "ja": "わかりました。入口で見ます。",
          "vi": "Tôi hiểu. Tôi sẽ xem ở lối vào."
        }
      ],
      "admin": {
        "source_refs": [
          "w_park"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3284ec51-42df-51c2-97a6-2e8c510148c9-u01": {
            "kind": "original_extension"
