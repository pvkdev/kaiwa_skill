    {
      "situation_uid": "93f8a7c6-12b1-57b0-9bbc-7592962380a0",
      "event_id": "E03",
      "context_vi": "Sau khi hẹn gọi lúc bốn giờ, bạn được báo nhân viên bãi Aoba giả định đã chuyển xe sang khu giữ bên cạnh. Bạn đến quầy khu đó, hỏi xe có nguyên vẹn và có khoản nào cần trả.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên khu giữ xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "93f8a7c6-12b1-57b0-9bbc-7592962380a0-u01",
          "speaker_id": "a",
          "ja": "黒い自転車を取りに来ました。車体は大丈夫ですか。料金はありますか。",
          "vi": "Tôi đến lấy xe đen. Xe có ổn không ạ? Có phí gì không?"
        },
        {
          "id": "93f8a7c6-12b1-57b0-9bbc-7592962380a0-u02",
          "speaker_id": "b",
          "ja": "こちらで確認した限り、傷はありません。この移動の料金はありません。",
          "vi": "Theo kiểm tra ở đây, xe không có vết xước. Việc chuyển nội bộ này không thu phí."
        },
        {
          "id": "93f8a7c6-12b1-57b0-9bbc-7592962380a0-u03",
          "speaker_id": "a",
          "ja": "わかりました。自分でも見ます。",
          "vi": "Tôi hiểu. Tôi sẽ tự xem lại xe."
        }
      ],
      "admin": {
