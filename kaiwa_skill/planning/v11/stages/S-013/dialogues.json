    {
      "situation_uid": "8d710395-bfe6-52ff-9ce1-553c9264e10f",
      "event_id": "E03",
      "context_vi": "Tại bãi xe Aoba giả định, bạn không thấy xe. Nhân viên cần kiểm xem có bị chuyển nội bộ sang khu khác không; bạn xin người và giờ gọi lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên bãi xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8d710395-bfe6-52ff-9ce1-553c9264e10f-u01",
          "speaker_id": "b",
          "ja": "職員が移したか、確認します。",
          "vi": "Tôi sẽ kiểm xem nhân viên có chuyển xe không."
        },
        {
          "id": "8d710395-bfe6-52ff-9ce1-553c9264e10f-u02",
          "speaker_id": "a",
          "ja": "誰に、いつ聞けばいいですか。",
          "vi": "Tôi hỏi ai và khi nào ạ?"
        },
        {
          "id": "8d710395-bfe6-52ff-9ce1-553c9264e10f-u03",
          "speaker_id": "b",
          "ja": "私に、今日の四時に電話してください。",
          "vi": "Chị gọi cho tôi lúc bốn giờ hôm nay."
        },
        {
          "id": "8d710395-bfe6-52ff-9ce1-553c9264e10f-u04",
          "speaker_id": "a",
          "ja": "四時に、こちらへ電話します。",
          "vi": "Bốn giờ tôi gọi lại đây."
        }
      ],
      "admin": {
