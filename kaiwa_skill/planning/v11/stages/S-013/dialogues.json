    {
      "situation_uid": "5a453864-f891-5dd0-80fb-d859646abbf1",
      "event_id": "E05",
      "context_vi": "Bạn báo lại lỗi phanh xe. Để thợ không kiểm nhầm phần khác, bạn nhắc lần đầu báo tiếng lạ và tiệm đã thay miếng phanh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5a453864-f891-5dd0-80fb-d859646abbf1-u01",
          "speaker_id": "a",
          "ja": "前回、ブレーキの音を伝えました。パッドを替えてもらいました。",
          "vi": "Lần trước tôi cũng báo tiếng ở phanh. Tiệm đã thay miếng phanh."
        },
        {
          "id": "5a453864-f891-5dd0-80fb-d859646abbf1-u02",
          "speaker_id": "b",
          "ja": "わかりました。同じ音か確認します。",
          "vi": "Tôi hiểu. Tôi kiểm có phải cùng tiếng đó không."
        },
        {
          "id": "5a453864-f891-5dd0-80fb-d859646abbf1-u03",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Nhờ anh."
        }
      ],
      "admin": {
        "source_refs": [
          "repair"
        ],
