    {
      "situation_uid": "67f06f1f-1de3-5862-a521-d34bdfe66ae9",
      "event_id": "E05",
      "context_vi": "Ba giờ chiều hôm sau, bạn nhận lại xe sau lần kiểm phanh thứ hai. Thợ đã điều chỉnh phanh và báo phí kiểm giả định 1.000 yên; bạn hỏi lại tình trạng trước khi nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thợ sửa xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "67f06f1f-1de3-5862-a521-d34bdfe66ae9-u01",
          "speaker_id": "a",
          "ja": "ブレーキは今、どうですか。",
          "vi": "Giờ phanh thế nào ạ?"
        },
        {
          "id": "67f06f1f-1de3-5862-a521-d34bdfe66ae9-u02",
          "speaker_id": "b",
          "ja": "調整しました。音は出ません。点検料は千円です。",
          "vi": "Tôi đã chỉnh. Giờ không còn tiếng. Phí kiểm là 1.000 yên."
        },
        {
          "id": "67f06f1f-1de3-5862-a521-d34bdfe66ae9-u03",
          "speaker_id": "a",
          "ja": "千円ですね。ここで少し試してもいいですか。",
          "vi": "1.000 yên nhỉ. Tôi thử xe một chút ở đây được không ạ?"
        },
        {
          "id": "67f06f1f-1de3-5862-a521-d34bdfe66ae9-u04",
          "speaker_id": "b",
          "ja": "はい、どうぞ。",
          "vi": "Vâng, chị cứ thử."
        }
      ],
