          }
        }
      }
    },
    {
      "situation_uid": "7931c471-a266-5294-bd50-b4fc8813d698",
      "event_id": "E01",
      "context_vi": "Sau khi xin nhắc riêng số tiền ở quầy, bạn muốn xác nhận lại con số trước khi trả.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7931c471-a266-5294-bd50-b4fc8813d698-u01",
          "speaker_id": "a",
          "ja": "千二百円ですね。",
          "vi": "1.200 yên đúng không ạ?"
        },
        {
          "id": "7931c471-a266-5294-bd50-b4fc8813d698-u02",
          "speaker_id": "b",
          "ja": "はい、千二百円です。",
          "vi": "Vâng, 1.200 yên ạ."
        },
        {
          "id": "7931c471-a266-5294-bd50-b4fc8813d698-u03",
          "speaker_id": "a",
          "ja": "わかりました。こちらです。",
          "vi": "Tôi hiểu rồi. Tôi gửi tiền ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
        "specialty_item_ids": [
          "sj-so-01-b07-146"
        ],
