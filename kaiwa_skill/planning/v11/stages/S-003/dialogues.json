        },
        {
          "id": "d3a1c1ea-442e-5cef-827a-98260b826001-u03",
          "speaker_id": "b",
          "ja": "はい、どうぞ。",
          "vi": "Ừ, chị cứ nghĩ đi."
        },
        {
          "id": "d3a1c1ea-442e-5cef-827a-98260b826001-u04",
          "speaker_id": "a",
          "ja": "はい、明日は来られます。",
          "vi": "Được, ngày mai tôi đến được."
        }
      ],
