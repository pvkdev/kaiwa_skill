    {
      "situation_uid": "4f04d8af-502c-5d6e-a38f-6e7713d9f790",
      "event_id": "E03",
      "context_vi": "Ngay sau khi thấy tờ ghi chú ghi bốn giờ, bạn gọi lại quầy đặt lịch để xác nhận giờ xem phòng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4f04d8af-502c-5d6e-a38f-6e7713d9f790-u01",
          "speaker_id": "a",
          "ja": "先ほど見学の予約をしたリンです。時間をもう一度聞いてもいいですか。",
          "vi": "Tôi là Linh, vừa đặt lịch xem phòng. Anh nhắc lại giờ giúp tôi được không ạ?"
        },
        {
          "id": "4f04d8af-502c-5d6e-a38f-6e7713d9f790-u02",
          "speaker_id": "b",
          "ja": "はい、明日の四時です。",
          "vi": "Vâng, bốn giờ ngày mai ạ."
        },
        {
          "id": "4f04d8af-502c-5d6e-a38f-6e7713d9f790-u03",
          "speaker_id": "a",
          "ja": "四時ですね。三時と聞きました。ありがとうございます。",
          "vi": "Bốn giờ nhỉ. Tôi đã nghe thành ba giờ. Cảm ơn anh."
        },
        {
          "id": "4f04d8af-502c-5d6e-a38f-6e7713d9f790-u04",
          "speaker_id": "b",
          "ja": "はい、お待ちしています。",
          "vi": "Vâng, chúng tôi đợi chị."
        }
      ],
