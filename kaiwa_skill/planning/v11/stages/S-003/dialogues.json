      ],
      "turns": [
        {
          "id": "d3a1c1ea-442e-5cef-827a-98260b826001-u01",
          "speaker_id": "b",
          "ja": "明日は来られますか。",
          "vi": "Ngày mai chị đến được không?"
        },
