  "dialogues": [
    {
      "situation_uid": "ac36f744-95c5-561d-8a09-444e25672225",
      "event_id": "E01",
      "context_vi": "Ở quầy ăn đang ồn, bạn không nghe rõ câu nhân viên vừa nói. Bạn xin anh ấy nói chậm hơn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ac36f744-95c5-561d-8a09-444e25672225-u01",
          "speaker_id": "b",
          "ja": "ご注文はお決まりですか。",
          "vi": "Chị chọn món xong chưa ạ?"
        },
        {
          "id": "ac36f744-95c5-561d-8a09-444e25672225-u02",
          "speaker_id": "a",
          "ja": "すみません、もう少しゆっくりお願いします。",
          "vi": "Xin lỗi, anh nói chậm hơn một chút được không ạ?"
        },
        {
          "id": "ac36f744-95c5-561d-8a09-444e25672225-u03",
          "speaker_id": "b",
          "ja": "注文は、決まりましたか。",
          "vi": "Chị đã chọn món chưa ạ?"
        },
        {
          "id": "ac36f744-95c5-561d-8a09-444e25672225-u04",
          "speaker_id": "a",
          "ja": "はい、カレーをお願いします。",
          "vi": "Rồi ạ, cho tôi món cà ri."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat",
          "simple"
        ],
        "specialty_item_ids": [
          "sj-so-01-b07-146"
        ],
