    {
      "situation_uid": "503e9ebf-e974-5e28-8879-9590cf4abc08",
      "event_id": "E03",
      "context_vi": "Vừa rời quầy đặt lịch xem phòng, bạn kể cho bạn mình rằng giờ hẹn là ba giờ. Bạn ấy nhìn tờ ghi chú của quầy và thấy ghi bốn giờ. Bạn nhận ra phải gọi xác nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "503e9ebf-e974-5e28-8879-9590cf4abc08-u01",
          "speaker_id": "a",
          "ja": "見学は三時だよね。",
          "vi": "Lịch xem là ba giờ nhỉ?"
        },
        {
          "id": "503e9ebf-e974-5e28-8879-9590cf4abc08-u02",
          "speaker_id": "b",
          "ja": "このメモには四時と書いてあるよ。",
          "vi": "Tờ ghi chú này viết bốn giờ đấy."
        },
        {
          "id": "503e9ebf-e974-5e28-8879-9590cf4abc08-u03",
          "speaker_id": "a",
          "ja": "あ、聞き間違えたかも。電話して聞くね。",
          "vi": "À, có khi mình nghe nhầm. Mình gọi lại hỏi nhé."
        }
      ],
