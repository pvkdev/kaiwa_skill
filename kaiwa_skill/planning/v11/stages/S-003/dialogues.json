    {
      "situation_uid": "71eda0dd-3739-5221-ba65-b739f5bf8ccc",
      "event_id": "E03",
      "context_vi": "Trước khi chia tay, bạn cần xác nhận cả giờ và điểm hẹn mà người quen vừa nhắc: ba giờ ở trước cửa ga.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "71eda0dd-3739-5221-ba65-b739f5bf8ccc-u01",
          "speaker_id": "a",
          "ja": "明日は三時に駅の前ですね。",
          "vi": "Ngày mai ba giờ trước cửa ga nhỉ?"
        },
        {
          "id": "71eda0dd-3739-5221-ba65-b739f5bf8ccc-u02",
          "speaker_id": "b",
          "ja": "はい、駅の前で会いましょう。",
          "vi": "Ừ, mình gặp trước cửa ga nhé."
        },
        {
          "id": "71eda0dd-3739-5221-ba65-b739f5bf8ccc-u03",
          "speaker_id": "a",
          "ja": "三時ですね。では、また明日。",
          "vi": "Ba giờ nhỉ. Hẹn ngày mai."
        },
        {
          "id": "71eda0dd-3739-5221-ba65-b739f5bf8ccc-u04",
          "speaker_id": "b",
          "ja": "また明日。",
          "vi": "Hẹn ngày mai."
        }
      ],
