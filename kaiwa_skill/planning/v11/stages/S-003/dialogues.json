    {
      "situation_uid": "d7a8c572-94eb-5796-83eb-1b9fe910732a",
      "event_id": "E02",
      "context_vi": "Tiếp cuộc chỉ phòng học: bạn vừa biết mình nghe nhầm tầng một với tầng hai. Bạn nhận lỗi và hỏi lại vị trí đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d7a8c572-94eb-5796-83eb-1b9fe910732a-u01",
          "speaker_id": "a",
          "ja": "すみません、一階と聞きました。二階ですね。",
          "vi": "Xin lỗi, tôi nghe thành tầng một. Là tầng hai nhỉ?"
        },
        {
          "id": "d7a8c572-94eb-5796-83eb-1b9fe910732a-u02",
          "speaker_id": "b",
          "ja": "はい、二階です。階段を上がってください。",
          "vi": "Vâng, tầng hai. Chị lên cầu thang nhé."
        },
        {
          "id": "d7a8c572-94eb-5796-83eb-1b9fe910732a-u03",
          "speaker_id": "a",
          "ja": "わかりました。二階へ行きます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ lên tầng hai."
        }
      ],
