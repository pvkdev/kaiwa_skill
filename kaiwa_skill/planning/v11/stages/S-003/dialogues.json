    {
      "situation_uid": "96922b15-2a7b-57ea-8ecd-ade9417126ec",
      "event_id": "E02",
      "context_vi": "Người hướng dẫn nói “角” khi chỉ đường tới phòng học. Bạn chưa biết từ đó và muốn hỏi nghĩa ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "96922b15-2a7b-57ea-8ecd-ade9417126ec-u01",
          "speaker_id": "b",
          "ja": "次の角を右です。",
          "vi": "Đến góc rẽ tiếp theo thì rẽ phải."
        },
        {
          "id": "96922b15-2a7b-57ea-8ecd-ade9417126ec-u02",
          "speaker_id": "a",
          "ja": "「角」は何ですか。",
          "vi": "“Kado” nghĩa là gì ạ?"
        },
        {
          "id": "96922b15-2a7b-57ea-8ecd-ade9417126ec-u03",
          "speaker_id": "b",
          "ja": "道が曲がるところです。",
          "vi": "Là chỗ đường rẽ."
        },
        {
          "id": "96922b15-2a7b-57ea-8ecd-ade9417126ec-u04",
          "speaker_id": "a",
          "ja": "ああ、次の角を右ですね。",
          "vi": "À, đến góc rẽ tiếp theo thì rẽ phải nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "direction"
        ],
        "specialty_item_ids": [
          "sj-so-01-b11-61"
        ],
        "turn_origins": {
