        }
      }
    },
    {
      "situation_uid": "11150a19-1ca3-5a8c-ab9b-a04940ced927",
      "event_id": "E02",
      "context_vi": "Người hướng dẫn đã chỉ bạn đi thẳng đến cầu thang. Bạn hiểu đoạn đầu nhưng chưa rõ sau đó phải đi đâu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "11150a19-1ca3-5a8c-ab9b-a04940ced927-u01",
          "speaker_id": "b",
          "ja": "まっすぐ階段まで行って、そのあと左です。",
          "vi": "Đi thẳng đến cầu thang, rồi rẽ trái."
        },
        {
          "id": "11150a19-1ca3-5a8c-ab9b-a04940ced927-u02",
          "speaker_id": "a",
          "ja": "階段まではわかりました。そのあと、どちらですか。",
          "vi": "Tôi hiểu đoạn đến cầu thang rồi. Sau đó rẽ phía nào ạ?"
        },
        {
          "id": "11150a19-1ca3-5a8c-ab9b-a04940ced927-u03",
          "speaker_id": "b",
          "ja": "左です。",
          "vi": "Rẽ trái."
        },
        {
          "id": "11150a19-1ca3-5a8c-ab9b-a04940ced927-u04",
          "speaker_id": "a",
          "ja": "階段のあと、左ですね。",
          "vi": "Qua cầu thang rồi rẽ trái nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "direction"
        ],
        "specialty_item_ids": [
          "sj-so-01-b07-18"
        ],
        "turn_origins": {
