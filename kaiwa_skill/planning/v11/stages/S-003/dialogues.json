          }
        }
      }
    },
    {
      "situation_uid": "b880b6b1-8a9d-5305-a940-488393bda539",
      "event_id": "E01",
      "context_vi": "Người hướng dẫn chỉ còn một phút trước khi vào lớp. Bạn chưa theo kịp phần giải thích và xin nghe ý quan trọng trước.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b880b6b1-8a9d-5305-a940-488393bda539-u01",
          "speaker_id": "b",
          "ja": "あと一分だけです。",
          "vi": "Tôi chỉ còn một phút thôi."
        },
        {
          "id": "b880b6b1-8a9d-5305-a940-488393bda539-u02",
          "speaker_id": "a",
          "ja": "わかりました。大事なところからお願いします。",
          "vi": "Tôi hiểu. Anh nói phần quan trọng trước giúp tôi nhé."
        },
        {
          "id": "b880b6b1-8a9d-5305-a940-488393bda539-u03",
          "speaker_id": "b",
          "ja": "まず、二階の教室へ行ってください。",
          "vi": "Trước hết chị lên phòng học tầng hai."
        },
        {
          "id": "b880b6b1-8a9d-5305-a940-488393bda539-u04",
          "speaker_id": "a",
          "ja": "二階ですね。ほかは後で聞きます。",
          "vi": "Tầng hai nhỉ. Phần còn lại tôi hỏi sau."
        }
      ],
      "admin": {
        "source_refs": [
          "simple"
        ],
        "specialty_item_ids": [
          "sj-so-01-b11-61"
        ],
        "turn_origins": {
          "b880b6b1-8a9d-5305-a940-488393bda539-u01": {
