    {
      "situation_uid": "d3a1c1ea-442e-5cef-827a-98260b826001",
      "event_id": "E03",
      "context_vi": "Bạn được hỏi ý kiến trong nhóm học và cần vài giây để nghĩ câu trả lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "thành viên cùng nhóm",
