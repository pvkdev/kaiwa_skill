        {
          "id": "a6965b46-fcd9-5ec7-be7b-19253a7329f0-u02",
          "speaker_id": "a",
          "ja": "一階ですね。この階ですか。",
          "vi": "Tầng một nhỉ. Ở tầng này ạ?"
