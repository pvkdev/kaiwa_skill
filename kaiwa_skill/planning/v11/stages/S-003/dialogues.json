          }
        }
      }
    },
    {
      "situation_uid": "f398d2b8-51a2-5129-b589-b3ae88face41",
      "event_id": "E01",
      "context_vi": "Ở quầy ăn ồn, bạn chỉ nghe nhân viên vừa nhắc một món trong thực đơn nhưng không rõ tên món.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f398d2b8-51a2-5129-b589-b3ae88face41-u01",
          "speaker_id": "b",
          "ja": "今日のおすすめは、親子丼です。",
          "vi": "Hôm nay chúng tôi gợi ý món cơm gà trứng."
        },
        {
          "id": "f398d2b8-51a2-5129-b589-b3ae88face41-u02",
          "speaker_id": "a",
          "ja": "すみません、料理の名前をもう一度お願いします。",
          "vi": "Xin lỗi, anh nhắc lại tên món được không ạ?"
        },
        {
          "id": "f398d2b8-51a2-5129-b589-b3ae88face41-u03",
          "speaker_id": "b",
          "ja": "親子丼です。",
          "vi": "Món oyakodon ạ."
        },
        {
          "id": "f398d2b8-51a2-5129-b589-b3ae88face41-u04",
          "speaker_id": "a",
          "ja": "親子丼ですね。それをお願いします。",
          "vi": "Oyakodon nhỉ. Cho tôi món đó."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
        "specialty_item_ids": [
          "sj-so-01-b07-146"
        ],
        "turn_origins": {
          "f398d2b8-51a2-5129-b589-b3ae88face41-u01": {
            "kind": "original_extension"
          },
          "f398d2b8-51a2-5129-b589-b3ae88face41-u02": {
            "kind": "original_extension"
          },
          "f398d2b8-51a2-5129-b589-b3ae88face41-u03": {
            "kind": "original_extension"
          },
          "f398d2b8-51a2-5129-b589-b3ae88face41-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "98b422c2-fbc1-5995-b41a-2aa18e8434cb",
      "event_id": "E01",
      "context_vi": "Tại quầy, bạn đã nghe rõ món mình mua nhưng chưa nghe rõ số tiền nhân viên vừa báo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên quầy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "98b422c2-fbc1-5995-b41a-2aa18e8434cb-u01",
          "speaker_id": "b",
          "ja": "合わせて、千二百円です。",
          "vi": "Tổng cộng là 1.200 yên."
        },
        {
          "id": "98b422c2-fbc1-5995-b41a-2aa18e8434cb-u02",
          "speaker_id": "a",
          "ja": "すみません、金額だけもう一度お願いします。",
          "vi": "Xin lỗi, anh nhắc riêng số tiền được không ạ?"
        },
        {
          "id": "98b422c2-fbc1-5995-b41a-2aa18e8434cb-u03",
          "speaker_id": "b",
          "ja": "千二百円です。",
          "vi": "1.200 yên ạ."
        },
        {
          "id": "98b422c2-fbc1-5995-b41a-2aa18e8434cb-u04",
          "speaker_id": "a",
          "ja": "千二百円ですね。",
          "vi": "1.200 yên nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "repeat"
        ],
        "specialty_item_ids": [
          "sj-so-01-b07-146"
        ],
        "turn_origins": {
