    {
      "situation_uid": "7b045d4d-4724-59f7-b68c-495d657036c7",
      "event_id": "E02",
      "context_vi": "Bạn nghe chỉ dẫn tới phòng nhưng câu quá dài. Bạn nhờ người hướng dẫn nói từng bước đơn giản hơn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7b045d4d-4724-59f7-b68c-495d657036c7-u01",
          "speaker_id": "a",
          "ja": "すみません、もっと簡単にお願いします。",
          "vi": "Xin lỗi, anh nói đơn giản hơn giúp tôi được không?"
        },
        {
          "id": "7b045d4d-4724-59f7-b68c-495d657036c7-u02",
          "speaker_id": "b",
          "ja": "はい。まず、まっすぐです。",
          "vi": "Được. Trước hết đi thẳng."
        },
        {
          "id": "7b045d4d-4724-59f7-b68c-495d657036c7-u03",
          "speaker_id": "a",
          "ja": "まっすぐですね。",
          "vi": "Đi thẳng nhỉ."
        },
        {
          "id": "7b045d4d-4724-59f7-b68c-495d657036c7-u04",
          "speaker_id": "b",
          "ja": "次に、右です。",
          "vi": "Sau đó rẽ phải."
        },
        {
          "id": "7b045d4d-4724-59f7-b68c-495d657036c7-u05",
          "speaker_id": "a",
          "ja": "わかりました。ありがとうございます。",
          "vi": "Tôi hiểu rồi. Cảm ơn anh."
        }
      ],
      "admin": {
