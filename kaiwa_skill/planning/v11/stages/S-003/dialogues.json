    {
      "situation_uid": "a6965b46-fcd9-5ec7-be7b-19253a7329f0",
      "event_id": "E02",
      "context_vi": "Người hướng dẫn bảo phòng học ở tầng hai. Bạn nghe thành tầng một và chỉ thử cầu thang xuống tầng một.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
