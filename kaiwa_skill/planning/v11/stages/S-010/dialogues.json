    {
      "situation_uid": "77fde585-cd79-5ca5-9458-0c98a06db5cb",
      "event_id": "E02",
      "context_vi": "Sau khi hỏi lối vòng qua công viên và bưu điện trong khu phố Aoba hư cấu, bạn gọi cho người bạn đang đợi ở thư viện để báo vị trí.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "bạn đang đợi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "77fde585-cd79-5ca5-9458-0c98a06db5cb-u01",
          "speaker_id": "a",
          "ja": "今、公園の前にいるよ。いつもの道が通れないんだ。",
          "vi": "Giờ mình đang trước công viên. Đường mọi khi bị chặn rồi."
        },
        {
          "id": "77fde585-cd79-5ca5-9458-0c98a06db5cb-u02",
          "speaker_id": "b",
          "ja": "そうなんだ。別の道はわかった？",
          "vi": "Vậy à. Cậu biết đường khác chưa?"
        },
        {
          "id": "77fde585-cd79-5ca5-9458-0c98a06db5cb-u03",
          "speaker_id": "a",
          "ja": "うん。郵便局の前を通って行くよ。",
          "vi": "Ừ. Mình sẽ đi qua trước bưu điện."
        },
        {
          "id": "77fde585-cd79-5ca5-9458-0c98a06db5cb-u04",
          "speaker_id": "b",
          "ja": "わかった。図書館で待ってるね。",
          "vi": "Được. Mình đợi ở thư viện nhé."
        }
      ],
      "admin": {
