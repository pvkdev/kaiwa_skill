    {
      "situation_uid": "e4e43d77-82db-519b-a0d6-b8f8ab80dc57",
      "event_id": "E02",
      "context_vi": "Ở khu phố Aoba hư cấu, con đường bạn quen đi tới thư viện hôm nay bị rào chắn. Bạn hỏi người địa phương lối vòng từ công viên nhỏ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e4e43d77-82db-519b-a0d6-b8f8ab80dc57-u01",
          "speaker_id": "a",
          "ja": "この道は通れませんね。図書館へはどう行きますか。",
          "vi": "Đường này không đi được nhỉ. Tôi tới thư viện thế nào ạ?"
        },
        {
          "id": "e4e43d77-82db-519b-a0d6-b8f8ab80dc57-u02",
          "speaker_id": "b",
          "ja": "公園の角を右に曲がってください。郵便局の前を通ります。",
          "vi": "Chị rẽ phải ở góc công viên rồi đi qua trước bưu điện."
        },
        {
          "id": "e4e43d77-82db-519b-a0d6-b8f8ab80dc57-u03",
          "speaker_id": "a",
          "ja": "公園で右、郵便局の前ですね。",
          "vi": "Rẽ phải ở công viên, qua trước bưu điện nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "walk"
        ],
