    {
      "situation_uid": "76d7f505-ed14-55de-a194-657fef8072fe",
      "event_id": "E02",
      "context_vi": "Trong khu phố Aoba hư cấu, bạn đứng trước tiệm bánh nhưng không thấy lối nhỏ tới trung tâm cộng đồng. Bạn hỏi người địa phương tại chỗ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "76d7f505-ed14-55de-a194-657fef8072fe-u01",
          "speaker_id": "a",
          "ja": "パン屋の前にいます。センターへの道が見えません。",
          "vi": "Tôi đang đứng trước tiệm bánh. Tôi không thấy lối tới trung tâm."
        },
        {
          "id": "76d7f505-ed14-55de-a194-657fef8072fe-u02",
          "speaker_id": "b",
          "ja": "パン屋の右に細い道がありますよ。",
          "vi": "Bên phải tiệm bánh có lối nhỏ đấy."
        },
        {
          "id": "76d7f505-ed14-55de-a194-657fef8072fe-u03",
          "speaker_id": "a",
          "ja": "あ、この道ですね。",
          "vi": "À, lối này nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "walk"
        ],
        "specialty_item_ids": [
          "sj-so-03-b11-75",
          "sj-so-03-b11-2"
        ],
        "turn_origins": {
