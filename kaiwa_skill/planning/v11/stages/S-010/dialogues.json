    {
      "situation_uid": "b27102d5-5785-5514-afd1-0a539bcca1f9",
      "event_id": "E02",
      "context_vi": "Bạn muốn gặp bạn ở cửa bắc ga Aoba hư cấu nhưng đang đứng tại cửa nam. Bạn tưởng cửa nam là cửa bắc và hỏi một người qua đường.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người qua đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b27102d5-5785-5514-afd1-0a539bcca1f9-u01",
          "speaker_id": "a",
          "ja": "ここは北口ですよね。",
          "vi": "Đây là cửa bắc, đúng không ạ?"
        },
        {
          "id": "b27102d5-5785-5514-afd1-0a539bcca1f9-u02",
          "speaker_id": "b",
          "ja": "いいえ、ここは南口です。",
          "vi": "Không, đây là cửa nam."
        },
        {
          "id": "b27102d5-5785-5514-afd1-0a539bcca1f9-u03",
          "speaker_id": "a",
          "ja": "あ、反対でした。",
          "vi": "À, tôi nhầm phía rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "walk"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b27102d5-5785-5514-afd1-0a539bcca1f9-u01": {
