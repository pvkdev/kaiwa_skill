    {
      "situation_uid": "53ca2388-ec85-561b-b6b7-7b34b87da79f",
      "event_id": "E03",
      "context_vi": "Bạn đang chỉ người khác đi bộ tới thư viện Aoba hư cấu. Bạn dùng hai mốc dễ nhận: công viên rồi hiệu sách.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hỏi đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "53ca2388-ec85-561b-b6b7-7b34b87da79f-u01",
          "speaker_id": "a",
          "ja": "まず、公園までまっすぐです。その次に、本屋の角を左です。",
          "vi": "Đầu tiên đi thẳng tới công viên. Sau đó rẽ trái ở góc hiệu sách."
        },
        {
          "id": "53ca2388-ec85-561b-b6b7-7b34b87da79f-u02",
          "speaker_id": "b",
          "ja": "公園、それから本屋ですね。",
          "vi": "Công viên, rồi hiệu sách nhỉ."
        },
        {
          "id": "53ca2388-ec85-561b-b6b7-7b34b87da79f-u03",
          "speaker_id": "a",
          "ja": "はい。本屋で左です。",
          "vi": "Đúng. Ở hiệu sách thì rẽ trái."
        }
      ],
      "admin": {
