  "dialogues": [
    {
      "situation_uid": "ad2623c7-0c89-5dc2-90dd-fd953cc45060",
      "event_id": "E01",
      "context_vi": "Ở khu phố Sakura hư cấu, bạn muốn tới bưu điện và hỏi người địa phương liệu có gần không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ad2623c7-0c89-5dc2-90dd-fd953cc45060-u01",
          "speaker_id": "a",
          "ja": "すみません、郵便局はこの辺ですか。",
          "vi": "Xin lỗi, bưu điện có ở gần đây không ạ?"
        },
        {
          "id": "ad2623c7-0c89-5dc2-90dd-fd953cc45060-u02",
          "speaker_id": "b",
          "ja": "はい、歩いて五分ぐらいです。",
          "vi": "Có, đi bộ khoảng năm phút."
        },
        {
          "id": "ad2623c7-0c89-5dc2-90dd-fd953cc45060-u03",
          "speaker_id": "a",
          "ja": "どちらへ行きますか。",
          "vi": "Tôi đi hướng nào ạ?"
        },
        {
          "id": "ad2623c7-0c89-5dc2-90dd-fd953cc45060-u04",
          "speaker_id": "b",
          "ja": "この道をまっすぐです。",
          "vi": "Cứ đi thẳng đường này."
        }
      ],
      "admin": {
        "source_refs": [
          "walk",
          "polite"
        ],
