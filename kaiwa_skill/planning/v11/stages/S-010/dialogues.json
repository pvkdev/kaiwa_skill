    {
      "situation_uid": "870dc492-8c16-557d-bb9c-897dcc09ed5b",
      "event_id": "E03",
      "context_vi": "Bạn vừa chỉ một người mới đi thẳng đến công viên rồi rẽ trái để tới hiệu sách trong khu phố Aoba hư cấu. Anh ấy nhắc lại thành rẽ phải.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hỏi đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "870dc492-8c16-557d-bb9c-897dcc09ed5b-u01",
          "speaker_id": "a",
          "ja": "公園までまっすぐです。そこで左に曲がってください。",
          "vi": "Đi thẳng tới công viên. Ở đó anh rẽ trái nhé."
        },
        {
          "id": "870dc492-8c16-557d-bb9c-897dcc09ed5b-u02",
          "speaker_id": "b",
          "ja": "公園で右ですね。",
          "vi": "Ở công viên rẽ phải nhỉ."
        },
        {
          "id": "870dc492-8c16-557d-bb9c-897dcc09ed5b-u03",
          "speaker_id": "a",
          "ja": "いいえ、左です。",
          "vi": "Không, rẽ trái."
        }
      ],
