    {
      "situation_uid": "18e4b46f-16f3-519a-92c3-82ef9a40b19c",
      "event_id": "E01",
      "context_vi": "Trong khu phố Sakura hư cấu, bạn muốn tới bưu điện. Phía trước có hai ngã rẽ, bạn hỏi đúng ngã nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "18e4b46f-16f3-519a-92c3-82ef9a40b19c-u01",
          "speaker_id": "a",
          "ja": "どの角で左に曲がりますか。",
          "vi": "Tôi rẽ trái ở góc nào ạ?"
        },
        {
          "id": "18e4b46f-16f3-519a-92c3-82ef9a40b19c-u02",
          "speaker_id": "b",
          "ja": "二つ目の角です。コンビニのところです。",
          "vi": "Góc thứ hai. Chỗ cửa hàng tiện lợi."
        },
        {
          "id": "18e4b46f-16f3-519a-92c3-82ef9a40b19c-u03",
          "speaker_id": "a",
          "ja": "一つ目ではなく、二つ目ですね。",
          "vi": "Không phải góc đầu mà là góc thứ hai nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "walk"
        ],
        "specialty_item_ids": [
          "sj-so-03-b11-75"
        ],
        "turn_origins": {
          "18e4b46f-16f3-519a-92c3-82ef9a40b19c-u01": {
            "kind": "original_extension"
          },
          "18e4b46f-16f3-519a-92c3-82ef9a40b19c-u02": {
            "kind": "original_extension"
          },
          "18e4b46f-16f3-519a-92c3-82ef9a40b19c-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7635296a-3b32-5b8a-a733-43668ee94bcd",
      "event_id": "E01",
      "context_vi": "Bạn nghe người địa phương nêu tên tòa nhà cạnh bưu điện nhưng không nghe rõ. Bạn xin nhắc riêng tên tòa nhà để nhận ra mốc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7635296a-3b32-5b8a-a733-43668ee94bcd-u01",
          "speaker_id": "b",
          "ja": "郵便局は青葉ビルの隣です。",
          "vi": "Bưu điện ở cạnh tòa nhà Aoba."
        },
        {
          "id": "7635296a-3b32-5b8a-a733-43668ee94bcd-u02",
          "speaker_id": "a",
          "ja": "すみません、ビルの名前をもう一度お願いします。",
          "vi": "Xin lỗi, anh nhắc lại tên tòa nhà được không ạ?"
        },
        {
          "id": "7635296a-3b32-5b8a-a733-43668ee94bcd-u03",
          "speaker_id": "b",
          "ja": "青葉ビルです。",
          "vi": "Tòa nhà Aoba."
        },
        {
          "id": "7635296a-3b32-5b8a-a733-43668ee94bcd-u04",
          "speaker_id": "a",
          "ja": "青葉ビルの隣ですね。",
          "vi": "Cạnh tòa Aoba nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "walk"
        ],
        "specialty_item_ids": [],
