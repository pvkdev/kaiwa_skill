    {
      "situation_uid": "65e2133e-2c1f-5f6d-9069-bf5aa2554e54",
      "event_id": "E01",
      "context_vi": "Ở khu phố Sakura hư cấu, bạn hỏi lối tới bưu điện nhưng người địa phương không chắc. Bạn muốn biết chỗ có thể hỏi tiếp thay vì đi theo phỏng đoán.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "65e2133e-2c1f-5f6d-9069-bf5aa2554e54-u01",
          "speaker_id": "a",
          "ja": "郵便局への道を知っていますか。",
          "vi": "Anh biết đường đến bưu điện không ạ?"
        },
        {
          "id": "65e2133e-2c1f-5f6d-9069-bf5aa2554e54-u02",
          "speaker_id": "b",
          "ja": "すみません、よくわかりません。",
          "vi": "Xin lỗi, tôi không rõ lắm."
        },
        {
          "id": "65e2133e-2c1f-5f6d-9069-bf5aa2554e54-u03",
          "speaker_id": "a",
          "ja": "どこで聞けますか。",
          "vi": "Vậy tôi hỏi ở đâu được ạ?"
        },
        {
          "id": "65e2133e-2c1f-5f6d-9069-bf5aa2554e54-u04",
          "speaker_id": "b",
          "ja": "駅の案内所で聞けますよ。",
          "vi": "Chị có thể hỏi ở quầy hướng dẫn trong ga."
        },
        {
          "id": "65e2133e-2c1f-5f6d-9069-bf5aa2554e54-u05",
          "speaker_id": "a",
          "ja": "ありがとうございます。駅で聞きます。",
          "vi": "Cảm ơn anh. Tôi sẽ hỏi ở ga."
        }
      ],
      "admin": {
        "source_refs": [
          "walk"
        ],
        "specialty_item_ids": [],
