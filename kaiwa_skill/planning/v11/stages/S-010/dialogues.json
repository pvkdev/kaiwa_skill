    {
      "situation_uid": "b98ce024-3703-54a7-a5dc-fb10a344a0c1",
      "event_id": "E03",
      "context_vi": "Sau khi người hỏi đường nhắc nhầm rẽ phải và bạn sửa thành rẽ trái tại công viên, bạn kiểm anh ấy đã nhận ra mốc đầu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hỏi đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b98ce024-3703-54a7-a5dc-fb10a344a0c1-u01",
          "speaker_id": "a",
          "ja": "公園は見えますか。あそこです。",
          "vi": "Anh thấy công viên không? Ở đằng kia."
        },
        {
          "id": "b98ce024-3703-54a7-a5dc-fb10a344a0c1-u02",
          "speaker_id": "b",
          "ja": "はい、見えます。あそこで左ですね。",
          "vi": "Có, tôi thấy rồi. Tới đó rẽ trái nhỉ."
        },
        {
          "id": "b98ce024-3703-54a7-a5dc-fb10a344a0c1-u03",
          "speaker_id": "a",
          "ja": "はい、そのとおりです。",
          "vi": "Đúng rồi."
        }
      ],
