    {
      "situation_uid": "c911cbe6-191c-5964-97f1-ea15e3e780a7",
      "event_id": "E01",
      "context_vi": "Sau khi được chỉ rẽ trái ở góc thứ hai, chỗ cửa hàng tiện lợi, bạn nhắc lại mốc để tới bưu điện trong khu phố Sakura hư cấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người địa phương",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c911cbe6-191c-5964-97f1-ea15e3e780a7-u01",
          "speaker_id": "a",
          "ja": "この道をまっすぐ、二つ目の角を左ですね。",
          "vi": "Đi thẳng đường này, rẽ trái ở góc thứ hai nhỉ."
        },
        {
          "id": "c911cbe6-191c-5964-97f1-ea15e3e780a7-u02",
          "speaker_id": "b",
          "ja": "はい。コンビニが見えますよ。",
          "vi": "Đúng. Chị sẽ thấy cửa hàng tiện lợi."
        },
        {
          "id": "c911cbe6-191c-5964-97f1-ea15e3e780a7-u03",
          "speaker_id": "a",
          "ja": "コンビニの角ですね。ありがとうございます。",
          "vi": "Góc cửa hàng tiện lợi nhỉ. Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "walk"
        ],
        "specialty_item_ids": [
          "sj-so-03-b11-75",
          "sj-so-03-b11-2"
