    {
      "situation_uid": "74083afd-cece-5819-9f2e-c3a36a7683e0",
      "event_id": "E03",
      "context_vi": "Bạn biết lối đến công viên ở khu phố Aoba hư cấu nhưng không chắc đoạn cuối tới thư viện. Bạn chỉ phần mình biết và nói rõ giới hạn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hỏi đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "74083afd-cece-5819-9f2e-c3a36a7683e0-u01",
          "speaker_id": "a",
          "ja": "公園まではわかります。ここをまっすぐです。",
          "vi": "Tôi biết đường tới công viên. Anh cứ đi thẳng lối này."
        },
        {
          "id": "74083afd-cece-5819-9f2e-c3a36a7683e0-u02",
          "speaker_id": "b",
          "ja": "その先は、どちらですか。",
          "vi": "Sau đó đi hướng nào?"
        },
        {
          "id": "74083afd-cece-5819-9f2e-c3a36a7683e0-u03",
          "speaker_id": "a",
          "ja": "すみません、その先はわかりません。公園でまた聞いてください。",
          "vi": "Xin lỗi, đoạn sau tôi không rõ. Anh hỏi tiếp ở công viên nhé."
        }
      ],
      "admin": {
        "source_refs": [
