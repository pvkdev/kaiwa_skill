          },
          "b27102d5-5785-5514-afd1-0a539bcca1f9-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "137fe401-3b11-5af5-8267-2a9669dca659",
      "event_id": "E02",
      "context_vi": "Sau khi biết mình đang ở cửa nam chứ không phải cửa bắc ga Aoba hư cấu, bạn nêu đúng cổng mình đứng và hỏi cách tới cửa bắc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người qua đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "137fe401-3b11-5af5-8267-2a9669dca659-u01",
          "speaker_id": "a",
          "ja": "今、南口です。北口へはどう行きますか。",
          "vi": "Giờ tôi đang ở cửa nam. Tôi đi cửa bắc thế nào ạ?"
        },
        {
          "id": "137fe401-3b11-5af5-8267-2a9669dca659-u02",
          "speaker_id": "b",
          "ja": "駅の外を回って、反対側へ行ってください。",
          "vi": "Chị vòng bên ngoài ga sang phía đối diện nhé."
        },
        {
          "id": "137fe401-3b11-5af5-8267-2a9669dca659-u03",
          "speaker_id": "a",
          "ja": "外を回るんですね。ありがとうございます。",
          "vi": "Vòng bên ngoài nhỉ. Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "walk"
        ],
        "specialty_item_ids": [],
