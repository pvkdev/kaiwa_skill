    {
      "situation_uid": "0fd8fb48-9605-52df-96f2-67c4331a7239",
      "event_id": "E03",
      "context_vi": "Một người mới ở khu phố Aoba hư cấu hỏi bạn đường tới thư viện. Trước khi chỉ, bạn cần biết anh ấy muốn đi bộ hay đi tàu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người hỏi đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0fd8fb48-9605-52df-96f2-67c4331a7239-u01",
          "speaker_id": "a",
          "ja": "歩いて行きますか。それとも電車ですか。",
          "vi": "Anh đi bộ hay đi tàu?"
        },
        {
          "id": "0fd8fb48-9605-52df-96f2-67c4331a7239-u02",
          "speaker_id": "b",
          "ja": "歩いて行きます。",
          "vi": "Tôi đi bộ."
        },
        {
          "id": "0fd8fb48-9605-52df-96f2-67c4331a7239-u03",
          "speaker_id": "a",
          "ja": "では、この道をまっすぐです。",
          "vi": "Vậy anh cứ đi thẳng đường này."
        }
      ],
      "admin": {
        "source_refs": [
          "walk"
        ],
        "specialty_item_ids": [],
