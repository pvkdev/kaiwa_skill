    {
      "situation_uid": "741771fa-dc9b-57fd-ac13-3cdcb7ec6359",
      "event_id": "E06",
      "context_vi": "Ở nhánh kết quả khác của cùng đợt tuyển, Nam thông báo Yui không được chọn, nói rõ quyết định và giữ sự tôn trọng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "741771fa-dc9b-57fd-ac13-3cdcb7ec6359-u01",
          "speaker_id": "A",
          "ja": "選考の結果、今回は別の方にお願いすることになりました。お時間をいただいたのに、ご希望に添えず申し訳ありません。",
          "vi": "Sau khi xem xét, lần này chúng tôi chọn người khác. Xin lỗi vì không thể đáp ứng mong muốn của chị dù chị đã dành thời gian."
        },
        {
          "id": "741771fa-dc9b-57fd-ac13-3cdcb7ec6359-u02",
          "speaker_id": "B",
          "ja": "承知しました。結果を知らせていただき、ありがとうございます。",
          "vi": "Tôi hiểu. Cảm ơn anh đã báo kết quả."
        },
        {
          "id": "741771fa-dc9b-57fd-ac13-3cdcb7ec6359-u03",
          "speaker_id": "A",
          "ja": "面談で具体的なお話を聞かせていただき、ありがとうございました。",
          "vi": "Cảm ơn chị đã chia sẻ các ví dụ cụ thể trong buổi trao đổi."
        }
      ],
