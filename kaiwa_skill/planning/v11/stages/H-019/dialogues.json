    {
      "situation_uid": "f4d2178c-062a-58f3-a9c9-869522bafd67",
      "event_id": "E04",
      "context_vi": "Nam xin Yui nêu dữ kiện còn thiếu trước khi quyết trong tình huống đổi ưu tiên.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "f4d2178c-062a-58f3-a9c9-869522bafd67-u01",
          "speaker_id": "A",
          "ja": "その場で決める前に、どんな情報が足りないと思いますか。",
          "vi": "Trước khi quyết trong tình huống đó, chị thấy còn thiếu thông tin gì?"
        },
        {
          "id": "f4d2178c-062a-58f3-a9c9-869522bafd67-u02",
          "speaker_id": "B",
          "ja": "お客様がいつまでに回答を必要とするか、確認したい内容が一件か複数かです。",
          "vi": "Cần biết khách cần trả lời trước khi nào, và điều muốn kiểm là một việc hay nhiều việc."
        },
        {
          "id": "f4d2178c-062a-58f3-a9c9-869522bafd67-u03",
          "speaker_id": "A",
          "ja": "その二つで、誰に相談するかも変わりそうですね。",
          "vi": "Hai điểm ấy có thể làm thay đổi cả việc phải hỏi ai."
        }
      ],
