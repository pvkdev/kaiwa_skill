    {
      "situation_uid": "ff018d7e-e2ef-5f7e-a5c3-80ca82596ea1",
      "event_id": "E03",
      "context_vi": "Yui chưa từng dùng công cụ quản lý yêu cầu của nhóm. Nam hỏi cách chị sẽ học mà không coi thiếu kinh nghiệm là kết luận sớm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "ff018d7e-e2ef-5f7e-a5c3-80ca82596ea1-u01",
          "speaker_id": "B",
          "ja": "御社の管理ツールは使ったことがありません。",
          "vi": "Tôi chưa dùng công cụ quản lý của công ty anh."
        },
        {
          "id": "ff018d7e-e2ef-5f7e-a5c3-80ca82596ea1-u02",
          "speaker_id": "A",
          "ja": "その点は承知しました。新しいツールを覚える時、これまでどう進めてきましたか。",
          "vi": "Tôi hiểu. Khi học công cụ mới, trước đây chị làm theo cách nào?"
        },
        {
          "id": "ff018d7e-e2ef-5f7e-a5c3-80ca82596ea1-u03",
          "speaker_id": "B",
          "ja": "まず一件の流れを見せてもらい、同じ手順を試して、分からない点をメモします。",
          "vi": "Trước tiên tôi nhờ xem luồng một việc, thử làm theo, rồi ghi lại điểm chưa rõ."
        }
      ],
