    {
      "situation_uid": "4f82ddcf-c2ee-5c15-a43c-b528a0e66ef9",
      "event_id": "E06",
      "context_vi": "Nam khen ví dụ Yui trình bày rõ; Yui tưởng như đã được nhận. Nam sửa ngay mức cam kết.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4f82ddcf-c2ee-5c15-a43c-b528a0e66ef9-u01",
          "speaker_id": "B",
          "ja": "具体例を評価いただいたので、採用は決まったと考えてよいですか。",
          "vi": "Anh đánh giá tốt ví dụ của tôi, vậy có thể hiểu là tôi đã được nhận không ạ?"
        },
        {
          "id": "4f82ddcf-c2ee-5c15-a43c-b528a0e66ef9-u02",
          "speaker_id": "A",
          "ja": "説明が分かりやすかったという感想です。採用の判断はまだ出ていません。紛らわしく聞こえたなら申し訳ありません。",
          "vi": "Tôi chỉ nhận xét chị trình bày dễ hiểu. Quyết định tuyển vẫn chưa có. Nếu tôi nói khiến chị hiểu nhầm thì xin lỗi."
        },
        {
          "id": "4f82ddcf-c2ee-5c15-a43c-b528a0e66ef9-u03",
          "speaker_id": "B",
          "ja": "分かりました。正式な連絡を待ちます。",
          "vi": "Tôi hiểu. Tôi sẽ đợi thông báo chính thức."
        }
      ],
      "admin": {
        "source_refs": [
          "b21_interview"
