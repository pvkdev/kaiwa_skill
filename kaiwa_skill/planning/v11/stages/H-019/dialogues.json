  "dialogues": [
    {
      "situation_uid": "1045df41-8c8a-57c0-a494-37d06e140143",
      "event_id": "E01",
      "context_vi": "Nam phụ trách tuyển điều phối viên hỗ trợ khách. Anh giới thiệu mình và thời lượng buổi phỏng vấn với ứng viên Yui.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "1045df41-8c8a-57c0-a494-37d06e140143-u01",
          "speaker_id": "A",
          "ja": "本日は私が業務について伺います。後半にはチーム長も参加します。全体で四十分ほどですが、よろしいでしょうか。",
          "vi": "Hôm nay tôi sẽ hỏi về công việc. Nửa sau trưởng nhóm sẽ tham gia. Cả buổi khoảng 40 phút, chị thấy được chứ?"
        },
        {
          "id": "1045df41-8c8a-57c0-a494-37d06e140143-u02",
          "speaker_id": "B",
          "ja": "はい。よろしくお願いいたします。",
          "vi": "Vâng. Rất mong được anh trao đổi."
        },
        {
          "id": "1045df41-8c8a-57c0-a494-37d06e140143-u03",
          "speaker_id": "A",
          "ja": "ありがとうございます。最初に仕事内容を短くお伝えします。",
          "vi": "Cảm ơn chị. Trước tiên tôi sẽ giới thiệu ngắn về công việc."
        }
      ],
      "admin": {
        "source_refs": [
          "b16_interview",
          "b21_interview"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1045df41-8c8a-57c0-a494-37d06e140143-u01": {
            "kind": "original_extension"
