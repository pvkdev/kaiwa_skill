    {
      "situation_uid": "9d280464-ab74-54cd-83ac-f0ff2f9c6ad3",
      "event_id": "E03",
      "context_vi": "Nam hỏi kiểu hỗ trợ giúp Yui bắt đầu tốt, không hứa chương trình đào tạo chưa kiểm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9d280464-ab74-54cd-83ac-f0ff2f9c6ad3-u01",
          "speaker_id": "A",
          "ja": "入社した場合、最初の一か月にどんな支援があると仕事を覚えやすいですか。",
          "vi": "Nếu vào làm, tháng đầu chị cần hỗ trợ gì để học việc dễ hơn?"
        },
        {
          "id": "9d280464-ab74-54cd-83ac-f0ff2f9c6ad3-u02",
          "speaker_id": "B",
          "ja": "難しい問い合わせを誰に相談すべきか、一覧があると助かります。",
          "vi": "Tôi sẽ thấy hữu ích nếu có danh sách việc khó thì hỏi ai."
        },
        {
          "id": "9d280464-ab74-54cd-83ac-f0ff2f9c6ad3-u03",
          "speaker_id": "A",
          "ja": "なるほど。今のチームで用意できる形を確認し、次の面談までにお伝えします。",
          "vi": "Tôi hiểu. Tôi sẽ kiểm nhóm hiện có thể chuẩn bị gì rồi báo chị trước buổi trao đổi tiếp."
        }
      ],
