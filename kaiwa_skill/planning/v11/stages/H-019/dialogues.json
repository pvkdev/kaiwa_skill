          }
        }
      }
    },
    {
      "situation_uid": "b49e30a6-8e05-558a-b542-cf98a6b65a15",
      "event_id": "E01",
      "context_vi": "Yui tưởng vị trí này tự quyết việc hoàn tiền cho khách. Nam sửa phạm vi theo quy trình của nhóm đang tuyển.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b49e30a6-8e05-558a-b542-cf98a6b65a15-u01",
          "speaker_id": "B",
          "ja": "返金が必要な場合も、私がその場で決めるのでしょうか。",
          "vi": "Nếu cần hoàn tiền thì tôi tự quyết ngay tại chỗ ạ?"
        },
        {
          "id": "b49e30a6-8e05-558a-b542-cf98a6b65a15-u02",
          "speaker_id": "A",
          "ja": "この職種では、まず事実を確認し、担当チームに判断を依頼します。返金を一人で決める役割ではありません。",
          "vi": "Ở vị trí này, trước hết chị kiểm sự việc rồi chuyển nhóm phụ trách quyết. Đây không phải vai trò tự quyết hoàn tiền."
        },
        {
          "id": "b49e30a6-8e05-558a-b542-cf98a6b65a15-u03",
          "speaker_id": "B",
          "ja": "分かりました。判断を急がず、経緯を整理して渡すのですね。",
          "vi": "Tôi hiểu. Không vội quyết, mà tổng hợp diễn biến để chuyển."
        }
      ],
      "admin": {
        "source_refs": [
          "b21_interview"
        ],
