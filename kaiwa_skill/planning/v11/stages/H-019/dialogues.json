    {
      "situation_uid": "8135b492-a4cc-579e-af7b-2f8af1a6af18",
      "event_id": "E03",
      "context_vi": "Hồ sơ Yui có khoảng nghỉ việc. Nam không ép lý do cá nhân; hỏi năng lực và mức sẵn sàng hiện tại.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8135b492-a4cc-579e-af7b-2f8af1a6af18-u01",
          "speaker_id": "A",
          "ja": "現在、問い合わせ対応の仕事を再開する上で、準備されていることを教えてください。",
          "vi": "Hiện để quay lại công việc hỗ trợ khách, chị đã chuẩn bị những gì?"
        },
        {
          "id": "8135b492-a4cc-579e-af7b-2f8af1a6af18-u02",
          "speaker_id": "B",
          "ja": "文章での回答練習を続け、前職の対応例も整理しました。",
          "vi": "Tôi vẫn luyện trả lời bằng văn bản và sắp xếp lại các ví dụ từ công việc trước."
        },
        {
          "id": "8135b492-a4cc-579e-af7b-2f8af1a6af18-u03",
          "speaker_id": "A",
          "ja": "ありがとうございます。差し支えない範囲で、個人が特定されない一例を後ほど口頭で教えてください。",
          "vi": "Cảm ơn chị. Lát nữa xin chị kể bằng lời một ví dụ không lộ thông tin cá nhân, trong phạm vi có thể chia sẻ."
        }
      ],
