    {
      "situation_uid": "c4e28f10-7563-540f-ad4e-ceb96c47e994",
      "event_id": "E03",
      "context_vi": "Yui chuyển từ ngành cửa hàng sang hỗ trợ trực tuyến. Nam hỏi kỹ năng nào chuyển được.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c4e28f10-7563-540f-ad4e-ceb96c47e994-u01",
          "speaker_id": "A",
          "ja": "店頭での経験から、この仕事にも使える力は何だと思いますか。",
          "vi": "Từ kinh nghiệm tại cửa hàng, chị nghĩ kỹ năng nào áp dụng được vào công việc này?"
        },
        {
          "id": "c4e28f10-7563-540f-ad4e-ceb96c47e994-u02",
          "speaker_id": "B",
          "ja": "相手が急いでいる時ほど、まず要件を短く言い直して確かめることです。",
          "vi": "Khách càng gấp, tôi càng nhắc ngắn lại yêu cầu để xác nhận."
        },
        {
          "id": "c4e28f10-7563-540f-ad4e-ceb96c47e994-u03",
          "speaker_id": "A",
          "ja": "オンラインでは表情が見えない場面もあります。その時はどう確かめますか。",
          "vi": "Trực tuyến có lúc không thấy nét mặt. Khi đó chị sẽ xác nhận thế nào?"
        },
        {
          "id": "c4e28f10-7563-540f-ad4e-ceb96c47e994-u04",
          "speaker_id": "B",
          "ja": "回答する前に、状況と希望する結果を文章で確認します。",
          "vi": "Trước khi trả lời, tôi hỏi lại bằng chữ về tình trạng và kết quả khách mong muốn."
        }
      ],
