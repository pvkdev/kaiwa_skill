    {
      "situation_uid": "636b9d55-1bb2-5519-989c-dacf188b3a8d",
      "event_id": "E06",
      "context_vi": "Nam giải thích các bước tuyển của công ty trong đợt này và mốc dự kiến, không nói kết quả trước quyết định.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "636b9d55-1bb2-5519-989c-dacf188b3a8d-u01",
          "speaker_id": "A",
          "ja": "この後、チーム長との面談内容も合わせて検討します。結果は来週水曜日までに人事からご連絡する予定です。",
          "vi": "Sau đây chúng tôi sẽ xem cùng nội dung trao đổi với trưởng nhóm. Dự kiến nhân sự sẽ báo kết quả trước thứ Tư tuần sau."
        },
        {
          "id": "636b9d55-1bb2-5519-989c-dacf188b3a8d-u02",
          "speaker_id": "B",
          "ja": "承知しました。連絡を待ちます。",
          "vi": "Tôi hiểu. Tôi sẽ chờ thông báo."
        },
        {
          "id": "636b9d55-1bb2-5519-989c-dacf188b3a8d-u03",
          "speaker_id": "A",
          "ja": "予定が変わる場合も、その日までに状況をお伝えします。",
          "vi": "Nếu lịch thay đổi, chúng tôi cũng sẽ báo tình trạng trước ngày đó."
        }
      ],
      "admin": {
