    {
      "situation_uid": "2895a6ae-a699-5d65-baa7-32ccde63b50e",
      "event_id": "E04",
      "context_vi": "Nam hỏi Yui sẽ báo ai khi yêu cầu hoàn tiền vượt quyền của vai này.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2895a6ae-a699-5d65-baa7-32ccde63b50e-u01",
          "speaker_id": "A",
          "ja": "返金の判断が必要になり、ご自身の権限を超える場合、誰に何を伝えますか。",
          "vi": "Khi cần quyết hoàn tiền, vượt quyền của chị, chị sẽ báo ai và báo gì?"
        },
        {
          "id": "2895a6ae-a699-5d65-baa7-32ccde63b50e-u02",
          "speaker_id": "B",
          "ja": "担当チームの責任者へ、注文番号、経緯、客の希望と確認済みの事実を伝えます。",
          "vi": "Tôi sẽ báo người phụ trách nhóm liên quan mã đơn, diễn biến, mong muốn của khách và những sự việc đã kiểm."
        },
        {
          "id": "2895a6ae-a699-5d65-baa7-32ccde63b50e-u03",
          "speaker_id": "A",
          "ja": "判断前に事実と希望を分けるのですね。",
          "vi": "Vậy trước khi họ quyết, chị tách điều đã xác nhận và điều khách mong muốn."
        }
      ],
