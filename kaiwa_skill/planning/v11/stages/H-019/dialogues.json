    {
      "situation_uid": "2484e670-2b55-58e8-b7b7-950fe4ad44a1",
      "event_id": "E05",
      "context_vi": "Yui hỏi có thể chuyển sang vai khác ngay sau vài tháng không. Nam chỉ nói được về lộ trình học hiện tại, chưa hứa vị trí khác.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2484e670-2b55-58e8-b7b7-950fe4ad44a1-u01",
          "speaker_id": "B",
          "ja": "数か月後に、別の部署へ移る可能性はありますか。",
          "vi": "Sau vài tháng, có khả năng chuyển sang bộ phận khác không ạ?"
        },
        {
          "id": "2484e670-2b55-58e8-b7b7-950fe4ad44a1-u02",
          "speaker_id": "A",
          "ja": "今この面談で、異動をお約束することはできません。この職種では、まず基本の問い合わせを担当し、次に複雑な案件を先輩と扱う予定です。",
          "vi": "Trong buổi này tôi không thể hứa điều chuyển. Ở vị trí này, ban đầu chị xử lý yêu cầu cơ bản, rồi làm việc phức tạp cùng người đi trước."
        },
        {
          "id": "2484e670-2b55-58e8-b7b7-950fe4ad44a1-u03",
          "speaker_id": "B",
          "ja": "まず応募している職種の段階を理解しました。",
          "vi": "Trước mắt tôi đã hiểu các bước của vị trí mình ứng tuyển."
        }
      ],
      "admin": {
        "source_refs": [
