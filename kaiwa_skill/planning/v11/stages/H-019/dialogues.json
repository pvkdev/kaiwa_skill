    {
      "situation_uid": "5492a338-5719-5e86-9f98-ae8df9a42d4d",
      "event_id": "E05",
      "context_vi": "Yui hỏi mức lương theo phụ cấp cụ thể. Nam chưa có bảng điều kiện, hẹn nhân sự trả lời đúng đầu mối.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "5492a338-5719-5e86-9f98-ae8df9a42d4d-u01",
          "speaker_id": "B",
          "ja": "勤務条件にある手当は、月額に含まれていますか。",
          "vi": "Khoản phụ cấp ghi trong điều kiện làm việc đã nằm trong mức tháng chưa ạ?"
        },
        {
          "id": "5492a338-5719-5e86-9f98-ae8df9a42d4d-u02",
          "speaker_id": "A",
          "ja": "その内訳は私の手元で確認できません。人事の担当者から、書面の条件に沿ってご案内します。",
          "vi": "Phần chi tiết đó hiện tôi không kiểm được. Người phụ trách nhân sự sẽ giải thích theo điều kiện bằng văn bản."
        },
        {
          "id": "5492a338-5719-5e86-9f98-ae8df9a42d4d-u03",
          "speaker_id": "B",
          "ja": "分かりました。窓口を教えていただけますか。",
          "vi": "Tôi hiểu. Anh cho tôi đầu mối được không?"
        },
        {
          "id": "5492a338-5719-5e86-9f98-ae8df9a42d4d-u04",
          "speaker_id": "A",
          "ja": "面談後、人事の連絡先と回答予定日をお伝えします。",
          "vi": "Sau buổi này, tôi sẽ gửi địa chỉ liên hệ của nhân sự và ngày dự kiến trả lời."
        }
      ],
