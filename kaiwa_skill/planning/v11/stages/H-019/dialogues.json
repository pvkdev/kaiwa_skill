    {
      "situation_uid": "0cc24572-8d9c-5d5b-af63-7cc41196ed8a",
      "event_id": "E05",
      "context_vi": "Nam hỏi Yui còn băn khoăn điều gì về vai sau khi đã mô tả công việc.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0cc24572-8d9c-5d5b-af63-7cc41196ed8a-u01",
          "speaker_id": "A",
          "ja": "ここまで伺って、仕事内容で気になっている点はありますか。",
          "vi": "Tới đây, chị còn băn khoăn gì về nội dung công việc không?"
        },
        {
          "id": "0cc24572-8d9c-5d5b-af63-7cc41196ed8a-u02",
          "speaker_id": "B",
          "ja": "問い合わせの種類が広いので、覚える順番が気になります。",
          "vi": "Loại yêu cầu khá rộng nên tôi băn khoăn thứ tự học."
        },
        {
          "id": "0cc24572-8d9c-5d5b-af63-7cc41196ed8a-u03",
          "speaker_id": "A",
          "ja": "よく分かりました。最初に扱う範囲と、後から増える範囲を確認してお伝えします。",
          "vi": "Tôi hiểu. Tôi sẽ kiểm rồi báo phần ban đầu xử lý và phần tăng thêm sau."
        }
      ],
      "admin": {
        "source_refs": [
          "b21_interview"
        ],
