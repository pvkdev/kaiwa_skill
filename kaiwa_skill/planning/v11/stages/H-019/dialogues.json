            "kind": "original_extension"
          },
          "b62c9dd0-42da-5ff4-be05-9fa92dd4ec8a-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "1c1fa19b-47c8-55c8-8ad1-f812350ba08f",
      "event_id": "E02",
      "context_vi": "Yui nói “cả nhóm giải quyết”. Nam hỏi phần riêng của chị và phần người khác làm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "1c1fa19b-47c8-55c8-8ad1-f812350ba08f-u01",
          "speaker_id": "B",
          "ja": "チームで連絡先を探して、届け先を修正しました。",
          "vi": "Cả nhóm tìm đầu mối liên hệ và sửa địa chỉ giao."
        },
        {
          "id": "1c1fa19b-47c8-55c8-8ad1-f812350ba08f-u02",
          "speaker_id": "A",
          "ja": "その中で、由衣さんが直接担当したのはどこですか。ほかの方が行った部分も分けて教えてください。",
          "vi": "Trong đó phần chị Yui trực tiếp phụ trách là gì? Xin nói riêng cả phần người khác làm."
        },
        {
          "id": "1c1fa19b-47c8-55c8-8ad1-f812350ba08f-u03",
          "speaker_id": "B",
          "ja": "私は注文記録を確認して運送会社へ状況を聞き、変更の手続きは先輩がしました。",
          "vi": "Tôi kiểm hồ sơ đơn và hỏi hãng vận chuyển; thủ tục đổi thì người đi trước làm."
        }
      ],
      "admin": {
        "source_refs": [
          "b16_interview"
        ],
