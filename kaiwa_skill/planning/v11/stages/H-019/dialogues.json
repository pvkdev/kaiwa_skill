    {
      "situation_uid": "6a32d40e-7e73-54ba-a375-bb02ba2e7612",
      "event_id": "E04",
      "context_vi": "Nam đưa tình huống giả định khách đổi ưu tiên sau khi đã gửi yêu cầu hỗ trợ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "6a32d40e-7e73-54ba-a375-bb02ba2e7612-u01",
          "speaker_id": "A",
          "ja": "お客様が「早さより、内容を正確に確認したい」と途中で優先順位を変えたら、まず何をしますか。",
          "vi": "Nếu khách đang làm việc với nhóm mà đổi ưu tiên từ “nhanh” sang “muốn kiểm nội dung chính xác”, trước tiên chị làm gì?"
        },
        {
          "id": "6a32d40e-7e73-54ba-a375-bb02ba2e7612-u02",
          "speaker_id": "B",
          "ja": "何を確認したいのか具体的に聞き、すでに約束した返事の時刻も見直します。",
          "vi": "Tôi sẽ hỏi cụ thể họ muốn kiểm gì, đồng thời xem lại giờ phản hồi đã hẹn."
        },
        {
          "id": "6a32d40e-7e73-54ba-a375-bb02ba2e7612-u03",
          "speaker_id": "A",
          "ja": "約束済みの時刻に影響が出そうなら、どう伝えますか。",
          "vi": "Nếu có khả năng ảnh hưởng giờ đã hẹn, chị sẽ nói thế nào?"
        },
        {
          "id": "6a32d40e-7e73-54ba-a375-bb02ba2e7612-u04",
          "speaker_id": "B",
          "ja": "分かった時点で、確認中の点と次の連絡時刻を伝えます。",
          "vi": "Ngay khi biết, tôi sẽ báo điều đang kiểm và giờ liên hệ tiếp."
        }
      ],
