        }
      }
    },
    {
      "situation_uid": "882fe7ea-f1cd-513c-b9ed-35b185f25e3a",
      "event_id": "E02",
      "context_vi": "Nam hỏi kết quả và điều Yui học từ trường hợp địa chỉ giao sai.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "882fe7ea-f1cd-513c-b9ed-35b185f25e3a-u01",
          "speaker_id": "A",
          "ja": "配送先の件は、最後にどうなりましたか。また、次に備えて何を変えましたか。",
          "vi": "Cuối cùng vụ địa chỉ giao sai ra sao? Và để chuẩn bị lần sau chị đã đổi điều gì?"
        },
        {
          "id": "882fe7ea-f1cd-513c-b9ed-35b185f25e3a-u02",
          "speaker_id": "B",
          "ja": "発送前だったので変更できました。以後は、相談を受けた時点で発送済みかを最初に確かめるようにしました。",
          "vi": "Vì hàng chưa xuất nên đã đổi được. Từ đó tôi kiểm ngay đã xuất hay chưa khi nhận yêu cầu."
        },
        {
          "id": "882fe7ea-f1cd-513c-b9ed-35b185f25e3a-u03",
          "speaker_id": "A",
          "ja": "結果だけでなく、確認の順番を変えたのですね。",
          "vi": "Vậy chị không chỉ xử lý xong mà còn đổi thứ tự kiểm."
        }
      ],
      "admin": {
