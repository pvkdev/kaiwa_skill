        }
      }
    },
    {
      "situation_uid": "b62c9dd0-42da-5ff4-be05-9fa92dd4ec8a",
      "event_id": "E02",
      "context_vi": "Nam xin một ví dụ Yui tự xử lý yêu cầu khó ở công việc trước.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b62c9dd0-42da-5ff4-be05-9fa92dd4ec8a-u01",
          "speaker_id": "A",
          "ja": "以前の仕事で、ご自身が対応した難しい問い合わせを一つ教えてください。",
          "vi": "Chị kể một yêu cầu khó mà chính chị xử lý ở công việc trước được không?"
        },
        {
          "id": "b62c9dd0-42da-5ff4-be05-9fa92dd4ec8a-u02",
          "speaker_id": "B",
          "ja": "配送先を間違えたという連絡がありました。まず注文内容と発送状況を確認しました。",
          "vi": "Có khách báo địa chỉ giao sai. Trước tiên tôi kiểm nội dung đơn và tình trạng xuất hàng."
        },
        {
          "id": "b62c9dd0-42da-5ff4-be05-9fa92dd4ec8a-u03",
          "speaker_id": "A",
          "ja": "その後、どの段階までご自身で進めましたか。",
          "vi": "Sau đó chính chị xử lý tới bước nào?"
        }
      ],
      "admin": {
        "source_refs": [
          "b16_interview"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "b62c9dd0-42da-5ff4-be05-9fa92dd4ec8a-u01": {
            "kind": "original_extension"
          },
