            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "c823fce1-ebb2-5fea-9918-6708f83032b8",
      "event_id": "E01",
      "context_vi": "Nam nói rõ anh phỏng vấn về cách làm, trưởng nhóm phụ trách công việc sẽ xem phần phối hợp nhóm.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c823fce1-ebb2-5fea-9918-6708f83032b8-u01",
          "speaker_id": "A",
          "ja": "私はお客様対応の経験を伺います。後から参加するチーム長は、日々の連携について質問します。",
          "vi": "Tôi sẽ hỏi kinh nghiệm hỗ trợ khách. Trưởng nhóm tham gia sau sẽ hỏi việc phối hợp hằng ngày."
        },
        {
          "id": "c823fce1-ebb2-5fea-9918-6708f83032b8-u02",
          "speaker_id": "B",
          "ja": "分かりました。経験と働き方を分けてお話しします。",
          "vi": "Tôi hiểu. Tôi sẽ trình bày riêng về kinh nghiệm và cách làm việc."
        },
        {
          "id": "c823fce1-ebb2-5fea-9918-6708f83032b8-u03",
          "speaker_id": "A",
          "ja": "具体例があれば、状況とご自身の役割も教えてください。",
          "vi": "Nếu có ví dụ cụ thể, xin chị nói cả tình huống và phần mình đảm nhận."
        }
      ],
      "admin": {
        "source_refs": [
          "b16_interview"
        ],
        "specialty_item_ids": [],
