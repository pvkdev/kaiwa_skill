    {
      "situation_uid": "e9d25e12-d54a-5ffb-9b87-e2c74924fb35",
      "event_id": "E05",
      "context_vi": "Nam mời Yui hỏi về công việc hằng ngày, không chỉ hỏi “có câu hỏi không” qua loa.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e9d25e12-d54a-5ffb-9b87-e2c74924fb35-u01",
          "speaker_id": "A",
          "ja": "こちらからの質問は以上です。日々の問い合わせの数や、担当の分け方など、確認したいことはありますか。",
          "vi": "Phần tôi hỏi đã xong. Chị muốn hỏi gì về số yêu cầu hằng ngày hay cách chia người phụ trách không?"
        },
        {
          "id": "e9d25e12-d54a-5ffb-9b87-e2c74924fb35-u02",
          "speaker_id": "B",
          "ja": "担当は、最初から一人で受けるのでしょうか。",
          "vi": "Ban đầu một người tự nhận việc luôn ạ?"
        },
        {
          "id": "e9d25e12-d54a-5ffb-9b87-e2c74924fb35-u03",
          "speaker_id": "A",
          "ja": "最初は先輩と一緒に記録を見ます。独り立ちの時期は、理解の状況を見て決めます。",
          "vi": "Lúc đầu chị xem hồ sơ cùng người đi trước. Khi nào tự làm sẽ tùy mức nắm việc."
        }
      ],
