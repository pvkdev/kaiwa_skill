      }
    },
    {
      "situation_uid": "8fd8828b-9a0c-5c6d-a2cb-1d612d038141",
      "event_id": "E01",
      "context_vi": "Nam hỏi Yui hiểu vị trí điều phối viên ra sao trước khi giải thích chi tiết.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "8fd8828b-9a0c-5c6d-a2cb-1d612d038141-u01",
          "speaker_id": "A",
          "ja": "応募された仕事を、今どのように理解されていますか。",
          "vi": "Hiện chị hiểu công việc mình ứng tuyển như thế nào?"
        },
        {
          "id": "8fd8828b-9a0c-5c6d-a2cb-1d612d038141-u02",
          "speaker_id": "B",
          "ja": "問い合わせに答えながら、必要な時は担当部署へつなぐ仕事だと思います。",
          "vi": "Tôi hiểu là trả lời yêu cầu của khách và chuyển tới bộ phận phụ trách khi cần."
        },
        {
          "id": "8fd8828b-9a0c-5c6d-a2cb-1d612d038141-u03",
          "speaker_id": "A",
          "ja": "その理解で大筋合っています。特に、回答後の状況を追うところも大事です。",
          "vi": "Chị hiểu đúng phần lớn. Việc theo dõi sau khi trả lời cũng là phần quan trọng."
        }
      ],
      "admin": {
        "source_refs": [
          "b21_interview"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8fd8828b-9a0c-5c6d-a2cb-1d612d038141-u01": {
            "kind": "original_extension"
