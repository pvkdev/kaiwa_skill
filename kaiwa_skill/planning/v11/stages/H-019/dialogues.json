    {
      "situation_uid": "815642bc-317a-5d30-a49e-29c6dc31de02",
      "event_id": "E06",
      "context_vi": "Đến thứ Tư, việc xét vẫn đang diễn ra. Nam báo Yui mốc mới thay vì im lặng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "815642bc-317a-5d30-a49e-29c6dc31de02-u01",
          "speaker_id": "A",
          "ja": "お約束した水曜日になりましたが、選考がまだ終わっていません。ご連絡が遅れ、申し訳ありません。金曜日の午後までに人事から状況をお知らせします。",
          "vi": "Đã tới thứ Tư như hẹn nhưng việc xét vẫn chưa xong. Xin lỗi vì báo chậm. Trước chiều thứ Sáu nhân sự sẽ thông báo tình trạng."
        },
        {
          "id": "815642bc-317a-5d30-a49e-29c6dc31de02-u02",
          "speaker_id": "B",
          "ja": "ご連絡ありがとうございます。金曜日まで待ちます。",
          "vi": "Cảm ơn anh đã báo. Tôi sẽ chờ tới thứ Sáu."
        },
        {
          "id": "815642bc-317a-5d30-a49e-29c6dc31de02-u03",
          "speaker_id": "A",
          "ja": "結果が出ていない場合も、その時点の状況をお送りします。",
          "vi": "Dù chưa có kết quả, lúc ấy chúng tôi vẫn sẽ báo tình trạng."
        }
      ],
