        }
      }
    },
    {
      "situation_uid": "ebf91f65-b991-5ad3-9581-5f502b80a35b",
      "event_id": "E02",
      "context_vi": "Yui dùng “chúng tôi giảm phản hồi chậm 20%”. Nam hỏi đóng góp của riêng chị, không gán hết thành tích nhóm cho cá nhân.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Nam, người tuyển dụng",
          "gender": "male"
        },
        {
          "id": "B",
          "role_vi": "Yui, ứng viên",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "ebf91f65-b991-5ad3-9581-5f502b80a35b-u01",
          "speaker_id": "B",
          "ja": "その後、チームの返信遅れが二割減りました。",
          "vi": "Sau đó tỷ lệ phản hồi chậm của nhóm giảm 20%."
        },
        {
          "id": "ebf91f65-b991-5ad3-9581-5f502b80a35b-u02",
          "speaker_id": "A",
          "ja": "それはチームの結果ですね。由衣さんが特に変えた手順は何でしたか。",
          "vi": "Đó là kết quả của nhóm. Riêng chị đã thay đổi bước nào?"
        },
        {
          "id": "ebf91f65-b991-5ad3-9581-5f502b80a35b-u03",
          "speaker_id": "B",
          "ja": "未回答の件を毎朝一覧にして、担当者が決まっていないものを先に確認しました。",
          "vi": "Mỗi sáng tôi lập danh sách các yêu cầu chưa trả lời, ưu tiên kiểm những việc chưa có người phụ trách."
        }
      ],
      "admin": {
        "source_refs": [
          "b16_interview"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ebf91f65-b991-5ad3-9581-5f502b80a35b-u01": {
