        }
      ],
      "turns": [
        {
          "id": "9ef90b29-54aa-53d4-8cd0-e8675687cf74-u01",
          "speaker_id": "a",
          "ja": "電話をもらって、かばんを見に来ました。私のは青くて、内側に名前があります。",
          "vi": "Tôi nhận được cuộc gọi nên đến xem túi. Túi của tôi màu xanh, bên trong có ghi tên."
        },
        {
          "id": "9ef90b29-54aa-53d4-8cd0-e8675687cf74-u02",
          "speaker_id": "b",
          "ja": "こちらで確認します。お名前も教えてください。",
          "vi": "Chúng tôi sẽ đối chiếu. Cho tôi xin tên của bạn."
        },
        {
          "id": "9ef90b29-54aa-53d4-8cd0-e8675687cf74-u03",
          "speaker_id": "a",
          "ja": "リンです。",
          "vi": "Tôi là Linh ạ."
