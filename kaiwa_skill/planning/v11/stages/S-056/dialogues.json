    {
      "situation_uid": "46e300fd-b099-54a0-9c36-e75bf802a50c",
      "event_id": "E04",
      "context_vi": "Bạn vừa giao chiếc ô nhặt ở ghế trước ga. Sau khi xác nhận việc bàn giao, bạn nói thêm mình cũng mất ví và nghĩ nó rơi ngoài đường, để cảnh sát lập hồ sơ riêng.",
