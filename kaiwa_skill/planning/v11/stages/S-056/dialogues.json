            "kind": "original_extension"
          },
          "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "66a4faee-228d-56ba-af47-95790ee514ea",
      "event_id": "E02",
      "context_vi": "Sau khi nộp thông tin ví mất, bạn muốn biết chốt cảnh sát liên hệ bằng cách nào nếu có chiếc ví phù hợp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "66a4faee-228d-56ba-af47-95790ee514ea-u01",
          "speaker_id": "a",
          "ja": "似た財布が届いたら、電話で知らせていただけますか。",
          "vi": "Nếu có ai nộp chiếc ví giống vậy, anh gọi báo cho tôi được không ạ?"
        },
        {
          "id": "66a4faee-228d-56ba-af47-95790ee514ea-u02",
          "speaker_id": "b",
          "ja": "この番号に電話します。届出の番号はこの紙にあります。",
          "vi": "Chúng tôi sẽ gọi số bạn ghi ở đây. Mã hồ sơ báo mất ở trên tờ giấy này."
        },
        {
          "id": "66a4faee-228d-56ba-af47-95790ee514ea-u03",
          "speaker_id": "a",
          "ja": "はい、その番号なら出られます。",
          "vi": "Vâng, tôi nghe được ở số đó ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "66a4faee-228d-56ba-af47-95790ee514ea-u01": {
            "kind": "original_extension"
          },
          "66a4faee-228d-56ba-af47-95790ee514ea-u02": {
            "kind": "original_extension"
          },
          "66a4faee-228d-56ba-af47-95790ee514ea-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "7af7b411-be9b-59b0-aac1-1ca45b50d55c",
      "event_id": "E02",
      "context_vi": "Hôm sau bạn gọi lại chốt cảnh sát theo mã hồ sơ. Hiện chưa có chiếc ví phù hợp, bạn hỏi cách theo dõi tiếp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7af7b411-be9b-59b0-aac1-1ca45b50d55c-u01",
          "speaker_id": "b",
          "ja": "今は合う財布が届いていません。",
          "vi": "Hiện chưa có ví nào khớp mô tả ạ."
        },
        {
          "id": "7af7b411-be9b-59b0-aac1-1ca45b50d55c-u02",
          "speaker_id": "a",
          "ja": "いつ、どの番号にもう一度聞けばいいですか。",
          "vi": "Khi nào tôi có thể hỏi lại, và gọi số nào ạ?"
        },
        {
          "id": "7af7b411-be9b-59b0-aac1-1ca45b50d55c-u03",
          "speaker_id": "b",
          "ja": "明日以降、この控えにある電話番号にかけて、届出番号を伝えてください。",
          "vi": "Từ ngày mai, chị gọi số điện thoại ghi trên bản giữ này và đọc mã báo mất nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "7af7b411-be9b-59b0-aac1-1ca45b50d55c-u01": {
            "kind": "original_extension"
