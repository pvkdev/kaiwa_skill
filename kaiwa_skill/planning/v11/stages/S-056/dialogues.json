    {
      "situation_uid": "2a04fb0d-f7aa-5ba2-b31c-ab59e963aec0",
      "event_id": "E03",
      "context_vi": "Sau cuộc gọi báo mất thẻ, bạn nghe không rõ thẻ đã bị ngừng sử dụng hay còn chờ. Bạn hỏi lại ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phát hành thẻ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2a04fb0d-f7aa-5ba2-b31c-ab59e963aec0-u01",
          "speaker_id": "a",
          "ja": "すみません。カードはもう使えなくなりましたか。手続きはまだですか。",
          "vi": "Xin lỗi, thẻ đã bị khóa rồi hay vẫn đang xử lý ạ?"
        },
        {
          "id": "2a04fb0d-f7aa-5ba2-b31c-ab59e963aec0-u02",
          "speaker_id": "b",
          "ja": "本人確認が終わり、今は利用停止です。",
          "vi": "Đã xác minh xong và thẻ hiện đã ngừng sử dụng."
        },
        {
          "id": "2a04fb0d-f7aa-5ba2-b31c-ab59e963aec0-u03",
          "speaker_id": "a",
          "ja": "今はそのカードを使えないんですね。",
          "vi": "Vậy hiện giờ không dùng được thẻ đó, đúng không ạ?"
        }
      ],
