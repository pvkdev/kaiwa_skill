          }
        }
      }
    },
    {
      "situation_uid": "26c7bc0e-9417-519d-a8a0-c15fe568527c",
      "event_id": "E02",
      "context_vi": "Chốt cảnh sát cho bạn xem ảnh một chiếc ví mới nhận. Nó giống kích cỡ nhưng khác màu ví bạn đã báo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "26c7bc0e-9417-519d-a8a0-c15fe568527c-u01",
          "speaker_id": "b",
          "ja": "この財布はお探しの物ですか。",
          "vi": "Đây có phải ví bạn đang tìm không ạ?"
        },
        {
          "id": "26c7bc0e-9417-519d-a8a0-c15fe568527c-u02",
          "speaker_id": "a",
          "ja": "いいえ、私の財布は黒いです。これは茶色です。私のではありません。",
          "vi": "Không ạ. Ví của tôi màu đen, chiếc này màu nâu. Đây không phải của tôi."
        },
        {
          "id": "26c7bc0e-9417-519d-a8a0-c15fe568527c-u03",
          "speaker_id": "b",
          "ja": "分かりました。届出はそのまま残します。",
          "vi": "Tôi hiểu. Hồ sơ báo mất của bạn vẫn được giữ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "26c7bc0e-9417-519d-a8a0-c15fe568527c-u01": {
