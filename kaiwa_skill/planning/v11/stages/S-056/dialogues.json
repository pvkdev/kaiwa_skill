    {
      "situation_uid": "ed4a6da4-ab18-5eb8-a6d5-bc617b3d2cf3",
      "event_id": "E03",
      "context_vi": "Bạn đã báo mất và ngân hàng xác nhận thẻ ATM bị khóa. Bạn tìm lại ví cùng thẻ trước khi xin cấp lại. Bạn gọi ngân hàng hỏi cách dùng lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phát hành thẻ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ed4a6da4-ab18-5eb8-a6d5-bc617b3d2cf3-u01",
          "speaker_id": "a",
          "ja": "なくしたキャッシュカードが見つかりました。まだ再発行は頼んでいません。そのまま使えますか。",
          "vi": "Tôi tìm lại được thẻ ATM đã mất. Tôi chưa xin cấp lại. Tôi dùng luôn thẻ này được không ạ?"
        },
        {
          "id": "ed4a6da4-ab18-5eb8-a6d5-bc617b3d2cf3-u02",
          "speaker_id": "b",
          "ja": "まだ使えません。利用を再開する手続きが必要です。",
          "vi": "Thẻ chưa dùng được ạ. Chị cần làm thủ tục mở lại."
        },
        {
          "id": "ed4a6da4-ab18-5eb8-a6d5-bc617b3d2cf3-u03",
          "speaker_id": "a",
          "ja": "どこで手続きすればいいですか。",
          "vi": "Tôi làm thủ tục ở đâu ạ?"
        },
        {
          "id": "ed4a6da4-ab18-5eb8-a6d5-bc617b3d2cf3-u04",
          "speaker_id": "b",
          "ja": "このカードなら、銀行の窓口でご相談いただけます。",
          "vi": "Với thẻ này, chị có thể hỏi tại quầy ngân hàng ạ."
        }
      ],
