    {
      "situation_uid": "a006449d-402f-5906-b7f5-0873ff82ec5e",
      "event_id": "E03",
      "context_vi": "Ví mất có thẻ ngân hàng. Bạn gọi số chính thức của đơn vị phát hành ghi trong ứng dụng ngân hàng để xin ngăn sử dụng thẻ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phát hành thẻ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a006449d-402f-5906-b7f5-0873ff82ec5e-u01",
          "speaker_id": "a",
          "ja": "キャッシュカードが入った財布をなくしました。カードを止めてください。",
          "vi": "Tôi làm mất ví có thẻ ATM trong đó. Nhờ khóa thẻ giúp tôi ạ."
        },
        {
          "id": "a006449d-402f-5906-b7f5-0873ff82ec5e-u02",
          "speaker_id": "b",
          "ja": "承りました。ご本人の確認をしてから利用を止めます。",
          "vi": "Tôi tiếp nhận. Sau khi xác minh chủ thẻ, chúng tôi sẽ ngừng sử dụng thẻ."
        },
        {
          "id": "a006449d-402f-5906-b7f5-0873ff82ec5e-u03",
          "speaker_id": "a",
          "ja": "確認をお願いします。",
