    {
      "situation_uid": "9ef90b29-54aa-53d4-8cd0-e8675687cf74",
      "event_id": "E04",
      "context_vi": "Chốt cảnh sát báo đã nhận một chiếc túi giống đồ bạn mất. Bạn đến nhận và nêu dấu riêng để họ đối chiếu.",
      "speakers": [
