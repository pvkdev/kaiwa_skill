    {
      "situation_uid": "15e31a85-4c4e-55a0-b424-d10005b771eb",
      "event_id": "E05",
      "context_vi": "Sau khi báo chốt cảnh sát và quầy ga về ví, nhân viên ga nói có một ví giống mô tả. Bạn hỏi dấu riêng trước khi đến nhận.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "15e31a85-4c4e-55a0-b424-d10005b771eb-u01",
          "speaker_id": "b",
          "ja": "黒い財布をお預かりしています。駅の預り番号は四五六です。",
          "vi": "Chúng tôi đang giữ một chiếc ví màu đen. Mã giữ đồ của ga là 456."
        },
        {
          "id": "15e31a85-4c4e-55a0-b424-d10005b771eb-u02",
          "speaker_id": "a",
          "ja": "表に赤い星がありますか。私の財布ならあります。",
          "vi": "Mặt trước có ngôi sao đỏ không ạ? Nếu là ví của tôi thì có."
        },
        {
          "id": "15e31a85-4c4e-55a0-b424-d10005b771eb-u03",
          "speaker_id": "b",
          "ja": "外側を確認してから、折り返しご連絡します。",
          "vi": "Chúng tôi sẽ kiểm tra bên ngoài rồi gọi lại."
        }
      ],
