        }
      }
    },
    {
      "situation_uid": "949414a7-76b2-5ca4-94ef-441a1201b731",
      "event_id": "E02",
      "context_vi": "Sau khi báo mất, bạn nhớ thêm dấu nhận diện: bên trong ví có một tấm ảnh nhỏ. Bạn gọi lại và đọc mã hồ sơ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "949414a7-76b2-5ca4-94ef-441a1201b731-u01",
          "speaker_id": "a",
          "ja": "届出番号は一二三です。財布の中に小さい写真も入っていました。追加できますか。",
          "vi": "Mã hồ sơ của tôi là 123. Trong ví còn có một tấm ảnh nhỏ. Tôi bổ sung được không ạ?"
        },
        {
          "id": "949414a7-76b2-5ca4-94ef-441a1201b731-u02",
          "speaker_id": "b",
          "ja": "はい。小さい写真を追加します。",
          "vi": "Được. Tôi sẽ bổ sung tấm ảnh nhỏ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "949414a7-76b2-5ca4-94ef-441a1201b731-u01": {
            "kind": "original_extension"
          },
          "949414a7-76b2-5ca4-94ef-441a1201b731-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "a006449d-402f-5906-b7f5-0873ff82ec5e",
      "event_id": "E03",
      "context_vi": "Ví mất có thẻ ngân hàng. Bạn gọi số chính thức của đơn vị phát hành ghi trong ứng dụng ngân hàng để xin ngăn sử dụng thẻ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phát hành thẻ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a006449d-402f-5906-b7f5-0873ff82ec5e-u01",
          "speaker_id": "a",
          "ja": "財布と銀行のカードをなくしました。カードを止めたいです。",
          "vi": "Tôi bị mất ví và thẻ ngân hàng. Tôi muốn khóa thẻ."
        },
        {
          "id": "a006449d-402f-5906-b7f5-0873ff82ec5e-u02",
          "speaker_id": "b",
          "ja": "承りました。ご本人の確認をしてから利用を止めます。",
          "vi": "Tôi tiếp nhận. Sau khi xác minh chủ thẻ, chúng tôi sẽ ngừng sử dụng thẻ."
        },
        {
          "id": "a006449d-402f-5906-b7f5-0873ff82ec5e-u03",
          "speaker_id": "a",
          "ja": "確認をお願いします。",
          "vi": "Xin tiến hành xác minh giúp tôi."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
