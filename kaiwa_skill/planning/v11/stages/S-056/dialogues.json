    {
      "situation_uid": "f8aed76c-6b85-5277-ba39-6fae109505b5",
      "event_id": "E04",
      "context_vi": "Bạn nhặt được một chiếc ô ở ghế trên quảng trường công cộng ngoài cửa bắc ga Aoi và mang tới chốt cảnh sát.",
      "speakers": [
        {
          "id": "a",
