    {
      "situation_uid": "e8b2b988-a3b8-5430-b0fb-cd54a6011f64",
      "event_id": "E03",
      "context_vi": "Bạn gọi đúng số báo mất thẻ trên trang ngân hàng. Nhân viên bắt đầu xác minh bằng cách hỏi tên và ngày sinh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
