    {
      "situation_uid": "6447d9eb-4ff8-5727-aaa4-1ae2f5e78a2f",
      "event_id": "E04",
      "context_vi": "Chiếc túi có vẻ đúng của bạn, nhưng hôm nay bạn chưa mang giấy tờ xác minh. Bạn hỏi khi nào quay lại và cần đem gì.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6447d9eb-4ff8-5727-aaa4-1ae2f5e78a2f-u01",
          "speaker_id": "a",
          "ja": "今日は本人確認の書類がありません。明日、もう一度来てもいいですか。何を持って来ればいいですか。",
          "vi": "Hôm nay tôi không mang giấy tờ xác minh. Ngày mai tôi quay lại được không, và cần mang gì ạ?"
        },
        {
          "id": "6447d9eb-4ff8-5727-aaa4-1ae2f5e78a2f-u02",
          "speaker_id": "b",
          "ja": "はい。お知らせの紙と、本人確認ができる書類を持って来てください。",
          "vi": "Được ạ. Chị mang tờ thông báo và giấy tờ xác minh danh tính nhé."
        },
        {
          "id": "6447d9eb-4ff8-5727-aaa4-1ae2f5e78a2f-u03",
          "speaker_id": "a",
          "ja": "明日、二つとも持って来ます。",
          "vi": "Ngày mai tôi sẽ mang cả hai."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
