          "18701e39-1c9f-59d1-8aa7-615907a15c6d-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45",
      "event_id": "E01",
      "context_vi": "Bạn đã báo mất ví ở chốt cảnh sát. Cảnh sát hỏi dấu nhận diện để đối chiếu nếu có người giao ví.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45-u01",
          "speaker_id": "b",
          "ja": "財布の色と大きさを教えてください。",
          "vi": "Cho tôi biết màu và kích thước ví ạ?"
        },
        {
          "id": "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45-u02",
          "speaker_id": "a",
          "ja": "黒くて、小さい財布です。前に赤い星があります。",
          "vi": "Ví nhỏ màu đen, mặt trước có hình ngôi sao đỏ."
        },
        {
          "id": "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45-u03",
          "speaker_id": "b",
          "ja": "黒い小さい財布で、赤い星ですね。",
          "vi": "Ví nhỏ màu đen, có ngôi sao đỏ ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45-u01": {
            "kind": "original_extension"
          },
