  "dialogues": [
    {
      "situation_uid": "ee2bc21f-051b-5e12-b151-240d300ee2c7",
      "event_id": "E01",
      "context_vi": "Bạn vừa xuống tàu, đến chốt cảnh sát để báo mất ví. Bạn nhớ rõ lúc cuối cùng còn cầm nó.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ee2bc21f-051b-5e12-b151-240d300ee2c7-u01",
          "speaker_id": "a",
          "ja": "すみません。財布をなくしました。電車を降りる時は持っていました。",
          "vi": "Xin lỗi, tôi bị mất ví. Lúc xuống tàu tôi vẫn còn cầm nó."
        },
        {
          "id": "ee2bc21f-051b-5e12-b151-240d300ee2c7-u02",
          "speaker_id": "b",
          "ja": "どの駅で降りましたか。",
          "vi": "Bạn xuống ở ga nào ạ?"
        },
        {
          "id": "ee2bc21f-051b-5e12-b151-240d300ee2c7-u03",
          "speaker_id": "a",
          "ja": "あおい駅です。",
          "vi": "Ga Aoi ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ee2bc21f-051b-5e12-b151-240d300ee2c7-u01": {
            "kind": "original_extension"
          },
          "ee2bc21f-051b-5e12-b151-240d300ee2c7-u02": {
            "kind": "original_extension"
          },
          "ee2bc21f-051b-5e12-b151-240d300ee2c7-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "136b713d-c44a-53ed-a33f-656e985027a2",
      "event_id": "E01",
      "context_vi": "Cảnh sát hỏi trong ví có gì. Bạn chắc có tiền mặt và thẻ ngân hàng, còn chiếc thẻ khác thì chưa chắc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "136b713d-c44a-53ed-a33f-656e985027a2-u01",
          "speaker_id": "b",
          "ja": "財布の中には何がありましたか。",
          "vi": "Trong ví có những gì ạ?"
        },
        {
          "id": "136b713d-c44a-53ed-a33f-656e985027a2-u02",
          "speaker_id": "a",
          "ja": "現金とキャッシュカードは入っていました。診察券も入っていたかもしれません。",
          "vi": "Chắc chắn có tiền mặt và thẻ ATM. Hình như còn có thẻ khám bệnh nữa ạ."
        },
        {
          "id": "136b713d-c44a-53ed-a33f-656e985027a2-u03",
          "speaker_id": "b",
          "ja": "分かりました。分かる物と、まだ分からない物を分けて書きます。",
          "vi": "Tôi hiểu. Tôi sẽ ghi riêng món bạn chắc chắn và món bạn chưa chắc."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "136b713d-c44a-53ed-a33f-656e985027a2-u01": {
            "kind": "original_extension"
          },
          "136b713d-c44a-53ed-a33f-656e985027a2-u02": {
            "kind": "original_extension"
          },
          "136b713d-c44a-53ed-a33f-656e985027a2-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "18701e39-1c9f-59d1-8aa7-615907a15c6d",
      "event_id": "E01",
      "context_vi": "Sau khi báo còn ví lúc xuống tàu, bạn nhận ra không biết nó rơi ở ga hay trên đường tới nhà. Bạn bổ sung cả hai mốc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "18701e39-1c9f-59d1-8aa7-615907a15c6d-u01",
          "speaker_id": "a",
          "ja": "あおい駅で降りたときは持っていました。家に着く前に、ないことに気づきました。駅で落としたか、帰る途中かは分かりません。",
          "vi": "Lúc xuống tàu ở ga Aoi tôi vẫn cầm ví. Tôi phát hiện mất trước khi về tới nhà. Tôi không biết rơi ở ga hay trên đường về ạ."
        },
        {
          "id": "18701e39-1c9f-59d1-8aa7-615907a15c6d-u02",
          "speaker_id": "b",
          "ja": "駅の中か、駅から家までの間ですね。そう書いておきます。",
          "vi": "Có thể trong ga hoặc trên đường từ ga về nhà. Tôi sẽ ghi như vậy ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "18701e39-1c9f-59d1-8aa7-615907a15c6d-u01": {
            "kind": "original_extension"
          },
          "18701e39-1c9f-59d1-8aa7-615907a15c6d-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45",
      "event_id": "E01",
      "context_vi": "Bạn đã báo mất ví ở chốt cảnh sát. Cảnh sát hỏi dấu nhận diện để đối chiếu nếu có người giao ví.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45-u01",
          "speaker_id": "b",
          "ja": "財布の色と大きさを教えてください。",
          "vi": "Cho tôi biết màu và kích thước ví ạ?"
        },
        {
          "id": "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45-u02",
          "speaker_id": "a",
          "ja": "黒くて、小さい財布です。前に赤い星があります。",
          "vi": "Ví nhỏ màu đen, mặt trước có hình ngôi sao đỏ."
        },
        {
          "id": "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45-u03",
          "speaker_id": "b",
          "ja": "黒い小さい財布で、赤い星ですね。",
          "vi": "Ví nhỏ màu đen, có ngôi sao đỏ ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "5cb2f22c-6bd3-57d6-bd6d-4ae1e40e2c45-u01": {
            "kind": "original_extension"
          },
