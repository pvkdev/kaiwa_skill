    {
      "situation_uid": "46e300fd-b099-54a0-9c36-e75bf802a50c",
      "event_id": "E04",
      "context_vi": "Bạn vừa giao chiếc ô nhặt ở ghế trước ga. Sau khi xác nhận việc bàn giao, bạn nói thêm mình cũng mất ví và nghĩ nó rơi ngoài đường, để cảnh sát lập hồ sơ riêng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "46e300fd-b099-54a0-9c36-e75bf802a50c-u01",
          "speaker_id": "b",
          "ja": "傘をお預かりしました。こちらが預り書です。",
          "vi": "Chúng tôi đã nhận chiếc ô. Đây là giấy biên nhận."
        },
        {
          "id": "46e300fd-b099-54a0-9c36-e75bf802a50c-u02",
          "speaker_id": "a",
          "ja": "傘はこれで大丈夫ですね。ありがとうございます。それと、道で財布を落としたかもしれません。届け出てもいいですか。",
          "vi": "Vậy việc giao ô xong rồi đúng không ạ? Cảm ơn anh. Tôi còn một việc: có thể tôi đánh rơi ví ngoài đường. Tôi báo mất được không ạ?"
        },
        {
          "id": "46e300fd-b099-54a0-9c36-e75bf802a50c-u03",
          "speaker_id": "b",
          "ja": "はい、傘はお預かりしました。財布のことは別に伺います。",
          "vi": "Vâng, chúng tôi đã nhận ô. Về chiếc ví, tôi sẽ tiếp nhận riêng ạ."
        }
      ],
      "admin": {
