  "dialogues": [
    {
      "situation_uid": "ee2bc21f-051b-5e12-b151-240d300ee2c7",
      "event_id": "E01",
      "context_vi": "Bạn vừa xuống tàu, đến chốt cảnh sát để báo mất ví. Bạn nhớ rõ lúc cuối cùng còn cầm nó.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ee2bc21f-051b-5e12-b151-240d300ee2c7-u01",
          "speaker_id": "a",
          "ja": "すみません。財布をなくしました。電車を降りる時は持っていました。",
          "vi": "Xin lỗi, tôi bị mất ví. Lúc xuống tàu tôi vẫn còn cầm nó."
        },
        {
          "id": "ee2bc21f-051b-5e12-b151-240d300ee2c7-u02",
          "speaker_id": "b",
          "ja": "どの駅で降りましたか。",
          "vi": "Bạn xuống ở ga nào ạ?"
        },
        {
          "id": "ee2bc21f-051b-5e12-b151-240d300ee2c7-u03",
          "speaker_id": "a",
          "ja": "あおい駅です。",
          "vi": "Ga Aoi ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "ee2bc21f-051b-5e12-b151-240d300ee2c7-u01": {
            "kind": "original_extension"
          },
          "ee2bc21f-051b-5e12-b151-240d300ee2c7-u02": {
            "kind": "original_extension"
          },
          "ee2bc21f-051b-5e12-b151-240d300ee2c7-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "136b713d-c44a-53ed-a33f-656e985027a2",
      "event_id": "E01",
      "context_vi": "Cảnh sát hỏi trong ví có gì. Bạn chắc có tiền mặt và thẻ ngân hàng, còn chiếc thẻ khác thì chưa chắc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "136b713d-c44a-53ed-a33f-656e985027a2-u01",
          "speaker_id": "b",
          "ja": "財布の中には何がありましたか。",
          "vi": "Trong ví có những gì ạ?"
        },
        {
          "id": "136b713d-c44a-53ed-a33f-656e985027a2-u02",
          "speaker_id": "a",
          "ja": "現金と銀行のカードは入っていました。保険証も入っていたかもしれません。",
          "vi": "Chắc chắn có tiền mặt và thẻ ngân hàng. Có thể còn có thẻ bảo hiểm nữa, nhưng tôi chưa chắc."
        },
        {
          "id": "136b713d-c44a-53ed-a33f-656e985027a2-u03",
          "speaker_id": "b",
          "ja": "分かりました。分かる物と、まだ分からない物を分けて書きます。",
          "vi": "Tôi hiểu. Tôi sẽ ghi riêng món bạn chắc chắn và món bạn chưa chắc."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "136b713d-c44a-53ed-a33f-656e985027a2-u01": {
            "kind": "original_extension"
          },
          "136b713d-c44a-53ed-a33f-656e985027a2-u02": {
            "kind": "original_extension"
          },
          "136b713d-c44a-53ed-a33f-656e985027a2-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "18701e39-1c9f-59d1-8aa7-615907a15c6d",
      "event_id": "E01",
      "context_vi": "Sau khi báo còn ví lúc xuống tàu, bạn nhận ra không biết nó rơi ở ga hay trên đường tới nhà. Bạn bổ sung cả hai mốc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cảnh sát koban",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "18701e39-1c9f-59d1-8aa7-615907a15c6d-u01",
          "speaker_id": "a",
          "ja": "財布を落とした場所は分かりません。あおい駅で電車を降りた時はありました。家に着く前になくなりました。",
          "vi": "Tôi không biết ví rơi ở đâu. Lúc xuống tàu ở ga Aoi tôi vẫn còn ví; trước khi về đến nhà thì không thấy nữa."
        },
        {
          "id": "18701e39-1c9f-59d1-8aa7-615907a15c6d-u02",
          "speaker_id": "b",
          "ja": "駅から家までの間ですね。そのように記録します。",
          "vi": "Vậy là trên quãng đường từ ga về nhà. Tôi sẽ ghi như thế."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "npa"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "18701e39-1c9f-59d1-8aa7-615907a15c6d-u01": {
            "kind": "original_extension"
