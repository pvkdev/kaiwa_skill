      ],
      "turns": [
        {
          "id": "46e300fd-b099-54a0-9c36-e75bf802a50c-u01",
          "speaker_id": "b",
          "ja": "傘をお預かりしました。こちらが預り書です。",
          "vi": "Chúng tôi đã nhận chiếc ô. Đây là giấy biên nhận."
        },
        {
          "id": "46e300fd-b099-54a0-9c36-e75bf802a50c-u02",
          "speaker_id": "a",
          "ja": "傘の引き渡しはこれで終わりですね。ありがとうございます。私の財布も道でなくしたので、別に届けたいです。",
          "vi": "Vậy tôi đã giao xong chiếc ô rồi phải không ạ? Cảm ơn anh. Tôi cũng mất ví, nghĩ là rơi ngoài đường, nên muốn báo riêng."
        },
        {
          "id": "46e300fd-b099-54a0-9c36-e75bf802a50c-u03",
          "speaker_id": "b",
          "ja": "はい、傘は終わりました。財布は別の届出として伺います。",
          "vi": "Vâng, việc giao ô đã xong. Tôi sẽ tiếp nhận vụ ví thành hồ sơ riêng."
        }
      ],
