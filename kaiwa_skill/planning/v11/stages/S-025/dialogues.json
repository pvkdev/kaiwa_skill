      ],
      "turns": [
        {
          "id": "bb671723-73c5-54e5-81d9-a4c7d574fd0f-u01",
          "speaker_id": "a",
          "ja": "友達に聞きたいです。これを少し置いてもいいですか。",
          "vi": "Tôi muốn hỏi bạn đi cùng. Tôi để áo đây một lát được không ạ?"
        },
        {
          "id": "bb671723-73c5-54e5-81d9-a4c7d574fd0f-u02",
          "speaker_id": "b",
          "ja": "はい、このレジで十分だけお預かりします。",
          "vi": "Được ạ, quầy này giữ giúp anh 10 phút."
        },
        {
          "id": "bb671723-73c5-54e5-81d9-a4c7d574fd0f-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。十分以内に戻ります。",
          "vi": "Cảm ơn chị. Tôi quay lại trong 10 phút."
        }
      ],
