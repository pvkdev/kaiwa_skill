  "dialogues": [
    {
      "situation_uid": "04e251a9-3adc-5578-9fc3-129bf04eb3f1",
      "event_id": "E01",
      "context_vi": "Tại cửa hàng quần áo hư cấu Aoi, bạn tìm áo khoác dùng vào mùa lạnh.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "04e251a9-3adc-5578-9fc3-129bf04eb3f1-u01",
          "speaker_id": "a",
          "ja": "寒い日に着る上着を探しています。",
          "vi": "Tôi tìm áo khoác để mặc ngày lạnh ạ."
        },
        {
          "id": "04e251a9-3adc-5578-9fc3-129bf04eb3f1-u02",
          "speaker_id": "b",
          "ja": "厚めと薄め、どちらがいいですか。",
          "vi": "Anh muốn loại dày hay mỏng ạ?"
        },
        {
          "id": "04e251a9-3adc-5578-9fc3-129bf04eb3f1-u03",
          "speaker_id": "a",
          "ja": "厚めがいいです。",
          "vi": "Tôi muốn loại dày ạ."
        },
        {
          "id": "04e251a9-3adc-5578-9fc3-129bf04eb3f1-u04",
          "speaker_id": "b",
          "ja": "では、こちらをご覧ください。",
          "vi": "Vậy anh xem khu này nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "style"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "04e251a9-3adc-5578-9fc3-129bf04eb3f1-u01": {
