    {
      "situation_uid": "0024070e-369c-59cd-b833-6525c310cf1a",
      "event_id": "E03",
      "context_vi": "Ở Aoi hư cấu, áo đang có giá 2.000 yên; ưu đãi 1.800 yên chỉ bắt đầu ngày mai. Bạn quyết định mua hôm nay theo giá hiện tại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0024070e-369c-59cd-b833-6525c310cf1a-u01",
          "speaker_id": "a",
          "ja": "このシャツ、今日は千八百円ですか。",
          "vi": "Áo này hôm nay là 1.800 yên ạ?"
        },
        {
          "id": "0024070e-369c-59cd-b833-6525c310cf1a-u02",
          "speaker_id": "b",
          "ja": "いいえ、その値段は明日からです。今日は二千円です。",
          "vi": "Không ạ, giá đó từ ngày mai. Hôm nay là 2.000 yên."
        },
        {
          "id": "0024070e-369c-59cd-b833-6525c310cf1a-u03",
          "speaker_id": "a",
          "ja": "わかりました。今日、二千円で買います。",
          "vi": "Tôi hiểu rồi. Hôm nay tôi mua với giá 2.000 yên."
        },
        {
          "id": "0024070e-369c-59cd-b833-6525c310cf1a-u04",
          "speaker_id": "b",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn anh ạ."
        }
      ],
      "admin": {
