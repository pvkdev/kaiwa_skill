          }
        }
      }
    },
    {
      "situation_uid": "bf8deac6-a946-5f8b-9f11-c99d2375abe4",
      "event_id": "E01",
      "context_vi": "Ở Aoi, bạn thường mặc cỡ M và muốn tìm đúng khu áo sơ mi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "bf8deac6-a946-5f8b-9f11-c99d2375abe4-u01",
          "speaker_id": "a",
          "ja": "Mサイズのシャツはどこですか。",
          "vi": "Áo sơ mi cỡ M ở đâu ạ?"
        },
        {
          "id": "bf8deac6-a946-5f8b-9f11-c99d2375abe4-u02",
          "speaker_id": "b",
          "ja": "こちらの棚です。普段もMサイズですか。",
          "vi": "Ở kệ này ạ. Bình thường anh cũng mặc cỡ M chứ?"
        },
        {
          "id": "bf8deac6-a946-5f8b-9f11-c99d2375abe4-u03",
          "speaker_id": "a",
          "ja": "はい、いつもMです。",
          "vi": "Vâng, tôi thường mặc cỡ M."
        }
      ],
      "admin": {
        "source_refs": [
          "style"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "bf8deac6-a946-5f8b-9f11-c99d2375abe4-u01": {
            "kind": "original_extension"
          },
          "bf8deac6-a946-5f8b-9f11-c99d2375abe4-u02": {
            "kind": "original_extension"
          },
          "bf8deac6-a946-5f8b-9f11-c99d2375abe4-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "3aeb750c-0d64-5d14-9249-d261886866cb",
      "event_id": "E01",
      "context_vi": "Bạn cần áo mặc đi làm, đang so áo xanh navy với áo đỏ ở Aoi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "3aeb750c-0d64-5d14-9249-d261886866cb-u01",
          "speaker_id": "a",
          "ja": "仕事に着るなら、紺と赤、どちらがいいですか。",
          "vi": "Nếu mặc đi làm thì xanh navy hay đỏ hợp hơn ạ?"
        },
        {
          "id": "3aeb750c-0d64-5d14-9249-d261886866cb-u02",
          "speaker_id": "b",
          "ja": "落ち着いた色がよければ、紺はいかがですか。",
          "vi": "Nếu anh thích màu trầm thì màu xanh navy thế nào ạ?"
        },
        {
          "id": "3aeb750c-0d64-5d14-9249-d261886866cb-u03",
          "speaker_id": "a",
          "ja": "そうですね。紺を見せてください。",
          "vi": "Đúng rồi. Cho tôi xem màu xanh navy."
        }
      ],
      "admin": {
        "source_refs": [
          "color",
          "style"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "3aeb750c-0d64-5d14-9249-d261886866cb-u01": {
            "kind": "original_extension"
          },
          "3aeb750c-0d64-5d14-9249-d261886866cb-u02": {
            "kind": "original_extension"
          },
          "3aeb750c-0d64-5d14-9249-d261886866cb-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "145b3644-31ef-51ef-885c-ce2ce4ae13b6",
      "event_id": "E01",
      "context_vi": "Nhân viên Aoi gợi ý áo hoa, nhưng bạn cần kiểu trơn để đi làm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "145b3644-31ef-51ef-885c-ce2ce4ae13b6-u01",
          "speaker_id": "b",
          "ja": "こちらの花柄はいかがですか。",
          "vi": "Anh thấy áo hoa này thế nào ạ?"
        },
        {
          "id": "145b3644-31ef-51ef-885c-ce2ce4ae13b6-u02",
          "speaker_id": "a",
          "ja": "すみません。柄のないものがいいです。",
          "vi": "Xin lỗi, tôi muốn loại không có hoa văn ạ."
        },
        {
          "id": "145b3644-31ef-51ef-885c-ce2ce4ae13b6-u03",
          "speaker_id": "b",
          "ja": "では、こちらの無地のシャツはどうですか。",
          "vi": "Vậy áo sơ mi trơn này thế nào ạ?"
        },
        {
          "id": "145b3644-31ef-51ef-885c-ce2ce4ae13b6-u04",
          "speaker_id": "a",
          "ja": "それなら見てみたいです。",
          "vi": "Loại đó tôi muốn xem thử ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "color"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "145b3644-31ef-51ef-885c-ce2ce4ae13b6-u01": {
            "kind": "original_extension"
          },
          "145b3644-31ef-51ef-885c-ce2ce4ae13b6-u02": {
            "kind": "original_extension"
          },
          "145b3644-31ef-51ef-885c-ce2ce4ae13b6-u03": {
            "kind": "original_extension"
          },
          "145b3644-31ef-51ef-885c-ce2ce4ae13b6-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "be5fe321-c952-59fd-ac04-be3cd016a017",
      "event_id": "E01",
      "context_vi": "Ở Aoi, nhân viên đã dẫn bạn đến khu áo sơ mi trơn; bạn xác nhận đúng loại muốn xem.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "be5fe321-c952-59fd-ac04-be3cd016a017-u01",
          "speaker_id": "b",
          "ja": "無地のシャツはこちらです。",
          "vi": "Áo sơ mi trơn ở khu này ạ."
        },
        {
          "id": "be5fe321-c952-59fd-ac04-be3cd016a017-u02",
          "speaker_id": "a",
          "ja": "はい、探していたのはこれです。",
          "vi": "Vâng, đúng loại tôi đang tìm."
        },
        {
          "id": "be5fe321-c952-59fd-ac04-be3cd016a017-u03",
          "speaker_id": "b",
          "ja": "サイズもご覧になりますか。",
          "vi": "Anh xem luôn cỡ áo nhé?"
        },
        {
          "id": "be5fe321-c952-59fd-ac04-be3cd016a017-u04",
          "speaker_id": "a",
          "ja": "Mサイズをお願いします。",
          "vi": "Cho tôi xem cỡ M ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "color"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
        "turn_origins": {
          "be5fe321-c952-59fd-ac04-be3cd016a017-u01": {
            "kind": "original_extension"
          },
