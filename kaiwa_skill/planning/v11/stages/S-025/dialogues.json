    {
      "situation_uid": "4a8d55d0-f18e-55db-8b20-f7e77f6dbe57",
      "event_id": "E03",
      "context_vi": "Ở Aoi, bạn thấy thông báo mua hai áo giảm giá nhưng chưa rõ áo đang cầm có nằm trong chương trình của cửa hàng này không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4a8d55d0-f18e-55db-8b20-f7e77f6dbe57-u01",
          "speaker_id": "a",
          "ja": "このシャツも二枚買うと安くなりますか。",
          "vi": "Áo này cũng được giảm khi mua hai chiếc ạ?"
        },
        {
          "id": "4a8d55d0-f18e-55db-8b20-f7e77f6dbe57-u02",
          "speaker_id": "b",
          "ja": "このシャツは対象です。もう一枚は対象の棚から選んでください。",
          "vi": "Áo này được ạ. Chiếc thứ hai anh chọn từ kệ hàng áp dụng chương trình nhé."
        },
        {
          "id": "4a8d55d0-f18e-55db-8b20-f7e77f6dbe57-u03",
          "speaker_id": "a",
          "ja": "対象の棚はどこですか。",
          "vi": "Kệ hàng áp dụng ở đâu ạ?"
        },
        {
          "id": "4a8d55d0-f18e-55db-8b20-f7e77f6dbe57-u04",
          "speaker_id": "b",
          "ja": "レジの左です。",
          "vi": "Bên trái quầy thu ngân ạ."
        }
      ],
      "admin": {
