    {
      "situation_uid": "51be9704-7e51-500a-91e6-e2a94bddaed9",
      "event_id": "E04",
      "context_vi": "Bạn mua áo ở Aoi hư cấu; nhãn trên kệ ghi áo đi kèm thắt lưng, nhưng trong túi không có. Bạn nhờ nhân viên kiểm nội dung bộ hàng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên cửa hàng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "51be9704-7e51-500a-91e6-e2a94bddaed9-u01",
          "speaker_id": "a",
          "ja": "この服にはベルトも付くと書いてありました。袋にありません。",
          "vi": "Nhãn ghi áo này có kèm thắt lưng, nhưng trong túi không có ạ."
        },
        {
          "id": "51be9704-7e51-500a-91e6-e2a94bddaed9-u02",
          "speaker_id": "b",
          "ja": "確認します。レシートを見せていただけますか。",
          "vi": "Tôi kiểm tra. Anh cho tôi xem hóa đơn được không ạ?"
        },
        {
          "id": "51be9704-7e51-500a-91e6-e2a94bddaed9-u03",
          "speaker_id": "a",
          "ja": "はい、ここにあります。",
          "vi": "Có ạ, đây ạ."
        },
        {
          "id": "51be9704-7e51-500a-91e6-e2a94bddaed9-u04",
