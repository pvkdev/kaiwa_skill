    {
      "situation_uid": "bb671723-73c5-54e5-81d9-a4c7d574fd0f",
      "event_id": "E03",
      "context_vi": "Tại quầy Aoi hư cấu, bạn muốn hỏi người đi cùng trước khi mua áo cỡ M. Cửa hàng đồng ý giữ áo đúng 10 phút trong tình huống này.",
