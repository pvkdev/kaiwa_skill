          "c6976139-fba3-5947-ba96-30c75b9c0a29-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "442c9335-d35f-5783-b15a-0940d1b06aa9",
      "event_id": "E02",
      "context_vi": "Bạn đang thử áo tại Aoi. Cỡ hiện tại chật ở vai nhưng tay lại dài; muốn nói rõ hai điểm trước khi đổi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phòng thử",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "442c9335-d35f-5783-b15a-0940d1b06aa9-u01",
          "speaker_id": "b",
          "ja": "サイズはいかがですか。",
          "vi": "Cỡ áo thế nào ạ?"
        },
        {
          "id": "442c9335-d35f-5783-b15a-0940d1b06aa9-u02",
          "speaker_id": "a",
          "ja": "肩はきついです。でも袖は長いです。",
          "vi": "Phần vai chật, nhưng tay áo lại dài ạ."
        },
        {
          "id": "442c9335-d35f-5783-b15a-0940d1b06aa9-u03",
          "speaker_id": "b",
          "ja": "別の形をお持ちしましょうか。",
          "vi": "Tôi mang kiểu khác cho anh nhé?"
        },
        {
          "id": "442c9335-d35f-5783-b15a-0940d1b06aa9-u04",
          "speaker_id": "a",
          "ja": "はい、お願いします。",
          "vi": "Vâng, nhờ chị."
        }
      ],
      "admin": {
        "source_refs": [
          "fitting"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
        "turn_origins": {
          "442c9335-d35f-5783-b15a-0940d1b06aa9-u01": {
