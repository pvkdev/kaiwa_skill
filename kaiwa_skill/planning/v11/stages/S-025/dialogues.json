        }
      }
    },
    {
      "situation_uid": "c6976139-fba3-5947-ba96-30c75b9c0a29",
      "event_id": "E02",
      "context_vi": "Bạn cầm áo ở Aoi và muốn biết hiện có phòng thử nào trống.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phòng thử",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c6976139-fba3-5947-ba96-30c75b9c0a29-u01",
          "speaker_id": "a",
          "ja": "今、試着室は空いていますか。",
          "vi": "Bây giờ có phòng thử nào trống không ạ?"
        },
        {
          "id": "c6976139-fba3-5947-ba96-30c75b9c0a29-u02",
          "speaker_id": "b",
          "ja": "はい、右の部屋が空いています。",
          "vi": "Có ạ, phòng bên phải đang trống."
        },
        {
          "id": "c6976139-fba3-5947-ba96-30c75b9c0a29-u03",
          "speaker_id": "a",
          "ja": "では、これを試着してもいいですか。",
          "vi": "Vậy tôi thử chiếc này được không ạ?"
        },
        {
          "id": "c6976139-fba3-5947-ba96-30c75b9c0a29-u04",
          "speaker_id": "b",
          "ja": "はい、どうぞ。",
          "vi": "Vâng, xin mời."
        }
      ],
      "admin": {
        "source_refs": [
          "fitting"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c6976139-fba3-5947-ba96-30c75b9c0a29-u01": {
