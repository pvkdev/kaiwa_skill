    {
      "situation_uid": "b29e8459-6b81-5d56-b169-1ba8057fbe66",
      "event_id": "E02",
      "context_vi": "Ở Aoi, áo bạn muốn thử không còn cỡ M. Bạn hỏi nhân viên liệu chi nhánh khác còn không, và chấp nhận chờ kiểm.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phòng thử",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b29e8459-6b81-5d56-b169-1ba8057fbe66-u01",
          "speaker_id": "a",
          "ja": "この服のMサイズはありませんか。",
          "vi": "Áo này hết cỡ M rồi ạ?"
        },
        {
          "id": "b29e8459-6b81-5d56-b169-1ba8057fbe66-u02",
          "speaker_id": "b",
          "ja": "この店にはありません。ほかの店は確認できます。",
          "vi": "Cửa hàng này không còn. Tôi có thể kiểm tra chi nhánh khác ạ."
        },
        {
          "id": "b29e8459-6b81-5d56-b169-1ba8057fbe66-u03",
          "speaker_id": "a",
          "ja": "では、確認をお願いします。",
          "vi": "Vậy nhờ chị kiểm tra giúp."
        },
        {
          "id": "b29e8459-6b81-5d56-b169-1ba8057fbe66-u04",
          "speaker_id": "b",
          "ja": "少々お待ちください。",
          "vi": "Anh đợi chút nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "fitting",
          "color"
        ],
        "specialty_item_ids": [
          "sj-so-06-b07-85"
        ],
