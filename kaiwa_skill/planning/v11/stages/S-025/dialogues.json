    {
      "situation_uid": "1f36d19f-f273-5e57-a9cd-460e79e49b75",
      "event_id": "E03",
      "context_vi": "Tại quầy Aoi hư cấu, bạn muốn biết nhãn 2.000 yên trên áo đã gồm thuế chưa. Giá chỉ là ví dụ của cửa hàng này.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "thu ngân",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "1f36d19f-f273-5e57-a9cd-460e79e49b75-u01",
          "speaker_id": "a",
          "ja": "この二千円は税込みですか。",
          "vi": "Giá 2.000 yên này đã gồm thuế chưa ạ?"
        },
