    {
      "situation_uid": "0f0b0610-dbb3-51d5-9227-54cab7f4ff7a",
      "event_id": "E02",
      "context_vi": "Tại phòng thử Aoi, bạn đã xin áo cỡ M nhưng nhân viên mang tới cỡ L.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "nhân viên phòng thử",
