    {
      "situation_uid": "8a26a1a8-c8b3-5091-b59f-00eb345eb0c8",
      "event_id": "E02",
      "context_vi": "Bạn nghĩ cả hai sẽ đi hiệu sách thứ Bảy tuần này. Bạn mình lại hiểu là thứ Bảy tuần sau và đã có việc vào thứ Bảy tuần này.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hẹn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8a26a1a8-c8b3-5091-b59f-00eb345eb0c8-u01",
          "speaker_id": "A",
          "ja": "今週の土曜、本屋に行くんだよね。",
          "vi": "Thứ Bảy tuần này mình đi hiệu sách đúng không?"
        },
        {
          "id": "8a26a1a8-c8b3-5091-b59f-00eb345eb0c8-u02",
          "speaker_id": "B",
          "ja": "え、来週じゃないの？ 八日は仕事だよ。",
          "vi": "Ơ, tớ tưởng tuần sau chứ? Ngày 8 tớ đi làm."
        },
        {
          "id": "8a26a1a8-c8b3-5091-b59f-00eb345eb0c8-u03",
          "speaker_id": "A",
          "ja": "そっか。じゃ、来週の土曜はどう？",
          "vi": "Ra vậy. Thế thứ Bảy tuần sau được không?"
        },
        {
          "id": "8a26a1a8-c8b3-5091-b59f-00eb345eb0c8-u04",
          "speaker_id": "B",
          "ja": "来週なら空いてるよ。",
          "vi": "Tuần sau thì tớ rảnh."
        }
      ],
      "admin": {
