    {
      "situation_uid": "ecab7954-0bf1-557f-807a-1e8f737e39b1",
      "event_id": "E03",
      "context_vi": "Bạn đã hẹn gặp ở quán cà phê lúc ba giờ chiều. Bỗng có việc phải xử lý ở nhà nên bạn gọi báo sẽ tới lúc ba giờ hai mươi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đến muộn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đang đợi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ecab7954-0bf1-557f-807a-1e8f737e39b1-u01",
          "speaker_id": "A",
          "ja": "ごめん。三時には着けそうにない。",
          "vi": "Xin lỗi. Chắc tớ không đến kịp ba giờ."
        },
        {
          "id": "ecab7954-0bf1-557f-807a-1e8f737e39b1-u02",
          "speaker_id": "B",
          "ja": "どうしたの？",
          "vi": "Có chuyện gì vậy?"
        },
        {
          "id": "ecab7954-0bf1-557f-807a-1e8f737e39b1-u03",
          "speaker_id": "A",
          "ja": "家で急に用事ができたんだ。三時二十分ごろになる。",
          "vi": "Nhà tớ có việc đột xuất. Chắc khoảng ba giờ hai mươi tớ tới."
        },
        {
          "id": "ecab7954-0bf1-557f-807a-1e8f737e39b1-u04",
          "speaker_id": "B",
          "ja": "わかった。先に店に入ってるね。",
          "vi": "Ừ, tớ vào quán đợi trước nhé."
        },
        {
          "id": "ecab7954-0bf1-557f-807a-1e8f737e39b1-u05",
          "speaker_id": "A",
          "ja": "ありがとう。着いたら連絡する。",
          "vi": "Cảm ơn cậu. Tới nơi tớ nhắn."
        }
      ],
      "admin": {
