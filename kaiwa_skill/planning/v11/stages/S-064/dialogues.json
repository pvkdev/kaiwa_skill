    {
      "situation_uid": "408cab06-36da-5ee2-8064-e74dd680b1ce",
      "event_id": "E03",
      "context_vi": "Bạn định gặp ở quán phía bên kia ga. Người bạn chỉ có thể ghé chỗ gần nhà, nên bạn thử dời điểm gặp sang quán đối diện nhà bạn ấy.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đề nghị",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "408cab06-36da-5ee2-8064-e74dd680b1ce-u01",
          "speaker_id": "B",
          "ja": "今日は駅の向こうまで行く時間がないんだ。",
          "vi": "Hôm nay tớ không có thời gian sang bên kia ga."
        },
        {
          "id": "408cab06-36da-5ee2-8064-e74dd680b1ce-u02",
          "speaker_id": "A",
          "ja": "じゃ、家の向かいのカフェはどう？",
          "vi": "Vậy quán cà phê đối diện nhà cậu thì sao?"
        },
        {
          "id": "408cab06-36da-5ee2-8064-e74dd680b1ce-u03",
          "speaker_id": "B",
          "ja": "そこならすぐ行けるよ。",
          "vi": "Chỗ đó thì tớ ra ngay được."
        },
        {
          "id": "408cab06-36da-5ee2-8064-e74dd680b1ce-u04",
          "speaker_id": "A",
          "ja": "じゃ、時間はそのままで、店だけ変えよう。",
          "vi": "Vậy giữ nguyên giờ, mình chỉ đổi quán nhé."
        }
      ],
      "admin": {
