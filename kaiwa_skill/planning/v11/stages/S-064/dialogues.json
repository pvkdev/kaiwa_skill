    {
      "situation_uid": "e3902269-e7cd-5cf1-8792-a83c35e03382",
      "event_id": "E02",
      "context_vi": "Hai bạn vừa sửa lại ngày hẹn đi hiệu sách thành thứ Bảy tuần sau. Bạn muốn xác nhận ngày cụ thể, giờ và đúng cửa ga sẽ gặp.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hẹn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e3902269-e7cd-5cf1-8792-a83c35e03382-u01",
          "speaker_id": "A",
          "ja": "来週の土曜日は十五日だよね。",
          "vi": "Thứ Bảy tuần sau là ngày 15 đúng không?"
        },
        {
          "id": "e3902269-e7cd-5cf1-8792-a83c35e03382-u02",
          "speaker_id": "B",
          "ja": "うん。午後二時に駅の東口でどう？",
          "vi": "Ừ. Hai giờ chiều ở cửa Đông nhà ga nhé?"
        },
        {
          "id": "e3902269-e7cd-5cf1-8792-a83c35e03382-u03",
          "speaker_id": "A",
          "ja": "いいよ。十五日の午後二時、東口ね。",
          "vi": "Được. Ngày 15 lúc hai giờ chiều, cửa Đông nhé."
        },
        {
          "id": "e3902269-e7cd-5cf1-8792-a83c35e03382-u04",
          "speaker_id": "B",
          "ja": "うん、東口で会おう。",
          "vi": "Ừ, gặp ở cửa Đông."
        }
      ],
      "admin": {
