    {
      "situation_uid": "bc1701c3-d42d-5ea7-9b4a-4f010ede3fbe",
      "event_id": "E04",
      "context_vi": "Hai bạn định đi bộ lên đồi ngắm cảnh. Bạn đi cùng thấy mệt nên bạn đề nghị đi một đoạn ngắn gần chỗ đang đứng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi dạo",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đang mệt",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bc1701c3-d42d-5ea7-9b4a-4f010ede3fbe-u01",
          "speaker_id": "B",
          "ja": "ちょっと疲れた。坂はきついな。",
          "vi": "Tớ hơi mệt rồi. Leo dốc chắc hơi đuối."
        },
        {
          "id": "bc1701c3-d42d-5ea7-9b4a-4f010ede3fbe-u02",
          "speaker_id": "A",
          "ja": "坂はまた今度でいいよ。近くの橋までならどう？",
          "vi": "Để hôm khác leo dốc cũng được. Đi tới cây cầu gần đây thì sao?"
        },
        {
          "id": "bc1701c3-d42d-5ea7-9b4a-4f010ede3fbe-u03",
          "speaker_id": "B",
          "ja": "橋までなら歩けそう。",
          "vi": "Tới cầu thì chắc tớ đi được."
        },
        {
          "id": "bc1701c3-d42d-5ea7-9b4a-4f010ede3fbe-u04",
          "speaker_id": "A",
          "ja": "じゃ、ゆっくり行こう。",
          "vi": "Vậy mình đi chậm thôi."
        }
      ],
