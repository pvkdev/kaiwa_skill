    {
      "situation_uid": "c28aaabf-8851-5728-802d-383ffef13ca4",
      "event_id": "E02",
      "context_vi": "Hai bạn đã chọn quán và giờ ăn tối. Bạn hỏi xem ai sẽ gọi đặt bàn cho hai người.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hẹn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c28aaabf-8851-5728-802d-383ffef13ca4-u01",
          "speaker_id": "A",
          "ja": "店は決まったね。予約はどっちがする？",
          "vi": "Vậy là chốt quán rồi. Ai đặt bàn đây?"
        },
        {
          "id": "c28aaabf-8851-5728-802d-383ffef13ca4-u02",
          "speaker_id": "B",
          "ja": "私が電話するよ。",
          "vi": "Để tớ gọi cho quán."
        },
        {
          "id": "c28aaabf-8851-5728-802d-383ffef13ca4-u03",
          "speaker_id": "A",
          "ja": "ありがとう。土曜の六時に二人ね。",
          "vi": "Cảm ơn cậu. Thứ Bảy lúc sáu giờ tối cho hai người nhé."
        },
        {
          "id": "c28aaabf-8851-5728-802d-383ffef13ca4-u04",
          "speaker_id": "B",
          "ja": "うん、電話したら知らせるね。",
          "vi": "Ừ, gọi xong tớ báo cậu."
        }
      ],
      "admin": {
        "source_refs": [],
        "specialty_item_ids": [
          "sj-so-15-b12-10"
        ],
        "turn_origins": {
