        }
      }
    },
    {
      "situation_uid": "c9a4fe00-2e60-50c7-9317-b83be060845e",
      "event_id": "E01",
      "context_vi": "Bạn vừa làm quen với một người ở lớp tiếng Nhật. Hai người cùng đi về phía công viên và bạn muốn rủ họ đi dạo một vòng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người học",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Người mới quen",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c9a4fe00-2e60-50c7-9317-b83be060845e-u01",
          "speaker_id": "A",
          "ja": "時間があったら、公園を少し歩きませんか。",
          "vi": "Nếu anh có thời gian, mình đi dạo một chút trong công viên nhé?"
        },
        {
          "id": "c9a4fe00-2e60-50c7-9317-b83be060845e-u02",
          "speaker_id": "B",
          "ja": "いいですね。十分ぐらいなら大丈夫です。",
          "vi": "Hay đấy. Tầm mười phút thì tôi đi được."
        },
        {
          "id": "c9a4fe00-2e60-50c7-9317-b83be060845e-u03",
          "speaker_id": "A",
          "ja": "じゃ、池の近くを歩きましょう。",
          "vi": "Vậy mình đi dọc bờ ao nhé."
        },
        {
          "id": "c9a4fe00-2e60-50c7-9317-b83be060845e-u04",
          "speaker_id": "B",
          "ja": "はい、行きましょう。",
          "vi": "Vâng, mình đi thôi."
        }
      ],
      "admin": {
        "source_refs": [
          "invite"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
