    {
      "situation_uid": "4f84ab0c-e7a3-5538-9451-4dc4cc1d903e",
      "event_id": "E03",
      "context_vi": "Hai bạn đã hẹn đi xem phim tối nay. Người bạn báo có việc gia đình và phải hủy. Bạn muốn nói là mình hiểu và để dịp khác đi cùng.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hẹn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn báo hủy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4f84ab0c-e7a3-5538-9451-4dc4cc1d903e-u01",
          "speaker_id": "B",
          "ja": "ごめん。家の用事で、今夜の映画に行けなくなった。",
          "vi": "Xin lỗi cậu. Nhà tớ có việc nên tối nay tớ không đi xem phim được nữa."
        },
        {
          "id": "4f84ab0c-e7a3-5538-9451-4dc4cc1d903e-u02",
          "speaker_id": "A",
          "ja": "わかった。映画はまた今度にしよう。",
          "vi": "Tớ hiểu. Mình để dịp khác đi xem nhé."
        },
        {
          "id": "4f84ab0c-e7a3-5538-9451-4dc4cc1d903e-u03",
          "speaker_id": "B",
          "ja": "うん、また誘ってね。",
          "vi": "Ừ, lần sau lại rủ tớ nhé."
        },
        {
          "id": "4f84ab0c-e7a3-5538-9451-4dc4cc1d903e-u04",
          "speaker_id": "A",
          "ja": "もちろん。",
          "vi": "Ừ, tất nhiên rồi."
        }
      ],
