    {
      "situation_uid": "3c4f01a5-61c4-5739-867d-19ad1ea7e43d",
      "event_id": "E04",
      "context_vi": "Hai bạn vừa đi chơi ở một chợ sách cũ và đều thấy vui. Bạn muốn rủ bạn mình tháng sau lại cùng đi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn rủ",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3c4f01a5-61c4-5739-867d-19ad1ea7e43d-u01",
          "speaker_id": "A",
          "ja": "古本、いいのがあったね。来月も一緒に行かない？",
          "vi": "Sách cũ có mấy cuốn hay nhỉ. Tháng sau lại đi cùng nhau nhé?"
        },
        {
          "id": "3c4f01a5-61c4-5739-867d-19ad1ea7e43d-u02",
          "speaker_id": "B",
          "ja": "行きたい。今度は絵本も見たいな。",
          "vi": "Tớ muốn đi. Lần sau tớ muốn xem cả sách tranh."
        },
        {
          "id": "3c4f01a5-61c4-5739-867d-19ad1ea7e43d-u03",
          "speaker_id": "A",
          "ja": "じゃ、来月の最初の日曜日はどう？",
          "vi": "Vậy Chủ nhật đầu tháng sau thì sao?"
        },
        {
          "id": "3c4f01a5-61c4-5739-867d-19ad1ea7e43d-u04",
          "speaker_id": "B",
          "ja": "いいね。時間が決まったら教えて。",
          "vi": "Được đấy. Chốt giờ rồi báo tớ nhé."
        }
      ],
