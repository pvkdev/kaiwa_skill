    {
      "situation_uid": "bdaa026f-5a7a-52d7-b57a-fe7848112397",
      "event_id": "E04",
      "context_vi": "Bạn và bạn mình đang đi bộ lâu hơn dự định. Thấy có ghế trống, bạn muốn hỏi người kia có muốn ngồi nghỉ không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi dạo",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "bdaa026f-5a7a-52d7-b57a-fe7848112397-u01",
          "speaker_id": "A",
          "ja": "少し休まない？",
          "vi": "Mình nghỉ một lát không?"
        },
        {
          "id": "bdaa026f-5a7a-52d7-b57a-fe7848112397-u02",
          "speaker_id": "B",
          "ja": "うん、ちょっと足が疲れた。",
          "vi": "Ừ, chân tớ hơi mỏi rồi."
        },
        {
          "id": "bdaa026f-5a7a-52d7-b57a-fe7848112397-u03",
          "speaker_id": "A",
          "ja": "あそこにベンチがあるよ。",
          "vi": "Đằng kia có ghế kìa."
        },
        {
          "id": "bdaa026f-5a7a-52d7-b57a-fe7848112397-u04",
          "speaker_id": "B",
          "ja": "じゃ、五分だけ座ろう。",
          "vi": "Vậy mình ngồi năm phút nhé."
        }
      ],
      "admin": {
        "source_refs": [
