    {
      "situation_uid": "5321720d-13f0-5a5b-84fd-8c5341f82b3f",
      "event_id": "E02",
      "context_vi": "Bạn định đi xem triển lãm rồi ăn trưa với bạn mình. Người đó chỉ rảnh từ 11 giờ đến 12 giờ nên hai bạn phải rút ngắn buổi đi chơi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn rủ",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "5321720d-13f0-5a5b-84fd-8c5341f82b3f-u01",
          "speaker_id": "B",
          "ja": "その日は十一時から十二時までしか空いてないんだ。",
          "vi": "Hôm đó tớ chỉ rảnh từ mười một đến mười hai giờ thôi."
        },
        {
          "id": "5321720d-13f0-5a5b-84fd-8c5341f82b3f-u02",
          "speaker_id": "A",
          "ja": "じゃ、ご飯は別の日にして、展示だけ見るのはどう？",
          "vi": "Vậy để hôm khác ăn cùng, hôm đó chỉ xem triển lãm nhé?"
        },
        {
          "id": "5321720d-13f0-5a5b-84fd-8c5341f82b3f-u03",
          "speaker_id": "B",
          "ja": "それなら行けるよ。",
          "vi": "Thế thì tớ đi được."
        },
        {
          "id": "5321720d-13f0-5a5b-84fd-8c5341f82b3f-u04",
          "speaker_id": "A",
