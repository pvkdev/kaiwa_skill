    {
      "situation_uid": "a7d6a38b-9110-5b82-8e20-ee66b4efcbef",
      "event_id": "E03",
      "context_vi": "Bạn rủ bạn mình đi dạo vào sáng Chủ nhật. Bạn ấy chưa biết lịch làm và hai người cần hẹn khi nào nói lại về buổi đi chơi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn rủ",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn chưa rõ lịch",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a7d6a38b-9110-5b82-8e20-ee66b4efcbef-u01",
          "speaker_id": "B",
          "ja": "日曜の朝はまだわからない。バイトが入るかも。",
          "vi": "Sáng Chủ nhật tớ chưa biết. Có thể tớ phải đi làm thêm."
        },
        {
          "id": "a7d6a38b-9110-5b82-8e20-ee66b4efcbef-u02",
          "speaker_id": "A",
          "ja": "何曜日にわかるの？",
          "vi": "Thứ mấy thì cậu biết?"
        },
        {
          "id": "a7d6a38b-9110-5b82-8e20-ee66b4efcbef-u03",
          "speaker_id": "B",
          "ja": "金曜の夕方にはわかるよ。",
          "vi": "Đến chiều thứ Sáu là tớ biết."
        },
        {
          "id": "a7d6a38b-9110-5b82-8e20-ee66b4efcbef-u04",
          "speaker_id": "A",
          "ja": "じゃ、金曜の夜八時に電話するね。",
          "vi": "Vậy tám giờ tối thứ Sáu tớ gọi nhé."
        },
        {
          "id": "a7d6a38b-9110-5b82-8e20-ee66b4efcbef-u05",
          "speaker_id": "B",
          "ja": "うん、その時間なら出られる。",
          "vi": "Ừ, giờ đó tớ nghe máy được."
        }
      ],
      "admin": {
        "source_refs": [],
        "specialty_item_ids": [
          "sj-so-15-b11-5"
