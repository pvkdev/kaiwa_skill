    {
      "situation_uid": "b512b1cd-5e9b-5766-814a-e0d06df64341",
      "event_id": "E02",
      "context_vi": "Hai bạn đã hẹn đi ăn trưa Chủ nhật. Ga có mấy lối ra và bạn muốn chọn một điểm dễ thấy.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn hẹn",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b512b1cd-5e9b-5766-814a-e0d06df64341-u01",
          "speaker_id": "A",
          "ja": "駅の待ち合わせ場所は？",
          "vi": "Mình gặp nhau ở đâu trong ga?"
        },
        {
          "id": "b512b1cd-5e9b-5766-814a-e0d06df64341-u02",
          "speaker_id": "B",
          "ja": "西口ならわかるよ。",
          "vi": "Cửa Tây thì tớ biết."
        },
        {
          "id": "b512b1cd-5e9b-5766-814a-e0d06df64341-u03",
          "speaker_id": "A",
          "ja": "じゃ、西口を出たところの大きな看板の前にしよう。",
          "vi": "Vậy ra cửa Tây, mình gặp trước tấm biển lớn nhé."
        },
        {
          "id": "b512b1cd-5e9b-5766-814a-e0d06df64341-u04",
          "speaker_id": "B",
          "ja": "うん、あの看板ならすぐ見つかるね。",
          "vi": "Ừ, tấm biển ấy dễ tìm."
        }
      ],
      "admin": {
        "source_refs": [
          "place"
        ],
        "specialty_item_ids": [
          "sj-so-15-b12-10"
        ],
        "turn_origins": {
