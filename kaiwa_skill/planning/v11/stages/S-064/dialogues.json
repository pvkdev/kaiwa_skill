    {
      "situation_uid": "22b1b3cf-e6d4-5bd6-afb4-2ee4c012c80b",
      "event_id": "E04",
      "context_vi": "Quán bánh hai bạn định tới đang đóng. Hai bạn muốn qua quán cà phê ven sông và cần xác định đi đường nào.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi chơi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn biết đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "22b1b3cf-e6d4-5bd6-afb4-2ee4c012c80b-u01",
          "speaker_id": "A",
          "ja": "川のそばのカフェって、橋を渡る？",
          "vi": "Qua quán cà phê ven sông thì có cần qua cầu không?"
        },
        {
          "id": "22b1b3cf-e6d4-5bd6-afb4-2ee4c012c80b-u02",
          "speaker_id": "B",
          "ja": "渡らないよ。この道を五分ぐらい歩くと右にある。",
          "vi": "Không cần. Đi bộ dọc đường này khoảng năm phút, quán ở bên phải."
        },
        {
          "id": "22b1b3cf-e6d4-5bd6-afb4-2ee4c012c80b-u03",
          "speaker_id": "A",
          "ja": "じゃ、そのカフェにしよう。この道をまっすぐだね。",
          "vi": "Vậy qua quán đó nhé. Cứ đi thẳng đường này nhỉ."
        },
        {
          "id": "22b1b3cf-e6d4-5bd6-afb4-2ee4c012c80b-u04",
          "speaker_id": "B",
          "ja": "うん、行こう。",
          "vi": "Ừ, mình đi thôi."
        }
      ],
