    {
      "situation_uid": "d98886ad-41b8-569d-afda-a1396ef86df5",
      "event_id": "E01",
      "context_vi": "Bạn vừa hỏi bạn mình có thích đi xem phim hay muốn ở nhà vào chiều Chủ nhật. Người bạn không hứng xem phim nhưng vẫn muốn ra ngoài một lát.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn rủ",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn được rủ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d98886ad-41b8-569d-afda-a1396ef86df5-u01",
          "speaker_id": "B",
          "ja": "映画はいいかな。でも、少し外に出たい。",
          "vi": "Chắc thôi xem phim nhé. Nhưng tớ muốn ra ngoài một lát."
        },
        {
          "id": "d98886ad-41b8-569d-afda-a1396ef86df5-u02",
          "speaker_id": "A",
          "ja": "じゃ、公園を散歩するのはどう？",
          "vi": "Vậy đi dạo trong công viên thì sao?"
        },
        {
          "id": "d98886ad-41b8-569d-afda-a1396ef86df5-u03",
          "speaker_id": "B",
          "ja": "それなら行きたい。",
          "vi": "Thế thì tớ muốn đi."
        },
        {
          "id": "d98886ad-41b8-569d-afda-a1396ef86df5-u04",
          "speaker_id": "A",
          "ja": "じゃあ、日曜は公園にしよう。",
          "vi": "Vậy Chủ nhật mình ra công viên nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "preference"
        ],
        "specialty_item_ids": [
          "sj-so-15-b12-11"
        ],
        "turn_origins": {
