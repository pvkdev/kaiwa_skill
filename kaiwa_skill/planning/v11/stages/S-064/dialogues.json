    {
      "situation_uid": "13d451ae-0f8d-5277-bf70-d48c2af27598",
      "event_id": "E01",
      "context_vi": "Bạn cùng lớp thích ý tưởng uống cà phê trước ga sau buổi học thứ Bảy. Bạn hỏi lúc mấy giờ thì tiện cho cả hai.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn cùng lớp",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "13d451ae-0f8d-5277-bf70-d48c2af27598-u01",
          "speaker_id": "B",
          "ja": "土曜日、コーヒー飲みに行こう。",
          "vi": "Thứ Bảy mình đi uống cà phê nhé."
        },
        {
          "id": "13d451ae-0f8d-5277-bf70-d48c2af27598-u02",
          "speaker_id": "A",
          "ja": "うん。何時がいい？",
          "vi": "Ừ. Mấy giờ thì tiện cho cậu?"
        },
        {
          "id": "13d451ae-0f8d-5277-bf70-d48c2af27598-u03",
          "speaker_id": "B",
          "ja": "一度家に帰るから、十二時半はどう？",
          "vi": "Tớ phải ghé về nhà một chút. Mười hai rưỡi thì sao?"
        },
        {
          "id": "13d451ae-0f8d-5277-bf70-d48c2af27598-u04",
          "speaker_id": "A",
          "ja": "ちょうどいいよ。じゃ、十二時半ね。",
          "vi": "Giờ đó vừa đẹp. Vậy mười hai rưỡi nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "invite"
        ],
        "specialty_item_ids": [
          "sj-so-15-b12-11"
        ],
        "turn_origins": {
