    {
      "situation_uid": "eb76ce0b-59e0-56da-8e3f-4ed426bd3a12",
      "event_id": "E04",
      "context_vi": "Hai bạn đến nơi mới thấy quán bánh đóng cửa. Bạn muốn cùng người kia tìm một chỗ khác để ngồi ăn nhẹ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn đi chơi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đi cùng",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "eb76ce0b-59e0-56da-8e3f-4ed426bd3a12-u01",
          "speaker_id": "B",
          "ja": "あれ、パン屋、今日は休みだね。",
          "vi": "Ơ, hôm nay tiệm bánh nghỉ rồi."
        },
        {
          "id": "eb76ce0b-59e0-56da-8e3f-4ed426bd3a12-u02",
          "speaker_id": "A",
          "ja": "川のそばのカフェはどう？ 外にも席があるよ。",
          "vi": "Quán cà phê ven sông thì sao? Ngoài trời cũng có chỗ ngồi."
        },
        {
          "id": "eb76ce0b-59e0-56da-8e3f-4ed426bd3a12-u03",
          "speaker_id": "B",
          "ja": "外に座れるなら、そっちがいいな。",
          "vi": "Nếu ngồi ngoài được thì tớ thích qua đó."
        },
        {
          "id": "eb76ce0b-59e0-56da-8e3f-4ed426bd3a12-u04",
          "speaker_id": "A",
          "ja": "うん。ここからどう行くんだっけ。",
          "vi": "Ừ. Từ đây đi thế nào nhỉ?"
        }
      ],
      "admin": {
