  "dialogues": [
    {
      "situation_uid": "49225882-4d10-5fca-9d88-49cda19b641b",
      "event_id": "E01",
      "context_vi": "Lớp tiếng Nhật của bạn có buổi học sáng thứ Bảy. Bạn muốn rủ một bạn cùng lớp đi uống cà phê sau buổi học.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn cùng lớp",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "49225882-4d10-5fca-9d88-49cda19b641b-u01",
          "speaker_id": "A",
          "ja": "土曜日、授業のあとは？",
          "vi": "Thứ Bảy tan học cậu có kế hoạch gì chưa?"
        },
        {
          "id": "49225882-4d10-5fca-9d88-49cda19b641b-u02",
          "speaker_id": "B",
          "ja": "まだ何もないよ。",
          "vi": "Tớ chưa có kế hoạch gì."
        },
        {
          "id": "49225882-4d10-5fca-9d88-49cda19b641b-u03",
          "speaker_id": "A",
          "ja": "じゃ、駅前でコーヒー飲まない？",
          "vi": "Vậy ra trước ga uống cà phê nhé?"
        },
        {
          "id": "49225882-4d10-5fca-9d88-49cda19b641b-u04",
          "speaker_id": "B",
          "ja": "いいね。駅前なら行きやすいよ。",
          "vi": "Hay đấy. Trước ga thì tớ đi dễ."
        }
      ],
      "admin": {
        "source_refs": [
          "invite"
        ],
        "specialty_item_ids": [
          "sj-so-15-b12-10"
        ],
        "turn_origins": {
