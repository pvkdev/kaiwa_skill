    {
      "situation_uid": "c6769e6e-5eb1-55e5-a2b6-0a2402f9da70",
      "event_id": "E01",
      "context_vi": "Hai bạn đang bàn xem chiều Chủ nhật nên ra rạp hay ở nhà. Bạn muốn nghe xem người kia thích làm gì trước khi quyết định.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn rủ",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn được rủ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c6769e6e-5eb1-55e5-a2b6-0a2402f9da70-u01",
          "speaker_id": "A",
          "ja": "日曜の午後、映画に行く？ それとも家でゆっくりする？",
          "vi": "Chiều Chủ nhật đi xem phim nhé? Hay cậu muốn nghỉ ở nhà?"
        },
        {
          "id": "c6769e6e-5eb1-55e5-a2b6-0a2402f9da70-u02",
          "speaker_id": "B",
          "ja": "うーん、どうしようかな。",
          "vi": "Ừm, để tớ xem nào."
        },
        {
          "id": "c6769e6e-5eb1-55e5-a2b6-0a2402f9da70-u03",
          "speaker_id": "A",
          "ja": "どっちでもいいよ。",
          "vi": "Tớ thấy cách nào cũng được."
        },
        {
          "id": "c6769e6e-5eb1-55e5-a2b6-0a2402f9da70-u04",
          "speaker_id": "B",
          "ja": "ちょっと考えるね。",
          "vi": "Để tớ nghĩ chút nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "invite",
          "preference"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "c6769e6e-5eb1-55e5-a2b6-0a2402f9da70-u01": {
