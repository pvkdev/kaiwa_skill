    {
      "situation_uid": "62e17530-fddb-5503-a477-1fe980595e82",
      "event_id": "E03",
      "context_vi": "Đúng tám giờ tối thứ Sáu, bạn gọi như đã hẹn để hỏi bạn mình có rảnh sáng Chủ nhật đi dạo không.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn gọi",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe máy",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "62e17530-fddb-5503-a477-1fe980595e82-u01",
          "speaker_id": "A",
          "ja": "もしもし。日曜の朝、行けそう？",
          "vi": "A lô. Sáng Chủ nhật cậu đi được không?"
        },
        {
          "id": "62e17530-fddb-5503-a477-1fe980595e82-u02",
          "speaker_id": "B",
          "ja": "うん、日曜はバイトが休みになったよ。",
          "vi": "Ừ, Chủ nhật tớ được nghỉ làm rồi."
        },
        {
          "id": "62e17530-fddb-5503-a477-1fe980595e82-u03",
          "speaker_id": "A",
          "ja": "じゃ、十時に公園の入口で会おうか。",
          "vi": "Vậy mười giờ mình gặp ở cổng công viên nhé?"
        },
        {
          "id": "62e17530-fddb-5503-a477-1fe980595e82-u04",
          "speaker_id": "B",
          "ja": "いいよ。日曜の十時ね。",
          "vi": "Được. Chủ nhật lúc mười giờ nhé."
        }
      ],
