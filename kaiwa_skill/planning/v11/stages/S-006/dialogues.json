    {
      "situation_uid": "fe3d4151-d884-5f72-9a8a-6117e8655c96",
      "event_id": "E02",
      "context_vi": "Trong bữa tối đầu tiên lúc khoảng bảy giờ, cô Yumi mời bạn ăn thêm cơm. Bạn đã no và muốn từ chối nhẹ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cô Yumi, người nấu bữa tối",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "fe3d4151-d884-5f72-9a8a-6117e8655c96-u01",
          "speaker_id": "b",
          "ja": "ご飯、もう少しいかがですか。",
          "vi": "Cháu ăn thêm chút cơm nhé?"
        },
        {
          "id": "fe3d4151-d884-5f72-9a8a-6117e8655c96-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。でも、もうおなかがいっぱいです。",
          "vi": "Cháu cảm ơn cô. Nhưng cháu no rồi ạ."
        },
        {
          "id": "fe3d4151-d884-5f72-9a8a-6117e8655c96-u03",
          "speaker_id": "b",
          "ja": "そうですか。",
          "vi": "Vậy à."
        },
        {
          "id": "fe3d4151-d884-5f72-9a8a-6117e8655c96-u04",
          "speaker_id": "a",
          "ja": "とてもおいしかったです。",
          "vi": "Bữa ăn ngon lắm ạ."
        }
      ],
      "admin": {
