    {
      "situation_uid": "4c6e0f71-5c76-52dc-9177-de1134f5a755",
      "event_id": "E03",
      "context_vi": "Ở gần phòng tắm, cô Yumi nhắc nhanh rằng khăn sạch để kệ, khăn dùng rồi để giỏ. Bạn chưa hiểu và xin một ví dụ cụ thể.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cô Yumi, chủ nhà",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4c6e0f71-5c76-52dc-9177-de1134f5a755-u01",
          "speaker_id": "a",
          "ja": "すみません、もう一度、例をお願いします。",
          "vi": "Xin lỗi cô, cô cho cháu một ví dụ được không ạ?"
        },
        {
          "id": "4c6e0f71-5c76-52dc-9177-de1134f5a755-u02",
          "speaker_id": "b",
          "ja": "この白いタオルはきれいです。棚です。使った後は、かごです。",
          "vi": "Khăn trắng này là khăn sạch, để ở kệ. Dùng xong thì để vào giỏ."
        },
        {
          "id": "4c6e0f71-5c76-52dc-9177-de1134f5a755-u03",
          "speaker_id": "a",
          "ja": "使った後は、このかごですね。",
          "vi": "Dùng xong thì để vào giỏ này nhỉ."
        },
        {
          "id": "4c6e0f71-5c76-52dc-9177-de1134f5a755-u04",
          "speaker_id": "b",
          "ja": "はい、そうです。",
          "vi": "Ừ, đúng rồi."
        }
      ],
