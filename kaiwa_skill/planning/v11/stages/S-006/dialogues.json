      ],
      "turns": [
        {
          "id": "3c3c25c3-6550-543c-80ad-51398cd2e3ef-u01",
          "speaker_id": "a",
          "ja": "ドライヤーを使ってもいいですか。",
          "vi": "Cháu dùng máy sấy tóc được không ạ?"
