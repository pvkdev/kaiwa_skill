        }
      }
    },
    {
      "situation_uid": "933672df-68f4-5ec3-9b1d-32e01e3cc0fd",
      "event_id": "E02",
      "context_vi": "Ngày đầu ở nhà Tanaka, bạn muốn biết bữa tối lúc mấy giờ và mình ngồi chỗ nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ông Tanaka, chủ nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "933672df-68f4-5ec3-9b1d-32e01e3cc0fd-u01",
          "speaker_id": "a",
          "ja": "晩ご飯は何時ごろですか。",
          "vi": "Bữa tối khoảng mấy giờ ạ?"
        },
        {
          "id": "933672df-68f4-5ec3-9b1d-32e01e3cc0fd-u02",
          "speaker_id": "b",
          "ja": "七時ごろです。",
          "vi": "Khoảng bảy giờ."
        },
        {
          "id": "933672df-68f4-5ec3-9b1d-32e01e3cc0fd-u03",
          "speaker_id": "a",
          "ja": "私はどこに座ればいいですか。",
          "vi": "Cháu ngồi chỗ nào ạ?"
        },
        {
          "id": "933672df-68f4-5ec3-9b1d-32e01e3cc0fd-u04",
          "speaker_id": "b",
          "ja": "この席にどうぞ。",
          "vi": "Cháu ngồi ghế này nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "933672df-68f4-5ec3-9b1d-32e01e3cc0fd-u01": {
            "kind": "original_extension"
