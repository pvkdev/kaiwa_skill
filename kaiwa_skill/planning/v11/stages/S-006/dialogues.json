          }
        }
      }
    },
    {
      "situation_uid": "a83fe791-edd3-5880-9fe9-fc257cc9563d",
      "event_id": "E01",
      "context_vi": "Tiếp lần gặp đầu: ông Tanaka đã nói vợ tên Yumi, nhưng bạn không nghe rõ. Bạn hỏi lại tên để gọi đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ông Tanaka, chủ nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a83fe791-edd3-5880-9fe9-fc257cc9563d-u01",
          "speaker_id": "a",
          "ja": "すみません、奥さんの名前をもう一度お願いします。",
          "vi": "Xin lỗi bác, bác nhắc lại tên cô nhà được không ạ?"
        },
        {
          "id": "a83fe791-edd3-5880-9fe9-fc257cc9563d-u02",
          "speaker_id": "b",
          "ja": "ユミです。",
          "vi": "Yumi."
        },
        {
          "id": "a83fe791-edd3-5880-9fe9-fc257cc9563d-u03",
          "speaker_id": "a",
          "ja": "ユミさんですね。ありがとうございます。",
          "vi": "Cô Yumi nhỉ. Cháu cảm ơn bác."
        }
      ],
      "admin": {
        "source_refs": [
          "home",
          "repeat"
        ],
        "specialty_item_ids": [
          "sj-so-01-b07-146"
        ],
        "turn_origins": {
