        }
      }
    },
    {
      "situation_uid": "ebde9387-5600-51ca-8be0-0fb4ea0d5ed0",
      "event_id": "E02",
      "context_vi": "Trong bữa tối, cô Yumi mời bạn món cá sống. Bạn chưa ăn được món đó và muốn nói nhẹ mà vẫn cảm ơn người nấu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cô Yumi, người nấu bữa tối",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "ebde9387-5600-51ca-8be0-0fb4ea0d5ed0-u01",
          "speaker_id": "b",
          "ja": "お刺身もどうぞ。",
          "vi": "Cháu dùng thêm sashimi nhé."
        },
        {
          "id": "ebde9387-5600-51ca-8be0-0fb4ea0d5ed0-u02",
          "speaker_id": "a",
          "ja": "ありがとうございます。でも、生の魚はまだ食べられません。",
          "vi": "Cháu cảm ơn cô. Nhưng hiện giờ cháu chưa ăn được cá sống."
        },
        {
          "id": "ebde9387-5600-51ca-8be0-0fb4ea0d5ed0-u03",
          "speaker_id": "b",
          "ja": "そうですか。では、こちらの野菜をどうぞ。",
          "vi": "Vậy à. Thế cháu dùng rau này nhé."
        },
        {
          "id": "ebde9387-5600-51ca-8be0-0fb4ea0d5ed0-u04",
          "speaker_id": "a",
          "ja": "はい、いただきます。",
          "vi": "Vâng, cháu xin dùng ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
