    {
      "situation_uid": "6768b0de-07f9-5d2d-b1d2-2699cfb603a1",
      "event_id": "E04",
      "context_vi": "Mới đến nhà Tanaka, bạn muốn gọi thoại cho gia đình mình. Bạn hỏi ông Tanaka có Wi-Fi dùng trong nhà không và xin ông chỉ cách kết nối sau.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ông Tanaka, chủ nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6768b0de-07f9-5d2d-b1d2-2699cfb603a1-u01",
          "speaker_id": "a",
          "ja": "家族に電話したいです。家のWi-Fiを使ってもいいですか。",
          "vi": "Cháu muốn gọi cho gia đình. Cháu dùng Wi-Fi nhà mình được không ạ?"
        },
        {
          "id": "6768b0de-07f9-5d2d-b1d2-2699cfb603a1-u02",
          "speaker_id": "b",
          "ja": "はい、いいですよ。あとでつなぎ方を見せます。",
          "vi": "Được chứ. Lát nữa bác chỉ cách kết nối."
        },
        {
          "id": "6768b0de-07f9-5d2d-b1d2-2699cfb603a1-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。助かります。",
          "vi": "Cháu cảm ơn bác. Vậy giúp cháu nhiều lắm."
        }
      ],
