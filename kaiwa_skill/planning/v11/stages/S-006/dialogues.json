            "kind": "original_extension"
          },
          "a83fe791-edd3-5880-9fe9-fc257cc9563d-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d100816e-9099-5ed9-8e42-8479c2c86c26",
      "event_id": "E01",
      "context_vi": "Sau khi bạn chào ông Tanaka lúc đến nhà, con gái ông là Hana vừa về. Ông để hai người tự làm quen.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "Hana, con gái chủ nhà",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "d100816e-9099-5ed9-8e42-8479c2c86c26-u01",
          "speaker_id": "b",
          "ja": "ただいま。あ、はじめまして。ハナです。田中の娘です。",
          "vi": "Con về rồi. À, rất vui được gặp chị. Em là Hana, con gái bác Tanaka."
        },
        {
          "id": "d100816e-9099-5ed9-8e42-8479c2c86c26-u02",
          "speaker_id": "a",
          "ja": "はじめまして。リンです。今日からお世話になります。",
          "vi": "Rất vui được gặp em. Chị là Linh. Hôm nay chị mới đến ở."
        },
        {
          "id": "d100816e-9099-5ed9-8e42-8479c2c86c26-u03",
          "speaker_id": "b",
          "ja": "リンさんですね。よろしくお願いします。",
          "vi": "Chị Linh nhỉ. Rất vui được gặp chị."
        }
      ],
      "admin": {
        "source_refs": [
          "home",
          "intro"
        ],
        "specialty_item_ids": [],
