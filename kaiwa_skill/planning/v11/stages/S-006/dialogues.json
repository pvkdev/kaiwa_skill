          "id": "eb183fa8-7529-510f-a579-736b03323032-u01",
          "speaker_id": "a",
          "ja": "お風呂は何時ごろ使えますか。",
          "vi": "Cháu dùng phòng tắm khoảng mấy giờ được ạ?"
        },
        {
          "id": "eb183fa8-7529-510f-a579-736b03323032-u02",
          "speaker_id": "b",
          "ja": "夜八時から十時までです。きれいなタオルはこの棚です。",
          "vi": "Từ tám đến mười giờ tối. Khăn sạch ở kệ này."
        },
        {
          "id": "eb183fa8-7529-510f-a579-736b03323032-u03",
          "speaker_id": "a",
          "ja": "八時から十時ですね。ありがとうございます。",
          "vi": "Từ tám đến mười giờ nhỉ. Cháu cảm ơn bác."
        }
      ],
