        {
          "id": "3c3c25c3-6550-543c-80ad-51398cd2e3ef-u02",
          "speaker_id": "b",
          "ja": "ごめんなさい。今、私が使います。",
          "vi": "Xin lỗi cháu. Bây giờ cô cần dùng."
        },
        {
          "id": "3c3c25c3-6550-543c-80ad-51398cd2e3ef-u03",
          "speaker_id": "a",
          "ja": "わかりました。あとで借りてもいいですか。",
