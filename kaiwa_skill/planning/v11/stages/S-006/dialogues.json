    {
      "situation_uid": "eb183fa8-7529-510f-a579-736b03323032",
      "event_id": "E03",
      "context_vi": "Ngày đầu ở nhà Tanaka, bạn hỏi ông về giờ có thể dùng phòng tắm. Ông cũng chỉ nơi lấy khăn sạch. Đây là quy ước riêng của gia đình.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
