  "dialogues": [
    {
      "situation_uid": "abe13291-2218-568f-bffa-bb157e85e783",
      "event_id": "E01",
      "context_vi": "Bạn mới đến ở cùng gia đình Tanaka. Người chủ nhà ra đón và giới thiệu rằng vợ ông tên Yumi. Bạn muốn biết nên gọi hai người thế nào.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ông Tanaka, chủ nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "abe13291-2218-568f-bffa-bb157e85e783-u01",
          "speaker_id": "a",
          "ja": "はじめまして。リンです。これからよろしくお願いします。",
          "vi": "Rất vui được gặp bác. Cháu là Linh. Từ nay mong bác giúp đỡ."
        },
        {
          "id": "abe13291-2218-568f-bffa-bb157e85e783-u02",
          "speaker_id": "b",
          "ja": "田中です。妻はユミです。",
          "vi": "Tôi là Tanaka. Vợ tôi tên Yumi."
        },
        {
          "id": "abe13291-2218-568f-bffa-bb157e85e783-u03",
          "speaker_id": "a",
          "ja": "田中さん、ユミさんと呼んでいいですか。",
          "vi": "Cháu gọi bác là bác Tanaka và cô ấy là cô Yumi được không ạ?"
        },
        {
          "id": "abe13291-2218-568f-bffa-bb157e85e783-u04",
          "speaker_id": "b",
          "ja": "はい、それでいいですよ。",
          "vi": "Ừ, cháu cứ gọi vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "home",
          "intro"
        ],
        "specialty_item_ids": [],
