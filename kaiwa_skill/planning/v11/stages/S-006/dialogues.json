    {
      "situation_uid": "996193a1-c812-5e19-a2d7-203ecbcb0593",
      "event_id": "E02",
      "context_vi": "Bạn đã biết gia đình Tanaka thường ăn tối khoảng bảy giờ. Hôm nay bạn sẽ về lúc tám rưỡi nên gọi báo trước và hỏi còn phần ăn hay nên tự lo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ông Tanaka, chủ nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "996193a1-c812-5e19-a2d7-203ecbcb0593-u01",
          "speaker_id": "a",
          "ja": "田中さん、今日は八時半ごろ帰ります。",
          "vi": "Bác Tanaka, hôm nay khoảng tám rưỡi cháu mới về."
        },
        {
          "id": "996193a1-c812-5e19-a2d7-203ecbcb0593-u02",
          "speaker_id": "b",
          "ja": "わかりました。晩ご飯はどうしますか。",
          "vi": "Bác biết rồi. Bữa tối cháu tính sao?"
        },
        {
          "id": "996193a1-c812-5e19-a2d7-203ecbcb0593-u03",
          "speaker_id": "a",
          "ja": "私のご飯はありますか。それとも外で食べますか。",
          "vi": "Nhà còn phần ăn cho cháu không ạ, hay cháu ăn bên ngoài?"
        },
        {
          "id": "996193a1-c812-5e19-a2d7-203ecbcb0593-u04",
          "speaker_id": "b",
          "ja": "一人分あります。温めて食べてください。",
          "vi": "Có một phần cho cháu. Cháu hâm lại rồi ăn nhé."
        },
        {
          "id": "996193a1-c812-5e19-a2d7-203ecbcb0593-u05",
          "speaker_id": "a",
          "ja": "ありがとうございます。そうします。",
          "vi": "Cháu cảm ơn bác. Cháu sẽ làm vậy."
        }
      ],
      "admin": {
        "source_refs": [
          "home"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "996193a1-c812-5e19-a2d7-203ecbcb0593-u01": {
