    {
      "situation_uid": "4d571fa6-5871-5a64-9c1f-3ce03fad668d",
      "event_id": "E03",
      "context_vi": "Bạn đã biết kệ gần phòng tắm là chỗ lấy khăn sạch. Sau khi tắm, bạn lỡ đặt khăn ướt lên chính kệ đó; cô Yumi nhắc chỗ để khăn đã dùng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "cô Yumi, chủ nhà",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4d571fa6-5871-5a64-9c1f-3ce03fad668d-u01",
          "speaker_id": "b",
          "ja": "リンさん、ぬれたタオルはこのかごにお願いします。",
          "vi": "Linh, khăn ướt cháu để vào giỏ này nhé."
        },
        {
          "id": "4d571fa6-5871-5a64-9c1f-3ce03fad668d-u02",
          "speaker_id": "a",
          "ja": "すみません。きれいなタオルの棚に置きました。",
          "vi": "Cháu xin lỗi. Cháu đã để lên kệ khăn sạch."
        },
        {
          "id": "4d571fa6-5871-5a64-9c1f-3ce03fad668d-u03",
          "speaker_id": "b",
          "ja": "大丈夫です。このかごです。",
          "vi": "Không sao. Là giỏ này."
        },
        {
          "id": "4d571fa6-5871-5a64-9c1f-3ce03fad668d-u04",
          "speaker_id": "a",
          "ja": "はい、今、かごに入れます。",
          "vi": "Vâng, cháu bỏ vào giỏ ngay ạ."
        }
      ],
      "admin": {
