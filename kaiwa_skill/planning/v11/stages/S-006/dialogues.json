        }
      }
    },
    {
      "situation_uid": "78ce5171-b296-540a-adc0-4377992a6cc3",
      "event_id": "E01",
      "context_vi": "Trong bữa đầu, ông Tanaka hỏi về gia đình bạn. Bạn muốn nói ngắn rằng bố mẹ ở Đà Nẵng và bạn có một em trai.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ông Tanaka, chủ nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "78ce5171-b296-540a-adc0-4377992a6cc3-u01",
          "speaker_id": "b",
          "ja": "リンさんの家族は、どこにいますか。",
          "vi": "Gia đình cháu ở đâu?"
        },
        {
          "id": "78ce5171-b296-540a-adc0-4377992a6cc3-u02",
          "speaker_id": "a",
          "ja": "両親はダナンにいます。弟が一人います。",
          "vi": "Bố mẹ cháu ở Đà Nẵng. Cháu có một em trai."
        },
        {
          "id": "78ce5171-b296-540a-adc0-4377992a6cc3-u03",
          "speaker_id": "b",
          "ja": "そうですか。弟さんは学生ですか。",
          "vi": "Vậy à. Em trai cháu còn đi học à?"
        },
        {
          "id": "78ce5171-b296-540a-adc0-4377992a6cc3-u04",
          "speaker_id": "a",
          "ja": "はい、大学生です。",
          "vi": "Vâng, em cháu học đại học."
        }
      ],
      "admin": {
        "source_refs": [
          "intro"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "78ce5171-b296-540a-adc0-4377992a6cc3-u01": {
