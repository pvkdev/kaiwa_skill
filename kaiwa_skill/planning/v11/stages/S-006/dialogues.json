    {
      "situation_uid": "6675f6e5-4756-5496-83d9-2f610a2687bf",
      "event_id": "E04",
      "context_vi": "Sau khi ông Tanaka hứa chỉ cách nối Wi-Fi, ông nói đang bận. Bạn cần gọi cho gia đình nên hỏi lúc nào ông có thể giúp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ông Tanaka, chủ nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "6675f6e5-4756-5496-83d9-2f610a2687bf-u01",
          "speaker_id": "b",
          "ja": "ごめんなさい。今、少し忙しいです。",
          "vi": "Xin lỗi cháu. Giờ bác đang bận một chút."
        },
        {
          "id": "6675f6e5-4756-5496-83d9-2f610a2687bf-u02",
          "speaker_id": "a",
          "ja": "わかりました。いつなら大丈夫ですか。",
          "vi": "Cháu hiểu. Khi nào bác tiện ạ?"
        },
        {
          "id": "6675f6e5-4756-5496-83d9-2f610a2687bf-u03",
          "speaker_id": "b",
          "ja": "晩ご飯の後なら大丈夫です。",
          "vi": "Sau bữa tối thì được."
        },
        {
          "id": "6675f6e5-4756-5496-83d9-2f610a2687bf-u04",
          "speaker_id": "a",
          "ja": "では、晩ご飯の後にお願いします。",
          "vi": "Vậy sau bữa tối nhờ bác nhé."
        }
      ],
