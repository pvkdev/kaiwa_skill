    {
      "situation_uid": "a059e697-c9fe-526f-a751-203a2e5d88ef",
      "event_id": "E04",
      "context_vi": "Bạn sẽ ngủ lại nhà bạn một tối. Bạn báo ông Tanaka trước để ông không chờ bữa tối, rồi hỏi cách liên lạc nếu có việc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "ông Tanaka, chủ nhà",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "a059e697-c9fe-526f-a751-203a2e5d88ef-u01",
          "speaker_id": "a",
          "ja": "明日の夜は友達の家に泊まります。晩ご飯はいりません。",
          "vi": "Tối mai cháu ngủ ở nhà bạn. Bác không cần để phần ăn tối cho cháu ạ."
        },
        {
          "id": "a059e697-c9fe-526f-a751-203a2e5d88ef-u02",
          "speaker_id": "b",
          "ja": "わかりました。何かあれば電話してください。",
          "vi": "Bác biết rồi. Có việc gì thì gọi điện nhé."
        },
        {
          "id": "a059e697-c9fe-526f-a751-203a2e5d88ef-u03",
          "speaker_id": "a",
          "ja": "はい。電話番号を確認してもいいですか。",
          "vi": "Vâng. Cháu xác nhận lại số điện thoại được không ạ?"
        },
        {
          "id": "a059e697-c9fe-526f-a751-203a2e5d88ef-u04",
          "speaker_id": "b",
          "ja": "はい、あとで一緒に確認しましょう。",
          "vi": "Được, lát nữa mình cùng kiểm nhé."
        }
      ],
