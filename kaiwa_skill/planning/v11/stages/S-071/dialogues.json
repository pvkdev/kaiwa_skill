    {
      "situation_uid": "45a86827-63cd-5bca-ab09-8ed13040c82b",
      "event_id": "E04",
      "context_vi": "Bạn của bạn không muốn kể lý do riêng đã đổi lịch. Hai người đã chuyển sang chuyện chung là chọn hôm có thể gặp. Bạn nhắc lại ý chính trước khi hỏi về tuần sau.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn trò chuyện",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn muốn giữ riêng tư",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "45a86827-63cd-5bca-ab09-8ed13040c82b-u01",
          "speaker_id": "A",
          "ja": "じゃ、今週末は会わないで、別の日にしよう。",
          "vi": "Vậy cuối tuần này mình không gặp. Để hôm khác nhé."
        },
        {
          "id": "45a86827-63cd-5bca-ab09-8ed13040c82b-u02",
          "speaker_id": "B",
          "ja": "うん、そうしよう。",
          "vi": "Ừ, vậy nhé."
        },
        {
          "id": "45a86827-63cd-5bca-ab09-8ed13040c82b-u03",
          "speaker_id": "A",
          "ja": "来週、いつなら会えそう？",
          "vi": "Tuần sau hôm nào cậu có thể gặp?"
        },
        {
          "id": "45a86827-63cd-5bca-ab09-8ed13040c82b-u04",
          "speaker_id": "B",
          "ja": "土曜の午後なら大丈夫だよ。",
          "vi": "Chiều thứ Bảy thì tớ đi được."
        }
      ],
