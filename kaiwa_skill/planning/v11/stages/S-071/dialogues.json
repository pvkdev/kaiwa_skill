    {
      "situation_uid": "94eabf65-8695-5c24-b52d-340cbba4572e",
      "event_id": "E04",
      "context_vi": "Bạn kể chuyện lần đầu tự làm bánh ở một lớp ngắn. Bạn mình cũng thấy thú vị, nên bạn rủ lần sau đi một buổi cho người mới cùng nhau.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người rủ",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn được rủ",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "94eabf65-8695-5c24-b52d-340cbba4572e-u01",
          "speaker_id": "A",
          "ja": "パン作り、楽しかったよ。今度、一緒にやってみない？",
          "vi": "Làm bánh mì vui lắm. Lần sau mình thử cùng nhau nhé?"
        },
        {
          "id": "94eabf65-8695-5c24-b52d-340cbba4572e-u02",
          "speaker_id": "B",
          "ja": "初めてでもできるかな。",
          "vi": "Chưa làm bao giờ thì có học được không nhỉ?"
        },
        {
          "id": "94eabf65-8695-5c24-b52d-340cbba4572e-u03",
          "speaker_id": "A",
          "ja": "私が行ったクラスは初めての人向けだったよ。",
          "vi": "Lớp tớ đi là lớp dành cho người mới đó."
        },
        {
          "id": "94eabf65-8695-5c24-b52d-340cbba4572e-u04",
          "speaker_id": "B",
          "ja": "それなら行きたいな。次はいつあるか見よう。",
          "vi": "Thế thì tớ muốn đi. Mình xem lần tới tổ chức khi nào nhé."
        }
      ],
