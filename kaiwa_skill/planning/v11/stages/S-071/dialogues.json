    {
      "situation_uid": "9734cccd-8b60-515e-9944-a5cc15ab4abc",
      "event_id": "E03",
      "context_vi": "Bạn nghe kể về chiếc túi bỏ quên ở trường. Bạn tưởng người gọi cho trường là bạn mình và muốn kiểm lại ai đã gọi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn nghe",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn kể",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9734cccd-8b60-515e-9944-a5cc15ab4abc-u01",
          "speaker_id": "B",
          "ja": "学校にかばんを忘れて、妹に話したんだ。",
          "vi": "Tớ bỏ quên túi ở trường rồi kể cho em gái."
        },
        {
          "id": "9734cccd-8b60-515e-9944-a5cc15ab4abc-u02",
          "speaker_id": "A",
          "ja": "それで、学校に電話したの？",
          "vi": "Thế rồi cậu gọi cho trường à?"
        },
        {
          "id": "9734cccd-8b60-515e-9944-a5cc15ab4abc-u03",
          "speaker_id": "B",
          "ja": "電話したのは妹だよ。",
          "vi": "Em gái tớ gọi ấy."
        },
        {
          "id": "9734cccd-8b60-515e-9944-a5cc15ab4abc-u04",
          "speaker_id": "A",
          "ja": "あ、妹さんが電話してくれたんだね。",
          "vi": "À, em gái cậu gọi giúp nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "correction"
        ],
