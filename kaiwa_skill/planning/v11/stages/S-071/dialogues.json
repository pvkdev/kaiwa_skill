    {
      "situation_uid": "79d0c2b1-75fb-5bb2-af1b-466d1d9fdcd4",
      "event_id": "E01",
      "context_vi": "Bạn cùng lớp hỏi cuối tuần bạn làm gì. Bạn kể việc đi chợ rồi về nhà nấu món đã mua.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "79d0c2b1-75fb-5bb2-af1b-466d1d9fdcd4-u01",
          "speaker_id": "B",
          "ja": "週末は何をした？",
          "vi": "Cuối tuần cậu làm gì?"
        },
        {
          "id": "79d0c2b1-75fb-5bb2-af1b-466d1d9fdcd4-u02",
          "speaker_id": "A",
          "ja": "土曜の朝、市場で野菜を買ったよ。",
          "vi": "Sáng thứ Bảy tớ ra chợ mua rau."
        },
        {
          "id": "79d0c2b1-75fb-5bb2-af1b-466d1d9fdcd4-u03",
          "speaker_id": "A",
          "ja": "そのあと、家でカレーを作った。",
          "vi": "Sau đó về nhà tớ nấu cà ri."
        },
        {
          "id": "79d0c2b1-75fb-5bb2-af1b-466d1d9fdcd4-u04",
          "speaker_id": "B",
          "ja": "いいね。誰かと食べた？",
          "vi": "Hay đấy. Cậu ăn cùng ai không?"
        },
        {
          "id": "79d0c2b1-75fb-5bb2-af1b-466d1d9fdcd4-u05",
          "speaker_id": "A",
          "ja": "うん、妹と食べたよ。",
          "vi": "Có, tớ ăn với em gái."
        }
      ],
      "admin": {
        "source_refs": [
          "weekend"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "79d0c2b1-75fb-5bb2-af1b-466d1d9fdcd4-u01": {
