    {
      "situation_uid": "c79da04d-9b8e-561d-9616-16cc1e2bdeea",
      "event_id": "E03",
      "context_vi": "Bạn vừa biết em gái của bạn mình đã gọi cho trường về chiếc túi bỏ quên. Bạn muốn nhắc đúng vai và hỏi tiếp ai đi lấy túi.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn nghe",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn kể",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c79da04d-9b8e-561d-9616-16cc1e2bdeea-u01",
          "speaker_id": "A",
          "ja": "妹さんが電話したんだね。かばんは自分で取りに行ったの？",
          "vi": "Em cậu gọi điện nhỉ. Còn túi thì cậu tự đi lấy à?"
        },
        {
          "id": "c79da04d-9b8e-561d-9616-16cc1e2bdeea-u02",
          "speaker_id": "B",
          "ja": "うん。忘れたのは私だからね。",
          "vi": "Ừ. Tớ là người để quên mà."
        },
        {
          "id": "c79da04d-9b8e-561d-9616-16cc1e2bdeea-u03",
          "speaker_id": "A",
          "ja": "いつ取りに行った？",
          "vi": "Cậu tới lấy khi nào?"
        },
        {
          "id": "c79da04d-9b8e-561d-9616-16cc1e2bdeea-u04",
          "speaker_id": "B",
          "ja": "次の日の朝。先生が持っていてくれたよ。",
          "vi": "Sáng hôm sau. Thầy giữ giúp tớ."
        }
      ],
      "admin": {
