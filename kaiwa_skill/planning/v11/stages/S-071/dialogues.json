  "dialogues": [
    {
      "situation_uid": "8ada810d-710f-5a8a-9054-95e22f92d79d",
      "event_id": "E01",
      "context_vi": "Vừa tới trường sáng nay, bạn kể cho bạn cùng lớp một chuyện lạ gặp trên đoạn đường ngang công viên.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8ada810d-710f-5a8a-9054-95e22f92d79d-u01",
          "speaker_id": "A",
          "ja": "今朝、学校に来る途中で変なことがあったよ。",
          "vi": "Sáng nay trên đường tới trường tớ gặp chuyện lạ."
        },
        {
          "id": "8ada810d-710f-5a8a-9054-95e22f92d79d-u02",
          "speaker_id": "B",
          "ja": "何があったの？",
          "vi": "Có chuyện gì thế?"
        },
        {
          "id": "8ada810d-710f-5a8a-9054-95e22f92d79d-u03",
          "speaker_id": "A",
          "ja": "公園の前で、アヒルが道の真ん中にいたんだ。",
          "vi": "Trước công viên có một con vịt đứng giữa đường."
        },
        {
          "id": "8ada810d-710f-5a8a-9054-95e22f92d79d-u04",
          "speaker_id": "B",
          "ja": "えっ、みんなどうしたの？",
          "vi": "Ơ, thế mọi người làm sao?"
        },
        {
          "id": "8ada810d-710f-5a8a-9054-95e22f92d79d-u05",
          "speaker_id": "A",
          "ja": "アヒルが渡るまで、みんな待ってたよ。",
          "vi": "Ai cũng đợi cho vịt qua đường rồi mới đi."
        }
      ],
      "admin": {
        "source_refs": [
          "weekend"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "8ada810d-710f-5a8a-9054-95e22f92d79d-u01": {
