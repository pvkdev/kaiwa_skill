    {
      "situation_uid": "f177ef41-e4ec-536e-b221-b741ae90e7df",
      "event_id": "E03",
      "context_vi": "Bạn mình kể chuyện đi xem hội chợ. Bạn muốn nhắc đúng chi tiết khiến người đó ngạc nhiên là có người chơi nhạc dù trời đang mưa.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn nghe",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn kể",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f177ef41-e4ec-536e-b221-b741ae90e7df-u01",
          "speaker_id": "B",
          "ja": "雨なのに、外で演奏していてびっくりした。",
          "vi": "Trời mưa mà họ vẫn biểu diễn bên ngoài, tớ ngạc nhiên lắm."
        },
        {
          "id": "f177ef41-e4ec-536e-b221-b741ae90e7df-u02",
          "speaker_id": "A",
          "ja": "雨の中でも演奏を続けたから、驚いたんだね。",
          "vi": "Cậu ngạc nhiên vì họ vẫn chơi nhạc dưới mưa nhỉ."
        },
        {
          "id": "f177ef41-e4ec-536e-b221-b741ae90e7df-u03",
          "speaker_id": "B",
          "ja": "そうそう。大きいテントの下でね。",
          "vi": "Ừ, đúng rồi. Họ chơi dưới lều lớn ấy."
        },
        {
          "id": "f177ef41-e4ec-536e-b221-b741ae90e7df-u04",
          "speaker_id": "A",
          "ja": "へえ。どんな楽器だったの？",
          "vi": "Ồ. Họ chơi nhạc cụ gì vậy?"
        }
      ],
      "admin": {
