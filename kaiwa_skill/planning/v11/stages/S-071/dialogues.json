    {
      "situation_uid": "3f9623e6-ebdf-5bc3-bb1c-eaa136a8eb2b",
      "event_id": "E02",
      "context_vi": "Bạn định đi xe đạp dọc sông trong chuyến đi cuối tuần. Trời đổ mưa giữa chừng nên bạn kể cho bạn mình nghe bạn đã đổi sang hoạt động gì.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "3f9623e6-ebdf-5bc3-bb1c-eaa136a8eb2b-u01",
          "speaker_id": "A",
          "ja": "川のそばを自転車で走るつもりだったよ。",
          "vi": "Tớ định đạp xe dọc bờ sông."
        },
        {
          "id": "3f9623e6-ebdf-5bc3-bb1c-eaa136a8eb2b-u02",
          "speaker_id": "B",
          "ja": "走れた？",
          "vi": "Cậu có đạp được không?"
        },
        {
          "id": "3f9623e6-ebdf-5bc3-bb1c-eaa136a8eb2b-u03",
          "speaker_id": "A",
          "ja": "途中で雨が降って、近くの小さな美術館に入った。",
          "vi": "Đang đi thì trời mưa, tớ vào một bảo tàng mỹ thuật nhỏ gần đó."
        },
        {
          "id": "3f9623e6-ebdf-5bc3-bb1c-eaa136a8eb2b-u04",
          "speaker_id": "B",
          "ja": "美術館はどうだった？",
          "vi": "Bảo tàng thế nào?"
        },
        {
          "id": "3f9623e6-ebdf-5bc3-bb1c-eaa136a8eb2b-u05",
          "speaker_id": "A",
          "ja": "静かでよかったよ。ゆっくり見られた。",
          "vi": "Yên tĩnh, thích lắm. Tớ xem thong thả được."
        }
      ],
      "admin": {
