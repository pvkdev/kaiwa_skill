    {
      "situation_uid": "f11785d7-733e-5b81-8ae5-2ed3a0060459",
      "event_id": "E04",
      "context_vi": "Bạn hỏi vì sao người kia phải đổi kế hoạch cuối tuần. Bạn ấy không muốn kể chuyện riêng về gia đình, nên bạn tôn trọng và đổi sang chuyện tìm hôm rảnh.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn trò chuyện",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn muốn giữ riêng tư",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f11785d7-733e-5b81-8ae5-2ed3a0060459-u01",
          "speaker_id": "B",
          "ja": "家のことだから、あまり話したくないな。",
          "vi": "Chuyện nhà ấy mà, tớ không muốn kể nhiều."
        },
        {
          "id": "f11785d7-733e-5b81-8ae5-2ed3a0060459-u02",
          "speaker_id": "A",
          "ja": "うん、聞かないよ。",
          "vi": "Ừ, tớ không hỏi thêm đâu."
        },
        {
          "id": "f11785d7-733e-5b81-8ae5-2ed3a0060459-u03",
          "speaker_id": "A",
          "ja": "じゃ、次に遊べそうな日を考えようか。",
          "vi": "Vậy mình nghĩ xem hôm nào có thể đi chơi nữa nhé?"
        },
        {
          "id": "f11785d7-733e-5b81-8ae5-2ed3a0060459-u04",
          "speaker_id": "B",
          "ja": "うん。それなら話せるよ。",
          "vi": "Ừ. Chuyện đó thì tớ nói được."
        }
      ],
      "admin": {
