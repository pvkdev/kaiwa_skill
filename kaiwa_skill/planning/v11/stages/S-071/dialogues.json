          }
        }
      }
    },
    {
      "situation_uid": "d6eb2f85-a790-52c6-ba70-a6a921ddbe82",
      "event_id": "E01",
      "context_vi": "Ở lớp, bạn kể với bạn mình về loại bánh lần đầu ăn ở chợ hôm qua. Người kia muốn biết vị ra sao.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d6eb2f85-a790-52c6-ba70-a6a921ddbe82-u01",
          "speaker_id": "A",
          "ja": "きのう、市場で初めて黒ごまのパンを食べたよ。",
          "vi": "Hôm qua ở chợ, lần đầu tớ ăn bánh mì mè đen."
        },
        {
          "id": "d6eb2f85-a790-52c6-ba70-a6a921ddbe82-u02",
          "speaker_id": "B",
          "ja": "へえ、どんな味だった？",
          "vi": "Ồ, vị thế nào?"
        },
        {
          "id": "d6eb2f85-a790-52c6-ba70-a6a921ddbe82-u03",
          "speaker_id": "A",
          "ja": "あまり甘くなかった。ごまの香りがよかったよ。",
          "vi": "Không ngọt lắm. Mùi mè thơm lắm."
        },
        {
          "id": "d6eb2f85-a790-52c6-ba70-a6a921ddbe82-u04",
          "speaker_id": "B",
          "ja": "ごま、好きなんだ。今度食べてみたいな。",
          "vi": "Tớ thích mè. Hôm nào tớ muốn ăn thử."
        }
      ],
      "admin": {
        "source_refs": [
          "weekend",
          "travel"
        ],
        "specialty_item_ids": [],
