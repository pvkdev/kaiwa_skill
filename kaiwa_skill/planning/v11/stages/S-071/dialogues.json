    {
      "situation_uid": "95a9e5eb-c633-51d0-b772-75c8b6b61b11",
      "event_id": "E01",
      "context_vi": "Bạn vừa nói việc quên ví xảy ra sáng hôm qua. Bạn muốn kể theo thứ tự từ lúc ra ga cho tới lúc quay về lấy ví.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "95a9e5eb-c633-51d0-b772-75c8b6b61b11-u01",
          "speaker_id": "A",
          "ja": "きのう、まず駅まで行ったんだ。",
          "vi": "Hôm qua ban đầu tớ ra tới ga."
        },
        {
          "id": "95a9e5eb-c633-51d0-b772-75c8b6b61b11-u02",
          "speaker_id": "B",
          "ja": "それで、どうしたの？",
          "vi": "Rồi cậu làm sao?"
        },
        {
          "id": "95a9e5eb-c633-51d0-b772-75c8b6b61b11-u03",
          "speaker_id": "A",
          "ja": "財布がないって気づいて、家に戻ったよ。",
          "vi": "Tớ phát hiện không có ví nên quay về nhà."
        },
        {
          "id": "95a9e5eb-c633-51d0-b772-75c8b6b61b11-u04",
          "speaker_id": "B",
          "ja": "駅に着いてから家に戻ったんだね。",
          "vi": "Cậu ra tới ga rồi mới quay về nhà nhỉ."
        },
        {
          "id": "95a9e5eb-c633-51d0-b772-75c8b6b61b11-u05",
          "speaker_id": "A",
          "ja": "そう。改札の前で気づいたよ。",
          "vi": "Ừ. Ra tới trước cổng soát vé tớ mới phát hiện."
        }
      ],
      "admin": {
        "source_refs": [
          "weekend",
          "correction"
        ],
