    {
      "situation_uid": "088adc09-ab20-5da0-a427-58c5f4439748",
      "event_id": "E01",
      "context_vi": "Bạn kể mình phải quay lại nhà lấy ví. Bạn cùng lớp tưởng việc đó xảy ra sáng nay, nên bạn sửa lại mốc thời gian.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "088adc09-ab20-5da0-a427-58c5f4439748-u01",
          "speaker_id": "B",
          "ja": "今朝、財布を取りに帰ったの？",
          "vi": "Sáng nay cậu quay về lấy ví à?"
        },
        {
          "id": "088adc09-ab20-5da0-a427-58c5f4439748-u02",
          "speaker_id": "A",
          "ja": "今朝じゃなくて、きのうの朝だよ。",
          "vi": "Là sáng hôm qua ấy."
        },
        {
          "id": "088adc09-ab20-5da0-a427-58c5f4439748-u03",
          "speaker_id": "B",
          "ja": "あ、きのうね。出かけるとき？",
          "vi": "À, hôm qua. Lúc cậu ra ngoài à?"
        },
        {
          "id": "088adc09-ab20-5da0-a427-58c5f4439748-u04",
          "speaker_id": "A",
          "ja": "うん。買い物に行く途中だった。",
          "vi": "Ừ. Lúc tớ đang trên đường đi mua đồ."
        }
      ],
      "admin": {
        "source_refs": [
          "correction"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "088adc09-ab20-5da0-a427-58c5f4439748-u01": {
