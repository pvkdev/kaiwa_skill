    {
      "situation_uid": "e06173db-a5cf-5c55-9c50-19f936036c07",
      "event_id": "E02",
      "context_vi": "Bạn gặp bạn cùng lớp sau cuối tuần. Bạn muốn kể mình đã đi địa phương nào và đi cùng ai.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn cùng lớp",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e06173db-a5cf-5c55-9c50-19f936036c07-u01",
          "speaker_id": "B",
          "ja": "休みの日、どこか行った？",
          "vi": "Ngày nghỉ cậu có đi đâu không?"
        },
        {
          "id": "e06173db-a5cf-5c55-9c50-19f936036c07-u02",
          "speaker_id": "A",
          "ja": "友達と川越に行ったよ。",
          "vi": "Tớ đi Kawagoe với một người bạn."
        },
        {
          "id": "e06173db-a5cf-5c55-9c50-19f936036c07-u03",
          "speaker_id": "B",
          "ja": "何をしたの？",
          "vi": "Cậu làm gì ở đó?"
        },
        {
          "id": "e06173db-a5cf-5c55-9c50-19f936036c07-u04",
          "speaker_id": "A",
          "ja": "町を歩いて、友達とお菓子を食べた。",
          "vi": "Tớ đi dạo quanh phố rồi ăn bánh với bạn ấy."
        }
      ],
      "admin": {
        "source_refs": [
          "travel"
        ],
