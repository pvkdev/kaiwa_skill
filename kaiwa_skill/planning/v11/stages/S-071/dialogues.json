    {
      "situation_uid": "2e7368fe-5e6d-5837-ab8a-5937e4e07679",
      "event_id": "E03",
      "context_vi": "Bạn mình bắt đầu kể chuyện quyển sách biến mất khỏi bàn học. Bạn muốn xác định chuyện bắt đầu lúc nào để theo kịp.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn nghe",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn kể",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2e7368fe-5e6d-5837-ab8a-5937e4e07679-u01",
          "speaker_id": "B",
          "ja": "きのう、机の上に本がなくてさ。",
          "vi": "Hôm qua tự nhiên tớ không thấy cuốn sách trên bàn."
        },
        {
          "id": "2e7368fe-5e6d-5837-ab8a-5937e4e07679-u02",
          "speaker_id": "A",
          "ja": "最初に気づいたのは何時ごろ？",
          "vi": "Cậu phát hiện ra lúc mấy giờ?"
        },
        {
          "id": "2e7368fe-5e6d-5837-ab8a-5937e4e07679-u03",
          "speaker_id": "B",
          "ja": "お昼を食べたすぐあと。次の授業で使う本だったんだ。",
          "vi": "Ngay sau bữa trưa. Cuốn đó cần dùng cho tiết sau."
        },
        {
          "id": "2e7368fe-5e6d-5837-ab8a-5937e4e07679-u04",
          "speaker_id": "A",
          "ja": "それで、まずどこを探したの？",
          "vi": "Thế cậu tìm ở đâu trước?"
        }
      ],
      "admin": {
