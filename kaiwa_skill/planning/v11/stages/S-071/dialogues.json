    {
      "situation_uid": "ceb63ffd-1d65-523d-b2b9-ca0cf0e40f06",
      "event_id": "E02",
      "context_vi": "Đến giờ nghỉ trưa, bạn gặp lại người đã hẹn ở chỗ ngồi quen. Bạn tiếp tục câu chuyện xe đạp xịt lốp và kể cách mình quay về.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ceb63ffd-1d65-523d-b2b9-ca0cf0e40f06-u01",
          "speaker_id": "A",
          "ja": "パンクした話の続きね。お店まで自転車を押して歩いたよ。",
          "vi": "Kể tiếp chuyện xịt lốp nhé. Tớ dắt xe đi bộ tới một cửa hàng."
        },
        {
          "id": "ceb63ffd-1d65-523d-b2b9-ca0cf0e40f06-u02",
          "speaker_id": "B",
          "ja": "そこまで押したの？ 大変だったね。",
          "vi": "Cậu dắt xe tới tận đó à? Vất vả nhỉ."
        },
        {
          "id": "ceb63ffd-1d65-523d-b2b9-ca0cf0e40f06-u03",
          "speaker_id": "A",
          "ja": "うん。お店から友達に電話して、車で迎えに来てもらった。",
          "vi": "Ừ. Tớ gọi cho bạn từ cửa hàng rồi bạn ấy lái xe đến đón."
        },
        {
          "id": "ceb63ffd-1d65-523d-b2b9-ca0cf0e40f06-u04",
          "speaker_id": "B",
          "ja": "じゃ、家まで帰れたんだね。よかった。",
          "vi": "Vậy là cậu về nhà được rồi nhỉ. May quá."
        }
      ],
      "admin": {
        "source_refs": [
          "weekend"
        ],
