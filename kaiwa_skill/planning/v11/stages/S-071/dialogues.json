    {
      "situation_uid": "0218a40c-93e1-59f8-8b72-237c06ca152e",
      "event_id": "E04",
      "context_vi": "Lần trước bạn đi công viên vào giữa trưa và thấy nắng quá. Bạn kể trải nghiệm đó làm bạn đổi giờ đi bộ tuần này thế nào.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0218a40c-93e1-59f8-8b72-237c06ca152e-u01",
          "speaker_id": "A",
          "ja": "先週、お昼に歩いたら、すごく暑かったよ。",
          "vi": "Tuần trước tớ đi bộ lúc trưa, nóng lắm."
        },
        {
          "id": "0218a40c-93e1-59f8-8b72-237c06ca152e-u02",
          "speaker_id": "B",
          "ja": "長く歩けた？",
          "vi": "Cậu đi được lâu không?"
        },
        {
          "id": "0218a40c-93e1-59f8-8b72-237c06ca152e-u03",
          "speaker_id": "A",
          "ja": "すぐ帰ったよ。だから今週は朝に行くつもり。",
          "vi": "Tớ quay về ngay. Thế nên tuần này tớ định đi buổi sáng."
        },
        {
          "id": "0218a40c-93e1-59f8-8b72-237c06ca152e-u04",
          "speaker_id": "B",
          "ja": "朝なら、ゆっくり歩けそうだね。",
          "vi": "Đi sáng thì chắc đi thong thả được nhỉ."
        }
      ],
