    {
      "situation_uid": "8ca247ed-ba48-5452-9316-e10dd3932ec9",
      "event_id": "E02",
      "context_vi": "Bạn vừa về sau một chuyến đi biển. Bạn có chuyện về đồ ăn và đường đi, nên muốn biết bạn mình thích nghe phần nào trước.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8ca247ed-ba48-5452-9316-e10dd3932ec9-u01",
          "speaker_id": "A",
          "ja": "海に行った話なんだけど、食べ物と道の話、どっちが聞きたい？",
          "vi": "Về chuyến đi biển ấy, cậu muốn nghe chuyện đồ ăn hay chuyện đường đi?"
        },
        {
          "id": "8ca247ed-ba48-5452-9316-e10dd3932ec9-u02",
          "speaker_id": "B",
          "ja": "食べ物がいいな。何を食べたの？",
          "vi": "Chuyện đồ ăn nhé. Cậu ăn gì ở đó?"
        },
        {
          "id": "8ca247ed-ba48-5452-9316-e10dd3932ec9-u03",
          "speaker_id": "A",
          "ja": "港の近くで魚を焼いてもらったよ。",
          "vi": "Gần bến tàu có chỗ nướng cá cho tớ ăn."
        },
        {
          "id": "8ca247ed-ba48-5452-9316-e10dd3932ec9-u04",
          "speaker_id": "B",
          "ja": "いいね。どんな魚だった？",
          "vi": "Thích nhỉ. Cá gì thế?"
        }
      ],
      "admin": {
