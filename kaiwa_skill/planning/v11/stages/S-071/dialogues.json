    {
      "situation_uid": "e59b66f0-a480-5ba0-bd1a-7615374c1549",
      "event_id": "E03",
      "context_vi": "Bạn vừa nghe hết chuyện bạn mình lạc con chó ở công viên rồi tìm thấy nó gần nhà. Bạn muốn đáp đúng với cái kết và nghe cảm giác người kể.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Bạn nghe",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn kể",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "e59b66f0-a480-5ba0-bd1a-7615374c1549-u01",
          "speaker_id": "B",
          "ja": "最後は家の前にいたんだ。見つかったよ。",
          "vi": "Cuối cùng nó đứng trước nhà. Tớ tìm được rồi."
        },
        {
          "id": "e59b66f0-a480-5ba0-bd1a-7615374c1549-u02",
          "speaker_id": "A",
          "ja": "よかったね。無事でほっとしたね。",
          "vi": "May quá. Nó không sao thì nhẹ cả người nhỉ."
        },
        {
          "id": "e59b66f0-a480-5ba0-bd1a-7615374c1549-u03",
          "speaker_id": "B",
          "ja": "うん。見つけたとき、泣きそうだったよ。",
          "vi": "Ừ. Tìm thấy nó tớ suýt khóc."
        },
        {
          "id": "e59b66f0-a480-5ba0-bd1a-7615374c1549-u04",
          "speaker_id": "A",
          "ja": "どのくらい探したの？",
          "vi": "Cậu tìm bao lâu vậy?"
        }
      ],
