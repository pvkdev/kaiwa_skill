    {
      "situation_uid": "ce784ae0-7fa7-53b4-a83f-3c9382fdc9d4",
      "event_id": "E02",
      "context_vi": "Bạn mở đầu chuyện lúc đi đạp xe thì bị xịt lốp. Bạn mình sắp vào lớp và không có thời gian nghe, nên bạn đề nghị kể vào giờ nghỉ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn đang bận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ce784ae0-7fa7-53b4-a83f-3c9382fdc9d4-u01",
          "speaker_id": "A",
          "ja": "この前、自転車で遠くまで行ったら、タイヤがパンクしてさ。",
          "vi": "Hôm trước tớ đạp xe đi xa thì bị xịt lốp ấy."
        },
        {
          "id": "ce784ae0-7fa7-53b4-a83f-3c9382fdc9d4-u02",
          "speaker_id": "B",
          "ja": "えっ、そうなの？ ごめん、もう授業が始まる。",
          "vi": "Ồ, vậy à? Xin lỗi, lớp tớ sắp bắt đầu rồi."
        },
        {
          "id": "ce784ae0-7fa7-53b4-a83f-3c9382fdc9d4-u03",
          "speaker_id": "A",
          "ja": "じゃ、昼休みに話すね。",
          "vi": "Vậy giờ nghỉ trưa tớ kể nhé."
        },
        {
          "id": "ce784ae0-7fa7-53b4-a83f-3c9382fdc9d4-u04",
          "speaker_id": "B",
          "ja": "うん。いつもの席で聞かせて。",
          "vi": "Ừ, ngồi chỗ hay ngồi rồi kể tớ nghe."
        }
      ],
      "admin": {
