    {
      "situation_uid": "444ec351-deeb-519c-9476-3dbaf801809e",
      "event_id": "E04",
      "context_vi": "Bạn vừa kể có lần ra khỏi tàu mới biết để quên ô. Bạn hỏi bạn mình từng gặp chuyện tương tự chưa rồi nghe một ví dụ của họ.",
      "speakers": [
        {
          "id": "A",
          "role_vi": "Người kể",
          "gender": "female"
        },
        {
          "id": "B",
          "role_vi": "Bạn nghe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "444ec351-deeb-519c-9476-3dbaf801809e-u01",
          "speaker_id": "A",
          "ja": "電車に何か忘れたこと、ある？",
          "vi": "Cậu từng để quên gì trên tàu chưa?"
        },
        {
          "id": "444ec351-deeb-519c-9476-3dbaf801809e-u02",
          "speaker_id": "B",
          "ja": "あるよ。前に手袋を置いてきた。",
          "vi": "Rồi. Có lần tớ để quên găng tay."
        },
        {
          "id": "444ec351-deeb-519c-9476-3dbaf801809e-u03",
          "speaker_id": "A",
          "ja": "その手袋、見つかった？",
          "vi": "Cậu tìm lại được đôi găng không?"
        },
        {
          "id": "444ec351-deeb-519c-9476-3dbaf801809e-u04",
          "speaker_id": "B",
          "ja": "ううん。結局、見つからなかった。",
          "vi": "Không. Cuối cùng tớ không tìm được."
        }
      ],
