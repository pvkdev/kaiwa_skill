    {
      "situation_uid": "19cecd66-6f55-54a8-b646-b2ef249de701",
      "event_id": "E02",
      "context_vi": "Trong căn hộ chung hư cấu, phòng nóng. Bạn hỏi người ở cùng trước khi mở cửa sổ cạnh bàn họ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người ở cùng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "19cecd66-6f55-54a8-b646-b2ef249de701-u01",
          "speaker_id": "a",
          "ja": "暑いですね。ここの窓を開けてもいいですか。",
          "vi": "Nóng nhỉ. Tôi mở cửa sổ này được không?"
        },
        {
          "id": "19cecd66-6f55-54a8-b646-b2ef249de701-u02",
          "speaker_id": "b",
          "ja": "はい、少しなら大丈夫です。",
          "vi": "Ừ, mở hé một chút thì được."
        },
        {
          "id": "19cecd66-6f55-54a8-b646-b2ef249de701-u03",
          "speaker_id": "a",
          "ja": "では、少しだけ開けます。寒くなったら言ってください。",
          "vi": "Vậy tôi mở hé thôi. Nếu lạnh thì bảo tôi nhé."
        },
        {
          "id": "19cecd66-6f55-54a8-b646-b2ef249de701-u04",
          "speaker_id": "b",
          "ja": "分かりました。",
          "vi": "Ừ."
        }
      ],
      "admin": {
        "source_refs": [
          "permission"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "19cecd66-6f55-54a8-b646-b2ef249de701-u01": {
