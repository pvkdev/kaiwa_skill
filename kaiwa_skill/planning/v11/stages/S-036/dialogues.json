  "dialogues": [
    {
      "situation_uid": "edb370e9-6128-53f5-a5bc-8210c43ebd89",
      "event_id": "E01",
      "context_vi": "Ở phòng sinh hoạt chung Sakura hư cấu, bạn thấy một ghế trống và hỏi người phụ trách trước khi ngồi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "edb370e9-6128-53f5-a5bc-8210c43ebd89-u01",
          "speaker_id": "a",
          "ja": "あの席に座ってもいいですか。",
          "vi": "Tôi ngồi chỗ kia được không ạ?"
        },
        {
          "id": "edb370e9-6128-53f5-a5bc-8210c43ebd89-u02",
          "speaker_id": "b",
          "ja": "はい。今は空いています。どうぞ。",
          "vi": "Được ạ. Chỗ đó hiện trống. Mời anh ngồi."
        },
        {
          "id": "edb370e9-6128-53f5-a5bc-8210c43ebd89-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。ここを使います。",
          "vi": "Cảm ơn chị. Tôi sẽ ngồi ở đây."
        }
      ],
      "admin": {
        "source_refs": [
          "permission",
          "seat"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "edb370e9-6128-53f5-a5bc-8210c43ebd89-u01": {
