      "event_id": "E04",
      "context_vi": "Bạn mượn một chiếc kéo từ người phụ trách phòng Sakura hư cấu và mang trả đúng giờ đã hẹn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người đã cho phép",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e31fa3c2-cb90-5c80-a25a-9d1a40cd671f-u01",
          "speaker_id": "a",
          "ja": "お借りしたはさみを返します。もう使い終わりました。",
          "vi": "Tôi trả chiếc kéo đã mượn. Tôi dùng xong rồi ạ."
        },
        {
          "id": "e31fa3c2-cb90-5c80-a25a-9d1a40cd671f-u02",
          "speaker_id": "b",
          "ja": "ありがとうございます。時間どおりですね。",
          "vi": "Cảm ơn anh. Đúng giờ đấy ạ."
        },
        {
          "id": "e31fa3c2-cb90-5c80-a25a-9d1a40cd671f-u03",
          "speaker_id": "a",
          "ja": "貸していただき、ありがとうございました。",
          "vi": "Cảm ơn chị đã cho tôi mượn."
        },
        {
          "id": "e31fa3c2-cb90-5c80-a25a-9d1a40cd671f-u04",
          "speaker_id": "b",
          "ja": "また必要なら声をかけてください。",
          "vi": "Nếu cần nữa, cứ nói với tôi nhé."
        }
      ],
