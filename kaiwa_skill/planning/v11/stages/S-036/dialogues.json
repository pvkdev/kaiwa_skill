          }
        }
      }
    },
    {
      "situation_uid": "f8662a14-02c4-5789-b45e-c676dfdbbd06",
      "event_id": "E01",
      "context_vi": "Sau khi hỏi ổ cắm ở bàn khu chung Sakura, người phụ trách kiểm tra và báo chỉ khu phía trong mới được cắm điện. Bạn nhờ chỉ đường.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "f8662a14-02c4-5789-b45e-c676dfdbbd06-u01",
          "speaker_id": "b",
          "ja": "この席のコンセントは使えません。奥の席なら使えます。",
          "vi": "Ổ cắm bàn này không dùng được. Bàn phía trong thì được ạ."
        },
        {
          "id": "f8662a14-02c4-5789-b45e-c676dfdbbd06-u02",
          "speaker_id": "a",
          "ja": "奥の席はどこですか。案内していただけますか。",
          "vi": "Bàn phía trong ở đâu ạ? Chị chỉ giúp tôi được không?"
        },
        {
          "id": "f8662a14-02c4-5789-b45e-c676dfdbbd06-u03",
          "speaker_id": "b",
          "ja": "あの棚の右側です。今、空いています。",
          "vi": "Phía bên phải kệ kia. Hiện đang trống ạ."
        },
        {
          "id": "f8662a14-02c4-5789-b45e-c676dfdbbd06-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。そちらで使います。",
          "vi": "Cảm ơn chị. Tôi sẽ dùng ở đó."
        }
      ],
      "admin": {
        "source_refs": [
          "permission"
        ],
