    {
      "situation_uid": "9265ba8e-1d61-5dbe-8e4e-ae25b711c46e",
      "event_id": "E02",
      "context_vi": "Trong căn hộ chung hư cấu, bạn muốn dùng bàn ăn để học vào tối mai. Người ở cùng cần hỏi bạn cùng phòng thứ ba, nên chưa thể đồng ý.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người ở cùng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9265ba8e-1d61-5dbe-8e4e-ae25b711c46e-u01",
          "speaker_id": "a",
          "ja": "明日の夜、食卓で勉強してもいいですか。",
          "vi": "Tối mai tôi học ở bàn ăn được không?"
        },
        {
          "id": "9265ba8e-1d61-5dbe-8e4e-ae25b711c46e-u02",
          "speaker_id": "b",
          "ja": "もう一人にも聞く必要があります。まだ決められません。",
          "vi": "Tôi cần hỏi người ở cùng nữa. Giờ chưa quyết được."
        },
        {
          "id": "9265ba8e-1d61-5dbe-8e4e-ae25b711c46e-u03",
          "speaker_id": "a",
          "ja": "分かりました。いつごろ返事を聞けますか。",
          "vi": "Tôi hiểu. Khoảng khi nào có câu trả lời?"
        },
        {
          "id": "9265ba8e-1d61-5dbe-8e4e-ae25b711c46e-u04",
          "speaker_id": "b",
          "ja": "今夜九時までに連絡します。",
          "vi": "Trước 9 giờ tối nay tôi sẽ báo."
        }
      ],
      "admin": {
        "source_refs": [
          "permission"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "9265ba8e-1d61-5dbe-8e4e-ae25b711c46e-u01": {
            "kind": "original_extension"
          },
          "9265ba8e-1d61-5dbe-8e4e-ae25b711c46e-u02": {
            "kind": "original_extension"
