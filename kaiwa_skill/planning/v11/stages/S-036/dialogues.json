    {
      "situation_uid": "70cc2c19-172c-530e-9d63-a8136614fc39",
      "event_id": "E04",
      "context_vi": "Bạn được mượn một đèn bàn ở Sakura hư cấu. Khi đang dùng, đèn nhấp nháy; bạn báo ngay và hỏi có nên ngừng dùng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người đã cho phép",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "70cc2c19-172c-530e-9d63-a8136614fc39-u01",
          "speaker_id": "a",
          "ja": "お借りしたライトが点滅しています。使うのをやめたほうがいいですか。",
          "vi": "Đèn tôi mượn đang nhấp nháy. Tôi có nên ngừng dùng không ạ?"
        },
        {
          "id": "70cc2c19-172c-530e-9d63-a8136614fc39-u02",
          "speaker_id": "b",
          "ja": "はい。今は電源を切ってください。こちらで確認します。",
          "vi": "Vâng. Anh tắt đèn lúc này nhé. Chúng tôi sẽ kiểm tra."
        },
        {
          "id": "70cc2c19-172c-530e-9d63-a8136614fc39-u03",
          "speaker_id": "a",
          "ja": "分かりました。切りました。どこに置けばいいですか。",
          "vi": "Tôi hiểu. Tôi đã tắt rồi. Tôi đặt đèn ở đâu ạ?"
        },
        {
          "id": "70cc2c19-172c-530e-9d63-a8136614fc39-u04",
          "speaker_id": "b",
          "ja": "そのまま机に置いてください。私が取りに行きます。",
          "vi": "Anh cứ để trên bàn. Tôi sẽ đến lấy."
        }
      ],
