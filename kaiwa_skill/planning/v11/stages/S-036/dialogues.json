    {
      "situation_uid": "6975e685-e939-5ec4-a846-005f42409ac9",
      "event_id": "E04",
      "context_vi": "Ở Sakura hư cấu, người phụ trách kiểm lịch và báo bàn không thể gia hạn sau 15 giờ. Bạn dừng dùng và thu dọn.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người đã cho phép",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "6975e685-e939-5ec4-a846-005f42409ac9-u01",
          "speaker_id": "b",
          "ja": "すみません。次の予約があるので、延長できません。",
          "vi": "Xin lỗi, có người đặt tiếp nên không thể gia hạn ạ."
        },
        {
          "id": "6975e685-e939-5ec4-a846-005f42409ac9-u02",
          "speaker_id": "a",
          "ja": "分かりました。今、片づけます。",
          "vi": "Tôi hiểu. Tôi thu dọn ngay."
        },
        {
          "id": "6975e685-e939-5ec4-a846-005f42409ac9-u03",
          "speaker_id": "b",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn anh."
        },
        {
          "id": "6975e685-e939-5ec4-a846-005f42409ac9-u04",
          "speaker_id": "a",
          "ja": "こちらこそ、使わせていただきありがとうございました。",
          "vi": "Tôi mới là người cảm ơn vì đã được dùng chỗ này."
        }
      ],
