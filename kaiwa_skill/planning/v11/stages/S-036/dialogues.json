    {
      "situation_uid": "c2506633-da42-5e1c-8d8c-6c17a4e24801",
      "event_id": "E02",
      "context_vi": "Trong căn hộ chung hư cấu, bạn thường dùng bếp lúc 18 giờ nhưng hôm nay muốn đổi với người ở cùng sang 19 giờ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người ở cùng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "c2506633-da42-5e1c-8d8c-6c17a4e24801-u01",
          "speaker_id": "a",
          "ja": "今日だけ、台所を使う時間を七時に変えてもいいですか。",
          "vi": "Chỉ hôm nay tôi đổi giờ dùng bếp sang 7 giờ được không?"
        },
        {
          "id": "c2506633-da42-5e1c-8d8c-6c17a4e24801-u02",
          "speaker_id": "b",
          "ja": "七時なら私は使いません。大丈夫です。",
          "vi": "7 giờ tôi không dùng. Được đấy."
        },
        {
          "id": "c2506633-da42-5e1c-8d8c-6c17a4e24801-u03",
          "speaker_id": "a",
          "ja": "ありがとうございます。六時の時間は使いません。",
          "vi": "Cảm ơn. Vậy 6 giờ tôi không dùng bếp."
        },
        {
          "id": "c2506633-da42-5e1c-8d8c-6c17a4e24801-u04",
          "speaker_id": "b",
          "ja": "はい、七時にどうぞ。",
          "vi": "Ừ, 7 giờ bạn dùng nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "permission"
        ],
        "specialty_item_ids": [],
