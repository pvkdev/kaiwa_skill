        }
      }
    },
    {
      "situation_uid": "00d934ff-1426-5d43-b595-95ba75e99ae2",
      "event_id": "E01",
      "context_vi": "Trong khu chung Sakura hư cấu, bạn cần sạc máy tính một lúc. Bạn hỏi người phụ trách có thể dùng ổ cắm bên bàn này không; chưa có câu trả lời.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "00d934ff-1426-5d43-b595-95ba75e99ae2-u01",
          "speaker_id": "a",
          "ja": "この席のコンセントを使ってもいいですか。",
          "vi": "Tôi dùng ổ cắm ở bàn này được không ạ?"
        },
        {
          "id": "00d934ff-1426-5d43-b595-95ba75e99ae2-u02",
          "speaker_id": "b",
          "ja": "確認しますね。どのくらい使いますか。",
          "vi": "Để tôi kiểm tra. Anh cần dùng bao lâu?"
        },
        {
          "id": "00d934ff-1426-5d43-b595-95ba75e99ae2-u03",
          "speaker_id": "a",
          "ja": "二十分くらいです。使える場所があれば教えてください。",
          "vi": "Khoảng 20 phút. Nếu có chỗ dùng được, xin chỉ giúp tôi."
        },
        {
          "id": "00d934ff-1426-5d43-b595-95ba75e99ae2-u04",
          "speaker_id": "b",
          "ja": "分かりました。場所を確認します。",
          "vi": "Vâng, tôi sẽ kiểm tra chỗ phù hợp."
        }
      ],
      "admin": {
        "source_refs": [
          "permission"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "00d934ff-1426-5d43-b595-95ba75e99ae2-u01": {
            "kind": "original_extension"
          },
