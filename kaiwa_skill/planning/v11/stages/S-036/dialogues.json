    {
      "situation_uid": "4f42cd3c-7e37-58ad-8737-46f69782a72b",
      "event_id": "E01",
      "context_vi": "Sau khi hỏi ổ cắm ở Sakura, người phụ trách báo hôm nay khu chung không cho dùng ổ cắm. Bạn không cắm điện và hỏi lựa chọn khác.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "4f42cd3c-7e37-58ad-8737-46f69782a72b-u01",
          "speaker_id": "b",
          "ja": "すみません。今日はこのエリアのコンセントは使えません。",
          "vi": "Xin lỗi, hôm nay ổ cắm trong khu này không dùng được ạ."
        },
        {
          "id": "4f42cd3c-7e37-58ad-8737-46f69782a72b-u02",
          "speaker_id": "a",
          "ja": "分かりました。使える場所はほかにありますか。",
          "vi": "Tôi hiểu. Có nơi nào khác dùng được không ạ?"
        },
        {
          "id": "4f42cd3c-7e37-58ad-8737-46f69782a72b-u03",
          "speaker_id": "b",
          "ja": "受付横の充電席を確認してみてください。",
          "vi": "Anh thử hỏi chỗ sạc cạnh quầy lễ tân nhé."
        },
        {
          "id": "4f42cd3c-7e37-58ad-8737-46f69782a72b-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。受付で聞いてみます。",
          "vi": "Cảm ơn chị. Tôi sẽ hỏi ở quầy."
        }
      ],
      "admin": {
        "source_refs": [
          "permission"
        ],
        "specialty_item_ids": [],
