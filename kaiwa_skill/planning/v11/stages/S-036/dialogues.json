    {
      "situation_uid": "0dc53f02-5a9a-57d3-82d1-5eb0561b9448",
      "event_id": "E04",
      "context_vi": "Ở Sakura hư cấu, bạn xin dùng bàn thêm 10 phút nhưng người phụ trách kiểm lịch và chỉ đồng ý thêm 5 phút. Bạn thấy 5 phút đủ để lưu tài liệu.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người đã cho phép",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0dc53f02-5a9a-57d3-82d1-5eb0561b9448-u01",
          "speaker_id": "b",
          "ja": "次の方が来るので、五分だけなら延長できます。",
          "vi": "Người tiếp theo sắp đến nên chỉ gia hạn được 5 phút ạ."
        },
        {
          "id": "0dc53f02-5a9a-57d3-82d1-5eb0561b9448-u02",
          "speaker_id": "a",
          "ja": "五分で十分です。資料を保存して片づけます。",
          "vi": "5 phút là đủ. Tôi lưu tài liệu rồi thu dọn."
        },
        {
          "id": "0dc53f02-5a9a-57d3-82d1-5eb0561b9448-u03",
          "speaker_id": "b",
          "ja": "では、三時五分までお願いします。",
