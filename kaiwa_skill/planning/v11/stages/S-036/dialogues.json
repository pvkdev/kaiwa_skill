          },
          "00d934ff-1426-5d43-b595-95ba75e99ae2-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "f0bcd1c7-fe6d-561e-9c15-fa80f8cf691e",
      "event_id": "E01",
      "context_vi": "Sau khi hỏi ổ cắm ở Sakura, người phụ trách kiểm tra và đồng ý cho bạn dùng ổ cắm ở bàn đó trong 20 phút. Bạn xác nhận mốc kết thúc.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người phụ trách",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "f0bcd1c7-fe6d-561e-9c15-fa80f8cf691e-u01",
          "speaker_id": "b",
          "ja": "このコンセントは二十分使えます。",
          "vi": "Ổ cắm này anh dùng được 20 phút ạ."
        },
        {
          "id": "f0bcd1c7-fe6d-561e-9c15-fa80f8cf691e-u02",
          "speaker_id": "a",
          "ja": "今は二時ですね。二時二十分まででいいですか。",
          "vi": "Bây giờ 2 giờ. Tôi dùng đến 2 giờ 20 được chứ ạ?"
        },
        {
          "id": "f0bcd1c7-fe6d-561e-9c15-fa80f8cf691e-u03",
          "speaker_id": "b",
          "ja": "はい。その時間までお願いします。",
          "vi": "Vâng, xin dùng đến giờ đó."
        },
        {
          "id": "f0bcd1c7-fe6d-561e-9c15-fa80f8cf691e-u04",
          "speaker_id": "a",
          "ja": "分かりました。時間になったら片づけます。",
          "vi": "Tôi hiểu. Đến giờ tôi sẽ thu dọn."
        }
      ],
      "admin": {
        "source_refs": [
          "permission"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f0bcd1c7-fe6d-561e-9c15-fa80f8cf691e-u01": {
