    {
      "situation_uid": "54467801-4feb-5d19-9772-ff67845a673e",
      "event_id": "E02",
      "context_vi": "Trong căn hộ chung hư cấu, bạn xin đổi giờ dùng bếp chỉ tối nay. Người ở cùng tưởng bạn muốn đổi lịch cả tuần.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "b",
          "role_vi": "người ở cùng",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "54467801-4feb-5d19-9772-ff67845a673e-u01",
          "speaker_id": "b",
          "ja": "今週ずっと七時に変えたいんですか。",
          "vi": "Bạn muốn đổi sang 7 giờ cả tuần à?"
        },
        {
          "id": "54467801-4feb-5d19-9772-ff67845a673e-u02",
          "speaker_id": "a",
          "ja": "いいえ、今日だけです。明日からはいつもどおり六時です。",
          "vi": "Không, chỉ hôm nay thôi. Từ mai vẫn 6 giờ như cũ."
        },
        {
          "id": "54467801-4feb-5d19-9772-ff67845a673e-u03",
          "speaker_id": "b",
          "ja": "今日だけなら七時で大丈夫です。",
          "vi": "Nếu chỉ hôm nay thì 7 giờ được."
        },
        {
          "id": "54467801-4feb-5d19-9772-ff67845a673e-u04",
          "speaker_id": "a",
          "ja": "ありがとうございます。今日だけ七時に使います。",
          "vi": "Cảm ơn. Tôi chỉ dùng lúc 7 giờ hôm nay."
        }
