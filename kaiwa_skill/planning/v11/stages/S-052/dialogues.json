    {
      "situation_uid": "9ed36260-5a32-576a-a139-fa818bb9b441",
      "event_id": "E04",
      "context_vi": "Bạn đến quầy hỗ trợ tại ga Aoi để hỏi về một món thất lạc không khẩn cấp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
