    {
      "situation_uid": "03debe24-3d4c-5189-9117-f43972ff18e1",
      "event_id": "E02",
      "context_vi": "Người tiếp nhận 119 nói quá nhanh sau khi bạn sửa cửa ga. Bạn xin từng câu ngắn để còn trả lời đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "03debe24-3d4c-5189-9117-f43972ff18e1-u01",
          "speaker_id": "a",
          "ja": "すみません。日本語をゆっくり話してください。一つずつお願いします。",
          "vi": "Xin lỗi, xin nói tiếng Nhật chậm lại, từng câu một ạ."
        },
        {
          "id": "03debe24-3d4c-5189-9117-f43972ff18e1-u02",
          "speaker_id": "b",
          "ja": "分かりました。今いる場所をもう一度教えてください。",
          "vi": "Được. Bạn nói lại chỗ đang đứng nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "03debe24-3d4c-5189-9117-f43972ff18e1-u01": {
