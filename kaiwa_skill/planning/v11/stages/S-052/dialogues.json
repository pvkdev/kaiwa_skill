            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "56408789-f5b7-549d-a9ef-b7352fa863f3",
      "event_id": "E02",
      "context_vi": "Bạn đang nói với 119 về người bị ngã trước bảng đỏ ở cửa tây ga Aoi hư cấu. Người tiếp nhận hỏi vị trí.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "56408789-f5b7-549d-a9ef-b7352fa863f3-u01",
          "speaker_id": "b",
          "ja": "119です。場所はどこですか。",
          "vi": "Tổng đài 119. Bạn đang ở đâu ạ?"
        },
        {
          "id": "56408789-f5b7-549d-a9ef-b7352fa863f3-u02",
          "speaker_id": "a",
          "ja": "あおい駅の西口、赤い案内板の前です。",
          "vi": "Trước bảng màu đỏ ở cửa tây ga Aoi."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "56408789-f5b7-549d-a9ef-b7352fa863f3-u01": {
            "kind": "original_extension"
          },
