        }
      }
    },
    {
      "situation_uid": "58b8bfef-513b-5021-b8e3-2ee9ead0d850",
      "event_id": "E03",
      "context_vi": "Bạn vẫn ở cửa tây, trước bảng đỏ đã báo cho 119. Bạn nhờ nhân viên ga ra đó đón đội tới, còn mình ở với người cần giúp.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "58b8bfef-513b-5021-b8e3-2ee9ead0d850-u01",
          "speaker_id": "a",
          "ja": "駅員さん、救急の人が来ます。西口の赤い看板で待ってもらえますか。",
          "vi": "Anh nhân viên ga ơi, đội cứu hộ sắp tới. Anh ra đợi ở biển đỏ cửa tây giúp tôi được không?"
        },
        {
          "id": "58b8bfef-513b-5021-b8e3-2ee9ead0d850-u02",
          "speaker_id": "b",
          "ja": "はい、そこへ行きます。",
          "vi": "Được, tôi sẽ ra đó."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
