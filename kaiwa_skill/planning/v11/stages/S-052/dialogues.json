      "turns": [
        {
          "id": "9ed36260-5a32-576a-a139-fa818bb9b441-u01",
          "speaker_id": "a",
          "ja": "すみません。落とし物はここで聞けますか。",
          "vi": "Xin lỗi, tôi có thể hỏi về đồ thất lạc ở đây không ạ?"
        },
        {
          "id": "9ed36260-5a32-576a-a139-fa818bb9b441-u02",
          "speaker_id": "b",
          "ja": "はい、まず何をなくしたか教えてください。",
          "vi": "Được. Trước tiên bạn cho biết mất gì."
        },
        {
          "id": "9ed36260-5a32-576a-a139-fa818bb9b441-u03",
          "speaker_id": "a",
          "ja": "財布を落としたと思います。届いていませんか。",
          "vi": "Tôi nghĩ mình đánh rơi ví. Có ai nhặt được nộp ở đây chưa ạ?"
        }
      ],
