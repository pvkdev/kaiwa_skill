            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "797bdfe1-e8e6-510d-a9fd-136c002b5325",
      "event_id": "E02",
      "context_vi": "Trong cuộc gọi 119 ở ga Aoi, bạn nhìn thấy khói gần cầu thang nhưng chưa thấy lửa. Bạn chỉ kể điều thấy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "797bdfe1-e8e6-510d-a9fd-136c002b5325-u01",
          "speaker_id": "b",
          "ja": "何が起きていますか。",
          "vi": "Đang xảy ra việc gì ạ?"
        },
        {
          "id": "797bdfe1-e8e6-510d-a9fd-136c002b5325-u02",
          "speaker_id": "a",
          "ja": "階段の近くに煙が見えます。火は見えません。",
          "vi": "Tôi thấy khói gần cầu thang. Tôi không thấy lửa."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "797bdfe1-e8e6-510d-a9fd-136c002b5325-u01": {
            "kind": "original_extension"
          },
          "797bdfe1-e8e6-510d-a9fd-136c002b5325-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "61322f7c-0ee2-58cf-ae5e-02fdc1f79d2c",
      "event_id": "E02",
      "context_vi": "Người tiếp nhận 119 nghe nhầm cửa tây thành cửa đông ga Aoi. Bạn sửa mốc ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "61322f7c-0ee2-58cf-ae5e-02fdc1f79d2c-u01",
          "speaker_id": "b",
          "ja": "あおい駅の東口ですか。",
          "vi": "Bạn ở cửa đông ga Aoi phải không?"
        },
        {
          "id": "61322f7c-0ee2-58cf-ae5e-02fdc1f79d2c-u02",
          "speaker_id": "a",
          "ja": "いいえ、西口です。赤い案内板の前です。",
          "vi": "Không, cửa tây, trước bảng màu đỏ ạ."
        },
        {
          "id": "61322f7c-0ee2-58cf-ae5e-02fdc1f79d2c-u03",
          "speaker_id": "b",
          "ja": "西口ですね。",
          "vi": "Cửa tây ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
