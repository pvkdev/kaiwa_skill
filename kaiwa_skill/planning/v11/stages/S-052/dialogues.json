          }
        }
      }
    },
    {
      "situation_uid": "37810d14-04ba-52ed-a890-f8f730df35e3",
      "event_id": "E03",
      "context_vi": "Từ bên ngoài cửa nam ga Aoi, bạn không nhìn vào được bên trong. Người tiếp nhận hỏi còn ai ở đó không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "37810d14-04ba-52ed-a890-f8f730df35e3-u01",
          "speaker_id": "a",
