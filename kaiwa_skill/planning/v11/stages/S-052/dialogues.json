            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "797bdfe1-e8e6-510d-a9fd-136c002b5325",
      "event_id": "E02",
      "context_vi": "Bạn thấy khói gần cầu thang ga Aoi. Sau khi ra chỗ an toàn, bạn gọi 119 và chỉ nói điều mình đã nhìn thấy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "797bdfe1-e8e6-510d-a9fd-136c002b5325-u01",
          "speaker_id": "b",
          "ja": "火事ですか、救急ですか。",
          "vi": "Chị báo cháy hay cần xe cấp cứu ạ?"
        },
        {
          "id": "797bdfe1-e8e6-510d-a9fd-136c002b5325-u02",
          "speaker_id": "a",
          "ja": "あおい駅の階段の近くで煙が出ています。火は見えません。",
          "vi": "Tôi thấy khói gần cầu thang ở ga Aoi. Tôi không thấy lửa ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "797bdfe1-e8e6-510d-a9fd-136c002b5325-u01": {
