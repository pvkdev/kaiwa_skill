          },
          "03debe24-3d4c-5189-9117-f43972ff18e1-u03": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c",
      "event_id": "E03",
      "context_vi": "Có khói gần cầu thang ga Aoi. Bạn ra ngoài theo hướng dẫn của nhân viên ga rồi cập nhật vị trí an toàn cho tổng đài 119.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c-u01",
          "speaker_id": "a",
          "ja": "駅員さんの案内で外に出ました。今はあおい駅の西口の外です。",
          "vi": "Tôi đã ra ngoài theo hướng dẫn của nhân viên ga. Giờ tôi ở bên ngoài cửa tây ga Aoi ạ."
        },
        {
          "id": "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c-u02",
          "speaker_id": "b",
          "ja": "西口の外ですね。消防隊に伝えます。",
          "vi": "Bên ngoài cửa tây ạ. Tôi sẽ báo vị trí cho đội cứu hỏa."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma",
          "fire_safety"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c-u01": {
            "kind": "original_extension"
          },
          "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d966bf21-597d-57fe-a1fe-ef39dcc3a907",
      "event_id": "E03",
      "context_vi": "Lối vào chỗ hẹn trước cửa tây ga Aoi vừa bị chặn. Nhân viên ga chỉ bạn đi vòng theo đường ngoài tới cửa nam. Bạn cập nhật 119 ngay khi tới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d966bf21-597d-57fe-a1fe-ef39dcc3a907-u01",
          "speaker_id": "a",
          "ja": "西口の前は通れなくなりました。今は南口の外、時計の下にいます。",
          "vi": "Bây giờ không đi qua trước cửa tây được. Tôi đang đứng dưới đồng hồ ở bên ngoài cửa nam ạ."
        },
        {
          "id": "d966bf21-597d-57fe-a1fe-ef39dcc3a907-u02",
          "speaker_id": "b",
          "ja": "南口の外、時計の下ですね。消防隊に伝えます。",
          "vi": "Bên ngoài cửa nam, dưới đồng hồ ạ. Tôi sẽ báo đội cứu hỏa."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
