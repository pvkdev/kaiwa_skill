          },
          "03debe24-3d4c-5189-9117-f43972ff18e1-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c",
      "event_id": "E03",
      "context_vi": "Sau khi làm theo hướng dẫn trong cuộc gọi 119, bạn đã ra khu ngoài cửa tây ga Aoi và cập nhật vị trí.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c-u01",
          "speaker_id": "a",
          "ja": "案内に従って外に出ました。今は駅の西口にいます。",
          "vi": "Tôi đã ra ngoài theo hướng dẫn. Giờ tôi ở cửa tây nhà ga."
        },
        {
          "id": "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c-u02",
          "speaker_id": "b",
          "ja": "西口ですね。今の場所を確認します。",
          "vi": "Cửa tây. Tôi sẽ xác nhận vị trí hiện tại."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c-u01": {
            "kind": "original_extension"
          },
          "0b99ad79-0e1c-53e2-b698-8ca2a0fa7c0c-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d966bf21-597d-57fe-a1fe-ef39dcc3a907",
      "event_id": "E03",
      "context_vi": "Lối cửa tây vừa đóng. Bạn chuyển ra ngoài cửa nam ga Aoi và báo ngay cho người tiếp nhận 119.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d966bf21-597d-57fe-a1fe-ef39dcc3a907-u01",
          "speaker_id": "a",
          "ja": "西口の通路が閉まりました。今は南口の外にいます。",
          "vi": "Lối cửa tây đã đóng. Giờ tôi ở ngoài cửa nam."
        },
        {
          "id": "d966bf21-597d-57fe-a1fe-ef39dcc3a907-u02",
          "speaker_id": "b",
          "ja": "南口の外ですね。位置を伝えます。",
          "vi": "Ngoài cửa nam. Tôi sẽ báo vị trí đó."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d966bf21-597d-57fe-a1fe-ef39dcc3a907-u01": {
