    {
      "situation_uid": "58b8bfef-513b-5021-b8e3-2ee9ead0d850",
      "event_id": "E03",
      "context_vi": "Bạn báo 119 có khói trong ga Aoi và vẫn ở khu an toàn ngoài cửa tây. Bạn nhờ nhân viên ga gần mình ra hiệu cho đội cứu hỏa khi xe tới.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
