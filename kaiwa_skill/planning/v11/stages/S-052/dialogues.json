  "dialogues": [
    {
      "situation_uid": "324d243f-e54e-505e-bdb0-e267a35443ec",
      "event_id": "E01",
      "context_vi": "Ở ga Aoi hư cấu, một người vừa ngã cạnh cầu thang. Bạn gọi người đứng gần để nhờ giúp ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người qua đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "324d243f-e54e-505e-bdb0-e267a35443ec-u01",
          "speaker_id": "a",
          "ja": "すみません、助けてください。あの階段のそばで人が倒れています。",
          "vi": "Xin giúp với ạ! Có người ngã cạnh cầu thang kia."
        },
        {
          "id": "324d243f-e54e-505e-bdb0-e267a35443ec-u02",
          "speaker_id": "b",
          "ja": "あの階段ですね。今、行きます。",
          "vi": "Cầu thang kia đúng không? Tôi tới ngay."
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "324d243f-e54e-505e-bdb0-e267a35443ec-u01": {
            "kind": "original_extension"
          },
          "324d243f-e54e-505e-bdb0-e267a35443ec-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "0e716c11-043e-5fa1-a200-7c0d60e0d0a3",
      "event_id": "E01",
      "context_vi": "Một người vừa ngã ở ga Aoi. Bạn chưa đủ tiếng Nhật để tự báo rõ; bạn nhờ người gần đó gọi 119 ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người qua đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0e716c11-043e-5fa1-a200-7c0d60e0d0a3-u01",
          "speaker_id": "a",
          "ja": "人が倒れています。救急車を呼んでください。百十九番です。",
          "vi": "Có người ngã. Anh gọi xe cấp cứu giúp tôi với, số 119 ạ."
        },
        {
          "id": "0e716c11-043e-5fa1-a200-7c0d60e0d0a3-u02",
          "speaker_id": "b",
          "ja": "はい、今かけます。",
          "vi": "Vâng, tôi gọi ngay."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "0e716c11-043e-5fa1-a200-7c0d60e0d0a3-u01": {
            "kind": "original_extension"
          },
          "0e716c11-043e-5fa1-a200-7c0d60e0d0a3-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "d28bf1a0-fb1a-595a-86fd-42665edf08f2",
      "event_id": "E01",
      "context_vi": "Người bạn vừa nhờ nhìn về phía cầu thang nhưng chưa thấy người ngã. Bạn chỉ rõ cửa tây ga Aoi và bảng hướng dẫn màu đỏ.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người qua đường",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "d28bf1a0-fb1a-595a-86fd-42665edf08f2-u01",
          "speaker_id": "a",
          "ja": "西口です。赤い案内板の前に倒れています。",
          "vi": "Ở cửa tây ạ. Người đó ngã ngay trước bảng hướng dẫn màu đỏ."
        },
        {
          "id": "d28bf1a0-fb1a-595a-86fd-42665edf08f2-u02",
          "speaker_id": "b",
          "ja": "西口の赤い案内板ですね。",
          "vi": "Cửa tây, bảng màu đỏ phải không?"
        }
      ],
      "admin": {
        "source_refs": [
          "main"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "d28bf1a0-fb1a-595a-86fd-42665edf08f2-u01": {
            "kind": "original_extension"
          },
          "d28bf1a0-fb1a-595a-86fd-42665edf08f2-u02": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "ce7a704c-b591-5a70-9701-fe307291db28",
      "event_id": "E01",
      "context_vi": "Người đầu tiên định gọi 119 nhưng điện thoại không kết nối. Bạn quay sang một người khác ở ga Aoi để nhờ gọi ngay.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người qua đường thứ hai",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ce7a704c-b591-5a70-9701-fe307291db28-u01",
          "speaker_id": "a",
          "ja": "すみません、人が倒れています。百十九番にかけてもらえますか。",
          "vi": "Xin giúp với, có người ngã. Anh gọi 119 giúp tôi được không ạ?"
        },
        {
          "id": "ce7a704c-b591-5a70-9701-fe307291db28-u02",
          "speaker_id": "b",
          "ja": "はい、私が今かけます。",
          "vi": "Được, tôi gọi ngay."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
