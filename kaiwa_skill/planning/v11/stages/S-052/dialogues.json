          }
        }
      }
    },
    {
      "situation_uid": "56408789-f5b7-549d-a9ef-b7352fa863f3",
      "event_id": "E02",
      "context_vi": "Bạn gọi 119 vì có người ngã và vừa xin xe cấp cứu. Khi người tiếp nhận hỏi, bạn nêu tên ga Aoi, cửa ra và mốc dễ thấy.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người tiếp nhận",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "56408789-f5b7-549d-a9ef-b7352fa863f3-u01",
          "speaker_id": "b",
          "ja": "場所はどこですか。近くに何か目印がありますか。",
          "vi": "Địa điểm ở đâu ạ? Gần đó có mốc nào dễ nhận không?"
        },
        {
          "id": "56408789-f5b7-549d-a9ef-b7352fa863f3-u02",
          "speaker_id": "a",
          "ja": "あおい駅の西口、赤い案内板の前です。",
          "vi": "Trước bảng màu đỏ ở cửa tây ga Aoi."
        }
      ],
      "admin": {
        "source_refs": [
          "main",
          "fdma"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "56408789-f5b7-549d-a9ef-b7352fa863f3-u01": {
