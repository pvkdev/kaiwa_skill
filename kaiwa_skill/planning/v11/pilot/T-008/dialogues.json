    {
      "situation_uid": "b383a6e8-399f-5970-b97d-5854e0cbba68",
      "event_id": "E01",
      "context_vi": "Vừa được hỏi có muốn kể chuyện trượt phỏng vấn không, người bạn nói cô muốn yên tĩnh một mình lúc này.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Bạn nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "b383a6e8-399f-5970-b97d-5854e0cbba68-u01",
          "speaker_id": "F",
          "ja": "ごめん、今は一人で静かにしていたい。",
          "vi": "Xin lỗi, giờ tớ muốn yên tĩnh một mình."
        },
        {
          "id": "b383a6e8-399f-5970-b97d-5854e0cbba68-u02",
          "speaker_id": "L",
          "ja": "うん、わかった。今はそっとしておくね。",
          "vi": "Ừ, tớ hiểu. Giờ tớ để cậu yên nhé."
        },
        {
          "id": "b383a6e8-399f-5970-b97d-5854e0cbba68-u03",
          "speaker_id": "F",
          "ja": "せっかく声をかけてくれたのに、ごめんね。",
          "vi": "Cậu đã hỏi thăm mà tớ lại thế này, xin lỗi nhé."
        },
        {
          "id": "b383a6e8-399f-5970-b97d-5854e0cbba68-u04",
          "speaker_id": "L",
          "ja": "謝らなくていいよ。あとで話したくなったら、いつでも連絡して。",
          "vi": "Cậu không cần xin lỗi. Sau này nếu muốn nói thì cứ liên lạc với tớ."
        },
        {
          "id": "b383a6e8-399f-5970-b97d-5854e0cbba68-u05",
          "speaker_id": "F",
          "ja": "うん。今日は先に帰るね。",
          "vi": "Ừ. Hôm nay tớ về trước nhé."
        },
        {
          "id": "b383a6e8-399f-5970-b97d-5854e0cbba68-u06",
          "speaker_id": "L",
          "ja": "わかった。帰り、気をつけてね。",
          "vi": "Ừ. Về cẩn thận nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "b06-offer",
          "b07-offer"
        ],
        "specialty_item_ids": [
          "sj-trung-02-b06-20",
