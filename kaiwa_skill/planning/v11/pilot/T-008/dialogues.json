    {
      "situation_uid": "35c9eef8-e84f-52fd-9377-e91688c8982c",
      "event_id": "E02",
      "context_vi": "Bạn đã nhận giúp đồng nghiệp sắp xếp tài liệu. Lịch bàn giao thay đổi, hôm nay bạn chỉ làm được một trong hai phần việc: tài liệu hoặc ghi chú họp.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Đồng nghiệp nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "35c9eef8-e84f-52fd-9377-e91688c8982c-u01",
          "speaker_id": "L",
          "ja": "予定が変わって、今日できるのは資料整理か議事メモのどちらかです。どちらを先に進めましょうか。",
          "vi": "Lịch thay đổi nên hôm nay tôi chỉ làm được một trong hai: sắp xếp tài liệu hoặc ghi chú họp. Tôi nên ưu tiên việc nào?"
        },
        {
          "id": "35c9eef8-e84f-52fd-9377-e91688c8982c-u02",
          "speaker_id": "F",
          "ja": "明日の打ち合わせに使う資料を先にお願いします。",
          "vi": "Nhờ anh ưu tiên tài liệu dùng cho cuộc họp ngày mai."
        },
        {
          "id": "35c9eef8-e84f-52fd-9377-e91688c8982c-u03",
          "speaker_id": "L",
          "ja": "わかりました。議事メモは明日でも間に合いますか。",
          "vi": "Tôi hiểu. Ghi chú họp để ngày mai vẫn kịp chứ?"
        },
        {
          "id": "35c9eef8-e84f-52fd-9377-e91688c8982c-u04",
          "speaker_id": "F",
          "ja": "はい、明日の午後一時までで大丈夫です。",
          "vi": "Vâng, chậm nhất một giờ chiều mai là được."
        },
        {
          "id": "35c9eef8-e84f-52fd-9377-e91688c8982c-u05",
          "speaker_id": "L",
          "ja": "では今日は資料を仕上げて、明日の午前中にメモをまとめます。",
          "vi": "Vậy hôm nay tôi hoàn thành tài liệu, sáng mai tôi tổng hợp ghi chú."
        },
        {
          "id": "35c9eef8-e84f-52fd-9377-e91688c8982c-u06",
          "speaker_id": "F",
          "ja": "その順番でお願いします。助かります。",
          "vi": "Nhờ anh theo thứ tự đó. Cảm ơn anh nhiều."
        }
      ],
      "admin": {
