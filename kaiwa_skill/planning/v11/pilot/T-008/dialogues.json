    {
      "situation_uid": "fed783ea-be61-56d3-8279-6648ec3de3bf",
      "event_id": "E03",
      "context_vi": "Bạn thân nữ vừa nói cô thấy rối bời và chưa biết lúc này nên làm gì. Hai người đang trò chuyện trực tiếp.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Bạn nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "fed783ea-be61-56d3-8279-6648ec3de3bf-u01",
          "speaker_id": "F",
          "ja": "今日は気持ちがぐちゃぐちゃで、どうしたらいいかもわからない。",
          "vi": "Hôm nay lòng tớ rối bời, chính tớ cũng chẳng biết phải làm sao."
        },
        {
          "id": "fed783ea-be61-56d3-8279-6648ec3de3bf-u02",
          "speaker_id": "L",
          "ja": "今、話を聞いてほしい？　少し一緒に歩く？　それとも一人でいたい？",
          "vi": "Giờ cậu muốn tớ nghe chuyện, đi dạo cùng một chút, hay muốn ở một mình?"
        },
        {
          "id": "fed783ea-be61-56d3-8279-6648ec3de3bf-u03",
          "speaker_id": "F",
          "ja": "少し考えていい？　すぐには決められない。",
          "vi": "Cho tớ nghĩ một lát được không? Tớ chưa quyết ngay được."
        },
        {
          "id": "fed783ea-be61-56d3-8279-6648ec3de3bf-u04",
          "speaker_id": "L",
          "ja": "もちろん。どれを選んでも大丈夫だよ。",
          "vi": "Tất nhiên. Chọn cách nào cũng được cả."
        },
        {
          "id": "fed783ea-be61-56d3-8279-6648ec3de3bf-u05",
          "speaker_id": "F",
          "ja": "ありがとう。今は一人でいたいかな。",
          "vi": "Cảm ơn. Giờ chắc tớ muốn ở một mình."
        },
        {
          "id": "fed783ea-be61-56d3-8279-6648ec3de3bf-u06",
          "speaker_id": "L",
          "ja": "わかった。気が変わったら連絡してね。",
          "vi": "Tớ hiểu. Nếu đổi ý thì liên lạc với tớ nhé."
        }
      ],
      "admin": {
