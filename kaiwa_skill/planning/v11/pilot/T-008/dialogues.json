    {
      "situation_uid": "06addb4b-a84b-557f-8a85-645e08bd462b",
      "event_id": "E03",
      "context_vi": "Bạn thân nữ vừa nói hôm nay cô chỉ muốn bạn lắng nghe, không muốn nhận lời khuyên. Cô ấy còn ngập ngừng khi bắt đầu kể.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Bạn nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "06addb4b-a84b-557f-8a85-645e08bd462b-u01",
          "speaker_id": "L",
          "ja": "何が必要か言ってくれてありがとう。ただ聞いてほしいんだね。",
          "vi": "Cảm ơn cậu đã nói rõ điều cậu cần. Cậu chỉ muốn tớ lắng nghe thôi, đúng không?"
        },
        {
          "id": "06addb4b-a84b-557f-8a85-645e08bd462b-u02",
          "speaker_id": "F",
          "ja": "うん。うまく話せないかもしれないけど。",
          "vi": "Ừ. Có thể tớ sẽ không kể được mạch lạc."
        },
        {
          "id": "06addb4b-a84b-557f-8a85-645e08bd462b-u03",
          "speaker_id": "L",
          "ja": "ゆっくりでいいよ。言葉を探している間も待つよ。",
          "vi": "Cậu cứ từ từ. Cậu cần tìm lời thì tớ sẽ đợi."
        },
        {
          "id": "06addb4b-a84b-557f-8a85-645e08bd462b-u04",
          "speaker_id": "F",
          "ja": "それなら、少しずつ話せそう。",
          "vi": "Vậy chắc tớ kể từng chút được."
        },
        {
          "id": "06addb4b-a84b-557f-8a85-645e08bd462b-u05",
          "speaker_id": "L",
          "ja": "うん。話せるところからでいいよ。",
          "vi": "Ừ. Bắt đầu từ phần nào cậu nói được thôi."
        },
        {
          "id": "06addb4b-a84b-557f-8a85-645e08bd462b-u06",
          "speaker_id": "F",
          "ja": "ありがとう。聞いてくれるだけで助かる。",
          "vi": "Cảm ơn. Chỉ cần cậu nghe thôi là đã giúp tớ nhiều rồi."
        }
      ],
