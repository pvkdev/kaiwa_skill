    {
      "situation_uid": "a01a8c9b-8cca-57dc-b0f1-e6eecd011bcd",
      "event_id": "E02",
      "context_vi": "Ở cơ quan, bạn nghe tin bố của một đồng nghiệp nữ vừa mất. Bạn gặp cô lần đầu từ khi cô trở lại.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Đồng nghiệp nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "a01a8c9b-8cca-57dc-b0f1-e6eecd011bcd-u01",
          "speaker_id": "L",
          "ja": "お父様のこと、聞きました。このたびはご愁傷さまです。",
          "vi": "Tôi đã nghe tin về bố chị. Xin chia buồn cùng chị."
        },
        {
          "id": "a01a8c9b-8cca-57dc-b0f1-e6eecd011bcd-u02",
          "speaker_id": "F",
          "ja": "ありがとうございます。急なことで、まだ実感がなくて。",
          "vi": "Cảm ơn anh. Chuyện xảy ra đột ngột nên tôi vẫn chưa tin nổi chuyện đã xảy ra."
        },
        {
          "id": "a01a8c9b-8cca-57dc-b0f1-e6eecd011bcd-u03",
          "speaker_id": "L",
          "ja": "そうでしたか。今は、言葉が見つかりません。",
          "vi": "Vậy à. Lúc này tôi không biết nói gì cho phải."
        },
        {
          "id": "a01a8c9b-8cca-57dc-b0f1-e6eecd011bcd-u04",
          "speaker_id": "F",
          "ja": "お気持ちだけで十分です。",
          "vi": "Tấm lòng của anh là đủ rồi."
        },
        {
          "id": "a01a8c9b-8cca-57dc-b0f1-e6eecd011bcd-u05",
          "speaker_id": "L",
          "ja": "お返事は気にしないでください。では、私はこれで失礼します。",
          "vi": "Chị đừng bận tâm phải đáp lời. Tôi xin phép đi trước."
        },
        {
          "id": "a01a8c9b-8cca-57dc-b0f1-e6eecd011bcd-u06",
          "speaker_id": "F",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
