    {
      "situation_uid": "76cf4870-292a-564c-9d56-f4dd3326b3cd",
      "event_id": "E01",
      "context_vi": "Vài ngày sau khi người bạn trượt phỏng vấn, bạn gọi điện hỏi thăm. Cô ấy vẫn chưa chủ động nói về chuyện ấy.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Bạn nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "76cf4870-292a-564c-9d56-f4dd3326b3cd-u01",
          "speaker_id": "L",
          "ja": "この前のこと、その後どう？　答えにくかったら、今は答えなくていいよ。",
          "vi": "Chuyện hôm trước, dạo này cậu thế nào? Nếu khó nói thì lúc này không cần trả lời đâu."
        },
        {
          "id": "76cf4870-292a-564c-9d56-f4dd3326b3cd-u02",
          "speaker_id": "F",
          "ja": "ありがとう。まだ少し落ち込んでるけど、今日は外に出られたよ。",
          "vi": "Cảm ơn cậu. Tớ vẫn hơi buồn, nhưng hôm nay đã ra ngoài được."
        },
        {
          "id": "76cf4870-292a-564c-9d56-f4dd3326b3cd-u03",
          "speaker_id": "L",
          "ja": "そっか。教えてくれてありがとう。今週、短くお茶でもする？",
          "vi": "Ừ. Cảm ơn cậu đã cho tớ biết. Tuần này mình uống trà một lát nhé?"
        },
        {
          "id": "76cf4870-292a-564c-9d56-f4dd3326b3cd-u04",
          "speaker_id": "F",
          "ja": "今週はまだ一人で過ごしたいかな。",
          "vi": "Tuần này tớ vẫn muốn ở một mình."
        },
        {
          "id": "76cf4870-292a-564c-9d56-f4dd3326b3cd-u05",
          "speaker_id": "L",
          "ja": "わかった。誘いは気にしないで。話したくなったら連絡してね。",
          "vi": "Tớ hiểu. Cậu đừng bận tâm lời rủ nhé. Khi nào muốn nói chuyện thì nhắn tớ."
        },
        {
          "id": "76cf4870-292a-564c-9d56-f4dd3326b3cd-u06",
          "speaker_id": "F",
          "ja": "うん、ありがとう。",
          "vi": "Ừ, cảm ơn cậu."
        }
      ],
      "admin": {
