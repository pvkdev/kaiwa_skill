    {
      "situation_uid": "045270ed-989e-5487-8997-3722b69e231b",
      "event_id": "E03",
      "context_vi": "Sau khi nói muốn ở một mình, bạn nữ đổi ý và gọi điện vì cô muốn gặp bạn trong hôm nay.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Bạn nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "045270ed-989e-5487-8997-3722b69e231b-u01",
          "speaker_id": "F",
          "ja": "さっきは一人でいたいって言ったけど、やっぱり少し会える？",
          "vi": "Lúc nãy tớ bảo muốn ở một mình, nhưng giờ tớ muốn gặp cậu một chút, được không?"
        },
        {
          "id": "045270ed-989e-5487-8997-3722b69e231b-u02",
          "speaker_id": "L",
          "ja": "うん、会えるよ。今日は七時なら行ける。どこがいい？",
          "vi": "Ừ, được chứ. Hôm nay bảy giờ tớ đi được. Cậu muốn gặp ở đâu?"
        },
        {
          "id": "045270ed-989e-5487-8997-3722b69e231b-u03",
          "speaker_id": "F",
          "ja": "駅前の静かな喫茶店がいいな。",
          "vi": "Quán cà phê yên tĩnh trước ga nhé."
        },
        {
          "id": "045270ed-989e-5487-8997-3722b69e231b-u04",
          "speaker_id": "L",
          "ja": "駅の東口にある喫茶店で合ってる？　七時に店の前で待ち合わせよう。",
          "vi": "Quán cà phê ở cửa đông nhà ga, đúng không? Bảy giờ mình gặp trước cửa quán nhé."
        },
        {
          "id": "045270ed-989e-5487-8997-3722b69e231b-u05",
          "speaker_id": "F",
          "ja": "うん、東口の店。七時に行くね。",
          "vi": "Ừ, quán ở cửa đông. Bảy giờ tớ đến."
        },
        {
          "id": "045270ed-989e-5487-8997-3722b69e231b-u06",
          "speaker_id": "L",
          "ja": "わかった。もし時間を変えたくなったら、連絡して。",
          "vi": "Tớ hiểu rồi. Nếu muốn đổi giờ thì báo tớ nhé."
        }
      ],
