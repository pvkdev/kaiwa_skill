    {
      "situation_uid": "11e581cd-8394-5e17-b600-2be0276a7ebc",
      "event_id": "E02",
      "context_vi": "Sau thời gian nghỉ vì việc gia đình, đồng nghiệp nữ trở lại. Bạn từng giúp sắp xếp tài liệu cuộc họp của cô.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Đồng nghiệp nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "11e581cd-8394-5e17-b600-2be0276a7ebc-u01",
          "speaker_id": "L",
          "ja": "お戻りになってからの仕事、どう分けるのがやりやすいですか。",
          "vi": "Sau khi chị trở lại, mình chia công việc thế nào thì chị thấy thuận tiện?"
        },
        {
          "id": "11e581cd-8394-5e17-b600-2be0276a7ebc-u02",
          "speaker_id": "F",
          "ja": "まず自分で全体を確認してから、必要なところだけ相談したいです。",
          "vi": "Trước hết tôi muốn tự xem tổng thể, rồi chỉ trao đổi những chỗ cần."
        },
        {
          "id": "11e581cd-8394-5e17-b600-2be0276a7ebc-u03",
          "speaker_id": "L",
          "ja": "わかりました。私が整理した資料の場所だけ、先にお伝えしますね。",
          "vi": "Tôi hiểu. Tôi chỉ nói trước cho chị vị trí tài liệu tôi đã sắp xếp nhé."
        },
        {
          "id": "11e581cd-8394-5e17-b600-2be0276a7ebc-u04",
          "speaker_id": "F",
          "ja": "お願いします。説明はあとで読めば大丈夫です。",
          "vi": "Vâng, nhờ anh. Phần giải thích tôi đọc sau là được."
        },
        {
          "id": "11e581cd-8394-5e17-b600-2be0276a7ebc-u05",
          "speaker_id": "L",
          "ja": "共有フォルダの「今週の会議」です。急ぎの件が出たら、先に確認します。",
          "vi": "Nó ở thư mục chung, mục “Cuộc họp tuần này”. Nếu có việc gấp, tôi sẽ hỏi chị trước."
        },
        {
          "id": "11e581cd-8394-5e17-b600-2be0276a7ebc-u06",
          "speaker_id": "F",
          "ja": "ありがとうございます。その進め方なら助かります。",
          "vi": "Cảm ơn anh. Cách đó rất hợp với tôi."
        }
      ],
      "admin": {
