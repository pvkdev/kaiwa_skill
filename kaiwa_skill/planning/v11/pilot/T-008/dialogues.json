  "dialogues": [
    {
      "situation_uid": "2a4ac3d5-e2e6-5375-bda6-bd2da73a1f48",
      "event_id": "E01",
      "context_vi": "Bạn gặp một người bạn vừa trượt buổi phỏng vấn. Cô ấy đã chuẩn bị nhiều nhưng còn buồn và chưa biết có muốn kể không.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Bạn nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "2a4ac3d5-e2e6-5375-bda6-bd2da73a1f48-u01",
          "speaker_id": "F",
          "ja": "面接、だめだったんだ。",
          "vi": "Buổi phỏng vấn không được rồi."
        },
        {
          "id": "2a4ac3d5-e2e6-5375-bda6-bd2da73a1f48-u02",
          "speaker_id": "L",
          "ja": "そうだったんだ。それは残念だったね。準備してたもんね。",
          "vi": "Vậy à. Tiếc thật. Cậu đã chuẩn bị nhiều mà."
        },
        {
          "id": "2a4ac3d5-e2e6-5375-bda6-bd2da73a1f48-u03",
          "speaker_id": "F",
          "ja": "うん。まだちょっと気持ちの整理がつかなくて。",
          "vi": "Ừ. Tớ vẫn chưa bình tâm lại được."
        },
        {
          "id": "2a4ac3d5-e2e6-5375-bda6-bd2da73a1f48-u04",
          "speaker_id": "L",
          "ja": "今、話したい？　話したくなければ、無理に聞かないよ。",
          "vi": "Bây giờ cậu có muốn kể không? Nếu chưa muốn thì tớ không hỏi ép đâu."
        },
        {
          "id": "2a4ac3d5-e2e6-5375-bda6-bd2da73a1f48-u05",
          "speaker_id": "F",
          "ja": "ありがとう。少し考えさせて。",
          "vi": "Cảm ơn. Cho tớ nghĩ một chút nhé."
        },
        {
          "id": "2a4ac3d5-e2e6-5375-bda6-bd2da73a1f48-u06",
          "speaker_id": "L",
          "ja": "うん。急がなくていいよ。",
          "vi": "Ừ. Không cần vội đâu."
        }
      ],
      "admin": {
        "source_refs": [
          "b07-regret"
        ],
