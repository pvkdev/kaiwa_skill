    {
      "situation_uid": "40e7d94d-329f-5dca-8870-1b65835db7b1",
      "event_id": "E03",
      "context_vi": "Sau khi muốn ở một mình, bạn nữ đổi ý và gọi nhờ bạn đi dạo cùng ngay tối nay. Bạn không thể ra ngoài tối nay.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Bạn nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "40e7d94d-329f-5dca-8870-1b65835db7b1-u01",
          "speaker_id": "F",
          "ja": "やっぱり今夜、少し一緒に歩いてほしい。来られる？",
          "vi": "Nghĩ lại thì tối nay tớ muốn có người đi dạo cùng một chút. Cậu đến được không?"
        },
        {
          "id": "40e7d94d-329f-5dca-8870-1b65835db7b1-u02",
          "speaker_id": "L",
          "ja": "ごめん、今夜は外に出られないんだ。電話なら九時から話せるよ。",
          "vi": "Xin lỗi, tối nay tớ không ra ngoài được. Nếu gọi điện thì từ chín giờ tớ nói chuyện được."
        },
        {
          "id": "40e7d94d-329f-5dca-8870-1b65835db7b1-u03",
          "speaker_id": "F",
          "ja": "九時か。今すぐ誰かと話したい気もする。",
          "vi": "Chín giờ à. Có lẽ tớ muốn nói với ai đó ngay bây giờ."
        },
        {
          "id": "40e7d94d-329f-5dca-8870-1b65835db7b1-u04",
          "speaker_id": "L",
          "ja": "そうか。共通の友達の美咲に、僕から聞いてみようか？",
          "vi": "Ra vậy. Để tớ thử hỏi Misaki, bạn chung của mình, nhé?"
        },
        {
          "id": "40e7d94d-329f-5dca-8870-1b65835db7b1-u05",
          "speaker_id": "F",
          "ja": "美咲には自分で連絡する。九時に電話してもいい？",
          "vi": "Tớ sẽ tự liên lạc với Misaki. Chín giờ tớ gọi cậu được chứ?"
        },
        {
          "id": "40e7d94d-329f-5dca-8870-1b65835db7b1-u06",
          "speaker_id": "L",
          "ja": "もちろん。九時に電話を待ってるね。",
          "vi": "Tất nhiên. Chín giờ tớ đợi điện thoại của cậu."
        }
      ],
      "admin": {
