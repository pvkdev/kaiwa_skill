    {
      "situation_uid": "028642d7-668e-5003-a4de-f77635dee0d8",
      "event_id": "E03",
      "context_vi": "Bạn thân nữ đang buồn vì một chuyện riêng. Bạn muốn động viên cô nhưng chưa biết cô cần nghe điều gì.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Bạn nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "028642d7-668e-5003-a4de-f77635dee0d8-u01",
          "speaker_id": "L",
          "ja": "頑張って。きっとうまくいくよ。",
          "vi": "Cố lên. Rồi mọi chuyện sẽ ổn thôi."
        },
        {
          "id": "028642d7-668e-5003-a4de-f77635dee0d8-u02",
          "speaker_id": "F",
          "ja": "今「頑張って」って言われると、もっと頑張らなきゃって苦しくなる。",
          "vi": "Giờ nghe “cố lên”, tớ lại thấy khổ vì như thể mình phải cố hơn nữa."
        },
        {
          "id": "028642d7-668e-5003-a4de-f77635dee0d8-u03",
          "speaker_id": "L",
          "ja": "ごめん。励ますつもりだったけど、負担をかけたね。",
          "vi": "Xin lỗi. Tớ định động viên, nhưng lại khiến cậu thêm áp lực."
        },
        {
          "id": "028642d7-668e-5003-a4de-f77635dee0d8-u04",
          "speaker_id": "F",
          "ja": "うん。今は先のことを考える余裕がないんだ。",
          "vi": "Ừ. Giờ tớ không còn sức nghĩ đến chuyện sau này."
        },
        {
          "id": "028642d7-668e-5003-a4de-f77635dee0d8-u05",
          "speaker_id": "L",
          "ja": "そうだよね。先の話はしない。今は、ここで話を聞くよ。",
          "vi": "Ừ nhỉ. Tớ sẽ không nói chuyện tương lai nữa. Lúc này tớ ở đây nghe cậu."
        },
        {
          "id": "028642d7-668e-5003-a4de-f77635dee0d8-u06",
          "speaker_id": "F",
          "ja": "ありがとう。今日はアドバイスより、ただ聞いてほしい。",
          "vi": "Cảm ơn. Hôm nay tớ chỉ muốn cậu lắng nghe, không cần lời khuyên."
        }
      ],
      "admin": {
