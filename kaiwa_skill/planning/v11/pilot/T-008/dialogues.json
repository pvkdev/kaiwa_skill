    {
      "situation_uid": "e40c9c66-e42c-53a6-b48f-44ae7c70eedb",
      "event_id": "E01",
      "context_vi": "Người bạn đã kể cô chuẩn bị nhiều nhưng căng thẳng nên im lặng trước một câu hỏi phỏng vấn. Bạn muốn động viên cô.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Bạn nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "e40c9c66-e42c-53a6-b48f-44ae7c70eedb-u01",
          "speaker_id": "L",
          "ja": "でも、次はもっと準備すれば大丈夫だよ。",
          "vi": "Nhưng lần sau cậu chuẩn bị kỹ hơn là sẽ ổn thôi."
        },
        {
          "id": "e40c9c66-e42c-53a6-b48f-44ae7c70eedb-u02",
          "speaker_id": "F",
          "ja": "違うよ。準備はしたのに、緊張で言えなかったの。",
          "vi": "Không phải. Tớ đã chuẩn bị rồi, nhưng vì căng thẳng nên không nói được."
        },
        {
          "id": "e40c9c66-e42c-53a6-b48f-44ae7c70eedb-u03",
          "speaker_id": "L",
          "ja": "ごめん。準備してなかったみたいに聞こえたよね。ちゃんと聞かずに言ってしまった。",
          "vi": "Xin lỗi. Nghe như tớ bảo cậu đã không chuẩn bị. Tớ nói mà chưa nghe cho kỹ."
        },
        {
          "id": "e40c9c66-e42c-53a6-b48f-44ae7c70eedb-u04",
          "speaker_id": "F",
          "ja": "うん。そこをわかってほしかった。",
          "vi": "Ừ. Tớ chỉ mong cậu hiểu điểm đó."
        },
        {
          "id": "e40c9c66-e42c-53a6-b48f-44ae7c70eedb-u05",
          "speaker_id": "L",
          "ja": "準備した分、言えなかったのが余計に悔しかったんだね。",
          "vi": "Chính vì đã chuẩn bị nên cậu càng tiếc vì không nói ra được nhỉ."
        },
        {
          "id": "e40c9c66-e42c-53a6-b48f-44ae7c70eedb-u06",
          "speaker_id": "F",
          "ja": "そう。聞いてくれてありがとう。",
          "vi": "Đúng vậy. Cảm ơn cậu đã nghe."
        }
      ],
      "admin": {
        "source_refs": [
          "b07-regret"
        ],
        "specialty_item_ids": [],
