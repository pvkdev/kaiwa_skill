    {
      "situation_uid": "914a686a-4336-56a4-bb8b-2103840f5a2c",
      "event_id": "E02",
      "context_vi": "Một đồng nghiệp nữ vừa có tang trong gia đình. Cô ấy đang lo phần chuẩn bị cho cuộc họp tuần này bị chậm.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Đồng nghiệp nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "914a686a-4336-56a4-bb8b-2103840f5a2c-u01",
          "speaker_id": "F",
          "ja": "今週の打ち合わせの準備、少し遅れていて。",
          "vi": "Phần chuẩn bị cuộc họp tuần này hơi chậm rồi."
        },
        {
          "id": "914a686a-4336-56a4-bb8b-2103840f5a2c-u02",
          "speaker_id": "L",
          "ja": "資料の整理なら、今日の午後、私ができます。そこを引き受けましょうか。",
          "vi": "Tôi có thể sắp xếp tài liệu chiều nay. Để tôi nhận phần đó nhé?"
        },
        {
          "id": "914a686a-4336-56a4-bb8b-2103840f5a2c-u03",
          "speaker_id": "F",
          "ja": "助かります。でも、説明の部分は自分でやりたいです。",
          "vi": "Vậy thì giúp tôi nhiều quá. Nhưng phần trình bày tôi muốn tự làm."
        },
        {
          "id": "914a686a-4336-56a4-bb8b-2103840f5a2c-u04",
          "speaker_id": "L",
          "ja": "わかりました。資料だけ整えて、説明の内容は触れません。",
          "vi": "Tôi hiểu. Tôi chỉ sắp xếp tài liệu, không đụng vào nội dung trình bày."
        },
        {
          "id": "914a686a-4336-56a4-bb8b-2103840f5a2c-u05",
          "speaker_id": "F",
          "ja": "ありがとうございます。元のファイルは共有フォルダにあります。",
          "vi": "Cảm ơn anh. File gốc nằm trong thư mục chung."
        },
        {
          "id": "914a686a-4336-56a4-bb8b-2103840f5a2c-u06",
          "speaker_id": "L",
          "ja": "今日中に整理して、終わったら連絡します。",
          "vi": "Tôi sẽ sắp xếp xong trong hôm nay rồi báo chị."
        }
      ],
      "admin": {
