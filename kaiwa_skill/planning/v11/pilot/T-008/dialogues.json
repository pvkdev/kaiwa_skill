    {
      "situation_uid": "745fee11-885f-5bbe-8cd4-2e7c698031ef",
      "event_id": "E02",
      "context_vi": "Sau khi bạn gửi lời chia buồn ở cơ quan, đồng nghiệp nữ nói tại hành lang rằng cô chưa muốn nói thêm về chuyện gia đình.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Đồng nghiệp nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "745fee11-885f-5bbe-8cd4-2e7c698031ef-u01",
          "speaker_id": "F",
          "ja": "すみません、家のことは今、あまり話したくなくて。",
          "vi": "Xin lỗi, lúc này tôi không muốn nói nhiều về chuyện gia đình."
        },
        {
          "id": "745fee11-885f-5bbe-8cd4-2e7c698031ef-u02",
          "speaker_id": "L",
          "ja": "わかりました。こちらから詳しくは聞きません。",
          "vi": "Tôi hiểu. Tôi sẽ không hỏi thêm chuyện riêng."
        },
        {
          "id": "745fee11-885f-5bbe-8cd4-2e7c698031ef-u03",
          "speaker_id": "F",
          "ja": "ありがとうございます。仕事の話なら大丈夫です。",
          "vi": "Cảm ơn anh. Nếu là chuyện công việc thì tôi vẫn nói được."
        },
        {
          "id": "745fee11-885f-5bbe-8cd4-2e7c698031ef-u04",
          "speaker_id": "L",
          "ja": "では、仕事の連絡はいつもどおりチャットで送ってもいいですか。",
          "vi": "Vậy tôi vẫn gửi trao đổi công việc qua chat như thường lệ được chứ?"
        },
        {
          "id": "745fee11-885f-5bbe-8cd4-2e7c698031ef-u05",
          "speaker_id": "F",
          "ja": "はい。それがいちばん助かります。",
          "vi": "Vâng. Như thế tiện cho tôi nhất."
        },
        {
          "id": "745fee11-885f-5bbe-8cd4-2e7c698031ef-u06",
          "speaker_id": "L",
          "ja": "承知しました。返信は必要なときだけで大丈夫です。",
          "vi": "Tôi hiểu rồi. Chị chỉ cần trả lời khi cần thiết thôi."
        }
      ],
      "admin": {
