    {
      "situation_uid": "af9b3d7c-4390-5530-a870-f086485255c1",
      "event_id": "E01",
      "context_vi": "Sau khi cân nhắc, người bạn quyết định kể chuyện trượt phỏng vấn. Cô ấy tiếc vì không nói được điều đã chuẩn bị.",
      "speakers": [
        {
          "id": "L",
          "role_vi": "Người học",
          "gender": "male"
        },
        {
          "id": "F",
          "role_vi": "Bạn nữ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "af9b3d7c-4390-5530-a870-f086485255c1-u01",
          "speaker_id": "F",
          "ja": "少し話してもいい？　結果より、面接で言いたいことを言えなかったのが悔しくて。",
          "vi": "Tớ kể một chút được không? Buồn hơn cả kết quả là trong buổi phỏng vấn tớ đã không nói được điều mình muốn."
        },
        {
          "id": "af9b3d7c-4390-5530-a870-f086485255c1-u02",
          "speaker_id": "L",
          "ja": "もちろん。言いたいことを言えなかったのが、悔しかったんだね。",
          "vi": "Tất nhiên rồi. Cậu tiếc vì đã không nói được điều mình muốn, đúng không?"
        },
        {
          "id": "af9b3d7c-4390-5530-a870-f086485255c1-u03",
          "speaker_id": "F",
          "ja": "そう。準備した話が、緊張して全部飛んじゃった。",
          "vi": "Ừ. Vì căng thẳng nên những điều tớ chuẩn bị cứ bay sạch."
        },
        {
          "id": "af9b3d7c-4390-5530-a870-f086485255c1-u04",
          "speaker_id": "L",
          "ja": "それはつらかったね。今は、何がいちばん心に残ってる？",
          "vi": "Lúc ấy hẳn khó chịu lắm. Giờ điều gì cứ đọng lại trong lòng cậu nhất?"
        },
        {
          "id": "af9b3d7c-4390-5530-a870-f086485255c1-u05",
          "speaker_id": "F",
          "ja": "面接官の質問に、黙ってしまったところかな。",
          "vi": "Chắc là lúc tớ im lặng trước câu hỏi của người phỏng vấn."
        },
        {
          "id": "af9b3d7c-4390-5530-a870-f086485255c1-u06",
          "speaker_id": "L",
          "ja": "そっか。そこが何度も頭に浮かぶんだね。",
          "vi": "Ra vậy. Khoảnh khắc đó cứ hiện lại trong đầu cậu nhỉ."
        }
      ],
      "admin": {
        "source_refs": [
          "b07-regret"
        ],
        "specialty_item_ids": [
          "sj-trung-02-b07-34"
        ],
