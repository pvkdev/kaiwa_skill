    {
      "situation_uid": "38599a91-33f3-5941-8a61-a9139207599b",
      "event_id": "E01",
      "context_vi": "Lúc 2 giờ 55 tại trung tâm, sau lời nhờ trông túi năm phút, bạn chỉ có thể trông đến 2 giờ 58 vì phải đi. Người học cần đổi kế hoạch.",
      "speakers": [
        {
          "id": "learner",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "other",
          "role_vi": "bạn/người được nhờ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "38599a91-33f3-5941-8a61-a9139207599b-u01",
          "speaker_id": "other",
          "ja": "ごめん。二時五十八分には出るんだ。",
          "vi": "Xin lỗi. Tớ phải đi lúc 2 giờ 58."
        },
        {
          "id": "38599a91-33f3-5941-8a61-a9139207599b-u02",
          "speaker_id": "learner",
          "ja": "そうか。五分は無理だね。かばんは持って行くよ。",
          "vi": "Vậy à. Năm phút thì không kịp. Tớ sẽ mang túi theo."
        },
        {
          "id": "38599a91-33f3-5941-8a61-a9139207599b-u03",
          "speaker_id": "other",
          "ja": "うん、ごめんね。",
          "vi": "Ừ, xin lỗi nhé."
        },
        {
          "id": "38599a91-33f3-5941-8a61-a9139207599b-u04",
          "speaker_id": "learner",
          "ja": "大丈夫。教えてくれてありがとう。",
          "vi": "Không sao. Cảm ơn cậu đã nói trước."
        }
      ],
      "admin": {
        "source_refs": [
          "b02_limit",
          "b26_refusal"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
