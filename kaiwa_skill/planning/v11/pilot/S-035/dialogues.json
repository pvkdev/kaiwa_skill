    {
      "situation_uid": "6c750b19-9237-5f0f-a814-f075b42657bf",
      "event_id": "E01",
      "context_vi": "Lúc 2 giờ 55, trước khi vào phòng bên cạnh trong trung tâm sinh hoạt, người học cần để bạn quen trông giúp túi sách trong năm phút. Bạn chưa trả lời ngay.",
      "speakers": [
        {
          "id": "learner",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "other",
          "role_vi": "bạn/người được nhờ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "6c750b19-9237-5f0f-a814-f075b42657bf-u01",
          "speaker_id": "learner",
          "ja": "今、ちょっといい？このかばん、五分だけ見ていてくれる？",
          "vi": "Giờ cậu rảnh chút không? Trông giúp tớ cái túi này đúng năm phút nhé?"
        },
        {
          "id": "6c750b19-9237-5f0f-a814-f075b42657bf-u02",
          "speaker_id": "other",
          "ja": "五分？ちょっと予定を見てもいい？",
          "vi": "Năm phút à? Để tớ xem lịch một chút nhé?"
        },
        {
          "id": "6c750b19-9237-5f0f-a814-f075b42657bf-u03",
          "speaker_id": "learner",
          "ja": "うん。ここで待つね。",
          "vi": "Ừ. Tớ đợi ở đây nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "b07_open",
          "b08_request"
        ],
        "specialty_item_ids": [
          "sj-so-08-b07-88"
        ],
