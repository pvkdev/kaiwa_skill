          }
        }
      }
    },
    {
      "situation_uid": "aea2d6ec-de98-5d3c-a6a1-779b523a005b",
      "event_id": "E01",
      "context_vi": "Lúc 2 giờ 55 tại trung tâm, sau lời nhờ trông túi năm phút, bạn xem lịch và nhận lời. Người học cần xác nhận giờ quay lại lấy.",
      "speakers": [
        {
          "id": "learner",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "other",
          "role_vi": "bạn/người được nhờ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "aea2d6ec-de98-5d3c-a6a1-779b523a005b-u01",
          "speaker_id": "other",
          "ja": "五分ならいいよ。ここで待ってるね。",
          "vi": "Năm phút thì được. Tớ đợi ở đây nhé."
        },
        {
          "id": "aea2d6ec-de98-5d3c-a6a1-779b523a005b-u02",
          "speaker_id": "learner",
          "ja": "ありがとう。三時にここへ戻るね。",
          "vi": "Cảm ơn. Ba giờ tớ quay lại đây nhé."
        },
        {
          "id": "aea2d6ec-de98-5d3c-a6a1-779b523a005b-u03",
          "speaker_id": "other",
          "ja": "うん、三時ね。",
          "vi": "Ừ, ba giờ nhé."
        },
        {
          "id": "aea2d6ec-de98-5d3c-a6a1-779b523a005b-u04",
          "speaker_id": "learner",
          "ja": "じゃ、お願い。",
          "vi": "Vậy nhờ cậu nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "b07_request"
        ],
        "specialty_item_ids": [],
