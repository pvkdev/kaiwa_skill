    {
      "situation_uid": "da6c1107-21e6-5af8-b6b7-c9506116f35e",
      "event_id": "E02",
      "context_vi": "Ở cửa trung tâm sinh hoạt, người học đang bê một hộp giấy và nhờ người đứng gần mở cửa một chút. Người kia làm ngay.",
      "speakers": [
        {
          "id": "learner",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "other",
          "role_vi": "người đứng gần",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "da6c1107-21e6-5af8-b6b7-c9506116f35e-u01",
          "speaker_id": "learner",
          "ja": "すみません。ドアを開けていただけますか。箱を持っているんです。",
          "vi": "Xin lỗi. Chị mở cửa giúp tôi được không ạ? Tôi đang bê hộp."
        },
        {
          "id": "da6c1107-21e6-5af8-b6b7-c9506116f35e-u02",
          "speaker_id": "other",
          "ja": "はい、どうぞ。",
          "vi": "Vâng, mời anh đi ạ."
        },
        {
          "id": "da6c1107-21e6-5af8-b6b7-c9506116f35e-u03",
          "speaker_id": "learner",
          "ja": "ありがとうございます。助かりました。",
          "vi": "Cảm ơn chị. Chị giúp tôi nhiều quá."
        },
        {
          "id": "da6c1107-21e6-5af8-b6b7-c9506116f35e-u04",
          "speaker_id": "other",
          "ja": "いえいえ。",
          "vi": "Không có gì ạ."
        }
      ],
      "admin": {
