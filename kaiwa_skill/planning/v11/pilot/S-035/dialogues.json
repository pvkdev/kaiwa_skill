    {
      "situation_uid": "0fb561c9-1c32-56a5-a423-b7fc3419e352",
      "event_id": "E01",
      "context_vi": "Sau cùng lời nhờ ở trung tâm, bạn nói không thể trông túi vì sắp đi. Người học cảm ơn và quyết định tự mang theo.",
      "speakers": [
        {
          "id": "learner",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "other",
          "role_vi": "bạn/người được nhờ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "0fb561c9-1c32-56a5-a423-b7fc3419e352-u01",
          "speaker_id": "other",
          "ja": "ごめん、今から出るから見ていられない。",
          "vi": "Xin lỗi, tớ phải đi ngay nên không trông được."
        },
        {
          "id": "0fb561c9-1c32-56a5-a423-b7fc3419e352-u02",
          "speaker_id": "learner",
          "ja": "わかった。かばんは自分で持って行くね。",
          "vi": "Tớ hiểu rồi. Tớ tự mang túi đi nhé."
        },
        {
          "id": "0fb561c9-1c32-56a5-a423-b7fc3419e352-u03",
          "speaker_id": "other",
          "ja": "うん、ごめんね。",
          "vi": "Ừ, xin lỗi nhé."
        },
        {
          "id": "0fb561c9-1c32-56a5-a423-b7fc3419e352-u04",
          "speaker_id": "learner",
          "ja": "いいよ。答えてくれてありがとう。",
          "vi": "Không sao. Cảm ơn cậu đã trả lời."
        }
      ],
      "admin": {
        "source_refs": [
          "b26_refusal"
        ],
