    {
      "situation_uid": "1fa09ea7-04ea-5b61-9484-627b55275888",
      "event_id": "E02",
      "context_vi": "Tại công viên, người học đưa điện thoại cho một người đang đứng gần và nhờ chụp đúng một tấm ảnh. Người kia nhận lời và hỏi vị trí đứng.",
      "speakers": [
        {
          "id": "learner",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "other",
          "role_vi": "người đứng gần",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "1fa09ea7-04ea-5b61-9484-627b55275888-u01",
          "speaker_id": "learner",
          "ja": "すみません、ちょっといいですか。写真を一枚撮っていただけますか。",
          "vi": "Xin lỗi, cho tôi nhờ chút được không ạ? Chị chụp giúp tôi một tấm ảnh nhé?"
        },
        {
          "id": "1fa09ea7-04ea-5b61-9484-627b55275888-u02",
          "speaker_id": "other",
          "ja": "いいですよ。どこに立ちますか。",
          "vi": "Được ạ. Anh đứng ở đâu?"
        },
        {
          "id": "1fa09ea7-04ea-5b61-9484-627b55275888-u03",
          "speaker_id": "learner",
          "ja": "あの木の前です。お願いします。",
          "vi": "Trước cái cây kia ạ. Nhờ chị nhé."
        },
        {
          "id": "1fa09ea7-04ea-5b61-9484-627b55275888-u04",
          "speaker_id": "other",
          "ja": "はい、撮りますよ。",
          "vi": "Vâng, tôi chụp đây."
        }
      ],
      "admin": {
