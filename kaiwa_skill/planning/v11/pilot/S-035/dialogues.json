          "id": "6124aedf-da41-59ab-964f-74d950494a1b-u02",
          "speaker_id": "learner",
          "ja": "一つなら運べるよ。三時に出るんだ。",
          "vi": "Một cái thì tớ mang được. Ba giờ tớ phải đi."
        },
