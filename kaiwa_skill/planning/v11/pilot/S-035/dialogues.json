  "dialogues": [
    {
      "situation_uid": "9e76289d-0136-58e2-ba98-8d251adaa543",
      "event_id": "E01",
      "context_vi": "Ở sảnh lớp học, người học hỏi một bạn quen đường đến phòng sinh hoạt mới ở tòa bên cạnh. Bạn biết phòng ở tầng hai; sau lời chỉ, người học biết lối đi.",
      "speakers": [
        {
          "id": "learner",
          "role_vi": "người học",
          "gender": "male"
        },
        {
          "id": "other",
          "role_vi": "bạn/người được nhờ",
          "gender": "female"
        }
      ],
      "turns": [
        {
          "id": "9e76289d-0136-58e2-ba98-8d251adaa543-u01",
          "speaker_id": "learner",
          "ja": "今、ちょっといい？新しい交流室への行き方を教えてくれる？",
          "vi": "Giờ cậu có rảnh chút không? Chỉ tớ đường đến phòng giao lưu mới nhé?"
        },
        {
          "id": "9e76289d-0136-58e2-ba98-8d251adaa543-u02",
          "speaker_id": "other",
          "ja": "うん。隣の建物の二階だよ。",
          "vi": "Ừ. Ở tầng hai tòa nhà bên cạnh."
        },
        {
          "id": "9e76289d-0136-58e2-ba98-8d251adaa543-u03",
          "speaker_id": "learner",
          "ja": "入口はどこ？",
          "vi": "Lối vào ở đâu?"
        },
        {
          "id": "9e76289d-0136-58e2-ba98-8d251adaa543-u04",
          "speaker_id": "other",
          "ja": "この道をまっすぐ行って、右だよ。",
          "vi": "Đi thẳng đường này rồi rẽ phải."
        },
        {
          "id": "9e76289d-0136-58e2-ba98-8d251adaa543-u05",
          "speaker_id": "learner",
          "ja": "右だね。ありがとう、行ってみる。",
          "vi": "Rẽ phải nhỉ. Cảm ơn, tớ đi thử nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "b07_open",
          "b07_thanks"
        ],
        "specialty_item_ids": [
          "sj-so-08-b07-88"
