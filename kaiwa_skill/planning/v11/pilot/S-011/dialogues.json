    {
      "situation_uid": "68b27ce2-cdc7-550e-a748-0b7dfe400a8c",
      "event_id": "E01",
      "context_vi": "Nhân viên vừa báo bạn đang đứng ở sân ga đi ngược hướng. Trước khi sang sân ga khác, bạn kiểm lại ga đổi và sân ga đúng.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "68b27ce2-cdc7-550e-a748-0b7dfe400a8c-u01",
          "speaker_id": "a",
          "ja": "確認してもいいですか。ここが青葉駅で、ここで乗り換えですね。",
          "vi": "Tôi hỏi lại được không ạ? Đây là ga Aoba và tôi đổi tàu ở đây, đúng không ạ?"
        },
        {
          "id": "68b27ce2-cdc7-550e-a748-0b7dfe400a8c-u02",
          "speaker_id": "b",
          "ja": "はい、ここで乗り換えです。",
          "vi": "Vâng, chị đổi tàu ở đây."
        },
        {
          "id": "68b27ce2-cdc7-550e-a748-0b7dfe400a8c-u03",
          "speaker_id": "a",
          "ja": "桜駅へは、向かいの２番線ですね。",
          "vi": "Để đến ga Sakura thì sang sân ga số 2 phía đối diện, đúng không ạ?"
        },
        {
          "id": "68b27ce2-cdc7-550e-a748-0b7dfe400a8c-u04",
          "speaker_id": "b",
          "ja": "そうです。あちらの２番線、桜方面です。",
          "vi": "Đúng rồi. Sân ga số 2 phía kia, hướng Sakura."
        },
        {
          "id": "68b27ce2-cdc7-550e-a748-0b7dfe400a8c-u05",
          "speaker_id": "a",
          "ja": "わかりました。向かいへ行きます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ sang phía đối diện."
        }
      ],
