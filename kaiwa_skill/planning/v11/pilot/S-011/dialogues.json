    {
      "situation_uid": "2393a507-1d7c-5210-8725-49c28f0ed7ae",
      "event_id": "E03",
      "context_vi": "Ở cổng soát vé, vé giấy của bạn không qua được máy. Bạn hỏi nhân viên ga quầy thích hợp và đưa vé để họ xem.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2393a507-1d7c-5210-8725-49c28f0ed7ae-u01",
          "speaker_id": "a",
          "ja": "すみません、この切符で改札を通れません。",
          "vi": "Xin lỗi, vé này không qua cổng soát vé được ạ."
        },
        {
          "id": "2393a507-1d7c-5210-8725-49c28f0ed7ae-u02",
          "speaker_id": "b",
          "ja": "窓口で確認します。",
          "vi": "Tôi sẽ kiểm tra vé ở quầy."
        },
        {
          "id": "2393a507-1d7c-5210-8725-49c28f0ed7ae-u03",
          "speaker_id": "a",
          "ja": "どの窓口に行けばいいですか。",
          "vi": "Tôi nên đến quầy nào ạ?"
        },
        {
          "id": "2393a507-1d7c-5210-8725-49c28f0ed7ae-u04",
          "speaker_id": "b",
          "ja": "こちらです。切符を見せてください。",
          "vi": "Quầy này ạ. Xin cho tôi xem vé."
        },
        {
          "id": "2393a507-1d7c-5210-8725-49c28f0ed7ae-u05",
          "speaker_id": "a",
          "ja": "お願いします。",
          "vi": "Nhờ anh kiểm tra giúp ạ."
        }
      ],
