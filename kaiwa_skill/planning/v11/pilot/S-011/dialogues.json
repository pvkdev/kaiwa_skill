    {
      "situation_uid": "4e5556ca-92ca-5164-95fa-96f682da6aea",
      "event_id": "E03",
      "context_vi": "Ở ga, bạn xách nhiều hành lý và muốn tìm thang máy để lên sân ga. Hỏi nhân viên ga đường đi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "4e5556ca-92ca-5164-95fa-96f682da6aea-u01",
          "speaker_id": "a",
          "ja": "すみません、荷物が多いです。エレベーターはどちらですか。",
          "vi": "Xin lỗi, tôi có nhiều hành lý. Thang máy ở phía nào ạ?"
        },
        {
          "id": "4e5556ca-92ca-5164-95fa-96f682da6aea-u02",
          "speaker_id": "b",
          "ja": "あちらです。改札の右にあります。",
          "vi": "Phía kia. Thang máy ở bên phải cổng soát vé."
        },
        {
          "id": "4e5556ca-92ca-5164-95fa-96f682da6aea-u03",
          "speaker_id": "a",
          "ja": "改札の右ですね。",
          "vi": "Bên phải cổng soát vé ạ?"
        },
        {
          "id": "4e5556ca-92ca-5164-95fa-96f682da6aea-u04",
          "speaker_id": "b",
          "ja": "はい。こちらから行けます。",
          "vi": "Vâng. Chị đi lối này được."
        },
        {
          "id": "4e5556ca-92ca-5164-95fa-96f682da6aea-u05",
          "speaker_id": "a",
          "ja": "ありがとうございます。",
          "vi": "Cảm ơn anh ạ."
        }
      ],
      "admin": {
        "source_refs": [
          "w_jr"
        ],
