  "dialogues": [
    {
      "situation_uid": "519f0e38-bbc1-5164-a0a0-bd370a5e996d",
      "event_id": "E01",
      "context_vi": "Tại sân ga, bạn muốn đến ga Sakura nhưng chưa biết tàu đang đỗ có tới đó không. Bạn hỏi nhân viên trước khi lên.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "519f0e38-bbc1-5164-a0a0-bd370a5e996d-u01",
          "speaker_id": "a",
          "ja": "すみません、この電車は桜駅に行きますか。",
          "vi": "Xin lỗi, tàu này có đến ga Sakura không ạ?"
        },
        {
          "id": "519f0e38-bbc1-5164-a0a0-bd370a5e996d-u02",
          "speaker_id": "b",
          "ja": "いいえ、桜駅には行きません。青葉駅まで行きます。",
          "vi": "Không, tàu này không đến ga Sakura. Tàu đi đến ga Aoba."
        },
        {
          "id": "519f0e38-bbc1-5164-a0a0-bd370a5e996d-u03",
          "speaker_id": "a",
          "ja": "桜駅へは、どの電車ですか。",
          "vi": "Vậy tôi đi tàu nào để đến ga Sakura ạ?"
        },
        {
          "id": "519f0e38-bbc1-5164-a0a0-bd370a5e996d-u04",
          "speaker_id": "b",
          "ja": "青葉駅で乗り換えてください。まず、この電車に乗ってください。",
          "vi": "Chị đổi tàu ở ga Aoba. Trước tiên, mời chị lên tàu này."
        },
        {
          "id": "519f0e38-bbc1-5164-a0a0-bd370a5e996d-u05",
          "speaker_id": "a",
          "ja": "この電車で青葉駅までですね。",
          "vi": "Tàu này đến ga Aoba, đúng không ạ?"
        },
        {
          "id": "519f0e38-bbc1-5164-a0a0-bd370a5e996d-u06",
          "speaker_id": "b",
          "ja": "はい、そうです。",
          "vi": "Vâng, đúng rồi."
        }
      ],
      "admin": {
