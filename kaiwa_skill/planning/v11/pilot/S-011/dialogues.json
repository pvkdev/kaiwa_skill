    {
      "situation_uid": "ea8e465e-3b20-539c-8168-255b71403c65",
      "event_id": "E02",
      "context_vi": "Tại trạm xe buýt, bạn muốn đến bến Bệnh viện nhưng chưa biết xe trước mặt có đi thẳng tới đó không. Bạn hỏi lái xe trước khi lên.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "lái xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ea8e465e-3b20-539c-8168-255b71403c65-u01",
          "speaker_id": "a",
          "ja": "すみません、このバスで病院前まで行けますか。",
          "vi": "Xin lỗi, đi xe này có tới bến Bệnh viện không ạ?"
        },
        {
          "id": "ea8e465e-3b20-539c-8168-255b71403c65-u02",
          "speaker_id": "b",
          "ja": "いいえ。このバスは中央公園までです。",
          "vi": "Không. Xe này chỉ đến bến Công viên Trung tâm."
        },
        {
          "id": "ea8e465e-3b20-539c-8168-255b71403c65-u03",
          "speaker_id": "a",
          "ja": "どこで乗り換えますか。",
          "vi": "Tôi đổi xe ở đâu ạ?"
        },
        {
          "id": "ea8e465e-3b20-539c-8168-255b71403c65-u04",
          "speaker_id": "b",
          "ja": "中央公園で降りて、病院前行きに乗ってください。",
          "vi": "Chị xuống ở bến Công viên Trung tâm rồi lên xe đi bến Bệnh viện."
        },
        {
          "id": "ea8e465e-3b20-539c-8168-255b71403c65-u05",
          "speaker_id": "a",
          "ja": "中央公園で降りるんですね。",
          "vi": "Vậy tôi xuống ở bến Công viên Trung tâm ạ?"
        },
        {
          "id": "ea8e465e-3b20-539c-8168-255b71403c65-u06",
          "speaker_id": "b",
          "ja": "はい。降りたら、次のバスの乗り場を確認してください。",
          "vi": "Đúng rồi. Sau khi xuống, chị hãy kiểm tra chỗ đón xe tiếp theo."
        }
      ],
