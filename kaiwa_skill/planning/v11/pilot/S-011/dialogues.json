    {
      "situation_uid": "82d2a9aa-d6d8-54cc-9fbd-dbb23b49a236",
      "event_id": "E02",
      "context_vi": "Sau khi đi quá bến Thư viện, bạn gọi cho người bạn nam đang đợi ở đó. Bạn báo sẽ xuống ở bến Hội trường Thành phố rồi tìm đường quay lại, chưa hứa giờ đến.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "người bạn đang đợi",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "82d2a9aa-d6d8-54cc-9fbd-dbb23b49a236-u01",
          "speaker_id": "a",
          "ja": "もしもし、図書館前を過ぎたよ。",
          "vi": "A lô, tớ đi quá bến Thư viện rồi."
        },
        {
          "id": "82d2a9aa-d6d8-54cc-9fbd-dbb23b49a236-u02",
          "speaker_id": "b",
          "ja": "えっ、今どこ？",
          "vi": "Ơ, giờ cậu ở đâu?"
        },
        {
          "id": "82d2a9aa-d6d8-54cc-9fbd-dbb23b49a236-u03",
          "speaker_id": "a",
          "ja": "次の市民会館前で降りるよ。少し遅れる。",
          "vi": "Tớ sẽ xuống ở bến Hội trường Thành phố tiếp theo. Tớ sẽ đến muộn một chút."
        },
        {
          "id": "82d2a9aa-d6d8-54cc-9fbd-dbb23b49a236-u04",
          "speaker_id": "b",
          "ja": "わかった。図書館の前で待ってるね。",
          "vi": "Ừ, tớ đợi trước thư viện nhé."
        },
        {
          "id": "82d2a9aa-d6d8-54cc-9fbd-dbb23b49a236-u05",
          "speaker_id": "a",
          "ja": "うん。降りたら、また連絡するね。",
          "vi": "Ừ. Xuống xe rồi tớ liên lạc lại nhé."
        }
      ],
