    {
      "situation_uid": "ae9d1408-aae7-5398-85ba-a2c7f29a45d6",
      "event_id": "E01",
      "context_vi": "Bạn muốn đến ga Sakura và nghe nói phải đổi tàu, nhưng chưa biết đổi ở ga nào. Bạn hỏi nhân viên trước khi đi.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ae9d1408-aae7-5398-85ba-a2c7f29a45d6-u01",
          "speaker_id": "a",
          "ja": "すみません、桜駅へ行きたいです。どこで乗り換えますか。",
          "vi": "Xin lỗi, tôi muốn đến ga Sakura. Tôi đổi tàu ở đâu ạ?"
        },
        {
          "id": "ae9d1408-aae7-5398-85ba-a2c7f29a45d6-u02",
          "speaker_id": "b",
          "ja": "青葉駅で乗り換えます。",
          "vi": "Chị đổi tàu ở ga Aoba."
        },
        {
          "id": "ae9d1408-aae7-5398-85ba-a2c7f29a45d6-u03",
          "speaker_id": "a",
          "ja": "青葉駅ですか。",
          "vi": "Ga Aoba ạ?"
        },
        {
          "id": "ae9d1408-aae7-5398-85ba-a2c7f29a45d6-u04",
          "speaker_id": "b",
          "ja": "はい。青葉駅で降りてください。",
          "vi": "Đúng rồi. Chị xuống ở ga Aoba."
        },
        {
          "id": "ae9d1408-aae7-5398-85ba-a2c7f29a45d6-u05",
          "speaker_id": "a",
          "ja": "わかりました。青葉駅で降ります。",
          "vi": "Tôi hiểu rồi. Tôi sẽ xuống ở ga Aoba."
        }
      ],
      "admin": {
        "source_refs": [
          "b08_train",
          "b27_station"
