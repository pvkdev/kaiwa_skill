    {
      "situation_uid": "2f02b243-cae3-5107-bff3-aa7a1e38f18c",
      "event_id": "E01",
      "context_vi": "Bạn đang đứng trên một sân ga ở ga Aoba và muốn đến ga Sakura. Bạn chưa chắc đây có phải chiều đi đúng nên hỏi nhân viên.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "2f02b243-cae3-5107-bff3-aa7a1e38f18c-u01",
          "speaker_id": "a",
          "ja": "すみません、桜駅へ行きます。このホームでいいですか。",
          "vi": "Xin lỗi, tôi đi ga Sakura. Đứng sân ga này đúng không ạ?"
        },
        {
          "id": "2f02b243-cae3-5107-bff3-aa7a1e38f18c-u02",
          "speaker_id": "b",
          "ja": "いいえ、ここは反対方向です。",
          "vi": "Không, đây là chiều ngược lại."
        },
        {
          "id": "2f02b243-cae3-5107-bff3-aa7a1e38f18c-u03",
          "speaker_id": "a",
          "ja": "そうですか。どちらのホームですか。",
          "vi": "Vậy ạ. Sân ga nào mới đúng ạ?"
        },
        {
          "id": "2f02b243-cae3-5107-bff3-aa7a1e38f18c-u04",
          "speaker_id": "b",
          "ja": "向かいの２番線です。あちらのホームへどうぞ。",
          "vi": "Sân ga số 2 ở phía đối diện. Mời chị sang sân ga đó."
        },
        {
          "id": "2f02b243-cae3-5107-bff3-aa7a1e38f18c-u05",
          "speaker_id": "a",
          "ja": "向かいの２番線ですね。",
          "vi": "Sân ga số 2 phía đối diện ạ."
        }
      ],
      "admin": {
