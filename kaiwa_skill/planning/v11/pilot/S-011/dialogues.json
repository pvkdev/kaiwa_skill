    {
      "situation_uid": "52f40bb7-9557-5778-a222-b3e2006859b0",
      "event_id": "E02",
      "context_vi": "Bạn sắp lên một xe Toei Bus trong 23 quận Tokyo. Trước cửa xe, bạn hỏi lái xe lối lên và thời điểm trả tiền.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "lái xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "52f40bb7-9557-5778-a222-b3e2006859b0-u01",
          "speaker_id": "a",
          "ja": "すみません、どこから乗りますか。",
          "vi": "Xin lỗi, tôi lên xe từ cửa nào ạ?"
        },
        {
          "id": "52f40bb7-9557-5778-a222-b3e2006859b0-u02",
          "speaker_id": "b",
          "ja": "前のドアからどうぞ。",
          "vi": "Mời chị lên từ cửa trước."
        },
        {
          "id": "52f40bb7-9557-5778-a222-b3e2006859b0-u03",
          "speaker_id": "a",
          "ja": "お金はいつ払いますか。",
          "vi": "Tôi trả tiền lúc nào ạ?"
        },
        {
          "id": "52f40bb7-9557-5778-a222-b3e2006859b0-u04",
          "speaker_id": "b",
          "ja": "乗るときに払ってください。",
          "vi": "Chị trả lúc lên xe."
        },
        {
          "id": "52f40bb7-9557-5778-a222-b3e2006859b0-u05",
          "speaker_id": "a",
          "ja": "わかりました。ここで払います。",
          "vi": "Tôi hiểu rồi. Tôi trả ở đây ạ."
        }
      ],
