    {
      "situation_uid": "0c09f777-1f73-55e3-b5a5-c365485eb552",
      "event_id": "E02",
      "context_vi": "Khi xe buýt tạm dừng, bạn nhận ra đã qua bến Thư viện. Bạn hỏi lái xe bến tiếp theo có thể xuống để tìm đường quay lại.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "lái xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "0c09f777-1f73-55e3-b5a5-c365485eb552-u01",
          "speaker_id": "a",
          "ja": "すみません、図書館前を過ぎましたか。",
          "vi": "Xin lỗi, xe đã qua bến Thư viện chưa ạ?"
        },
        {
          "id": "0c09f777-1f73-55e3-b5a5-c365485eb552-u02",
          "speaker_id": "b",
          "ja": "はい、さっき通りました。",
          "vi": "Rồi, xe vừa đi qua."
        },
        {
          "id": "0c09f777-1f73-55e3-b5a5-c365485eb552-u03",
          "speaker_id": "a",
          "ja": "次はどこで降りられますか。",
          "vi": "Tôi có thể xuống ở bến nào tiếp theo ạ?"
        },
        {
          "id": "0c09f777-1f73-55e3-b5a5-c365485eb552-u04",
          "speaker_id": "b",
          "ja": "次の市民会館前で降りられます。",
          "vi": "Chị có thể xuống ở bến Hội trường Thành phố tiếp theo."
        },
        {
          "id": "0c09f777-1f73-55e3-b5a5-c365485eb552-u05",
          "speaker_id": "a",
          "ja": "市民会館前ですね。降りるボタンを押します。",
          "vi": "Bến Hội trường Thành phố ạ. Tôi sẽ bấm nút xuống xe."
        }
      ],
