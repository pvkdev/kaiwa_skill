    {
      "situation_uid": "add40c3f-065e-5f08-9731-8961e5ccf623",
      "event_id": "E03",
      "context_vi": "Ở ga, bạn đi cùng mẹ, người khó leo cầu thang. Sau khi nói lý do cần thang máy, bạn chỉ vào lối đi gần đó để hỏi nhân viên.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "add40c3f-065e-5f08-9731-8961e5ccf623-u01",
          "speaker_id": "a",
          "ja": "すみません、母は階段がつらいんです。",
          "vi": "Xin lỗi, mẹ tôi đi cầu thang rất khó khăn ạ."
        },
        {
          "id": "add40c3f-065e-5f08-9731-8961e5ccf623-u02",
          "speaker_id": "b",
          "ja": "エレベーターをご案内します。",
          "vi": "Tôi sẽ chỉ lối thang máy."
        },
        {
          "id": "add40c3f-065e-5f08-9731-8961e5ccf623-u03",
          "speaker_id": "a",
          "ja": "こちらから行けますか。",
          "vi": "Chúng tôi đi lối này được không ạ?"
        },
        {
          "id": "add40c3f-065e-5f08-9731-8961e5ccf623-u04",
          "speaker_id": "b",
          "ja": "こちらの通路をまっすぐです。突き当たりを左です。",
          "vi": "Đi thẳng lối này. Đến cuối hành lang thì rẽ trái."
        },
        {
          "id": "add40c3f-065e-5f08-9731-8961e5ccf623-u05",
          "speaker_id": "a",
          "ja": "突き当たりを左ですね。ありがとうございます。",
          "vi": "Đến cuối hành lang rẽ trái ạ. Cảm ơn anh."
        }
      ],
