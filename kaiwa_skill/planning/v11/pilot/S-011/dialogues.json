    {
      "situation_uid": "14c7db18-06fa-519f-9b65-1872108db28d",
      "event_id": "E03",
      "context_vi": "Bạn và mẹ đang chờ cạnh cổng soát vé theo lời dặn. Nhân viên vừa quay lại sau khi liên hệ ga Aoba.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "14c7db18-06fa-519f-9b65-1872108db28d-u01",
          "speaker_id": "b",
          "ja": "青葉駅に確認しました。駅員がホームのエレベーター前で待ちます。",
          "vi": "Tôi đã xác nhận với ga Aoba. Nhân viên sẽ đợi trước thang máy ở sân ga."
        },
        {
          "id": "14c7db18-06fa-519f-9b65-1872108db28d-u02",
          "speaker_id": "a",
          "ja": "ホームのエレベーター前ですね。",
          "vi": "Trước thang máy ở sân ga ạ?"
        },
        {
          "id": "14c7db18-06fa-519f-9b65-1872108db28d-u03",
          "speaker_id": "b",
          "ja": "はい。降りたら、そこへ行ってください。",
          "vi": "Vâng. Xuống tàu rồi xin đến đó."
        },
        {
          "id": "14c7db18-06fa-519f-9b65-1872108db28d-u04",
          "speaker_id": "a",
          "ja": "わかりました。母とそこへ行きます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ cùng mẹ đến đó."
        },
        {
          "id": "14c7db18-06fa-519f-9b65-1872108db28d-u05",
          "speaker_id": "b",
          "ja": "お気をつけて。",
          "vi": "Chúc hai người đi an toàn."
        }
      ],
