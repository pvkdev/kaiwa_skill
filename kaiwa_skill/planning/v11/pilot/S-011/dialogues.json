    {
      "situation_uid": "25ad555b-8021-5d65-8c3b-e53b723c403a",
      "event_id": "E02",
      "context_vi": "Ở trạm xe buýt, bạn muốn đến thư viện. Trước khi lên, hỏi lái xe xem xe này có dừng ở bến gần thư viện không.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "lái xe",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "25ad555b-8021-5d65-8c3b-e53b723c403a-u01",
          "speaker_id": "a",
          "ja": "すみません、このバスは図書館前に止まりますか。",
          "vi": "Xin lỗi, xe này có dừng ở bến Thư viện không ạ?"
        },
        {
          "id": "25ad555b-8021-5d65-8c3b-e53b723c403a-u02",
          "speaker_id": "b",
          "ja": "はい、止まります。",
          "vi": "Có, xe có dừng."
        },
        {
          "id": "25ad555b-8021-5d65-8c3b-e53b723c403a-u03",
          "speaker_id": "a",
          "ja": "ここからいくつ目ですか。",
          "vi": "Từ đây là bến thứ mấy ạ?"
        },
        {
          "id": "25ad555b-8021-5d65-8c3b-e53b723c403a-u04",
          "speaker_id": "b",
          "ja": "ここから三つ目です。",
          "vi": "Từ đây là bến thứ ba."
        },
        {
          "id": "25ad555b-8021-5d65-8c3b-e53b723c403a-u05",
          "speaker_id": "a",
          "ja": "三つ目ですね。ありがとうございます。",
          "vi": "Bến thứ ba ạ. Cảm ơn anh."
        }
      ],
