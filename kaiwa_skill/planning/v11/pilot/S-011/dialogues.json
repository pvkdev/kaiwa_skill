    {
      "situation_uid": "ef5dae70-6a18-50f5-a57c-0fb6506894dc",
      "event_id": "E03",
      "context_vi": "Ở ga xuất phát, bạn đi cùng mẹ, người khó đi cầu thang. Bạn sắp đổi tàu ở ga Aoba và muốn nhờ nhân viên hướng dẫn việc chuyển ga.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "ef5dae70-6a18-50f5-a57c-0fb6506894dc-u01",
          "speaker_id": "a",
          "ja": "青葉駅で乗り換えます。母は階段がつらいんです。",
          "vi": "Chúng tôi đổi tàu ở ga Aoba. Mẹ tôi đi cầu thang khó khăn ạ."
        },
        {
          "id": "ef5dae70-6a18-50f5-a57c-0fb6506894dc-u02",
          "speaker_id": "b",
          "ja": "青葉駅でのご案内を確認します。少しお待ちください。",
          "vi": "Tôi sẽ kiểm tra việc hỗ trợ ở ga Aoba. Xin chờ một chút."
        },
        {
          "id": "ef5dae70-6a18-50f5-a57c-0fb6506894dc-u03",
          "speaker_id": "a",
          "ja": "どこで待てばいいですか。",
          "vi": "Chúng tôi nên chờ ở đâu ạ?"
        },
        {
          "id": "ef5dae70-6a18-50f5-a57c-0fb6506894dc-u04",
          "speaker_id": "b",
          "ja": "この改札の横でお待ちください。",
          "vi": "Xin chờ cạnh cổng soát vé này."
        },
        {
          "id": "ef5dae70-6a18-50f5-a57c-0fb6506894dc-u05",
          "speaker_id": "a",
          "ja": "改札の横ですね。ここで待ちます。",
          "vi": "Cạnh cổng soát vé ạ. Chúng tôi sẽ chờ ở đây."
        }
      ],
