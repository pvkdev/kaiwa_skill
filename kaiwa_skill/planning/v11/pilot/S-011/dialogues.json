    {
      "situation_uid": "c86d5282-a8f9-5db3-9a55-2ded9d0541b0",
      "event_id": "E01",
      "context_vi": "Bạn vừa xuống ở ga Aoba để đổi tàu đi ga Sakura. Bạn hỏi nhân viên lối đến sân ga của chuyến tiếp theo.",
      "speakers": [
        {
          "id": "a",
          "role_vi": "người học",
          "gender": "female"
        },
        {
          "id": "b",
          "role_vi": "nhân viên ga",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c86d5282-a8f9-5db3-9a55-2ded9d0541b0-u01",
          "speaker_id": "a",
          "ja": "すみません、桜駅へ行く電車はどちらですか。",
          "vi": "Xin lỗi, tàu đi ga Sakura ở phía nào ạ?"
        },
        {
          "id": "c86d5282-a8f9-5db3-9a55-2ded9d0541b0-u02",
          "speaker_id": "b",
          "ja": "２番線です。あちらの階段を上がってください。",
          "vi": "Ở sân ga số 2. Chị lên cầu thang phía kia."
        },
        {
          "id": "c86d5282-a8f9-5db3-9a55-2ded9d0541b0-u03",
          "speaker_id": "a",
          "ja": "２番線ですね。こちらの階段ですか。",
          "vi": "Sân ga số 2 ạ. Cầu thang này phải không ạ?"
        },
        {
          "id": "c86d5282-a8f9-5db3-9a55-2ded9d0541b0-u04",
          "speaker_id": "b",
          "ja": "いいえ、その先の階段です。",
          "vi": "Không, cầu thang phía trước nữa."
        },
        {
          "id": "c86d5282-a8f9-5db3-9a55-2ded9d0541b0-u05",
          "speaker_id": "a",
          "ja": "あ、あちらですね。ありがとうございます。",
          "vi": "À, phía kia ạ. Cảm ơn anh."
        }
      ],
      "admin": {
        "source_refs": [
          "b08_train",
          "b27_station",
          "w_metro"
        ],
        "specialty_item_ids": [
          "sj-so-03-b18-13"
