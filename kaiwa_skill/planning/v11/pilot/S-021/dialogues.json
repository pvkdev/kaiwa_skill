    {
      "situation_uid": "7d01ae36-779a-58c2-ba0a-ee3cee160048",
      "event_id": "E03",
      "context_vi": "Giấy trắng đã được mang tới. Nhân viên báo với trưởng nhóm, xác nhận có thể tiếp tục in 12 bộ tài liệu.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "7d01ae36-779a-58c2-ba0a-ee3cee160048-u01",
          "speaker_id": "N",
          "ja": "白い紙が来ました。印刷を始めてもいいですか。",
          "vi": "Giấy trắng đã đến. Tôi bắt đầu in được chưa ạ?"
        },
        {
          "id": "7d01ae36-779a-58c2-ba0a-ee3cee160048-u02",
          "speaker_id": "L",
          "ja": "はい。十二部お願いします。",
          "vi": "Được. In mười hai bộ nhé."
        },
        {
          "id": "7d01ae36-779a-58c2-ba0a-ee3cee160048-u03",
          "speaker_id": "N",
          "ja": "十二部ですね。まず一部、印刷して見てみます。",
          "vi": "Mười hai bộ ạ. Trước tiên tôi sẽ in một bộ rồi xem thử."
        },
        {
          "id": "7d01ae36-779a-58c2-ba0a-ee3cee160048-u04",
          "speaker_id": "L",
          "ja": "はい。確認してから、残りを印刷してください。",
          "vi": "Đúng rồi. Kiểm tra xong rồi in số còn lại nhé."
        }
      ],
