          },
          "f15ff307-cf0d-59e8-a052-b0dc8172f52d-u04": {
            "kind": "original_extension"
          }
        }
      }
    },
    {
      "situation_uid": "9308b68b-93de-5888-b638-2e1adfcaa860",
      "event_id": "E02",
      "context_vi": "Sau khi trực tiếp hỏi trưởng nhóm, đồng nghiệp quay lại trả lời. Nhân viên cần nói lại chính xác cách sẽ sửa.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "D",
          "role_vi": "Đồng nghiệp hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "9308b68b-93de-5888-b638-2e1adfcaa860-u01",
          "speaker_id": "D",
          "ja": "リーダーに聞きました。三ページ目だけです。",
          "vi": "Tôi đã hỏi trưởng nhóm rồi. Chỉ trang ba thôi."
        },
        {
          "id": "9308b68b-93de-5888-b638-2e1adfcaa860-u02",
          "speaker_id": "N",
          "ja": "三ページ目の古いページを取りますね。",
          "vi": "Vậy tôi lấy trang ba bản cũ ra, đúng không ạ?"
        },
        {
          "id": "9308b68b-93de-5888-b638-2e1adfcaa860-u03",
          "speaker_id": "D",
          "ja": "はい。新しい三ページ目を入れてください。",
          "vi": "Đúng. Hãy thay bằng trang ba bản mới."
        },
        {
          "id": "9308b68b-93de-5888-b638-2e1adfcaa860-u04",
          "speaker_id": "N",
          "ja": "はい。ほかのページはそのままにします。",
          "vi": "Vâng. Các trang khác tôi giữ nguyên."
        },
        {
          "id": "9308b68b-93de-5888-b638-2e1adfcaa860-u05",
          "speaker_id": "D",
          "ja": "それで大丈夫です。",
          "vi": "Làm vậy là được."
        }
      ],
      "admin": {
        "source_refs": [
          "b03_instruction",
          "b02_rephrase"
        ],
        "specialty_item_ids": [
          "sj-so-05-b07-82"
        ],
        "turn_origins": {
          "9308b68b-93de-5888-b638-2e1adfcaa860-u01": {
