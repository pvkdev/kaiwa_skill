    {
      "situation_uid": "62c336f1-3825-548b-a6b3-e76301e3c60c",
      "event_id": "E03",
      "context_vi": "Khi chuẩn bị in bộ tài liệu, nhân viên thấy khay chỉ có giấy xanh dù trưởng nhóm dặn dùng giấy trắng. Cô báo ngay, chưa tự ý in.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "62c336f1-3825-548b-a6b3-e76301e3c60c-u01",
          "speaker_id": "N",
          "ja": "すみません。白い紙がありません。青い紙だけです。",
          "vi": "Xin lỗi ạ. Không còn giấy trắng, chỉ có giấy xanh."
        },
        {
          "id": "62c336f1-3825-548b-a6b3-e76301e3c60c-u02",
          "speaker_id": "L",
          "ja": "そうですか。まだ印刷していませんね。",
          "vi": "Vậy à. Cô chưa in chứ?"
        },
        {
          "id": "62c336f1-3825-548b-a6b3-e76301e3c60c-u03",
          "speaker_id": "N",
          "ja": "はい。まだ印刷していません。どうしますか。",
          "vi": "Vâng, tôi chưa in. Giờ làm thế nào ạ?"
        },
        {
          "id": "62c336f1-3825-548b-a6b3-e76301e3c60c-u04",
          "speaker_id": "L",
          "ja": "少し待ってください。紙を確認します。",
          "vi": "Chờ một chút nhé. Tôi sẽ kiểm tra giấy."
        }
      ],
      "admin": {
