    {
      "situation_uid": "c54ebfbd-fbc8-5d34-a894-3a98f4a5155f",
      "event_id": "E02",
      "context_vi": "Hai đồng nghiệp đã dặn khác nhau về cách kẹp bộ tài liệu. Nhân viên hỏi đồng nghiệp hướng dẫn ai có quyền quyết định bản cuối.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "D",
          "role_vi": "Đồng nghiệp hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c54ebfbd-fbc8-5d34-a894-3a98f4a5155f-u01",
          "speaker_id": "N",
          "ja": "クリップで留めると聞きました。",
          "vi": "Tôi được dặn dùng kẹp giấy."
        },
        {
          "id": "c54ebfbd-fbc8-5d34-a894-3a98f4a5155f-u02",
          "speaker_id": "D",
          "ja": "そうですか。",
          "vi": "Vậy à."
        },
        {
          "id": "c54ebfbd-fbc8-5d34-a894-3a98f4a5155f-u03",
          "speaker_id": "N",
          "ja": "でも、別の人はホチキスと言っています。だれに確認しますか。",
          "vi": "Nhưng một người khác lại dặn bấm ghim. Tôi xác nhận với ai ạ?"
        },
        {
          "id": "c54ebfbd-fbc8-5d34-a894-3a98f4a5155f-u04",
          "speaker_id": "D",
          "ja": "この資料の担当はリーダーです。リーダーに聞いてください。",
          "vi": "Trưởng nhóm phụ trách tài liệu này. Cô hãy hỏi trưởng nhóm."
        },
        {
          "id": "c54ebfbd-fbc8-5d34-a894-3a98f4a5155f-u05",
          "speaker_id": "N",
          "ja": "分かりました。このままにして、リーダーに聞きます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ để nguyên như thế và hỏi trưởng nhóm."
        },
        {
          "id": "c54ebfbd-fbc8-5d34-a894-3a98f4a5155f-u06",
          "speaker_id": "D",
          "ja": "はい。そのほうがいいです。",
          "vi": "Ừ, như vậy tốt hơn."
        }
      ],
      "admin": {
