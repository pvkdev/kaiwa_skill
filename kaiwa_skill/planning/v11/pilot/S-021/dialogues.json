          }
        }
      }
    },
    {
      "situation_uid": "55762402-82b6-5b2e-bce0-4057fa70ce99",
      "event_id": "E01",
      "context_vi": "Trưởng nhóm giao làm tài liệu cho buổi đào tạo. Nhân viên đang có mẫu cũ và hỏi liệu có thể dùng lại không.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "55762402-82b6-5b2e-bce0-4057fa70ce99-u01",
          "speaker_id": "N",
          "ja": "前の資料の見本を使ってもいいですか。",
          "vi": "Tôi dùng mẫu tài liệu lần trước được không ạ?"
        },
        {
          "id": "55762402-82b6-5b2e-bce0-4057fa70ce99-u02",
          "speaker_id": "L",
          "ja": "はい。でも、全部は使わないでください。",
          "vi": "Được. Nhưng đừng dùng toàn bộ nhé."
        },
        {
          "id": "55762402-82b6-5b2e-bce0-4057fa70ce99-u03",
          "speaker_id": "N",
          "ja": "どの部分を使いますか。",
          "vi": "Tôi dùng phần nào ạ?"
        },
        {
          "id": "55762402-82b6-5b2e-bce0-4057fa70ce99-u04",
          "speaker_id": "L",
          "ja": "表紙の形だけです。中身は新しくしてください。",
          "vi": "Chỉ dùng bố cục trang bìa. Nội dung bên trong làm mới nhé."
        },
        {
          "id": "55762402-82b6-5b2e-bce0-4057fa70ce99-u05",
          "speaker_id": "N",
          "ja": "表紙の形だけですね。わかりました。",
          "vi": "Chỉ bố cục bìa thôi ạ. Tôi hiểu rồi."
        }
      ],
      "admin": {
        "source_refs": [
          "b03_instruction",
          "b02_rephrase"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "55762402-82b6-5b2e-bce0-4057fa70ce99-u01": {
