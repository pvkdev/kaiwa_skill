    {
      "situation_uid": "25fa54cd-46a6-5b61-b7a1-be6c9f31a30b",
      "event_id": "E02",
      "context_vi": "Ở bàn làm việc, nhân viên hỏi đồng nghiệp hướng dẫn về từ 差し替える trong chỉ thị chỉnh tài liệu. Cô muốn biết mình phải làm gì.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "D",
          "role_vi": "Đồng nghiệp hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "25fa54cd-46a6-5b61-b7a1-be6c9f31a30b-u01",
          "speaker_id": "N",
          "ja": "「差し替える」が分かりません。どういう意味ですか。",
          "vi": "Tôi chưa hiểu “thay trang”. Từ đó nghĩa là gì ạ?"
        },
        {
          "id": "25fa54cd-46a6-5b61-b7a1-be6c9f31a30b-u02",
          "speaker_id": "D",
          "ja": "古いページを取って、新しいページを入れることです。",
          "vi": "Lấy trang cũ ra, rồi đưa trang mới vào."
        },
        {
          "id": "25fa54cd-46a6-5b61-b7a1-be6c9f31a30b-u03",
          "speaker_id": "N",
          "ja": "分かりました。どのページですか。",
          "vi": "Tôi hiểu rồi. Là trang nào ạ?"
        },
        {
          "id": "25fa54cd-46a6-5b61-b7a1-be6c9f31a30b-u04",
          "speaker_id": "D",
          "ja": "三ページ目だと思います。でも、確認しますね。",
          "vi": "Tôi nghĩ là trang ba. Nhưng để tôi kiểm tra lại nhé."
        },
        {
          "id": "25fa54cd-46a6-5b61-b7a1-be6c9f31a30b-u05",
          "speaker_id": "N",
          "ja": "はい。確認をお願いします。",
          "vi": "Vâng, nhờ anh kiểm tra giúp."
        }
      ],
      "admin": {
        "source_refs": [
          "b03_instruction",
          "b02_rephrase"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "25fa54cd-46a6-5b61-b7a1-be6c9f31a30b-u01": {
