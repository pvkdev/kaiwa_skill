    {
      "situation_uid": "123542f0-6256-5cc3-8b46-c32c117ab32e",
      "event_id": "E03",
      "context_vi": "Sau khi đề nghị dùng giấy màu kem, nhân viên chờ trưởng nhóm quay lại với quyết định. Cô cũng muốn biết mình có thể làm gì trong lúc chưa in được.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "123542f0-6256-5cc3-8b46-c32c117ab32e-u01",
          "speaker_id": "L",
          "ja": "ベージュの紙は使わないでください。白い紙を待ちましょう。",
          "vi": "Đừng dùng giấy màu kem. Ta chờ giấy trắng nhé."
        },
        {
          "id": "123542f0-6256-5cc3-8b46-c32c117ab32e-u02",
          "speaker_id": "N",
          "ja": "分かりました。待つ間に、何をしますか。",
          "vi": "Vâng. Trong lúc chờ, tôi làm gì trước ạ?"
        },
        {
          "id": "123542f0-6256-5cc3-8b46-c32c117ab32e-u03",
          "speaker_id": "L",
          "ja": "先に、資料の順番を確認してください。",
          "vi": "Trước hết hãy kiểm tra thứ tự các trang tài liệu."
        },
        {
          "id": "123542f0-6256-5cc3-8b46-c32c117ab32e-u04",
          "speaker_id": "N",
          "ja": "はい。順番を確認して、印刷は待ちます。",
          "vi": "Vâng. Tôi kiểm tra thứ tự trang, còn việc in thì chờ."
        }
      ],
      "admin": {
