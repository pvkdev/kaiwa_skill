    {
      "situation_uid": "725e1d3b-371c-5c87-8d9b-46a33f8ffed3",
      "event_id": "E04",
      "context_vi": "Nhân viên đã bổ sung trang ba vào bộ bị thiếu. Cô xin trưởng nhóm kiểm lại chính bộ vừa sửa trước khi giao đi.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "725e1d3b-371c-5c87-8d9b-46a33f8ffed3-u01",
          "speaker_id": "N",
          "ja": "足りなかった三ページ目を入れました。",
          "vi": "Tôi đã bổ sung trang ba bị thiếu rồi ạ."
        },
        {
          "id": "725e1d3b-371c-5c87-8d9b-46a33f8ffed3-u02",
          "speaker_id": "L",
          "ja": "ありがとうございます。十二部、そろいましたか。",
          "vi": "Cảm ơn cô. Đủ cả mười hai bộ chưa?"
        },
        {
          "id": "725e1d3b-371c-5c87-8d9b-46a33f8ffed3-u03",
          "speaker_id": "N",
          "ja": "はい。十二部あります。この一部をもう一度見ていただけますか。",
          "vi": "Vâng, có đủ mười hai bộ. Anh xem lại bộ này giúp tôi được không ạ?"
        },
        {
          "id": "725e1d3b-371c-5c87-8d9b-46a33f8ffed3-u04",
          "speaker_id": "L",
          "ja": "はい。三ページ目もありますね。これで大丈夫です。",
