    {
      "situation_uid": "8b6b9c26-9552-5d9a-a82b-95e66095afd6",
      "event_id": "E04",
      "context_vi": "Sau khi báo đã xếp xong 12 bộ nhưng trước khi trưởng nhóm xem, nhân viên kiểm lại và phát hiện một bộ thiếu trang ba. Cô báo ngay để chưa bàn giao như bản đủ.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "8b6b9c26-9552-5d9a-a82b-95e66095afd6-u01",
          "speaker_id": "N",
          "ja": "すみません。確認したら、一部だけ三ページ目がありません。",
          "vi": "Xin lỗi ạ. Tôi kiểm lại thì có một bộ thiếu trang ba."
        },
        {
          "id": "8b6b9c26-9552-5d9a-a82b-95e66095afd6-u02",
          "speaker_id": "L",
          "ja": "分かりました。今、その一部は渡さないでください。",
          "vi": "Tôi hiểu rồi. Bây giờ đừng đưa bộ đó đi nhé."
        },
        {
          "id": "8b6b9c26-9552-5d9a-a82b-95e66095afd6-u03",
          "speaker_id": "N",
          "ja": "はい。三ページ目を入れてから、また報告します。",
          "vi": "Vâng. Tôi sẽ bổ sung trang ba rồi báo lại."
        },
        {
          "id": "8b6b9c26-9552-5d9a-a82b-95e66095afd6-u04",
          "speaker_id": "L",
          "ja": "お願いします。",
          "vi": "Nhờ cô nhé."
        }
      ],
