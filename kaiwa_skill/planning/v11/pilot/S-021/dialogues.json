  "dialogues": [
    {
      "situation_uid": "b58df347-1426-52c3-9a69-0a0b55b64d27",
      "event_id": "E01",
      "context_vi": "Ở văn phòng, trưởng nhóm giao cho nhân viên chuẩn bị tài liệu buổi đào tạo. Nhân viên cần nhắc lại tên việc và hạn trước khi bắt đầu.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b58df347-1426-52c3-9a69-0a0b55b64d27-u01",
          "speaker_id": "L",
          "ja": "今日の研修の資料を用意してください。",
          "vi": "Hãy chuẩn bị tài liệu cho buổi đào tạo hôm nay."
        },
        {
          "id": "b58df347-1426-52c3-9a69-0a0b55b64d27-u02",
          "speaker_id": "N",
          "ja": "はい。いつまでですか。",
          "vi": "Vâng ạ. Hạn đến khi nào ạ?"
        },
        {
          "id": "b58df347-1426-52c3-9a69-0a0b55b64d27-u03",
          "speaker_id": "L",
          "ja": "午後三時までにお願いします。",
          "vi": "Chậm nhất ba giờ chiều nhé."
        },
        {
          "id": "b58df347-1426-52c3-9a69-0a0b55b64d27-u04",
          "speaker_id": "N",
          "ja": "研修の資料を、今日の三時までですね。",
          "vi": "Tài liệu buổi đào tạo, chậm nhất ba giờ chiều nay, đúng không ạ?"
        },
        {
          "id": "b58df347-1426-52c3-9a69-0a0b55b64d27-u05",
          "speaker_id": "L",
          "ja": "そうです。お願いします。",
          "vi": "Đúng rồi. Nhờ cô nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "b03_instruction",
          "b10_confirm"
        ],
        "specialty_item_ids": [
          "sj-so-05-b07-82"
