    {
      "situation_uid": "1c6e544c-37e7-5d86-8375-49dcd177a197",
      "event_id": "E01",
      "context_vi": "Tiếp sau khi nghe hạn giao, nhân viên không nghe rõ số bộ trưởng nhóm vừa nói nên ghi chú phân vân giữa 12 và 20. Cô hỏi lại trước khi in.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "1c6e544c-37e7-5d86-8375-49dcd177a197-u01",
          "speaker_id": "N",
          "ja": "すみません。十二部ですか、二十部ですか。",
          "vi": "Xin lỗi ạ. Mười hai bộ hay hai mươi bộ ạ?"
        },
        {
          "id": "1c6e544c-37e7-5d86-8375-49dcd177a197-u02",
          "speaker_id": "L",
          "ja": "十二部です。",
          "vi": "Mười hai bộ."
        },
        {
          "id": "1c6e544c-37e7-5d86-8375-49dcd177a197-u03",
          "speaker_id": "N",
          "ja": "十二部ですね。書き直します。",
          "vi": "Mười hai bộ ạ. Tôi sẽ sửa lại ghi chú."
        },
        {
          "id": "1c6e544c-37e7-5d86-8375-49dcd177a197-u04",
          "speaker_id": "L",
          "ja": "はい。それでお願いします。",
          "vi": "Vâng, cứ làm như thế nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "b03_instruction"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "1c6e544c-37e7-5d86-8375-49dcd177a197-u01": {
