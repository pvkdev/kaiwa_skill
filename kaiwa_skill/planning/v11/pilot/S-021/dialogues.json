    {
      "situation_uid": "50c84cf1-41f1-58a6-9da7-8a8cab88321d",
      "event_id": "E03",
      "context_vi": "Sau khi báo thiếu giấy trắng, nhân viên tìm thấy giấy màu kem. Cô đề nghị dùng thay và chờ trưởng nhóm quyết định.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "50c84cf1-41f1-58a6-9da7-8a8cab88321d-u01",
          "speaker_id": "N",
          "ja": "ベージュの紙があります。これを使ってもいいですか。",
          "vi": "Có giấy màu kem. Tôi dùng giấy này được không ạ?"
        },
        {
          "id": "50c84cf1-41f1-58a6-9da7-8a8cab88321d-u02",
          "speaker_id": "L",
          "ja": "まだ使わないでください。確認します。",
          "vi": "Cô chưa dùng nhé. Để tôi kiểm tra."
        },
        {
          "id": "50c84cf1-41f1-58a6-9da7-8a8cab88321d-u03",
          "speaker_id": "N",
          "ja": "分かりました。返事を待ちます。",
          "vi": "Tôi hiểu rồi. Tôi sẽ đợi câu trả lời."
        },
        {
          "id": "50c84cf1-41f1-58a6-9da7-8a8cab88321d-u04",
          "speaker_id": "L",
          "ja": "すぐに伝えます。",
          "vi": "Tôi sẽ báo ngay."
        }
      ],
      "admin": {
