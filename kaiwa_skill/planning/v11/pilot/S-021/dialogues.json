    {
      "situation_uid": "b0f1ca82-9d45-574d-82f4-4b2214609224",
      "event_id": "E04",
      "context_vi": "Nhân viên vừa xếp xong 12 bộ tài liệu in bằng giấy trắng, đặt ở bàn cạnh trưởng nhóm. Cô báo xong và nêu vị trí để trưởng nhóm biết nơi lấy.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "b0f1ca82-9d45-574d-82f4-4b2214609224-u01",
          "speaker_id": "N",
          "ja": "研修の資料、十二部できました。",
          "vi": "Mười hai bộ tài liệu đào tạo đã xong ạ."
        },
        {
          "id": "b0f1ca82-9d45-574d-82f4-4b2214609224-u02",
          "speaker_id": "L",
          "ja": "ありがとうございます。どこにありますか。",
          "vi": "Cảm ơn cô. Tài liệu ở đâu vậy?"
        },
        {
          "id": "b0f1ca82-9d45-574d-82f4-4b2214609224-u03",
          "speaker_id": "N",
          "ja": "こちらの机の上です。",
          "vi": "Ở trên bàn này ạ."
        },
        {
          "id": "b0f1ca82-9d45-574d-82f4-4b2214609224-u04",
          "speaker_id": "L",
          "ja": "分かりました。あとで中を見ます。",
          "vi": "Tôi rõ rồi. Lát nữa tôi sẽ xem bên trong."
        }
      ],
      "admin": {
