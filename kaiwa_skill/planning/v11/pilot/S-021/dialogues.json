          }
        }
      }
    },
    {
      "situation_uid": "f15ff307-cf0d-59e8-a052-b0dc8172f52d",
      "event_id": "E02",
      "context_vi": "Tiếp cuộc hỏi nghĩa “thay trang”, đồng nghiệp chưa chắc có phải chỉ trang ba. Nhân viên cần chốt người sẽ xác nhận với trưởng nhóm.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "D",
          "role_vi": "Đồng nghiệp hướng dẫn",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "f15ff307-cf0d-59e8-a052-b0dc8172f52d-u01",
          "speaker_id": "D",
          "ja": "三ページ目だけか、まだ分かりません。",
          "vi": "Tôi vẫn chưa rõ có phải chỉ trang ba không."
        },
        {
          "id": "f15ff307-cf0d-59e8-a052-b0dc8172f52d-u02",
          "speaker_id": "N",
          "ja": "だれに聞けばいいですか。",
          "vi": "Tôi nên hỏi ai ạ?"
        },
        {
          "id": "f15ff307-cf0d-59e8-a052-b0dc8172f52d-u03",
          "speaker_id": "D",
          "ja": "私がリーダーに聞きます。少し待ってください。",
          "vi": "Tôi sẽ hỏi trưởng nhóm. Cô chờ một chút nhé."
        },
        {
          "id": "f15ff307-cf0d-59e8-a052-b0dc8172f52d-u04",
          "speaker_id": "N",
          "ja": "ありがとうございます。返事を待ってから直します。",
          "vi": "Cảm ơn anh. Tôi sẽ đợi câu trả lời rồi mới sửa."
        }
      ],
      "admin": {
        "source_refs": [
          "b03_instruction"
        ],
        "specialty_item_ids": [],
        "turn_origins": {
          "f15ff307-cf0d-59e8-a052-b0dc8172f52d-u01": {
            "kind": "original_extension"
