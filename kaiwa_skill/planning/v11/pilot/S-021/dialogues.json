        }
      }
    },
    {
      "situation_uid": "c9b62a8f-9cd7-501b-8680-d8479ce246fd",
      "event_id": "E01",
      "context_vi": "Tiếp lời dặn về mẫu cũ, nhân viên xác nhận giới hạn trước khi bắt tay sửa tài liệu.",
      "speakers": [
        {
          "id": "N",
          "role_vi": "Nhân viên",
          "gender": "female"
        },
        {
          "id": "L",
          "role_vi": "Trưởng nhóm",
          "gender": "male"
        }
      ],
      "turns": [
        {
          "id": "c9b62a8f-9cd7-501b-8680-d8479ce246fd-u01",
          "speaker_id": "N",
          "ja": "確認します。前の見本は表紙の形だけ使いますね。",
          "vi": "Cho tôi xác nhận ạ. Tôi chỉ dùng bố cục bìa của mẫu trước, đúng không ạ?"
        },
        {
          "id": "c9b62a8f-9cd7-501b-8680-d8479ce246fd-u02",
          "speaker_id": "L",
          "ja": "はい。本文は今回の内容にしてください。",
          "vi": "Đúng. Phần nội dung hãy dùng nội dung của lần này."
        },
        {
          "id": "c9b62a8f-9cd7-501b-8680-d8479ce246fd-u03",
          "speaker_id": "N",
          "ja": "はい。本文は新しく作ります。",
          "vi": "Vâng. Tôi sẽ làm mới phần nội dung."
        },
        {
          "id": "c9b62a8f-9cd7-501b-8680-d8479ce246fd-u04",
          "speaker_id": "L",
          "ja": "お願いします。",
          "vi": "Nhờ cô nhé."
        }
      ],
      "admin": {
        "source_refs": [
          "b02_rephrase"
        ],
        "specialty_item_ids": [
          "sj-so-05-b07-82"
        ],
