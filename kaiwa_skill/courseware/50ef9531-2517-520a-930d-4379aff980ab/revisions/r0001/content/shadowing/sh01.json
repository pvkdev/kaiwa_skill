  "items": [
    {
      "id": "sj09-d01",
      "kind": "dialogue",
      "example_id": "sj09-u01",
      "speakers": [
        {
          "id": "A",
          "role": "Người mở lời"
        },
        {
          "id": "B",
          "role": "Người đáp"
        }
      ],
      "turns": [
        {
          "id": "sh01--sj09-d01--t01",
          "speaker": "A",
          "ja": "ちょっと聞いてくれる？ もう、頭に来ちゃった。",
          "vi": "Nghe tớ nói một chút được không? Tớ bực quá rồi."
        },
        {
          "id": "sh01--sj09-d01--t02",
          "speaker": "B",
          "ja": "どうしたの、いったい？",
          "vi": "Rốt cuộc có chuyện gì vậy?"
        }
      ],
      "authorship": "source_quote"
    },
    {
      "id": "sj09-d02",
      "kind": "dialogue",
      "example_id": "sj09-u03",
      "speakers": [
        {
          "id": "A",
          "role": "Người mở lời"
        },
        {
          "id": "B",
          "role": "Người đáp"
        }
      ],
      "turns": [
        {
          "id": "sh01--sj09-d02--t01",
          "speaker": "A",
          "ja": "ぼくの言うこと、わかってくれるよね？",
          "vi": "Cậu hiểu ý tớ chứ?"
        },
        {
          "id": "sh01--sj09-d02--t02",
          "speaker": "B",
          "ja": "もちろん、わかるよ。",
          "vi": "Tất nhiên là hiểu."
        }
      ],
      "authorship": "source_quote"
    },
    {
      "id": "sj09-d03",
      "kind": "dialogue",
      "example_id": "sj09-u05",
      "speakers": [
        {
          "id": "A",
          "role": "Người mở lời"
        },
        {
          "id": "B",
          "role": "Người đáp"
        }
      ],
      "turns": [
        {
          "id": "sh01--sj09-d03--t01",
          "speaker": "A",
          "ja": "じゃ、私、買ってくるから、席とってもらえる？",
          "vi": "Thế tớ đi mua, cậu giữ chỗ giúp tớ được không?"
        },
        {
          "id": "sh01--sj09-d03--t02",
          "speaker": "B",
          "ja": "わかった。じゃ、ぼくはコーヒーね。",
          "vi": "Được. Thế mua cà phê cho tớ nhé."
        }
      ],
      "authorship": "source_quote"
    },
    {
      "id": "sj09-d04",
      "kind": "dialogue",
      "example_id": "sj09-u07",
      "speakers": [
        {
          "id": "A",
          "role": "Người mở lời"
        },
        {
          "id": "B",
          "role": "Người đáp"
        }
      ],
      "turns": [
        {
          "id": "sh01--sj09-d04--t01",
          "speaker": "A",
          "ja": "社長はいちいち口をはさんでくるから困るよね。",
          "vi": "Giám đốc cứ xen vào từng việc nhỏ, khó xử thật nhỉ."
        },
        {
          "id": "sh01--sj09-d04--t02",
          "speaker": "B",
          "ja": "ほんと。こっちに任せてくれればいいのに。",
          "vi": "Đúng đấy. Giá mà ông ấy để bọn mình tự lo."
        }
      ],
      "authorship": "source_quote"
    },
    {
      "id": "sj09-d05",
      "kind": "dialogue",
      "example_id": "sj09-u09",
      "speakers": [
        {
          "id": "A",
          "role": "Người mở lời"
        },
        {
          "id": "B",
          "role": "Người đáp"
        }
      ],
      "turns": [
        {
          "id": "sh01--sj09-d05--t01",
          "speaker": "A",
          "ja": "もうちょっとそっちに寄ってもらえない？ 狭くて。",
          "vi": "Cậu dịch sang bên đó thêm một chút được không? Chật quá."
        },
        {
          "id": "sh01--sj09-d05--t02",
          "speaker": "B",
          "ja": "これでいい？",
          "vi": "Thế này được chưa?"
        },
        {
          "id": "sh01--sj09-d05--t03",
          "speaker": "A",
          "ja": "うん、ありがとう。",
          "vi": "Ừ, cảm ơn."
        }
      ],
      "authorship": "source_quote"
    }
  ]
}
