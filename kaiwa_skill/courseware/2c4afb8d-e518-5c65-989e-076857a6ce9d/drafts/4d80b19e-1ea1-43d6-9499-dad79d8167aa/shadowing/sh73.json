      "id": "sh73_01",
      "kind": "sentence",
      "example_id": "b73_01",
      "ja": "で、結局、どうなったの？",
      "vi": "Rồi cuối cùng thế nào?",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    },
    {
      "id": "sh73_02",
      "kind": "sentence",
      "example_id": "b73_02",
      "ja": "中止になったよ。",
      "vi": "Bị hủy rồi.",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    },
    {
      "id": "sh73_03",
      "kind": "sentence",
      "example_id": "b73_03",
      "ja": "それで、どうなりましたか",
      "vi": "Rồi chuyện gì xảy ra ạ?",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    },
    {
      "id": "sh73_04",
      "kind": "sentence",
      "example_id": "b73_04",
      "ja": "で、どうしたんですか。",
      "vi": "Rồi anh/chị đã làm sao ạ?",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    },
    {
      "id": "sh73_05",
      "kind": "sentence",
      "example_id": "b73_05",
      "ja": "しょうがないから、遅れて行きました。",
      "vi": "Không còn cách nào nên tôi đến muộn.",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    },
    {
      "id": "sh73_06",
      "kind": "sentence",
      "example_id": "b73_06",
      "ja": "で、大丈夫だったんですか。",
      "vi": "Rồi mọi chuyện có ổn không ạ?",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    },
    {
      "id": "sh73_07",
      "kind": "sentence",
      "example_id": "b73_07",
      "ja": "ええ。なんとか無事に着きました。",
      "vi": "Vâng, cuối cùng cũng đến nơi an toàn.",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    },
    {
      "id": "sh73_08",
      "kind": "sentence",
      "example_id": "b73_08",
      "ja": "で、いつにします？",
      "vi": "Vậy chọn khi nào?",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    },
    {
      "id": "sh73_09",
      "kind": "sentence",
      "example_id": "b73_09",
      "ja": "早いほうがいいですね。",
      "vi": "Càng sớm càng tốt nhỉ.",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    }
