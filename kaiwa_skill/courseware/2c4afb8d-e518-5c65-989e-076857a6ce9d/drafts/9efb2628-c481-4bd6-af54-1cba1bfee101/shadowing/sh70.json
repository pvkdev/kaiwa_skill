    {
      "id": "sh70_05",
      "kind": "sentence",
      "example_id": "b70_05",
      "ja": "へー、知らなかった。",
      "vi": "Ồ, giờ tớ mới biết đấy.",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    },
    {
      "id": "sh70_06",
      "kind": "sentence",
      "example_id": "b70_06",
      "ja": "あの日は体調が悪くて、先に帰ったんです。",
      "vi": "Hôm ấy tôi không khỏe nên về trước.",
      "authorship": "source_quote",
      "source_refs": [
        "srcB11"
      ]
    },
    {
