  "items": [
    {
      "id": "i01",
      "kind": "sentence",
      "example_id": "q01",
      "ja": "メニューを見せてもらえますか。",
      "vi": "Cho tôi xem thực đơn được không?",
      "authorship": "source_quote",
      "source_refs": [
        "b08_05"
      ]
    },
    {
      "id": "i02",
      "kind": "sentence",
      "example_id": "q02",
      "ja": "すみません、注文をお願いします。",
      "vi": "Xin lỗi, tôi muốn gọi món.",
      "authorship": "source_quote",
      "source_refs": [
        "b08_05"
      ]
    },
    {
      "id": "i03",
      "kind": "sentence",
      "example_id": "q03",
      "ja": "コーヒーをお願いします。",
      "vi": "Cho tôi cà phê.",
      "authorship": "source_quote",
      "source_refs": [
        "b08_05"
      ]
    },
    {
      "id": "i04",
      "kind": "sentence",
      "example_id": "q04",
      "ja": "ホットとアイス、どちらになさいますか。",
      "vi": "Quý khách dùng loại nóng hay lạnh?",
      "authorship": "source_quote",
      "source_refs": [
        "b08_05"
      ]
    },
    {
      "id": "i05",
      "kind": "sentence",
      "example_id": "q05",
      "ja": "ホットでお願いします。",
      "vi": "Cho tôi loại nóng.",
      "authorship": "source_quote",
      "source_refs": [
        "b08_05"
      ]
    },
    {
      "id": "i06",
      "kind": "sentence",
      "example_id": "q06",
      "ja": "お飲み物はお食事の後でよろしいですか。",
      "vi": "Quý khách dùng đồ uống sau bữa ăn được chứ ạ?",
      "authorship": "source_quote",
      "source_refs": [
        "b08_05"
      ]
    },
    {
      "id": "i07",
      "kind": "sentence",
      "example_id": "q07",
      "ja": "後でお願いします。",
      "vi": "Xin mang sau bữa ăn.",
      "authorship": "source_quote",
      "source_refs": [
        "b08_05"
      ]
    },
    {
      "id": "i08",
      "kind": "sentence",
      "example_id": "q08",
      "ja": "一緒でお願いします。",
      "vi": "Xin mang cùng với bữa ăn.",
      "authorship": "source_quote",
      "source_refs": [
        "b08_05"
      ]
    },
    {
      "id": "i09",
      "kind": "sentence",
      "example_id": "q09",
      "ja": "私はこれにします。さくらさんは何にしますか。",
      "vi": "Tôi chọn món này. Sakura, bạn chọn món gì?",
      "authorship": "source_quote",
      "source_refs": [
        "b08_06"
      ]
    },
    {
      "id": "i10",
      "kind": "sentence",
      "example_id": "q10",
      "ja": "おすすめは何ですか。",
      "vi": "Món nào được quán gợi ý?",
      "authorship": "source_quote",
      "source_refs": [
        "b08_06"
      ]
    },
    {
      "id": "i11",
      "kind": "sentence",
      "example_id": "q11",
      "ja": "これは豚肉が入っていますか。",
      "vi": "Món này có thịt lợn không?",
      "authorship": "source_quote",
      "source_refs": [
        "b08_06"
      ]
    },
    {
      "id": "i12",
      "kind": "sentence",
      "example_id": "q12",
      "ja": "生の魚は苦手なんです。",
      "vi": "Tôi không hợp món cá sống.",
      "authorship": "source_quote",
      "source_refs": [
        "b08_06"
      ]
    },
    {
      "id": "i13",
      "kind": "sentence",
      "example_id": "q13",
      "ja": "お酒は飲めないんです。",
      "vi": "Tôi không uống được rượu.",
      "authorship": "source_quote",
      "source_refs": [
        "b08_06"
      ]
    },
    {
      "id": "i14",
      "kind": "sentence",
      "example_id": "q14",
      "ja": "注文したものが来ないんですが。",
      "vi": "Món tôi gọi vẫn chưa được mang ra.",
      "authorship": "source_quote",
      "source_refs": [
        "b08_06"
      ]
    },
    {
      "id": "i15",
      "kind": "sentence",
      "example_id": "q15",
      "ja": "これは注文していません。",
      "vi": "Tôi không gọi món này.",
      "authorship": "source_quote",
      "source_refs": [
        "b08_06"
      ]
    },
    {
      "id": "i16",
      "kind": "sentence",
      "example_id": "q16",
      "ja": "お会計お願いします。",
      "vi": "Cho tôi thanh toán.",
      "authorship": "source_quote",
      "source_refs": [
        "b08_06"
      ]
    }
  ]
}
