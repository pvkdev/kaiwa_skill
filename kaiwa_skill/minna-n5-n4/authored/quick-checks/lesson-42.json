        {
          "id": "2",
          "text": "見るの"
        }
      ],
      "correct": "0",
      "explanation_vi": "Việc xem trận đấu là mục đích có chủ ý của người mua tivi. Động từ nối thẳng với ために ở thể từ điển là 見る.",
      "provenance": {
        "question": "source",
        "answer": "ai_editorial",
        "explanation": "ai_editorial",
        "official_key": "not_verified"
      }
    },
