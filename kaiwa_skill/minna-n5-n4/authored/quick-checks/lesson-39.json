      "choices": [
        {
          "id": "0",
          "text": "なので"
        },
        {
          "id": "1",
          "text": "だので"
        },
        {
          "id": "2",
          "text": "だったので"
        }
      ],
      "correct": "2",
      "explanation_vi": "Đề yêu cầu biểu thị rõ quá khứ của danh từ 休み. 休みだった là “đã là ngày nghỉ”; thêm ので để nối với kết quả ở nhà.",
      "provenance": {
        "question": "ai_adapted",
        "answer": "ai_editorial",
        "explanation": "ai_editorial",
        "official_key": "not_verified"
      }
